package layout

// FullscreenViewer shares viewport sizing and native window-control exclusion
// across media previews and live computer desktops. Contents own their controls.
templ FullscreenViewer(attributes templ.Attributes) {
 <style>
  dialog[data-fullscreen-viewer] { position:fixed; inset:0; width:100vw; max-width:100vw; height:100dvh; max-height:100dvh; margin:0; padding:0; border:0; border-radius:0; overflow:hidden; }
  dialog[data-fullscreen-viewer][open] { display:flex; flex-direction:column; }
 </style>
 <dialog data-fullscreen-viewer { attributes... }>
  { children... }
 </dialog>
}
