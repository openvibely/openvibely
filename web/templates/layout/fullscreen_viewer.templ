package layout

// FullscreenViewer is the shared gallery frame for file previews and desktops.
templ FullscreenViewer(attributes templ.Attributes) {
 <style>
  dialog[data-fullscreen-viewer] { position:fixed; inset:0; width:100vw; max-width:100vw; height:100dvh; max-height:100dvh; margin:0; padding:0; border:0; border-radius:0; overflow:hidden; color:#eee; background:transparent; }
  dialog[data-fullscreen-viewer]::backdrop { background:rgb(0 0 0 / .9); }
  dialog[data-fullscreen-viewer][open] { display:flex; flex-direction:column; }
  [data-fullscreen-shell] { color:inherit; background:transparent; box-shadow:none; padding:0; width:100%; max-width:none; max-height:none; transform:none; translate:none; scale:none; margin:0; border:0; border-radius:0; min-height:0; overflow:hidden; height:100%; display:flex; flex-direction:column; }
  [data-fullscreen-header] { display:flex; align-items:center; gap:8px; padding:12px 72px 12px 12px; flex-shrink:0; min-height:64px; }
  [data-fullscreen-title] { flex:1; min-width:0; overflow:hidden; text-overflow:ellipsis; white-space:nowrap; font-size:14px; }
  [data-fullscreen-close] { display:flex; align-items:center; justify-content:center; padding:0; cursor:pointer; position:absolute; top:12px; right:12px; width:44px; height:44px; border:0; border-radius:50%; background:rgb(0 0 0 / .7); color:#eee; }
  [data-fullscreen-close]:hover, [data-fullscreen-close]:focus-visible { background-image:linear-gradient(rgb(255 255 255 / .12),rgb(255 255 255 / .12)); }
  [data-fullscreen-stage] { flex:1; min-width:0; margin-inline:68px; min-height:0; overflow:hidden; position:relative; display:flex; justify-content:center; align-items:center; }
  @media (max-width:640px) { [data-fullscreen-stage] { margin-inline:16px; } }
 </style>
 <dialog data-fullscreen-viewer { attributes... }>
  <div data-fullscreen-shell class="image-gallery-shell file-viewer-shell">
   { children... }
  </div>
 </dialog>
 <script>
  if (!window.openVibelyBindFullscreenViewers) {
   window.openVibelyBindFullscreenViewers = function() {
    document.querySelectorAll('dialog[data-fullscreen-viewer]').forEach(dialog => {
     if(dialog.dataset.fullscreenBound)return;
     dialog.dataset.fullscreenBound='true';
     const isBackdrop=target=>target instanceof Element && !target.closest('#toast-container,img,video,canvas,button,a,input,textarea,select,[contenteditable],[data-result-content],[data-gallery-name],[data-gallery-count],[data-fullscreen-title],[data-fullscreen-interactive]');
     let backdropPress=false;
     dialog.addEventListener('pointerdown',event=>{backdropPress=event.button===0&&isBackdrop(event.target)},true);
     dialog.addEventListener('pointerup',event=>{const released=document.elementFromPoint(event.clientX,event.clientY);backdropPress=backdropPress&&event.button===0&&released&&dialog.contains(released)&&isBackdrop(released)},true);
     dialog.addEventListener('pointercancel',()=>{backdropPress=false});
     dialog.addEventListener('close',()=>{backdropPress=false});
     dialog.addEventListener('click',event=>{if(backdropPress&&isBackdrop(event.target))dialog.close();backdropPress=false},true);
     dialog.querySelector('[data-fullscreen-close]')?.addEventListener('click',()=>dialog.close());
    });
   };
  }
  window.openVibelyBindFullscreenViewers();
 </script>
}

templ FullscreenViewerHeader(closeAttributes templ.Attributes) {
 <header data-fullscreen-header>
  { children... }
  <button data-fullscreen-close data-tooltip-disabled type="button" { closeAttributes... }><svg class="h-4 w-4" fill="none" viewBox="0 0 24 24" stroke="currentColor" aria-hidden="true"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M6 18L18 6M6 6l12 12"/></svg></button>
 </header>
}
