package layout

import (
	"encoding/json"
 "context"
	"runtime"

	"github.com/openvibely/openvibely/internal/models"
)

func pinnedProjects(projects []models.Project, ids []string) []models.Project {
	byID := make(map[string]models.Project, len(projects))
	for _, project := range projects {
		byID[project.ID] = project
	}
	result := make([]models.Project, 0, len(ids))
	for _, id := range ids {
		if project, ok := byID[id]; ok {
			result = append(result, project)
			delete(byID, id)
		}
	}
	return result
}

func pinnedProjectJSON(projects []models.Project) string {
	ids := make([]string, 0, len(projects))
	for _, project := range projects {
		ids = append(ids, project.ID)
	}
	value, _ := json.Marshal(ids)
	return string(value)
}

func projectBarPlatform(ctx context.Context) string {
 if serverRuntimeMode(ctx) == "desktop" { return runtime.GOOS }
 return "web"
}

templ DesktopProjectTabs(projects []models.Project, currentProjectID string) {
	<style>
 [data-openvibely-runtime="web"] #desktop-project-titlebar { display: none; --wails-draggable: no-drag; }
 #project-selector-trigger .project-selector-plus { display: none; }
 #desktop-project-titlebar #project-selector-trigger .project-selector-plus { display: block; }
 #desktop-project-titlebar #project-selector-current-label { display: none; }
 #desktop-project-titlebar #project-selector-trigger { background: transparent; border: 0; }
 @media (min-width: 1024px) {
  [data-openvibely-runtime="web"] #desktop-project-titlebar { display: flex; }
  [data-openvibely-runtime="web"] body > .drawer { height: calc(100% - 46px); }
  [data-openvibely-runtime="web"] #sidebar { height: calc(100dvh - 46px); }
  [data-openvibely-runtime="web"] .drawer-side { height: calc(100dvh - 46px); }
  [data-openvibely-runtime="web"] .sidebar-header { display: none; }
 }

  [data-openvibely-runtime="desktop"] body > .drawer { height: calc(100% - 46px); }
  [data-openvibely-runtime="desktop"] #sidebar { height: calc(100dvh - 46px); }
  [data-openvibely-runtime="desktop"] .drawer-side { top: 46px; height: calc(100dvh - 46px); }
  @media (min-width: 1024px) { [data-openvibely-runtime="desktop"] .drawer-side { top: 0; } }
  #desktop-project-titlebar { height: 46px; display: flex; align-items: center; gap: 6px; padding: 0 8px; box-sizing: border-box; --wails-draggable: drag; cursor: default; -webkit-user-select: none; user-select: none; --project-tab-selected: oklch(var(--b2)); --project-tab-contour: oklch(var(--b1)); box-shadow: inset 0 -2px var(--project-tab-contour); }
  /* Reserve the sidebar column; the first tab's curved foot starts at its edge. */
  #desktop-project-titlebar { position: relative; }
  #desktop-project-titlebar[data-platform="darwin"] { padding-left: 128px; }
  #desktop-project-titlebar > #sidebar-collapse-btn { position: absolute; left: 8px; top: 7px; width: 32px; height: 32px; padding: 0; display: flex; align-items: center; justify-content: center; }
  #desktop-project-titlebar[data-platform="darwin"] > #sidebar-collapse-btn { left: 82px; }
  .project-bar-brand { cursor: default; -webkit-user-select: none; user-select: none; --wails-draggable: drag; display: none; position: absolute; left: 16px; font-size: 14px; line-height: 20px; font-weight: 500; }
  @media (min-width: 1024px) {
    #desktop-project-titlebar .project-bar-brand { display: block; }
    #desktop-project-titlebar[data-platform="darwin"] .project-bar-brand { left: 90px; }
    #desktop-project-titlebar > #sidebar-collapse-btn, #desktop-project-titlebar[data-platform="darwin"] > #sidebar-collapse-btn { left: calc(16rem - 40px); }
    body.sidebar-collapsed-pending #desktop-project-titlebar .project-bar-brand { display: none; }
    body.sidebar-collapsed-pending #desktop-project-titlebar > #sidebar-collapse-btn { left: calc((3.5rem - 1px - 32px) / 2); }
    body.sidebar-collapsed-pending #desktop-project-titlebar[data-platform="darwin"] > #sidebar-collapse-btn { left: 82px; }
    #desktop-project-titlebar { padding-left: 16rem; }
    #desktop-project-titlebar[data-platform="darwin"] { padding-left: 16rem; }
    body.sidebar-collapsed-pending #desktop-project-titlebar { padding-left: 3.5rem; }
    body.sidebar-collapsed-pending #desktop-project-titlebar[data-platform="darwin"] { padding-left: max(3.5rem, 128px); }
  }
  [data-theme="light"] #desktop-project-titlebar { --project-tab-contour: var(--ov-l-border); }
  #desktop-project-titlebar button, #desktop-project-titlebar [data-project-selector], #desktop-project-titlebar dialog { --wails-draggable: no-drag; }
  #desktop-project-titlebar button:focus-visible { outline: 2px solid oklch(var(--p)); outline-offset: -2px; }
  #desktop-project-titlebar:not([data-keyboard-navigation]) [data-project-tab]:focus { outline: none; }
  #desktop-project-tabs { position: relative; display: flex; min-width: 0; min-height: 0; overflow-x: auto; overflow-y: hidden; scrollbar-width: none; gap: 4px; align-self: stretch; padding: 6px 10px 0; }
  /* Keep native scrollbars out of the header, including older WebKitGTK. */
  #desktop-project-tabs::-webkit-scrollbar { display: none; width: 0; height: 0; }
  .desktop-project-tab { display: flex; align-items: center; flex: 0 0 240px; width: 240px; position: relative; border-radius: 16px 16px 0 0; background: transparent; --wails-draggable: no-drag; }
  .desktop-project-tab:has([aria-selected="true"]) { background: var(--project-tab-selected); z-index: 1; }
  .desktop-project-tab:has([aria-selected="true"])::before, .desktop-project-tab:has([aria-selected="true"])::after { content: ""; position: absolute; bottom: 0; width: 10px; height: 10px; pointer-events: none; }
  .desktop-project-tab:has([aria-selected="true"])::before { left: -10px; background: radial-gradient(circle at 0 0, transparent 8px, var(--project-tab-contour) 8px, var(--project-tab-contour) 10px, var(--project-tab-selected) 10px); }
  .desktop-project-tab:has([aria-selected="true"])::after { right: -10px; background: radial-gradient(circle at 100% 0, transparent 8px, var(--project-tab-contour) 8px, var(--project-tab-contour) 10px, var(--project-tab-selected) 10px); }
  .desktop-project-tab:not(:has([aria-selected="true"]))::after { content: ""; position: absolute; right: -3px; top: calc(50% - 3px); width: 2px; height: 16px; transform: translateY(-50%); border-radius: 1px; background: oklch(var(--bc) / .25); pointer-events: none; transition: none; }
  .desktop-project-tab:not(:has([aria-selected="true"])):is(:hover, :has(+ .desktop-project-tab:hover), :has(+ .desktop-project-tab [aria-selected="true"]))::after { opacity: 0; }
  @media (prefers-reduced-motion: reduce) { .desktop-project-tab::before, .desktop-project-tab::after { transition: none; } }
  .desktop-project-tab [role="tab"] { width: 100%; height: 100%; border-radius: inherit; text-align: left; color: inherit; background: transparent; padding: 0 40px 6px 16px; min-width: 0; overflow: hidden; text-overflow: ellipsis; white-space: nowrap; font-size: .875rem; line-height: 1.25rem; font-weight: 400; }
  [data-theme="light"] .desktop-project-tab [role="tab"] { color: var(--ov-l-text-strong); font-weight: 500; }
  /* End the straight sides above the curved feet, never at the baseline. */
  .desktop-project-tab [role="tab"][aria-selected="true"]::before { content: ""; position: absolute; inset: 0 0 10px; border: 2px solid var(--project-tab-contour); border-bottom: 0; border-radius: 16px 16px 0 0; pointer-events: none; }
  .desktop-project-tab [role="tab"][aria-selected="true"] { color: color-mix(in oklch, oklch(var(--bc)) 70%, black); }
  [data-theme="dark"] .desktop-project-tab [role="tab"][aria-selected="true"] { color: color-mix(in oklch, oklch(var(--bc)) 70%, white); }
  .desktop-project-tab [data-close-project] { position: absolute; right: 8px; top: calc(50% - 3px); transform: translateY(-50%); width: 24px; height: 24px; display: flex; align-items: center; justify-content: center; padding: 0; line-height: 1; border-radius: 50%; }
  .desktop-project-tab:not(:has([aria-selected="true"])):hover [role="tab"] { background: oklch(var(--bc) / .08); border-radius: 999px; background-clip: padding-box; border: 4px solid transparent; border-width: 1px 2px 7px; padding-top: 0; padding-bottom: 0; padding-left: 14px; padding-right: 38px; }
  .desktop-project-tab:has([aria-selected="true"]):hover { background: var(--project-tab-selected); }
  .desktop-project-tab [data-close-project]:enabled:hover { background: oklch(var(--bc) / .18); }
  .desktop-project-tab [data-close-project]:disabled { opacity: .35; cursor: default; }
  #desktop-project-titlebar #project-selector-trigger { display: flex; align-items: center; justify-content: center; padding: 0; line-height: 1; flex-shrink: 0; width: 30px; height: 30px; align-self: center; transform: translateY(-3px); border-radius: 50%; }
 #desktop-project-titlebar #project-selector-trigger:is(:hover, [data-pointer-over], [aria-expanded="true"]) { background: oklch(var(--bc) / .12); }
 #project-tab-menu { position: fixed; margin: 0; padding: 4px; border: 1px solid oklch(var(--bc) / .2); border-radius: 8px; background: oklch(var(--b1)); color: oklch(var(--bc)); --wails-draggable: no-drag; }
 #project-tab-menu button { display: block; width: 100%; text-align: left; padding: 8px 16px; border-radius: 4px; }
 #project-tab-menu button:hover { background: oklch(var(--bc) / .12); }
  .desktop-titlebar-space { flex: 1; min-width: 24px; height: 100%; }
  #desktop-project-titlebar [data-project-selector] { position: relative; margin: 0; padding-left: 7px; width: 37px; flex-shrink: 0; display: flex; flex-direction: row; align-items: center; align-self: center; gap: 0; }
  #desktop-project-titlebar [data-project-selector] > div:first-child { display: none; }
  #desktop-project-titlebar [data-project-selector] .label-text { display: none; }
	  #desktop-project-titlebar #project-selector-trigger { width: 30px; }
 </style>
	<header id="desktop-project-titlebar" class="bg-base-300" data-platform={ projectBarPlatform(ctx) } data-pinned-projects={ pinnedProjectJSON(pinnedProjects(projects, uiPreferences(ctx).PinnedProjectIDs)) } aria-label="Project title bar">
			<span class="project-bar-brand">OpenVibely</span>

			if serverRuntimeMode(ctx) == "desktop" {
 @SidebarToggle()
 }
			<div id="desktop-project-tabs" role="tablist" aria-label="Open projects">			for _, project := range pinnedProjects(projects, uiPreferences(ctx).PinnedProjectIDs) {
				<div class="desktop-project-tab">
					<button type="button" role="tab" aria-selected={ fmtBool(project.ID == currentProjectID) } tabindex={ tabIndex(project.ID == currentProjectID) } data-project-tab={ project.ID }>{ project.Name }</button>
					<button type="button" disabled?={ len(pinnedProjects(projects, uiPreferences(ctx).PinnedProjectIDs)) <= 1 } data-close-project={ project.ID } aria-label={ "Close project tab: " + project.Name }><svg width="12" height="12" viewBox="0 0 12 12" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" aria-hidden="true"><path d="m3 3 6 6m0-6-6 6"/></svg></button>
				</div>
			}
		if serverRuntimeMode(ctx) == "desktop" {
 @ProjectSelector(projects, currentProjectID)
 }
        </div>

		<div class="desktop-titlebar-space" aria-hidden="true"></div>
		if serverRuntimeMode(ctx) == "desktop" {
			@DesktopWindowControls(runtime.GOOS)
		}

	</header>
 <div id="project-tab-menu" popover="manual" role="menu" aria-label="Project tab"><button type="button" role="menuitem" id="project-tab-settings-action">Project Settings</button></div>
	<script>
 (function() {
  function installProjectTabs() {
   var bar = document.getElementById('desktop-project-titlebar');
   var select = document.getElementById('project-selector');
   var list = document.getElementById('desktop-project-tabs');
   var menu = document.getElementById('project-tab-menu');
 var menuTab;
 var add = document.querySelector('[data-project-selector]');
 if (bar.dataset.platform === 'web') {
  var home = document.createElement('span');
  home.id = 'web-project-selector-home';
  add.before(home);
  var toggle = document.getElementById('sidebar-collapse-btn');
  var toggleHome = toggle.parentElement;
  var create = document.getElementById('new-project-btn');
  var createHome = create.parentElement;
  var originalCreateClass = create.className;
  var selectorMenu = document.getElementById('project-selector-dialog');
  var results = selectorMenu.querySelector('[role="listbox"]');
  var createRow = document.createElement('div');
  createRow.hidden = true;
  createRow.setAttribute('data-searchable-selector-divider', '');
  createRow.style.cssText = 'padding: 8px; border-bottom-width: 1px';
  (results || selectorMenu.firstElementChild).before(createRow);
  var label = document.createElement('span'); label.textContent = 'Create New Project';
  var media = matchMedia('(min-width: 1024px)');
  function placeWebControls() {
   if (selectorMenu.open) selectorMenu.close();
   if (media.matches) {
    list.append(add); bar.prepend(toggle);
    createRow.append(create); create.append(label);
    create.className = 'flex w-full max-w-full min-w-0 items-center gap-2 overflow-hidden rounded-btn px-4 py-2';
    create.setAttribute('data-searchable-selector-option', '');
    create.setAttribute('data-searchable-selector-action', '');
   } else {
    home.after(add); toggleHome.append(toggle);
    createHome.append(create); label.remove(); create.className = originalCreateClass;
    create.removeAttribute('data-searchable-selector-option');
    create.removeAttribute('data-searchable-selector-action');
    create.removeAttribute('data-selector-active');
   }
   createRow.hidden = !media.matches;
  }
  media.addEventListener('change', function() { placeWebControls(); sync(); });
  placeWebControls();
  create.addEventListener('click', function() { if (selectorMenu.open) selectorMenu.close(); });
 } else { list.append(add); }
   if (!bar || !select || bar.dataset.installed) return;
   bar.dataset.installed = 'true';
   // Modal dialogs make the trigger inert, interrupting CSS :hover even
   // when the pointer stays over it. Keep that visual state across toggles.
   var addButton = document.getElementById('project-selector-trigger');
   function trackAddHover(event) {
    var rect = addButton.getBoundingClientRect();
    addButton.toggleAttribute('data-pointer-over', event.pointerType !== 'touch' && event.clientX >= rect.left && event.clientX < rect.right && event.clientY >= rect.top && event.clientY < rect.bottom);
   }
   document.addEventListener('pointermove', trackAddHover, true);
   document.addEventListener('pointerdown', trackAddHover, true);
   document.addEventListener('pointerout', function(event) {
    if (!event.relatedTarget) addButton.removeAttribute('data-pointer-over');
   }, true);
   window.addEventListener('blur', function() { addButton.removeAttribute('data-pointer-over'); });
   // WebViews may focus the first tab automatically on launch. Only show
   // its focus outline after keyboard input, not startup or pointer focus.
   document.addEventListener('keydown', function(event) {
    if (['Tab', 'ArrowLeft', 'ArrowRight', 'Home', 'End', 'ContextMenu', 'F10'].includes(event.key)) bar.setAttribute('data-keyboard-navigation', '');
   }, true);
   document.addEventListener('pointerdown', function() { bar.removeAttribute('data-keyboard-navigation'); }, true);
   bar.addEventListener('dblclick', function(event) {
    if (getComputedStyle(event.target).getPropertyValue('--wails-draggable').trim() !== 'drag') return;
    if (window.wails && window.wails.Window) window.wails.Window.ToggleMaximise();
   });
   var recoveredTabs = (window.openVibelyRecoveredProjectPreferences || {}).pinned_project_ids;
   var ids = Array.from(new Set((Array.isArray(recoveredTabs) ? recoveredTabs : JSON.parse(bar.dataset.pinnedProjects)).filter(function(id) {
    return Array.from(select.options).some(function(option) { return option.value === id; });
   })));
   bar.dataset.pinnedProjects = JSON.stringify(ids);
 var closedActive = "";
 var pendingCloses = new Set();
   function saveTabs() {
    bar.dataset.pinnedProjects = JSON.stringify(ids);
    window.openVibelySaveProjectPreferences({pinned_project_ids: ids.slice()});
   }
   function switchProject(id, request) {
    select.value = id;
    select.dispatchEvent(new CustomEvent('change', {bubbles: true, detail: request || {}}));
    return select.value === id;
   }
   function sync() {
    if (bar.dataset.platform === 'web' && !matchMedia('(min-width: 1024px)').matches) return;
    var active = select.value;
 if (active && !ids.includes(active) && active !== closedActive) { ids.push(active); saveTabs(); render(); return; }
    list.querySelectorAll('[data-project-tab]').forEach(function(tab, index) {
     tab.setAttribute('aria-selected', String(tab.dataset.projectTab === active));
     tab.tabIndex = tab.dataset.projectTab === active || (ids.indexOf(active) === -1 && index === 0) ? 0 : -1;
    });
    list.querySelectorAll('[data-close-project]').forEach(function(close) {
     close.disabled = ids.length <= 1 || pendingCloses.has(close.dataset.closeProject) || close.dataset.closeProject === window.openVibelyProtectedProjectID;
    });
    var activeTab = list.querySelector('[aria-selected="true"]');
    if (activeTab) activeTab.scrollIntoView({block: 'nearest', inline: 'nearest'});
   }
   function render() {
    list.replaceChildren();
    ids.forEach(function(id) {
     var option = Array.from(select.options).find(function(option) { return option.value === id; });
     if (!option) return;
     var wrapper = document.createElement('div'); wrapper.className = 'desktop-project-tab';
     var tab = document.createElement('button'); tab.type = 'button'; tab.setAttribute('role', 'tab'); tab.dataset.projectTab = id; tab.textContent = option.textContent.trim();
     var close = document.createElement('button'); close.type = 'button'; close.dataset.closeProject = id; close.innerHTML = '<svg width="12" height="12" viewBox="0 0 12 12" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" aria-hidden="true"><path d="m3 3 6 6m0-6-6 6"/></svg>'; close.setAttribute('aria-label', 'Close project tab: ' + tab.textContent);
     close.disabled = ids.length <= 1 || pendingCloses.has(close.dataset.closeProject) || close.dataset.closeProject === window.openVibelyProtectedProjectID;
     wrapper.append(tab, close); list.append(wrapper);
    });
    list.append(add);
    sync();
   }
   // Track on the document so moving tab nodes cannot interrupt the gesture.
   var drag = null;
   var dragFrame = 0;
   var suppressDragClick = false;
   var reducedTabMotion = matchMedia('(prefers-reduced-motion: reduce)');
   function animateTabPosition(node, from) {
    node.getAnimations().forEach(function(animation) { animation.cancel(); });
    if (!reducedTabMotion.matches && Math.abs(from) > 0.5) node.animate([{transform: 'translateX(' + from + 'px)'}, {transform: 'translateX(0)'}], {duration: 180, easing: 'cubic-bezier(.2, 0, 0, 1)'});
   }
   function moveDraggedTab() {
    if (!drag || !drag.started) return;
    var bounds = list.getBoundingClientRect();
    var speed = drag.x < bounds.left + 32 ? -12 : drag.x > bounds.right - 32 ? 12 : 0;
    list.scrollLeft += speed;
    var others = Array.from(list.querySelectorAll('.desktop-project-tab')).filter(function(node) { return node !== drag.wrapper; });
    // Hit-test layout positions, not animated bounds, to avoid oscillating slots.
    var origin = list.getBoundingClientRect().left - list.scrollLeft;
    var tabs = Array.from(list.querySelectorAll('.desktop-project-tab'));
    // Clamp to resting tab slots, excluding the gap before +. Neither end
    // should need a corrective slide when the pointer is released.
    var first = tabs[0];
    var last = tabs[tabs.length - 1];
    var left = Math.max(origin + first.offsetLeft, Math.min(drag.x - drag.grabOffset,
     origin + last.offsetLeft + last.offsetWidth - drag.wrapper.offsetWidth));
    var right = left + drag.wrapper.offsetWidth;
    var index = tabs.indexOf(drag.wrapper);
    var target = index;
    while (target + 1 < tabs.length && right > origin + tabs[target + 1].offsetLeft + tabs[target + 1].offsetWidth / 2) target++;
    if (target === index) {
     while (target > 0 && left < origin + tabs[target - 1].offsetLeft + tabs[target - 1].offsetWidth / 2) target--;
    }
    var before = target > index ? tabs[target].nextElementSibling : tabs[target];
    if (target !== index) {
     var previous = others.map(function(node) { return node.getBoundingClientRect().left; });
     list.insertBefore(drag.wrapper, before || add);
     others.forEach(function(node, index) { animateTabPosition(node, previous[index] - (origin + node.offsetLeft)); });
    }
     drag.wrapper.style.transform = 'translateX(' + (left - (origin + drag.wrapper.offsetLeft)) + 'px)';   }
   function dragTick() {
    if (!drag || !drag.started) return;
    moveDraggedTab();
    dragFrame = requestAnimationFrame(dragTick);
   }
   list.addEventListener('pointerdown', function(event) {
    var tab = event.target.closest('[data-project-tab]');
    if (!tab || event.button !== 0 || !event.isPrimary) return;
    if (!switchProject(tab.dataset.projectTab)) return;
    drag = {pointer: event.pointerId, startX: event.clientX, grabOffset: event.clientX - tab.parentElement.getBoundingClientRect().left, x: event.clientX, wrapper: tab.parentElement, started: false};
   });
   document.addEventListener('pointermove', function(event) {
    if (!drag || event.pointerId !== drag.pointer) return;
    drag.x = event.clientX;
    if (!drag.started && Math.abs(drag.x - drag.startX) >= 6) {
     drag.started = true;
     menu.hidePopover();
     drag.wrapper.getAnimations().forEach(function(animation) { animation.cancel(); });
     drag.wrapper.style.zIndex = '3';
     list.style.cursor = 'grabbing';
     dragTick();
    }
    if (drag.started) { event.preventDefault(); moveDraggedTab(); }
   });
   function finishDrag(event) {
    if (!drag || (event.pointerId != null && event.pointerId !== drag.pointer)) return;
    var ended = drag;
    drag = null;
    cancelAnimationFrame(dragFrame);
    list.style.cursor = '';
    var releaseOffset = parseFloat(ended.wrapper.style.transform.replace('translateX(', '')) || 0;
    ended.wrapper.style.transform = '';
    ended.wrapper.style.zIndex = '';
    if (!ended.started) return;
    animateTabPosition(ended.wrapper, releaseOffset);
    suppressDragClick = true;
    setTimeout(function() { suppressDragClick = false; }, 0);
    if (event.type !== 'pointerup') { render(); return; }
    var reordered = Array.from(list.querySelectorAll('[data-project-tab]')).map(function(tab) { return tab.dataset.projectTab; });
    if (JSON.stringify(reordered) !== JSON.stringify(ids)) { ids = reordered; saveTabs(); }
   }
   document.addEventListener('pointerup', finishDrag);
   document.addEventListener('pointercancel', finishDrag);
   window.addEventListener('blur', finishDrag);
   document.addEventListener('keydown', function(event) { if (event.key === 'Escape' && drag) { event.preventDefault(); finishDrag(event); } });
   list.addEventListener('click', function(event) {
    if (suppressDragClick) { event.preventDefault(); event.stopImmediatePropagation(); }
   }, true);
   list.addEventListener('dragstart', function(event) { if (event.target.closest('[data-project-tab]')) event.preventDefault(); });
   function openMenu(tab, x, y) {
    menuTab = tab;
    menu.showPopover();
    menu.style.left = Math.max(0, Math.min(x, innerWidth - menu.offsetWidth)) + 'px';
    menu.style.top = Math.max(0, Math.min(y, innerHeight - menu.offsetHeight)) + 'px';
    document.getElementById('project-tab-settings-action').focus();
   }
   list.addEventListener('contextmenu', function(event) {
    var wrapper = event.target.closest('.desktop-project-tab');
    if (!wrapper) return;
    event.preventDefault(); openMenu(wrapper.querySelector('[data-project-tab]'), event.clientX, event.clientY);
   });
   list.addEventListener('keydown', function(event) {
    if (event.key !== 'ContextMenu' && !(event.shiftKey && event.key === 'F10')) return;
    var tab = event.target.closest('[data-project-tab]'); if (!tab) return;
    event.preventDefault(); var rect = tab.getBoundingClientRect(); openMenu(tab, rect.left, rect.bottom);
   });
   document.addEventListener('pointerdown', function(event) {
    if (!menu.contains(event.target)) menu.hidePopover();
   });
   window.addEventListener('resize', function() { menu.hidePopover(); });
   list.addEventListener('scroll', function() { menu.hidePopover(); });
   menu.addEventListener('keydown', function(event) {
    if (event.key === 'ArrowDown' || event.key === 'ArrowUp') {
     event.preventDefault(); var items = Array.from(menu.querySelectorAll('[role=menuitem]'));
     items[(items.indexOf(document.activeElement) + (event.key === 'ArrowDown' ? 1 : items.length - 1)) % items.length].focus();
    }
    if (event.key === 'Escape' || event.key === 'Tab') { menu.hidePopover(); if (menuTab) menuTab.focus(); } });
   document.getElementById('project-tab-settings-action').addEventListener('click', function() {
    if (!menuTab) return;
    menu.hidePopover();
    htmx.ajax('GET', '/projects/' + encodeURIComponent(menuTab.dataset.projectTab) + '/edit', {target: document.getElementById('project-settings-container'), swap: 'innerHTML'});
   });
   list.addEventListener('click', async function(event) {
    var option = event.target.closest('[data-project-selector-option]');
    if (option) {
     closedActive = '';
     // Selecting the current project does not emit a change event.
     if (option.dataset.projectId === select.value) sync();
     return;
    }
    var tab = event.target.closest('[data-project-tab]');
    // Pointer activation already happened on press; retain keyboard activation.
    if (tab) { if (event.detail === 0) switchProject(tab.dataset.projectTab); return; }
    var close = event.target.closest('[data-close-project]');
    if (!close || ids.length <= 1) return;
    var index = ids.indexOf(close.dataset.closeProject);
    var next = ids[index + 1] || ids[index - 1];
    var closingID = close.dataset.closeProject;
    if (pendingCloses.has(closingID) || closingID === window.openVibelyProtectedProjectID) return;
    pendingCloses.add(closingID);
    close.disabled = true;
    try {
     if (closingID === select.value && next) {
      var request = {};
      if (!switchProject(next, request) || !request.navigation || !await request.navigation) return;
      if (select.value !== next) return;
     }
     // Navigation may have allowed other tab changes while this close was pending.
     index = ids.indexOf(closingID);
     if (index < 0 || ids.length <= 1) return;
     closedActive = closingID;
     ids.splice(index, 1); render(); saveTabs();
     var focus = list.querySelector('[aria-selected="true"]') || list.querySelector('[data-project-tab]') || add;
     focus.focus();
    } finally {
     pendingCloses.delete(closingID);
     sync();
    }
   });
   list.addEventListener('keydown', function(event) {
    var tab = event.target.closest('[data-project-tab]');
    if (!tab) return;
    if (event.defaultPrevented || event.isComposing || event.altKey || event.metaKey || event.ctrlKey || event.shiftKey) return;
    var tabs = Array.from(list.querySelectorAll('[data-project-tab]'));
    var index = tabs.indexOf(tab);
    if (event.key === 'ArrowRight') index = (index + 1) % tabs.length;
    else if (event.key === 'ArrowLeft') index = (index + tabs.length - 1) % tabs.length;
    else if (event.key === 'Home') index = 0;
    else if (event.key === 'End') index = tabs.length - 1;
    else if (event.key === 'Delete') { event.preventDefault(); tab.parentElement.querySelector('[data-close-project]').click(); return; }
    else return;
    event.preventDefault();
    tabs.forEach(function(item) { item.tabIndex = -1; });
    tabs[index].tabIndex = 0; tabs[index].focus(); tabs[index].scrollIntoView({block: 'nearest', inline: 'nearest'});
   });
   document.addEventListener('keydown', function(event) {
    if (event.defaultPrevented || event.isComposing || event.repeat || event.metaKey === event.ctrlKey || !event.shiftKey || event.altKey) return;
    if (event.key !== 'ArrowLeft' && event.key !== 'ArrowRight') return;
    var target = event.target;
    var composer = target && (target.id === 'message-input' || target.id === 'task-message-input');
    if (!composer && target && (target.isContentEditable || target.closest('input, textarea, select, [role="textbox"]'))) return;
    if (document.querySelector('dialog[open], [popover]:popover-open') || Array.from(document.querySelectorAll('[role="dialog"][aria-modal="true"]')).some(function(dialog) { return dialog.getClientRects().length > 0; })) return;
    var tabs = Array.from(list.querySelectorAll('[data-project-tab]'));
    if (tabs.length < 2 || !list.getClientRects().length) return;
    var index = tabs.findIndex(function(tab) { return tab.dataset.projectTab === select.value; });
    if (index < 0) return;
    event.preventDefault();
    index = (index + (event.key === 'ArrowRight' ? 1 : -1) + tabs.length) % tabs.length;
    switchProject(tabs[index].dataset.projectTab);
   });
   window.openVibelyProjectTabsSync = sync;
   render();
  }
  if (document.readyState === 'loading') document.addEventListener('DOMContentLoaded', installProjectTabs, {once: true});
  else installProjectTabs();
 })();
 </script>
}

func fmtBool(value bool) string {
	if value {
		return "true"
	}
	return "false"
}
func tabIndex(active bool) string {
	if active {
		return "0"
	}
	return "-1"
}
