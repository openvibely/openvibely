package layout

import (
	"encoding/json"
	"runtime"

	"github.com/openvibely/openvibely/internal/models"
)

func pinnedProjects(projects []models.Project, ids []string) []models.Project {
	byID := make(map[string]models.Project, len(projects))
	for _, project := range projects {
		byID[project.ID] = project
	}
	result := make([]models.Project, 0, len(ids))
	for _, id := range ids {
		if project, ok := byID[id]; ok {
			result = append(result, project)
			delete(byID, id)
		}
	}
	return result
}

func pinnedProjectJSON(projects []models.Project) string {
	ids := make([]string, 0, len(projects))
	for _, project := range projects {
		ids = append(ids, project.ID)
	}
	value, _ := json.Marshal(ids)
	return string(value)
}

templ DesktopProjectTabs(projects []models.Project, currentProjectID string) {
	<style>
  [data-openvibely-runtime="desktop"] body > .drawer { height: calc(100% - 46px); }
  [data-openvibely-runtime="desktop"] #sidebar { height: calc(100dvh - 46px); }
  [data-openvibely-runtime="desktop"] .drawer-side { top: 46px; height: calc(100dvh - 46px); }
  @media (min-width: 1024px) { [data-openvibely-runtime="desktop"] .drawer-side { top: 0; } }
  #desktop-project-titlebar { height: 46px; display: flex; align-items: center; gap: 6px; padding: 0 8px; box-sizing: border-box; --wails-draggable: drag; user-select: none; --project-tab-selected: color-mix(in oklch, oklch(var(--b2)), oklch(var(--bc)) 24%); border-bottom: 1px solid var(--project-tab-selected); }
  #desktop-project-titlebar button, #desktop-project-titlebar [data-project-selector], #desktop-project-titlebar dialog { --wails-draggable: no-drag; }
  #desktop-project-titlebar button:focus-visible { outline: 2px solid oklch(var(--p)); outline-offset: -2px; }
  #desktop-project-tabs { display: flex; min-width: 0; overflow-x: auto; scrollbar-width: thin; gap: 4px; align-self: stretch; padding: 6px 10px 0; }
  .desktop-project-tab { display: flex; align-items: center; flex: 0 0 240px; width: 240px; position: relative; border-radius: 16px 16px 0 0; background: oklch(var(--b2)); --wails-draggable: no-drag; }
  .desktop-project-tab:has([aria-selected="true"]) { background: var(--project-tab-selected); z-index: 1; }
  .desktop-project-tab:has([aria-selected="true"])::before, .desktop-project-tab:has([aria-selected="true"])::after { content: ""; position: absolute; bottom: 0; width: 10px; height: 10px; pointer-events: none; }
  .desktop-project-tab:has([aria-selected="true"])::before { left: -10px; background: radial-gradient(circle at 0 0, transparent 10px, var(--project-tab-selected) 10.5px); }
  .desktop-project-tab:has([aria-selected="true"])::after { right: -10px; background: radial-gradient(circle at 100% 0, transparent 10px, var(--project-tab-selected) 10.5px); }
  .desktop-project-tab [role="tab"] { width: 100%; height: 100%; border-radius: inherit; text-align: left; color: inherit; background: transparent; padding: 0 40px 0 16px; min-width: 0; overflow: hidden; text-overflow: ellipsis; white-space: nowrap; font-size: 13px; }
  .desktop-project-tab [data-close-project] { position: absolute; right: 8px; top: 50%; transform: translateY(-50%); width: 24px; height: 24px; display: flex; align-items: center; justify-content: center; padding: 0; line-height: 1; border-radius: 50%; }
  .desktop-project-tab:not(:has([aria-selected="true"])) [role="tab"]:hover { background: oklch(var(--bc) / .08); border-radius: 999px; background-clip: padding-box; border: 4px solid transparent; padding-left: 12px; padding-right: 36px; }
  .desktop-project-tab:has([aria-selected="true"]):hover { background: var(--project-tab-selected); }
  .desktop-project-tab [data-close-project]:hover { background: oklch(var(--bc) / .18); }
  #new-project-btn { flex-shrink: 0; width: 30px; height: 30px; align-self: center; border-radius: 50%; }
 #new-project-btn:hover { background: oklch(var(--bc) / .12); }
 #project-tab-menu { position: fixed; margin: 0; padding: 4px; border: 1px solid oklch(var(--bc) / .2); border-radius: 8px; background: oklch(var(--b1)); color: oklch(var(--bc)); --wails-draggable: no-drag; }
 #project-tab-menu button { display: block; width: 100%; text-align: left; padding: 8px 16px; border-radius: 4px; }
 #project-tab-menu button:hover { background: oklch(var(--bc) / .12); }
  .desktop-titlebar-space { flex: 1; min-width: 24px; height: 100%; }
  #desktop-project-titlebar [data-project-selector] { margin: 0; width: 150px; flex-shrink: 0; display: flex; flex-direction: row; align-items: center; gap: 5px; }
  #desktop-project-titlebar [data-project-selector] > div:first-child { margin: 0; order: 2; flex-shrink: 0; }
  #desktop-project-titlebar [data-project-selector] .label-text { display: none; }
	  #desktop-project-titlebar #project-selector-trigger { width: 150px; }
	  .desktop-window-controls { display: flex; align-items: center; align-self: stretch; flex-shrink: 0; --wails-draggable: no-drag; }
	  .desktop-window-controls button { display: flex; align-items: center; justify-content: center; padding: 0; width: 46px; height: 100%; color: inherit; }
	  .desktop-window-controls svg { width: 12px; height: 12px; pointer-events: none; }
	  .desktop-window-controls:not(.desktop-traffic-lights) button:hover { background: oklch(var(--bc) / .12); }
	  .desktop-window-controls:not(.desktop-traffic-lights) button:last-child:hover { background: #c42b1c; color: white; }
	  .desktop-traffic-lights { gap: 8px; padding: 0 12px 0 8px; }
		  .desktop-traffic-lights button { position: relative; flex: 0 0 12px; width: 12px; height: 12px; border-radius: 50%; border: 0; appearance: none; }
		  .desktop-traffic-lights [data-wml-window="Close"] { background: #ff5f57; color: #4c0000; box-shadow: inset 0 0 0 .5px #e0443e; }
		  .desktop-traffic-lights [data-wml-window="Minimise"] { background: #febc2e; color: #995700; box-shadow: inset 0 0 0 .5px #dea123; }
		  .desktop-traffic-lights [data-wml-window="ToggleFullscreen"] { background: #28c840; color: #006500; box-shadow: inset 0 0 0 .5px #1aab29; }
		  .desktop-traffic-lights svg { position: absolute; left: 50%; top: 50%; transform: translate(-50%, -50%); width: 12px; height: 12px; opacity: 0; }	  .desktop-traffic-lights:hover svg, .desktop-traffic-lights button:focus-visible svg { opacity: 1; }
	  .desktop-traffic-lights button:active { filter: brightness(.85); } </style>
	<header id="desktop-project-titlebar" class="bg-base-200" data-platform={ runtime.GOOS } data-pinned-projects={ pinnedProjectJSON(pinnedProjects(projects, uiPreferences(ctx).PinnedProjectIDs)) } aria-label="Project title bar">
			if runtime.GOOS == "darwin" {
				<div class="desktop-window-controls desktop-traffic-lights" role="group" aria-label="Window controls">
					<button type="button" data-wml-window="Close" aria-label="Close window" title="Close"><svg viewBox="0 0 12 12" fill="none" stroke="currentColor" stroke-width="1" stroke-linecap="round" aria-hidden="true"><path d="M3.5 3.5l5 5m0-5-5 5"/></svg></button>
					<button type="button" data-wml-window="Minimise" aria-label="Minimize window" title="Minimize"><svg viewBox="0 0 12 12" fill="none" stroke="currentColor" stroke-width="1" aria-hidden="true"><path d="M2.5 6h7"/></svg></button>
					<button type="button" data-wml-window="ToggleFullscreen" aria-label="Enter or exit fullscreen" title="Enter or exit fullscreen"><svg viewBox="0 0 12 12" fill="currentColor" aria-hidden="true"><path data-fullscreen-glyph d="M2.5 2.5h4l-4 4zm7 7h-4l4-4z"/><path data-restore-glyph d="M2 5.5h3.5V2zm8 1H6.5V10z" style="display: none"/></svg></button>
				</div>
			}
			<div id="desktop-project-tabs" role="tablist" aria-label="Pinned projects">			for _, project := range pinnedProjects(projects, uiPreferences(ctx).PinnedProjectIDs) {
				<div class="desktop-project-tab">
					<button type="button" role="tab" aria-selected={ fmtBool(project.ID == currentProjectID) } tabindex={ tabIndex(project.ID == currentProjectID) } data-project-tab={ project.ID } title={ project.Name }>{ project.Name }</button>
					<button type="button" data-close-project={ project.ID } aria-label={ "Close project tab: " + project.Name } title="Close tab (unpin)">×</button>
				</div>
			}
		<button id="new-project-btn" type="button" aria-label="Create project" title="Create project">+</button>
        </div>

		<div class="desktop-titlebar-space" aria-hidden="true"></div>
		@ProjectSelector(projects, currentProjectID)
			if runtime.GOOS != "darwin" {
				<div class="desktop-window-controls" role="group" aria-label="Window controls">
					<button type="button" data-wml-window="Minimise" aria-label="Minimize window" title="Minimize"><svg viewBox="0 0 12 12" fill="none" stroke="currentColor" aria-hidden="true"><path d="M1 6h10"/></svg></button>
					<button type="button" data-wml-window="ToggleMaximise" aria-label="Maximize or restore window" title="Maximize or restore"><svg viewBox="0 0 12 12" fill="none" stroke="currentColor" aria-hidden="true"><rect x="1.5" y="1.5" width="9" height="9"/></svg></button>
					<button type="button" data-wml-window="Close" aria-label="Close window" title="Close"><svg viewBox="0 0 12 12" fill="none" stroke="currentColor" aria-hidden="true"><path d="m1 1 10 10m0-10L1 11"/></svg></button>
				</div>
			}

	</header>
 <div id="project-tab-menu" popover="manual" role="menu" aria-label="Project tab"><button type="button" role="menuitem" id="project-tab-pin-action">Pin</button><button type="button" role="menuitem" id="project-tab-settings-action">Project Settings</button></div>
	<script>
 (function() {
  function installProjectTabs() {
   var bar = document.getElementById('desktop-project-titlebar');
   var select = document.getElementById('project-selector');
   var list = document.getElementById('desktop-project-tabs');
   var menu = document.getElementById('project-tab-menu');
 var pin = document.getElementById('project-tab-pin-action');
 var menuTab;
 var add = document.getElementById('new-project-btn');
 list.append(add);
   if (!bar || !select || bar.dataset.installed) return;
   bar.dataset.installed = 'true';
   var fullscreenButton = bar.querySelector('[data-wml-window="ToggleFullscreen"]');
   if (fullscreenButton && window.wails && window.wails.Events) {
    var fullscreenRevision = 0;
    function showFullscreenState(fullscreen) {
     fullscreenButton.querySelector('[data-fullscreen-glyph]').style.display = fullscreen ? 'none' : '';
     fullscreenButton.querySelector('[data-restore-glyph]').style.display = fullscreen ? '' : 'none';
     fullscreenButton.title = fullscreen ? 'Exit fullscreen' : 'Enter fullscreen';
     fullscreenButton.setAttribute('aria-label', fullscreenButton.title);
    }
    window.wails.Events.On('common:WindowFullscreen', function() { fullscreenRevision++; showFullscreenState(true); });
    window.wails.Events.On('common:WindowUnFullscreen', function() { fullscreenRevision++; showFullscreenState(false); });
    window.wails.Window.IsFullscreen().then(function(value) {
     if (fullscreenRevision === 0) showFullscreenState(value);
    }).catch(function() {});
   }
   bar.addEventListener('dblclick', function(event) {
    if (getComputedStyle(event.target).getPropertyValue('--wails-draggable').trim() !== 'drag') return;
    if (window.wails && window.wails.Window) window.wails.Window.ToggleMaximise();
   });
   var ids = JSON.parse(bar.dataset.pinnedProjects);
   var openIDs = ids.slice();
 var closedActive = "";
 var saveQueue = Promise.resolve();
   function savePins() {
    bar.dataset.pinnedProjects = JSON.stringify(ids);
    var payload = JSON.stringify({pinned_project_ids: ids});
    // Serialize saves so rapid pin/unpin clicks cannot persist out of order.
    saveQueue = saveQueue.catch(function() {}).then(function() {
     return fetch('/ui/preferences', {method: 'POST', headers: {'Content-Type': 'application/json'}, body: payload, keepalive: true}).then(function(response) {
      if (!response.ok) throw new Error('Could not save pinned projects');
     });
    }).catch(function() { if (window.showToast) window.showToast('Could not save pinned projects. Try again.', 'failed'); });
   }
   function switchProject(id) {
    select.value = id;
    select.dispatchEvent(new Event('change', {bubbles: true}));
    return select.value === id;
   }
   function sync() {
    var active = select.value;
 if (active && !openIDs.includes(active) && active !== closedActive) { openIDs.push(active); render(); return; }
    list.querySelectorAll('[data-project-tab]').forEach(function(tab, index) {
     tab.setAttribute('aria-selected', String(tab.dataset.projectTab === active));
     tab.tabIndex = tab.dataset.projectTab === active || (ids.indexOf(active) === -1 && index === 0) ? 0 : -1;
    });
    var activeTab = list.querySelector('[aria-selected="true"]');
    if (activeTab) activeTab.scrollIntoView({block: 'nearest', inline: 'nearest'});
   }
   function render() {
    list.replaceChildren();
    openIDs.forEach(function(id) {
     var option = Array.from(select.options).find(function(option) { return option.value === id; });
     if (!option) return;
     var wrapper = document.createElement('div'); wrapper.className = 'desktop-project-tab';
     var tab = document.createElement('button'); tab.type = 'button'; tab.setAttribute('role', 'tab'); tab.dataset.projectTab = id; tab.textContent = option.textContent.trim(); tab.title = tab.textContent;
     var close = document.createElement('button'); close.type = 'button'; close.dataset.closeProject = id; close.textContent = '×'; close.title = 'Close tab (unpin)'; close.setAttribute('aria-label', 'Close project tab: ' + tab.textContent);
     wrapper.append(tab, close); list.append(wrapper);
    });
    list.append(add);
    sync();
   }
   function openMenu(tab, x, y) {
    menuTab = tab;
    pin.textContent = ids.includes(tab.dataset.projectTab) ? 'Unpin' : 'Pin';
    menu.showPopover();
    menu.style.left = Math.max(0, Math.min(x, innerWidth - menu.offsetWidth)) + 'px';
    menu.style.top = Math.max(0, Math.min(y, innerHeight - menu.offsetHeight)) + 'px';
    pin.focus();
   }
   list.addEventListener('contextmenu', function(event) {
    var wrapper = event.target.closest('.desktop-project-tab');
    if (!wrapper) return;
    event.preventDefault(); openMenu(wrapper.querySelector('[data-project-tab]'), event.clientX, event.clientY);
   });
   list.addEventListener('keydown', function(event) {
    if (event.key !== 'ContextMenu' && !(event.shiftKey && event.key === 'F10')) return;
    var tab = event.target.closest('[data-project-tab]'); if (!tab) return;
    event.preventDefault(); var rect = tab.getBoundingClientRect(); openMenu(tab, rect.left, rect.bottom);
   });
   document.addEventListener('pointerdown', function(event) {
    if (!menu.contains(event.target)) menu.hidePopover();
   });
   window.addEventListener('resize', function() { menu.hidePopover(); });
   list.addEventListener('scroll', function() { menu.hidePopover(); });
   menu.addEventListener('keydown', function(event) {
    if (event.key === 'ArrowDown' || event.key === 'ArrowUp') {
     event.preventDefault(); var items = Array.from(menu.querySelectorAll('[role=menuitem]'));
     items[(items.indexOf(document.activeElement) + (event.key === 'ArrowDown' ? 1 : items.length - 1)) % items.length].focus();
    }
    if (event.key === 'Escape' || event.key === 'Tab') { menu.hidePopover(); if (menuTab) menuTab.focus(); } });
   document.getElementById('project-tab-settings-action').addEventListener('click', function() {
    if (!menuTab) return;
    menu.hidePopover();
    htmx.ajax('GET', '/projects/' + encodeURIComponent(menuTab.dataset.projectTab) + '/edit', {target: document.getElementById('project-settings-container'), swap: 'innerHTML'});
   });
   pin.addEventListener('click', function() {
    if (!menuTab) return;
    var id = menuTab.dataset.projectTab;
    var index = ids.indexOf(id);
    if (index === -1) ids.push(id); else ids.splice(index, 1);
    menu.hidePopover(); menuTab.focus(); savePins();
   });
   list.addEventListener('click', function(event) {
    var tab = event.target.closest('[data-project-tab]');
    if (tab) { switchProject(tab.dataset.projectTab); return; }
    var close = event.target.closest('[data-close-project]');
    if (!close) return;
    var index = openIDs.indexOf(close.dataset.closeProject);
    var next = openIDs[index + 1] || openIDs[index - 1];
    if (close.dataset.closeProject === select.value && next && !switchProject(next)) return;
    closedActive = close.dataset.closeProject;
 openIDs.splice(index, 1); ids = ids.filter(function(id) { return id !== close.dataset.closeProject; }); render(); savePins();
    var focus = list.querySelector('[aria-selected="true"]') || list.querySelector('[data-project-tab]') || add;
    focus.focus();
   });
   list.addEventListener('keydown', function(event) {
    var tab = event.target.closest('[data-project-tab]');
    if (!tab) return;
    var tabs = Array.from(list.querySelectorAll('[data-project-tab]'));
    var index = tabs.indexOf(tab);
    if (event.key === 'ArrowRight') index = (index + 1) % tabs.length;
    else if (event.key === 'ArrowLeft') index = (index + tabs.length - 1) % tabs.length;
    else if (event.key === 'Home') index = 0;
    else if (event.key === 'End') index = tabs.length - 1;
    else if (event.key === 'Delete') { event.preventDefault(); tab.parentElement.querySelector('[data-close-project]').click(); return; }
    else return;
    event.preventDefault();
    tabs.forEach(function(item) { item.tabIndex = -1; });
    tabs[index].tabIndex = 0; tabs[index].focus(); tabs[index].scrollIntoView({block: 'nearest', inline: 'nearest'});
   });
   window.openVibelyProjectTabsSync = sync;
   sync();
  }
  if (document.readyState === 'loading') document.addEventListener('DOMContentLoaded', installProjectTabs, {once: true});
  else installProjectTabs();
 })();
 </script>
}

func fmtBool(value bool) string {
	if value {
		return "true"
	}
	return "false"
}
func tabIndex(active bool) string {
	if active {
		return "0"
	}
	return "-1"
}
