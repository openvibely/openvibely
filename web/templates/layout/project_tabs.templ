package layout

import (
	"encoding/json"
	"runtime"
	"slices"

	"github.com/openvibely/openvibely/internal/models"
)

func pinnedProjects(projects []models.Project, ids []string) []models.Project {
	byID := make(map[string]models.Project, len(projects))
	for _, project := range projects {
		byID[project.ID] = project
	}
	result := make([]models.Project, 0, len(ids))
	for _, id := range ids {
		if project, ok := byID[id]; ok {
			result = append(result, project)
			delete(byID, id)
		}
	}
	return result
}

func pinnedProjectJSON(projects []models.Project) string {
	ids := make([]string, 0, len(projects))
	for _, project := range projects {
		ids = append(ids, project.ID)
	}
	value, _ := json.Marshal(ids)
	return string(value)
}

templ DesktopProjectTabs(projects []models.Project, currentProjectID string) {
	<style>
  [data-openvibely-runtime="desktop"] body > .drawer { height: calc(100% - 46px); }
  [data-openvibely-runtime="desktop"] #sidebar { height: calc(100dvh - 46px); }
  [data-openvibely-runtime="desktop"] .drawer-side { top: 46px; height: calc(100dvh - 46px); }
  @media (min-width: 1024px) { [data-openvibely-runtime="desktop"] .drawer-side { top: 0; } }
  #desktop-project-titlebar { height: 46px; display: flex; align-items: center; gap: 6px; padding: 0 8px; box-sizing: border-box; --wails-draggable: drag; user-select: none; border-bottom: 1px solid oklch(var(--bc) / .15); }
  #desktop-project-titlebar button, #desktop-project-titlebar [data-project-selector], #desktop-project-titlebar dialog { --wails-draggable: no-drag; }
  #desktop-project-titlebar button:focus-visible { outline: 2px solid oklch(var(--p)); outline-offset: -2px; }
  #desktop-project-tabs { display: flex; min-width: 0; overflow-x: auto; scrollbar-width: thin; gap: 4px; align-self: stretch; padding-top: 6px; }
  .desktop-project-tab { display: flex; align-items: center; flex: 0 0 240px; width: 240px; position: relative; border-radius: 10px 10px 0 0; background: oklch(var(--b2)); --wails-draggable: no-drag; }
  .desktop-project-tab:has([aria-selected="true"]) { background: oklch(var(--b1)); }
  .desktop-project-tab [role="tab"] { width: 100%; height: 100%; border-radius: inherit; text-align: left; color: inherit; background: transparent; padding: 0 40px 0 16px; min-width: 0; overflow: hidden; text-overflow: ellipsis; white-space: nowrap; font-size: 13px; }
  .desktop-project-tab [data-close-project] { position: absolute; right: 8px; top: 50%; transform: translateY(-50%); width: 24px; height: 24px; display: flex; align-items: center; justify-content: center; padding: 0; line-height: 1; border-radius: 50%; }
  .desktop-project-tab:hover { background: oklch(var(--bc) / .08); }
  .desktop-project-tab:has([aria-selected="true"]):hover { background: oklch(var(--b1)); }
  .desktop-project-tab [data-close-project]:hover { background: oklch(var(--bc) / .18); }
  #project-pin-toggle { flex-shrink: 0; }
  .desktop-titlebar-space { flex: 1; min-width: 24px; height: 100%; }
  #desktop-project-titlebar [data-project-selector] { margin: 0; width: 210px; flex-shrink: 0; display: flex; flex-direction: row; align-items: center; gap: 5px; }
  #desktop-project-titlebar [data-project-selector] > div:first-child { margin: 0; order: 2; flex-shrink: 0; }
  #desktop-project-titlebar [data-project-selector] .label-text { display: none; }
	  #desktop-project-titlebar #project-selector-trigger { width: 150px; }
	  .desktop-window-controls { display: flex; align-items: center; align-self: stretch; flex-shrink: 0; --wails-draggable: no-drag; }
	  .desktop-window-controls button { display: flex; align-items: center; justify-content: center; padding: 0; width: 46px; height: 100%; color: inherit; }
	  .desktop-window-controls svg { width: 12px; height: 12px; pointer-events: none; }
	  .desktop-window-controls:not(.desktop-traffic-lights) button:hover { background: oklch(var(--bc) / .12); }
	  .desktop-window-controls:not(.desktop-traffic-lights) button:last-child:hover { background: #c42b1c; color: white; }
	  .desktop-traffic-lights { gap: 8px; padding: 0 12px 0 8px; }
	  .desktop-traffic-lights button { width: 12px; height: 12px; border-radius: 50%; border: 1px solid rgb(0 0 0 / .12); color: rgb(0 0 0 / .65); }
	  .desktop-traffic-lights [data-wml-window="Close"] { background: #ff5f57; color: #4c0000; }
	  .desktop-traffic-lights [data-wml-window="Minimise"] { background: #febc2e; color: #995700; }
	  .desktop-traffic-lights [data-wml-window="ToggleFullscreen"] { background: #28c840; color: #006500; }
	  .desktop-traffic-lights svg { width: 8px; height: 8px; opacity: 0; }
	  .desktop-traffic-lights:hover svg, .desktop-traffic-lights button:focus-visible svg { opacity: 1; }
	  .desktop-traffic-lights button:active { filter: brightness(.85); } </style>
	<header id="desktop-project-titlebar" class="bg-base-200" data-platform={ runtime.GOOS } data-pinned-projects={ pinnedProjectJSON(pinnedProjects(projects, uiPreferences(ctx).PinnedProjectIDs)) } aria-label="Project title bar">
			if runtime.GOOS == "darwin" {
				<div class="desktop-window-controls desktop-traffic-lights" role="group" aria-label="Window controls">
					<button type="button" data-wml-window="Close" aria-label="Close window" title="Close"><svg viewBox="0 0 10 10" fill="none" stroke="currentColor" stroke-width="1.5" aria-hidden="true"><path d="m1.5 1.5 7 7m0-7-7 7"/></svg></button>
					<button type="button" data-wml-window="Minimise" aria-label="Minimize window" title="Minimize"><svg viewBox="0 0 10 10" fill="none" stroke="currentColor" stroke-width="1.5" aria-hidden="true"><path d="M1 5h8"/></svg></button>
					<button type="button" data-wml-window="ToggleFullscreen" aria-label="Enter or exit fullscreen" title="Enter or exit fullscreen"><svg viewBox="0 0 10 10" fill="currentColor" aria-hidden="true"><path d="M1 1h4L1 5zm8 8H5l4-4z"/></svg></button>
				</div>
			}
			<div id="desktop-project-tabs" role="tablist" aria-label="Pinned projects">			for _, project := range pinnedProjects(projects, uiPreferences(ctx).PinnedProjectIDs) {
				<div class="desktop-project-tab">
					<button type="button" role="tab" aria-selected={ fmtBool(project.ID == currentProjectID) } tabindex={ tabIndex(project.ID == currentProjectID) } data-project-tab={ project.ID } title={ project.Name }>{ project.Name }</button>
					<button type="button" data-close-project={ project.ID } aria-label={ "Close project tab: " + project.Name } title="Close tab (unpin)">×</button>
				</div>
			}
		</div>
		<div class="desktop-titlebar-space" aria-hidden="true"></div>
		<button id="project-pin-toggle" type="button" class="btn btn-ghost btn-sm" aria-label="Toggle pin for current project" aria-pressed={ fmtBool(slices.Contains(uiPreferences(ctx).PinnedProjectIDs, currentProjectID)) } disabled?={ len(projects) == 0 }>
			if slices.Contains(uiPreferences(ctx).PinnedProjectIDs, currentProjectID) {
				Unpin
			} else {
				Pin
			}
		</button>
			@ProjectSelector(projects, currentProjectID)
			if runtime.GOOS != "darwin" {
				<div class="desktop-window-controls" role="group" aria-label="Window controls">
					<button type="button" data-wml-window="Minimise" aria-label="Minimize window" title="Minimize"><svg viewBox="0 0 12 12" fill="none" stroke="currentColor" aria-hidden="true"><path d="M1 6h10"/></svg></button>
					<button type="button" data-wml-window="ToggleMaximise" aria-label="Maximize or restore window" title="Maximize or restore"><svg viewBox="0 0 12 12" fill="none" stroke="currentColor" aria-hidden="true"><rect x="1.5" y="1.5" width="9" height="9"/></svg></button>
					<button type="button" data-wml-window="Close" aria-label="Close window" title="Close"><svg viewBox="0 0 12 12" fill="none" stroke="currentColor" aria-hidden="true"><path d="m1 1 10 10m0-10L1 11"/></svg></button>
				</div>
			}

	</header>
	<script>
 (function() {
  function installProjectTabs() {
   var bar = document.getElementById('desktop-project-titlebar');
   var select = document.getElementById('project-selector');
   var list = document.getElementById('desktop-project-tabs');
   var pin = document.getElementById('project-pin-toggle');
   if (!bar || !select || bar.dataset.installed) return;
   bar.dataset.installed = 'true';
   bar.addEventListener('dblclick', function(event) {
    if (getComputedStyle(event.target).getPropertyValue('--wails-draggable').trim() !== 'drag') return;
    if (window.wails && window.wails.Window) window.wails.Window.ToggleMaximise();
   });
   var ids = JSON.parse(bar.dataset.pinnedProjects);
   var saveQueue = Promise.resolve();
   function savePins() {
    bar.dataset.pinnedProjects = JSON.stringify(ids);
    var payload = JSON.stringify({pinned_project_ids: ids});
    // Serialize saves so rapid pin/unpin clicks cannot persist out of order.
    saveQueue = saveQueue.catch(function() {}).then(function() {
     return fetch('/ui/preferences', {method: 'POST', headers: {'Content-Type': 'application/json'}, body: payload, keepalive: true}).then(function(response) {
      if (!response.ok) throw new Error('Could not save pinned projects');
     });
    }).catch(function() { if (window.showToast) window.showToast('Could not save pinned projects. Try again.', 'failed'); });
   }
   function switchProject(id) {
    select.value = id;
    select.dispatchEvent(new Event('change', {bubbles: true}));
    return select.value === id;
   }
   function sync() {
    var active = select.value;
    list.querySelectorAll('[data-project-tab]').forEach(function(tab, index) {
     tab.setAttribute('aria-selected', String(tab.dataset.projectTab === active));
     tab.tabIndex = tab.dataset.projectTab === active || (ids.indexOf(active) === -1 && index === 0) ? 0 : -1;
    });
    var pinned = ids.indexOf(active) !== -1;
    pin.setAttribute('aria-pressed', String(pinned));
    pin.setAttribute('aria-label', pinned ? 'Unpin current project' : 'Pin current project');
    pin.textContent = pinned ? 'Unpin' : 'Pin';
    var activeTab = list.querySelector('[aria-selected="true"]');
    if (activeTab) activeTab.scrollIntoView({block: 'nearest', inline: 'nearest'});
   }
   function render() {
    list.replaceChildren();
    ids.forEach(function(id) {
     var option = Array.from(select.options).find(function(option) { return option.value === id; });
     if (!option) return;
     var wrapper = document.createElement('div'); wrapper.className = 'desktop-project-tab';
     var tab = document.createElement('button'); tab.type = 'button'; tab.setAttribute('role', 'tab'); tab.dataset.projectTab = id; tab.textContent = option.textContent.trim(); tab.title = tab.textContent;
     var close = document.createElement('button'); close.type = 'button'; close.dataset.closeProject = id; close.textContent = '×'; close.title = 'Close tab (unpin)'; close.setAttribute('aria-label', 'Close project tab: ' + tab.textContent);
     wrapper.append(tab, close); list.append(wrapper);
    });
    sync();
   }
   pin.addEventListener('click', function() {
    if (!select.value) return;
    var index = ids.indexOf(select.value);
    if (index === -1) ids.push(select.value); else ids.splice(index, 1);
    render(); savePins();
   });
   list.addEventListener('click', function(event) {
    var tab = event.target.closest('[data-project-tab]');
    if (tab) { switchProject(tab.dataset.projectTab); return; }
    var close = event.target.closest('[data-close-project]');
    if (!close) return;
    var index = ids.indexOf(close.dataset.closeProject);
    var next = ids[index + 1] || ids[index - 1];
    if (close.dataset.closeProject === select.value && next && !switchProject(next)) return;
    ids.splice(index, 1); render(); savePins();
    var focus = list.querySelector('[aria-selected="true"]') || list.querySelector('[data-project-tab]') || pin;
    focus.focus();
   });
   list.addEventListener('keydown', function(event) {
    var tab = event.target.closest('[data-project-tab]');
    if (!tab) return;
    var tabs = Array.from(list.querySelectorAll('[data-project-tab]'));
    var index = tabs.indexOf(tab);
    if (event.key === 'ArrowRight') index = (index + 1) % tabs.length;
    else if (event.key === 'ArrowLeft') index = (index + tabs.length - 1) % tabs.length;
    else if (event.key === 'Home') index = 0;
    else if (event.key === 'End') index = tabs.length - 1;
    else if (event.key === 'Delete') { event.preventDefault(); tab.parentElement.querySelector('[data-close-project]').click(); return; }
    else return;
    event.preventDefault();
    tabs.forEach(function(item) { item.tabIndex = -1; });
    tabs[index].tabIndex = 0; tabs[index].focus(); tabs[index].scrollIntoView({block: 'nearest', inline: 'nearest'});
   });
   window.openVibelyProjectTabsSync = sync;
   sync();
  }
  if (document.readyState === 'loading') document.addEventListener('DOMContentLoaded', installProjectTabs, {once: true});
  else installProjectTabs();
 })();
 </script>
}

func fmtBool(value bool) string {
	if value {
		return "true"
	}
	return "false"
}
func tabIndex(active bool) string {
	if active {
		return "0"
	}
	return "-1"
}
