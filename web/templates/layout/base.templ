							}
							const options = savedKanbanInteraction && savedKanbanInteraction.refreshTaskOptions && openDropdown && openDropdown.querySelector('[data-task-card-merge-options]');
							const refreshURL = options && options.getAttribute('hx-get');
							if (options && refreshURL && window.htmx) {
