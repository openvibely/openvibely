						function normalizeThemeID(value) {
							value = String(value || '').trim();
							if (nativeThemeModes[value]) return value;
							if (value === 'light' || value === 'dark') return nativeThemeByMode[value];
							if (/^[a-z0-9][a-z0-9._:-]*$/i.test(value)) return value;
							return '';
