							if (liveBoard) restoreKanbanInteraction(liveBoard);
							const openDropdown = openKanbanMenuKey && liveBoard && Array.from(liveBoard.querySelectorAll('[data-kanban-menu-key]')).find(function(candidate) {
								return candidate.getAttribute('data-kanban-menu-key') === openKanbanMenuKey;
							});
							if (openDropdown && (!document.activeElement || !liveBoard.contains(document.activeElement))) {
								const fallbackTrigger = openDropdown.querySelector('[data-kanban-menu-trigger]');
								if (fallbackTrigger) {
									suppressKanbanMenuFocusOpen = true;
									fallbackTrigger.focus({preventScroll: true});
									suppressKanbanMenuFocusOpen = false;
									setKanbanMenuExpanded(openDropdown, true);
