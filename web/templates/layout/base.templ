					}

					// Otherwise, keep the Kanban dropdown hidden while its pre-rendered,
					// measurable content settles into fixed viewport coordinates, then reveal it.
					if (kanbanDropdown) {
						prepareKanbanMenuPosition(kanbanDropdown, label);
						openKanbanMenuKey = kanbanDropdown.getAttribute('data-kanban-menu-key') || '';
						const board = kanbanDropdown.closest('#kanban-board');
						if (board && openKanbanMenuKey) board.setAttribute('data-open-kanban-menu-key', openKanbanMenuKey);
						setKanbanMenuExpanded(kanbanDropdown, true);
						window.dispatchEvent(new CustomEvent('kanban-menu-opened'));
					} else {
						requestAnimationFrame(function() { positionDropdownForViewport(label); });
					}
				}

				function handleTaskSelect(event) {


					const clickedTaskID = event.currentTarget.getAttribute('data-task-id');
					if (clickedTaskID && clickedTaskID === suppressedTaskClickID) {
						event.preventDefault();
						event.stopPropagation();
						suppressedTaskClickID = '';
						return;
					}
					// Ignore clicks on links or their children (let HTMX handle them)
					if (event.target.tagName === 'A' || event.target.closest('a')) {
						return;
					}

					// Ignore clicks on buttons, dropdowns, or other interactive elements
					if (event.target.tagName === 'BUTTON' || event.target.closest('button') || event.target.closest('.dropdown')) {
						return;
					}

					const card = event.currentTarget;
					const taskID = card.getAttribute('data-task-id');

					// Cmd/Ctrl+Click for multi-selection
					if (event.metaKey || event.ctrlKey) {
						event.preventDefault();
						event.stopPropagation();

						if (selectedTasks.has(taskID)) {
							selectedTasks.delete(taskID);
							card.classList.remove('task-selected');
						} else {
							selectedTasks.add(taskID);
							card.classList.add('task-selected');
						}

						return;
					}

					// Normal click on card body → navigate to task detail page
					if (taskID) {
						window.openVibelyNavigate('/tasks/' + taskID);
					}
				}

				function clearSelection() {
					selectedTasks.forEach(id => {
						const el = document.getElementById('task-' + id);
						if (el) el.classList.remove('task-selected');
					});
					selectedTasks.clear();
					draggedTaskIds = [];
				}



				function beginPointerCardMotion(card) {
					const rect = card.getBoundingClientRect();
					const placeholder = document.createElement('div');
					placeholder.setAttribute('aria-hidden', 'true');
					placeholder.setAttribute('data-pointer-drag-placeholder', '');
					placeholder.style.height = rect.height + 'px';
					placeholder.style.marginBottom = getComputedStyle(card).marginBottom;
					card.parentNode.insertBefore(placeholder, card);
					const originalStyle = card.getAttribute('style');
					card.style.position = 'fixed';
					card.style.left = rect.left + 'px';
					card.style.top = rect.top + 'px';
					card.style.width = rect.width + 'px';
					card.style.height = rect.height + 'px';
					card.style.margin = '0';
					card.style.zIndex = '1000';
					card.style.pointerEvents = 'none';
					return { card: card, placeholder: placeholder, originalStyle: originalStyle };
				}

				function movePointerCard(motion, deltaX, deltaY) {
					if (motion) motion.card.style.transform = 'translate3d(' + deltaX + 'px, ' + deltaY + 'px, 0)';
				}

				function endPointerCardMotion(motion) {
					if (!motion) return;
					if (motion.placeholder) motion.placeholder.remove();
					if (motion.originalStyle === null) motion.card.removeAttribute('style');
					else motion.card.setAttribute('style', motion.originalStyle);
				}

				window.beginPointerCardMotion = beginPointerCardMotion;
				window.movePointerCard = movePointerCard;
				window.endPointerCardMotion = endPointerCardMotion;

				let taskPointerDrag = null;
				let suppressedTaskClickID = '';

				function taskPointerDropZoneAt(clientX, clientY) {
					const hit = document.elementFromPoint(clientX, clientY);
					return hit ? hit.closest('.category-drop-zone, .task-drop-zone') : null;
				}

				function beginTaskPointerDrag(event) {
					const state = taskPointerDrag;
					if (!state || state.started) return;
					state.started = true;
					window.isDragging = true;
					document.documentElement.classList.add('drag-cursor-active');
					document.body.classList.add('drag-cursor-active');
					draggedElement = state.card;
					const taskID = state.card.getAttribute('data-task-id');

					if (selectedTasks.has(taskID) && selectedTasks.size > 1) {
						draggedTaskIds = Array.from(selectedTasks);
					} else {
						clearSelection();
						draggedTaskIds = [taskID];
					}
					draggedTaskIds.forEach(id => {
						const card = document.getElementById('task-' + id);
						if (card) card.classList.add('dragging');
					});
					state.motion = beginPointerCardMotion(state.card);
				}

				function refreshTaskPointerDropZone(clientX, clientY) {
					const state = taskPointerDrag;
					if (!state || !state.started) return null;
					const zone = taskPointerDropZoneAt(clientX, clientY);
					if (state.dropZone !== zone) {
						if (state.dropZone) state.dropZone.classList.remove('drag-over');
						state.dropZone = zone;
						if (zone) zone.classList.add('drag-over');
					}
					return zone;
				}

				function updateTaskPointerDropZone(event) {
					const zone = refreshTaskPointerDropZone(event.clientX, event.clientY);
					const board = document.getElementById('kanban-board');
					handlePointerAutoScroll(event, board, zone, function() {
						refreshTaskPointerDropZone(event.clientX, event.clientY);
					});
				}

				function handleTaskPointerMove(event) {
					const state = taskPointerDrag;
					if (!state || event.pointerId !== state.pointerId) return;
					const deltaX = event.clientX - state.startX;
					const deltaY = event.clientY - state.startY;
					if (!state.started && Math.hypot(deltaX, deltaY) < 4) return;
					beginTaskPointerDrag(event);
					event.preventDefault();
					movePointerCard(state.motion, deltaX, deltaY);
					updateTaskPointerDropZone(event);
				}

				function cleanupTaskPointerDrag() {
					const state = taskPointerDrag;
					stopAutoScroll();
					if (state && state.dropZone) state.dropZone.classList.remove('drag-over');
					if (state) endPointerCardMotion(state.motion);
					document.querySelectorAll('.dragging').forEach(card => {
						card.classList.remove('dragging');
					});
					document.documentElement.classList.remove('drag-cursor-active');
					document.body.classList.remove('drag-cursor-active');
					window.removeEventListener('pointermove', handleTaskPointerMove, true);
					window.removeEventListener('pointerup', handleTaskPointerUp, true);
					window.removeEventListener('pointercancel', handleTaskPointerCancel, true);
					window.isDragging = false;
					taskPointerDrag = null;
					draggedElement = null;
					draggedTaskIds = [];
					if (state && state.started) document.dispatchEvent(new CustomEvent('task-pointer-dragend'));
				}

				function handleTaskPointerUp(event) {
					const state = taskPointerDrag;
					if (!state || event.pointerId !== state.pointerId) return;
					const dropZone = taskPointerDropZoneAt(event.clientX, event.clientY) || state.dropZone;
					if (state.started) {
						suppressedTaskClickID = state.card.getAttribute('data-task-id');
						if (dropZone) {
							const dropEvent = {
								currentTarget: dropZone,
								target: dropZone,
								clientY: event.clientY,
								stopPropagation: function() {},
								preventDefault: function() {}
							};
							if (dropZone.getAttribute('data-drop-type') === 'status') handleActiveDrop(dropEvent);
							else handleCategoryDrop(dropEvent);
						}
						setTimeout(function() { suppressedTaskClickID = ''; }, 0);
					}
					cleanupTaskPointerDrag();
				}

				function handleTaskPointerCancel(event) {
					const state = taskPointerDrag;
					if (!state || event.pointerId !== state.pointerId) return;
					cleanupTaskPointerDrag();
					draggedTaskIds = [];
				}

				function handleTaskPointerDown(event) {
					if (event.button !== 0 || taskPointerDrag) return;
					if (event.target && event.target.closest('button, a, input, select, textarea, summary, label, [role="button"], .dropdown')) return;
					const card = event.currentTarget;
					taskPointerDrag = {
						card: card,
						pointerId: event.pointerId,
						startX: event.clientX,
						startY: event.clientY,
						started: false,
						dropZone: null
					};
					try { card.setPointerCapture(event.pointerId); } catch (_) {}
					window.addEventListener('pointermove', handleTaskPointerMove, true);
					window.addEventListener('pointerup', handleTaskPointerUp, true);
					window.addEventListener('pointercancel', handleTaskPointerCancel, true);
				}

				window.handleTaskPointerDown = handleTaskPointerDown;

				function stopAutoScroll() {
					if (autoScrollInterval) {
						clearInterval(autoScrollInterval);
						autoScrollInterval = null;
					}
					currentScrollZone = null;
					currentScrollDeltaX = 0;
					currentScrollDeltaY = 0;
					currentScrollRefresh = null;
				}

				let currentScrollDeltaX = 0;
				let currentScrollDeltaY = 0;
				let currentScrollRefresh = null;

				function startAutoScroll(scrollZone, deltaX, deltaY, refresh) {
					currentScrollRefresh = refresh || null;
					if (autoScrollInterval && currentScrollZone === scrollZone && currentScrollDeltaX === deltaX && currentScrollDeltaY === deltaY) return;
					stopAutoScroll();
					currentScrollZone = scrollZone;
					currentScrollDeltaX = deltaX;
					currentScrollDeltaY = deltaY;
					currentScrollRefresh = refresh || null;
					autoScrollInterval = setInterval(function() {
						if (!currentScrollZone) return stopAutoScroll();
						const previousLeft = currentScrollZone.scrollLeft;
						const previousTop = currentScrollZone.scrollTop;
						currentScrollZone.scrollLeft += currentScrollDeltaX;
						currentScrollZone.scrollTop += currentScrollDeltaY;
						if (currentScrollZone.scrollLeft === previousLeft && currentScrollZone.scrollTop === previousTop) return stopAutoScroll();
						if (currentScrollRefresh) currentScrollRefresh();
					}, 16);
				}

				function pointerAutoScrollDelta(event, scrollZone) {
					if (!scrollZone) return null;
					const rect = scrollZone.getBoundingClientRect();
					if (event.clientX < rect.left || event.clientX > rect.right || event.clientY < rect.top || event.clientY > rect.bottom) return null;
					const styles = getComputedStyle(scrollZone);
					const canScrollX = (styles.overflowX === 'auto' || styles.overflowX === 'scroll') && scrollZone.scrollWidth > scrollZone.clientWidth;
					const canScrollY = (styles.overflowY === 'auto' || styles.overflowY === 'scroll') && scrollZone.scrollHeight > scrollZone.clientHeight;
					const thresholdX = Math.min(80, rect.width / 3);
					const thresholdY = Math.min(80, rect.height / 3);
					let deltaX = 0;
					let deltaY = 0;
					if (canScrollX) {
						if (event.clientX - rect.left < thresholdX && scrollZone.scrollLeft > 0) deltaX = -8;
						else if (rect.right - event.clientX < thresholdX && scrollZone.scrollLeft + scrollZone.clientWidth < scrollZone.scrollWidth) deltaX = 8;
					}
					if (canScrollY) {
						if (event.clientY - rect.top < thresholdY && scrollZone.scrollTop > 0) deltaY = -8;
						else if (rect.bottom - event.clientY < thresholdY && scrollZone.scrollTop + scrollZone.clientHeight < scrollZone.scrollHeight) deltaY = 8;
					}
					return deltaX || deltaY ? { x: deltaX, y: deltaY } : null;
				}

				function handlePointerAutoScroll(event, outerContainer, innerContainer, refresh) {
					const outerDelta = pointerAutoScrollDelta(event, outerContainer);
					if (outerDelta) return startAutoScroll(outerContainer, outerDelta.x, outerDelta.y, refresh);
					const innerDelta = pointerAutoScrollDelta(event, innerContainer);
					if (innerDelta) return startAutoScroll(innerContainer, innerDelta.x, innerDelta.y, refresh);
					stopAutoScroll();
				}

				window.handlePointerAutoScroll = handlePointerAutoScroll;
				window.stopPointerAutoScroll = stopAutoScroll;

				// Drop handler for non-Active category columns (category change + reordering)
				function handleCategoryDrop(event) {
					event.stopPropagation();
					event.preventDefault();
					stopAutoScroll();
					const dropZone = event.currentTarget;
					dropZone.classList.remove('drag-over');

					if (draggedTaskIds.length === 0) return;

					const targetCategory = dropZone.getAttribute('data-category');
					console.log('[drag] CATEGORY DROP target=' + targetCategory + ' tasks=' + draggedTaskIds.join(','));
					const projectID = dropZone.getAttribute('data-project-id');

					// Only single task reordering is supported for now
					if (draggedTaskIds.length === 1) {
						const taskID = draggedTaskIds[0];
						const currentCategory = draggedElement.getAttribute('data-task-category');

						// Calculate drop position based on mouse Y position
						const dropPosition = getDropPosition(event, dropZone);
						console.log('[drag] DROP POSITION=' + dropPosition);

						// If same category, just reorder
						if (currentCategory === targetCategory) {
							if (dropPosition !== null) {
								htmx.ajax('PATCH', `/tasks/${taskID}/reorder`, {
									target: '#kanban-board',
									swap: 'outerHTML',
									values: { position: dropPosition }
								});
							}
						} else {
							// Different category - change category (which will auto-assign new position)
							htmx.ajax('PATCH', `/tasks/${taskID}/category`, {
								target: '#kanban-board',
								swap: 'outerHTML',
								values: { category: targetCategory }
							}).catch(function(err) {
								console.error('[drag] Category change failed:', err);
								// Show error message to user
								if (err.xhr && err.xhr.status === 400) {
									alert(err.xhr.responseText || 'Cannot move task to this category');
								}
							});
						}
					} else {
						// Multi-select batch category change. Clear selection before HTMX
						// request hooks snapshot the board, while retaining the payload IDs.
						const batchTaskIDs = draggedTaskIds.slice();
						clearSelection();
						htmx.ajax('PATCH', `/tasks/batch-category`, {
							target: '#kanban-board',
							swap: 'outerHTML',
							values: { task_ids: batchTaskIDs.join(','), category: targetCategory, project_id: projectID }
						}).catch(function(err) {
							console.error('[drag] Batch category change failed:', err);
							// Show error message to user
							if (err.xhr && err.xhr.status === 400) {
								alert(err.xhr.responseText || 'Cannot move tasks to this category');
							}
						});
					}

					clearSelection();
				}

				// Get drop position within a drop zone based on mouse Y coordinate
				function getDropPosition(event, dropZone) {
					const allCards = Array.from(dropZone.querySelectorAll('[data-task-id]'));
					// Filter out dragged elements to get accurate drop position
					const taskCards = allCards.filter(card => !draggedTaskIds.includes(card.getAttribute('data-task-id')));

					if (taskCards.length === 0) {
						return 0; // Empty zone, position 0
					}

					// Check if we're dragging the last card in the original list
					const lastCardInZone = allCards[allCards.length - 1];
					const draggingLastCard = lastCardInZone && draggedTaskIds.includes(lastCardInZone.getAttribute('data-task-id'));

					const mouseY = event.clientY;

					for (let i = 0; i < taskCards.length; i++) {
						const card = taskCards[i];
						const rect = card.getBoundingClientRect();

						// When dragging the last card, use 100% threshold for all cards
						// Otherwise, use 100% for non-last cards and 50% for the last card
						const isLastCard = i === taskCards.length - 1;
						const threshold = (draggingLastCard || !isLastCard) ? 1.0 : 0.5;
						const insertBeforeThreshold = rect.top + rect.height * threshold;

						// If mouse is above the threshold of this card, insert before it
						// Return the card's display_order (not the index in filtered array)
						if (mouseY < insertBeforeThreshold) {
							return parseInt(card.getAttribute('data-display-order'));
						}
					}

					// If we get here, mouse is below all cards, append to end
					// Return the last card's display_order + 1 to insert after it
					const lastCard = taskCards[taskCards.length - 1];
					return parseInt(lastCard.getAttribute('data-display-order')) + 1;
				}

				// Drop handler for Active column sub-groups (handles cross-column + status changes + reordering)
				function handleActiveDrop(event) {
					event.stopPropagation();
					event.preventDefault();
					stopAutoScroll();
					const dropZone = event.currentTarget;
					dropZone.classList.remove('drag-over');

					if (draggedTaskIds.length === 0) return;

					const targetStatus = dropZone.getAttribute('data-status');
					console.log('[drag] ACTIVE DROP targetStatus=' + targetStatus + ' tasks=' + draggedTaskIds.join(','));
					const projectID = dropZone.getAttribute('data-project-id');

					if (draggedTaskIds.length === 1) {
						const taskID = draggedTaskIds[0];
						const currentCategory = draggedElement.getAttribute('data-task-category');
						const currentStatus = draggedElement.getAttribute('data-task-status');

						// Calculate drop position
						const dropPosition = getDropPosition(event, dropZone);
						console.log('[drag] DROP POSITION=' + dropPosition);

						if (currentCategory !== 'active') {
							// Moving from different category to active
							htmx.ajax('PATCH', `/tasks/${taskID}/category`, {
								target: '#kanban-board',
								swap: 'outerHTML',
								values: { category: 'active' }
							}).catch(function(err) {
								console.error('[drag] Category change to active failed:', err);
								if (err.xhr && err.xhr.status === 400) {
									alert(err.xhr.responseText || 'Cannot move task to Active category');
								}
							});
						} else if (currentStatus !== targetStatus) {
							// Same category, different status
							htmx.ajax('PATCH', `/tasks/${taskID}/status`, {
								target: '#kanban-board',
								swap: 'outerHTML',
								values: { status: targetStatus }
							});
						} else if (dropPosition !== null) {
							// Same category, same status - just reorder
							htmx.ajax('PATCH', `/tasks/${taskID}/reorder`, {
								target: '#kanban-board',
								swap: 'outerHTML',
								values: { position: dropPosition }
							});
						}
					} else {
						// Multi-select drop into Active. Clear selection before HTMX
						// request hooks snapshot the board, while retaining the payload IDs.
						const batchTaskIDs = draggedTaskIds.slice();
						clearSelection();
						htmx.ajax('PATCH', `/tasks/batch-category`, {
							target: '#kanban-board',
							swap: 'outerHTML',
							values: { task_ids: batchTaskIDs.join(','), category: 'active', project_id: projectID }
						}).catch(function(err) {
							console.error('[drag] Batch category change to active failed:', err);
							if (err.xhr && err.xhr.status === 400) {
								alert(err.xhr.responseText || 'Cannot move tasks to Active category');
							}
						});
					}

					clearSelection();
				}

					window.openVibelyNavigate = function(url, historyURL) {
						var source = document.createElement('a');
						source.className = 'hidden';
						source.setAttribute('aria-hidden', 'true');
						source.setAttribute('tabindex', '-1');
						source.setAttribute('href', url);
						source.setAttribute('hx-get', url);
						source.setAttribute('hx-target', '#main-content');
						source.setAttribute('hx-swap', 'innerHTML');
						source.setAttribute('hx-push-url', historyURL || 'true');
						document.body.appendChild(source);
						var request = htmx.ajax('GET', url, {
							source: source,
							target: '#main-content',
							swap: 'innerHTML'
						});
						request.then(function() { source.remove(); }, function() { source.remove(); });
						return request;
					};

					window.syncOpenVibelyPageTitle = function(root) {
						if (!root) return;
						var marker = root.matches && root.matches('[data-openvibely-page-title]')
							? root
							: root.querySelector && root.querySelector('[data-openvibely-page-title]');
						if (!marker) return;
						document.title = marker.getAttribute('data-openvibely-page-title');
					};

					function syncOpenVibelyTitleFromHTMX(event) {
						var target = event && event.detail && event.detail.target;
						if (!target) target = document.getElementById('main-content');
						window.syncOpenVibelyPageTitle(target);
					}

					document.addEventListener('htmx:afterSwap', syncOpenVibelyTitleFromHTMX);
					document.addEventListener('htmx:historyRestore', function(event) {
						if (typeof resetKanbanInteractionForNavigation === 'function') resetKanbanInteractionForNavigation();
						syncOpenVibelyTitleFromHTMX(event);
					});
					if (window.addEventListener) window.addEventListener('popstate', function() {
						if (typeof resetKanbanInteractionForNavigation === 'function') resetKanbanInteractionForNavigation();
					});

					window.openVibelySubmitNavigate = function(form) {
						if (!form || !window.htmx) return Promise.reject(new Error('HTMX navigation unavailable'));
						var values = {};
						new FormData(form).forEach(function(value, key) { values[key] = value; });
						return htmx.ajax((form.getAttribute('method') || 'POST').toUpperCase(), form.getAttribute('action'), {
							source: form,
							target: '#main-content',
							swap: 'innerHTML',
							values: values
						});
					};

				// Scroll position restoration for drop zones
				// Interaction state is restored across the same authoritative kanban swaps.
				let savedScrollPositions = new Map();
				let savedKanbanInteraction = null;
				let openKanbanMenuKey = '';
				let suppressKanbanMenuFocusOpen = false;

				function kanbanMenuItemKey(element) {
					if (!element) return '';
					return [
						element.tagName,
						element.getAttribute('href') || '',
						element.getAttribute('hx-get') || '',
						element.getAttribute('hx-post') || '',
						element.getAttribute('hx-delete') || '',
						(element.textContent || '').trim().replace(/\s+/g, ' ')
					].join('|');
				}

				function snapshotKanbanInteraction(board) {
					const active = document.activeElement;
					let dropdown = kanbanDropdownForTarget(active);
					if (dropdown && (!board.contains(dropdown) || dropdown.getAttribute('data-kanban-menu-open') !== 'true')) dropdown = null;
					const durableMenuKey = board.getAttribute('data-open-kanban-menu-key') || openKanbanMenuKey;
					if (!dropdown && durableMenuKey) {
						dropdown = Array.from(board.querySelectorAll('[data-kanban-menu-key]')).find(function(candidate) {
							return candidate.getAttribute('data-kanban-menu-key') === durableMenuKey;
						}) || null;
					}
					let focusRole = dropdown && (!active || kanbanDropdownForTarget(active) !== dropdown) ? 'trigger' : '';
					let focusKey = '';
					if (dropdown && active && kanbanDropdownForTarget(active) === dropdown) {
						if (active.matches('[data-kanban-menu-trigger]')) focusRole = 'trigger';
						else if (active.matches('[data-kanban-menu-content]')) focusRole = 'content';
						else {
							focusRole = 'item';
							focusKey = kanbanMenuItemKey(active);
						}
					}
						savedKanbanInteraction = {
							selectedTaskIDs: Array.from(selectedTasks),
							menuKey: dropdown ? dropdown.getAttribute('data-kanban-menu-key') : '',
							focusRole: focusRole,
							focusKey: focusKey,
							refreshTaskOptions: !!(active && active.closest && active.closest('[data-task-card-merge-options]'))
						};				}

				function setKanbanMenuExpanded(dropdown, expanded) {
					const trigger = dropdown && dropdown.querySelector('[data-kanban-menu-trigger]');
					if (trigger) trigger.setAttribute('aria-expanded', expanded ? 'true' : 'false');
					if (dropdown) {
						if (expanded) dropdown.setAttribute('data-kanban-menu-open', 'true');
						else {
							dropdown.removeAttribute('data-kanban-menu-open');
							dropdown.removeAttribute('data-kanban-menu-positioning');
							closeKanbanSubmenus(dropdown, null);
						}
						const column = dropdown.closest('.kanban-column');
						if (column) {
							if (expanded) column.setAttribute('data-kanban-menu-column-open', 'true');
							else column.removeAttribute('data-kanban-menu-column-open');
						}
					}
				}

					function closeKanbanMenu(dropdown, restoreTriggerFocus) {
						const board = document.getElementById('kanban-board');
						const hadOpenMenu = !!openKanbanMenuKey || !!(board && board.getAttribute('data-open-kanban-menu-key'));
						openKanbanMenuKey = '';
						savedKanbanInteraction = null;
						const activeMenu = kanbanDropdownForTarget(document.activeElement);
						if (!restoreTriggerFocus && activeMenu && document.activeElement.blur) document.activeElement.blur();
						if (board) board.removeAttribute('data-open-kanban-menu-key');
						document.querySelectorAll('[data-kanban-menu-key]').forEach(function(candidate) {
							setKanbanMenuExpanded(candidate, false);
						});
						if (restoreTriggerFocus && dropdown) {
							const trigger = dropdown.querySelector('[data-kanban-menu-trigger]');
							if (trigger && document.contains(trigger)) {
								suppressKanbanMenuFocusOpen = true;
								trigger.focus({preventScroll: true});
								suppressKanbanMenuFocusOpen = false;
