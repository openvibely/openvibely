							navigator.clipboard.writeText(text).then(function() {
								btn.classList.add('copied');
								btn.innerHTML = '<svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M20 6L9 17l-5-5"></path></svg><span>Copied!</span>';
								setTimeout(function() {
									btn.classList.remove('copied');
									btn.innerHTML = '<svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><rect x="9" y="9" width="13" height="13" rx="2" ry="2"></rect><path d="M5 15H4a2 2 0 0 1-2-2V4a2 2 0 0 1 2-2h9a2 2 0 0 1 2 2v1"></path></svg><span>Copy</span>';
								}, 2000);
							});
						});
						pre.appendChild(btn);
					});
				};
// Theme toggle function
				window.toggleTheme = function() {
					var html = document.documentElement;
					var current = html.getAttribute('data-theme');
					var next = (current === 'dark') ? 'light' : 'dark';

					html.setAttribute('data-theme', next);
					localStorage.setItem('theme', next);

					// Update toggle icon
					var icons = document.querySelectorAll('.theme-toggle-icon');
					icons.forEach(function(icon) {
						icon.setAttribute('data-theme-current', next);
					});
				};

				// Listen for system theme changes (when no manual preference is saved)
				if (window.matchMedia) {
					window.matchMedia('(prefers-color-scheme: dark)').addEventListener('change', function(e) {
						if (!localStorage.getItem('theme')) {
							document.documentElement.setAttribute('data-theme', e.matches ? 'dark' : 'light');
						}
					});
				}

				// Scrollbar gutter and CSS overflow-y: scroll handle layout shifts in modern browsers
				// No JavaScript workaround needed

				let draggedElement = null;
				let selectedTasks = new Set();
				let draggedTaskIds = [];
				window.isDragging = false;
				let autoScrollInterval = null;
				let currentScrollZone = null;

				function updateSelectionCounter() {
					const counter = document.getElementById('selection-counter');
					if (!counter) return;

					if (selectedTasks.size > 0) {
						counter.querySelector('#selection-count').textContent = selectedTasks.size;
						counter.classList.add('visible');
					} else {
						counter.classList.remove('visible');
					}
				}

			// ── Tab Visibility Manager ──
			// Centralized manager to pause/resume SSE connections and HTMX polling
			// when a tab is hidden/visible. Prevents resource exhaustion with multiple tabs.
			window._tabVisibility = (function() {
				let sseConnections = {}; // name → { url, onmessage, onerror, onopen, instance }
				let hidden = false;

				function createSSE(name, entry) {
					if (entry.instance) {
						entry.instance.close();
						entry.instance = null;
					}
					const es = new EventSource(entry.url);
					es.onopen = entry.onopen || function() {};
					es.onmessage = entry.onmessage || function() {};
					es.onerror = entry.onerror || function() {};
					if (entry.listeners) {
						for (const evtName in entry.listeners) {
							es.addEventListener(evtName, entry.listeners[evtName]);
						}
					}
					entry.instance = es;
					return es;
				}

				function pauseAll() {
					hidden = true;
					// Close all managed SSE connections
					for (const name in sseConnections) {
						const entry = sseConnections[name];
						if (entry.instance) {
							console.log('[visibility] Closing SSE:', name);
							entry.instance.close();
							entry.instance = null;
						}
					}
					// Pause all HTMX polling elements
					document.querySelectorAll('[hx-trigger*="every"]').forEach(function(el) {
						el.setAttribute('data-hx-trigger-paused', el.getAttribute('hx-trigger'));
						el.setAttribute('hx-trigger', 'none');
						htmx.process(el);
					});
				}

				function resumeAll() {
					hidden = false;
					// Reconnect all managed SSE connections
					for (const name in sseConnections) {
						const entry = sseConnections[name];
						if (!entry.instance) {
							console.log('[visibility] Reconnecting SSE:', name);
							createSSE(name, entry);
						}
					}
					// Resume HTMX polling elements
					document.querySelectorAll('[data-hx-trigger-paused]').forEach(function(el) {
						el.setAttribute('hx-trigger', el.getAttribute('data-hx-trigger-paused'));
						el.removeAttribute('data-hx-trigger-paused');
						htmx.process(el);
					});
				}

				document.addEventListener('visibilitychange', function() {
					if (document.hidden) {
						pauseAll();
					} else {
						resumeAll();
					}
				});

				return {
					// Register a managed SSE connection. Auto-pauses when tab hidden.
					registerSSE: function(name, url, handlers) {
						// Close previous connection with this name if it exists
						if (sseConnections[name] && sseConnections[name].instance) {
							sseConnections[name].instance.close();
						}
						var entry = {
							url: url,
							onopen: handlers.onopen,
							onmessage: handlers.onmessage,
							onerror: handlers.onerror,
							listeners: handlers.listeners,
							instance: null
						};
						sseConnections[name] = entry;
						if (!hidden) {
							createSSE(name, entry);
						}
						return {
							close: function() {
								if (entry.instance) {
									entry.instance.close();
									entry.instance = null;
								}
								delete sseConnections[name];
							}
						};
					},
					// Unregister and close an SSE connection
					unregisterSSE: function(name) {
						var entry = sseConnections[name];
						if (entry) {
							if (entry.instance) {
								entry.instance.close();
							}
							delete sseConnections[name];
						}
					},
					// Dispatch a custom event from an SSE message (for shared connections)
					dispatchSSEEvent: function(eventName, data) {
						window.dispatchEvent(new CustomEvent(eventName, { detail: data }));
					},
					isHidden: function() { return hidden; }
				};
			})();

			// Track which element was focused before mousedown to properly detect dropdown toggle
			let focusedBeforeClick = null;

			document.addEventListener('mousedown', function(e) {
				// Record what was focused before this interaction starts
				focusedBeforeClick = document.activeElement;
			}, true);

			function handleDropdownToggle(event) {
				event.stopPropagation(); // Prevent event from bubbling to parent handlers
				const label = event.currentTarget;

				// Check if this dropdown was already open before the click
				if (focusedBeforeClick === label) {
					// Dropdown was already open, close it
					event.preventDefault();
					label.blur();
				}
				// Otherwise, let the default focus behavior open the dropdown
			}

				function handleTaskSelect(event) {
					// Ignore clicks on links or their children (let HTMX handle them)
					if (event.target.tagName === 'A' || event.target.closest('a')) {
						return;
					}

					// Ignore clicks on buttons, dropdowns, or other interactive elements
					if (event.target.tagName === 'BUTTON' || event.target.closest('button') || event.target.closest('.dropdown')) {
						return;
					}

					const card = event.currentTarget;
					const taskID = card.getAttribute('data-task-id');

					// Cmd/Ctrl+Click for multi-selection
					if (event.metaKey || event.ctrlKey) {
						event.preventDefault();
						event.stopPropagation();

						if (selectedTasks.has(taskID)) {
							selectedTasks.delete(taskID);
							card.classList.remove('task-selected');
						} else {
							selectedTasks.add(taskID);
							card.classList.add('task-selected');
						}

						updateSelectionCounter();
						return;
					}

					// Normal click on card body → navigate to task detail page
					if (taskID) {
						window.openVibelyNavigate('/tasks/' + taskID);
					}
				}

				function clearSelection() {
					selectedTasks.forEach(id => {
						const el = document.getElementById('task-' + id);
						if (el) el.classList.remove('task-selected');
					});
					selectedTasks.clear();
					draggedTaskIds = [];
					updateSelectionCounter();
				}

				function handleDragStart(event) {
					window.isDragging = true;
					draggedElement = event.currentTarget;
					const taskID = draggedElement.getAttribute('data-task-id');
					const cat = draggedElement.getAttribute('data-task-category');
					console.log('[drag] START task=' + taskID + ' category=' + cat);

					if (selectedTasks.has(taskID) && selectedTasks.size > 1) {
						// Dragging a selected task — include all selected
						draggedTaskIds = Array.from(selectedTasks);
					} else {
						// Single drag — clear any selection
						clearSelection();
						draggedTaskIds = [taskID];
					}

					// Add dragging class to all dragged cards
					draggedTaskIds.forEach(id => {
						const el = document.getElementById('task-' + id);
						if (el) el.classList.add('dragging');
					});

					event.dataTransfer.effectAllowed = 'move';
					event.dataTransfer.setData('text/plain', draggedTaskIds.join(','));
				}

				function handleDragEnd(event) {
					window.isDragging = false;
					stopAutoScroll();
					// Remove dragging class from all cards - use both the ID list AND
					// a DOM query as fallback, because handleCategoryDrop/handleActiveDrop
					// call clearSelection() (which empties draggedTaskIds) before dragend fires.
					draggedTaskIds.forEach(id => {
						const el = document.getElementById('task-' + id);
						if (el) el.classList.remove('dragging');
					});
					document.querySelectorAll('.dragging').forEach(el => {
						el.classList.remove('dragging');
					});
					document.querySelectorAll('.category-drop-zone, .task-drop-zone').forEach(zone => {
						zone.classList.remove('drag-over');
					});
				}

				function stopAutoScroll() {
					if (autoScrollInterval) {
						clearInterval(autoScrollInterval);
						autoScrollInterval = null;
					}
					currentScrollZone = null;
				}

				function startAutoScroll(scrollZone, direction, speed) {
					// Don't restart if already scrolling the same zone in the same direction
					if (autoScrollInterval && currentScrollZone === scrollZone) {
						return;
					}

					stopAutoScroll();
					currentScrollZone = scrollZone;

					autoScrollInterval = setInterval(() => {
						if (!scrollZone) {
							stopAutoScroll();
							return;
						}

						// Scroll the zone
						scrollZone.scrollTop += direction * speed;

						// Stop if we've reached the edge
						if (direction < 0 && scrollZone.scrollTop <= 0) {
							stopAutoScroll();
						} else if (direction > 0 && scrollZone.scrollTop + scrollZone.clientHeight >= scrollZone.scrollHeight) {
							stopAutoScroll();
						}
					}, 16); // ~60fps
				}

				function handleAutoScroll(event, dropZone) {
					// Only auto-scroll if the zone is scrollable
					if (dropZone.scrollHeight <= dropZone.clientHeight) {
						stopAutoScroll();
						return;
					}

					const rect = dropZone.getBoundingClientRect();
					const mouseY = event.clientY;
					const scrollThreshold = 80; // pixels from edge to trigger scroll
					const scrollSpeed = 8; // pixels per frame

					const distanceFromTop = mouseY - rect.top;
					const distanceFromBottom = rect.bottom - mouseY;

					if (distanceFromTop < scrollThreshold && distanceFromTop >= 0) {
						// Near top edge - scroll up
						startAutoScroll(dropZone, -1, scrollSpeed);
					} else if (distanceFromBottom < scrollThreshold && distanceFromBottom >= 0) {
						// Near bottom edge - scroll down
						startAutoScroll(dropZone, 1, scrollSpeed);
					} else {
						// Not near any edge
						stopAutoScroll();
					}
				}

				function handleDragOver(event) {
					event.preventDefault();
					event.dataTransfer.dropEffect = 'move';

					// Auto-scroll when dragging near edges of scrollable dropzones
					const dropZone = event.currentTarget;
					if (dropZone && (dropZone.classList.contains('category-drop-zone') || dropZone.classList.contains('task-drop-zone'))) {
						handleAutoScroll(event, dropZone);
					}

					return false;
				}

				function handleDragEnter(event) {
					event.currentTarget.classList.add('drag-over');
				}

				function handleDragLeave(event) {
					const dropZone = event.currentTarget;
					if (event.target === dropZone) {
						dropZone.classList.remove('drag-over');
						// Stop auto-scrolling when leaving the zone
						if (currentScrollZone === dropZone) {
							stopAutoScroll();
						}
					}
				}

				// Drop handler for non-Active category columns (category change + reordering)
				function handleCategoryDrop(event) {
					event.stopPropagation();
					event.preventDefault();
					stopAutoScroll();
					const dropZone = event.currentTarget;
					dropZone.classList.remove('drag-over');

					if (draggedTaskIds.length === 0) return;

					const targetCategory = dropZone.getAttribute('data-category');
					console.log('[drag] CATEGORY DROP target=' + targetCategory + ' tasks=' + draggedTaskIds.join(','));
					const projectID = dropZone.getAttribute('data-project-id');

					// Only single task reordering is supported for now
					if (draggedTaskIds.length === 1) {
						const taskID = draggedTaskIds[0];
						const currentCategory = draggedElement.getAttribute('data-task-category');

						// Calculate drop position based on mouse Y position
						const dropPosition = getDropPosition(event, dropZone);
						console.log('[drag] DROP POSITION=' + dropPosition);

						// If same category, just reorder
						if (currentCategory === targetCategory) {
							if (dropPosition !== null) {
								htmx.ajax('PATCH', `/tasks/${taskID}/reorder`, {
									target: '#kanban-board',
									swap: 'outerHTML',
									values: { position: dropPosition }
								});
							}
						} else {
							// Different category - change category (which will auto-assign new position)
							htmx.ajax('PATCH', `/tasks/${taskID}/category`, {
								target: '#kanban-board',
								swap: 'outerHTML',
								values: { category: targetCategory }
							}).catch(function(err) {
								console.error('[drag] Category change failed:', err);
								// Show error message to user
								if (err.xhr && err.xhr.status === 400) {
									alert(err.xhr.responseText || 'Cannot move task to this category');
								}
							});
						}
					} else {
						// Multi-select batch category change
						htmx.ajax('PATCH', `/tasks/batch-category`, {
							target: '#kanban-board',
							swap: 'outerHTML',
							values: { task_ids: draggedTaskIds.join(','), category: targetCategory, project_id: projectID }
						}).catch(function(err) {
							console.error('[drag] Batch category change failed:', err);
							// Show error message to user
							if (err.xhr && err.xhr.status === 400) {
								alert(err.xhr.responseText || 'Cannot move tasks to this category');
							}
						});
					}

					clearSelection();
				}

				// Get drop position within a drop zone based on mouse Y coordinate
				function getDropPosition(event, dropZone) {
					const allCards = Array.from(dropZone.querySelectorAll('[data-task-id]'));
					// Filter out dragged elements to get accurate drop position
					const taskCards = allCards.filter(card => !draggedTaskIds.includes(card.getAttribute('data-task-id')));

					if (taskCards.length === 0) {
						return 0; // Empty zone, position 0
					}

					// Check if we're dragging the last card in the original list
					const lastCardInZone = allCards[allCards.length - 1];
					const draggingLastCard = lastCardInZone && draggedTaskIds.includes(lastCardInZone.getAttribute('data-task-id'));

					const mouseY = event.clientY;

					for (let i = 0; i < taskCards.length; i++) {
						const card = taskCards[i];
						const rect = card.getBoundingClientRect();

						// When dragging the last card, use 100% threshold for all cards
						// Otherwise, use 100% for non-last cards and 50% for the last card
						const isLastCard = i === taskCards.length - 1;
						const threshold = (draggingLastCard || !isLastCard) ? 1.0 : 0.5;
						const insertBeforeThreshold = rect.top + rect.height * threshold;

						// If mouse is above the threshold of this card, insert before it
						// Return the card's display_order (not the index in filtered array)
						if (mouseY < insertBeforeThreshold) {
							return parseInt(card.getAttribute('data-display-order'));
						}
					}

					// If we get here, mouse is below all cards, append to end
					// Return the last card's display_order + 1 to insert after it
					const lastCard = taskCards[taskCards.length - 1];
					return parseInt(lastCard.getAttribute('data-display-order')) + 1;
				}

				// Drop handler for Active column sub-groups (handles cross-column + status changes + reordering)
				function handleActiveDrop(event) {
					event.stopPropagation();
					event.preventDefault();
					stopAutoScroll();
					const dropZone = event.currentTarget;
					dropZone.classList.remove('drag-over');

					if (draggedTaskIds.length === 0) return;

					const targetStatus = dropZone.getAttribute('data-status');
					console.log('[drag] ACTIVE DROP targetStatus=' + targetStatus + ' tasks=' + draggedTaskIds.join(','));
					const projectID = dropZone.getAttribute('data-project-id');

					if (draggedTaskIds.length === 1) {
						const taskID = draggedTaskIds[0];
						const currentCategory = draggedElement.getAttribute('data-task-category');
						const currentStatus = draggedElement.getAttribute('data-task-status');

						// Calculate drop position
						const dropPosition = getDropPosition(event, dropZone);
						console.log('[drag] DROP POSITION=' + dropPosition);

						if (currentCategory !== 'active') {
							// Moving from different category to active
							htmx.ajax('PATCH', `/tasks/${taskID}/category`, {
								target: '#kanban-board',
								swap: 'outerHTML',
								values: { category: 'active' }
							}).catch(function(err) {
								console.error('[drag] Category change to active failed:', err);
								if (err.xhr && err.xhr.status === 400) {
									alert(err.xhr.responseText || 'Cannot move task to Active category');
								}
							});
						} else if (currentStatus !== targetStatus) {
							// Same category, different status
							htmx.ajax('PATCH', `/tasks/${taskID}/status`, {
								target: '#kanban-board',
								swap: 'outerHTML',
								values: { status: targetStatus }
							});
						} else if (dropPosition !== null) {
							// Same category, same status - just reorder
							htmx.ajax('PATCH', `/tasks/${taskID}/reorder`, {
								target: '#kanban-board',
								swap: 'outerHTML',
								values: { position: dropPosition }
							});
						}
					} else {
						// Multi-select drop into Active — batch category change
						htmx.ajax('PATCH', `/tasks/batch-category`, {
							target: '#kanban-board',
							swap: 'outerHTML',
							values: { task_ids: draggedTaskIds.join(','), category: 'active', project_id: projectID }
						}).catch(function(err) {
							console.error('[drag] Batch category change to active failed:', err);
							if (err.xhr && err.xhr.status === 400) {
								alert(err.xhr.responseText || 'Cannot move tasks to Active category');
							}
						});
					}

					clearSelection();
				}

					window.openVibelyNavigate = function(url, historyURL) {
						var source = document.createElement('a');
						source.className = 'hidden';
						source.setAttribute('aria-hidden', 'true');
						source.setAttribute('tabindex', '-1');
						source.setAttribute('href', url);
						source.setAttribute('hx-get', url);
						source.setAttribute('hx-target', '#main-content');
						source.setAttribute('hx-swap', 'innerHTML');
						source.setAttribute('hx-push-url', historyURL || 'true');
						document.body.appendChild(source);
						var request = htmx.ajax('GET', url, {
							source: source,
							target: '#main-content',
							swap: 'innerHTML'
						});
						request.then(function() { source.remove(); }, function() { source.remove(); });
						return request;
					};

					window.syncOpenVibelyPageTitle = function(root) {
						if (!root) return;
						var marker = root.matches && root.matches('[data-openvibely-page-title]')
							? root
							: root.querySelector && root.querySelector('[data-openvibely-page-title]');
						if (!marker) return;
						document.title = marker.getAttribute('data-openvibely-page-title');
					};

					function syncOpenVibelyTitleFromHTMX(event) {
						var target = event && event.detail && event.detail.target;
						if (!target) target = document.getElementById('main-content');
						window.syncOpenVibelyPageTitle(target);
					}

					document.addEventListener('htmx:afterSwap', syncOpenVibelyTitleFromHTMX);
					document.addEventListener('htmx:historyRestore', syncOpenVibelyTitleFromHTMX);

					window.openVibelySubmitNavigate = function(form) {
						if (!form || !window.htmx) return Promise.reject(new Error('HTMX navigation unavailable'));
						var values = {};
						new FormData(form).forEach(function(value, key) { values[key] = value; });
						return htmx.ajax((form.getAttribute('method') || 'POST').toUpperCase(), form.getAttribute('action'), {
							source: form,
							target: '#main-content',
							swap: 'innerHTML',
							values: values
						});
					};

				// Scroll position restoration for drop zones
				let savedScrollPositions = new Map();

				// Save scroll positions before kanban board swap
				document.addEventListener('htmx:beforeSwap', function(event) {
					if (event.detail.target && event.detail.target.id === 'kanban-board') {
						savedScrollPositions.clear();
						// Save scroll positions of all scrollable drop zones
						const dropZones = document.querySelectorAll('.category-drop-zone, .task-drop-zone');
						dropZones.forEach(function(zone, index) {
							if (zone.scrollTop > 0) {
								// Use category/status as key if available, otherwise use index
								const category = zone.getAttribute('data-category');
								const status = zone.getAttribute('data-status');
								const key = category || (status ? 'active-' + status : 'zone-' + index);
								savedScrollPositions.set(key, zone.scrollTop);
								console.log('[scroll] SAVE ' + key + ' = ' + zone.scrollTop);
							}
						});
					}
				});

				// Clear selection when kanban board is replaced via HTMX
				// Use document.addEventListener instead of document.body.addEventListener
				// because this script runs in <head> where document.body may not exist yet.
				document.addEventListener('htmx:afterSwap', function(event) {
					if (event.detail.target && event.detail.target.id === 'kanban-board') {
						clearSelection();

						// Restore scroll positions after board is re-rendered
						if (savedScrollPositions.size > 0) {
							// Use setTimeout to ensure DOM is fully updated
							setTimeout(function() {
								const dropZones = document.querySelectorAll('.category-drop-zone, .task-drop-zone');
								dropZones.forEach(function(zone, index) {
									const category = zone.getAttribute('data-category');
									const status = zone.getAttribute('data-status');
									const key = category || (status ? 'active-' + status : 'zone-' + index);
									const savedPosition = savedScrollPositions.get(key);
									if (savedPosition !== undefined) {
										zone.scrollTop = savedPosition;
										console.log('[scroll] RESTORE ' + key + ' = ' + savedPosition);
									}
								});
								savedScrollPositions.clear();
							}, 0);
						}
					}
				});
			</script>
		</head>
		<body class="h-screen bg-base-200 overflow-hidden" hx-ext="morph">
			<div class="drawer lg:drawer-open h-full">
				<input id="sidebar-toggle" type="checkbox" class="drawer-toggle"/>
				<div class="drawer-content flex flex-col h-full overflow-hidden">
					<!-- Navbar (mobile only) -->
					<div class="navbar bg-base-100 shadow-sm flex-shrink-0 lg:hidden">
						<div class="flex-none lg:hidden">
							<label for="sidebar-toggle" class="btn btn-square btn-ghost">
								<svg xmlns="http://www.w3.org/2000/svg" fill="none" viewBox="0 0 24 24" class="inline-block w-6 h-6 stroke-current">
									<path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M4 6h16M4 12h16M4 18h16"></path>
								</svg>
							</label>
						</div>
						<div class="flex-1">
							<span class="text-xl font-bold lg:hidden">OpenVibely</span>
						</div>
					</div>
					<!-- Main Content -->
					<main id="main-content" class="p-6 flex-1 overflow-y-auto overflow-x-hidden">
						{ children... }
					</main>
				</div>
					<!-- Sidebar -->
					<div class="drawer-side z-[200] lg:z-auto">
						<label for="sidebar-toggle" aria-label="close sidebar" class="drawer-overlay z-[190] lg:z-auto"></label>
						@Sidebar(projects, currentProjectID)
					</div>
					<!-- Apply sidebar collapsed state immediately to prevent flash -->
				<script>
					(function() {
						if (localStorage.getItem('sidebar-collapsed') === 'true') {
							var s = document.getElementById('sidebar');
							if (s) s.classList.add('sidebar-collapsed');
						}
					})();
				</script>
			</div>
			<!-- Toast Notification Container -->
			<div id="toast-container"></div>
			<script>
				function getTopMostOpenModal() {
					const openModals = Array.from(document.querySelectorAll('dialog.modal[open]'));
					if (openModals.length === 0) return null;
					return openModals[openModals.length - 1];
				}

				function ensureToastContainer(host) {
					if (!host) return null;
					let container = document.getElementById('toast-container');
					if (!container) {
						container = document.createElement('div');
						container.id = 'toast-container';
					}
					if (container.parentElement !== host) {
						host.appendChild(container);
					}
					return container;
				}

				function getToastContainer() {
					const modal = getTopMostOpenModal();
					if (modal) {
						return ensureToastContainer(modal);
					}
					const body = document.body;
					if (!body) {
						return document.getElementById('toast-container');
					}
					return ensureToastContainer(body);
				}

				function findVisibleTaskToast(taskId) {
					if (!taskId) return null;
					return document.querySelector('.toast-notification[data-task-id="' + taskId + '"]:not(.toast-dismiss)');
				}

				function findVisibleToastKey(toastKey) {
					if (!toastKey) return null;
					return document.querySelector('.toast-notification[data-toast-key="' + toastKey + '"]:not(.toast-dismiss)');
				}

				function syncToastContainerHost() {
					const modal = getTopMostOpenModal();
					const host = modal || document.body;
					if (host) {
						ensureToastContainer(host);
					}
				}
				window.syncToastContainerHost = syncToastContainerHost;

				if (!window._toastDialogPatchApplied && window.HTMLDialogElement && HTMLDialogElement.prototype && typeof HTMLDialogElement.prototype.showModal === 'function') {
					const originalShowModal = HTMLDialogElement.prototype.showModal;
					HTMLDialogElement.prototype.showModal = function() {
						const result = originalShowModal.apply(this, arguments);
						setTimeout(syncToastContainerHost, 0);
						return result;
					};
					window._toastDialogPatchApplied = true;
				}

				document.addEventListener('close', function(event) {
					if (event && event.target && event.target.matches && event.target.matches('dialog.modal')) {
						setTimeout(syncToastContainerHost, 0);
					}
				}, true);

				document.addEventListener('cancel', function(event) {
					if (event && event.target && event.target.matches && event.target.matches('dialog.modal')) {
						setTimeout(syncToastContainerHost, 0);
					}
				}, true);

				syncToastContainerHost();

				// Global toast notification system
				function escapeToastHtml(value) {
					return String(value || '')
						.replace(/&/g, '&amp;')
						.replace(/</g, '&lt;')
						.replace(/>/g, '&gt;')
						.replace(/"/g, '&quot;')
						.replace(/'/g, '&#39;');
				}

				function shouldSuppressDuplicateToast(message, status, taskId) {
					var now = Date.now();
					if (!window._recentToasts) {
						window._recentToasts = new Map();
					}
					var dedupKey = String(message || '') + '|' + String(status || 'info') + '|' + String(taskId || '');
					var lastShownAt = window._recentToasts.get(dedupKey);
					if (lastShownAt && now - lastShownAt < 1000) {
						return true;
					}
					window._recentToasts.set(dedupKey, now);
					window._recentToasts.forEach(function(timestamp, key) {
						if (now - timestamp > 5000) {
							window._recentToasts.delete(key);
						}
					});
					return false;
				}

				function closeOpenModalsForToastNavigation() {
					var openModals = Array.from(document.querySelectorAll('dialog.modal[open]'));
					if (openModals.length === 0) return;
					openModals.forEach(function(modal) {
						try {
							modal.close();
						} catch (err) {}
					});
					setTimeout(syncToastContainerHost, 0);
				}

				window.showToast = function(title, status, taskId, options) {
					const container = getToastContainer();
					if (!container) return;
					options = options || {};
					var toastKey = String(options.toastKey || '').trim();
					var clickURL = String(options.clickURL || options.clickUrl || '').trim();

					// Deduplicate: skip if a toast for this task or explicit toast key is already visible
					if (taskId && findVisibleTaskToast(taskId)) {
						return;
					}
					if (toastKey && findVisibleToastKey(toastKey)) {
						return;
					}

					// Determine style based on status
					let alertClass, icon, statusLabel;
					switch (status) {
						case 'completed':
							alertClass = 'alert-success';
							statusLabel = 'Completed';
							icon = '<svg xmlns="http://www.w3.org/2000/svg" class="h-5 w-5 shrink-0" fill="none" viewBox="0 0 24 24" stroke="currentColor"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 12l2 2 4-4m6 2a9 9 0 11-18 0 9 9 0 0118 0z" /></svg>';
							break;
						case 'failed':
							alertClass = 'alert-error';
							statusLabel = 'Failed';
							icon = '<svg xmlns="http://www.w3.org/2000/svg" class="h-5 w-5 shrink-0" fill="none" viewBox="0 0 24 24" stroke="currentColor"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M10 14l2-2m0 0l2-2m-2 2l-2-2m2 2l2 2m7-2a9 9 0 11-18 0 9 9 0 0118 0z" /></svg>';
							break;
						case 'cancelled':
							alertClass = 'alert-warning';
							statusLabel = 'Cancelled';
							icon = '<svg xmlns="http://www.w3.org/2000/svg" class="h-5 w-5 shrink-0" fill="none" viewBox="0 0 24 24" stroke="currentColor"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 9v2m0 4h.01m-6.938 4h13.856c1.54 0 2.502-1.667 1.732-3L13.732 4c-.77-1.333-2.694-1.333-3.464 0L3.34 16c-.77 1.333.192 3 1.732 3z" /></svg>';
							break;
						default:
							alertClass = 'alert-info';
							statusLabel = status;
							icon = '<svg xmlns="http://www.w3.org/2000/svg" class="h-5 w-5 shrink-0" fill="none" viewBox="0 0 24 24" stroke="currentColor"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M13 16h-1v-4h-1m1-4h.01M21 12a9 9 0 11-18 0 9 9 0 0118 0z" /></svg>';
							break;
					}

					// Use full title - CSS will handle wrapping
					const displayTitle = title;
					if (shouldSuppressDuplicateToast(displayTitle, status, taskId)) {
						return;
					}

					const toast = document.createElement('div');
					toast.className = 'toast-notification alert ' + alertClass + ' shadow-lg';
					toast.setAttribute('role', 'alert');
					if (taskId) {
						toast.setAttribute('data-task-id', taskId);
					}
					if (toastKey) {
						toast.setAttribute('data-toast-key', toastKey);
					}
					toast.innerHTML = icon +
						'<div class="toast-message-container flex flex-col gap-0 min-w-0 flex-1 overflow-hidden">' +
							'<span class="font-semibold text-xs uppercase tracking-wider opacity-80">' + escapeToastHtml(statusLabel) + '</span>' +
							'<span class="text-sm break-words">' + escapeToastHtml(displayTitle) + '</span>' +
						'</div>' +
						'<button type="button" class="toast-close btn btn-ghost btn-circle" aria-label="Dismiss notification" onclick="event.stopPropagation(); dismissToast(this.parentElement)">' +
							'<svg xmlns="http://www.w3.org/2000/svg" class="h-4 w-4" fill="none" viewBox="0 0 24 24" stroke="currentColor"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M6 18L18 6M6 6l12 12" /></svg>' +
						'</button>';

					var linkURL = String(options.linkURL || '').trim();
					var linkText = String(options.linkText || '').trim();
					if (linkURL !== '') {
						if (linkText === '') {
							linkText = 'Open';
						}
						var containerEl = toast.querySelector('.toast-message-container');
						if (containerEl) {
							var link = document.createElement('a');
							link.href = linkURL;
							link.className = 'link link-primary text-xs mt-1 self-start';
							link.textContent = linkText;
							link.addEventListener('click', function(event) {
								event.preventDefault();
								event.stopPropagation();
								closeOpenModalsForToastNavigation();
								window.openVibelyNavigate(linkURL).catch(function(err) {
									console.error('[toast] Failed to load link URL:', err);
								});
								dismissToast(toast);
							});
							containerEl.appendChild(link);
						}
					}

					// Click to navigate when a target is provided. Task toasts keep their task-detail default.
					var navigateURL = clickURL || (taskId ? '/tasks/' + taskId : '');
					if (navigateURL) {
						toast.classList.add('cursor-pointer');
						toast.addEventListener('click', function() {
							closeOpenModalsForToastNavigation();
							window.openVibelyNavigate(navigateURL).catch(function(err) {
								console.error('[toast] Failed to load toast target:', err);
							});
							dismissToast(toast);
						});
					}

					container.appendChild(toast);

					// Auto-dismiss after 5 seconds
					if (!options.sticky) {
						const autoDismiss = setTimeout(function() {
							dismissToast(toast);
						}, 5000);
						toast._autoDismiss = autoDismiss;
					}

					// Limit to 5 visible toasts
					const toasts = container.querySelectorAll('.toast-notification:not(.toast-dismiss)');
					if (toasts.length > 5) {
						dismissToast(toasts[0]);
					}
				};

				// Bridge HTMX-triggered toast events into the global toast renderer.
				// Handlers can emit: {"openvibelyToast":{"message":"...", "status":"failed"}}
				if (!window._openvibelyToastBridgeRegistered) {
					window._openvibelyToastBridgeRegistered = true;
					document.body.addEventListener('openvibelyToast', function(event) {
						var detail = event && event.detail ? event.detail : {};
						var message = typeof detail === 'string' ? detail : (detail.message || '');
						if (!message || !window.showToast) return;

						var status = detail.status || detail.type || 'info';
						if (status === 'success') status = 'completed';
						if (status === 'error') status = 'failed';
						if (status === 'warning') status = 'cancelled';

						var taskId = detail.taskId || detail.task_id || '';
						var linkURL = detail.linkURL || detail.link_url || '';
						var linkText = detail.linkText || detail.link_text || '';
						var toastKey = detail.toastKey || detail.toast_key || '';
						var clickURL = detail.clickURL || detail.click_url || '';
						window.showToast(message, status, taskId, { linkURL: linkURL, linkText: linkText, toastKey: toastKey, clickURL: clickURL });
					});
				}

				window.dismissToast = function(toast) {
					if (!toast || toast.classList.contains('toast-dismiss')) return;
					if (toast._autoDismiss) clearTimeout(toast._autoDismiss);
					toast.classList.add('toast-dismiss');
					toast.addEventListener('animationend', function() {
						toast.remove();
					}, { once: true });
					// Fallback: force-remove if animationend doesn't fire
					// (prefers-reduced-motion, browser quirks, transition/animation conflicts)
					setTimeout(function() {
						if (toast.parentNode) toast.remove();
					}, 400);
				};

				function systemUpdateIsActionable(data) {
					if (!data || !data.release || !data.release.metadata) return false;
					var available = data.release.metadata.version || '';
					if (!available || data.current_version === available || data.state === 'succeeded') return false;
					if (data.release.apply_supported === false || data.distribution === 'hosted') return false;
					var readyForLocalApply = data.distribution === 'docker' || data.manual || data.staged;
					return readyForLocalApply && (data.state === 'available' || data.state === 'failed');
				}

				function setSystemUpdateIndicators(visible) {
					var badge = document.getElementById('system-update-nav-badge');
					if (badge) badge.classList.toggle('hidden', !visible);
				}

				function systemUpdateNoticeKey(data) {
					var release = data && data.release ? data.release : {};
					var metadata = release.metadata || {};
					var target = release.target || {};
					return [
						data && data.current_version ? data.current_version : '',
						metadata.version || '',
						metadata.commit || '',
						metadata.published_at || '',
						target.sha256 || target.url || ''
					].join('|');
				}

				function systemUpdatePendingSuccessFromData(data) {
					var version = data && data.release && data.release.metadata ? data.release.metadata.version || '' : '';
					if (!version) return null;
					return { version: version, noticeKey: systemUpdateNoticeKey(data) };
				}

				function rememberSystemUpdatePendingSuccess(data) {
					var pending = systemUpdatePendingSuccessFromData(data);
					if (!pending) return;
					try {
						localStorage.setItem('openvibely-system-update-pending-success', JSON.stringify(pending));
					} catch (_) {}
				}

				function consumeSystemUpdatePendingSuccess() {
					try {
						var raw = localStorage.getItem('openvibely-system-update-pending-success');
						if (!raw) return null;
						localStorage.removeItem('openvibely-system-update-pending-success');
						var pending = JSON.parse(raw);
						if (!pending || !pending.version || !pending.noticeKey) return null;
						return pending;
					} catch (_) {
						try { localStorage.removeItem('openvibely-system-update-pending-success'); } catch (_) {}
						return null;
					}
				}

				function clearSystemUpdatePendingSuccess() {
					try { localStorage.removeItem('openvibely-system-update-pending-success'); } catch (_) {}
				}

				function navigateSystemUpdateToAlerts() {
					closeOpenModalsForToastNavigation();
					if (window.openVibelyNavigate) {
						window.openVibelyNavigate('/alerts').catch(function(err) {
							console.error('[system-update] failed to navigate to alerts:', err);
						});
					} else {
						window.location.href = '/alerts';
					}
				}

				function applySystemUpdateFromToast(toast) {
					if (!toast || toast.dataset.systemUpdateApplying === 'true') return;
					toast.dataset.systemUpdateApplying = 'true';
					fetch('/api/system/update/apply', { method: 'POST', headers: { 'Accept': 'application/json' } })
						.then(function(response) {
							if (!response.ok) return null;
							return response.json().catch(function() { return null; });
						})
						.then(function(data) {
							if (data) rememberSystemUpdatePendingSuccess(data);
						})
						.catch(function(err) { console.error('[system-update] apply failed:', err); })
						.finally(function() {
							navigateSystemUpdateToAlerts();
							dismissToast(toast);
						});
				}

				window.openVibelyClearSystemUpdatePendingSuccess = clearSystemUpdatePendingSuccess;

				function showSystemUpdateSucceededToast(data, pending) {
					if (!pending && (!data || data.state !== 'succeeded')) return;
					var version = pending ? pending.version : (data.release && data.release.metadata ? data.release.metadata.version || '' : data.current_version || '');
					if (!version) return;
					var noticeKey = pending ? pending.noticeKey : systemUpdateNoticeKey(data);
					var successKey = 'succeeded|' + noticeKey;
					try {
						if (localStorage.getItem('openvibely-system-update-success-toast') === successKey) return;
						localStorage.setItem('openvibely-system-update-success-toast', successKey);
					} catch (_) {}
					if (window.showToast) {
						window.showToast('OpenVibely updated to ' + version, 'completed');
					}
				}

				function dismissSystemUpdateNotice(noticeKey) {
					var toast = document.querySelector('[data-system-update-toast]');
					if (toast) dismissToast(toast);
					if (noticeKey) {
						try { localStorage.setItem('openvibely-system-update-dismissed-version', noticeKey); } catch (_) {}
					}
				}

				function showSystemUpdateNotice(data) {
					var version = data && data.release && data.release.metadata ? data.release.metadata.version || '' : '';
					if (!version) return;
					var noticeKey = systemUpdateNoticeKey(data);
					try {
						if (localStorage.getItem('openvibely-system-update-dismissed-version') === noticeKey) return;
					} catch (_) {}
					var existing = document.querySelector('[data-system-update-toast]');
					if (existing) {
						if (existing.getAttribute('data-system-update-toast') === noticeKey) return;
						dismissToast(existing);
					}
					var container = getToastContainer();
					if (!container) return;
					var toast = document.createElement('div');
					toast.className = 'toast-notification alert system-update-toast shadow-lg';
					toast.setAttribute('role', 'alert');
					toast.setAttribute('data-system-update-toast', noticeKey);
					toast.innerHTML =
						'<svg xmlns="http://www.w3.org/2000/svg" class="h-5 w-5 shrink-0" fill="none" viewBox="0 0 24 24" stroke="currentColor"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M4 4v5h.582m15.356 2A8.001 8.001 0 004.582 9m0 0H9m11 11v-5h-.581m0 0a8.003 8.003 0 01-15.357-2m15.357 2H15" /></svg>' +
						'<div class="toast-message-container flex flex-col gap-1 min-w-0 flex-1 overflow-hidden">' +
							'<span class="font-semibold text-xs uppercase tracking-wider opacity-80">Update available</span>' +
							'<span class="text-sm break-words">OpenVibely ' + escapeToastHtml(version) + ' is ready to install.</span>' +
						'</div>' +
						'<button type="button" class="toast-close btn btn-ghost btn-circle" aria-label="Dismiss update notification" data-system-update-dismiss>' +
							'<svg xmlns="http://www.w3.org/2000/svg" class="h-4 w-4" fill="none" viewBox="0 0 24 24" stroke="currentColor"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M6 18L18 6M6 6l12 12" /></svg>' +
						'</button>';
					toast.addEventListener('click', function(event) {
						if (event.target && event.target.closest && event.target.closest('button')) return;
						applySystemUpdateFromToast(toast);
					});
					var dismissButton = toast.querySelector('[data-system-update-dismiss]');
					if (dismissButton) {
						dismissButton.addEventListener('click', function(event) {
							event.preventDefault();
							event.stopPropagation();
							dismissSystemUpdateNotice(noticeKey);
						});
					}
					container.appendChild(toast);
				}

				async function refreshGlobalSystemUpdateIndicators() {
					try {
						var response = await fetch('/api/system/update', { headers: { 'Accept': 'application/json' } });
						if (response.status === 204) {
							handleGlobalSystemUpdateSnapshot(null);
							return;
						}
						if (!response.ok) return;
						var data = await response.json();
						handleGlobalSystemUpdateSnapshot(data);
					} catch (_) {}
				}

				function handleGlobalSystemUpdateSnapshot(data) {
					if (!data) {
						setSystemUpdateIndicators(false);
						dismissSystemUpdateNotice('');
						showSystemUpdateSucceededToast(null, consumeSystemUpdatePendingSuccess());
						return;
					}
					var actionable = systemUpdateIsActionable(data);
					setSystemUpdateIndicators(actionable);
					if (actionable) showSystemUpdateNotice(data);
					else {
						dismissSystemUpdateNotice('');
						var available = data.release && data.release.metadata ? data.release.metadata.version || '' : '';
						if (data.state === 'waiting_for_idle' || data.state === 'ready' || data.state === 'applying' || data.state === 'restarting' || data.state === 'validating') {
							rememberSystemUpdatePendingSuccess(data);
						}
						showSystemUpdateSucceededToast(data);
						if (available && data.current_version === available) {
							showSystemUpdateSucceededToast(null, consumeSystemUpdatePendingSuccess());
						} else if (data.state === 'failed' || data.state === 'rolled_back' || data.state === 'idle') {
							clearSystemUpdatePendingSuccess();
						}
					}
				}

				window.refreshGlobalSystemUpdateIndicators = refreshGlobalSystemUpdateIndicators;
				window.openVibelyHandleSystemUpdateSnapshot = handleGlobalSystemUpdateSnapshot;

				if (!window._openVibelySystemUpdateIndicatorsRegistered) {
					window._openVibelySystemUpdateIndicatorsRegistered = true;
					refreshGlobalSystemUpdateIndicators();
					window.openVibelySystemUpdateIndicatorPoll = setInterval(refreshGlobalSystemUpdateIndicators, 30000);
					document.body.addEventListener('alertUpdate', refreshGlobalSystemUpdateIndicators);
				}
			</script>

			<!-- Card Search Helper -->
			<script>
				(function() {
					// Shared card search/filter helper.
					// Usage: add <input data-card-search="<page-key>" placeholder="...">
					//        and   data-search-card + data-search-text="..." on each card.
					// The helper filters cards, shows/hides a no-results message, and
					// persists the search term in sessionStorage per page key.

					function cardSearchStorageKey(pageKey) {
						return 'ov_card_search_' + pageKey;
					}

					function storeCardSearchTerm(pageKey, value) {
						if (!pageKey) return;
						try { sessionStorage.setItem(cardSearchStorageKey(pageKey), value || ''); } catch(e) {}
					}

					function loadCardSearchTerm(pageKey) {
						try { return sessionStorage.getItem(cardSearchStorageKey(pageKey)) || ''; } catch(e) { return ''; }
					}

					function initCardSearch(input) {
						var pageKey = input.getAttribute('data-card-search');
						if (!pageKey) return;
						var container = input.closest('[data-search-container]');
						if (!container) return;

						function applyFilter() {
							var term = (input.value || '').toLowerCase().trim();
							storeCardSearchTerm(pageKey, input.value || '');

							var cards = container.querySelectorAll('[data-search-card]');
							var visibleCount = 0;
							for (var i = 0; i < cards.length; i++) {
								var text = (cards[i].getAttribute('data-search-text') || '').toLowerCase();
								var match = !term || text.indexOf(term) !== -1;
								cards[i].style.display = match ? '' : 'none';
								if (match) visibleCount++;
							}

							// Show/hide no-results message
							var noResults = container.querySelector('[data-search-no-results]');
							if (noResults) {
								noResults.style.display = (term && visibleCount === 0) ? '' : 'none';
							}
						}

						if (!input.dataset.cardSearchInit) {
							// Restore persisted term once per input instance.
							var saved = loadCardSearchTerm(pageKey);
							if (saved) {
								input.value = saved;
							}
							input.addEventListener('input', applyFilter);
							input.dataset.cardSearchInit = 'true';
						}

						// Apply on init/re-init (for restored term or HTMX re-swap)
						applyFilter();
					}

					function initAllCardSearches(root) {
						var inputs = (root || document).querySelectorAll('input[data-card-search]');
						for (var i = 0; i < inputs.length; i++) {
							initCardSearch(inputs[i]);
						}
					}

					function replaceSearchableCardContainer(containerOrSelector, html) {
						var container = typeof containerOrSelector === 'string' ? document.querySelector(containerOrSelector) : containerOrSelector;
						if (!container) return null;
						var input = container.querySelector('input[data-card-search]');
						var pageKey = input ? input.getAttribute('data-card-search') : '';
						var activeTerm = input ? input.value || '' : (pageKey ? loadCardSearchTerm(pageKey) : '');
						if (pageKey) storeCardSearchTerm(pageKey, activeTerm);
						container.outerHTML = html;
						var nextContainer = container.id ? document.getElementById(container.id) : null;
						if (!nextContainer) return null;
						var nextInput = nextContainer.querySelector('input[data-card-search]');
						if (nextInput && pageKey && nextInput.getAttribute('data-card-search') === pageKey) {
							nextInput.value = activeTerm;
						}
						if (window.htmx) htmx.process(nextContainer);
						initAllCardSearches(nextContainer);
						return nextContainer;
					}

					window.refreshCardSearches = initAllCardSearches;
					window.replaceSearchableCardContainer = replaceSearchableCardContainer;

					// Init on page load
					setTimeout(function() { initAllCardSearches(); }, 0);

					// Re-init after HTMX swaps (handles partial container refreshes)
					document.body.addEventListener('htmx:afterSettle', function(evt) {
						if (evt.detail && evt.detail.elt) {
							initAllCardSearches(evt.detail.elt);
						}
					});
				})();
			</script>

			<!-- Desktop external-link bridge -->
			<script>
					// In Wails desktop mode, the embedded WebView does not handle
					// target="_blank" or new-window navigation, so clicks on anchors
					// like the Task Changes "View PR" link silently do nothing.
					// Intercept clicks on external links and route them through the
					// Wails Browser.OpenURL bridge or the server-side desktop opener
					// so they open in the user's real system browser. In web/server
					// mode this helper is inert, preserving normal anchor behavior.
				(function() {
						function isDesktopRuntime() {
							try {
								if (typeof window === 'undefined') return false;
								var serverRuntime = document.documentElement.getAttribute('data-openvibely-runtime');
								if (serverRuntime === 'desktop') return true;
								if (window.location && window.location.protocol === 'wails:') return true;
								if (typeof window.wails !== 'undefined') return true;
								if (typeof window._wails !== 'undefined') return true;
								if (typeof window.runtime !== 'undefined') return true;
								if (typeof window.__WAILS__ !== 'undefined') return true;
								return false;
							} catch (_) {
								return false;
							}
						}
						function isExternalHref(href) {
						if (!href) return false;
						var lower = String(href).toLowerCase();
						return lower.indexOf('http://') === 0 || lower.indexOf('https://') === 0 || lower.indexOf('mailto:') === 0;
					}
					// openExternalViaBackend calls the server-side /open-external
					// endpoint, which uses the OS browser opener (browser.OpenURL).
					// This is the most reliable path in desktop mode because the
					// Wails runtime JS is not always injected when the WebView loads
					// from an HTTP server URL rather than the Wails asset server.
						function openExternalViaBackend(url) {
							fetch('/open-external?url=' + encodeURIComponent(url), {
								method: 'POST',
								headers: { 'X-OpenVibely-Desktop': '1' }
							})
								.then(function(r) {
								if (!r.ok) { throw new Error('HTTP ' + r.status); }
							})
							.catch(function() {
								if (window.showToast) {
									window.showToast('Failed to open in system browser: ' + url, 'failed');
								}
							});
					}
					function callWailsOpenURL(url) {
						// Try Wails v3 Browser.OpenURL (injected runtime).
						try {
							if (window.wails && window.wails.Browser && typeof window.wails.Browser.OpenURL === 'function') {
								var p = window.wails.Browser.OpenURL(url);
								if (p && typeof p.then === 'function') {
									// If the Wails API rejects, fall back to the backend endpoint.
									p.catch(function() { openExternalViaBackend(url); });
								}
								return true;
							}
							// Older Wails runtime shape.
							if (window.wails && typeof window.wails.OpenURL === 'function') {
								var p2 = window.wails.OpenURL(url);
								if (p2 && typeof p2.then === 'function') {
									p2.catch(function() { openExternalViaBackend(url); });
								}
								return true;
							}
						} catch (_) { /* fall through */ }
						// Wails JS API unavailable — use server-side opener.
						openExternalViaBackend(url);
						return true; // handled asynchronously
					}
						function isChatMessageExternalLink(anchor) {
							return !!(anchor && anchor.getAttribute('data-openvibely-chat-external-link') === 'true' && anchor.closest && anchor.closest('.chat-stream-content, [id^="streaming-message-"], [data-raw-content]'));
						}
						function handleAnchorClick(event) {
							// Allow modifier-clicks to fall through.
							if (event.defaultPrevented) return;
							if (event.button !== undefined && event.button !== 0) return;
							if (event.metaKey || event.ctrlKey || event.shiftKey || event.altKey) return;
							var target = event.target;
							var anchor = target && target.closest ? target.closest('a[href]') : null;
							if (!anchor) return;
							var href = anchor.getAttribute('href');
							if (!href) return;
							var desktop = isDesktopRuntime();
							var chatExternal = isChatMessageExternalLink(anchor);
							if (!desktop && !chatExternal) return;
							// Only act on external links or links explicitly marked target="_blank".
							var blank = anchor.getAttribute('target') === '_blank';
							if (!isExternalHref(href) && !blank && !chatExternal) return;
							// If it's target="_blank" but a relative URL, resolve to absolute first
							// so the system browser receives a usable URL.
							var absolute = anchor.getAttribute('data-openvibely-external-url') || href;
							try {
								absolute = new URL(absolute, window.location.href).toString();
							} catch (_) {}
							if (!isExternalHref(absolute)) {
								// Same-origin relative link in a new tab: let default behavior happen.
								return;
							}
							event.preventDefault();
							event.stopPropagation();
							if (desktop) {
								callWailsOpenURL(absolute);
								return;
							}
							try {
								window.open(absolute, '_blank', 'noopener,noreferrer');
							} catch (_) {
								if (window.showToast) window.showToast('Failed to open link: ' + absolute, 'failed');
							}
						}
					document.addEventListener('click', handleAnchorClick, true);
					// Expose for callers that need an explicit opener (e.g., dropdown item buttons).
					window.openExternalURL = function(url) {
						if (!url) return false;
						if (!isDesktopRuntime()) {
							try { window.open(url, '_blank', 'noopener,noreferrer'); return true; } catch (_) { return false; }
						}
						return callWailsOpenURL(url);
					};
				})();
			</script>

			<!-- Selection Counter -->
			<div id="selection-counter">
				<span id="selection-count">0</span>
				<span>tasks selected</span>
				<button onclick="clearSelection()" class="btn btn-sm btn-ghost">Clear</button>
			</div>
		</body>
	</html>
}
