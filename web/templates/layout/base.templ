				});
				document.addEventListener('pointerdown', function(event) {
					if (!kanbanDropdownForTarget(event.target)) {
						closeKanbanMenu(null, false);
					}
				}, true);
				document.addEventListener('keydown', function(event) {
					if (event.key === 'Escape') {
						const dropdown = kanbanDropdownForTarget(event.target);
						if (dropdown) {
							event.preventDefault();
							event.stopPropagation();
