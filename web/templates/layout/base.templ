					for (const name in sseConnections) {
						const entry = sseConnections[name];
						if (entry.instance) {
							console.log('[visibility] Closing SSE:', name);
							entry.instance.close();
							entry.instance = null;
						}
					}
					// Pause all HTMX polling elements
					document.querySelectorAll('[hx-trigger*="every"]').forEach(function(el) {
