							requestPage(state, 0, true);
						}

						function parseResponse(html, selector) {
							var documentFragment = new DOMParser().parseFromString(html, 'text/html');
							var incomingList;
							try { incomingList = documentFragment.querySelector(selector); } catch (_) { incomingList = null; }
							if (!incomingList) throw new Error('paged card list missing');
							return incomingList;
						}

						function appendCards(state, incomingList) {
							var incomingCards = cardsFor(incomingList, state.root);
							var currentCards = cardsFor(state.list, state.root);
							var keyAttribute = state.root.getAttribute('data-card-pagination-key') || '';
							var target = currentCards.length ? currentCards[0].parentElement : null;
								if (!target && incomingCards.length) {
									state.list.innerHTML = incomingList.innerHTML;
									rememberCards(state, cardsFor(state.list, state.root), true);
									if (window.htmx && typeof window.htmx.process === 'function') window.htmx.process(state.list);
									return incomingCards.length;
								}
								var appended = [];
								for (var i = 0; i < incomingCards.length; i++) {
									var key = cardKey(incomingCards[i], keyAttribute);
									if (state.keys[key]) continue;
									var clone = incomingCards[i].cloneNode(true);
									target.appendChild(clone);
									appended.push(clone);
									state.keys[key] = true;
								}
								if (window.htmx && typeof window.htmx.process === 'function') {
									for (var j = 0; j < appended.length; j++) window.htmx.process(appended[j]);
								}
								return incomingCards.length;						}

						function requestPage(state, page, replace) {
							if (!isCurrent(state) || state.loading) return;
							if (!replace && (!state.hasMore || page !== state.nextPage || state.requestedPages[page])) return;
							state.requestedPages[page] = true;
							var generation = state.generation;
							var controller = typeof AbortController === 'function' ? new AbortController() : null;
							state.controller = controller;
							state.loading = true;
							state.failedPage = null;
							state.failedReplace = false;
							setStatus(state, 'loading');
							var endpoint = state.root.getAttribute('data-card-pagination-url');
							if (!endpoint) endpoint = window.location.pathname + window.location.search;
							var url;
							try {
								url = new URL(endpoint, window.location.href);
							} catch (_) {
								url = null;
							}
								if (!url) {
								state.loading = false;
								delete state.requestedPages[page];
								state.failedPage = page;
								state.failedReplace = replace;
									state.hasMore = true;
									setStatus(state, 'error');
									disconnectTrigger(state);
								return;
							}
								try {
									var currentURL = new URL(window.location.href);
									currentURL.searchParams.forEach(function(value, key) {
										if (['card_page', 'card_window', 'page', 'page_size', 'offset'].indexOf(key) === -1) url.searchParams.set(key, value);
									});
								} catch (_) {}
								url.searchParams.set('page', String(page));							url.searchParams.set('page_size', String(state.pageSize));
							url.searchParams.set('offset', String(replace ? 0 : state.nextOffset));
							url.searchParams.set('card_page', '1');
							if (state.search) url.searchParams.set('search', state.search);
							else url.searchParams.delete('search');
							var options = {
								method: 'GET',
								credentials: 'same-origin',
								headers: {'HX-Request': 'true', 'Accept': 'text/html'}
							};
							if (controller) options.signal = controller.signal;
							window.fetch(url.toString(), options).then(function(response) {
								if (!response.ok) throw new Error('paged card request failed');
								var header = response.headers.get(pageHeader);
								return response.text().then(function(html) { return {html: html, header: header}; });
							}).then(function(payload) {
								if (!isCurrent(state) || state.generation !== generation) return;
								var selector = state.root.getAttribute('data-card-pagination-list');
								var incomingList = parseResponse(payload.html, selector);
								var received = cardsFor(incomingList, state.root).length;
									if (replace) {
										state.list.innerHTML = incomingList.innerHTML;
										rememberCards(state, cardsFor(state.list, state.root), true);
										if (window.htmx && typeof window.htmx.process === 'function') window.htmx.process(state.list);
									} else {
										appendCards(state, incomingList);
									}
									if (typeof window.refreshCardSearches === 'function') window.refreshCardSearches(state.root);
									if (typeof state.root._openVibelyInstallSelectionCards === 'function') state.root._openVibelyInstallSelectionCards();
									state.nextPage = page + 1;
									state.nextOffset = replace ? received : state.nextOffset + received;
									state.hasMore = payload.header === null ? received >= state.pageSize : payload.header === 'true';
									state.loading = false;
									state.controller = null;
									delete state.requestedPages[page];

									var replacementSnapshot = state.replaceSnapshot;
									state.replaceSnapshot = null;
									restoreReplacementState(state, replacementSnapshot);
									setStatus(state, 'idle');								connectTrigger(state);
							}).catch(function(error) {
								if (!isCurrent(state) || state.generation !== generation || error && error.name === 'AbortError') return;
								state.loading = false;
								state.controller = null;
								delete state.requestedPages[page];
								state.failedPage = page;
								state.failedReplace = replace;
									state.hasMore = true;
									setStatus(state, 'error');
									disconnectTrigger(state);
							});
						}

						function createState(root, list, initialSearch) {
							var pageSize = pageNumber(root.getAttribute('data-card-pagination-page-size'), 20);
							if (pageSize < 1) pageSize = 20;
							var initialHasMore = root.getAttribute('data-card-pagination-has-more');
							var status = root.querySelector('[data-card-pagination-status]');
							var statusHasMore = status && status.getAttribute('data-card-pagination-has-more');
							if (statusHasMore !== null) initialHasMore = statusHasMore;
							var initialCardCount = cardsFor(list, root).length;
							var hasMore = initialHasMore === null ? initialCardCount >= pageSize : initialHasMore === 'true';
							var state = {
								root: root,
								list: list,
								pageSize: pageSize,
								nextPage: Math.max(1, Math.ceil(initialCardCount / pageSize)),
								nextOffset: initialCardCount,
								hasMore: hasMore,
								loading: false,
								generation: 0,
								controller: null,
								requestedPages: Object.create(null),
								keys: Object.create(null),
								search: initialSearch || '',
								searchTimer: null,
								input: null,
								observer: null,
								scrollTarget: null,
								scrollHandler: null,
								sentinel: null,
								failedPage: null,
									failedReplace: false,
									resetPending: false,
									replaceSnapshot: null,
									invalidated: false							};
							rememberCards(state, cardsFor(list, root), true);
							return state;
						}

						function destroyState(state) {
							if (!state) return;
							state.generation++;
							if (state.controller) state.controller.abort();
							if (state.searchTimer) clearTimeout(state.searchTimer);
							disconnectTrigger(state);
							state.loading = false;
						}

						function initRoot(root, initialDocument) {
							var list = listFor(root);
							if (!list) return;
							var state = root._openVibelyCardPaginationState;
							if (state && (state.list !== list || state.invalidated)) {
								destroyState(state);
								state = null;
							}
							var listChanged = !state;
								var input = root.querySelector('input[data-card-search]');
								var term = input ? (input.value || '').trim() : '';
								var replacementSnapshot = root.id ? replacementSnapshots[root.id] : null;
								if (!state) {
									state = createState(root, list, replacementSnapshot ? term : '');
									root._openVibelyCardPaginationState = state;
								}							bindSearch(state);
							setStatus(state, 'idle');
							if (state.resetPending) return;
								if (listChanged && term && state.search !== term) {								state.resetPending = true;
								setTimeout(function() {
									if (!isCurrent(state)) return;
									state.resetPending = false;
									resetSearch(state, term);
								}, 0);
									return;
								}
								if (replacementSnapshot && root.id) {
									delete replacementSnapshots[root.id];
									restoreReplacementState(state, replacementSnapshot);
								}
								connectTrigger(state);						}

						function initRoots(scope, initialDocument) {
							var roots = rootsIn(scope);
							for (var i = 0; i < roots.length; i++) initRoot(roots[i], initialDocument);
						}

						function clearDetachedReplacementSnapshots() {
							for (var id in replacementSnapshots) {
								if (!document.getElementById(id)) delete replacementSnapshots[id];
							}
						}

						function destroyCardPagination(scope, preserveReplacement) {
							var roots = rootsIn(scope || document);
							for (var i = 0; i < roots.length; i++) {
								var state = roots[i]._openVibelyCardPaginationState;
								if (!state) continue;
								if (preserveReplacement) rememberReplacementSnapshot(state);
								destroyState(state);
								state.invalidated = true;
								roots[i]._openVibelyCardPaginationState = null;
							}
						}

						window.refreshCardPagination = function(scope) {
							initRoots(scope || document, false);
						};
						window.cardCollectionActionURL = cardCollectionActionURL;
						window.cardPaginationRefreshURL = cardPaginationRefreshURL;
						window.destroyCardPagination = destroyCardPagination;

							function invalidateRoots(scope) {							var roots = rootsIn(scope);
							for (var i = 0; i < roots.length; i++) {
								var state = roots[i]._openVibelyCardPaginationState;
								if (state) {
									state.generation++;
									if (state.controller) state.controller.abort();
									state.controller = null;
									state.loading = false;
									state.invalidated = true;
									disconnectTrigger(state);
								}
							}
						}

						setTimeout(function() {
							initRoots(document, true);
						}, 0);
						if (document.body) {
							document.body.addEventListener('htmx:configRequest', function(event) {
								var detail = event.detail || {};
								if (!detail.path) return;
								var root = closestPaginationRoot(detail.elt) || closestPaginationRoot(detail.target);
								if (!root) return;
								var list = listFor(root);
								var target = detail.target;
								var replacesWindow = target === root || target === list || (target && list && typeof target.contains === 'function' && target.contains(list));
								if (replacesWindow) detail.path = cardPaginationRefreshURL(root, detail.path);
							});
							document.body.addEventListener('htmx:beforeSwap', function(event) {
								var target = event.detail && event.detail.target;
								if (!target) return;
								var roots = rootsIn(target);
								for (var i = 0; i < roots.length; i++) {
									var state = roots[i]._openVibelyCardPaginationState;
									if (!state) continue;
									var selector = roots[i].getAttribute('data-card-pagination-list');
									var replacesList = target === state.root || target === state.list || (target.querySelector && selector && target.querySelector(selector));
									if (replacesList) {
										rememberReplacementSnapshot(state);
										invalidateRoots(roots[i]);
									}
								}
							});
							document.body.addEventListener('htmx:afterSettle', function(event) {
								var scope = event.detail && event.detail.elt ? event.detail.elt : document;
								initRoots(scope);
								if (scope !== document) initRoots(document);
								setTimeout(function() {
									initRoots(document);
									clearDetachedReplacementSnapshots();
								}, 0);
							});
						}
					})();
				</script>
			<!-- Desktop external-link bridge -->
			<script>
					// In Wails desktop mode, the embedded WebView does not handle
					// target="_blank" or new-window navigation, so clicks on anchors
					// like the Task Changes "View PR" link silently do nothing.
					// Intercept clicks on external links and route them through the
					// Wails Browser.OpenURL bridge or the server-side desktop opener
					// so they open in the user's real system browser. In web/server
					// mode this helper is inert, preserving normal anchor behavior.
				(function() {
						function isDesktopRuntime() {
							try {
								if (typeof window === 'undefined') return false;
								var serverRuntime = document.documentElement.getAttribute('data-openvibely-runtime');
								if (serverRuntime === 'desktop') return true;
								if (window.location && window.location.protocol === 'wails:') return true;
								if (typeof window.wails !== 'undefined') return true;
								if (typeof window._wails !== 'undefined') return true;
								if (typeof window.runtime !== 'undefined') return true;
								if (typeof window.__WAILS__ !== 'undefined') return true;
								return false;
							} catch (_) {
								return false;
							}
						}
						function isExternalHref(href) {
						if (!href) return false;
						var lower = String(href).toLowerCase();
						return lower.indexOf('http://') === 0 || lower.indexOf('https://') === 0 || lower.indexOf('mailto:') === 0;
					}
					// openExternalViaBackend calls the server-side /open-external
					// endpoint, which uses the OS browser opener (browser.OpenURL).
					// This is the most reliable path in desktop mode because the
					// Wails runtime JS is not always injected when the WebView loads
					// from an HTTP server URL rather than the Wails asset server.
						function openExternalViaBackend(url) {
							fetch('/open-external?url=' + encodeURIComponent(url), {
								method: 'POST',
								headers: { 'X-OpenVibely-Desktop': '1' }
							})
								.then(function(r) {
								if (!r.ok) { throw new Error('HTTP ' + r.status); }
							})
							.catch(function() {
								if (window.showToast) {
									window.showToast('Failed to open in system browser: ' + url, 'failed');
								}
							});
					}
					function callWailsOpenURL(url) {
						// Try Wails v3 Browser.OpenURL (injected runtime).
						try {
							if (window.wails && window.wails.Browser && typeof window.wails.Browser.OpenURL === 'function') {
								var p = window.wails.Browser.OpenURL(url);
								if (p && typeof p.then === 'function') {
									// If the Wails API rejects, fall back to the backend endpoint.
									p.catch(function() { openExternalViaBackend(url); });
								}
								return true;
							}
							// Older Wails runtime shape.
							if (window.wails && typeof window.wails.OpenURL === 'function') {
								var p2 = window.wails.OpenURL(url);
								if (p2 && typeof p2.then === 'function') {
									p2.catch(function() { openExternalViaBackend(url); });
								}
								return true;
							}
						} catch (_) { /* fall through */ }
						// Wails JS API unavailable — use server-side opener.
						openExternalViaBackend(url);
						return true; // handled asynchronously
					}
						function isChatMessageExternalLink(anchor) {
							return !!(anchor && anchor.getAttribute('data-openvibely-chat-external-link') === 'true' && anchor.closest && anchor.closest('.chat-stream-content, [id^="streaming-message-"], [data-raw-content]'));
						}
						function handleAnchorClick(event) {
							// Allow modifier-clicks to fall through.
							if (event.defaultPrevented) return;
							if (event.button !== undefined && event.button !== 0) return;
							if (event.metaKey || event.ctrlKey || event.shiftKey || event.altKey) return;
							var target = event.target;
							var anchor = target && target.closest ? target.closest('a[href]') : null;
							if (!anchor) return;
							var href = anchor.getAttribute('href');
							if (!href) return;
							var desktop = isDesktopRuntime();
							var chatExternal = isChatMessageExternalLink(anchor);
							if (!desktop && !chatExternal) return;
							// Only act on external links or links explicitly marked target="_blank".
							var blank = anchor.getAttribute('target') === '_blank';
							if (!isExternalHref(href) && !blank && !chatExternal) return;
							// If it's target="_blank" but a relative URL, resolve to absolute first
							// so the system browser receives a usable URL.
							var absolute = anchor.getAttribute('data-openvibely-external-url') || href;
							try {
								absolute = new URL(absolute, window.location.href).toString();
							} catch (_) {}
							if (!isExternalHref(absolute)) {
								// Same-origin relative link in a new tab: let default behavior happen.
								return;
							}
							event.preventDefault();
							event.stopPropagation();
							if (desktop) {
								callWailsOpenURL(absolute);
								return;
							}
							try {
								window.open(absolute, '_blank', 'noopener,noreferrer');
							} catch (_) {
								if (window.showToast) window.showToast('Failed to open link: ' + absolute, 'failed');
							}
						}
					document.addEventListener('click', handleAnchorClick, true);
					// Expose for callers that need an explicit opener (e.g., dropdown item buttons).
					window.openExternalURL = function(url) {
						if (!url) return false;
						if (!isDesktopRuntime()) {
							try { window.open(url, '_blank', 'noopener,noreferrer'); return true; } catch (_) { return false; }
						}
						return callWailsOpenURL(url);
					};
				})();
			</script>
		</body>
	</html>
}
