					} else if (trigger && event.target !== trigger && dropdown.getAttribute('data-kanban-menu-positioning') === 'true') {
						dropdown.__openVibelyPositionGeneration = (dropdown.__openVibelyPositionGeneration || 0) + 1;
						positionDropdownForViewport(trigger);
						dropdown.removeAttribute('data-kanban-menu-positioning');
					}
					openKanbanMenuKey = dropdown.getAttribute('data-kanban-menu-key');
					const board = dropdown.closest('#kanban-board');
					if (board) {
						board.setAttribute('data-open-kanban-menu-key', openKanbanMenuKey);
						snapshotKanbanInteraction(board);
					}
					document.querySelectorAll('[data-kanban-menu-key]').forEach(function(candidate) {
