							var mode = modeForTheme(themeID);
							var html = document.documentElement;
							html.setAttribute('data-theme', mode);
							html.setAttribute('data-color-theme', themeID);
							if (persist) {
								try { localStorage.setItem('theme', themeID); } catch (_) {}
								persistUIPreference({ theme: themeID });
							}

							// Update toggle icon
							var icons = document.querySelectorAll('.theme-toggle-icon');
							icons.forEach(function(icon) {
								icon.setAttribute('data-theme-current', mode);
							});
						};

						window.toggleTheme = function() {
							var current = document.documentElement.getAttribute('data-theme');
							var nextMode = (current === 'dark') ? 'light' : 'dark';
							window.applyOpenVibelyTheme(nativeThemeByMode[nextMode], true);
						};

						window.applyOpenVibelyTheme(document.documentElement.getAttribute('data-color-theme'), false);

