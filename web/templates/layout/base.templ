						}
						if (hadOpenMenu) window.dispatchEvent(new CustomEvent('kanban-refresh-unblocked'));
					}				window.closeKanbanMenu = closeKanbanMenu;

				function resetKanbanInteractionForNavigation() {
					clearSelection();
					closeKanbanMenu(null, false);
					document.querySelectorAll('#kanban-board .task-selected').forEach(function(card) {
						card.classList.remove('task-selected');
					});
				}

				function restoreKanbanInteraction(board) {
					const snapshot = savedKanbanInteraction;
					if (!snapshot) return;
					selectedTasks.clear();
					snapshot.selectedTaskIDs.forEach(function(id) {
						const card = document.getElementById('task-' + id);
						if (!card || !board.contains(card)) return;
						selectedTasks.add(id);
						card.classList.add('task-selected');
					});
					const menuKey = snapshot.menuKey || openKanbanMenuKey;
					if (!menuKey) return;
					const dropdown = Array.from(board.querySelectorAll('[data-kanban-menu-key]')).find(function(candidate) {
						return candidate.getAttribute('data-kanban-menu-key') === menuKey;
					});
					if (!dropdown) {
						closeKanbanMenu(null, false);
						return;
					}
					const trigger = dropdown.querySelector('[data-kanban-menu-trigger]');
					let focusTarget = trigger;
					if (snapshot.focusRole === 'content') focusTarget = dropdown.querySelector('[data-kanban-menu-content]') || trigger;
					if (snapshot.focusRole === 'item') {
						focusTarget = Array.from(dropdown.querySelectorAll('a, button, [tabindex]')).find(function(candidate) {
							return kanbanMenuItemKey(candidate) === snapshot.focusKey;
						}) || trigger;
					}
					if (focusTarget) {
						openKanbanMenuKey = menuKey;
						board.setAttribute('data-open-kanban-menu-key', menuKey);
