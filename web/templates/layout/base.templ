						// Save scroll positions of all scrollable drop zones
						const dropZones = document.querySelectorAll('.category-drop-zone, .task-drop-zone');
						dropZones.forEach(function(zone, index) {
							if (zone.scrollTop > 0) {
								// Use category/status as key if available, otherwise use index
								const category = zone.getAttribute('data-category');
								const status = zone.getAttribute('data-status');
								const key = category || (status ? 'active-' + status : 'zone-' + index);
								savedScrollPositions.set(key, zone.scrollTop);
