package layout

// AccountUsageRail lives outside the scrolling navigation so account controls stay
// next to Settings. Provider permissions remain enforced by the Analytics API.
templ AccountUsageRail() {
 <div id="rail-accounts" aria-label="Subscription accounts"></div>
 <div id="rail-account-popup" class="ov-menu" popover="manual" role="dialog" aria-label="Subscription usage" hidden></div>
 <div id="rail-overflow" class="ov-menu ov-menu-actions" popover="manual" role="menu" aria-label="More navigation" hidden></div>
 <style>
#rail-accounts {
  display: flex;
  flex-direction: column;
  align-items: center;
  gap: 2px;
  flex-shrink: 0;
  max-height: 35vh;
  overflow-y: auto;
  scrollbar-width: thin;
}
.rail-account,
:is(#rail-more, #sidebar [data-plugin-nav-overflow] > button) {
  display: flex;
  align-items: center;
  justify-content: center;
  flex-shrink: 0;
  width: 36px;
  height: 36px;
  padding: 0;
  margin: auto;
  border: 0;
  border-radius: 8px;
  color: inherit;
  background: transparent;
  cursor: pointer;
}
.rail-account:hover,
.rail-account[aria-expanded="true"],
:is(#rail-more, #sidebar [data-plugin-nav-overflow] > button):hover,
:is(#rail-more, #sidebar [data-plugin-nav-overflow] > button)[aria-expanded="true"] {
  background: oklch(var(--bc) / 0.06);
}
.rail-account:is(:hover, :active, :focus-visible, [aria-expanded="true"]),
:is(#rail-more, #sidebar [data-plugin-nav-overflow] > button):is(:hover, :active, :focus-visible, [aria-expanded="true"]) {
  color: oklch(var(--bc));
  --ov-usage-remaining: currentColor;
}
.rail-account:focus-visible,
:is(#rail-more, #sidebar [data-plugin-nav-overflow] > button):focus-visible {
  outline: 2px solid var(--ov-focus, oklch(var(--p)));
  outline-offset: 2px;
}
.rail-account svg {
  width: 28px;
  height: 28px;
}
.rail-account text,
[data-meter-preview] text {
  fill: currentColor;
  opacity: 0.75;
  font: 600 9px system-ui;
}
:root {
  --ov-usage-remaining: oklch(var(--bc) / 0.75);
  --ov-usage-used: oklch(var(--bc) / 0.12);
}
[data-color-theme-kind^="high-contrast"] {
  --ov-usage-remaining: currentColor;
  --ov-usage-used: oklch(var(--bc) / 0.4);
}
@media (forced-colors: active) {
  .rail-account {
    --ov-usage-remaining: CanvasText;
    --ov-usage-used: GrayText;
    forced-color-adjust: none;
  }
}
#rail-account-popup[hidden], #rail-overflow[hidden] { display: none !important; }
#rail-account-popup[data-menu-open], #rail-overflow[data-menu-open] { display: block; position: fixed; z-index: 1000; }
#rail-account-popup {
  width: 330px;
  max-width: calc(100vw - 24px);
  max-height: calc(100dvh - 24px);
  overflow: auto;
  margin: 0;
  padding: 16px;
}
#rail-overflow {
  width: 190px;
  margin: 0;
}
#rail-overflow > li {
  list-style: none;
}
#rail-overflow a {
  display: flex;
  align-items: center;
  width: 100% !important;
  height: auto !important;
  min-height: 0 !important;
  padding: 7px 10px !important;
  justify-content: flex-start !important;
  gap: 10px !important;
  opacity: 1;
}
#rail-overflow .sidebar-text {
  display: inline !important;
  width: auto !important;
  opacity: 1 !important;
  visibility: visible !important;
}
#rail-overflow svg {
  width: 20px;
  height: 20px;
}
:is(#rail-more, #sidebar [data-plugin-nav-overflow] > button) svg {
  width: 20px;
  height: 20px;
  opacity: 0.75;
}
:is(#rail-more, #sidebar [data-plugin-nav-overflow] > button):is(:hover, :active, :focus-visible, [aria-expanded="true"]) svg {
  opacity: 1;
}
.rail-usage-heading {
  font-weight: 600;
}
.rail-usage-meta {
  font-size: 11px;
  opacity: 0.7;
  margin-top: 4px;
}
.rail-usage-limit {
  margin-top: 16px;
}
.rail-usage-row {
  display: flex;
  justify-content: space-between;
  align-items: center;
  gap: 12px;
}
.rail-usage-track {
  display: flex;
  height: 5px;
  border-radius: 8px;
  overflow: hidden;
  margin: 7px 0;
}
.rail-usage-track > span {
  background: var(--ov-usage-used);
}
.rail-usage-track::after {
  content: "";
  flex: 1;
  background: var(--ov-usage-remaining);
}
.rail-usage-resets,
.rail-usage-footer {
  border-top: 1px solid var(--ov-border-subtle);
  margin-top: 16px;
  padding-top: 12px;
}
.rail-usage-reset {
  margin-top: 12px;
}
.rail-usage-reset button {
  flex-shrink: 0;
}
html[data-shell-frame] .sidebar-aside.sidebar-collapsed .menu a,
html[data-shell-frame] .sidebar-aside.sidebar-collapsed .menu summary {
  width: 36px !important;
  height: 36px !important;
  min-height: 36px !important;
}
html[data-shell-frame] .sidebar-aside .menu a svg {
  width: 20px;
  height: 20px;
}
html[data-shell-frame] .sidebar-aside .sidebar-footer {
  padding-top: 2px;
}
html[data-shell-frame] #sidebar .sidebar-footer-menu {
  transform: none;
}
</style>
 <script>
(() => {
  if (window.openVibelyAccountRail) return;
  const host = document.getElementById("rail-accounts"),
    popup = document.getElementById("rail-account-popup"),
    overflow = document.getElementById("rail-overflow");
  if (!host || !popup || !overflow) return;
  const state = {
    accounts: [],
    selected: null,
    loading: false,
    denied: false,
    busy: false,
    attempts: (window.openVibelyResetAttempts ||= new Map()),
    reads: new Map(),
    timer: null,
    lastRefresh: 0,
    scope: "",
  };
  window.openVibelyAccountRail = state;
  const el = (tag, cls, text) => {
    const n = document.createElement(tag);
    if (cls) n.className = cls;
    if (text !== undefined) n.textContent = text;
    return n;
  };
  const provider = (a) => (a.provider === "openai" ? "OpenAI" : "Anthropic");
  const identity = (a) => a.identity || provider(a) + " account";
  const compare = (a, b) =>
    (a.provider === "openai" ? 0 : 1) - (b.provider === "openai" ? 0 : 1) ||
    identity(a).localeCompare(identity(b), "en", {
      sensitivity: "base",
      numeric: true,
    }) ||
    a.key.localeCompare(b.key, "en");
  const limits = (a) =>
    a.data?.limits?.length
      ? a.data.limits
      : [
          a.data?.primary_limit,
          a.data?.secondary_limit,
          ...(a.data?.extra_limits || []),
        ].filter(Boolean);
  const mainLimit = (a, minutes) =>
    limits(a).find(
      (l) =>
        l.window_minutes === minutes &&
        !/sonnet|opus|model|review/i.test((l.limit_key || "") + " " + l.label),
    ) ||
    limits(a).find((l) =>
      minutes === 300
        ? /^(five_hour|5.hour|session)$/i.test(l.limit_key || "")
        : /^(seven_day|weekly)$/i.test(l.limit_key || ""),
    );
  const percent = (l) =>
    l &&
    l.used_percent !== null &&
    l.used_percent !== undefined &&
    Number.isFinite(Number(l.used_percent))
      ? Math.max(0, Math.min(100, Number(l.used_percent)))
      : null;
  const nativePopover = typeof popup.showPopover === "function";
  function surfaceShown(surface) {
    return nativePopover ? surface.matches(":popover-open") : !surface.hidden;
  }
  function showSurface(surface) {
    surface.hidden = false;
    if (nativePopover) surface.showPopover();
    else {
      surface.removeAttribute("popover");
      surface.setAttribute("data-menu-open", "");
    }
  }
  function hideSurface(surface) {
    if (nativePopover && surfaceShown(surface)) surface.hidePopover();
    surface.hidden = true;
    surface.removeAttribute("data-menu-open");
  }
  const shown = () => surfaceShown(popup);
  function position(surface, button, alignTop = false) {
    if (!button) return;
    const r = button.getBoundingClientRect();
    surface.style.left =
      Math.max(
        12,
        Math.min(innerWidth - surface.offsetWidth - 12, r.right + 12),
      ) + "px";
    surface.style.top =
      Math.max(
        12,
        Math.min(
          innerHeight - surface.offsetHeight - 12,
          alignTop ? r.top : r.bottom - surface.offsetHeight,
        ),
      ) + "px";
  }
  const usageMenu = window.ovMenuController.create({
    trigger: () => host.querySelector('[data-key="' + CSS.escape(state.selected || "") + '"]'),
    panels: () => [popup],
    isOpen: shown,
    open: () => showSurface(popup),
    close: () => hideSurface(popup),
  });
  const nav = document.querySelector("#sidebar .sidebar-inner > .menu");
  const more = el("button", "", "");
  more.id = "rail-more";
  more.type = "button";
  more.title = "More navigation";
  more.setAttribute("aria-label", "More navigation");
  more.setAttribute("aria-haspopup", "true");
  more.setAttribute("aria-expanded", "false");
  more.setAttribute("aria-controls", "rail-overflow");
  more.innerHTML =
    '<svg viewBox="0 0 24 24" fill="currentColor" aria-hidden="true"><circle cx="5" cy="12" r="1.6"/><circle cx="12" cy="12" r="1.6"/><circle cx="19" cy="12" r="1.6"/></svg>';
  const moreItem = el("li");
  moreItem.append(more);
  // Keep the popup outside the rail so WebKit hit-tests it over the task list.
  document.body.append(overflow);
  const paths = ["/analytics", "/insights", "/history", "/upcoming"];
  for (const path of paths) {
    const link = nav?.querySelector('[data-nav-base="' + path + '"]');
    if (!link) continue;
    if (!moreItem.isConnected) link.closest("li").before(moreItem);
    link.setAttribute("role", "menuitem");
    link.closest("li").setAttribute("role", "none");
    overflow.append(link.closest("li"));
  }
  nav?.querySelectorAll(".menu-title").forEach((n) => {
    if (n.textContent.includes("Insights")) {
      const previous = n.previousElementSibling;
      if (previous?.classList.contains("sidebar-divider")) previous.remove();
      n.remove();
    }
  });
  const overflowMenu = window.ovMenuController.create({
    trigger: more,
    panels: () => [overflow],
    isOpen: () => surfaceShown(overflow),
    open: (event) => {
      showSurface(overflow);
      position(overflow, more, true);
      if (event.detail === 0) overflow.querySelector("a")?.focus();
    },
    close: () => hideSurface(overflow),
  });
  more.onclick = (event) => overflowMenu.toggle(event);
  overflow.addEventListener("click", (e) => {
    if (e.target.closest("a")) overflowMenu.close();
  });
  overflow.addEventListener("keydown", (e) => {
    const links = [...overflow.querySelectorAll("a")];
    if (!["ArrowDown", "ArrowUp", "Home", "End"].includes(e.key)) return;
    e.preventDefault();
    const i = links.indexOf(document.activeElement);
    links[
      e.key === "Home"
        ? 0
        : e.key === "End"
          ? links.length - 1
          : (i + (e.key === "ArrowDown" ? 1 : -1) + links.length) % links.length
    ]?.focus();
  });
  async function read(url, options) {
    if (!options && state.reads.has(url)) return state.reads.get(url);
    const request = (async () => {
      const controller = new AbortController();
      const timer = setTimeout(() => controller.abort(), 20000);
      try {
        const response = await fetch(url, {
          credentials: "same-origin",
          ...options,
          signal: controller.signal,
        });
        if (
          response.status === 401 ||
          response.status === 403 ||
          response.status === 404
        ) {
          const error = new Error("Account usage is unavailable.");
          error.denied = true;
          throw error;
        }
        if (!response.ok) throw new Error("Unable to refresh account usage.");
        return await response.json();
      } finally {
        clearTimeout(timer);
      }
    })();
    if (!options) state.reads.set(url, request);
    try {
      return await request;
    } finally {
      state.reads.delete(url);
    }
  }
  const url = (projection, key, refresh = false) => {
    const q = new URLSearchParams({ projection });
    const project = document.getElementById("project-selector")?.value;
    if (project) q.set("project_id", project);
    if (key) q.set("account_key", key);
    if (refresh) q.set("refresh", "true");
    return "/api/analytics/usage?" + q;
  };
  const providerLogoPaths = {"anthropic": ["M17.3041 3.541h-3.6718l6.696 16.918H24Z", "M6.6959 3.541 0 20.459h3.7442l1.3693-3.5527h7.0052l1.3693 3.5528h3.7442L10.5363 3.5409Zm-.3712 10.2232 2.2914-5.9456 2.2914 5.9456Z"], "openai": ["M22.282 9.821a5.985 5.985 0 0 0-.516-4.91 6.046 6.046 0 0 0-6.51-2.9A6.065 6.065 0 0 0 4.981 4.18a5.998 5.998 0 0 0-3.998 2.9 6.046 6.046 0 0 0 .743 7.097 5.98 5.98 0 0 0 .51 4.911 6.051 6.051 0 0 0 6.515 2.9A5.985 5.985 0 0 0 13.26 24a6.056 6.056 0 0 0 5.772-4.206 5.99 5.99 0 0 0 3.997-2.9 6.056 6.056 0 0 0-.747-7.073zM13.26 22.43a4.476 4.476 0 0 1-2.876-1.04l.141-.081 4.779-2.758a.795.795 0 0 0 .392-.681v-6.737l2.02 1.168a.071.071 0 0 1 .038.052v5.583a4.504 4.504 0 0 1-4.494 4.494zM3.6 18.304a4.47 4.47 0 0 1-.535-3.014l.142.085 4.783 2.759a.771.771 0 0 0 .78 0l5.843-3.369v2.332a.08.08 0 0 1-.033.062L9.74 19.95a4.5 4.5 0 0 1-6.14-1.646zM2.34 7.896a4.485 4.485 0 0 1 2.366-1.973V11.6a.766.766 0 0 0 .388.676l5.815 3.355-2.02 1.168a.076.076 0 0 1-.071 0l-4.83-2.786A4.504 4.504 0 0 1 2.34 7.872zm16.597 3.855l-5.833-3.387L15.119 7.2a.076.076 0 0 1 .071 0l4.83 2.791a4.494 4.494 0 0 1-.676 8.105v-5.678a.79.79 0 0 0-.407-.667zm2.01-3.023l-.141-.085-4.774-2.782a.776.776 0 0 0-.785 0L9.409 9.23V6.897a.066.066 0 0 1 .028-.061l4.83-2.787a4.5 4.5 0 0 1 6.68 4.66zm-12.64 4.135l-2.02-1.164a.08.08 0 0 1-.038-.057V6.085a4.5 4.5 0 0 1 7.375-3.453l-.142.08L8.704 5.46a.795.795 0 0 0-.393.681zm1.097-2.365l2.602-1.5 2.607 1.5v2.999l-2.597 1.5-2.607-1.5z"]};
  let logoSequence = 0;
  function svgFor(a, style = window.openVibelyDisplay?.get("meters") || "logos") {
    const svg = document.createElementNS("http://www.w3.org/2000/svg", "svg");
    svg.setAttribute("viewBox", "0 0 40 40");
    svg.setAttribute("aria-hidden", "true");
    const add = (tag, attrs) => {
      const n = document.createElementNS(svg.namespaceURI, tag);
      for (const [k, v] of Object.entries(attrs)) n.setAttribute(k, String(v));
      svg.append(n);
      return n;
    };
    const weekly = mainLimit(a, 10080),
      five = mainLimit(a, 300);
    const logo = (x, y, size, color, clip) => {
      const group = add("g", {transform: `translate(${x} ${y}) scale(${size / 24})`, fill: color});
      for (const d of providerLogoPaths[a.provider] || []) {
        const path = document.createElementNS(svg.namespaceURI, "path");
        path.setAttribute("d", d); group.append(path);
      }
      if (clip) {
        const wrapper = add("g", {"clip-path": `url(#${clip})`});
        wrapper.append(group);
      }
    };
    const bar = (limit, y) => {
      const p = percent(limit);
      add("rect", {x:5,y,width:30,height:2.4,rx:1.2,fill:"var(--ov-usage-used)"});
      if (p !== null) add("rect", {x:5+30*p/100,y,width:30*(100-p)/100,height:2.4,rx:1.2,fill:"var(--ov-usage-remaining)"});
    };
    if (style === "fill" || style === "bars") {
      if (style === "fill") {
        // Weekly fills the logo; a separate bar retains the independent 5-hour limit.
        const p = percent(weekly);
        logo(5,4,30,"var(--ov-usage-used)");
        if (p !== null) {
          const id = "usage-logo-" + (++logoSequence);
          const clip = add("clipPath", {id});
          const rect = document.createElementNS(svg.namespaceURI, "rect");
          for (const [k,v] of Object.entries({x:0,y:4+30*p/100,width:40,height:30*(100-p)/100})) rect.setAttribute(k,v);
          clip.append(rect);
          logo(5,4,30,"var(--ov-usage-remaining)",id);
        }
        if (five) bar(five,37);
      } else {
        logo(8,1,24,"var(--ov-usage-remaining)");
        if (weekly) bar(weekly,30);
        if (five) bar(five,36);
      }
      return svg;
    }
    const available = [
      ...(weekly ? [[weekly, 17]] : []),
      ...(five ? [[five, weekly ? 12.5 : 17]] : []),
    ];
    if (!available.length) {
      add("circle", {
        cx: 20,
        cy: 20,
        r: 17,
        fill: "none",
        stroke: "var(--ov-usage-used)",
        "stroke-width": 1.67,
        "vector-effect": "non-scaling-stroke",
        "stroke-dasharray": "2 3",
      });
    } else
      for (const [limit, r] of available) {
        const p = percent(limit);
        if (p === null) {
          add("circle", {
            cx: 20,
            cy: 20,
            r,
            fill: "none",
            stroke: "var(--ov-usage-used)",
            "stroke-width": 1.67,
            "vector-effect": "non-scaling-stroke",
            "stroke-dasharray": "2 3",
          });
          continue;
        }
        const stroke = {fill: "none", "stroke-width": 1.67, "vector-effect": "non-scaling-stroke"};
        add("circle", {cx: 20, cy: 20, r, ...stroke,
          stroke: p === 0 ? "var(--ov-usage-remaining)" : "var(--ov-usage-used)"});
        if (p > 0 && p < 100) {
          // Draw the remaining arc in viewBox coordinates so scaling the icon
          // cannot change its length relative to the non-scaling stroke.
          const angle = 2 * Math.PI * p / 100;
          const x = 20 + r * Math.sin(angle);
          const y = 20 - r * Math.cos(angle);
          add("path", {...stroke, stroke: "var(--ov-usage-remaining)",
            d: `M ${x} ${y} A ${r} ${r} 0 ${p < 50 ? 1 : 0} 1 20 ${20 - r}`});
        }
      }
    if (style === "logos") {
      const size = weekly && five ? 16 : 22;
      logo((40-size)/2,(40-size)/2,size,"var(--ov-usage-remaining)");
    } else add("text", { x: 20, y: 23.4, "text-anchor": "middle" }).textContent =
      a.provider === "openai" ? "O" : "A";
    return svg;
  }
  window.openVibelyUsageMeterPreview = (provider, style) => svgFor({provider, data:{limits:[
    {window_minutes:10080,used_percent:55,label:"Weekly"},
    {window_minutes:300,used_percent:25,label:"5-hour"},
  ]}}, style);
  document.dispatchEvent(new CustomEvent("openvibely:usage-meter-ready"));
  document.addEventListener("openvibely:display-change", (event) => {
    if (event.detail?.name === "meters") drawRail();
  });
  function drawRail() {
    const focused = document.activeElement?.dataset.key;
    const nodes = state.accounts.filter((a) => limits(a).some((l) => percent(l) !== null)).map((a) => {
      const button = el("button", "rail-account");
      button.type = "button";
      button.dataset.key = a.key;
      button.setAttribute("aria-controls", popup.id);
      button.setAttribute(
        "aria-expanded",
        String(shown() && state.selected === a.key),
      );
      const info = limits(a)
        .map(
          (l) =>
            l.label +
            ": " +
            (percent(l) === null
              ? "unknown"
              : (100 - percent(l)).toFixed(0) + "% left"),
        )
        .join(", ");
      button.title =
        provider(a) +
        " · " +
        identity(a) +
        (a.error
          ? " · Usage stale — refresh unavailable"
          : info
            ? " · " + info
            : " · Loading usage");
      button.setAttribute("aria-label", button.title);
      button.append(svgFor(a));
      // Match the rail overflow menus: activate again to close.
      button.onclick = () => openAccount(a);
      return button;
    });
    host.replaceChildren(...nodes);
    if (focused)
      host.querySelector('[data-key="' + CSS.escape(focused) + '"]')?.focus();
  }
  function resetTime(value) {
    if (!value) return "Reset time unavailable";
    const d = new Date(value);
    if (Number.isNaN(d.getTime())) return "Reset time unavailable";
    const totalMinutes = Math.ceil((d - Date.now()) / 60000);
    if (totalMinutes <= 0) return "Reset due";
    const days = Math.floor(totalMinutes / 1440);
    const hours = Math.floor((totalMinutes % 1440) / 60);
    const minutes = totalMinutes % 60;
    const parts = [];
    if (days > 0) parts.push(days + (days === 1 ? " day" : " days"));
    if (hours > 0) parts.push(hours + (hours === 1 ? " hour" : " hours"));
    if (minutes > 0 || !parts.length) parts.push(minutes + (minutes === 1 ? " minute" : " minutes"));
    return "Resets in " + parts.join(", ");
  }
  function drawPopup() {
    const a = state.accounts.find((a) => a.key === state.selected);
    if (!a) {
      usageMenu.close();
      return;
    }
    const focus = document.activeElement?.dataset.action;
    popup.replaceChildren();
    popup.setAttribute(
      "aria-label",
      provider(a) + " " + identity(a) + " usage",
    );
    popup.append(
      el(
        "div",
        "rail-usage-heading",
        provider(a) + (a.data?.plan_type ? " · " + a.data.plan_type : ""),
      ),
      el("div", "rail-usage-meta", identity(a)),
    );
    if (a.error)
      popup.append(
        el("p", "rail-usage-meta", "Usage is stale. Refresh failed; showing the last known allowance."),
      );
    if (!a.data)
      popup.append(el("p", "rail-usage-meta", "Loading usage…"));
    else {
      for (const l of limits(a)) {
        const section = el("div", "rail-usage-limit"),
          row = el("div", "rail-usage-row"),
          p = percent(l);
        row.append(
          el("span", "", l.label),
          el(
            "span",
            "",
            p === null ? "Unknown" : (100 - p).toFixed(0) + "% left",
          ),
        );
        section.append(row);
        if (p !== null) {
          const track = el("div", "rail-usage-track");
          track.setAttribute("role", "meter");
          track.setAttribute("aria-label", l.label + " remaining");
          track.setAttribute("aria-valuemin", "0");
          track.setAttribute("aria-valuemax", "100");
          track.setAttribute("aria-valuenow", String(100 - p));
          const used = el("span");
          used.style.width = p + "%";
          track.append(used);
          section.append(track);
        }
        section.append(el("div", "rail-usage-meta", resetTime(l.resets_at)));
        popup.append(section);
      }
      if (!limits(a).length)
        popup.append(
          el("p", "rail-usage-meta", "No live limit snapshot available."),
        );
    }
    if (a.resets?.available_count > 0) {
      const section = el("div", "rail-usage-resets");
      section.append(el("div", "rail-usage-heading", "Usage resets"));
      if (a.resets.unavailable_reason)
        section.append(
          el(
            "p",
            "rail-usage-meta",
            String(a.resets.unavailable_reason).replaceAll("_", " "),
          ),
        );
      if (!Array.isArray(a.resets.credits))
        section.append(
          el("p", "rail-usage-meta", "Reset details unavailable."),
        );
      for (const c of Array.isArray(a.resets.credits) ? a.resets.credits : []) {
        if (!c || typeof c !== "object" || c.status !== "available") continue;
        const row = el("div", "rail-usage-reset"),
          head = el("div", "rail-usage-row"),
          button = el("button", "btn btn-ghost btn-sm btn-square");
        button.type = "button";
        button.title = "Use reset";
        button.setAttribute("aria-label", "Use reset: " + (c.title || "Usage reset"));
        button.innerHTML = '<svg xmlns="http://www.w3.org/2000/svg" class="h-4 w-4" fill="none" viewBox="0 0 24 24" stroke="currentColor" aria-hidden="true"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M3 11a9 9 0 1 1 2.7 7.3"></path><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M3 3v8h8"></path></svg>';
        button.dataset.action = "reset-" + c.id;
        const raw = c.expires_at ?? c.expiresAt,
          expiry =
            raw == null
              ? null
              : new Date(typeof raw === "number" ? raw * 1000 : raw);
        button.disabled =
          state.busy ||
          !c.id ||
          c.usable === false ||
          (expiry &&
            (!Number.isFinite(expiry.getTime()) || expiry <= new Date()));
        button.onclick = () => redeem(a, c);
        head.append(el("span", "", c.title || "Usage reset"), button);
        row.append(head);
        const labels = {
          five_hour: "5-hour limit",
          seven_day: "Weekly limit",
          seven_day_sonnet: "Sonnet weekly limit",
          seven_day_opus: "Opus weekly limit",
        };
        const details = [
          c.remaining_uses !== undefined
            ? c.remaining_uses + " use(s) remaining"
            : "",
          Array.isArray(c.clears)
            ? "Resets " +
              c.clears
                .map((k) => labels[k] || String(k).replaceAll("_", " "))
                .join(", ")
            : "",
          c.gives_back_weekly ? "Returns usage to weekly allowance" : "",
          expiry
            ? Number.isFinite(expiry.getTime())
              ? (expiry <= new Date() ? "Expired" : resetTime(expiry).replace("Resets in ", "Expires in "))
              : "Expiration unavailable"
            : "Does not expire",
          c.usable === false
            ? String(
                c.unavailable_reason || "Currently unavailable",
              ).replaceAll("_", " ")
            : "",
        ].filter(Boolean);
        row.append(el("p", "rail-usage-meta", details.join(" · ")));
        section.append(row);
      }
      popup.append(section);
    }
    if (a.resetError)
      popup.append(
        el("p", "rail-usage-meta", "Reset availability could not be loaded."),
      );
    const message = el("p", "rail-usage-meta", a.message);
    message.setAttribute("role", "status");
    popup.append(message);
    const footer = el("div", "rail-usage-footer rail-usage-row");
    const stamp = a.data?.updated_at;
    footer.append(
      el(
        "span",
        "rail-usage-meta",
        a.refreshing ? "Refreshing…" : stamp
          ? "Updated " + new Date(stamp).toLocaleTimeString()
          : "Not yet updated",
      ),
    );
    const refresh = el("button", "btn btn-ghost btn-sm");
    refresh.type = "button";
    refresh.setAttribute("aria-label", "Refresh usage");
    refresh.setAttribute("data-tooltip-disabled", "");
    refresh.innerHTML = '<svg xmlns="http://www.w3.org/2000/svg" class="h-4 w-4" fill="none" viewBox="0 0 24 24" stroke="currentColor" aria-hidden="true"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M4 4v5h.582m15.356 2A8.001 8.001 0 004.582 9m0 0H9m11 11v-5h-.581m0 0a8.003 8.003 0 01-15.357-2m15.357 2H15"></path></svg>';
    refresh.dataset.action = "refresh";
    refresh.disabled = state.busy;
    refresh.onclick = () => loadAccount(a, true);
    footer.append(refresh);
    popup.append(footer);
    position(
      popup,
      host.querySelector('[data-key="' + CSS.escape(a.key) + '"]'),
    );
    if (focus)
      popup.querySelector('[data-action="' + CSS.escape(focus) + '"]')?.focus();
  }
  function applySnapshot(a, snapshot) {
    if (!snapshot) return;
    a.data = snapshot.account_limits?.[0] || null;
    a.error = snapshot.error || a.data?.error || "";
    a.resets = snapshot.resets || null;
    a.resetError = !!snapshot.reset_error;
    a.refreshing = !!snapshot.refreshing;
  }
  async function loadResets(a) {
    // Reset availability arrives with the same shared account snapshot.
    if (shown() && state.selected === a.key) drawPopup();
  }
  async function loadAccount(a, refresh = false) {
    try {
      const data = await read(url("snapshots", a.key, refresh));
      applySnapshot(a, data.snapshots?.[a.key]);
    } catch (e) {
      if (e.denied) { state.accounts = []; usageMenu.close(); }
      else a.error = e.message;
    }
    drawRail();
    if (shown() && state.selected === a.key) drawPopup();
  }
  async function openAccount(a) {
    if (shown() && state.selected === a.key) {
      usageMenu.close(true);
      return;
    }
    state.selected = a.key;
    a.message = "";
    usageMenu.open();
    drawRail();
    drawPopup();
    popup.querySelector('[data-action="refresh"]')?.focus();
    await loadResets(a);
  }
  async function redeem(a, c) {
    if (state.busy) return;
    state.busy = true;
    a.message = "Resetting…";
    drawPopup();
    const key = JSON.stringify([a.stable_key || a.key, c.id]);
    try {
      if (!state.attempts.has(key)) {
        const bytes = new Uint8Array(16);
        crypto.getRandomValues(bytes);
        bytes[6] = (bytes[6] & 15) | 64;
        bytes[8] = (bytes[8] & 63) | 128;
        const hex = Array.from(bytes, (b) => b.toString(16).padStart(2, "0")).join("");
        state.attempts.set(key, [hex.slice(0, 8), hex.slice(8, 12), hex.slice(12, 16), hex.slice(16, 20), hex.slice(20)].join("-"));
      }
      const result = await read("/api/analytics/usage/resets/consume", {
        method: "POST",
        headers: { "Content-Type": "application/json" },
        body: JSON.stringify({
          account_key: a.key,
          credit_id: c.id,
          idempotency_key: state.attempts.get(key),
        }),
      });
      if (!result.retry_same_request) state.attempts.delete(key);
      const messages = {
        reset: "Usage reset.",
        not_needed: "Your usage does not need a reset right now.",
        already_used: "That reset was already used.",
        no_longer_available:
          "That reset is no longer available. Nothing was used.",
        cooldown: "A reset was just started. Try again in a minute.",
        in_progress:
          "Your earlier reset may still be processing. Try again in a minute.",
      };
      a.message =
        messages[result.outcome] ||
        "Could not confirm the reset. Retry to check the same request.";
      await loadAccount(a, false);
      await loadResets(a);
    } catch (_) {
      a.message =
        "Could not confirm the reset. Retry to check the same request.";
    } finally {
      state.busy = false;
      if (shown()) drawPopup();
      document.body.dispatchEvent(
        new CustomEvent("accountUsageChanged", { detail: { source: "rail" } }),
      );
    }
  }
  async function refreshAll() {
    const scope = document.getElementById("project-selector")?.value || "";
    if (state.loading) { state.pendingRefresh = true; return; }
    if (document.hidden) return;
    state.scope = scope;
    state.lastRefresh = Date.now();
    state.loading = true;
    try {
      const inventory = await read(url("accounts"));
      ensureUsageSubscription();
      const old = new Map(state.accounts.map((a) => [a.key, a]));
      state.accounts = (inventory.accounts || [])
        .filter((a) => ["openai", "anthropic"].includes(a.provider))
        .map((a) => Object.assign(old.get(a.key) || {}, a))
        .sort(compare);
      state.denied = false;
      drawRail();
      if (shown()) drawPopup();
      const data = await read(url("snapshots"));
      state.accounts.forEach((a) => applySnapshot(a, data.snapshots?.[a.key]));
      drawRail();
      if (shown()) drawPopup();
    } catch (e) {
      if (e.denied) {
        state.subscription?.close();
        state.subscription = null;
        state.denied = true;
        state.accounts = [];
        usageMenu.close();
        drawRail();
      } else {
        state.accounts.forEach((a) => (a.error = e.message));
        drawRail();
        if (shown()) drawPopup();
      }
    } finally {
      state.loading = false;
      if (state.pendingRefresh || (document.getElementById("project-selector")?.value || "") !== state.scope) {
        state.pendingRefresh = false; refreshAll();
      }
    }
  }
  window.addEventListener("resize", () => {
    usageMenu.close();
    overflowMenu.close();
  });
  document.addEventListener("visibilitychange", () => {
    if (!document.hidden) refreshAll();
  });
  document.body.addEventListener("htmx:afterSettle", (event) => {
    if (event.detail?.target?.id !== "main-content") return;
    usageMenu.close();
    overflowMenu.close();
    refreshAll();
  });
  document.body.addEventListener("accountUsageChanged", (event) => {
    if (event.detail?.source === "rail") return;
    state.lastRefresh = 0;
    refreshAll();
  });
  document.body.addEventListener("accountUsageUpdated", refreshAll);
  // Independent of project navigation; the transport restores this on reconnect.
  function ensureUsageSubscription() {
    if (state.subscription || !window.openVibelyLive?.accountUsage) return;
    state.subscription = window.openVibelyLive.accountUsage({
      onopen: () => document.body.dispatchEvent(new CustomEvent("accountUsageUpdated")),
      listeners: {
        account_usage_updated: () => document.body.dispatchEvent(new CustomEvent("accountUsageUpdated")),
        error: () => document.body.dispatchEvent(new CustomEvent("accountUsageUpdated")),
      },
    });
  }
  refreshAll();
})();
</script>
}
