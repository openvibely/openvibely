package layout

// MermaidDiagrams enhances completed Markdown without changing the HTML sanitizer.
templ MermaidDiagrams() {
 <style>
 .chat-mermaid { display:block; margin:1em 0; }
 .chat-mermaid img { display:block; max-width:100%; max-height:480px; border-radius:8px; }
 </style>
 <script>
 (() => {
  if (window.renderMermaidDiagrams) return;
  let library, frame, serial=0, queue=Promise.resolve();
  const cache=new Map(), failures=new Map();
  const currentTheme=()=>document.documentElement.getAttribute('data-theme')==='light'?'default':'dark';
  const terminal=new Set(['completed','failed','cancelled']);
  const isTerminal=code=>{
   const pair=code.closest('[data-execution-pair="true"]');
   return !!pair && terminal.has(pair.getAttribute('data-exec-status'));
  };
  // Ask the same Markdown lexer that renders the message whether its last block is
  // an unclosed fence. A trailing partial line is ignored because it can still change.
  // Streamed text only grows, so each message re-lexes from its last top-level blank
  // line before the final block; blocks ending earlier can no longer change.
  const fenceState=new WeakMap();
  function endsInsideFence(owner,text) {
   const state=fenceState.get(owner)||{text:null,open:false,prefix:''};
   fenceState.set(owner,state);
   if (text===state.text) return state.open;
   const parser=window.marked;
   if (!parser || typeof parser.lexer!=='function') return true;
   const complete=text.slice(0,text.lastIndexOf('\n')+1).replace(/\r\n|\r/g,'\n');
   const offset=complete.startsWith(state.prefix)?state.prefix.length:0;
   let tokens=parser.lexer(complete.slice(offset));
   let consumed=0, cut=0;
   for (let i=0;i<tokens.length-1;i++) {
    consumed+=tokens[i].raw.length;
    if (tokens[i].type==='space') cut=consumed;
   }
   state.prefix=complete.slice(0,offset+cut);
   let last=null;
   while (tokens && tokens.length) {
    const visible=tokens.filter(token=>token.type!=='space');
    last=visible[visible.length-1];
    if (!last) break;
    tokens=last.type==='list'?last.items:last.tokens;
   }
   let open=false;
   if (last && last.type==='code' && last.codeBlockStyle!=='indented') {
    // Raw holds the opening fence, the content, and the closing fence only if one was found.
    const rawLines=last.raw.replace(/\n+$/,'').split('\n').length;
    const contentLines=last.text===''?0:last.text.split('\n').length;
    open=rawLines<=contentLines+1;
   }
   state.text=text; state.open=open;
   return open;
  }
  // Live rendering parses each text section between tool blocks as its own document,
  // so check the section's source rather than the raw reply with tool output.
  function streamingFenceClosed(code) {
   const owner=code.closest('[data-raw-content]');
   if (!owner) return false;
   const sections=Array.from(owner.querySelectorAll('.chat-markdown')).filter(section=>'_chatMarkdownSource' in section);
   const section=code.closest('.chat-markdown');
   let scope=owner, source=owner.getAttribute('data-raw-content')||'';
   // Blocks outside a text section (e.g. in thinking) fall back to the raw reply.
   if (section && sections.includes(section)) {
    // An earlier section is bounded by a later tool block, so it is complete.
    if (section!==sections[sections.length-1]) return true;
    scope=section; source=section._chatMarkdownSource;
   }
   if (!endsInsideFence(scope,source)) return true;
   const blocks=Array.from(scope.querySelectorAll('pre > code')).filter(block=>!block.closest('.stream-tool'));
   return blocks[blocks.length-1]!==code;
  }
  function eligible(code) {
   if (!code.isConnected || !code.closest('[data-execution-pair="true"]') ||
    !code.closest('.chat-bubble-assistant-msg') || code.closest('.stream-tool')) return false;
   return isTerminal(code) || code.matches('a.chat-mermaid') || streamingFenceClosed(code);
  }
  function discardFrame() {
   if (frame) frame.remove();
   frame=null; library=null;
  }
  function deadline(work, milliseconds, onTimeout) {
   let timer;
   return Promise.race([work,new Promise((_,reject)=>{
    timer=setTimeout(()=>{ onTimeout(); reject(new Error('Diagram rendering timed out')); },milliseconds);
   })]).finally(()=>clearTimeout(timer));
  }
  function loadLibrary() {
   if (!library) library=(async()=>{
    for (let attempt=0;attempt<2;attempt++) {
     try {
      frame=document.createElement('iframe');
      frame.setAttribute('aria-hidden','true');
      frame.dataset.mermaidRenderer='';
      frame.tabIndex=-1;
      frame.style.cssText='position:absolute;left:-100000px;top:0;width:1200px;height:900px;visibility:hidden;border:0;';
      document.body.appendChild(frame);
      const target=frame;
      const doc=target.contentDocument;
      await deadline(new Promise((resolve,reject)=>{
       const script=doc.createElement('script');
       script.src=document.querySelector('meta[name="ov-asset-mermaid"]').content;
       script.onload=()=>resolve();
       script.onerror=()=>reject(new Error('Diagram library could not load'));
       doc.head.appendChild(script);
      }),10000,()=>target.remove());
      if (!target.contentWindow.mermaid) throw new Error('Diagram library could not load');
      return target.contentWindow.mermaid;
     } catch (error) {
      if (frame) frame.remove();
      frame=null;
      if (attempt===1) throw error;
      await new Promise(resolve=>setTimeout(resolve,1000));
     }
    }
   })().catch(error=>{library=null;throw error;});
   return library;
  }
  function errorNotice(code) {
   const anchor=code.matches('a.chat-mermaid')?code:code.parentElement;
   const notice=anchor.nextElementSibling;
   return notice && notice.hasAttribute('data-mermaid-error')?notice:null;
  }
  function clearFailure(code) {
   const notice=errorNotice(code);
   if (notice) notice.remove();
  }
  function showFailure(code,isDiagram,error) {
   if (!eligible(code)) return;
   clearFailure(code);
   const notice=document.createElement('div');
   notice.dataset.mermaidError='';
   notice.setAttribute('role','status');
   notice.appendChild(document.createTextNode(error.message==='Diagram rendering timed out'?'Diagram rendering timed out. ':'Could not render diagram. '));
   const button=document.createElement('button');
   button.type='button';button.textContent='Retry diagram';button.dataset.mermaidRetry='';
   notice.appendChild(button);
   (isDiagram?code:code.parentElement).after(notice);
  }
  document.addEventListener('click',event=>{
   const button=event.target.closest('[data-mermaid-retry]');
   if (!button) return;
   const notice=button.closest('[data-mermaid-error]');
   const anchor=notice && notice.previousElementSibling;
   const code=anchor && (anchor.matches('a.chat-mermaid')?anchor:anchor.querySelector('code.language-mermaid'));
   if (!code || !eligible(code)) return;
   event.preventDefault();
   failures.delete(JSON.stringify([currentTheme(),code.matches('a.chat-mermaid')?code.dataset.mermaidSource:code.textContent]));
   clearFailure(code);delete code._mermaidRender;delete code.dataset.mermaidTheme;
   window.renderMermaidDiagrams(anchor.parentElement);
  });
  function configure(mermaid,theme) {
   mermaid.initialize({theme, themeVariables:{background:'transparent'},startOnLoad:false, securityLevel:'strict', suppressErrorRendering:true,
       maxTextSize:50000, maxEdges:500, htmlLabels:false, flowchart:{htmlLabels:false},
       // Lock every configuration key against frontmatter and init directives.
       secure:Array.from(new Set(['secure', 'htmlLabels', 'dompurifyConfig', ...Object.keys(mermaid.mermaidAPI.defaultConfig)]))});
  }
  function commit(code,isDiagram,source,theme,url,image) {
   clearFailure(code);
   const link=isDiagram?code:document.createElement('a');
   link.className='chat-mermaid';
   link.href=url;
   link.dataset.imageGalleryItem='';
   if (!isDiagram) link.dataset.imageName='diagram-'+Array.from(crypto.getRandomValues(new Uint8Array(8)),b=>'abcdefghijklmnopqrstuvwxyz0123456789'[b%36]).join('')+'.svg';
   link.setAttribute('aria-label','Preview Mermaid diagram');
   link.dataset.mermaidSource=source;
   link.dataset.mermaidTheme=theme;
   link.replaceChildren(image);
   if (!isDiagram) {
    const markdown=code.closest('.chat-markdown') || code.parentElement.parentElement;
    markdown.setAttribute('data-image-gallery-group','');
    code.parentElement.replaceWith(link);
   }
   if (window.imageGallery && window.imageGallery.refreshItem) window.imageGallery.refreshItem(link);
  }
  window.renderMermaidDiagrams=function(root) {
   if (!root || !root.querySelectorAll) return Promise.resolve();
   const pending=[];
   root.querySelectorAll('pre > code.language-mermaid, a.chat-mermaid[data-mermaid-source]').forEach(code=>{
    if (!eligible(code)) return;
    if (code._mermaidRender) { pending.push(code._mermaidRender); return; }
    const isDiagram=code.matches('a.chat-mermaid');
    const source=isDiagram?code.dataset.mermaidSource:code.textContent;
    const unchanged=()=>eligible(code) && (isDiagram?code.dataset.mermaidSource:code.textContent)===source;
    if (isDiagram && code.dataset.mermaidTheme===currentTheme()) { clearFailure(code); return; }
    if (!isDiagram) {
     // Swap synchronously on live redraws so a rendered diagram never flashes back to code.
     const key=JSON.stringify([currentTheme(),source]);
     if (cache.has(key)) {
      const image=document.createElement('img');
      image.alt='Mermaid diagram';
      image.src=cache.get(key);
      commit(code,false,source,currentTheme(),image.src,image);
      return;
     }
     if (failures.has(key) && !isTerminal(code)) { showFailure(code,false,failures.get(key)); return; }
    }
    let retry=false;
    const render=async()=>{
     if (!unchanged() || source.length>50000) return;
     let host;
     try {
      const mermaid=await loadLibrary();
      if (!unchanged()) return;
      const renderStarted=Date.now();
      const theme=currentTheme();
      const key=JSON.stringify([theme,source]);
      let url=cache.get(key);
      if (!url) {
      configure(mermaid,theme);
      // Keep Mermaid's temporary DOM separate from the message, including on errors.
      host=frame.contentDocument.createElement('div');
      host.style.cssText='position:absolute;left:-100000px;top:0;visibility:hidden;';
      frame.contentDocument.body.appendChild(host);
      const result=await deadline(mermaid.render('ov-mermaid-'+(++serial),source,host),10000,discardFrame);
      // Keep the canvas transparent in messages, previews, and downloads.
      const svgDocument=new DOMParser().parseFromString(result.svg,'image/svg+xml');
      svgDocument.documentElement.style.backgroundColor='transparent';
      const svg=new XMLSerializer().serializeToString(svgDocument.documentElement);
      url='data:image/svg+xml;charset=utf-8,'+encodeURIComponent(svg);
      cache.set(key,url);
      if (cache.size>32) cache.delete(cache.keys().next().value);
      }
      if (!unchanged()) return;
      const image=document.createElement('img');
      image.alt='Mermaid diagram';
      // A self-contained image URL survives HTMX history restoration and needs no
      // object-URL registry. Never insert generated SVG into the message's DOM.
      image.src=url;
      await deadline(image.decode(),Math.max(1,10000-(Date.now()-renderStarted)),()=>{image.removeAttribute('src');});
      if (!unchanged()) return;
      if (theme!==currentTheme()) { retry=true; return; }
      commit(code,isDiagram,source,theme,url,image);
     } catch (error) {
      // Live redraws recreate the block every frame; don't re-render a known failure.
      if (!isTerminal(code)) {
       failures.set(JSON.stringify([currentTheme(),source]),error);
       if (failures.size>32) failures.delete(failures.keys().next().value);
      }
      // Keep source (or the last successful image) and allow explicit recovery.
      showFailure(code,isDiagram,error);
     } finally {
      if (host) host.remove();
     }
    };
    const requestedTheme=currentTheme();
    code._mermaidRender=queue.then(render).finally(()=>{
     // Only in-flight diagram work should block a later theme refresh.
     if (isDiagram) delete code._mermaidRender;
     else if (retry || requestedTheme!==currentTheme()) delete code._mermaidRender;
     if ((retry || requestedTheme!==currentTheme()) && code.isConnected) window.renderMermaidDiagrams(code.parentElement);
     // A live redraw replaced this block mid-render; show the cached result if the stream pauses.
     else if (!isDiagram && !code.isConnected) window.renderMermaidDiagrams(document);
    });
    queue=code._mermaidRender.catch(()=>{});
    pending.push(code._mermaidRender);
   });
   return Promise.all(pending);
  };
  new MutationObserver(()=>window.renderMermaidDiagrams(document)).observe(document.documentElement,{attributes:true,attributeFilter:['data-theme']});
  document.addEventListener('htmx:historyRestore',()=>window.renderMermaidDiagrams(document));
 })();
 </script>
}
