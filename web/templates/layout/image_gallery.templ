package layout

// ImageGallery is shared by saved attachments, message attachments and drafts.
templ ImageGallery() {
 <dialog id="image-gallery" class="bg-base-200 text-base-content" aria-label="Image preview">
  <div class="modal-box image-gallery-shell bg-base-200">
   <header><span data-gallery-name></span><span data-gallery-count aria-live="polite"></span><button type="button" data-gallery-close class="btn btn-circle btn-ghost btn-xs ov-modal-close" aria-label="Close image preview" title="Close image preview"><svg class="h-4 w-4" fill="none" viewBox="0 0 24 24" stroke="currentColor" aria-hidden="true"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M6 18L18 6M6 6l12 12"/></svg></button></header>
   <div class="image-gallery-viewer">
   <div data-gallery-stage><img data-gallery-image alt="" draggable="false"/><p data-gallery-status role="status"></p></div>
    <button type="button" data-gallery-prev class="image-gallery-arrow" aria-label="Previous image"><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><polyline points="15 6 9 12 15 18"/></svg></button>
    <button type="button" data-gallery-next class="image-gallery-arrow" aria-label="Next image"><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><polyline points="9 6 15 12 9 18"/></svg></button>
   </div>
   <footer>
    <div class="image-gallery-tools" role="group" aria-label="Image controls">
     <button type="button" data-gallery-minus aria-label="Zoom out" title="Zoom out"><svg viewBox="0 0 14 14" fill="none" stroke="currentColor" stroke-width="1.2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><circle cx="6" cy="6" r="3.5"/><path d="m9 9 3 3M4.5 6h3"/></svg></button>
     <button type="button" data-gallery-plus aria-label="Zoom in" title="Zoom in"><svg viewBox="0 0 14 14" fill="none" stroke="currentColor" stroke-width="1.2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><circle cx="6" cy="6" r="3.5"/><path d="m9 9 3 3M4.5 6h3M6 4.5v3"/></svg></button>
     <button type="button" data-gallery-fit aria-label="Fit image" title="Fit image"><svg viewBox="0 0 14 14" fill="none" stroke="currentColor" stroke-width="1.2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M1.5 4.5h3v-3m5 0v3h3m0 5h-3v3m-5 0v-3h-3"/></svg></button>
     <a download data-gallery-download aria-label="Download image" title="Download image"><svg viewBox="0 0 14 14" fill="none" stroke="currentColor" stroke-width="1.2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M7 1v8m-3-3 3 3 3-3M2 8v4h10V8"/></svg></a>
    </div>
   </footer>
  </div>
 </dialog>
 <style>
 #image-gallery { padding:0; border:0; border-radius:12px; color:inherit; width:calc(100vw - 32px); max-width:1200px; height:calc(100dvh - 48px); max-height:900px; margin:auto; }
 #image-gallery::backdrop { background:rgb(0 0 0 / .7); }
 #image-gallery .image-gallery-shell { padding:0; width:100%; max-width:none; max-height:none; transform:none; border-radius:0; height:100%; display:flex; flex-direction:column; }
 #image-gallery header, #image-gallery footer { display:flex; align-items:center; gap:8px; padding:12px; flex-shrink:0; }
 #image-gallery header { padding-right:44px; }
 #image-gallery header [data-gallery-name] { flex:1; min-width:0; overflow:hidden; text-overflow:ellipsis; white-space:nowrap; font-size:14px; }
 #image-gallery [data-gallery-count] { font-size:12px; opacity:.6; }
 #image-gallery footer { justify-content:center; }
 #image-gallery .image-gallery-tools { display:flex; gap:4px; padding:8px; border-radius:999px; background:rgb(0 0 0 / .7); color:#eee; }
 #image-gallery .image-gallery-tools > * { display:flex; align-items:center; justify-content:center; width:36px; height:36px; border:0; border-radius:50%; background:transparent; color:inherit; cursor:pointer; }
 #image-gallery .image-gallery-tools > *:hover { background:rgb(255 255 255 / .12); }
 #image-gallery .image-gallery-tools svg { width:22px; height:22px; }
 #image-gallery .image-gallery-viewer { flex:1; min-height:0; position:relative; display:flex; }
 #image-gallery .image-gallery-arrow { position:absolute; top:50%; transform:translateY(-50%); z-index:1; display:flex; align-items:center; justify-content:center; width:44px; height:44px; border:0; border-radius:50%; background:rgb(0 0 0 / .7); color:#eee; padding:0; cursor:pointer; }
 #image-gallery .image-gallery-arrow svg { display:block; width:24px; height:24px; flex-shrink:0; }
 #image-gallery .image-gallery-arrow:hover:not(:disabled) { background:rgb(0 0 0 / .9); }
 #image-gallery .image-gallery-arrow:disabled { opacity:.3; cursor:default; }
 #image-gallery [data-gallery-prev] { left:12px; }
 #image-gallery [data-gallery-next] { right:12px; }
 #image-gallery [data-gallery-stage] { flex:1; min-width:0; margin-inline:68px; min-height:0; overflow:hidden; position:relative; display:flex; justify-content:center; align-items:center; touch-action:none; }
 #image-gallery img { max-width:100%; max-height:100%; object-fit:contain; user-select:none; flex-shrink:0; }
 #image-gallery [data-gallery-status] { position:absolute; pointer-events:none; }
 @media (max-width:640px) { #image-gallery [data-gallery-stage] { margin-inline:0; } }
 [data-image-gallery-item] { cursor:zoom-in; }
 .attachment-gallery-row { display:flex; align-items:center; gap:12px; min-width:0; padding:0; width:calc(100% + 24px); margin-inline:-12px; border-radius:8px; }
 .attachment-gallery-open { cursor:pointer; display:flex; align-items:center; gap:12px; min-width:0; flex:1; border-radius:8px; padding:4px 12px; text-align:left; }
 .attachment-gallery-row:hover { background:color-mix(in srgb,currentColor 5%,transparent); }
 .attachment-gallery-open img, [data-pending-attachment] img { width:48px; height:48px; object-fit:cover; border-radius:6px; }
 </style>
 <script>
 (() => {
  if (window.imageGallery) return;
  const dialog=document.getElementById('image-gallery'), stage=dialog.querySelector('[data-gallery-stage]');
  let image=dialog.querySelector('img'), items=[], index=0, scale=1, x=0, y=0, opener=null, group=null, drag=null;
  const q=s=>dialog.querySelector('[data-gallery-'+s+']');
  function transform(){
   const maxX=Math.max(0,(image.width*scale-stage.clientWidth)/2), maxY=Math.max(0,(image.height*scale-stage.clientHeight)/2);
   x=Math.max(-maxX,Math.min(maxX,x)); y=Math.max(-maxY,Math.min(maxY,y));
   image.style.transform=`translate(${x}px, ${y}px) scale(${scale})`; stage.style.cursor=scale>1?'grab':'default';
   q('fit').title='Fit image ('+Math.round(scale*100)+'%)';
  }
  function zoom(value){ scale=Math.max(1,Math.min(8,value)); transform(); }
  function show(next){
   if(next<0 || next>=items.length)return;
   index=next; scale=1;x=0;y=0;drag=null;
   const item=items[index], old=image; image=document.createElement('img'); image.dataset.galleryImage=''; image.draggable=false; image.alt=item.name;
   old.replaceWith(image); const current=image;
   q('status').textContent='Loading image…';
   image.onload=()=>{if(image!==current)return;q('status').textContent='';transform();};
   image.onerror=()=>{if(image!==current)return;q('status').textContent='Image unavailable';image.style.visibility='hidden';};
   image.src=item.url; q('name').textContent=item.name; q('count').textContent=(index+1)+' / '+items.length;
   q('download').href=item.url; q('download').download=item.name;
   q('prev').disabled=index===0; q('next').disabled=index===items.length-1; transform();
  }
  function close(){if(dialog.open)dialog.close();}
  dialog.addEventListener('close',()=>{ observer.disconnect(); image.removeAttribute('src');items=[];group=null;drag=null;if(opener&&opener.isConnected)opener.focus({preventScroll:true});opener=null; });
  dialog.addEventListener('click',e=>{if(e.target===dialog)close();});
  q('close').onclick=close;q('prev').onclick=()=>show(index-1);q('next').onclick=()=>show(index+1);
  q('minus').onclick=()=>zoom(scale/1.5);q('plus').onclick=()=>zoom(scale*1.5);q('fit').onclick=()=>{x=0;y=0;zoom(1);};
  dialog.addEventListener('keydown',e=>{if(e.defaultPrevented||e.isComposing||e.altKey||e.metaKey||e.ctrlKey)return;if(e.key==='Escape'){e.preventDefault();e.stopPropagation();close();return;}if(['ArrowLeft','ArrowRight','+','=','-','0'].includes(e.key)){e.preventDefault();e.stopPropagation();if(e.key==='ArrowLeft')show(index-1);else if(e.key==='ArrowRight')show(index+1);else if(e.key==='-')zoom(scale/1.5);else if(e.key==='0')zoom(1);else zoom(scale*1.5);}});
  stage.addEventListener('wheel',e=>{e.preventDefault();zoom(scale*(e.deltaY<0?1.15:1/1.15));},{passive:false});
  stage.addEventListener('pointerdown',e=>{if(scale<=1)return;drag={id:e.pointerId,x:e.clientX,y:e.clientY};stage.setPointerCapture(e.pointerId);});
  stage.addEventListener('pointermove',e=>{if(!drag||drag.id!==e.pointerId)return;x+=e.clientX-drag.x;y+=e.clientY-drag.y;drag.x=e.clientX;drag.y=e.clientY;transform();});
  stage.addEventListener('pointerup',()=>drag=null);stage.addEventListener('pointercancel',()=>drag=null);
  window.addEventListener('resize',transform);
  document.addEventListener('click',e=>{
   const trigger=e.target.closest('[data-image-gallery-item]');if(!trigger)return;
   const container=trigger.closest('[data-image-gallery-group]');if(!container)return;
   e.preventDefault();opener=trigger;group=container;
   const links=Array.from(container.querySelectorAll('[data-image-gallery-item]'));
   items=links.map(a=>({element:a,url:a.href||a.dataset.imageUrl,name:a.dataset.imageName||a.textContent.trim()}));
   dialog.showModal();observer.observe(document.body,{childList:true,subtree:true});show(links.indexOf(trigger));q('close').focus();
  });
  document.addEventListener('htmx:beforeSwap',e=>{const target=e.detail.target;if(e.detail.shouldSwap&&dialog.open&&target&&group&&(target===group||target.contains(group)))close();});
  const observer=new MutationObserver(()=>{if(dialog.open&&(!group||!group.isConnected||!opener.isConnected))close();});
  function refreshItem(element) {
   if (!dialog.open) return;
   const item=items.find(item=>item.element===element);
   if (!item) return;
   item.url=element.href||element.dataset.imageUrl;
   if (items[index]===item) {
    image.src=item.url;
    q('download').href=item.url;
   }
  }
  window.imageGallery={close,refreshItem};
 })();
 </script>
}
