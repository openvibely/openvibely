package layout

import (
	"fmt"
	"net/url"
	"strconv"
	"time"

	"github.com/openvibely/openvibely/internal/models"
	"github.com/openvibely/openvibely/web/templates/taskstate"
)

const taskListGroupLimit = 7

type TaskListGroup struct {
	Label string
	Tasks []models.Task
}

func TaskListGroups(tasks []models.Task) []TaskListGroup {
	order := []models.TaskCategory{models.CategoryActive, models.CategoryCompleted, models.CategoryBacklog, models.CategoryScheduled}
	labels := map[models.TaskCategory]string{models.CategoryActive: "Active", models.CategoryBacklog: "Backlog", models.CategoryScheduled: "Scheduled", models.CategoryCompleted: "Completed"}
	byCategory := map[models.TaskCategory][]models.Task{}
	for _, task := range tasks {
		if task.ParentTaskID != nil {
			continue
		}
		category := task.Category
		// Scheduled tasks retain their category across runs. Surface admitted
		// executions in Active until they finish without changing that category.
		if category == models.CategoryScheduled && (task.Status == models.StatusRunning || task.Status == models.StatusQueued || task.WorkerCapacityQueued || task.AutomationCapacityQueued) {
			category = models.CategoryActive
		}
		byCategory[category] = append(byCategory[category], task)
	}
	groups := make([]TaskListGroup, 0, len(order))
	for _, category := range order {
		if len(byCategory[category]) > 0 {
			groups = append(groups, TaskListGroup{Label: labels[category], Tasks: byCategory[category]})
		}
	}
	return groups
}

func taskListAge(t time.Time) string {
	d := time.Since(t)
	switch {
	case d < time.Minute:
		return "now"
	case d < time.Hour:
		return strconv.Itoa(int(d.Minutes())) + "m"
	case d < 24*time.Hour:
		return strconv.Itoa(int(d.Hours())) + "h"
	case d < 7*24*time.Hour:
		return strconv.Itoa(int(d.Hours()/24)) + "d"
	case d < 365*24*time.Hour:
		return strconv.Itoa(int(d.Hours()/(24*7))) + "w"
	}
	return strconv.Itoa(int(d.Hours()/(24*365))) + "y"
}

templ TaskListPanelContent(projectID string, groups []TaskListGroup, menus ...map[string]templ.Component) {
    @TaskListPanelContentWithProjects(projectID, groups, nil, menus...)
}

func taskListRowURL(projectID string, task models.Task) string {
    path := fmt.Sprintf("/tasks/%s?from=tasks", task.ID)
    if projectID == models.AllProjectsID { path += "&project_id=" + url.QueryEscape(projectID) }
    return path
}

func taskListSearchTitle(task models.Task, names map[string]string) string {
    if name := names[task.ProjectID]; name != "" { return task.Title + " " + name }
    return task.Title
}

templ TaskListPanelContentWithProjects(projectID string, groups []TaskListGroup, names map[string]string, menus ...map[string]templ.Component) {
	if len(groups) == 0 {
		<div class="task-list-empty">No tasks yet.</div>
	}
	for _, group := range groups {
		<details class="task-list-group" open?={ group.Label == "Active" || group.Label == "Completed" } data-task-list-group={ group.Label } data-task-list-project-scope={ projectID }>
			<summary>
				<span class="task-list-group-label">{ group.Label }</span>
				<span class="task-list-count">{ strconv.Itoa(len(group.Tasks)) }</span>
				<svg class="task-list-chevron" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="m6 9 6 6 6-6"></path></svg>
			</summary>
			<div class="task-list-scroll-wrap">
            <div class="task-list-rows">
			for i, task := range group.Tasks {
				<a
					class="task-list-row"
					data-task-list-row={ task.ID }
                    data-task-owner-project={ task.ProjectID }
                    data-task-category={ string(task.Category) }
                    data-task-status={ string(task.Status) }
                    aria-haspopup="menu"
					data-task-list-title={ taskListSearchTitle(task, names) }
					data-task-list-extra?={ i >= taskListGroupLimit }
					data-task-list-age={ taskListAge(task.UpdatedAt) }
					href={ templ.SafeURL(taskListRowURL(projectID, task)) }
					hx-get={ taskListRowURL(projectID, task) }
					hx-target="#main-content"
					hx-swap="innerHTML"
					hx-push-url="true"
				>
					@taskstate.Icon(task)
					<span class="task-list-title">{ task.Title }</span>
                    if name := names[task.ProjectID]; name != "" {
                        <span data-task-list-project={ task.ProjectID } title={ name } style="max-width: 40%; overflow: hidden; text-overflow: ellipsis; white-space: nowrap; font-size: 11px; opacity: .65;">{ name }</span>
                    }
					if task.Prompt != "" {
						<template data-task-list-prompt>{ task.Prompt }</template>
					}
				</a>
                <template data-task-list-menu={ task.ID }>
                    if len(menus) > 0 && menus[0][task.ID] != nil {
                        @menus[0][task.ID]
                    }
                </template>
			}
            </div>
            <div class="task-list-scroll-rail" aria-hidden="true"><div class="task-list-scroll-thumb"></div></div>
            </div>
			if len(group.Tasks) > 3 {
				<button type="button" class="task-list-more" data-task-list-more={ strconv.Itoa(len(group.Tasks)) }>Show more</button>
                <button type="button" class="task-list-browse-controls task-list-done">
                    <span>Show less</span>
                </button>
			}
		</details>
	}
}

templ TaskListPanel(currentProjectID string) {
	<aside id="task-list-panel" aria-label="Tasks">
        <div class="task-list-search-slot">
        <div class="task-list-search kanban-search" data-open="false">
            <span class="kanban-search-toggle" aria-hidden="true"><svg class="h-5 w-5" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2"><path stroke-linecap="round" stroke-linejoin="round" d="M21 21l-4.35-4.35M17 11a6 6 0 11-12 0 6 6 0 0112 0z"></path></svg></span>
            <input id="task-list-search-input" class="kanban-search-input" type="search" placeholder="Search tasks…" aria-label="Search tasks" autocomplete="off" tabindex="-1"/>
            <button type="button" id="task-list-search-clear" class="kanban-search-clear" aria-label="Clear search" tabindex="-1"><svg class="h-3.5 w-3.5" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2" aria-hidden="true"><path stroke-linecap="round" stroke-linejoin="round" d="M6 18L18 6M6 6l12 12"></path></svg></button>
        </div>
        </div>
        <div id="changes-explorer-host"></div>
		<nav id="appearance-settings-nav" aria-label="Settings">
			@SettingsLinks(currentProjectID)
		</nav>
		<div
			id="task-list-groups"
			hx-get={ fmt.Sprintf("/tasks/sidebar?project_id=%s", currentProjectID) }
			hx-trigger="load, taskListRefresh from:body"
			hx-swap="innerHTML"
			hx-sync="this:queue last"
			hx-push-url="false"
		></div>
	</aside>
	<nav class="settings-mobile-nav" aria-label="Settings">@SettingsLinks(currentProjectID)</nav>
	<div id="changes-explorer-mobile"></div>
    @ChangesExplorerScript()
	<div id="task-list-divider" role="separator" aria-orientation="vertical" aria-label="Resize task list" tabindex="0"></div>
	<style>
        .task-list-drop-targets { position:fixed;z-index:990;box-sizing:border-box;padding:10px;border:1px solid oklch(var(--bc) / .2);border-radius:12px;background:var(--ov-menu-surface, #24212e);color:oklch(var(--bc));box-shadow:0 12px 32px #0005;max-height:calc(100vh - 16px);overflow-y:auto;overscroll-behavior:contain; }
        .task-list-drop-targets:not([hidden]) { display:grid;grid-template-columns:1fr;gap:7px; }
        .task-list-drop-targets[hidden] { display:none !important; }
        .task-list-drop-targets > .drop-heading { padding:2px 12px; font-size:12px; font-weight:600; opacity:.7; }
        .task-list-drop-targets > [data-task-list-drop-category] { box-sizing:border-box;min-height:44px;display:flex;align-items:center;gap:8px;padding:9px 12px;border:1px solid oklch(var(--bc) / .2);border-radius:6px;font-size:12px; }
        .task-list-drop-targets .drop-current { opacity:.5;border-style:dashed; }
        .task-list-drop-targets .drop-current::after { content:'(current)';margin-left:auto;font-size:10px; }
        .task-list-drop-targets .drop-hover { background:oklch(var(--p) / .25);border-color:oklch(var(--p)); }
        .task-list-row[data-task-list-row] { user-select:none;-webkit-user-select:none; }
        .task-list-row.task-list-dragging { display:flex !important; opacity:1; }

        #appearance-settings-nav { display: none; }
        html.appearance-settings #task-list-panel > :not(#appearance-settings-nav):not(#changes-explorer-host):not(.task-list-search-slot) { display: none !important; }
        html.appearance-settings #appearance-settings-nav { display: flex; flex-direction: column; overflow-y: auto; }
        .settings-back, .changes-explorer .explorer-back { display: flex; align-items: center; width: 100%; text-align: left; gap: 8px; min-height: 32px; padding: 6px 10px; margin-bottom: 12px; border-radius: 8px; font-size: 13.5px; font-weight: 400; line-height: 20px; color: inherit; text-decoration: none; cursor: pointer; }
        .settings-back svg, .changes-explorer .explorer-back svg { width: 16px; height: 16px; flex-shrink: 0; }
        .settings-back:hover, .changes-explorer .explorer-back:hover { background: var(--ov-hover-subtle); }
        .settings-back:focus-visible, .changes-explorer .explorer-back:focus-visible { outline: 2px solid currentColor; outline-offset: -2px; }
        .settings-nav-group { width: 100%; }
        .settings-nav-group > summary { list-style: none; cursor: pointer; }
        .settings-nav-group > summary::-webkit-details-marker { display: none; }
        .settings-nav-disclosure { margin-left: auto; width: 14px; height: 14px; transition: transform .15s ease; }
        .settings-nav-group:not([open]) .settings-nav-disclosure { transform: rotate(-90deg); }
        .settings-nav-children { display: flex; flex-direction: column; margin-left: 17px; padding-left: 8px; border-left: 1px solid var(--ov-border-subtle, rgba(166, 173, 187, .2)); }
        .settings-nav-child { width: 100%; }
        .settings-mobile-nav .settings-nav-group { flex: 0 0 100%; }
        .settings-mobile-nav { display: none; }
        html.appearance-settings .settings-mobile-nav { display: flex; flex-wrap: wrap; gap: 4px; padding: 12px; max-height: 40vh; overflow-y: auto; flex-shrink: 0; }
        .settings-mobile-nav .settings-back { width: 100%; padding: 8px 10px; }
        html.appearance-settings[data-shell-frame] .settings-mobile-nav { display: none; }
        [data-settings-section][hidden] { display: none !important; }
    </style>
	<script>
        (function() {
            var root = document.documentElement;
            var inSettings = false;
            var retainedWorkspace = null;
            var settingsPane = null;
            var restoringWorkspace = false;
            var retainedScroll = [];
            var taskView = null;
            var settingsRequest = null;
            function isSettingsURL(value) {
                var path = new URL(value, location.href).pathname;
                return /^\/(themes|shortcuts|models|agents|skills|channels|personality|organization|workers|settings\/workers)(\/|$)/.test(path);
            }
            window.isSettingsWorkspaceURL = isSettingsURL;
            // Keep the workspace connected: its drafts, live subscriptions and
            // virtual transcript remain owned by the original page.
            document.addEventListener('htmx:beforeSwap', function(event) {
                var detail = event.detail;
                if (!detail.shouldSwap || detail.target?.id !== 'main-content') return;
                var url = detail.xhr?.responseURL;
                if (!url || !isSettingsURL(url)) return;
                var main = detail.target;
                var destinationProject = workspaceProject(url);
                workspaceURL = workspaceURLs.get(destinationProject) || '/tasks?project_id=' + encodeURIComponent(destinationProject);
                // A settings page reopened in another project must not retain
                // the outgoing project's workspace as its return destination.
                if (destinationProject !== mountedProject) return;
                if (!settingsPane && inSettings) return;
                if (!settingsPane) {
                    retainedScroll = [main].concat(Array.from(main.querySelectorAll('*'))).filter(function(el) {
                        return el.scrollTop || el.scrollLeft;
                    }).map(function(el) { return {el:el, top:el.scrollTop, left:el.scrollLeft}; });
                    retainedWorkspace = document.createElement('div');
                    retainedWorkspace.id = 'settings-retained-workspace';
                    retainedWorkspace.hidden = true;
                    retainedWorkspace.inert = true;
                    retainedWorkspace.setAttribute('hx-history', 'false');
                    while (main.firstChild) retainedWorkspace.appendChild(main.firstChild);
                    main.appendChild(retainedWorkspace);
                    settingsPane = document.createElement('div');
                    settingsPane.id = 'settings-content';
                    main.appendChild(settingsPane);
                }
                main.classList.remove('htmx-swapping', 'htmx-settling');
                detail.target = settingsPane;
            }, true);
            window.restoreSettingsWorkspace = function(push) {
                if (!retainedWorkspace || !settingsPane) return false;
                if (settingsRequest && settingsRequest.readyState !== 4) settingsRequest.abort();
                settingsRequest = null;
                var main = document.getElementById('main-content');
                if (push) window.workspaceNavigation.commit(workspaceURL);
                // HTMX owns cleanup for the outgoing Settings content only.
                restoringWorkspace = true;
                htmx.swap(settingsPane, '', {swapStyle: 'innerHTML', settleDelay: 0});
                settingsPane.remove();
                while (retainedWorkspace.firstChild) main.insertBefore(retainedWorkspace.firstChild, retainedWorkspace);
                retainedWorkspace.remove();
                retainedWorkspace = null;
                settingsPane = null;
                restoringWorkspace = false;
                window.syncAppearanceSettings();
                retainedScroll.forEach(function(position) {
                    if (position.el.isConnected) {
                        position.el.scrollTop = position.top;
                        position.el.scrollLeft = position.left;
                    }
                });
                retainedScroll = [];
                window.dispatchEvent(new Event('resize'));
                document.body.dispatchEvent(new CustomEvent('htmx:afterSettle', {bubbles:true, detail:{target:main, elt:main}}));
                return true;
            };
            // One history owner for mounted workspace views. Page-specific
            // controllers register how to display their local view, not another
            // popstate listener. Other destinations retain normal HTMX navigation.
            function commitURL(url, replace) {
                var next = new URL(url, location.href);
                if (next.href !== location.href) history[replace ? 'replaceState' : 'pushState'](Object.assign({}, history.state, {htmx:true}), '', next);
            }
            function navigateWorkspace(url, push) {
                var next = new URL(url, location.href);
                if (next.origin !== location.origin) return false;
                if (isSettingsURL(next.href)) {
                    var source = document.createElement('a');
                    source.hidden = true;
                    source.setAttribute('hx-push-url', push ? next.pathname + next.search + next.hash : 'false');
                    source.setAttribute('hx-replace-url', 'false');
                    source.dataset.workspaceHistoryNavigation = push ? 'false' : 'true';
                    document.body.appendChild(source);
                    htmx.ajax('GET', next.pathname + next.search, {source:source, target:'#main-content', swap:'innerHTML'}).finally(function() {
                        source.remove();
                    }).catch(function() {});
                    return true;
                }
                var localTask = taskView && taskView.matches(next);
                var stored = new URL(workspaceURL, location.href);
                var retained = retainedWorkspace && (localTask || next.href === stored.href);
                if (!retained && (!localTask || retainedWorkspace)) return false;
                if (settingsRequest && settingsRequest.readyState !== 4) settingsRequest.abort();
                if (push) commitURL(next.href);
                if (retained) window.restoreSettingsWorkspace(false);
                if (localTask) taskView.show(next);
                if (window.syncAppearanceSettings) window.syncAppearanceSettings();
                if (window.syncOpenVibelyPageTitle) window.syncOpenVibelyPageTitle(document.getElementById('main-content'));
                return true;
            }
            window.workspaceNavigation = {
                navigate: navigateWorkspace,
                back: function() { return retainedWorkspace ? navigateWorkspace(workspaceURL, true) : false; },
                commit: commitURL,
                registerTask: function(view) {
                    taskView = view;
                    return function() { if (taskView === view) taskView = null; };
                }
            };
            document.addEventListener('click', function(event) {
                var link = event.target.closest('a');
                if (!link || event.button !== 0 || event.metaKey || event.ctrlKey || event.shiftKey || event.altKey || link.hasAttribute('download') || (link.target && link.target !== '_self')) return;
                if (!link.matches('[hx-target="#main-content"], [data-settings-back]')) return;
                // Appearance section selection already updates its existing pane.
                if (link.matches('[data-settings-link]') && document.getElementById('themes-container')) return;
                var target = link.matches('[data-settings-back]') ? workspaceURL : link.href;
                if (!navigateWorkspace(target, true)) return;
                event.preventDefault();
                event.stopImmediatePropagation();
            }, true);
            window.addEventListener('popstate', function(event) {
                if (navigateWorkspace(location.href, false)) event.stopImmediatePropagation();
            }, true);
            document.addEventListener('htmx:beforeCleanupElement', function(event) {
                if (event.detail.elt === retainedWorkspace) {
                    retainedScroll = [];
                    retainedWorkspace = null;
                    settingsPane = null;
                }
            });

            var inContextSidebar = false;
            var contextChanges = null;
            var wasCollapsed = false;
            var workspaceURL = /^\/(themes|shortcuts|models|agents|skills|channels|personality|organization|workers|settings\/workers)(\/|$)/.test(location.pathname) ? '/tasks' + location.search : location.pathname + location.search + location.hash;
            var workspaceURLs = new Map();
            function workspaceProject(value) {
                return new URL(value, location.href).searchParams.get('project_id') || (document.getElementById('project-selector') || {}).value || '';
            }
            workspaceURLs.set(workspaceProject(workspaceURL), workspaceURL);
            // History changes the address before replacing the mounted page.
            // Update ownership only when content actually swaps or is restored.
            var mountedProject = workspaceProject(document.getElementById('task-list-groups').getAttribute('hx-get'));
            document.addEventListener('htmx:afterSwap', function(event) {
                if (event.detail.target?.id !== 'main-content') return;
                var url = event.detail.xhr?.responseURL || (window.openVibelyDisplayedURL ? window.openVibelyDisplayedURL() : location.href);
                mountedProject = workspaceProject(url);
            });
            document.addEventListener('htmx:historyRestore', function() {
                mountedProject = workspaceProject(location.href);
            });
            var workspaceScroll = 0;
            var boardScroll = new Map();
            var boardScrollSelector = '#tasks-page, #kanban-board, .category-drop-zone, .task-drop-zone';
            function boardScrollKey(el) {
                return el.id || JSON.stringify([el.getAttribute('data-project-id'), el.getAttribute('data-category'), el.getAttribute('data-status')]);
            }
            document.addEventListener('htmx:afterRequest', function(e) {
                if (e.detail.xhr === settingsRequest) settingsRequest = null;
            });
            // Capture the outgoing workspace before cached thread navigation can
            // synchronously swap the DOM and change inSettings during this event.
            document.addEventListener('htmx:beforeRequest', function(e) {
                if (e.detail.target?.id === 'main-content' && isSettingsURL(e.detail.requestConfig?.path || location.href)) settingsRequest = e.detail.xhr;
                if (e.detail.target && e.detail.target.id === 'main-content' && !inSettings) {
                    if (e.detail.elt?.dataset.workspaceHistoryNavigation !== 'true') {
                        workspaceURL = location.pathname + location.search + location.hash;
                        workspaceURLs.set(workspaceProject(workspaceURL), workspaceURL);
                    }
                    workspaceScroll = document.getElementById('main-content').scrollTop;
                    boardScroll.clear();
                    document.getElementById('main-content').querySelectorAll(boardScrollSelector).forEach(function(el) {
                        boardScroll.set(boardScrollKey(el), {top: el.scrollTop, left: el.scrollLeft});
                    });
                }
            }, true);
            window.syncAppearanceSettings = function() {
                if (restoringWorkspace) return;
                var appearance = !!document.getElementById('themes-container');
                var workers = !!document.getElementById('worker-settings-content');
                var changes = document.getElementById('tab-changes');
                var reviewing = !settingsPane && !!changes && !changes.classList.contains('hidden');
                root.classList.toggle('changes-explorer-active', reviewing);
                if (window.syncChangesExplorer) window.syncChangesExplorer(reviewing);
                var settings = appearance || workers || !!document.querySelector('#main-content #shortcuts-container, #main-content #models-container, #main-content #agents-container, #main-content #skills-container, #main-content #channels-container, #main-content #personality-container, #main-content #organization-container');
                var active = reviewing || settings;
                if (active && !inContextSidebar) {
                    wasCollapsed = root.classList.contains('task-list-collapsed');
                } else if (!active && inContextSidebar) {
                    root.classList.toggle('task-list-collapsed', wasCollapsed);
                    if (location.pathname + location.search + location.hash === workspaceURL) {
                        document.getElementById('main-content').scrollTop = workspaceScroll;
                        document.getElementById('main-content').querySelectorAll(boardScrollSelector).forEach(function(el) {
                            var position = boardScroll.get(boardScrollKey(el));
                            if (position) {
                                el.scrollTop = position.top;
                                el.scrollLeft = position.left;
                            }
                        });
                    }
                }
                // Open on entry or when changing contextual pages, without
                // overwriting the workspace preference or undoing a manual
                // explorer collapse during an ordinary diff refresh.
                if (active && (!inContextSidebar || settings !== inSettings || (reviewing && changes !== contextChanges))) {
                    root.classList.remove('task-list-collapsed');
                }
                contextChanges = reviewing ? changes : null;
                inSettings = settings;
                inContextSidebar = active;
                root.classList.toggle('appearance-settings', active);
                if (window.syncTaskListToggle) window.syncTaskListToggle();
                document.getElementById('task-list-panel').setAttribute('aria-label', reviewing ? 'Changed files' : active ? 'Settings' : 'Tasks');
                if (!active) return;
                var projectID = new URLSearchParams(location.search).get('project_id') || (document.getElementById('project-selector') || {}).value || '';
                document.querySelectorAll('[data-settings-link]').forEach(function(link) {
                    var target = '/themes?project_id=' + encodeURIComponent(projectID) + '#' + link.dataset.settingsLink;
                    link.setAttribute('href', target);
                    link.setAttribute('hx-get', target);
                    if (window.htmx) htmx.process(link);
                });
                var section = location.hash.slice(1);
                if (!['themes','layout','chat'].includes(section)) section = 'themes';
                document.querySelectorAll('[data-settings-section]').forEach(function(el) { el.hidden = el.dataset.settingsSection !== section; });
                document.querySelectorAll('[data-settings-link]').forEach(function(el) {
                    if (appearance && el.dataset.settingsLink === section) el.setAttribute('aria-current', 'page');
                    else el.removeAttribute('aria-current');
                });
                if (appearance) document.getElementById('appearance-section-title').textContent = {themes: 'Themes', layout: 'Layout', chat: 'Chat'}[section];
                document.querySelectorAll('[data-settings-back]').forEach(function(el) {
                    el.setAttribute('href', workspaceURL);
                    el.setAttribute('hx-get', workspaceURL);
                    if (window.htmx) htmx.process(el);
                });
            };
            document.addEventListener('click', function(e) {
                var link = e.target.closest('[data-settings-link]');
                if (!link || !document.getElementById('themes-container') || e.button !== 0 || e.metaKey || e.ctrlKey || e.shiftKey || e.altKey) return;
                e.preventDefault();
                e.stopPropagation();
                history.replaceState(history.state, '', '#' + link.dataset.settingsLink);
                window.syncAppearanceSettings();
            }, true);
            document.addEventListener('DOMContentLoaded', window.syncAppearanceSettings);
            document.addEventListener('htmx:afterSettle', window.syncAppearanceSettings);
            document.addEventListener('htmx:historyRestore', window.syncAppearanceSettings);
            window.addEventListener('hashchange', window.syncAppearanceSettings);
        })();
    </script>
	<script>
		(function() {
			var root = document.documentElement;
			var panel = document.getElementById('task-list-panel');
			var groups = document.getElementById('task-list-groups');
			var divider = document.getElementById('task-list-divider');
			var searchBox = document.querySelector('#task-list-panel .task-list-search');
			var searchInput = document.getElementById('task-list-search-input');
			var widthKey = 'openvibely.taskListWidth';
			var collapsedKey = 'openvibely.taskListCollapsed';
			var MIN = 200, MAX = 560;

			function clampWidth(w) { return Math.round(Math.max(MIN, Math.min(MAX, w, window.innerWidth - 480))); }
			function setWidth(w, persist) {
				var next = clampWidth(w);
				root.style.setProperty('--task-list-width', next + 'px');
				divider.setAttribute('aria-valuenow', String(next));
				if (persist) try { localStorage.setItem(widthKey, String(next)); } catch (_) {}
			}
