                    if (target.getAttribute('aria-disabled') === 'true') return null;
                    target.classList.add('drop-hover');
                    return {category: target.dataset.taskListDropCategory};
                }
                var group = hit.closest('[data-task-list-group]');
                if (!group || !groups.contains(group)) return null;
                var category = group.dataset.taskListGroup.toLowerCase();
                var rows = Array.from(group.querySelectorAll('[data-task-list-row]')).filter(function(row) {
                    return row !== rowDrag.row && row.getClientRects().length && getComputedStyle(row).display !== 'none';
                });
                var before = rows.find(function(row) { var rect = row.getBoundingClientRect(); return y < rect.top + rect.height / 2; });
                var anchor = before || rows[rows.length - 1];
                return {category: category, anchor: anchor, before: !!before};
            }
            function finishRowDrag(cancelled) {
                var state = rowDrag;
                if (!state) return;
                rowDrag = null;
                endPress();
                cancelAnimationFrame(state.frame);
                window.removeEventListener('pointermove', moveRowDrag, true);
                window.removeEventListener('pointerup', endRowDrag, true);
                window.removeEventListener('pointercancel', cancelRowDrag, true);
                window.removeEventListener('blur', cancelRowDrag);
                window.removeEventListener('resize', cancelRowDrag);
                document.removeEventListener('keydown', cancelRowDragKey, true);
                window.endPointerCardMotion(state.motion);
                state.row.classList.remove('task-list-dragging');
                dropTargets.hidden = true;
                clearRowDropIndicators();
                if (!state.started) return;
                window.isDragging = false;
                document.documentElement.classList.remove('drag-cursor-active');
                suppressRowClick = true;
                setTimeout(function() { suppressRowClick = false; }, 0);
                document.dispatchEvent(new CustomEvent('task-pointer-dragend'));
                var destination = state.destination;
                if (cancelled || !destination) { refreshSoon(0); return; }
                var values = {project_id: currentProjectID()};
                var path = '/tasks/' + encodeURIComponent(state.row.dataset.taskListRow);
                // Scheduled executions appear in Active without changing their saved category.
                // Reordering within that displayed group must not unschedule them.
                if (destination.category === state.group || destination.category === state.row.dataset.taskCategory) {
                    if (!destination.anchor || destination.anchor.dataset.taskCategory !== state.row.dataset.taskCategory) { refreshSoon(0); return; }
                    values[destination.before ? 'before_task_id' : 'after_task_id'] = destination.anchor.dataset.taskListRow;
                    path += '/reorder';
                } else {
                    values.category = destination.category;
                    path += '/category';
                }
                // Scope belongs in the URL: ownership middleware does not read form values.
                path += '?project_id=' + encodeURIComponent(currentProjectID());
                rowMovePending = true;
                var failureShown = false;
                function showMoveFailure(event) {
                    if (event && event.detail && event.detail.requestConfig.path !== path) return;
                    if (!failureShown && window.showToast) window.showToast('Could not move task. Check its current state and try again.', 'failed');
                    failureShown = true;
                }
                document.body.addEventListener('htmx:responseError', showMoveFailure);
                // Keep the mutation independent of sidebar refresh requests.
                var requestSource = document.createElement('span');
                requestSource.hidden = true;
                document.body.appendChild(requestSource);
                htmx.ajax('PATCH', path, {source: requestSource, target: groups, swap: 'none', values: values}).catch(function() {
                    showMoveFailure();
                }).finally(function() {
                    document.body.removeEventListener('htmx:responseError', showMoveFailure);
                    requestSource.remove();
                    rowMovePending = false;
                    refreshSoon(0);
                    window.dispatchEvent(new CustomEvent('sse-task-event', {detail: {type: 'task_board_updated', project_id: currentProjectID()}}));
                });
            }
            function cancelRowDrag() { finishRowDrag(true); }
            function cancelRowDragKey(event) { if (event.key === 'Escape') { event.preventDefault(); finishRowDrag(true); } }
            function endRowDrag(event) {
                if (!rowDrag || rowDrag.pointerId !== event.pointerId) return;
                if (rowDrag.started) rowDrag.destination = rowDropAt(event.clientX, event.clientY);
                finishRowDrag(false);
            }
            function moveRowDrag(event) {
                var state = rowDrag;
                if (!state || state.pointerId !== event.pointerId) return;
                if (!state.started && Math.hypot(event.clientX - state.x, event.clientY - state.y) < 5) return;
                event.preventDefault();
                state.lastX = event.clientX; state.lastY = event.clientY;
                if (!state.started) {
                    state.started = true;
                    closeTaskContextMenu(false); hideHoverCard();
                    window.isDragging = true;
                    document.documentElement.classList.add('drag-cursor-active');
                    window.getSelection().removeAllRanges();
                    if (window.openVibelyTooltip) window.openVibelyTooltip.close();
                    // Move the original entry, preserving its place and exact inline styles.
                    state.origin = state.row.getBoundingClientRect();
                    state.motion = window.beginPointerCardMotion(state.row);
                    state.row.classList.add('task-list-dragging');
                    state.row.style.setProperty('background-color', 'var(--shell-row-selected, #292633)', 'important');
                    state.row.style.setProperty('box-shadow', '0 8px 24px #0004', 'important');
                    positionRowDropTargets(state);
                    function scrollFrame() {
                        if (rowDrag !== state) return;
                        var hit = document.elementFromPoint(state.lastX, state.lastY);
                        var scroller = hit && hit.closest('.task-list-group[data-browsing]:not([data-searching]) .task-list-rows');
                        scroller = scroller || groups;
                        var rect = scroller.getBoundingClientRect();
                        if (state.lastX >= rect.left && state.lastX <= rect.right && !dropTargets.contains(document.elementFromPoint(state.lastX, state.lastY))) {
                            var delta = state.lastY < rect.top + 32 ? -7 : state.lastY > rect.bottom - 32 ? 7 : 0;
                            if (delta) { scroller.scrollTop += delta; state.destination = rowDropAt(state.lastX, state.lastY); }
                        }
                        state.frame = requestAnimationFrame(scrollFrame);
                    }
                    state.frame = requestAnimationFrame(scrollFrame);
                }
                window.movePointerCard(state.motion, event.clientX - state.x, event.clientY - state.y);
                state.destination = rowDropAt(event.clientX, event.clientY);
            }
            groups.addEventListener('dragstart', function(event) { if (event.target.closest('[data-task-list-row]')) event.preventDefault(); });
            groups.addEventListener('click', function(event) { if (suppressRowClick) { event.preventDefault(); event.stopImmediatePropagation(); } }, true);
            groups.addEventListener('pointerdown', function(event) {
                var row = event.target.closest('[data-task-list-row]');
                if (!row || event.button !== 0 || event.pointerType === 'touch' || rowMovePending || window.isDragging || window.kanbanBatchRunning || event.ctrlKey || event.metaKey || event.shiftKey) return;
                rowDrag = {row: row, group: row.closest('[data-task-list-group]').dataset.taskListGroup.toLowerCase(), pointerId: event.pointerId, x: event.clientX, y: event.clientY, started: false};
                window.addEventListener('pointermove', moveRowDrag, true);
                window.addEventListener('pointerup', endRowDrag, true);
                window.addEventListener('pointercancel', cancelRowDrag, true);
                window.addEventListener('blur', cancelRowDrag);
                window.addEventListener('resize', cancelRowDrag);
                document.addEventListener('keydown', cancelRowDragKey, true);
            });

            // Keep the shared card menu outside the scrolling sidebar.
            var contextMenu = document.createElement('div');
            contextMenu.className = 'dropdown';
            contextMenu.setAttribute('data-menu-dropdown', '');
            contextMenu.setAttribute('data-task-list-context-menu', '');
            contextMenu.setAttribute('data-kanban-menu-key', 'task-list-context');
            contextMenu.innerHTML = '<button type="button" tabindex="-1" data-kanban-menu-trigger data-task-card-menu-trigger aria-label="Task actions" style="position:fixed;width:0;height:0;overflow:hidden;opacity:0"></button><ul tabindex="-1" aria-label="Task actions" data-menu-content data-kanban-menu-content class="ov-menu ov-menu-actions ov-menu-scroll dropdown-content menu w-52 max-w-[calc(100vw-2rem)]"></ul>';
            document.body.appendChild(contextMenu);
            var contextRow = null;
            function taskContextMenuOpen() {
                return contextMenu.getAttribute('data-kanban-menu-open') === 'true';
            }
            // Shared handlers also close menus on request start and navigation.
            new MutationObserver(function() {
                flushDeferredRefresh();
            }).observe(contextMenu, {attributes: true, attributeFilter: ['data-kanban-menu-open']});
            function closeTaskContextMenu(restoreFocus) {
                if (taskContextMenuOpen() && window.closeKanbanMenu) window.closeKanbanMenu(contextMenu, restoreFocus);
                else if (restoreFocus && contextRow && contextRow.isConnected) contextRow.focus({preventScroll: true});
                flushDeferredRefresh();
            }
            function openTaskContextMenu(row, x, y) {
                var template = row.nextElementSibling;
                if (!template || !template.matches('[data-task-list-menu]')) return;
                closeTaskContextMenu(false);
                hideHoverCard();
                contextRow = row;
                contextMenu.__openVibelyMenuReturnFocus = row;
                var menu = contextMenu.querySelector('ul');
                menu.replaceChildren(template.content.cloneNode(true));
                // Keep ownership explicit even when browsing All projects or another task.
                contextMenu.setAttribute('hx-vals', JSON.stringify({project_id: row.dataset.taskOwnerProject}));
                if (currentProjectID() === '__all_projects__') {
                    menu.querySelectorAll('a[hx-get]').forEach(function(link) {
                        var url = link.getAttribute('hx-get') + '&project_id=' + encodeURIComponent(currentProjectID());
                        link.setAttribute('hx-get', url); link.setAttribute('href', url);
                    });
                }
                contextMenu.dataset.contextX = x;
                contextMenu.dataset.contextY = y;
                htmx.process(contextMenu);
                var trigger = contextMenu.querySelector('[data-kanban-menu-trigger]');
                handleDropdownToggle({currentTarget: trigger, stopPropagation: function() {}, preventDefault: function() {}});
                var first = menu.querySelector('button:not(:disabled), a[href]');
                contextMenu.__openVibelyPendingMenuFocus = first;
            }
            groups.addEventListener('contextmenu', function(event) {
                var row = event.target.closest('[data-task-list-row]');
                if (!row) return;
                event.preventDefault();
                openTaskContextMenu(row, event.clientX, event.clientY);
            });
            groups.addEventListener('keydown', function(event) {
                if (event.key !== 'ContextMenu' && !(event.shiftKey && event.key === 'F10')) return;
                var row = event.target.closest('[data-task-list-row]');
                if (!row) return;
                event.preventDefault();
                var rect = row.getBoundingClientRect();
                openTaskContextMenu(row, rect.left, rect.bottom);
            });
            document.addEventListener('keydown', function(event) {
                if (!taskContextMenuOpen()) return;
                if (['ArrowDown', 'ArrowUp', 'Home', 'End'].includes(event.key)) {
                    if (window.kanbanDropdownForTarget(event.target) !== contextMenu) return;
                    var panel = event.target.closest('[data-menu-submenu-portaled], [data-menu-content]');
                    if (!panel) return;
                    var items = Array.from(panel.querySelectorAll(':scope > li > button:not(:disabled), :scope > li > a[href]')).filter(function(item) {
                        return item.getAttribute('aria-disabled') !== 'true' && item.getClientRects().length > 0;
                    });
                    if (!items.length) return;
                    event.preventDefault();
                    var index = items.indexOf(document.activeElement);
                    if (event.key === 'Home') index = 0;
                    else if (event.key === 'End') index = items.length - 1;
                    else index = (index + (event.key === 'ArrowDown' ? 1 : items.length - 1)) % items.length;
                    items[index].focus({preventScroll: true});
                }
                if (event.key === 'Escape') { event.preventDefault(); closeTaskContextMenu(true); }
                if (event.key === 'Tab') closeTaskContextMenu(true);
            }, true);
            document.addEventListener('pointerdown', function(event) {
                if (window.kanbanDropdownForTarget(event.target) !== contextMenu) closeTaskContextMenu(false);
            });
            groups.addEventListener('scroll', function() { closeTaskContextMenu(false); }, true);
            window.addEventListener('resize', function() { closeTaskContextMenu(false); });
            window.addEventListener('task-list-action-finished', function() { closeTaskContextMenu(true); refreshSoon(0); });
            contextMenu.addEventListener('htmx:afterRequest', function(event) {
                closeTaskContextMenu(true); refreshSoon(0);
            });
            contextMenu.addEventListener('click', function(event) {
                if (event.target.closest('a[href]')) closeTaskContextMenu(false);
            });

			var refreshTimer = null, refreshAt = 0;
			function refreshSoon(delay) {
				var at = Date.now() + delay;
				if (refreshTimer && refreshAt <= at) return;
				clearTimeout(refreshTimer);
				refreshAt = at;
				refreshTimer = setTimeout(function() { refreshTimer = null; if (window.htmx) htmx.trigger(groups, 'taskListRefresh'); }, delay);
			}
			function currentProjectID() {
				var m = (groups.getAttribute('hx-get') || '').match(/project_id=([^&]+)/);
				return m ? decodeURIComponent(m[1]) : '';
			}
            function applyTaskDeletion(data) {
                if (!data || !data.task_id) return;
                var id = data.task_id;
                if (contextRow && contextRow.dataset.taskListRow === id) closeTaskContextMenu(false);
                groups.querySelectorAll('[data-task-list-row]').forEach(function(row) {
                    if (row.dataset.taskListRow !== id) return;
                    var template = row.nextElementSibling;
                    if (template && template.matches('[data-task-list-menu]')) template.remove();
                    row.remove();
                });
                lastListHTML = null;
                var card = document.getElementById('task-' + id);
                if (card && card.closest('#kanban-board')) htmx.remove(card);
                // Reconcile counts and empty groups without waiting for the live stream.
                refreshSoon(0);
                var cache = window.openVibelyThreadCache;
                if (cache) cache.pages.forEach(function(page, key) {
                    if (page.threadKey === cache.threadKey(data.project_id, id)) cache.pages.delete(key);
                });
                var main = document.getElementById('main-content');
                var detail = main && main.querySelector('#task-detail-content, #task-thread-view');
                if (detail && detail.dataset.taskId === id) {
                    // Clean up the deleted thread before navigation can cache it again.
                    htmx.swap(main, '<div class="p-6">This task has been deleted.</div>', {swapStyle: 'innerHTML'});
                    window.openVibelyNavigate('/tasks?project_id=' + encodeURIComponent(currentProjectID() || data.project_id)).catch(function() {
                        if (window.showToast) window.showToast('Task deleted. Unable to load the task list.', 'failed');
                    });
                }
            }
            document.body.addEventListener('taskDeleted', function(event) {
                window.dispatchEvent(new CustomEvent('sse-task-event', {detail: event.detail}));
            });
			var listEvents = ['task_board_updated', 'task_status_changed', 'task_category_changed', 'task_thread_execution_started', 'task_lifecycle_execution_changed', 'task_thread_input_applied', 'task_thread_input_queued', 'task_goal_updated', 'task_goal_paused', 'task_goal_resumed', 'task_goal_cleared', 'task_goal_evaluated', 'task_goal_followup_queued'];
			window.addEventListener('sse-task-event', function(e) {
				var data = e.detail || {};
                if (data.type === 'task_deleted') { applyTaskDeletion(data); return; }
				if (listEvents.indexOf(data.type) === -1) return;
				if (currentProjectID() !== '__all_projects__' && data.project_id && data.project_id !== currentProjectID()) return;
				refreshSoon(300);
			});
			window.addEventListener('sse-live-connected', function() { refreshSoon(300); });

			document.body.addEventListener('htmx:afterRequest', function(e) {
				var cfg = e.detail && e.detail.requestConfig;
				if (!cfg || !e.detail.successful || cfg.verb === 'get' || e.detail.target === groups) return;
				if (!/^\/(tasks|thread-inputs|executions)\b/.test(cfg.path || '')) return;
				refreshSoon(150);
				setTimeout(function() { refreshSoon(0); }, 1500);
			});

			// Replacing a row between pointerdown and pointerup makes the browser drop the click.
			var pressing = false, deferredRefresh = false, lastListHTML = null, focusedTaskRow = null;
			groups.addEventListener('pointerdown', function() { pressing = true; });
            function flushDeferredRefresh() {
                if (!deferredRefresh || pressing || rowDrag || rowMovePending || taskContextMenuOpen()) return;
                deferredRefresh = false;
                refreshSoon(0);
            }
            var pressEndTimer = null;
            function endPress() {
                if (pressEndTimer !== null) return;
                // Let the click finish before a refresh can replace its target row.
                pressEndTimer = setTimeout(function() {
                    pressEndTimer = null;
                    pressing = false;
                    flushDeferredRefresh();
                }, 0);
            }
			document.addEventListener('pointerup', endPress, true);
			document.addEventListener('pointercancel', endPress, true);
			document.body.addEventListener('htmx:beforeSwap', function(e) {
				// Actions also target the list with swap:none; only list refreshes carry list HTML.
				if (e.detail.target !== groups || e.detail.elt !== groups) return;
				if (pressing || rowDrag || rowMovePending || taskContextMenuOpen()) { e.detail.shouldSwap = false; deferredRefresh = true; return; }
                deferredRefresh = false;
				if (e.detail.serverResponse === lastListHTML) { e.detail.shouldSwap = false; return; }
                groups.querySelectorAll('.task-list-group[data-browsing] .task-list-rows').forEach(function(rows) {
                    browseScroll[taskListGroupKey(rows.closest('.task-list-group'))] = rows.scrollTop;
                });
				lastListHTML = e.detail.serverResponse;
				var focusedRow = document.activeElement && document.activeElement.closest && document.activeElement.closest('[data-task-list-row]');
				focusedTaskRow = focusedRow && groups.contains(focusedRow) ? focusedRow.dataset.taskListRow : null;
				hideHoverCard();
			});
			document.body.addEventListener('htmx:afterSwap', function(e) {
				if (e.detail.target !== groups) return;
				restoreGroups(); filter(); syncActiveRow();
				if (focusedTaskRow === null) return;
				var row = groups.querySelector('[data-task-list-row="' + CSS.escape(focusedTaskRow) + '"]');
				focusedTaskRow = null;
				if (row && (document.activeElement === document.body || !document.activeElement)) row.focus({preventScroll: true});
			});
			document.body.addEventListener('htmx:afterSettle', syncActiveRow);
			window.addEventListener('popstate', syncActiveRow);
			window.addEventListener('resize', function() { setWidth(currentWidth(), false); });
			function activeProjectID() {
				var fromURL = new URLSearchParams(location.search).get('project_id');
				if (fromURL) return fromURL;
				var sel = document.getElementById('project-selector');
				return sel ? sel.value : '';
			}
			function syncProject() {
				var pid = activeProjectID();
				if (!pid || pid === currentProjectID()) return;
				clearTimeout(refreshTimer); refreshTimer = null;
				groups.setAttribute('hx-get', '/tasks/sidebar?project_id=' + encodeURIComponent(pid));
				if (window.htmx) { htmx.process(groups); htmx.trigger(groups, 'taskListRefresh'); }
			}
			document.addEventListener('change', function(e) { if (e.target && e.target.id === 'project-selector') syncProject(); });
			document.body.addEventListener('htmx:pushedIntoHistory', syncProject);
			document.body.addEventListener('htmx:replacedInHistory', syncProject);
			document.body.addEventListener('htmx:historyRestore', syncProject);
			document.body.addEventListener('htmx:afterSettle', syncProject);
			window.addEventListener('popstate', syncProject);
			document.addEventListener('DOMContentLoaded', syncToggle);
			syncToggle();
		})();
	</script>
}

templ TaskListHeaderControls(currentProjectID string) {
	<div id="task-list-header" aria-label="Task list controls">
		<button type="button" id="task-list-toggle" class="sidebar-toggle-btn btn btn-ghost btn-sm btn-square" aria-controls="task-list-panel" aria-expanded="true" aria-label="Collapse task list" title="Toggle task list (⌘B)">
			<svg viewBox="0 0 24 24" class="h-5 w-5" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path class="task-list-toggle-fill" d="M9 3H5a2 2 0 0 0-2 2v14a2 2 0 0 0 2 2h4Z" stroke="none"></path><rect x="3" y="3" width="18" height="18" rx="2"></rect><path d="M9 3v18"></path></svg>
		</button>
		<span class="task-list-brand">OpenVibely</span>
		<div class="task-list-actions">
			<button type="button" id="task-list-search-toggle" class="sidebar-toggle-btn header-action-btn btn btn-ghost btn-sm btn-square" aria-expanded="false" aria-controls="task-list-search-input" aria-label="Search tasks" title="Search tasks">
				<svg viewBox="0 0 24 24" class="h-5 w-5" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" aria-hidden="true"><circle cx="10" cy="10" r="6"></circle><path d="m15 15 5 5"></path></svg>
			</button>
			<a id="task-list-new" class="sidebar-toggle-btn header-action-btn btn btn-ghost btn-sm btn-square" data-nav-base="/tasks/new" href={ templ.SafeURL("/tasks/new?project_id=" + url.QueryEscape(currentProjectID)) } hx-get={ "/tasks/new?project_id=" + url.QueryEscape(currentProjectID) } hx-target="#main-content" hx-push-url="true" aria-label="New task" title="New task">
				<svg viewBox="0 0 24 24" class="h-5 w-5" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" aria-hidden="true"><path d="M12 5v14M5 12h14"></path></svg>
			</a>
		</div>
	</div>
}

templ SettingsLinks(currentProjectID string) {
	<a class="settings-back" href="/tasks" data-settings-back hx-get="/tasks" hx-target="#main-content" hx-push-url="true">
        <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="m12 19-7-7 7-7M5 12h14"></path></svg>
        <span>Back</span>
    </a>
	<details class="settings-nav-group" open>
		<summary class="task-list-row settings-nav-group-title">
			<svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
				<path d="M12 3a9 9 0 1 0 0 18h1.2a2 2 0 0 0 1.7-3.1l-.5-.8a1.3 1.3 0 0 1 1.1-2h1.7A3.8 3.8 0 0 0 21 11.3C21 6.7 17 3 12 3Z"></path>
				<circle cx="7.5" cy="10" r="1"></circle>
				<circle cx="11" cy="7" r="1"></circle>
				<circle cx="15.5" cy="8" r="1"></circle>
			</svg>
			<span class="task-list-title">Appearance</span>
			<svg class="settings-nav-disclosure" xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="m6 9 6 6 6-6"></path></svg>
		</summary>
		<div class="settings-nav-children">
			<a class="task-list-row settings-nav-child" href={ templ.SafeURL("/themes?project_id=" + url.QueryEscape(currentProjectID) + "#themes") } hx-get={ "/themes?project_id=" + url.QueryEscape(currentProjectID) + "#themes" } hx-target="#main-content" hx-push-url="true" data-settings-link="themes">
				<svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
					<rect x="3" y="3" width="14" height="6" rx="2"></rect>
					<path d="M17 6h2a2 2 0 0 1 2 2v3a2 2 0 0 1-2 2h-7v3"></path>
					<rect x="10" y="16" width="4" height="6" rx="1"></rect>
				</svg>
				<span class="task-list-title">Themes</span>
			</a>
			<a class="task-list-row settings-nav-child" href={ templ.SafeURL("/themes?project_id=" + url.QueryEscape(currentProjectID) + "#layout") } hx-get={ "/themes?project_id=" + url.QueryEscape(currentProjectID) + "#layout" } hx-target="#main-content" hx-push-url="true" data-settings-link="layout">
				<svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
					<rect x="3" y="3" width="18" height="18" rx="2"></rect>
					<path d="M3 9h18M9 9v12"></path>
				</svg>
				<span class="task-list-title">Layout</span>
			</a>
			<a class="task-list-row settings-nav-child" href={ templ.SafeURL("/themes?project_id=" + url.QueryEscape(currentProjectID) + "#chat") } hx-get={ "/themes?project_id=" + url.QueryEscape(currentProjectID) + "#chat" } hx-target="#main-content" hx-push-url="true" data-settings-link="chat">
				<svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
