package layout

import (
	"fmt"
	"net/url"
	"strconv"
	"time"

	"github.com/openvibely/openvibely/internal/models"
	"github.com/openvibely/openvibely/web/templates/taskstate"
)

const taskListGroupLimit = 7

type TaskListGroup struct {
	Label string
	Tasks []models.Task
}

func TaskListGroups(tasks []models.Task) []TaskListGroup {
	order := []models.TaskCategory{models.CategoryActive, models.CategoryCompleted, models.CategoryBacklog, models.CategoryScheduled}
	labels := map[models.TaskCategory]string{models.CategoryActive: "Active", models.CategoryBacklog: "Backlog", models.CategoryScheduled: "Scheduled", models.CategoryCompleted: "Completed"}
	byCategory := map[models.TaskCategory][]models.Task{}
	for _, task := range tasks {
		if task.ParentTaskID != nil {
			continue
		}
		byCategory[task.Category] = append(byCategory[task.Category], task)
	}
	groups := make([]TaskListGroup, 0, len(order))
	for _, category := range order {
		if len(byCategory[category]) > 0 {
			groups = append(groups, TaskListGroup{Label: labels[category], Tasks: byCategory[category]})
		}
	}
	return groups
}

func taskListAge(t time.Time) string {
	d := time.Since(t)
	switch {
	case d < time.Minute:
		return "now"
	case d < time.Hour:
		return strconv.Itoa(int(d.Minutes())) + "m"
	case d < 24*time.Hour:
		return strconv.Itoa(int(d.Hours())) + "h"
	case d < 7*24*time.Hour:
		return strconv.Itoa(int(d.Hours()/24)) + "d"
	case d < 365*24*time.Hour:
		return strconv.Itoa(int(d.Hours()/(24*7))) + "w"
	}
	return strconv.Itoa(int(d.Hours()/(24*365))) + "y"
}

templ TaskListPanelContent(projectID string, groups []TaskListGroup) {
	if len(groups) == 0 {
		<div class="task-list-empty">No tasks yet.</div>
	}
	for _, group := range groups {
		<details class="task-list-group" open data-task-list-group={ group.Label }>
			<summary>
				<svg class="task-list-chevron" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="m6 9 6 6 6-6"></path></svg>
				<span class="task-list-group-label">{ group.Label }</span>
				<span class="task-list-count">{ strconv.Itoa(len(group.Tasks)) }</span>
			</summary>
			for i, task := range group.Tasks {
				<a
					class="task-list-row"
					data-task-list-row={ task.ID }
					data-task-list-title={ task.Title }
					data-task-list-extra?={ i >= taskListGroupLimit }
					data-task-list-age={ taskListAge(task.UpdatedAt) }
					href={ templ.SafeURL(fmt.Sprintf("/tasks/%s?from=tasks", task.ID)) }
					hx-get={ fmt.Sprintf("/tasks/%s?from=tasks", task.ID) }
					hx-target="#main-content"
					hx-swap="innerHTML"
					hx-push-url="true"
				>
					@taskstate.Icon(task)
					<span class="task-list-title">{ task.Title }</span>
					if task.Prompt != "" {
						<template data-task-list-prompt>{ task.Prompt }</template>
					}
				</a>
			}
			if len(group.Tasks) > taskListGroupLimit {
				<button type="button" class="task-list-more" data-task-list-more={ strconv.Itoa(len(group.Tasks) - taskListGroupLimit) }>{ fmt.Sprintf("Show %d more", len(group.Tasks)-taskListGroupLimit) }</button>
			}
		</details>
	}
}

templ TaskListPanel(currentProjectID string) {
	<aside id="task-list-panel" aria-label="Tasks">
		<nav id="appearance-settings-nav" aria-label="Settings">
			@SettingsLinks(currentProjectID)
		</nav>
		<div class="task-list-search" hidden>
			<input id="task-list-search-input" type="search" placeholder="Search tasks…" aria-label="Search tasks" autocomplete="off"/>
		</div>
		<div
			id="task-list-groups"
			hx-get={ fmt.Sprintf("/tasks/sidebar?project_id=%s", currentProjectID) }
			hx-trigger="load, taskListRefresh from:body"
			hx-swap="innerHTML"
			hx-sync="this:queue last"
			hx-push-url="false"
		></div>
	</aside>
	<nav class="settings-mobile-nav" aria-label="Settings">@SettingsLinks(currentProjectID)</nav>
	<div id="task-list-divider" role="separator" aria-orientation="vertical" aria-label="Resize task list" tabindex="0"></div>
	<style>
        #appearance-settings-nav { display: none; }
        html.appearance-settings #task-list-panel > :not(#appearance-settings-nav) { display: none !important; }
        html.appearance-settings #appearance-settings-nav { display: flex; flex-direction: column; overflow-y: auto; }
        #appearance-settings-nav .settings-back { font-size: 13px; opacity: .75; padding: 10px; margin-bottom: 12px; }
        html.appearance-settings #task-list-header { visibility: hidden; }
        html.appearance-settings #task-list-divider { display: none !important; }
        .settings-mobile-nav { display: none; }
        html.appearance-settings .settings-mobile-nav { display: flex; flex-wrap: wrap; gap: 4px; padding: 12px; max-height: 40vh; overflow-y: auto; flex-shrink: 0; }
        .settings-mobile-nav .settings-back { width: 100%; padding: 8px 10px; }
        html.appearance-settings[data-shell-frame] .settings-mobile-nav { display: none; }
        [data-settings-section][hidden] { display: none !important; }
    </style>
	<script>
        (function() {
            var root = document.documentElement;
            var inSettings = false;
            var wasCollapsed = false;
            var workspaceURL = /^\/(themes|models|agents|skills|channels|personality|settings\/workers)(\/|$)/.test(location.pathname) ? '/tasks' + location.search : location.pathname + location.search + location.hash;
            var workspaceScroll = 0;
            var boardScroll = new Map();
            var boardScrollSelector = '#tasks-page, #kanban-board, .category-drop-zone, .task-drop-zone';
            function boardScrollKey(el) {
                return el.id || JSON.stringify([el.getAttribute('data-project-id'), el.getAttribute('data-category'), el.getAttribute('data-status')]);
            }
            document.addEventListener('htmx:beforeRequest', function(e) {
                if (e.detail.target && e.detail.target.id === 'main-content' && !inSettings) {
                    workspaceURL = location.pathname + location.search + location.hash;
                    workspaceScroll = document.getElementById('main-content').scrollTop;
                    boardScroll.clear();
                    document.getElementById('main-content').querySelectorAll(boardScrollSelector).forEach(function(el) {
                        boardScroll.set(boardScrollKey(el), {top: el.scrollTop, left: el.scrollLeft});
                    });
                }
            });
            window.syncAppearanceSettings = function() {
                var appearance = !!document.getElementById('themes-container');
                var workerConfig = location.pathname === '/settings/workers' && !!document.getElementById('worker-settings-content');
                var active = appearance || workerConfig || !!document.querySelector('#main-content #models-container, #main-content #agents-container, #main-content #skills-container, #main-content #channels-container, #main-content #personality-container');
                root.classList.toggle('worker-configuration', workerConfig);
                if (active && !inSettings) {
                    wasCollapsed = root.classList.contains('task-list-collapsed');
                    root.classList.remove('task-list-collapsed');
                } else if (!active && inSettings) {
                    root.classList.toggle('task-list-collapsed', wasCollapsed);
                    if (location.pathname + location.search + location.hash === workspaceURL) {
                        document.getElementById('main-content').scrollTop = workspaceScroll;
                        document.getElementById('main-content').querySelectorAll(boardScrollSelector).forEach(function(el) {
                            var position = boardScroll.get(boardScrollKey(el));
                            if (position) {
                                el.scrollTop = position.top;
                                el.scrollLeft = position.left;
                            }
                        });
                    }
                }
                inSettings = active;
                root.classList.toggle('appearance-settings', active);
                document.getElementById('task-list-panel').setAttribute('aria-label', active ? 'Settings' : 'Tasks');
                if (!active) return;
                var projectID = new URLSearchParams(location.search).get('project_id') || (document.getElementById('project-selector') || {}).value || '';
                document.querySelectorAll('[data-settings-link]').forEach(function(link) {
                    var target = '/themes?project_id=' + encodeURIComponent(projectID) + '#' + link.dataset.settingsLink;
                    link.setAttribute('href', target);
                    link.setAttribute('hx-get', target);
                    if (window.htmx) htmx.process(link);
                });
                var section = location.hash.slice(1);
                if (!['themes','layout','chat'].includes(section)) section = 'themes';
                document.querySelectorAll('[data-settings-section]').forEach(function(el) { el.hidden = el.dataset.settingsSection !== section; });
                document.querySelectorAll('[data-settings-link]').forEach(function(el) {
                    if (appearance && el.dataset.settingsLink === section) el.setAttribute('aria-current', 'page');
                    else el.removeAttribute('aria-current');
                });
                if (appearance) document.getElementById('appearance-section-title').textContent = {themes: 'Themes', layout: 'Layout', chat: 'Chat appearance'}[section];
                document.querySelectorAll('[data-settings-back]').forEach(function(el) {
                    el.setAttribute('href', workspaceURL);
                    el.setAttribute('hx-get', workspaceURL);
                    if (window.htmx) htmx.process(el);
                });
            };
            document.addEventListener('click', function(e) {
                var link = e.target.closest('[data-settings-link]');
                if (!link || !document.getElementById('themes-container') || e.button !== 0 || e.metaKey || e.ctrlKey || e.shiftKey || e.altKey) return;
                e.preventDefault();
                e.stopPropagation();
                history.replaceState(history.state, '', '#' + link.dataset.settingsLink);
                window.syncAppearanceSettings();
            }, true);
            document.addEventListener('DOMContentLoaded', window.syncAppearanceSettings);
            document.addEventListener('htmx:afterSettle', window.syncAppearanceSettings);
            document.addEventListener('htmx:historyRestore', window.syncAppearanceSettings);
            window.addEventListener('hashchange', window.syncAppearanceSettings);
        })();
    </script>
	<script>
		(function() {
			var root = document.documentElement;
			var panel = document.getElementById('task-list-panel');
			var groups = document.getElementById('task-list-groups');
			var divider = document.getElementById('task-list-divider');
			var searchBox = panel.querySelector('.task-list-search');
			var searchInput = document.getElementById('task-list-search-input');
			var widthKey = 'openvibely.taskListWidth';
			var collapsedKey = 'openvibely.taskListCollapsed';
			var MIN = 200, MAX = 560;

			function clampWidth(w) { return Math.round(Math.max(MIN, Math.min(MAX, w, window.innerWidth - 480))); }
			function setWidth(w, persist) {
				var next = clampWidth(w);
				root.style.setProperty('--task-list-width', next + 'px');
				divider.setAttribute('aria-valuenow', String(next));
				if (persist) try { localStorage.setItem(widthKey, String(next)); } catch (_) {}
			}
			function currentWidth() { return parseFloat(getComputedStyle(root).getPropertyValue('--task-list-width')) || 300; }
			try { var saved = parseFloat(localStorage.getItem(widthKey)); if (saved) setWidth(saved, false); } catch (_) {}
			try { if (localStorage.getItem(collapsedKey) === 'true') root.classList.add('task-list-collapsed'); } catch (_) {}

			function toggleButton() { return document.getElementById('task-list-toggle'); }
			function syncToggle() {
				var btn = toggleButton(); if (!btn) return;
				var collapsed = root.classList.contains('task-list-collapsed');
				btn.setAttribute('aria-expanded', collapsed ? 'false' : 'true');
				btn.setAttribute('aria-label', (collapsed ? 'Expand' : 'Collapse') + ' task list');
			}
			function setCollapsed(collapsed) {
                if (root.classList.contains("appearance-settings")) return;
				root.classList.toggle('task-list-collapsed', collapsed);
				try { localStorage.setItem(collapsedKey, String(collapsed)); } catch (_) {}
				syncToggle();
			}
			function openSearch(open) {
				searchBox.hidden = !open;
				var btn = document.getElementById('task-list-search-toggle');
				if (btn) btn.setAttribute('aria-expanded', String(open));
				if (open) { setCollapsed(false); searchInput.focus(); }
				else { searchInput.value = ''; filter(); }
			}
			function filter() {
				var q = searchInput.value.trim().toLowerCase();
groups.querySelectorAll('.task-list-group').forEach(function(group) {
						var label = group.getAttribute('data-task-list-group');
						var wasSearching = group.hasAttribute('data-searching');
						if (q && !wasSearching) {
							// Capture the current state even if its toggle event is still queued.
							groupState[label] = Object.assign({}, groupState[label], { closed: !group.open });
							saveGroupState();
						}
						var visible = 0;					group.querySelectorAll('[data-task-list-row]').forEach(function(row) {
						var match = !q || (row.getAttribute('data-task-list-title') || '').toLowerCase().indexOf(q) !== -1;
						row.hidden = !match; if (match) visible++;
					});
					group.hidden = visible === 0;
					group.toggleAttribute('data-searching', !!q);
						if (q) group.open = visible > 0;
						else if (wasSearching) group.open = !(groupState[label] || {}).closed;
				});
			}
			function syncActiveRow() {
				var m = window.location.pathname.match(/^\/tasks\/([^/]+)$/);
				var id = m ? m[1] : '';
				groups.querySelectorAll('[data-task-list-row]').forEach(function(row) {
					if (row.getAttribute('data-task-list-row') === id) row.setAttribute('aria-current', 'page');
					else row.removeAttribute('aria-current');
				});
			}

			document.addEventListener('click', function(e) {
				if (e.target.closest('#task-list-toggle')) { e.preventDefault(); setCollapsed(!root.classList.contains('task-list-collapsed')); }
				else if (e.target.closest('#task-list-search-toggle')) { e.preventDefault(); openSearch(searchBox.hidden); }
			});
			document.addEventListener('keydown', function(e) {
				if (!root.hasAttribute('data-shell-frame') || e.defaultPrevented || e.isComposing || e.repeat || e.altKey || e.shiftKey || !(e.ctrlKey || e.metaKey) || e.key.toLowerCase() !== 'b') return;
				e.preventDefault();
				setCollapsed(!root.classList.contains('task-list-collapsed'));
			});
			searchInput.addEventListener('input', filter);
			searchInput.addEventListener('keydown', function(e) { if (e.key === 'Escape') { e.preventDefault(); openSearch(false); } });

			var drag = null;
			divider.addEventListener('pointerdown', function(e) {
				if (e.button !== 0) return;
				e.preventDefault();
				drag = { id: e.pointerId, x: e.clientX, width: panel.getBoundingClientRect().width };
				divider.setPointerCapture(e.pointerId);
				root.classList.add('task-list-resizing');
			});
			divider.addEventListener('pointermove', function(e) { if (drag && e.pointerId === drag.id) setWidth(drag.width + e.clientX - drag.x, false); });
			function endDrag() { if (!drag) return; drag = null; root.classList.remove('task-list-resizing'); setWidth(currentWidth(), true); }
			divider.addEventListener('pointerup', endDrag);
			divider.addEventListener('pointercancel', endDrag);
			divider.addEventListener('lostpointercapture', endDrag);
			divider.addEventListener('dblclick', function() { setWidth(300, true); });
			divider.addEventListener('keydown', function(e) {
				var w = currentWidth();
				if (e.key === 'ArrowLeft') w -= 20; else if (e.key === 'ArrowRight') w += 20; else return;
				e.preventDefault(); setWidth(w, true);
			});

			var groupStateKey = 'openvibely.taskListGroups';
			var groupState = {};
			try { groupState = JSON.parse(localStorage.getItem(groupStateKey) || '{}') || {}; } catch (_) {}
			function saveGroupState() { try { localStorage.setItem(groupStateKey, JSON.stringify(groupState)); } catch (_) {} }
			function syncMore(group) {
				var btn = group.querySelector('.task-list-more');
				if (btn) btn.textContent = group.hasAttribute('data-expanded') ? 'Show less' : 'Show ' + btn.getAttribute('data-task-list-more') + ' more';
			}
			function restoreGroups() {
				groups.querySelectorAll('.task-list-group').forEach(function(group) {
					var st = groupState[group.getAttribute('data-task-list-group')] || {};
					group.open = !st.closed;
					group.toggleAttribute('data-expanded', !!st.expanded);
					syncMore(group);
				});
			}
			groups.addEventListener('toggle', function(e) {
				var group = e.target;
				if (!group.classList || !group.classList.contains('task-list-group')) return;
				// Search expansion is temporary, including after a live list refresh.
				if (searchInput.value.trim()) return;
				var label = group.getAttribute('data-task-list-group');
				groupState[label] = Object.assign({}, groupState[label], { closed: !group.open });
				saveGroupState();
			}, true);
			groups.addEventListener('click', function(e) {
				if (e.button !== 0 || e.metaKey || e.ctrlKey || e.shiftKey || e.altKey) return;
				var row = e.target.closest('[data-task-list-row]');
				if (!row) return;
				var main = document.getElementById('main-content');
				var thread = main && main.querySelector('#task-thread-view');
				// Cached navigation displays the new task before the URL changes.
				// A cold navigation hides the outgoing thread; allow clicking back to it.
				if (!thread || thread.closest('[hidden], .hidden, [data-workspace-hidden]') || main.hasAttribute('data-page-loading') || thread.getAttribute('data-task-id') !== row.getAttribute('data-task-list-row')) return;
				e.preventDefault();
				e.stopPropagation();
			}, true);
			groups.addEventListener('click', function(e) {
				var btn = e.target.closest('.task-list-more');
				if (!btn) return;
				var group = btn.closest('.task-list-group');
				var expanded = !group.hasAttribute('data-expanded');
				group.toggleAttribute('data-expanded', expanded);
				var label = group.getAttribute('data-task-list-group');
				groupState[label] = Object.assign({}, groupState[label], { expanded: expanded });
				saveGroupState();
				syncMore(group);
			});

			var hoverCard = document.createElement('div');
			hoverCard.className = 'task-list-hovercard ov-menu';
			hoverCard.setAttribute('role', 'tooltip');
			hoverCard.hidden = true;
			document.body.appendChild(hoverCard);
			var hoverTimer = null, hoverRow = null;
			function hideHoverCard() { clearTimeout(hoverTimer); hoverRow = null; hoverCard.hidden = true; }
			function showHoverCard(row) {
				hoverCard.replaceChildren();
				var head = document.createElement('div'); head.className = 'task-list-hovercard-head';
				var icon = row.querySelector('[data-task-state-icon]');
				if (icon) head.appendChild(icon.cloneNode(true));
				var title = document.createElement('strong'); title.textContent = row.getAttribute('data-task-list-title') || '';
				head.appendChild(title);
				hoverCard.appendChild(head);
				var prompt = row.querySelector('template[data-task-list-prompt]');
				if (prompt && prompt.content.textContent.trim()) {
					var p = document.createElement('p'); p.className = 'task-list-hovercard-prompt'; p.textContent = prompt.content.textContent.trim();
					hoverCard.appendChild(p);
				}
				var meta = document.createElement('div'); meta.className = 'task-list-hovercard-meta';
				var state = icon ? (icon.getAttribute('aria-label') || '').replace(/^Task state:\s*/, '') : '';
				meta.textContent = (state ? state + ' · ' : '') + 'Updated ' + (row.getAttribute('data-task-list-age') || '') + (row.getAttribute('data-task-list-age') === 'now' ? '' : ' ago');
				hoverCard.appendChild(meta);
				hoverCard.hidden = false;
				var r = row.getBoundingClientRect(), panelRect = panel.getBoundingClientRect();
				var top = Math.max(8, Math.min(r.top - 4, window.innerHeight - hoverCard.offsetHeight - 8));
				hoverCard.style.left = Math.round(panelRect.right + 8) + 'px';
				hoverCard.style.top = Math.round(top) + 'px';
			}
			groups.addEventListener('mouseover', function(e) {
				var row = e.target.closest('[data-task-list-row]');
				if (row === hoverRow) return;
				clearTimeout(hoverTimer);
				hoverRow = row;
				if (!row) { hoverCard.hidden = true; return; }
				hoverTimer = setTimeout(function() { if (hoverRow === row && row.isConnected) showHoverCard(row); }, hoverCard.hidden ? 450 : 60);
			});
			groups.addEventListener('mouseleave', hideHoverCard);
			groups.addEventListener('scroll', hideHoverCard, { passive: true });
			groups.addEventListener('click', hideHoverCard);

			var refreshTimer = null, refreshAt = 0;
			function refreshSoon(delay) {
				var at = Date.now() + delay;
				if (refreshTimer && refreshAt <= at) return;
				clearTimeout(refreshTimer);
				refreshAt = at;
				refreshTimer = setTimeout(function() { refreshTimer = null; if (window.htmx) htmx.trigger(groups, 'taskListRefresh'); }, delay);
			}
			function currentProjectID() {
				var m = (groups.getAttribute('hx-get') || '').match(/project_id=([^&]+)/);
				return m ? decodeURIComponent(m[1]) : '';
			}
			var listEvents = ['task_board_updated', 'task_status_changed', 'task_category_changed', 'task_thread_execution_started', 'task_lifecycle_execution_changed', 'task_thread_input_applied', 'task_thread_input_queued', 'task_goal_updated', 'task_goal_paused', 'task_goal_resumed', 'task_goal_cleared', 'task_goal_evaluated', 'task_goal_followup_queued'];
			window.addEventListener('sse-task-event', function(e) {
				var data = e.detail || {};
				if (listEvents.indexOf(data.type) === -1) return;
				if (data.project_id && data.project_id !== currentProjectID()) return;
				refreshSoon(300);
			});
			window.addEventListener('sse-live-connected', function() { refreshSoon(300); });
			document.body.addEventListener('htmx:afterRequest', function(e) {
				var cfg = e.detail && e.detail.requestConfig;
				if (!cfg || !e.detail.successful || cfg.verb === 'get' || e.detail.target === groups) return;
				if (!/^\/(tasks|thread-inputs|executions)\b/.test(cfg.path || '')) return;
				refreshSoon(150);
				setTimeout(function() { refreshSoon(0); }, 1500);
			});

			// Replacing a row between pointerdown and pointerup makes the browser drop the click.
			var pressing = false, deferredRefresh = false, lastListHTML = null;
			groups.addEventListener('pointerdown', function() { pressing = true; });
			function endPress() {
				if (!pressing) return;
				setTimeout(function() {
					pressing = false;
					if (deferredRefresh) { deferredRefresh = false; refreshSoon(0); }
				}, 0);
			}
			document.addEventListener('pointerup', endPress, true);
			document.addEventListener('pointercancel', endPress, true);
			document.body.addEventListener('htmx:beforeSwap', function(e) {
				if (e.detail.target !== groups) return;
				if (pressing) { e.detail.shouldSwap = false; deferredRefresh = true; return; }
				if (e.detail.serverResponse === lastListHTML) { e.detail.shouldSwap = false; return; }
				lastListHTML = e.detail.serverResponse;
				hideHoverCard();
			});
			document.body.addEventListener('htmx:afterSwap', function(e) { if (e.detail.target === groups) { restoreGroups(); filter(); syncActiveRow(); } });
			document.body.addEventListener('htmx:afterSettle', syncActiveRow);
			window.addEventListener('popstate', syncActiveRow);
			window.addEventListener('resize', function() { setWidth(currentWidth(), false); });
			function activeProjectID() {
				var fromURL = new URLSearchParams(location.search).get('project_id');
				if (fromURL) return fromURL;
				var sel = document.getElementById('project-selector');
				return sel ? sel.value : '';
			}
			function syncProject() {
				var pid = activeProjectID();
				if (!pid || pid === currentProjectID()) return;
				clearTimeout(refreshTimer); refreshTimer = null;
				groups.setAttribute('hx-get', '/tasks/sidebar?project_id=' + encodeURIComponent(pid));
				if (window.htmx) { htmx.process(groups); htmx.trigger(groups, 'taskListRefresh'); }
			}
			document.addEventListener('change', function(e) { if (e.target && e.target.id === 'project-selector') syncProject(); });
			document.body.addEventListener('htmx:pushedIntoHistory', syncProject);
			document.body.addEventListener('htmx:replacedInHistory', syncProject);
			document.body.addEventListener('htmx:historyRestore', syncProject);
			document.body.addEventListener('htmx:afterSettle', syncProject);
			window.addEventListener('popstate', syncProject);
			document.addEventListener('DOMContentLoaded', syncToggle);
			syncToggle();
		})();
	</script>
}

templ TaskListHeaderControls(currentProjectID string) {
	<div id="task-list-header" aria-label="Task list controls">
		<button type="button" id="task-list-toggle" class="sidebar-toggle-btn btn btn-ghost btn-sm btn-square" aria-controls="task-list-panel" aria-expanded="true" aria-label="Collapse task list" title="Toggle task list (⌘B)">
			<svg viewBox="0 0 24 24" class="h-5 w-5" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path class="task-list-toggle-fill" d="M9 3H5a2 2 0 0 0-2 2v14a2 2 0 0 0 2 2h4Z" stroke="none"></path><rect x="3" y="3" width="18" height="18" rx="2"></rect><path d="M9 3v18"></path></svg>
		</button>
		<span class="task-list-brand">OpenVibely</span>
		<div class="task-list-actions">
			<button type="button" id="task-list-search-toggle" class="sidebar-toggle-btn header-action-btn btn btn-ghost btn-sm btn-square" aria-expanded="false" aria-label="Search tasks" title="Search tasks">
				<svg viewBox="0 0 24 24" class="h-5 w-5" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" aria-hidden="true"><circle cx="10" cy="10" r="6"></circle><path d="m15 15 5 5"></path></svg>
			</button>
			<a id="task-list-new" class="sidebar-toggle-btn header-action-btn btn btn-ghost btn-sm btn-square" data-nav-base="/tasks/new" href={ templ.SafeURL("/tasks/new?project_id=" + url.QueryEscape(currentProjectID)) } hx-get={ "/tasks/new?project_id=" + url.QueryEscape(currentProjectID) } hx-target="#main-content" hx-push-url="true" aria-label="New task" title="New task">
				<svg viewBox="0 0 24 24" class="h-5 w-5" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" aria-hidden="true"><path d="M12 5v14M5 12h14"></path></svg>
			</a>
		</div>
	</div>
}

templ SettingsLinks(currentProjectID string) {
	<a class="settings-back" href="/tasks" data-settings-back hx-get="/tasks" hx-target="#main-content" hx-push-url="true">← Back to workspace</a>
	<a class="task-list-row" href={ templ.SafeURL("/themes?project_id=" + url.QueryEscape(currentProjectID) + "#themes") } hx-get={ "/themes?project_id=" + url.QueryEscape(currentProjectID) + "#themes" } hx-target="#main-content" hx-push-url="true" data-settings-link="themes">
		<svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
			<rect x="3" y="3" width="14" height="6" rx="2"></rect>
			<path d="M17 6h2a2 2 0 0 1 2 2v3a2 2 0 0 1-2 2h-7v3"></path>
			<rect x="10" y="16" width="4" height="6" rx="1"></rect>
		</svg>
		<span class="task-list-title">Themes</span>
	</a>
	<a class="task-list-row" href={ templ.SafeURL("/themes?project_id=" + url.QueryEscape(currentProjectID) + "#layout") } hx-get={ "/themes?project_id=" + url.QueryEscape(currentProjectID) + "#layout" } hx-target="#main-content" hx-push-url="true" data-settings-link="layout">
		<svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
			<rect x="3" y="3" width="18" height="18" rx="2"></rect>
			<path d="M3 9h18M9 9v12"></path>
		</svg>
		<span class="task-list-title">Layout</span>
	</a>
	<a class="task-list-row" href={ templ.SafeURL("/themes?project_id=" + url.QueryEscape(currentProjectID) + "#chat") } hx-get={ "/themes?project_id=" + url.QueryEscape(currentProjectID) + "#chat" } hx-target="#main-content" hx-push-url="true" data-settings-link="chat">
		<svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
			<path d="M21 11.5a8.4 8.4 0 0 1-.9 3.8 8.5 8.5 0 0 1-7.6 4.7 8.4 8.4 0 0 1-3.8-.9L3 21l1.9-5.7a8.4 8.4 0 0 1-.9-3.8 8.5 8.5 0 0 1 4.7-7.6 8.4 8.4 0 0 1 3.8-.9h.5a8.5 8.5 0 0 1 8 8z"></path>
			<path d="M8 10h8M8 14h5"></path>
		</svg>
		<span class="task-list-title">Chat appearance</span>
	</a>
	<a
		class="task-list-row"
		data-nav-base="/models"
		href={ templ.SafeURL(fmt.Sprintf("/models?project_id=%s", currentProjectID)) }
		hx-get={ fmt.Sprintf("/models?project_id=%s", currentProjectID) }
		hx-target="#main-content"
		hx-push-url="true"
	>
		<svg xmlns="http://www.w3.org/2000/svg" class="h-4 w-4 shrink-0" fill="none" viewBox="0 0 24 24" stroke="currentColor">
			<path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9.75 17L9 20l-1 1h8l-1-1-.75-3M3 13h18M5 17h14a2 2 0 002-2V5a2 2 0 00-2-2H5a2 2 0 00-2 2v10a2 2 0 002 2z"></path>
		</svg>
		<span class="task-list-title">Models</span>
	</a>
	<a
		class="task-list-row"
		data-nav-base="/agents"
		href={ templ.SafeURL(fmt.Sprintf("/agents?project_id=%s", currentProjectID)) }
		hx-get={ fmt.Sprintf("/agents?project_id=%s", currentProjectID) }
		hx-target="#main-content"
		hx-push-url="true"
	>
		<svg xmlns="http://www.w3.org/2000/svg" class="h-4 w-4 shrink-0" fill="none" viewBox="0 0 24 24" stroke="currentColor">
			<path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M17 20h5v-2a3 3 0 00-5.356-1.857M17 20H7m10 0v-2c0-.656-.126-1.283-.356-1.857M7 20H2v-2a3 3 0 015.356-1.857M7 20v-2c0-.656.126-1.283.356-1.857m0 0a5.002 5.002 0 019.288 0M15 7a3 3 0 11-6 0 3 3 0 016 0z"></path>
		</svg>
		<span class="task-list-title">Agents</span>
	</a>
	<a
		class="task-list-row"
		data-nav-base="/skills"
		href={ templ.SafeURL(fmt.Sprintf("/skills?project_id=%s", currentProjectID)) }
		hx-get={ fmt.Sprintf("/skills?project_id=%s", currentProjectID) }
		hx-target="#main-content"
		hx-push-url="true"
	>
		<svg xmlns="http://www.w3.org/2000/svg" class="h-4 w-4 shrink-0" fill="none" viewBox="0 0 24 24" stroke="currentColor">
			<path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 6.253v13m0-13C10.832 5.477 9.246 5 7.5 5S4.168 5.477 3 6.253v13C4.168 18.477 5.754 18 7.5 18s3.332.477 4.5 1.253m0-13C13.168 5.477 14.754 5 16.5 5c1.746 0 3.332.477 4.5 1.253v13C19.832 18.477 18.246 18 16.5 18c-1.746 0-3.332.477-4.5 1.253"></path>
		</svg>
		<span class="task-list-title">Skills</span>
	</a>
	<a
		class="task-list-row"
		data-nav-base="/channels"
		href={ templ.SafeURL(fmt.Sprintf("/channels?project_id=%s", currentProjectID)) }
		hx-get={ fmt.Sprintf("/channels?project_id=%s", currentProjectID) }
		hx-target="#main-content"
		hx-push-url="true"
	>
		<svg xmlns="http://www.w3.org/2000/svg" class="h-4 w-4 shrink-0" fill="none" viewBox="0 0 24 24" stroke="currentColor">
			<path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M13.828 10.172a4 4 0 00-5.656 0l-4 4a4 4 0 105.656 5.656l1.102-1.101m-.758-4.899a4 4 0 005.656 0l4-4a4 4 0 00-5.656-5.656l-1.1 1.1"></path>
		</svg>
		<span class="task-list-title">Channels</span>
	</a>
	<a
		class="task-list-row"
		data-nav-base="/personality"
		href={ templ.SafeURL(fmt.Sprintf("/personality?project_id=%s", currentProjectID)) }
		hx-get={ fmt.Sprintf("/personality?project_id=%s", currentProjectID) }
		hx-target="#main-content"
		hx-push-url="true"
	>
		<svg xmlns="http://www.w3.org/2000/svg" class="h-4 w-4 shrink-0" fill="none" viewBox="0 0 24 24" stroke="currentColor">
			<path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M14.828 14.828a4 4 0 01-5.656 0M9 10h.01M15 10h.01M21 12a9 9 0 11-18 0 9 9 0 0118 0"></path>
		</svg>
		<span class="task-list-title">Personality</span>
	</a>
	<a class="task-list-row" data-nav-base="/settings/workers" href={ templ.SafeURL("/settings/workers?project_id=" + url.QueryEscape(currentProjectID)) } hx-get={ "/settings/workers?project_id=" + url.QueryEscape(currentProjectID) } hx-target="#main-content" hx-push-url="true">
		<svg xmlns="http://www.w3.org/2000/svg" class="h-4 w-4 shrink-0" fill="none" viewBox="0 0 24 24" stroke="currentColor">
			<path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M10.325 4.317c.426-1.756 2.924-1.756 3.35 0a1.724 1.724 0 002.573 1.066c1.543-.94 3.31.826 2.37 2.37a1.724 1.724 0 001.066 2.573c1.756.426 1.756 2.924 0 3.35a1.724 1.724 0 00-1.066 2.573c.94 1.543-.826 3.31-2.37 2.37a1.724 1.724 0 00-2.573 1.066c-.426 1.756-2.924 1.756-3.35 0a1.724 1.724 0 00-2.573-1.066c-1.543.94-3.31-.826-2.37-2.37a1.724 1.724 0 00-1.066-2.573c-1.756-.426-1.756-2.924 0-3.35a1.724 1.724 0 001.066-2.573c-.94-1.543.826-3.11 2.37-2.37.996.608 2.296.07 2.572-1.065z"></path>
			<path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M15 12a3 3 0 11-6 0 3 3 0 016 0z"></path>
		</svg><span class="task-list-title">Worker limits</span>
	</a>
}
