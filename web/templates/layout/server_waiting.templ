package layout

import "github.com/openvibely/openvibely/internal/models"

// ServerWaiting stands in for a saved server's project page while that server
// is not connected, and reloads the page once it is.
templ ServerWaiting(projects []models.Project, currentProjectID, serverName string) {
	@Base(serverName, projects, currentProjectID) {
		@ServerWaitingContent(serverName)
	}
}

templ ServerWaitingContent(serverName string) {
	<div id="server-waiting" class="flex h-full flex-col items-center justify-center gap-3 text-center" data-server-waiting>
		@PageTitle(serverName)
		<span class="loading loading-spinner loading-md opacity-60" aria-hidden="true"></span>
		<p class="font-medium" role="status">Connecting to { serverName }…</p>
		<p class="text-sm opacity-60">This project opens as soon as { serverName } is reachable.</p>
		<a class="link text-sm opacity-60" href="/servers" hx-get="/servers" hx-target="#main-content" hx-push-url="true">Servers settings</a>
		<script>
			(function() {
				var root = document.getElementById('server-waiting');
				function reload() {
					window.removeEventListener('openvibely-servers-changed', reload);
					if (!document.body.contains(root)) return;
					window.openVibelyNavigate(location.pathname + location.search + location.hash, 'false').catch(function() {});
				}
				window.addEventListener('openvibely-servers-changed', reload);
			})();
		</script>
	</div>
}

templ RepositoryWaiting(projects []models.Project, currentProjectID string) {
 @Base("Loading project", projects, currentProjectID) {
  @RepositoryWaitingContent()
 }
}

templ RepositoryWaitingContent() {
 <div class="flex h-full flex-col items-center justify-center gap-3 text-center" data-repository-waiting>
  @PageTitle("Loading project")
  <span class="loading loading-spinner loading-md opacity-60" aria-hidden="true"></span>
  <p class="font-medium" role="status">Loading repository information…</p>
  <p class="text-sm opacity-60">Your project opens when its repository information is ready.</p>
  <script>
   (function() {
    var root = document.querySelector('[data-repository-waiting]');
    var timer;
    function reload() {
     clearTimeout(timer);
     window.removeEventListener('openvibely-servers-changed', reload);
     if (!document.body.contains(root)) return;
     window.openVibelyNavigate(location.pathname + location.search + location.hash, 'false').catch(function() {});
    }
    window.addEventListener('openvibely-servers-changed', reload);
    timer = setTimeout(reload, 3000);
   })();
  </script>
 </div>
}
