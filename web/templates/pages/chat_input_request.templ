package pages

import (
	"fmt"

	"github.com/openvibely/openvibely/internal/events"
	"github.com/openvibely/openvibely/internal/models"
)

const chatInputOptionClass = "chat-input-option-btn card bg-base-100 shadow-sm border border-base-300 cursor-pointer hover:border-primary/40 hover:shadow-md transition-all flex items-start justify-start h-auto min-h-0 w-full px-4 py-3 text-left normal-case"

func chatInputRequestsForExec(requests []*events.ChatInputRequestEvent, execID string) []*events.ChatInputRequestEvent {
	var out []*events.ChatInputRequestEvent
	for _, req := range requests {
		if req != nil && !req.Completed && req.ExecID == execID {
			out = append(out, req)
		}
	}
	return out
}

func chatInputRequestsWithoutExec(requests []*events.ChatInputRequestEvent, history []models.Execution) []*events.ChatInputRequestEvent {
	shown := make(map[string]bool, len(history))
	for _, exec := range history {
		shown[exec.ID] = true
	}
	var out []*events.ChatInputRequestEvent
	for _, req := range requests {
		if req != nil && !req.Completed && !shown[req.ExecID] {
			out = append(out, req)
		}
	}
	return out
}

func pendingChatInputRequests(requests []*events.ChatInputRequestEvent) []*events.ChatInputRequestEvent {
	return chatInputRequestsWithoutExec(requests, nil)
}

func chatInputQuestionClass(index int) string {
	if index == 0 {
		return "space-y-2"
	}
	return "space-y-2 hidden"
}

func chatInputQuestionLegend(q events.ChatInputRequestQuestion, index int) string {
	if q.Question != "" {
		return q.Question
	}
	return fmt.Sprintf("Question %d", index+1)
}

// ChatInputRequestCard is hx-preserve so transcript swaps keep the live card and its unsubmitted picks.
templ ChatInputRequestCard(req *events.ChatInputRequestEvent) {
	<section
		id={ "chat-input-request-" + req.ID }
		class="chat-input-request-card card shadow-lg"
		data-chat-input-request-id={ req.ID }
		data-chat-input-exec-id={ req.ExecID }
 data-project-id={ req.ProjectID }
 data-chat-input-installation={ string(req.Installation) }
		data-current-question-index="0"
		aria-label="Input requested"
		hx-preserve="true"
	>
		<div class="card-body gap-4 p-4">
 if len(req.Installation)>0 {
<section data-skill-dependency-details="true"></section>
}
			for i, q := range req.Questions {
				<fieldset class={ chatInputQuestionClass(i) } data-chat-input-question-id={ q.ID } data-chat-input-question-index={ fmt.Sprintf("%d", i) }>
					<legend class="text-xl font-semibold leading-snug">{ chatInputQuestionLegend(q, i) }</legend>
					for j, opt := range q.Options {
						<div class={ chatInputOptionClass } style="--btn-focus-scale: 1" role="button" tabindex="0" data-chat-input-option="true" data-question-id={ q.ID } data-option-label={ opt.Label } aria-pressed="false">
							<span class="flex min-w-0 flex-col items-start">
								<span class="flex min-w-0 flex-wrap items-center gap-2">
									<span class="font-medium">{ opt.Label }</span>
									if j == 0 && len(req.Installation)==0 {
										<span class="chat-input-recommended-badge">Recommended</span>
									}
								</span>
								<span class="text-xs opacity-70 whitespace-normal">{ opt.Description }</span>
							</span>
						</div>
					}
if len(req.Installation)==0 {
					<div class={ chatInputOptionClass } style="--btn-focus-scale: 1" role="button" tabindex="0" data-chat-input-option="true" data-chat-input-custom-option="true" data-question-id={ q.ID } aria-pressed="false">Something else</div>
					<div class="hidden space-y-2 rounded-lg border border-base-300/70 p-3" data-chat-input-custom-wrap="true">
						<textarea class="textarea textarea-bordered min-h-20 w-full" maxlength="2000" placeholder="Type your answer" data-chat-input-custom-answer="true" aria-label="Custom answer"></textarea>
					</div>
}

				</fieldset>
			}
if len(req.Installation)==0 {
			<div class="pt-1" data-chat-input-recommended-actions="true">
				<div class="chat-input-option-btn chat-input-recommended-shortcut card bg-primary shadow-sm border border-primary cursor-pointer hover:shadow-md hover:border-primary transition-all inline-flex items-center justify-start h-auto min-h-0 w-fit max-w-full px-4 py-2 text-left font-normal normal-case" style="--btn-focus-scale: 1" role="button" tabindex="0" data-chat-input-nav="recommended" aria-label="Use recommended answers and continue">Recommended and move forward</div>
			</div>
			<div class="flex justify-end text-sm text-base-content/60" data-chat-input-navigation="true">
				<div class="flex items-center gap-2" data-chat-input-pager="true">
					<span class="min-w-12 px-2 text-center" data-chat-input-position="true">1 of { fmt.Sprintf("%d", len(req.Questions)) }</span>
					<button type="button" class="btn btn-ghost btn-sm" data-chat-input-nav="previous" aria-label="Previous question">Previous</button>
					<button type="button" class="btn btn-primary btn-sm" data-chat-input-nav="next" aria-label="Next question">Next</button>
				</div>
			</div>
}

			<div class="text-sm font-medium hidden" role="status" aria-live="polite"></div>
		</div>
	</section>
}

templ ChatInputRequestCards(requests []*events.ChatInputRequestEvent) {
	for _, req := range pendingChatInputRequests(requests) {
		@ChatInputRequestCard(req)
	}
}
