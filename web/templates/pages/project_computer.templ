package pages

import (
 "github.com/openvibely/openvibely/internal/models"
 "github.com/openvibely/openvibely/web/templates/layout"
 "github.com/openvibely/openvibely/web/static"
)

templ ProjectComputer(projects []models.Project, projectID string, taskIDs ...string) {
 @layout.Base("Computer", projects, projectID) {
  @ProjectComputerContent(projectID,taskIDs...)
 }
}

func computerTaskID(ids []string)string {if len(ids)>0{return ids[0]};return ""}

templ ProjectComputerContent(projectID string, taskIDs ...string) {
  <section id="project-computer" data-computer-task={computerTaskID(taskIDs)} data-computer-project={ projectID } data-computer-viewer={ static.URL("vendor/novnc/core/rfb.js") } class="p-4 flex flex-col gap-4">
   <div data-computer-preview style="position:relative">
 <div data-computer-screen class="bg-base-200 rounded-lg overflow-hidden" style="height:220px;min-height:180px"></div>
 <button type="button" data-computer-preview-open aria-label="Open larger computer preview" style="position:absolute;inset:0;width:100%;height:100%;cursor:zoom-in;background:transparent;border:0"></button>
 </div>
   if computerTaskID(taskIDs)=="" {
 <h1 class="text-xl font-bold">Project computer</h1>
 } else {
 <h3 class="font-semibold">Computer</h3>
 }
   if computerTaskID(taskIDs)=="" {
 <p class="text-sm opacity-70">The computer starts automatically. Each saved task has its own desktop on the Computer tab.</p>
 }
   @ProjectComputerToggle(projectID)
 <details data-computer-grants><summary class="cursor-pointer">Chrome permissions</summary><button type="button" class="btn" data-computer-grants-refresh>Refresh permissions</button><div data-computer-grant-list></div><nav aria-label="Chrome permissions pages"><button type="button" class="btn btn-sm" data-computer-grants-previous disabled>Previous</button><span data-computer-grants-page></span><button type="button" class="btn btn-sm" data-computer-grants-next disabled>Next</button></nav></details>
 <button type="button" class="btn btn-sm" data-computer-action="ensure" hidden>Retry connection</button>
   if computerTaskID(taskIDs)!="" {
 <label>Run standard shell and file tools in
 <select class="select select-bordered" data-computer-target><option value="worktree">Task worktree</option><option value="computer">Task computer</option></select></label>
 <p class="text-sm">Applies on the next task turn. Git commands follow the shell selection.</p>
 <details data-computer-jobs><summary class="cursor-pointer">Commands and live output</summary><div data-computer-job-list></div></details>
 <details data-computer-files>
 <summary class="cursor-pointer">Files</summary>
 <p class="text-sm">Take over to upload or download files (up to 25 MB). Existing files are kept.</p>
 <label>Folder in Files <input class="input input-bordered" data-computer-folder placeholder="Leave empty for Files"/></label>
 <button type="button" class="btn" data-computer-files-refresh>Show files</button>
 <label>Upload file <input type="file" data-computer-upload/></label>
 <div data-computer-file-list></div>
 </details>
 }
 <div data-computer-login hidden class="p-3 bg-base-200 rounded-lg">
 <p data-computer-login-site></p>
 <p class="text-sm">Complete the requested step privately. Done checks access and resumes this task. If needed, your task model checks a screenshot.</p>
 <button type="button" class="btn" data-computer-chrome>Choose Chrome sign-ins</button>
 <div data-computer-chrome-form hidden>
 <p class="text-sm">Choose individual cookies from one or more profiles. macOS may ask for Keychain access. Task grants stay with this task; project grants can be used by other tasks in this project.</p>
 <label>Chrome profile <select class="select select-bordered" data-computer-profile></select></label>
 <label>Access <select class="select select-bordered" data-computer-grant-scope><option value="task">This task</option><option value="project">This project</option></select></label>
 <label>Expires <select class="select select-bordered" data-computer-grant-hours><option value="-1">One import for this task (1 hour)</option><option value="1" selected>1 hour</option><option value="24">1 day</option><option value="168">7 days</option><option value="720">30 days</option><option value="0">Until revoked</option></select></label>
 <p data-computer-selection-count></p>
 <div data-computer-sites style="max-height:180px;overflow:auto"></div>
 <button type="button" class="btn btn-primary" data-computer-import>Approve selected sign-ins</button>
 </div>
 <button type="button" class="btn" data-computer-action="login-done">Done — resume task</button>
 <button type="button" class="btn" data-computer-action="login-cancel">Decline request</button>
 </div>
 <p role="status" aria-live="polite" data-computer-status>Checking computer…</p>
   <dialog data-computer-dialog aria-label="Live computer screen" class="bg-base-100 text-base-content" style="position:fixed;inset:0;width:100vw;max-width:100vw;height:100dvh;max-height:100dvh;margin:0;padding:0;border:0;border-radius:0;overflow:hidden"><header style="display:flex;justify-content:flex-end;height:52px;flex-shrink:0;padding:8px 16px;align-items:center"><button type="button" class="btn btn-ghost btn-sm" data-computer-clipboard disabled>Copy clipboard</button><button type="button" class="btn btn-ghost btn-sm" data-teach-open>Teach a task</button><button type="button" class="btn btn-ghost btn-sm btn-square" data-computer-close aria-label="Exit fullscreen" title="Exit fullscreen"><svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.7" aria-hidden="true"><path d="M4 9h5V4m11 5h-5V4M4 15h5v5m11-5h-5v5"></path></svg></button></header><div data-computer-teach hidden style="max-height:40vh;overflow:auto;padding:12px">
 <p>Demonstrate the task, then review the steps and captures before generating a workflow. Typed values are omitted. Pause before entering private information.</p>
 <label>Goal <input class="input input-bordered" data-teach-goal maxlength="2000"/></label>
 <button type="button" class="btn btn-sm" data-teach-record>Record steps</button>
 <label>Describe a step <input class="input input-bordered" data-teach-note maxlength="1500"/></label>
 <label><input type="checkbox" data-teach-auto/>Automatically capture screen changes while recording</label>
 <button type="button" class="btn btn-sm" data-teach-capture>Capture step</button>
 <ol data-teach-steps></ol><div data-teach-images></div>
 <button type="button" class="btn btn-sm" data-teach-discard>Discard</button>
 <button type="button" class="btn btn-sm" data-teach-save>Generate workflow</button>
 <p role="status" data-teach-status></p><pre data-teach-output hidden style="max-height:160px;overflow:auto;white-space:pre-wrap"></pre>
 <div data-teach-draft hidden><label>Workflow name <input class="input input-bordered" data-workflow-name maxlength="200"/></label><label>Instructions <textarea class="textarea textarea-bordered" data-workflow-instructions maxlength="30000" style="width:100%;height:160px"></textarea></label><button type="button" class="btn btn-sm" data-workflow-save>Save reusable workflow</button></div>
 <details data-workflows><summary>Saved workflows</summary><div data-workflow-list></div></details>
 </div><div data-computer-expanded></div></dialog>
   <style>
    [data-computer-dialog][open] { display:flex; flex-direction:column; }
    [data-computer-expanded] { display:flex; flex-direction:column; flex:1; min-height:0; }
    [data-computer-expanded] [data-computer-screen] { flex:1; min-height:0 !important; height:auto !important; border-radius:0; background:#111; }
    [data-computer-expanded] [data-computer-status] { position:absolute; bottom:16px; left:50%; transform:translateX(-50%); z-index:3; padding:6px 12px; border-radius:8px; background:var(--fallback-b1,oklch(var(--b1))); font-size:12px; pointer-events:none; }
    [data-computer-expanded] [data-computer-files] { max-height:30vh; overflow:auto; flex-shrink:0; }
    [data-computer-expanded] [data-computer-login] { max-height:35vh; overflow:auto; flex-shrink:0; }
   </style>
   <script>
    (function(){
     const root=document.getElementById('project-computer');
     if(!root || root.dataset.bound) return;
     root.dataset.bound='true';
     const base='/projects/'+encodeURIComponent(root.dataset.computerProject)+'/computer';
     const viewerID=crypto.randomUUID();
     const scoped=path=>base+path+'?viewer_id='+viewerID+(root.dataset.computerTask?'&task_id='+encodeURIComponent(root.dataset.computerTask):'');
     const dialog=root.querySelector('[data-computer-dialog]');
     const homes=[];
     const expand=root.querySelector('[data-computer-preview-open]');
     function openViewer(){if(closing)return;if(dialog.open){takeoverRequested=true;refresh();return;}takeoverRequested=true;for(const node of [root.querySelector('[data-computer-status]'),root.querySelector('[data-computer-login]'),root.querySelector('[data-computer-files]'),screen].filter(Boolean)){const mark=document.createComment('computer-home');node.before(mark);homes.push([mark,node]);dialog.querySelector('[data-computer-expanded]').append(node);}screen.style.height='70vh';dialog.showModal();refresh();}
     root.querySelector('[data-computer-preview-open]').onclick=openViewer;
     root.querySelector('[data-computer-close]').onclick=()=>{dialog.close();finishViewer();};
     dialog.addEventListener('close',finishViewer);
     async function finishViewer(){if(savingDemo)teachNote.textContent="Generation cancelled. Your demonstration is preserved.";generationAbort?.abort();if(closing || !homes.length)return;takeoverRequested=false;closing=true;recording=false;renderDemo();disconnect(true);for(const [mark,node] of homes)mark.replaceWith(node);homes.length=0;screen.style.height='220px';expand.focus();try{if(controlPromise)await controlPromise;const res=await fetch(scoped('/status'),{cache:'no-store'});if(!res.ok)throw Error('Could not check computer control. Reopen the viewer and try exiting again.');const state=await res.json();if((state.held||state.takeover_pending)&&!state.handoff_kind){const released=await fetch(scoped('/release'),{method:'POST'});if(!released.ok)throw Error('Could not return computer control. Reopen the viewer and try exiting again.');}}catch(e){status.textContent=e.message;return;}finally{closing=false;}await refresh();return true;}
     const status=root.querySelector('[data-computer-status]');
     const screen=root.querySelector('[data-computer-screen]');
     const buttons=[...root.querySelectorAll('[data-computer-action]')];
     let rfb=null, mode='', pending=false, generation=0, closed=false, refreshVersion=0, attemptedStart=false, takeoverRequested=false, closing=false, controlPromise=null, retained=null, frameTimer=null;
     const clipboardButton=root.querySelector('[data-computer-clipboard]');
     const teach=root.querySelector('[data-computer-teach]');
     const teachNote=root.querySelector('[data-teach-status]');
     let previousCapture=null;
     let connected=false, connectionMessage='', currentState=null, inViewport=true, clipboard='', ime=null, composing=false, pasteShift=false, recording=false, steps=[], images=[], savingDemo=false, generationAbort=null, workflowID="";
     function inputActive(){return connected && mode==='control' && dialog.open && !document.hidden && !closing;}
     function reportConnection(){
      if(!currentState?.ready)return;
      status.textContent=connected?(mode==='control'?'You have control. This task’s computer tools are paused.':currentState.busy?'An agent is using the computer.':'Ready'):(connectionMessage||'Connecting to the desktop…');
     }
     function visible(){const rect=root.querySelector('[data-computer-preview]').getBoundingClientRect();return !document.hidden && (dialog.open || (inViewport && root.getClientRects().length>0 && rect.bottom>0 && rect.right>0 && rect.top<window.innerHeight && rect.left<window.innerWidth));}
     function chord(key,code,{ctrl=false,shift=false,alt=false}={}){
      if(!inputActive())return;
      for(const [sym,name] of [[0xffeb,'MetaLeft'],[0xffec,'MetaRight'],[0xffe3,'ControlLeft'],[0xffe4,'ControlRight'],[0xffe1,'ShiftLeft'],[0xffe2,'ShiftRight'],[0xffe9,'AltLeft'],[0xffea,'AltRight']])rfb.sendKey(sym,name,false);
      const mods=[...(ctrl?[[0xffe3,'ControlLeft']]:[]),...(shift?[[0xffe1,'ShiftLeft']]:[]),...(alt?[[0xffe9,'AltLeft']]:[])];
      for(const [sym,name] of mods)rfb.sendKey(sym,name,true);
      rfb.sendKey(key,code,true);rfb.sendKey(key,code,false);
      for(const [sym,name] of mods.reverse())rfb.sendKey(sym,name,false);
     }
     function commitText(text){if(!inputActive()||!text)return;for(const char of text){const point=char.codePointAt(0);rfb.sendKey(point<=255?point:0x01000000+point,null,true);rfb.sendKey(point<=255?point:0x01000000+point,null,false);}addStep('Type [user-provided value] into the focused field.');}
     function focusKeyboard(){if(inputActive())ime?.focus({preventScroll:true});}
     function installKeyboard(){
      ime?.remove();ime=document.createElement('textarea');ime.setAttribute('aria-label','Remote computer keyboard');ime.autocomplete='off';ime.spellcheck=false;ime.setAttribute('autocapitalize','off');ime.style.cssText='position:absolute;left:0;bottom:0;width:1px;height:1px;opacity:0;resize:none';screen.append(ime);
      ime.addEventListener('compositionstart',()=>{composing=true});
      ime.addEventListener('compositionend',()=>{composing=false;queueMicrotask(()=>{if(ime){commitText(ime.value);ime.value=''}})});
      ime.addEventListener('input',()=>{if(!composing){commitText(ime.value);ime.value=''}});
      focusKeyboard();
     }
     const specialKeys={Enter:0xff0d,Tab:0xff09,Escape:0xff1b,Backspace:0xff08,Delete:0xffff,ArrowLeft:0xff51,ArrowUp:0xff52,ArrowRight:0xff53,ArrowDown:0xff54,Home:0xff50,End:0xff57,PageUp:0xff55,PageDown:0xff56,Insert:0xff63};
     screen.addEventListener('keydown',e=>{
      if(!inputActive()||e.isComposing||composing)return;
      if(['Control','Meta','Alt','Shift'].includes(e.key))return;
      const command=e.ctrlKey||(['Mac','iPhone','iPad'].some(name=>navigator.platform.includes(name))&&e.metaKey),letter=e.key.toLowerCase();
      if(command&&letter==='v'){pasteShift=e.shiftKey;e.stopImmediatePropagation();focusKeyboard();return;}
      const symbol=specialKeys[e.key]||(['F1','F2','F3','F4','F5','F6','F7','F8','F9','F10','F11','F12'].includes(e.key)?0xffbd+Number(e.key.slice(1)):null);
      if(symbol||command||e.altKey){e.preventDefault();e.stopImmediatePropagation();const key=symbol||(e.key.length===1?e.key.codePointAt(0):null);if(key)chord(key,e.code,{ctrl:command,shift:e.shiftKey,alt:e.altKey});addStep(symbol?'Press '+e.key+'.':'Use a keyboard shortcut.');return;}
      if(e.target===ime)e.stopImmediatePropagation();
     },true);
     screen.addEventListener('paste',e=>{if(!inputActive())return;e.preventDefault();e.stopImmediatePropagation();const text=e.clipboardData?.getData('text/plain');if(text){rfb.clipboardPasteFrom(text);chord(0x76,'KeyV',{ctrl:true,shift:pasteShift});addStep('Paste [user-provided value] into the focused field.');}pasteShift=false;if(ime)ime.value='';},true);
     screen.addEventListener('focusin',e=>{if(e.target.tagName==='CANVAS')queueMicrotask(focusKeyboard)});
     screen.addEventListener('pointerup',e=>{if(e.target.tagName!=='CANVAS'||!inputActive())return;const r=e.target.getBoundingClientRect();addStep((e.button===2?'Right-click':'Click')+' at '+Math.round((e.clientX-r.left)*e.target.width/r.width)+', '+Math.round((e.clientY-r.top)*e.target.height/r.height)+' (locate the current semantic target).');queueMicrotask(focusKeyboard);},true);
     screen.addEventListener('wheel',e=>{if(inputActive())addStep('Scroll '+(e.deltaY<0?'up':'down')+'.')},{passive:true,capture:true});
     clipboardButton.onclick=async()=>{if(!inputActive()||!clipboard)return;try{await navigator.clipboard.writeText(clipboard);status.textContent='Remote clipboard copied.';}catch{status.textContent='Clipboard access was denied by your browser.';}};
     function renderDemo(){
      root.querySelector('[data-teach-record]').textContent=recording?'Pause recording':'Record steps';
      const list=root.querySelector('[data-teach-steps]');list.replaceChildren();steps.forEach((step,i)=>{const row=document.createElement('li');const text=document.createElement('textarea');text.value=step;text.maxLength=2000;text.setAttribute('aria-label','Step '+(i+1));text.onchange=()=>{steps[i]=text.value};const remove=document.createElement('button');remove.type='button';remove.textContent='Remove';remove.onclick=()=>{steps.splice(i,1);renderDemo()};row.append(text,remove);list.append(row)});
      const box=root.querySelector('[data-teach-images]');box.replaceChildren();images.forEach((image,i)=>{const item=document.createElement('span'),img=document.createElement('img'),remove=document.createElement('button');img.src='data:image/jpeg;base64,'+image;img.alt='Capture '+(i+1);img.style.cssText='width:120px;height:80px;object-fit:contain';remove.type='button';remove.textContent='Remove capture '+(i+1);remove.onclick=()=>{images.splice(i,1);renderDemo()};item.append(img,remove);box.append(item)});
     }
     function addStep(text,manual=false){if((!recording&&!manual)||!inputActive()||currentState?.handoff_kind||savingDemo)return;if(steps.length>=100){recording=false;teachNote.textContent='100 steps recorded. Review and save or discard.';renderDemo();return;}if(!manual&&steps.at(-1)===text)return;steps.push(text);renderDemo();}
     root.querySelector('[data-teach-open]').onclick=()=>{teach.hidden=!teach.hidden;loadWorkflows().catch(e=>teachNote.textContent=e.message)};
     root.querySelector('[data-teach-record]').onclick=()=>{if(!inputActive()||currentState?.handoff_kind){teachNote.textContent='Wait for control and finish any private request first.';return;}recording=!recording;previousCapture=null;teachNote.textContent=recording?'Recording actions. Typed and pasted values are omitted. Screenshots follow your automatic capture setting; you can also Capture step.':'Recording paused.';renderDemo()};
     function captureScreen(note){
      if(!inputActive()||currentState?.handoff_kind||savingDemo)return false;
      const source=screen.querySelector('canvas:not([data-retained-frame])');
      if(!source?.width||retained)return false;
      if(images.length>=32||steps.length>=100){recording=false;renderDemo();teachNote.textContent='Capture limit reached. Review or remove captures to continue.';return false;}
      const canvas=document.createElement('canvas'),scale=Math.min(1,1280 * Math.pow(Math.max(source.width,source.height),-1));canvas.width=Math.round(source.width*scale);canvas.height=Math.round(source.height*scale);canvas.getContext('2d').drawImage(source,0,0,canvas.width,canvas.height);images.push(canvas.toDataURL('image/jpeg',.72).split(',')[1]);addStep('Capture: '+note,true);return true;
     }
     root.querySelector('[data-teach-capture]').onclick=()=>{const note=root.querySelector('[data-teach-note]');if(!note.value.trim()){teachNote.textContent='Describe the step before capturing it.';return;}if(captureScreen(note.value.trim())){note.value='';teachNote.textContent='Review the capture before generating.';}};
     const autoCaptureTimer=setInterval(()=>{
      if(!recording||!root.querySelector('[data-teach-auto]').checked||!inputActive()||currentState?.handoff_kind||savingDemo||retained){previousCapture=null;return;}
      const source=screen.querySelector('canvas:not([data-retained-frame])');if(!source?.width)return;
      const thumbnail=document.createElement('canvas');thumbnail.width=32;thumbnail.height=18;const ctx=thumbnail.getContext('2d');ctx.drawImage(source,0,0,32,18);const pixels=ctx.getImageData(0,0,32,18).data;let delta=0;
      if(previousCapture)for(let i=0;i<pixels.length;i+=4)delta+=Math.abs(pixels[i]-previousCapture[i])+Math.abs(pixels[i+1]-previousCapture[i+1])+Math.abs(pixels[i+2]-previousCapture[i+2]);
      if(previousCapture&&delta<32*18*3*12)return;
      if(captureScreen('Screen changed at '+new Date().toLocaleTimeString())){previousCapture=pixels.slice();teachNote.textContent='Capturing changed screens. Review captures before generating.';}
     },1200);
     root.querySelector('[data-teach-discard]').onclick=()=>{generationAbort?.abort();root.querySelector('[data-teach-output]').textContent='';root.querySelector('[data-teach-output]').hidden=true;workflowID='';recording=false;previousCapture=null;steps=[];images=[];root.querySelector('[data-teach-draft]').hidden=true;renderDemo();teachNote.textContent='Demonstration discarded.';};
     root.querySelector('[data-teach-save]').onclick=async e=>{
      const goal=root.querySelector('[data-teach-goal]').value.trim();if(!goal||!steps.length){teachNote.textContent='Add a goal and at least one step.';return;}
      if(!inputActive()||currentState?.handoff_kind||savingDemo){teachNote.textContent='Wait for control and finish any private request first.';return;}
      recording=false;renderDemo();savingDemo=true;const controller=new AbortController();generationAbort=controller;const output=root.querySelector('[data-teach-output]');output.textContent='';output.hidden=false;root.querySelector('[data-teach-draft]').hidden=true;e.target.disabled=true;teachNote.textContent='Generating workflow with your configured model…';
      try{const res=await fetch(scoped('/teach'),{method:'POST',signal:controller.signal,headers:{'Content-Type':'application/json','Accept':'application/x-ndjson'},body:JSON.stringify({goal,steps,images})});if(!res.ok){const error=await res.json();throw Error(error.message||'Could not generate workflow');}const reader=res.body.getReader(),decoder=new TextDecoder();let buffer='',data=null;while(true){const {value,done}=await reader.read();buffer+=decoder.decode(value||new Uint8Array(),{stream:!done});let at;while((at=buffer.indexOf('\n'))>=0){const line=buffer.slice(0,at);buffer=buffer.slice(at+1);if(!line.trim())continue;const item=JSON.parse(line);if(item.error)throw Error(item.error);if(item.text){output.textContent+=item.text;output.scrollTop=output.scrollHeight;}if(item.draft)data=item.draft;}if(done)break;}if(controller.signal.aborted)return;if(!data)throw Error('No workflow returned. Your demonstration is preserved.');workflowID='';root.querySelector('[data-workflow-name]').value=data.name;root.querySelector('[data-workflow-instructions]').value=data.instructions;root.querySelector('[data-teach-draft]').hidden=false;teachNote.textContent='Review and edit the workflow before saving. Your demonstration is still here.';}catch(e){if(e.name!=='AbortError')teachNote.textContent=e.message;}finally{if(generationAbort===controller)generationAbort=null;savingDemo=false;e.target.disabled=false;}
     };
     async function workflowAction(body){const res=await fetch(scoped('/workflows'),{method:'POST',headers:{'Content-Type':'application/json'},body:JSON.stringify(body)});const data=await res.json();if(!res.ok)throw Error(data.message||'Workflow operation failed');return data;}
     root.querySelector('[data-workflow-save]').onclick=async e=>{e.target.disabled=true;try{await workflowAction({action:'save',id:workflowID,name:root.querySelector('[data-workflow-name]').value,instructions:root.querySelector('[data-workflow-instructions]').value});root.querySelector('[data-teach-draft]').hidden=true;teachNote.textContent='Reusable workflow saved.';await loadWorkflows();}catch(e){teachNote.textContent=e.message;}finally{e.target.disabled=false;}};
     async function loadWorkflows(){const res=await fetch(scoped('/workflows'),{cache:'no-store'});if(!res.ok)throw Error('Could not load workflows');const items=await res.json();const list=root.querySelector('[data-workflow-list]');list.replaceChildren();for(const item of items){const row=document.createElement('details'),title=document.createElement('summary'),instructions=document.createElement('pre');title.textContent=item.name;instructions.textContent=item.instructions;instructions.style.whiteSpace='pre-wrap';row.append(title,instructions);for(const [action,label] of [['edit','Edit workflow'],['use','Create task from workflow'],['delete','Delete workflow']]){const button=document.createElement('button');button.type='button';button.className='btn btn-sm';button.textContent=label;button.onclick=async()=>{if(action==='edit'){generationAbort?.abort();workflowID=item.id;root.querySelector('[data-workflow-name]').value=item.name;root.querySelector('[data-workflow-instructions]').value=item.instructions;root.querySelector('[data-teach-draft]').hidden=false;return;}button.disabled=true;try{const data=await workflowAction({action,id:item.id});if(action==='delete'){await loadWorkflows();return;}teachNote.replaceChildren(document.createTextNode('Backlog task created. '));const link=document.createElement('a');link.href=data.url;link.textContent='Review task';link.onclick=async event=>{if(event.metaKey||event.ctrlKey)return;event.preventDefault();dialog.close();if(await finishViewer())location.assign(data.url);};teachNote.append(link);}catch(e){teachNote.textContent=e.message;}finally{button.disabled=false;}};row.append(button);}list.append(row);}}
     function visibilityChanged(){if(!visible()){++refreshVersion;recording=false;renderDemo();disconnect();}else refresh();}
     document.addEventListener('visibilitychange',visibilityChanged);
     const viewportObserver=new IntersectionObserver(entries=>{inViewport=entries[0].isIntersecting;visibilityChanged()});viewportObserver.observe(root.querySelector('[data-computer-preview]'));
     // Keep the last painted desktop while the authorized stream changes modes.
     function retainFrame(){
      const source=screen.querySelector('canvas:not([data-retained-frame])');
      if(!source || !source.width || !source.height)return;
      const frame=document.createElement('canvas');frame.width=source.width;frame.height=source.height;
      try{const ctx=source.getContext('2d');if(![.25,.5,.75].some(v=>ctx.getImageData(Math.floor(source.width*v),Math.floor(source.height*v),1,1).data[3]))return;frame.getContext('2d').drawImage(source,0,0);}catch{return;}
      retained?.remove();retained=frame;frame.dataset.retainedFrame='';frame.setAttribute('aria-hidden','true');
      screen.style.position='relative';frame.style.cssText='position:absolute;inset:0;width:100%;height:100%;object-fit:contain;pointer-events:none;z-index:1;background:#111';
     }
     function revealFrame(epoch){
      clearTimeout(frameTimer);
      if(closed || epoch!==generation || !retained)return;
      const canvas=screen.querySelector('canvas:not([data-retained-frame])');
      if(canvas?.width && canvas?.height){try{if([.25,.5,.75].some(v=>canvas.getContext('2d').getImageData(Math.floor(canvas.width*v),Math.floor(canvas.height*v),1,1).data[3])){retained.remove();retained=null;return;}}catch{retained.remove();retained=null;return;}}
      frameTimer=setTimeout(()=>revealFrame(epoch),50);
     }
     async function viewer(held,state){
      held=held && dialog.open;
      const next=held?'control':'view';
      if(rfb && mode===next)return;
      disconnect(true);mode=next;
      const epoch=++generation;
      const {default:RFB}=await import(root.dataset.computerViewer);
      if(closed || epoch!==generation)return;
      const ws=new URL(state.stream_url || scoped('/stream/'+next),location.href);ws.protocol=ws.protocol==='https:'?'wss:':'ws:';
      rfb=new RFB(screen,ws.href,{wsProtocols:state.ticket?['binary',state.ticket]:['binary']});
      if(retained)screen.append(retained);
      rfb.qualityLevel=7;rfb.scaleViewport=true;rfb.resizeSession=false;rfb.viewOnly=!held;
      revealFrame(epoch);
      rfb.addEventListener('connect',()=>{if(epoch!==generation||closed)return;connected=true;connectionMessage='';reportConnection();if(held)installKeyboard();});
      rfb.addEventListener('clipboard',event=>{if(epoch!==generation||!inputActive())return;clipboard=event.detail.text;clipboardButton.disabled=!clipboard;if(document.hasFocus())navigator.clipboard?.writeText(clipboard).catch(()=>{status.textContent='Use Copy clipboard to copy the remote selection.';});});
      rfb.addEventListener('securityfailure',()=>{if(epoch===generation){connected=false;connectionMessage='Desktop authentication failed. Reconnecting…';reportConnection();}});
      rfb.addEventListener('disconnect',event=>{if(epoch===generation){connected=false;rfb=null;mode='';clipboard='';clipboardButton.disabled=true;recording=false;renderDemo();connectionMessage='Desktop disconnected. Reconnecting…';reportConnection();}});
     }
     function disconnect(preserve=false){++generation;connected=false;clipboard='';clipboardButton.disabled=true;ime?.remove();ime=null;composing=false;clearTimeout(frameTimer);if(preserve)retainFrame();if(rfb)rfb.disconnect();rfb=null;mode='';if(preserve && retained)screen.append(retained);else{retained?.remove();retained=null;}}
     async function refresh(){
      if(closed || pending || closing)return;
 if(!visible()){disconnect();return;}
      const version=++refreshVersion;
      try{
       const requestedControl=dialog.open;
       const res=await fetch(scoped('/status')+'&viewer_mode='+(requestedControl?'control':'view'),{cache:'no-store'});if(!res.ok)throw new Error('Could not check project computer');
       const state=await res.json();if(closed || pending || closing || !visible() || version!==refreshVersion)return;if(requestedControl!==dialog.open){await refresh();return;}currentState=state;if(state.handoff_kind){recording=false;renderDemo();}root.querySelector('[data-teach-open]').hidden=!!state.handoff_kind;if(state.handoff_kind)teach.hidden=true;
       if(state.enabled!==false && !state.ready && !attemptedStart){attemptedStart=true;pending=true;status.textContent='Starting project computer… The first start may take several minutes.';try{const started=await fetch(scoped('/ensure'),{method:'POST'});if(!started.ok){const data=await started.json();throw Error(data.message||'Could not start computer');}pending=false;await refresh();}catch(e){pending=false;status.textContent=e.message;root.querySelector('[data-computer-action=ensure]').hidden=false;}return;}
       if(state.ready && dialog.open && takeoverRequested){takeoverRequested=false;if(!state.held){pending=true;controlPromise=fetch(scoped('/takeover'),{method:'POST'});try{const response=await controlPromise;if(!response.ok)throw Error('Could not take control. Close and reopen the viewer to retry.');state.held=true;}finally{controlPromise=null;pending=false;}if(!dialog.open||closing)return;await refresh();return;}}
       status.textContent=state.ready?(state.held?'You have control. This task’s computer tools are paused.':state.busy?'An agent is using the computer.':'Ready'):state.enabled===false?'Project computer is disabled. Enable it below.':'Connecting to the computer…';
       root.querySelector('[data-computer-login]').hidden=!state.handoff_kind;
 root.querySelector('[data-computer-login-site]').textContent=state.handoff_kind?(state.handoff_reason||'Computer help requested')+(state.handoff_url?' — '+state.handoff_url:''):'';
 const target=root.querySelector('[data-computer-target]');if(target&&!pending)target.value=state.tool_target||'worktree';
 root.querySelector('[data-computer-chrome]').hidden=state.handoff_kind!=='request_chrome_login'||!state.chrome_available;
 buttons.forEach(b=>{const a=b.dataset.computerAction;if(a==='ensure')b.hidden=state.ready||state.enabled===false;b.disabled=a==='ensure'?state.enabled===false:a.startsWith('login-')?!state.handoff_kind:a==='release'?!state.held||!!state.handoff_kind:a==='takeover'?!state.ready||state.held:!state.ready||state.held||state.busy;});
       if(state.ready){await viewer(state.held,state);reportConnection();}else disconnect();
      }catch(e){status.textContent=e.message;}
     }
     root.addEventListener('click',async event=>{
      const button=event.target.closest('[data-computer-action]');if(!button || pending || button.disabled)return;
      pending=true;++refreshVersion;buttons.forEach(b=>b.disabled=true);disconnect();
      const action=button.dataset.computerAction;
      status.textContent=action==='ensure'?'Starting project computer. The first image build can take several minutes…':'Updating computer…';
      try{
       const res=await fetch(scoped('/'+action),{method:'POST',headers:{'Content-Type':'application/json'}});
       if(!res.ok){const body=await res.json();throw new Error(body.message||'Computer operation failed');}
       pending=false;await refresh();
      }catch(e){status.textContent=e.message;pending=false;buttons.forEach(b=>b.disabled=false);}
     });
     const fileList=root.querySelector('[data-computer-file-list]');
 const folder=root.querySelector('[data-computer-folder]');
 const fileURL=path=>{const url=new URL(scoped('/files'),location.href);url.searchParams.set('path',path);return url;};
 async function showFiles(){const res=await fetch(fileURL(folder.value),{cache:'no-store'});const data=await res.json();if(!res.ok)throw Error(data.message||'Files unavailable');fileList.replaceChildren();for(const item of data.entries||[]){const relative=item.path.replace(/^Files\/?/,'');const entry=document.createElement(item.directory?'button':'a');entry.textContent=item.name+(item.directory?'/':'');entry.className='block';if(item.directory){entry.type='button';entry.onclick=()=>{folder.value=relative;showFiles().catch(e=>status.textContent=e.message);};}else{entry.href=fileURL(relative);entry.download=item.name;}fileList.append(entry);if(!item.directory){const add=document.createElement('button');add.type='button';add.className='btn btn-sm';add.textContent='Add to task';add.onclick=async()=>{add.disabled=true;try{const url=new URL(scoped('/import-file'),location.href);url.searchParams.set('path',relative);const response=await fetch(url,{method:'POST'});const saved=await response.json();if(!response.ok)throw Error(saved.message||'Could not add file');add.textContent='Added';status.textContent='File added to task attachments.';document.body.dispatchEvent(new Event('taskAttachmentsChanged',{bubbles:true}));}catch(e){status.textContent=e.message;add.disabled=false;}};fileList.append(add);}}}
 if(fileList){root.querySelector('[data-computer-files-refresh]').onclick=()=>showFiles().catch(e=>status.textContent=e.message);root.querySelector('[data-computer-upload]').onchange=async event=>{const file=event.target.files[0];if(!file)return;if(file.size>25*1024*1024){status.textContent='Choose a file up to 25 MB.';return;}try{const path=(folder.value?folder.value.replace(/\/$/,'')+'/':'')+file.name;const res=await fetch(fileURL(path),{method:'PUT',body:file});if(!res.ok){const data=await res.json();throw Error(data.message||'Upload failed');}await showFiles();status.textContent='File uploaded.';}catch(e){status.textContent=e.message;}finally{event.target.value='';}};}
 const profile=root.querySelector('[data-computer-profile]');
 const sites=root.querySelector('[data-computer-sites]');

 const selectedCookies=new Map();let pendingImport="";
 const cookieKey=c=>JSON.stringify([c.profile,c.domain,c.name,c.path]);
 const updateSelection=()=>root.querySelector('[data-computer-selection-count]').textContent=selectedCookies.size+' cookies selected across profiles';
 async function chromeSites(){sites.replaceChildren();const url=new URL(scoped('/chrome'),location.href);url.searchParams.set('profile',profile.value);const res=await fetch(url,{cache:'no-store'});const data=await res.json();if(!res.ok)throw Error(data.message||'Could not load Chrome cookies');for(const cookie of data.cookies){const label=document.createElement('label');label.style.display='block';const check=document.createElement('input');check.type='checkbox';const key=cookieKey(cookie);check.checked=selectedCookies.has(key);check.onchange=()=>{if(check.checked)selectedCookies.set(key,cookie);else selectedCookies.delete(key);updateSelection();};label.append(check,document.createTextNode(' '+cookie.domain+' — '+cookie.name+' ('+cookie.path+')'));sites.append(label);}}
 profile.onchange=()=>chromeSites().catch(e=>status.textContent=e.message);
 root.querySelector('[data-computer-chrome]').onclick=async()=>{try{const res=await fetch(scoped('/chrome'),{cache:'no-store'});const data=await res.json();if(!res.ok)throw Error(data.message||'Chrome profiles unavailable');pendingImport=data.pending_import?.id||'';if(pendingImport){status.textContent='An approved import is incomplete. Retry to resume remaining profiles.';root.querySelector('[data-computer-import]').textContent='Resume approved import';}profile.replaceChildren();for(const name of data.profiles){profile.add(new Option(name,name));}root.querySelector('[data-computer-chrome-form]').hidden=false;updateSelection();if(profile.value)await chromeSites();}catch(e){status.textContent=e.message;}};
 root.querySelector('[data-computer-import]').onclick=async event=>{if(!pendingImport&&!selectedCookies.size){status.textContent='Select at least one cookie.';return;}event.target.disabled=true;pending=true;try{const res=await fetch(scoped('/chrome-import'),{method:'POST',headers:{'Content-Type':'application/json'},body:JSON.stringify({grant_id:pendingImport,scope:root.querySelector('[data-computer-grant-scope]').value,hours:Number(root.querySelector('[data-computer-grant-hours]').value),selections:[...selectedCookies.values()]})});const data=await res.json();if(!res.ok){if(data.grant_id){pendingImport=data.grant_id;root.querySelector('[data-computer-import]').textContent='Resume approved import';}throw Error(data.message||'Import failed');}pendingImport='';root.querySelector('[data-computer-import]').textContent='Approve selected sign-ins';status.textContent='Imported '+data.imported+' cookies. Check your sign-in, then select Done.';root.querySelector('[data-computer-chrome-form]').hidden=true;selectedCookies.clear();updateSelection();}catch(e){status.textContent=e.message;}finally{event.target.disabled=false;pending=false;}};
 const target=root.querySelector('[data-computer-target]');if(target)target.onchange=async()=>{target.disabled=true;try{const res=await fetch(scoped('/target-'+target.value),{method:'POST'});if(!res.ok)throw Error('Could not change tool destination');status.textContent='Tool destination saved for the next turn.';}catch(e){status.textContent=e.message;}finally{target.disabled=false;}};
 const grantList=root.querySelector('[data-computer-grant-list]');
 let grantOffset=0,grantPageVersion=0;
 const grantPrevious=root.querySelector('[data-computer-grants-previous]'),grantNext=root.querySelector('[data-computer-grants-next]');
 async function showGrants(offset=grantOffset){const version=++grantPageVersion;grantPrevious.disabled=true;grantNext.disabled=true;const res=await fetch(scoped('/chrome-grants')+'&offset='+offset,{cache:'no-store'});const data=await res.json();if(!res.ok)throw Error(data.message||'Permissions unavailable');if(version!==grantPageVersion)return;grantOffset=data.offset;grantPrevious.disabled=grantOffset===0;grantNext.disabled=!data.has_more;root.querySelector('[data-computer-grants-page]').textContent='Page '+(Math.floor(grantOffset/200)+1);grantList.replaceChildren();for(const grant of data.grants){const row=document.createElement('div');row.textContent=grant.scope+' — '+grant.selections.map(c=>c.profile+': '+c.domain+'/'+c.name).join(', ')+' — '+(grant.revoked?'Revoked':(grant.one_time?'One import — ':'')+(grant.expires_at?'Expires '+new Date(grant.expires_at*1000).toLocaleString():'Until revoked'));const button=document.createElement('button');button.className='btn btn-sm';button.textContent=grant.revoked?'Retry clearing cookies':'Revoke';button.onclick=async()=>{button.disabled=true;try{const response=await fetch(scoped('/chrome-grants'),{method:'POST',headers:{'Content-Type':'application/json'},body:JSON.stringify({grant_id:grant.id})});const data=await response.json();if(!response.ok)throw Error(data.message||'Could not revoke');await showGrants();}catch(e){status.textContent=e.message;}finally{button.disabled=false;}};row.append(button);grantList.append(row);}}
 if(grantList){root.querySelector('[data-computer-grants-refresh]').onclick=()=>showGrants(0).catch(e=>status.textContent=e.message);grantPrevious.onclick=()=>showGrants(Math.max(0,grantOffset-200)).catch(e=>status.textContent=e.message);grantNext.onclick=()=>showGrants(grantOffset+200).catch(e=>status.textContent=e.message);}
 const jobDetails=root.querySelector('[data-computer-jobs]');const jobList=root.querySelector('[data-computer-job-list]');let jobsPending=false;
 async function showJobs(){if(!jobDetails||!jobDetails.open||closed||jobsPending||!visible())return;jobsPending=true;try{const res=await fetch(scoped('/jobs'),{cache:'no-store'});if(!res.ok)return;const data=await res.json();if(closed)return;jobList.replaceChildren();for(const job of data.jobs){const label=document.createElement('p');label.textContent=job.job_id+' — '+(job.running?'Running':'Exited '+job.exit_code);const output=document.createElement('pre');output.style.cssText='max-height:240px;overflow:auto;white-space:pre-wrap';output.textContent=job.output;jobList.append(label,output);if(job.running){const stop=document.createElement('button');stop.className='btn btn-sm';stop.textContent='Stop command';stop.onclick=async()=>{stop.disabled=true;try{const res=await fetch(scoped('/jobs'),{method:'POST',headers:{'Content-Type':'application/json'},body:JSON.stringify({job_id:job.job_id})});if(!res.ok)throw Error('Could not stop command');await showJobs();}catch(e){status.textContent=e.message;}finally{stop.disabled=false;}};jobList.append(stop);}}}catch{}finally{jobsPending=false;}}
 if(jobDetails)jobDetails.addEventListener('toggle',showJobs);
 const jobTimer=setInterval(showJobs,1000);
 function changed(){attemptedStart=false;setTimeout(visibilityChanged,0);}
 document.addEventListener('computer-setting-changed',changed);
 document.addEventListener('computer-tab-change',changed);
 refresh();const timer=setInterval(refresh,5000);
     const observer=new MutationObserver(()=>{if(!root.isConnected){closed=true;clearInterval(autoCaptureTimer);viewportObserver.disconnect();document.removeEventListener('visibilitychange',visibilityChanged);document.removeEventListener('computer-setting-changed',changed);document.removeEventListener('computer-tab-change',changed);if(dialog.open)dialog.close();clearInterval(timer);clearInterval(jobTimer);disconnect();observer.disconnect();}});
     observer.observe(document.body,{childList:true,subtree:true});
    })();
   </script>
  </section>
 }

templ ProjectComputerToggle(projectID string) {
 <div data-computer-preference={projectID} class="mb-4">
 <label class="label cursor-pointer justify-start gap-2"><input type="checkbox" class="toggle toggle-sm" data-computer-enabled disabled/><span>Project computer</span></label>
 <p class="text-xs opacity-70">Enable for all tasks in this project. Starts automatically when used.</p>
 <label>Stop unused desktops after <select class="select select-bordered" data-computer-idle disabled><option value="15">15 minutes</option><option value="30">30 minutes</option><option value="60">1 hour</option><option value="120">2 hours</option><option value="0">Never</option></select></label>
 <p class="text-xs opacity-70">Active tasks, open viewers, private requests and running commands stay open. Idle shutdown keeps saved files and browser logins, but closes apps and loses unsaved work. Open the Computer tab to restart.</p>
 <label>Desktop time zone <select class="select select-bordered" data-computer-time-zone disabled><option value="UTC">UTC</option></select></label>
 <button type="button" class="btn btn-sm" data-computer-time-zone-restart>Apply to desktop</button>
 <p class="text-xs opacity-70">Saved for all task desktops in this project. Apply restarts the computer when idle; files are kept.</p>
 <p role="status" data-computer-preference-status></p>
 <script>
 (()=>{document.querySelectorAll('[data-computer-preference]').forEach(root=>{
 if(root.dataset.bound)return;root.dataset.bound='true';const box=root.querySelector('input'),status=root.querySelector('[role=status]');const base='/projects/'+encodeURIComponent(root.dataset.computerPreference)+'/computer';
 const idle=root.querySelector('[data-computer-idle]');
 idle.onchange=async()=>{idle.disabled=true;try{const res=await fetch(base+'/idle-timeout',{method:'POST',body:new URLSearchParams({idle_minutes:idle.value})});if(!res.ok){const data=await res.json();throw Error(data.message||'Could not save idle timeout');}status.textContent='Idle timeout saved for this project.';}catch(e){status.textContent=e.message;await load();}finally{idle.disabled=false;}};
 const zone=root.querySelector('[data-computer-time-zone]'),restart=root.querySelector('[data-computer-time-zone-restart]');
 for(const name of Intl.supportedValuesOf?.('timeZone')||[]){zone.add(new Option(name,name));}
 zone.onchange=async()=>{zone.disabled=true;restart.disabled=true;try{const res=await fetch(base+'/time-zone',{method:'POST',body:new URLSearchParams({time_zone:zone.value})});if(!res.ok){const data=await res.json();throw Error(data.message||'Could not save time zone');}status.textContent='Time zone saved. Apply when the computer is idle.';}catch(e){status.textContent=e.message;}finally{zone.disabled=false;restart.disabled=false;}};
 restart.onclick=async()=>{restart.disabled=true;zone.disabled=true;status.textContent='Applying desktop time zone…';try{const res=await fetch(base+'/start',{method:'POST'});if(!res.ok){const data=await res.json();throw Error(data.message||'Could not apply time zone');}status.textContent='Desktop time zone applied.';document.dispatchEvent(new CustomEvent('computer-setting-changed'));}catch(e){status.textContent=e.message;}finally{restart.disabled=false;zone.disabled=false;}};
 async function load(){try{const res=await fetch(base+'/status',{cache:'no-store'});if(!res.ok)throw Error('Could not load computer setting');const state=await res.json();box.checked=state.enabled!==false;box.disabled=false;const minutes=String(state.idle_minutes??30);if(![...idle.options].some(o=>o.value===minutes))idle.add(new Option(minutes+' minutes',minutes));idle.value=minutes;idle.disabled=false;const selected=state.time_zone||'UTC';if(![...zone.options].some(o=>o.value===selected))zone.add(new Option(selected,selected));zone.value=selected;zone.disabled=false;}catch(e){status.textContent=e.message;}}
 box.onchange=async()=>{box.disabled=true;try{const res=await fetch(base+'/'+(box.checked?'enable':'disable'),{method:'POST'});if(!res.ok){const data=await res.json();throw Error(data.message||'Could not save computer setting');}status.textContent='Saved for this project.';document.dispatchEvent(new CustomEvent('computer-setting-changed',{detail:{project:root.dataset.computerPreference}}));}catch(e){box.checked=!box.checked;status.textContent=e.message;}finally{box.disabled=false;}};load();
 });})();
 </script>
 </div>
}
