package pages

import (
 "github.com/openvibely/openvibely/internal/models"
 "github.com/openvibely/openvibely/web/templates/layout"
 "github.com/openvibely/openvibely/web/templates/components"
 "github.com/openvibely/openvibely/web/static"
 templateui "github.com/openvibely/openvibely/web/templates"
)

templ ProjectComputer(projects []models.Project, projectID string, taskIDs ...string) {
 @layout.Base("Computer", projects, projectID) {
  @ProjectComputerContent(projectID,taskIDs...)
 }
}

func computerTaskID(ids []string)string {if len(ids)>0{return ids[0]};return ""}

templ ProjectComputerContent(projectID string, taskIDs ...string) {
 @ComputerErrorReporter()
 if computerTaskID(taskIDs)!="" {
  <section id="project-computer" data-computer-task={computerTaskID(taskIDs)} data-computer-project={ projectID } data-computer-viewer={ static.URL("vendor/novnc/core/rfb.js") } class="flex flex-col gap-4 text-sm">
   <div data-computer-preview hidden style="position:relative">
 <div data-computer-screen tabindex="-1" aria-label="Computer screen" class="rounded-lg overflow-hidden outline-none" style="position:relative;aspect-ratio:16/10;width:100%;user-select:none;-webkit-user-select:none;background:var(--shell-card,var(--fallback-b1,oklch(var(--b1))))"></div>
 <button type="button" data-computer-preview-open aria-label="Open larger computer preview" style="position:absolute;inset:0;width:100%;height:100%;z-index:3;cursor:zoom-in;background:transparent;border:0"></button>
 </div>
 <h3 class="text-sm font-semibold">Computer</h3>
   @TaskComputerToggle(projectID, computerTaskID(taskIDs))
 @ProjectComputerPermissions(projectID, computerTaskID(taskIDs))
 <button type="button" class="btn btn-sm" data-computer-action="ensure" hidden>Retry connection</button>
 <div class="flex flex-col gap-2">
 <button type="button" class="inspector-property-row" data-computer-target data-value="worktree" aria-haspopup="dialog">
 @components.InspectorPropertyContent("Run tools in", "Task worktree")
 </button>
 @components.InspectorPicker("computer-target-picker") {
 <div data-options="target">
 <button type="button" data-value="worktree" class="ov-menu-option w-full">Task worktree</button>
 <button type="button" data-value="computer" class="ov-menu-option w-full">Task computer</button>
 </div>
 }

 </div>
 <div data-computer-login data-fullscreen-interactive hidden class="p-3 bg-base-200 rounded-lg">
 <p data-computer-login-site></p>
 <p class="text-sm">Complete the requested step privately. Done checks access and resumes this task. If needed, your task model checks a screenshot.</p>
 <button type="button" class="btn" data-computer-chrome>Choose Chrome sign-ins</button>
 <button type="button" class="btn" data-computer-action="login-done">Done — resume task</button>
 <button type="button" class="btn" data-computer-action="login-cancel">Decline request</button>
 </div>
 <dialog class="modal computer-import-modal" data-computer-import-dialog data-fullscreen-interactive aria-label="Import Chrome sign-ins">
 <div class="modal-box" data-computer-chrome-form hidden>
 <button type="button" class="btn btn-circle btn-ghost btn-xs ov-modal-close" data-computer-import-close aria-label="Close"><svg xmlns="http://www.w3.org/2000/svg" class="h-4 w-4" fill="none" viewBox="0 0 24 24" stroke="currentColor"><path stroke-linecap="round" stroke-width="2" d="M6 18L18 6M6 6l12 12"></path></svg></button>
 <h3>Import Chrome sign-ins</h3><p class="import-muted">Choose which cookies to share with this computer.</p>
 <label class="import-row">Chrome profile <select class="select select-bordered" data-computer-profile></select></label>
 <label class="import-row">Allow access for <select class="select select-bordered" data-computer-grant-scope><option value="task">This task</option><option value="project">This project</option></select></label>
 <label class="import-row">Expires <select class="select select-bordered" data-computer-grant-hours><option value="-1">One import for this task (1 hour)</option><option value="1" selected>1 hour</option><option value="24">1 day</option><option value="168">7 days</option><option value="720">30 days</option><option value="0">Until revoked</option></select></label>
 <h4>Cookies</h4><input type="search" class="input input-bordered" data-computer-cookie-search placeholder="Search sites or cookies…" aria-label="Search sites or cookies"/>
 <div data-computer-sites></div>
 <p class="import-muted">Your computer may ask you to unlock Chrome’s saved cookies.</p>
 <div class="import-actions"><button type="button" class="btn" data-computer-import-cancel>Cancel</button><button type="button" class="btn btn-primary" data-computer-import>Import selected</button></div>
 </div><form method="dialog" class="modal-backdrop"><button type="submit">close</button></form>
 </dialog>
 <style>
 .computer-import-modal > .modal-box{width:540px;max-width:calc(100vw - 2rem);font-size:13px}
 .computer-import-modal h3{font-size:18px;font-weight:500;margin:0 32px 12px 0}
 .computer-import-modal .import-muted{opacity:.55;font-size:12px;line-height:1.5;margin-top:8px}
 .computer-import-modal .import-row{display:flex;justify-content:space-between;align-items:center;gap:24px;min-height:58px;border-bottom:1px solid oklch(var(--bc)/.07);padding:10px 0}
 .computer-import-modal .select,.computer-import-modal .input{font-size:13px;height:34px;min-height:34px;border-radius:7px}
 .computer-import-modal .select{width:190px}.computer-import-modal .input{width:100%;margin:8px 0}
 .computer-import-modal h4{font-size:11px;text-transform:uppercase;letter-spacing:.08em;opacity:.5;margin:24px 0 6px}
 .computer-import-modal [data-computer-sites]{max-height:220px;overflow:auto}
 .computer-import-modal .cookie-group{padding:8px 0;border-bottom:1px solid oklch(var(--bc)/.07)}
 .computer-import-modal .cookie-heading,.computer-import-modal .cookie-row{display:flex;align-items:center;gap:10px;padding:6px 0}
 .computer-import-modal .cookie-row{padding-left:26px;font-size:12px}.computer-import-modal .cookie-row span{overflow-wrap:anywhere}
 .computer-import-modal .import-actions{display:flex;justify-content:flex-end;gap:8px;margin-top:24px}
 .computer-import-modal .import-actions .btn{font-size:12px;height:32px;min-height:32px;font-weight:500;border-radius:7px;padding:0 14px;margin:0}
 @media(max-width:560px){.computer-import-modal .import-row{gap:12px}.computer-import-modal .select{width:150px}}
 </style>
   @layout.FullscreenViewer(templ.Attributes{"data-computer-dialog": true, "aria-label": "Live computer screen"}) {
   @layout.FullscreenViewerHeader(templ.Attributes{"aria-label": "Close computer preview"}) {
    <span data-fullscreen-title></span><button type="button" class="btn btn-ghost btn-sm rounded-md px-2 text-sm font-normal" data-teach-open>Teach a skill</button>
   }
   <div data-computer-teach data-fullscreen-interactive hidden>
    <div data-teach-toolbar>
     <span data-teach-label>Show the computer how to do a task.</span>
     <span data-teach-timer hidden aria-label="Recording duration">0:00</span>
     <button type="button" class="btn btn-sm" data-teach-record>Start recording</button>
     <button type="button" class="btn btn-sm" data-teach-stop hidden>Stop and save</button>
     <button type="button" class="btn btn-ghost btn-sm" data-teach-discard aria-label="Discard recording" title="Discard recording">✕</button>
    </div>
    <p role="status" data-teach-status></p>
   </div><div data-computer-expanded data-fullscreen-stage></div>
   }
   <style>
    [data-computer-teach] { flex:none; width:min(760px,100%); align-self:center; padding:12px 20px; box-sizing:border-box; }
    [data-computer-teach] [hidden] { display:none !important; }
    [data-teach-toolbar] { display:flex; align-items:center; gap:12px; flex-wrap:wrap; }
    [data-teach-label] { flex:1; min-width:160px; }
    [data-teach-timer] { font-variant-numeric:tabular-nums; }
    [data-teach-status]:empty { display:none; }
    [data-teach-status] { margin:8px 0 0; }
    .computer-summary { cursor:pointer; list-style:none; }
    .computer-summary::-webkit-details-marker { display:none; }
    details[open] > .computer-summary > [aria-hidden] { transform:rotate(90deg); }
    #project-computer[data-computer-task] > details > :not(summary) { margin-top:12px; }
    [data-computer-dialog] [data-fullscreen-header] > button:focus:not(:focus-visible) { outline:none; }
    [data-computer-expanded] { display:flex; flex-direction:column; flex:1; min-height:0; }
    [data-computer-expanded] [data-computer-screen] { flex:1; min-height:0 !important; height:auto !important; border-radius:0; background:transparent !important; }
    [data-computer-expanded] [data-computer-login] { max-height:35vh; overflow:auto; flex-shrink:0; }
   </style>
   <script>
    (function(){
     const root=document.getElementById('project-computer');
     if(!root || root.dataset.bound) return;
     root.dataset.bound='true';
     const find=selector=>root.querySelector(selector);
     const preview=root.querySelector('[data-computer-preview]');
     const base='/projects/'+encodeURIComponent(root.dataset.computerProject)+'/computer';
     const computerToast=(...args)=>window.computerErrorToast(root.dataset.computerProject,root.dataset.computerTask,...args);
     function computerUUID() {
      const cryptoAPI = globalThis.crypto;
      if (typeof cryptoAPI.randomUUID === 'function') return cryptoAPI.randomUUID();
      const bytes = cryptoAPI.getRandomValues(new Uint8Array(16));
      bytes[6] = (bytes[6] & 15) | 64;
      bytes[8] = (bytes[8] & 63) | 128;
      const hex = Array.from(bytes, byte => byte.toString(16).padStart(2, '0')).join('');
      return hex.slice(0, 8) + '-' + hex.slice(8, 12) + '-' + hex.slice(12, 16) + '-' + hex.slice(16, 20) + '-' + hex.slice(20);
     }
     const viewerID=computerUUID();
     const scoped=path=>base+path+'?viewer_id='+viewerID+(root.dataset.computerTask?'&task_id='+encodeURIComponent(root.dataset.computerTask):'');
     const dialog=find('[data-computer-dialog]');
     const homes=[];
     const expand=find('[data-computer-preview-open]');
     function openViewer(){if(closing)return;if(dialog.open){refresh();return;}for(const node of [find('[data-computer-login]'),find('[data-computer-import-dialog]'),screen].filter(Boolean)){const mark=document.createComment('computer-home');node.before(mark);homes.push([mark,node]);dialog.querySelector('[data-computer-expanded]').append(node);}screen.style.height='70vh';dialog.showModal();if(rfb)rfb.background='transparent';screen.focus({preventScroll:true});refresh();recoverTeaching();}
     find('[data-computer-preview-open]').onclick=openViewer;
     dialog.addEventListener('close',finishViewer);
     async function finishViewer(){if(dialog.open)return;pauseTeaching();if(closing || !homes.length)return;closing=true;recording=false;renderDemo();syncViewerInput();for(const [mark,node] of homes)mark.replaceWith(node);homes.length=0;screen.style.height='';if(rfb)rfb.background='var(--shell-card,var(--fallback-b1,oklch(var(--b1))))';expand.focus();closing=false;await refresh();return true;}
     const screen=find('[data-computer-screen]');
     const connectionOverlay=document.createElement('div');connectionOverlay.dataset.computerConnection='';
     connectionOverlay.setAttribute('role','status');connectionOverlay.setAttribute('aria-live','polite');
     connectionOverlay.style.cssText='position:absolute;inset:0;z-index:2;display:flex;flex-direction:column;align-items:center;justify-content:center;gap:12px;background:rgba(20,24,32,.65);color:white;text-align:center;padding:16px';
     connectionOverlay.innerHTML='<span class="loading loading-spinner loading-sm" aria-hidden="true"></span><span data-computer-connection-text></span>';
     screen.append(connectionOverlay);
     let frameReady=false,everConnected=false,startupStage='';
     function renderConnection(){
      const waiting=!frameReady;connectionOverlay.style.display=waiting?'flex':'none';screen.setAttribute('aria-busy',String(waiting));
      if(!waiting)return;
      const seconds=Math.ceil(Math.max(0,screenRetry.nextRetryAt-Date.now())/1000);
      const text=startupStage==='building'?'Building computer image…':startupStage==='starting'||pending?'Starting computer…':seconds?'Retrying in '+seconds+(seconds===1?' second…':' seconds…'):everConnected||retained?'Reconnecting to computer…':'Connecting to computer…';
      const label=connectionOverlay.querySelector('[data-computer-connection-text]');if(label.textContent!==text)label.textContent=text;
     }
     const buttons=[...root.querySelectorAll('[data-computer-action]')];
     let rfb=null, mode='', pending=false, generation=0, closed=false, refreshVersion=0, attemptedStart=false, closing=false, retained=null, frameTimer=null, liveCanvas=null, hiddenTimer=null;
     let statusStream=null, statusLive=false, statusFailed=false, statusTimer=null, connectTimer=null, refreshPromise=null, refreshQueued=false, pendingState=null;
     // A queued status snapshot must not undo a tool destination saved after it arrived.
     let targetSaveVersion=0, pendingTargetSaveVersion=0;
     function queueStatus(){
      if(closed || previewDeleted)return;
      clearTimeout(statusTimer);statusTimer=setTimeout(()=>{statusTimer=null;refresh();},50);
     }
     const screenRetry=window.openVibelyRetry(()=>refresh());
     const connectionTimer=setInterval(renderConnection,250);
     function retryStatus(){
      if(closed || previewDeleted || !visible() || pending || closing || !statusLive || statusFailed)return;
      if((connected&&frameReady) || currentState?.enabled===false){screenRetry.cancel();return;}
      // A status read or screen handshake must finish before another attempt.
      if(rfb || !currentState)return;
      screenRetry.fail();
     }
     function statusDisconnected(){statusLive=false;screenRetry.cancel();}
     function statusChanged(event){
      let data;try{data=JSON.parse(event.data);}catch{return;}
      if(data.project_id!==root.dataset.computerProject || data.task_id!==root.dataset.computerTask)return;
      startupStage=data.startup_stage||'';renderConnection();
      pendingState=data;pendingTargetSaveVersion=targetSaveVersion;statusFailed=false;queueStatus();
     }
     function subscribeStatus(force=false){
      if((statusStream&&!force) || !window.openVibelyLive)return;
      statusStream?.close();statusLive=false;statusFailed=true;
      statusStream=window.openVibelyLive.computer(root.dataset.computerProject,root.dataset.computerTask,{viewer_id:viewerID,viewer_mode:'control'},{
       onopen:()=>{statusLive=true;},
       listeners:{computer_status:statusChanged,
        task_deleted:event=>{let data;try{data=JSON.parse(event.data);}catch{return;}previewWasDeleted({detail:data});},
        retry:()=>{statusFailed=true;statusDisconnected();},error:()=>{statusStream?.close();statusStream=null;pendingState=null;disconnect();statusFailed=true;statusDisconnected();}}
      });
     }
     window.addEventListener('live-transport-disconnected',statusDisconnected);

     if(!window.__ovComputerPreviewCache){
      window.__ovComputerPreviewCache=new Map();
      function evictDeletedPreview(event){
       const data=event.detail||{};
       if((event.type!=='taskDeleted' && data.type!=='task_deleted') || !data.task_id)return;
       for(const key of window.__ovComputerPreviewCache.keys()){
        const [project,task]=JSON.parse(key);
        if(task===data.task_id && (!data.project_id || project===data.project_id))window.__ovComputerPreviewCache.delete(key);
       }
       window.dispatchEvent(new CustomEvent('computer-preview-deleted',{detail:data}));
      }
      window.addEventListener('sse-task-event',evictDeletedPreview,true);
      document.body.addEventListener('taskDeleted',evictDeletedPreview,true);
     }
     const previewCache=window.__ovComputerPreviewCache;
     let previewDeleted=false;
     const previewKey=JSON.stringify([root.dataset.computerProject,root.dataset.computerTask]);
     const teach=find('[data-computer-teach]');
     const teachNote=find('[data-teach-status]');
     let connected=false, currentState=null, inViewport=true, ime=null, composing=false, pasteShift=false, recording=false;
     function inputActive(){return connected && frameReady && !retained && mode==='control' && dialog.open && !document.hidden && !closing;}

     function viewerShown(){return !root.closest('[data-computer-permission-pending]') && (dialog.open || root.getClientRects().length>0);}
     function visible(){return !document.hidden && viewerShown();}
     function chord(key,code,{ctrl=false,shift=false,alt=false}={}){
      if(!inputActive())return;
      for(const [sym,name] of [[0xffeb,'MetaLeft'],[0xffec,'MetaRight'],[0xffe3,'ControlLeft'],[0xffe4,'ControlRight'],[0xffe1,'ShiftLeft'],[0xffe2,'ShiftRight'],[0xffe9,'AltLeft'],[0xffea,'AltRight']])rfb.sendKey(sym,name,false);
      const mods=[...(ctrl?[[0xffe3,'ControlLeft']]:[]),...(shift?[[0xffe1,'ShiftLeft']]:[]),...(alt?[[0xffe9,'AltLeft']]:[])];
      for(const [sym,name] of mods)rfb.sendKey(sym,name,true);
      rfb.sendKey(key,code,true);rfb.sendKey(key,code,false);
      for(const [sym,name] of mods.reverse())rfb.sendKey(sym,name,false);
     }
     function commitText(text){if(!inputActive()||!text)return;for(const char of text){const point=char.codePointAt(0);rfb.sendKey(point<=255?point:0x01000000+point,null,true);rfb.sendKey(point<=255?point:0x01000000+point,null,false);}}
     function focusKeyboard(){if(inputActive())ime?.focus({preventScroll:true});}
     function installKeyboard(){
      ime?.remove();ime=document.createElement('textarea');ime.setAttribute('aria-label','Remote computer keyboard');ime.autocomplete='off';ime.spellcheck=false;ime.setAttribute('autocapitalize','off');ime.style.cssText='position:absolute;left:0;bottom:0;width:1px;height:1px;opacity:0;resize:none';screen.append(ime);
      ime.addEventListener('compositionstart',()=>{composing=true});
      ime.addEventListener('compositionend',()=>{composing=false;queueMicrotask(()=>{if(ime){commitText(ime.value);ime.value=''}})});
      ime.addEventListener('input',()=>{if(!composing){commitText(ime.value);ime.value=''}});
      focusKeyboard();
     }
     const specialKeys={Enter:0xff0d,Tab:0xff09,Escape:0xff1b,Backspace:0xff08,Delete:0xffff,ArrowLeft:0xff51,ArrowUp:0xff52,ArrowRight:0xff53,ArrowDown:0xff54,Home:0xff50,End:0xff57,PageUp:0xff55,PageDown:0xff56,Insert:0xff63};
     screen.addEventListener('keydown',e=>{
      if(!inputActive()||e.isComposing||composing)return;
      if(['Control','Meta','Alt','Shift'].includes(e.key))return;
      const command=e.ctrlKey||(['Mac','iPhone','iPad'].some(name=>navigator.platform.includes(name))&&e.metaKey),letter=e.key.toLowerCase();
      if(command&&letter==='v'){pasteShift=e.shiftKey;e.stopImmediatePropagation();focusKeyboard();return;}
      const symbol=specialKeys[e.key]||(['F1','F2','F3','F4','F5','F6','F7','F8','F9','F10','F11','F12'].includes(e.key)?0xffbd+Number(e.key.slice(1)):null);
      if(symbol||command||e.altKey){e.preventDefault();e.stopImmediatePropagation();const key=symbol||(e.key.length===1?e.key.codePointAt(0):null);if(key)chord(key,e.code,{ctrl:command,shift:e.shiftKey,alt:e.altKey});return;}
      if(e.target===ime)e.stopImmediatePropagation();
     },true);
     screen.addEventListener('paste',e=>{if(!inputActive())return;e.preventDefault();e.stopImmediatePropagation();const text=e.clipboardData?.getData('text/plain');if(text){rfb.clipboardPasteFrom(text);chord(0x76,'KeyV',{ctrl:true,shift:pasteShift});}pasteShift=false;if(ime)ime.value='';},true);
     screen.addEventListener('focusin',e=>{if(e.target.tagName==='CANVAS')queueMicrotask(focusKeyboard)});
     screen.addEventListener('pointerup',e=>{if(e.target.tagName!=='CANVAS'||!inputActive())return;queueMicrotask(focusKeyboard);},true);
     let teachState=null,teachSteps=0,teachImages=0,teachBusy=false,teachChain=Promise.resolve();
     function renderDemo(){
      find('[data-teach-record]').hidden=recording||teachBusy;
      find('[data-teach-record]').textContent=teachState?.state==='stopped'?'Resume recording':'Start recording';
      find('[data-teach-stop]').hidden=!teachState||!['recording','stopped','finished'].includes(teachState.state);
      find('[data-teach-stop]').disabled=teachBusy;
      find('[data-teach-discard]').disabled=teachBusy;
      find('[data-teach-timer]').hidden=!teachState||!['recording','stopped','finished'].includes(teachState.state);
      find('[data-teach-label]').textContent=recording?'Watching and learning':teachBusy?'Saving recording…':'Recording stopped';
      find('[data-teach-open]').hidden=recording||teachBusy||!!currentState?.handoff_kind;
      updateRecordingTimer();
     }
     function updateRecordingTimer(){const elapsed=teachState?Math.min(600,Math.max(0,Math.floor((Date.now()-Date.parse(teachState.started_at))/1000))):0;find('[data-teach-timer]').textContent=Math.floor(elapsed/60)+':'+String(elapsed%60).padStart(2,'0');}
     async function teachRequest(body){const response=await fetch(scoped('/recording'),body?{method:'POST',headers:{'Content-Type':'application/json'},body:JSON.stringify(body)}:{cache:'no-store'});const data=await response.json();if(!response.ok)throw Error(data.message||'Could not update recording');return data;}
     function acceptTeach(data){const previousError=teachState?.error;teachState=data.recording;if(teachState.error)teachNote.textContent=teachState.error;else if(previousError)teachNote.textContent="";teachSteps=data.step_count;teachImages=data.image_count;recording=teachState.state==='recording'&&inputActive()&&!currentState?.handoff_kind;renderDemo();}
     function queueTeach(action){const next=teachChain.then(action);teachChain=next.catch(()=>{});return next;}
     function teachError(error){recording=false;teachNote.textContent=error.message+' Your recording is preserved; retry saving or discard it.';renderDemo();}
     async function startTeaching(){
      if(!inputActive()||currentState?.handoff_kind||teachBusy)return;
      teach.hidden=false;teachBusy=true;renderDemo();
      try{await queueTeach(async()=>{acceptTeach(await teachRequest({action:'start'}));});if(!teachState.error)teachNote.textContent='The project computer is recording your screen and actions. Stop before entering private information.';}
      catch(error){teachError(error)}finally{teachBusy=false;renderDemo();}
     }
     find('[data-teach-open]').onclick=startTeaching;
     find('[data-teach-record]').onclick=startTeaching;
     find('[data-teach-stop]').onclick=async()=>{
      if(teachBusy||!teachState)return;recording=false;teachBusy=true;renderDemo();
      try{await queueTeach(async()=>{acceptTeach(await teachRequest({action:'save',id:teachState.id}));});teach.hidden=true;teachNote.textContent='';if(root.isConnected){dialog.close();await finishViewer();document.getElementById('task-message-input')?.focus();}computerToast('Recording sent to the task to learn.','success');}
      catch(error){teachError(error)}finally{teachBusy=false;renderDemo();}
     };
     find('[data-teach-discard]').onclick=async()=>{
      if(teachBusy||!teachState)return;recording=false;teachBusy=true;renderDemo();
      try{await queueTeach(async()=>{acceptTeach(await teachRequest({action:'discard',id:teachState.id}));});teach.hidden=true;teachNote.textContent='';}
      catch(error){teachError(error)}finally{teachBusy=false;renderDemo();}
     };
     function pauseTeaching(){
      if(teachBusy||!teachState||teachState.state!=='recording')return;
      recording=false;renderDemo();queueTeach(async()=>{acceptTeach(await teachRequest({action:'pause',id:teachState.id}));}).catch(teachError);
     }
     let teachPolling=false;
     const recordingStatusTimer=setInterval(()=>{
      if(teachBusy||teachPolling||!teachState||!['recording','stopped','finished'].includes(teachState.state)||document.hidden)return;
      teachPolling=true;queueTeach(async()=>acceptTeach(await teachRequest())).catch(teachError).finally(()=>{teachPolling=false});
     },2000);
     const recordingTimer=setInterval(updateRecordingTimer,1000);
     function recoverTeaching(){if(teachBusy)return;queueTeach(async()=>{acceptTeach(await teachRequest());if(!teachBusy)teach.hidden=!['recording','stopped','finished'].includes(teachState.state);}).catch(error=>{teachNote.textContent=error.message});}
     function suspendViewer(){
      pauseTeaching();recording=false;renderDemo();syncViewerInput();
      // Brief app switches keep the stream alive, but release keyboard and mouse input.
      if(document.hidden && viewerShown() && rfb){
       if(hiddenTimer===null)hiddenTimer=setTimeout(()=>{hiddenTimer=null;if(!visible())disconnect();},600000);
      }else disconnect();
     }
     function visibilityChanged(){
      if(closed || previewDeleted)return;
      if(!visible()){++refreshVersion;suspendViewer();}
      else{clearTimeout(hiddenTimer);hiddenTimer=null;refresh();}
     }
     document.addEventListener('visibilitychange',visibilityChanged);
     const viewportObserver=new IntersectionObserver(entries=>{inViewport=entries[0].isIntersecting;visibilityChanged()});viewportObserver.observe(preview);
     // Only capture on disconnect; keep at most 12 task previews, each at most 640x400.
     function rememberFrame(source){
      if(previewDeleted)return;
      const frame=document.createElement('canvas'),scale=Math.min(1,640/source.width,400/source.height);
      frame.width=Math.max(1,Math.round(source.width*scale));frame.height=Math.max(1,Math.round(source.height*scale));
      frame.getContext('2d').drawImage(source,0,0,frame.width,frame.height);
      previewCache.delete(previewKey);previewCache.set(previewKey,frame);
      while(previewCache.size>12)previewCache.delete(previewCache.keys().next().value);
     }
     function showFrame(frame){
      retained?.remove();retained=frame;frame.dataset.retainedFrame='';frame.setAttribute('aria-hidden','true');
      screen.style.position='relative';frame.style.cssText='position:absolute;inset:0;width:100%;height:100%;object-fit:contain;pointer-events:none;z-index:1;background:var(--shell-card,var(--fallback-b1,oklch(var(--b1))))';
      screen.append(frame);
     }
     function restoreFrame(){
      if(previewDeleted)return;
      const saved=previewCache.get(previewKey);if(!saved)return;
      previewCache.delete(previewKey);previewCache.set(previewKey,saved);
      const frame=document.createElement('canvas');frame.width=saved.width;frame.height=saved.height;
      frame.getContext('2d').drawImage(saved,0,0);showFrame(frame);
     }
     // Keep the last painted desktop while the stream reconnects.
     function retainFrame(){
      if(previewDeleted || retained)return;
      // noVNC detaches its screen before emitting an unexpected disconnect.
      const source=screen.querySelector('canvas:not([data-retained-frame])')||liveCanvas;
      if(!source || !source.width || !source.height)return;
      const frame=document.createElement('canvas');frame.width=source.width;frame.height=source.height;
      try{const ctx=source.getContext('2d');if(![.25,.5,.75].some(v=>ctx.getImageData(Math.floor(source.width*v),Math.floor(source.height*v),1,1).data[3]))return;frame.getContext('2d').drawImage(source,0,0);}catch{return;}
      rememberFrame(frame);showFrame(frame);
     }
     function revealFrame(epoch){
      clearTimeout(frameTimer);
      if(closed || epoch!==generation || frameReady)return;
      const canvas=screen.querySelector('canvas:not([data-retained-frame])');
      if(connected&&canvas?.width&&canvas?.height){try{
       if([.25,.5,.75].some(v=>canvas.getContext('2d').getImageData(Math.floor(canvas.width*v),Math.floor(canvas.height*v),1,1).data[3])){
        retained?.remove();retained=null;frameReady=true;everConnected=true;clearTimeout(connectTimer);
        screenRetry.success();renderConnection();syncViewerInput();return;
       }
      }catch{ /* Keep input blocked until a readable live frame arrives. */ }}
      frameTimer=setTimeout(()=>revealFrame(epoch),50);
     }
     function syncViewerInput(){
      if(!rfb)return;
      const want=!!(connected&&frameReady&&dialog.open&&!closing&&!document.hidden);
      if(!want&&!rfb.viewOnly){
       // Release held input before viewOnly starts suppressing outgoing input.
       rfb._keyboard?.ungrab();
       if(rfb._mouseButtonMask)rfb._sendMouse(rfb._mousePos.x,rfb._mousePos.y,0);
       rfb._mouseButtonMask=0;
      }
      rfb.viewOnly=!want;mode=want?'control':'view';
      if(want){if(!ime)installKeyboard();}else{ime?.remove();ime=null;composing=false;}
     }
     function previewQuality(state){return ({low:3,balanced:7,high:9})[state.preview_quality]??7;}
     async function viewer(state){
      if(rfb){rfb.qualityLevel=previewQuality(state);syncViewerInput();return;}
      disconnect();mode='view';
      const epoch=++generation;
      const {default:RFB}=await import(root.dataset.computerViewer);
      if(closed || previewDeleted || epoch!==generation)return;
      const ws=new URL(state.stream_url || scoped('/stream/control'),location.href);ws.protocol=ws.protocol==='https:'?'wss:':'ws:';
      rfb=new RFB(screen,ws.href,{wsProtocols:state.ticket?['binary',state.ticket]:['binary']});
      liveCanvas=screen.querySelector('canvas:not([data-retained-frame])');
      if(retained)screen.append(retained);
      rfb.background=dialog.open?'transparent':'var(--shell-card,var(--fallback-b1,oklch(var(--b1))))';
      rfb.qualityLevel=previewQuality(state);rfb.scaleViewport=true;rfb.resizeSession=false;rfb.viewOnly=true;
      revealFrame(epoch);
      connectTimer=setTimeout(()=>{if(epoch===generation&&!frameReady){disconnect();retryStatus();}},10000);
      rfb.addEventListener('connect',()=>{if(epoch!==generation||closed)return;connected=true;revealFrame(epoch);syncViewerInput();});
      rfb.addEventListener('clipboard',event=>{if(epoch!==generation||!inputActive())return;if(document.hasFocus())navigator.clipboard?.writeText(event.detail.text).catch(()=>{});});
      rfb.addEventListener('securityfailure',()=>{if(epoch===generation){connected=false;computerToast('Desktop authentication failed.','error','',{toastKey:previewKey+':authentication'});}});
      rfb.addEventListener('disconnect',event=>{if(epoch===generation){clearTimeout(connectTimer);retainFrame();liveCanvas=null;connected=false;frameReady=false;rfb=null;mode='';recording=false;renderDemo();renderConnection();retryStatus();}});
     }
     function disconnect(){clearTimeout(hiddenTimer);hiddenTimer=null;++generation;clearTimeout(connectTimer);screenRetry.cancel();connected=false;frameReady=false;ime?.remove();ime=null;composing=false;clearTimeout(frameTimer);if(rfb)retainFrame();if(rfb)rfb.disconnect();rfb=null;liveCanvas=null;mode='';if(retained)screen.append(retained);else if(!closed)restoreFrame();renderConnection();}
     function refresh(){
      if(refreshPromise){refreshQueued=true;return refreshPromise;}
      refreshPromise=(async()=>{do{refreshQueued=false;await refreshStatus();}while(refreshQueued&&!closed&&!previewDeleted);})().finally(()=>{refreshPromise=null;retryStatus();});
      return refreshPromise;
     }
     async function refreshStatus(){
      if(closed || previewDeleted || pending || closing)return;
 if(!visible()){suspendViewer();return;}
      if(!pendingState){if(rfb&&connected&&currentState){syncViewerInput();return;}subscribeStatus(true);return;}
      screenRetry.cancel();
      const version=++refreshVersion;
      try{
       const state=pendingState, stateTargetSaveVersion=pendingTargetSaveVersion;pendingState=null;statusFailed=false;
       if(state.viewer_mode!=='control'){return;}
       if(closed || previewDeleted || pending || closing || !visible() || version!==refreshVersion)return;
       const taskToggle=find('[data-task-computer-toggle]');if(taskToggle){taskToggle.checked=!!state.task_enabled;taskToggle.disabled=!state.project_enabled;}
       preview.hidden=!state.enabled;
currentState=state;if(state.handoff_kind){pauseTeaching();recording=false;renderDemo();}find('[data-teach-open]').hidden=recording||teachBusy||!!state.handoff_kind;if(state.handoff_kind)teach.hidden=true;
       if(state.startup_stage && !state.ready){disconnect();return;}
       if(state.enabled!==false && !state.ready && !attemptedStart){attemptedStart=true;pending=true;try{const started=await fetch(scoped('/ensure'),{method:'POST'});if(!started.ok){const data=await started.json();throw Error(data.message||'Could not start computer');}pending=false;refreshQueued=true;}catch(e){pending=false;startupStage='';renderConnection();computerToast(e.message,'error');find('[data-computer-action=ensure]').hidden=false;find('[data-computer-action=ensure]').disabled=false;}return;}
       find('[data-computer-login]').hidden=!state.handoff_kind;
 find('[data-computer-login-site]').textContent=state.handoff_kind?(state.handoff_reason||'Computer help requested')+(state.handoff_url?' — '+state.handoff_url:''):'';
 const target=find('[data-computer-target]');if(target&&!target.disabled&&stateTargetSaveVersion===targetSaveVersion){target.dataset.value=state.tool_target||'worktree';target.querySelector('[data-property-label]').textContent=target.dataset.value==='computer'?'Task computer':'Task worktree';}
 find('[data-computer-chrome]').hidden=state.handoff_kind!=='request_chrome_login'||!state.chrome_available;
 buttons.forEach(b=>{const a=b.dataset.computerAction;if(a==='ensure')b.hidden=state.ready||state.enabled===false;b.disabled=a==='ensure'?state.enabled===false:a.startsWith('login-')?!state.handoff_kind:!state.ready||state.held||state.busy;});
       if(state.ready){await viewer(state);}else disconnect();
      }catch(e){computerToast(e.message,'error');if(visible())screenRetry.fail();}
     }
     async function computerAction(event){
      const button=event.target.closest('[data-computer-action]');if(!button || pending || button.disabled)return;
      pending=true;++refreshVersion;buttons.forEach(b=>b.disabled=true);
      const action=button.dataset.computerAction;
      if(action!=='login-done')disconnect();
      try{
       const res=await fetch(scoped('/'+action),{method:'POST',headers:{'Content-Type':'application/json'}});
       if(!res.ok){const body=await res.json();throw new Error(body.message||'Computer operation failed');}
       pending=false;await refresh();
      }catch(e){computerToast(e.message,'error');pending=false;buttons.forEach(b=>b.disabled=false);await refresh();}
     }
     root.addEventListener('click',computerAction);
 const profile=find('[data-computer-profile]');
 const sites=find('[data-computer-sites]');

 const selectedCookies=new Map();let pendingImport="",importBusy=false;
 const cookieKey=c=>JSON.stringify([c.profile,c.domain,c.name,c.path]);
 const updateSelection=()=>{find('[data-computer-import]').disabled=importBusy||(!pendingImport&&!selectedCookies.size);};
 const importDialog=find('[data-computer-import-dialog]'),cookieSearch=find('[data-computer-cookie-search]');
 let loadedCookies=[],cookieLoad=0,importReturnFocus=null;
 const prepareImportClose=()=>{if(importReturnFocus?.matches('[data-computer-grants-open]'))importReturnFocus.setAttribute('data-selector-return-focus','');};
 importDialog.addEventListener('cancel',prepareImportClose);importDialog.querySelector('.modal-backdrop').addEventListener('submit',prepareImportClose);
 function renderCookies(){sites.replaceChildren();const groups=new Map(),query=cookieSearch.value.toLowerCase();for(const cookie of loadedCookies){if(!(cookie.domain+' '+cookie.name+' '+cookie.path).toLowerCase().includes(query))continue;if(!groups.has(cookie.domain))groups.set(cookie.domain,[]);groups.get(cookie.domain).push(cookie);}
 const checkbox=()=>{const c=document.createElement('input');c.type='checkbox';c.className='checkbox checkbox-primary checkbox-sm';return c;};
 for(const [domain,cookies] of groups){const group=document.createElement('div');group.className='cookie-group';const heading=document.createElement('label');heading.className='cookie-heading';const all=checkbox();const sync=()=>{all.checked=cookies.every(c=>selectedCookies.has(cookieKey(c)));all.indeterminate=!all.checked&&cookies.some(c=>selectedCookies.has(cookieKey(c)));};sync();heading.append(all,document.createTextNode(domain));group.append(heading);all.onchange=()=>{for(const cookie of cookies){if(all.checked)selectedCookies.set(cookieKey(cookie),cookie);else selectedCookies.delete(cookieKey(cookie));}updateSelection();renderCookies();};for(const cookie of cookies){const label=document.createElement('label');label.className='cookie-row';const check=checkbox();check.checked=selectedCookies.has(cookieKey(cookie));check.onchange=()=>{if(check.checked)selectedCookies.set(cookieKey(cookie),cookie);else selectedCookies.delete(cookieKey(cookie));sync();updateSelection();};const text=document.createElement('span');text.textContent=cookie.name+' ('+cookie.path+')';label.append(check,text);group.append(label);}sites.append(group);}if(!groups.size)sites.textContent=query?'No matching cookies':'No cookies available';}
 cookieSearch.oninput=renderCookies;
 const resetImport=()=>{find('[data-computer-chrome-form]').hidden=true;selectedCookies.clear();updateSelection();};
 const closeImport=()=>{prepareImportClose();importDialog.close();resetImport();};find('[data-computer-import-close]').onclick=closeImport;find('[data-computer-import-cancel]').onclick=closeImport;
 importDialog.addEventListener('close',()=>{if(!importDialog.open&&!find('[data-computer-chrome-form]').hidden)resetImport();});
 async function chromeSites(){const version=++cookieLoad;loadedCookies=[];sites.textContent='Loading cookies…';const url=new URL(scoped('/chrome'),location.href);url.searchParams.set('profile',profile.value);try{const res=await fetch(url,{cache:'no-store'});const data=await res.json();if(version!==cookieLoad)return;if(!res.ok)throw Error(data.message||'Could not load Chrome cookies');loadedCookies=data.cookies;renderCookies();}catch(e){if(version!==cookieLoad)return;sites.textContent='Could not load cookies';throw e;}}
 profile.onchange=()=>chromeSites().catch(e=>computerToast(e.message,'error'));
 async function openChromeImport(){if(pending)return;try{const res=await fetch(scoped('/chrome'),{cache:'no-store'});const data=await res.json();if(!res.ok)throw Error(data.message||'Chrome profiles unavailable');pendingImport=data.pending_import?.id||'';find('[data-computer-import]').textContent=pendingImport?'Resume approved import':'Import selected';if(pendingImport){computerToast('An approved import is incomplete. Retry to resume remaining profiles.','info');find('[data-computer-import]').textContent='Resume approved import';}profile.replaceChildren();for(const name of data.profiles){profile.add(new Option(name,name));}find('[data-computer-chrome-form]').hidden=false;if(!importDialog.open){importReturnFocus=document.activeElement;importDialog.showModal();}cookieSearch.value='';loadedCookies=[];renderCookies();updateSelection();if(profile.value)await chromeSites();}catch(e){computerToast(e.message,'error');}};
 find('[data-computer-chrome]').onclick=openChromeImport;
 root.addEventListener('computer:import-chrome',openChromeImport);
 find('[data-computer-import]').onclick=async event=>{if(importBusy)return;if(!pendingImport&&!selectedCookies.size){computerToast('Select at least one cookie.','error');return;}event.target.disabled=true;importBusy=true;pending=true;try{const res=await fetch(scoped('/chrome-import'),{method:'POST',headers:{'Content-Type':'application/json'},body:JSON.stringify({grant_id:pendingImport,scope:find('[data-computer-grant-scope]').value,hours:Number(find('[data-computer-grant-hours]').value),selections:[...selectedCookies.values()]})});const data=await res.json();if(!res.ok){if(data.grant_id){pendingImport=data.grant_id;find('[data-computer-import]').textContent='Resume approved import';}throw Error(data.message||'Import failed');}pendingImport='';find('[data-computer-import]').textContent='Import selected';computerToast('Imported '+data.imported+' cookies.'+(currentState?.handoff_kind==='request_chrome_login'?' Check your sign-in, then select Done.':''),'success');closeImport();}catch(e){computerToast(e.message,'error');}finally{importBusy=false;pending=false;updateSelection();}};
 const target=find('[data-computer-target]'), targetPicker=find('#computer-target-picker');
 const targetPickerUI=window.createInspectorPicker(root,targetPicker,()=>target.disabled);
 target.onclick=()=>targetPickerUI.open(target);
 targetPicker.addEventListener('click',async event=>{
 const option=event.target.closest('button[data-value]');if(!option||target.disabled)return;
 target.disabled=true;
 try{const res=await fetch(scoped('/target-'+option.dataset.value),{method:'POST'});if(!res.ok)throw Error('Could not change tool destination');targetSaveVersion++;target.dataset.value=option.dataset.value;target.querySelector('[data-property-label]').textContent=option.textContent;targetPickerUI.close();targetPickerUI.returnFocus(target);}
 catch(e){computerToast(e.message,'error');}
 finally{target.disabled=false;}
 });
 function changed(){attemptedStart=false;setTimeout(visibilityChanged,0);}
 document.addEventListener('computer-setting-changed',changed);
 document.addEventListener('computer-tab-change',changed);
 function previewWasDeleted(event){
  const data=event.detail||{};
  if(data.task_id!==root.dataset.computerTask || (data.project_id && data.project_id!==root.dataset.computerProject))return;
  previewDeleted=true;retained?.remove();retained=null;disconnect();
 }
 window.addEventListener('computer-preview-deleted',previewWasDeleted);
 function dispose(){
  if(closed)return;
  pauseTeaching();closed=true;statusStream?.close();statusStream=null;
  clearTimeout(statusTimer);clearInterval(connectionTimer);screenRetry.dispose();clearInterval(recordingStatusTimer);clearInterval(recordingTimer);
  viewportObserver.disconnect();
  window.removeEventListener('live-transport-disconnected',statusDisconnected);
  window.removeEventListener('computer-preview-deleted',previewWasDeleted);
  document.removeEventListener('htmx:beforeCleanupElement',beforeCleanup);
  document.removeEventListener('visibilitychange',visibilityChanged);
  document.removeEventListener('computer-setting-changed',changed);
  document.removeEventListener('computer-tab-change',changed);
  dialog.removeEventListener('close',finishViewer);
  if(dialog.open)dialog.close();
  disconnect();
 }
 function beforeCleanup(event){if(event.detail?.elt===root || event.detail?.elt?.contains(root))dispose();}
 document.addEventListener('htmx:beforeCleanupElement',beforeCleanup);
 const taskToggle=find('[data-task-computer-toggle]');
 if(taskToggle)taskToggle.onchange=async()=>{
  taskToggle.disabled=true;pending=true;
  try{const res=await fetch(scoped(taskToggle.checked?'/task-enable':'/task-disable'),{method:'POST'});if(!res.ok){const data=await res.json();throw Error(data.message||'Could not update task computer');}attemptedStart=false;if(!taskToggle.checked){disconnect();preview.hidden=true;}}
  catch(e){computerToast(e.message,'error');taskToggle.checked=!taskToggle.checked;}
  finally{pending=false;taskToggle.disabled=false;await refresh();}
 };
 restoreFrame();renderConnection();screenRetry.start();

    })();
   </script>
  </section>
 }
 }

templ ProjectComputerToggle(projectID string) {
 <div data-computer-preference={projectID} class="mb-4">
 <label class="label cursor-pointer justify-start gap-2"><input type="checkbox" class="toggle toggle-sm" data-computer-enabled disabled/><span>Project computer</span></label>
 <p class="text-xs opacity-70">Allow tasks in this project to opt into computer use. Each task is off by default.</p>
 <label>Stop unused desktops after <select class="select select-bordered" data-computer-idle disabled><option value="15">15 minutes</option><option value="30">30 minutes</option><option value="60">1 hour</option><option value="120">2 hours</option><option value="0">Never</option></select></label>
 <p class="text-xs opacity-70">Active tasks, open viewers, private requests and running commands stay open. Idle shutdown keeps saved files and browser logins, but closes apps and loses unsaved work. Open the Computer tab to restart.</p>
 <label>Desktop time zone <select class="select select-bordered" data-computer-time-zone disabled><option value="UTC">UTC</option></select></label>
 <button type="button" class="btn btn-sm" data-computer-time-zone-restart>Apply to desktop</button>
 <p class="text-xs opacity-70">Saved for all task desktops in this project. Apply restarts the computer when idle; files are kept.</p>
 <p role="status" data-computer-preference-status></p>
 <script>
 (()=>{document.querySelectorAll('[data-computer-preference]').forEach(root=>{
 if(root.dataset.bound)return;root.dataset.bound='true';const box=root.querySelector('input'),status=root.querySelector('[role=status]');const base='/projects/'+encodeURIComponent(root.dataset.computerPreference)+'/computer';
 const idle=root.querySelector('[data-computer-idle]');
 idle.onchange=async()=>{idle.disabled=true;try{const res=await fetch(base+'/idle-timeout',{method:'POST',body:new URLSearchParams({idle_minutes:idle.value})});if(!res.ok){const data=await res.json();throw Error(data.message||'Could not save idle timeout');}status.textContent='Idle timeout saved for this project.';}catch(e){status.textContent=e.message;await load();}finally{idle.disabled=false;}};
 const zone=root.querySelector('[data-computer-time-zone]'),restart=root.querySelector('[data-computer-time-zone-restart]');
 for(const name of Intl.supportedValuesOf?.('timeZone')||[]){zone.add(new Option(name,name));}
 zone.onchange=async()=>{zone.disabled=true;restart.disabled=true;try{const res=await fetch(base+'/time-zone',{method:'POST',body:new URLSearchParams({time_zone:zone.value})});if(!res.ok){const data=await res.json();throw Error(data.message||'Could not save time zone');}status.textContent='Time zone saved. Apply when the computer is idle.';}catch(e){status.textContent=e.message;}finally{zone.disabled=false;restart.disabled=false;}};
 restart.onclick=async()=>{restart.disabled=true;zone.disabled=true;status.textContent='Applying desktop time zone…';try{const res=await fetch(base+'/start',{method:'POST'});if(!res.ok){const data=await res.json();throw Error(data.message||'Could not apply time zone');}status.textContent='Desktop time zone applied.';document.dispatchEvent(new CustomEvent('computer-setting-changed'));}catch(e){status.textContent=e.message;}finally{restart.disabled=false;zone.disabled=false;}};
 async function load(){try{const res=await fetch(base+'/status',{cache:'no-store'});if(!res.ok)throw Error('Could not load computer setting');const state=await res.json();box.checked=state.enabled!==false;box.disabled=false;const minutes=String(state.idle_minutes??30);if(![...idle.options].some(o=>o.value===minutes))idle.add(new Option(minutes+' minutes',minutes));idle.value=minutes;idle.disabled=false;const selected=state.time_zone||'UTC';if(![...zone.options].some(o=>o.value===selected))zone.add(new Option(selected,selected));zone.value=selected;zone.disabled=false;}catch(e){status.textContent=e.message;}}
 box.onchange=async()=>{box.disabled=true;try{const res=await fetch(base+'/'+(box.checked?'enable':'disable'),{method:'POST'});if(!res.ok){const data=await res.json();throw Error(data.message||'Could not save computer setting');}status.textContent='Saved for this project.';document.dispatchEvent(new CustomEvent('computer-setting-changed',{detail:{project:root.dataset.computerPreference}}));}catch(e){box.checked=!box.checked;status.textContent=e.message;}finally{box.disabled=false;}};load();
 });})();
 </script>
 </div>
}

templ ProjectComputerPermissions(projectID, taskID string, compact ...bool) {
 @ComputerErrorReporter()
 <div data-computer-grants data-grants-project={projectID} data-grants-task={taskID} data-searchable-selector data-searchable-selector-local data-searchable-selector-left-anchor data-searchable-selector-no-default-highlight data-searchable-selector-kind="Chrome permission">
 <input type="hidden" data-searchable-selector-value/>
 <style>.ov-menu [data-computer-grant-list] > .ov-menu-option{align-items:flex-start;text-align:left}</style>
 if len(compact)>0 && compact[0] {
 <button type="button" class="btn btn-ghost permissions-button" data-computer-grants-open data-searchable-selector-trigger aria-haspopup="dialog">Manage <span aria-hidden="true">›</span></button>
 } else {
 <button type="button" class="inspector-property-row" data-computer-grants-open data-searchable-selector-trigger aria-haspopup="dialog">
 @components.InspectorPropertyContent("Chrome permissions", "")
 </button>
 }
 @templateui.SearchableSelector(templateui.SearchableSelectorConfig{ID:"computer-grants-picker",Kind:"Chrome permission",Local:true,CreateButtonID:"computer-manual-import",CreateLabel:"Import Chrome sign-ins"}) {
 <div data-computer-grant-list></div>
 }
 <script>
 (()=>{document.querySelectorAll('[data-computer-grants]').forEach(root=>{
 if(root.dataset.bound)return;root.dataset.bound='true';
 const picker=root.querySelector('[data-searchable-selector-dialog]'),list=root.querySelector('[data-computer-grant-list]');
 picker.setAttribute('aria-label','Chrome permissions');
 const search=picker.querySelector('input');search.setAttribute('aria-label','Search Chrome permissions');
 let importAvailable=false;
 const refresh=()=>{importButton.hidden=!importAvailable||!root.closest('[data-computer-task]');importButton.parentElement.hidden=importButton.hidden;window.openVibelySearchableSelector.filter(root);};
 const base='/projects/'+encodeURIComponent(root.dataset.grantsProject)+'/computer/chrome-grants';
 const computerToast=(...args)=>window.computerErrorToast(root.dataset.grantsProject,root.dataset.grantsTask,...args);
 const url=offset=>base+'?offset='+offset+(root.dataset.grantsTask?'&task_id='+encodeURIComponent(root.dataset.grantsTask):'');
 const importButton=root.querySelector('#computer-manual-import');importButton.setAttribute('data-computer-manual-import','');importButton.hidden=true;importButton.parentElement.hidden=true;
 importButton.onclick=()=>{window.openVibelySearchableSelector.close(root,false);root.closest('[data-computer-task]')?.dispatchEvent(new CustomEvent('computer:import-chrome'));};
 let busy=false,version=0;
 async function load(){const current=++version;importAvailable=false;refresh();list.textContent='Loading permissions…';try{
 let grants=[],offset=0;
 for(;;){const res=await fetch(url(offset),{cache:'no-store'});const data=await res.json();if(!res.ok)throw Error(data.message||'Permissions unavailable');if(current!==version)return;importAvailable=data.chrome_available===true;grants.push(...data.grants);if(!data.has_more)break;if(data.next_offset<=offset)throw Error('Could not load remaining permissions');offset=data.next_offset;}
 list.replaceChildren();if(!grants.length){const empty=document.createElement('p');empty.className='p-3 text-sm opacity-60';empty.textContent='No Chrome permissions';list.append(empty);}
 for(const grant of grants){const button=document.createElement('button');button.type='button';button.dataset.value=grant.id;button.setAttribute('data-searchable-selector-option','');button.setAttribute('data-searchable-selector-id',grant.id);button.className='ov-menu-option w-full max-w-full overflow-hidden flex flex-col items-start gap-1';
 const title=document.createElement('span');title.className='text-sm';title.textContent=grant.selections.map(c=>c.profile+': '+c.domain+' / '+c.name).join(', ');
 const detail=document.createElement('span');detail.className='text-xs opacity-60';detail.textContent=(grant.scope==='project'?'This project':'This task')+' · '+(grant.revoked?'Revoked':(grant.one_time?'One import · ':'')+(grant.expires_at?'Expires '+new Date(grant.expires_at*1000).toLocaleString():'Until revoked'));
 const action=document.createElement('span');action.className='text-xs text-error';action.textContent=grant.revoked?'Retry clearing cookies':'Revoke';button.append(title,detail,action);button.setAttribute('data-searchable-selector-name',button.textContent);
 button.onclick=async event=>{event.stopPropagation();if(busy)return;busy=true;button.disabled=true;try{const res=await fetch(url(0),{method:'POST',headers:{'Content-Type':'application/json'},body:JSON.stringify({grant_id:grant.id})});const data=await res.json();if(!res.ok)throw Error(data.message||'Could not revoke');await load();}catch(e){computerToast(e.message,'error');}finally{busy=false;button.disabled=false;}};list.append(button);}
 refresh();
 }catch(e){if(current!==version)return;list.textContent='Could not load permissions. Close and reopen to retry.';computerToast(e.message,'error');}}
 const observer=new MutationObserver(records=>{if(picker.open&&records.some(r=>r.attributeName==='open'))load();});observer.observe(picker,{attributes:true,attributeFilter:['open']});
 root.addEventListener('htmx:beforeCleanupElement',e=>{if(e.target===root){version++;observer.disconnect();}});
 });})();
 </script>
 </div>
}

// TaskComputerToggle never changes project-wide permission.
templ TaskComputerToggle(projectID, taskID string) {
 <div data-task-computer-preference data-project-id={projectID} class="flex flex-col gap-2">
 <label class="flex items-center gap-3 text-sm"><input type="checkbox" class="toggle toggle-sm toggle-primary shrink-0" data-task-computer-toggle name="computer_enabled" value="on" form="task-thread-form" disabled/>Use computer for this task</label>
 if taskID=="" {
 <p class="text-sm opacity-60">The desktop and preview start after you send the first message.</p>
 <script>
 (()=>{
 const box=document.querySelector('[data-task-computer-preference]');if(!box)return;
 const toggle=box.querySelector('[data-task-computer-toggle]');
 async function update(){
 const project=document.getElementById('new-task-project')?.value||box.dataset.projectId;
 try{const res=await fetch('/projects/'+encodeURIComponent(project)+'/computer/status');if(!res.ok)throw Error();const state=await res.json();toggle.disabled=!state.enabled;if(toggle.disabled)toggle.checked=false;}catch{toggle.disabled=true;toggle.checked=false;}
 }
 update();
 const destination=document.getElementById('new-task-project');destination?.addEventListener('change',update);
 document.body.addEventListener('htmx:beforeCleanupElement',function cleanup(e){if(e.detail.elt===box||e.detail.elt?.contains(box)){destination?.removeEventListener('change',update);document.body.removeEventListener('htmx:beforeCleanupElement',cleanup);}});
 })();
 </script>
 }
 </div>
}

// ComputerErrorReporter keeps repeated connection failures from flooding Alerts.
// Failed deliveries remain retryable; they never trigger another error report.
templ ComputerErrorReporter() {
 <script>
 (()=>{
 if(window.computerErrorToast)return;
 const reports=new Map();
 window.computerErrorToast=(project,task,message,type,...rest)=>{
 window.showToast?.(message,type,...rest);
 if(type!=='error'||!project)return;
 const text=String(message||'Project computer operation failed').slice(0,1000);
 const key=JSON.stringify([project,task||'',text]),now=Date.now();
 for(const [k,v] of reports)if(now-v>=60000)reports.delete(k);
 if(reports.has(key))return;
 reports.set(key,now);
 const url='/projects/'+encodeURIComponent(project)+'/computer/error'+(task?'?task_id='+encodeURIComponent(task):'');
 fetch(url,{method:'POST',headers:{'Content-Type':'application/json'},body:JSON.stringify({message:text})})
 .then(res=>{if(!res.ok)throw Error('Could not record computer alert');})
 .catch(error=>{if(reports.get(key)===now)reports.delete(key);console.error('Could not record project computer alert',error);});
 };
 })();
 </script>
}
