					function outboundTargetKindOnPlatformChange(platformSel) {
						const platform = platformSel ? platformSel.value : '';
						const wrapper = document.getElementById('outbound-target-kind-wrapper');
						if (!wrapper) return;
						const kindSel = wrapper.querySelector('select[name="target_kind"]');
						const fixedLabel = document.getElementById('outbound-target-kind-fixed-label');
						const fixedKind = platform === 'telegram' ? 'Chat' : platform === 'email' ? 'Email' : null;
						if (fixedKind) {
							if (kindSel) kindSel.classList.add('hidden');
							if (fixedLabel) { fixedLabel.textContent = fixedKind; fixedLabel.classList.remove('hidden'); }
						} else {
							if (kindSel) kindSel.classList.remove('hidden');
							if (fixedLabel) fixedLabel.classList.add('hidden');
						}
					}

					function resetOutboundTargetAddForm() {
						const form = document.getElementById('outbound-target-add-form');
						if (form) {
							form.reset();
							delete form.dataset.editingRowKey;
							const submit = form.querySelector('button[type="submit"]');
							if (submit) submit.textContent = 'Add Target';
						}
						const platformSel = document.getElementById('outbound-target-platform-select');
						if (platformSel) outboundTargetKindOnPlatformChange(platformSel);
					}

					function reloadOutboundTargetsModalDraft() {
						const section = document.getElementById('outbound-targets-section');
						if (!section || !window.htmx) return;
						const projectID = section.getAttribute('data-project-id') || '';
						window.htmx.ajax('GET', '/channels/outbound-targets?project_id=' + encodeURIComponent(projectID), {
							target: '#outbound-targets-section',
							swap: 'outerHTML'
						});
					}

					function openOutboundTargetsModal() {
						const modal = document.getElementById('outbound_targets_modal');
						resetOutboundTargetAddForm();
						reloadOutboundTargetsModalDraft();
						if (modal) modal.showModal();
					}

					function closeOutboundTargetsModal() {
						const modal = document.getElementById('outbound_targets_modal');
						if (modal) modal.close();
					}

					function handleOutboundTargetsModalClose() {
						resetOutboundTargetAddForm();
						reloadOutboundTargetsModalDraft();
					}

					function outboundTargetsDraftInput(name, value) {
						const input = document.createElement('input');
						input.type = 'hidden';
						input.name = name;
						input.value = value || '';
						return input;
					}

					function outboundTargetsFindDraftGroup(rowKey) {
						const fields = document.getElementById('outbound-targets-draft-fields');
						if (!fields) return null;
						const groups = fields.querySelectorAll('[data-outbound-target-draft-key]');
						for (let i = 0; i < groups.length; i++) {
							if (groups[i].getAttribute('data-outbound-target-draft-key') === rowKey) return groups[i];
						}
						return null;
					}

					function outboundTargetsFindDraftRow(rowKey) {
						const tbody = document.getElementById('outbound-targets-draft-tbody');
						if (!tbody) return null;
						const rows = tbody.querySelectorAll('tr[data-outbound-target-draft-key]');
						for (let i = 0; i < rows.length; i++) {
							if (rows[i].getAttribute('data-outbound-target-draft-key') === rowKey) return rows[i];
						}
						return null;
					}

					function outboundTargetsDraftValue(group, name) {
						const input = group ? group.querySelector('input[name="' + name + '"]') : null;
						return input ? input.value : '';
					}

					function outboundTargetsAppendDraftFields(rowKey, id, platform, targetKind, name, targetID, threadID, isHome, defaultSubject) {
						const fields = document.getElementById('outbound-targets-draft-fields');
						if (!fields) return;
						let group = outboundTargetsFindDraftGroup(rowKey);
						if (!group) {
							group = document.createElement('div');
							group.id = 'outbound-target-draft-fields-' + rowKey;
							group.setAttribute('data-outbound-target-draft-key', rowKey);
							fields.appendChild(group);
						}
						while (group.firstChild) group.removeChild(group.firstChild);
						group.appendChild(outboundTargetsDraftInput('target_row_id', id));
						group.appendChild(outboundTargetsDraftInput('target_platform', platform));
						group.appendChild(outboundTargetsDraftInput('target_kind', targetKind));
						group.appendChild(outboundTargetsDraftInput('target_name', name));
						group.appendChild(outboundTargetsDraftInput('target_target_id', targetID));
						group.appendChild(outboundTargetsDraftInput('target_thread_id', threadID));
						group.appendChild(outboundTargetsDraftInput('target_is_home', isHome ? 'true' : 'false'));
						group.appendChild(outboundTargetsDraftInput('target_default_subject', defaultSubject));
					}

					function outboundTargetsEscape(value) {
						const div = document.createElement('div');
						div.textContent = value || '';
						return div.innerHTML;
					}

							function outboundTargetTestTestingHTML() {
								return '<span class="inline-flex items-center gap-1"><span class="loading loading-spinner loading-xs" aria-hidden="true"></span><span>Testing...</span></span>';
							}

							function outboundTargetTestFailedHTML() {
								return '<span class="inline-flex items-center gap-1 text-error" title="Test failed."><span aria-hidden="true">✕</span><span>Failed</span></span>';
							}

							function outboundTargetTestBefore(button) {
								if (!button) return;
								button.disabled = true;
								button.setAttribute('aria-busy', 'true');
								const label = button.querySelector('[data-outbound-target-test-label]');
								if (label) label.innerHTML = outboundTargetTestTestingHTML();
							}

							function outboundTargetTestAfter(button, event) {
								if (!button) return;
								button.disabled = false;
								button.removeAttribute('aria-busy');
								if (event && event.detail && event.detail.successful === false) {
									const label = button.querySelector('[data-outbound-target-test-label]');
									if (label) label.innerHTML = outboundTargetTestFailedHTML();
								}
							}

					function outboundTargetsRenderDraftRow(rowKey, platform, targetKind, name, targetID, threadID, isHome) {
						const escapedRowKey = outboundTargetsEscape(rowKey);
						const fieldsID = 'outbound-target-draft-fields-' + escapedRowKey;
						const testLabelID = 'outbound-target-test-label-' + escapedRowKey;
						const typeCell = targetKind === 'user' ? '<span class="badge badge-sm badge-outline">User DM</span>' : '<span class="opacity-60 text-xs">' + outboundTargetsEscape(targetKind) + '</span>';
						return '<td>' + outboundTargetsEscape(platform) + '</td>' +
							'<td>' + typeCell + '</td>' +
							'<td>' + (name ? '<span>#' + outboundTargetsEscape(name) + '</span>' : '<span class="opacity-50">unnamed</span>') + '</td>' +
							'<td class="font-mono text-xs break-all">' + outboundTargetsEscape(targetID) + '</td>' +
							'<td class="font-mono text-xs">' + outboundTargetsEscape(threadID) + '</td>' +
							'<td class="outbound-target-home-cell">' + (isHome ? '<span class="badge badge-sm badge-primary">Home</span>' : '') + '</td>' +
							'<td class="text-right whitespace-nowrap"><span class="badge badge-sm badge-ghost mr-2">Unsaved</span><button type="button" class="btn btn-xs mr-1" onclick="editOutboundTargetDraft(this)">Edit</button><button type="button" class="btn btn-xs mr-1" hx-post="/channels/outbound-targets/test-draft" hx-include="#' + fieldsID + ', #outbound-targets-policy-form input[name=project_id]" hx-target="#' + testLabelID + '" hx-swap="innerHTML" hx-on::before-request="outboundTargetTestBefore(this)" hx-on::after-request="outboundTargetTestAfter(this, event)"><span id="' + testLabelID + '" data-outbound-target-test-label aria-live="polite">Test</span></button><button type="button" class="btn btn-xs btn-error" onclick="removeOutboundTargetDraft(this)">Delete</button></td>';
					}

					function editOutboundTargetDraft(button) {
						const row = button ? button.closest('tr[data-outbound-target-draft-key]') : null;
						const form = document.getElementById('outbound-target-add-form');
						if (!row || !form) return;
						const rowKey = row.getAttribute('data-outbound-target-draft-key') || '';
						const group = outboundTargetsFindDraftGroup(rowKey);
						if (!rowKey || !group) return;
						form.reset();
						form.elements.platform.value = outboundTargetsDraftValue(group, 'target_platform');
						form.elements.target_kind.value = outboundTargetsDraftValue(group, 'target_kind') || 'channel';
						form.elements.name.value = outboundTargetsDraftValue(group, 'target_name');
						form.elements.target_id.value = outboundTargetsDraftValue(group, 'target_target_id');
						form.elements.thread_id.value = outboundTargetsDraftValue(group, 'target_thread_id');
						form.elements.is_home.checked = outboundTargetsDraftValue(group, 'target_is_home') === 'true';
						form.elements.default_subject.value = outboundTargetsDraftValue(group, 'target_default_subject');
						form.dataset.editingRowKey = rowKey;
						const submit = form.querySelector('button[type="submit"]');
						if (submit) submit.textContent = 'Update Target';
						const platformSel = document.getElementById('outbound-target-platform-select');
						if (platformSel) outboundTargetKindOnPlatformChange(platformSel);
					}

					function addOutboundTargetDraft(event) {
						if (event) event.preventDefault();
						const form = document.getElementById('outbound-target-add-form');
						const tbody = document.getElementById('outbound-targets-draft-tbody');
						if (!form || !tbody) return false;
						const editingRowKey = form.dataset.editingRowKey || '';
						const editingRow = editingRowKey ? outboundTargetsFindDraftRow(editingRowKey) : null;
						const editingGroup = editingRowKey ? outboundTargetsFindDraftGroup(editingRowKey) : null;
						if (editingRowKey && (!editingRow || !editingGroup)) return false;
						const platform = (form.elements.platform.value || '').trim().toLowerCase();
						const targetKind = platform === 'telegram' ? 'chat' : platform === 'email' ? 'email' : (form.elements.target_kind.value || 'channel').trim().toLowerCase();
						const name = (form.elements.name.value || '').trim().replace(/^#+/, '').toLowerCase();
						const targetID = (form.elements.target_id.value || '').trim();
						const threadID = (form.elements.thread_id.value || '').trim();
						const isHome = !!form.elements.is_home.checked;
						const defaultSubject = (form.elements.default_subject.value || '').trim();
						if (!platform || !targetID) return false;
						if (isHome) {
							document.querySelectorAll('#outbound-targets-draft-tbody tr[data-platform="' + platform + '"] .outbound-target-home-cell').forEach(function(cell) {
								cell.innerHTML = '';
							});
							document.querySelectorAll('#outbound-targets-draft-fields [data-outbound-target-draft-key]').forEach(function(group) {
								const platformInput = group.querySelector('input[name="target_platform"]');
								const homeInput = group.querySelector('input[name="target_is_home"]');
								if (platformInput && homeInput && platformInput.value === platform) homeInput.value = 'false';
							});
						}
						if (!editingRowKey) {
							const rowKey = 'draft-' + Date.now() + '-' + Math.random().toString(36).slice(2);
							const emptyRow = document.getElementById('outbound-targets-empty-row');
							if (emptyRow) emptyRow.remove();
							const row = document.createElement('tr');
							row.setAttribute('data-outbound-target-draft-key', rowKey);
							row.setAttribute('data-platform', platform);
							row.innerHTML = outboundTargetsRenderDraftRow(rowKey, platform, targetKind, name, targetID, threadID, isHome);
							tbody.appendChild(row);
							outboundTargetsAppendDraftFields(rowKey, '', platform, targetKind, name, targetID, threadID, isHome, defaultSubject);
							if (window.htmx && typeof window.htmx.process === 'function') window.htmx.process(row);
						} else {
							const id = outboundTargetsDraftValue(editingGroup, 'target_row_id') || editingRowKey;
							editingRow.setAttribute('data-platform', platform);
							editingRow.innerHTML = outboundTargetsRenderDraftRow(editingRowKey, platform, targetKind, name, targetID, threadID, isHome);
							outboundTargetsAppendDraftFields(editingRowKey, id, platform, targetKind, name, targetID, threadID, isHome, defaultSubject);
							if (window.htmx && typeof window.htmx.process === 'function') window.htmx.process(editingRow);
						}
						resetOutboundTargetAddForm();
						return false;
					}

					function removeOutboundTargetDraft(button) {
						const row = button ? button.closest('tr[data-outbound-target-draft-key]') : null;
						if (!row) return;
						const rowKey = row.getAttribute('data-outbound-target-draft-key');
						const form = document.getElementById('outbound-target-add-form');
						row.remove();
						const group = outboundTargetsFindDraftGroup(rowKey);
						if (group) group.remove();
						if (form && form.dataset.editingRowKey === rowKey) resetOutboundTargetAddForm();
						const tbody = document.getElementById('outbound-targets-draft-tbody');
						if (tbody && !tbody.querySelector('tr[data-outbound-target-draft-key]')) {
							const empty = document.createElement('tr');
							empty.id = 'outbound-targets-empty-row';
							empty.innerHTML = '<td colspan="7" class="opacity-60">No outbound targets saved yet.</td>';
							tbody.appendChild(empty);
						}
					}

				function setEmailProviderPreset(providerKey, preserveValues) {
					const provider = document.getElementById('email_provider');
					if (!provider) return;
					const option = provider.options[provider.selectedIndex];
					const isCustom = (providerKey || '').toLowerCase() === 'custom';
					const advanced = document.getElementById('email_advanced_details');
					if (advanced) advanced.open = isCustom;
					const help = document.getElementById('email_provider_help');
					if (help && option) help.textContent = option.getAttribute('data-help') || help.textContent;
					if (!isCustom && option && !preserveValues) {
						document.getElementById('email_imap_host').value = option.getAttribute('data-imap-host') || '';
						document.getElementById('email_imap_port').value = option.getAttribute('data-imap-port') || '993';
						document.getElementById('email_smtp_host').value = option.getAttribute('data-smtp-host') || '';
						document.getElementById('email_smtp_port').value = option.getAttribute('data-smtp-port') || '587';
					}
				}

				function markEmailProviderCustom() {
					const provider = document.getElementById('email_provider');
					if (provider) provider.value = 'custom';
				}

					function toggleSlackBotTokenMode(mode) {
						const section = document.getElementById('slack_bot_token_override_section');				if (!section) {
					return;
				}
				const normalized = (mode || '').toLowerCase();
				section.style.display = normalized === 'manual' ? '' : 'none';
			}

			function toggleGitHubAuthMode(mode) {
				const normalized = (mode || '').toLowerCase();
				const patSection = document.getElementById('github_pat_section');
				const appSection = document.getElementById('github_app_section');
				if (!patSection || !appSection) {
					return;
				}
				const isAppMode = normalized === 'app';
				patSection.style.display = isAppMode ? 'none' : '';
				appSection.style.display = isAppMode ? '' : 'none';
			}

				// Close modal and refresh after successful save
				document.body.addEventListener('htmx:afterRequest', function(event) {
					var detail = event.detail || {};
					var requestConfig = detail.requestConfig || {};
					var rawPath = requestConfig.path || (detail.pathInfo && detail.pathInfo.requestPath) || detail.path || '';
					var rp = String(rawPath).split('?')[0];
					if (rp === '/channels/telegram' && detail.successful) {
						const modal = document.getElementById('channel_modal');
						if (modal && modal.open) {
							modal.close();
						}
					}
					if (rp === '/channels/github/configure' && detail.successful) {
						const modal = document.getElementById('github_config_modal');
						if (modal && modal.open) {
							modal.close();
						}
					}
					if (rp === '/channels/slack/configure' && detail.successful) {
						const modal = document.getElementById('slack_config_modal');
						if (modal && modal.open) {
							modal.close();
						}
					}
					if (rp === '/channels/email/configure' && detail.successful) {
						const modal = document.getElementById('email_config_modal');
						if (modal && modal.open) {
							modal.close();
						}
					}
					if (rp === '/channels/discord/configure' && detail.successful) {
						const modal = document.getElementById('discord_config_modal');
						if (modal && modal.open) {
							modal.close();
						}
					}
					// Close webhook modal after successful save
					if (rp.startsWith('/channels/webhooks') && detail.successful) {
						var whModal = document.getElementById('webhook_modal');
						if (whModal && whModal.open) {
							whModal.close();
						}
					}
					if (rp === '/channels/send-message-explicit-targets' && detail.successful) {
						const xhr = event.detail.xhr;
						const triggerHeader = xhr && typeof xhr.getResponseHeader === 'function' ? (xhr.getResponseHeader('HX-Trigger') || '') : '';
						if (triggerHeader.indexOf('outbound-targets-card-refresh') !== -1) {
							const modal = document.getElementById('outbound_targets_modal');
							if (modal) modal.close();
							resetOutboundTargetAddForm();
						}
					}
				});

				document.body.addEventListener('htmx:configRequest', function(event) {
					if (!event || !event.detail || !event.detail.path) return;
					if (event.detail.path.indexOf('/channels/webhooks') !== 0) return;
					var modal = document.getElementById('webhook_modal');
					if (!modal || !modal.open) return;
					var params = event.detail.parameters || {};
					params.agent_ids = selectedWebhookAgentIDs.join(',');
					event.detail.parameters = params;
				});

			setTimeout(function() {
				const modeSelect = document.getElementById('github_auth_mode');
				if (modeSelect) {
					toggleGitHubAuthMode(modeSelect.value);
				}
					const slackModeSelect = document.getElementById('slack_bot_token_mode');
					if (slackModeSelect) {
						toggleSlackBotTokenMode(slackModeSelect.value);
					}
					const emailProviderSelect = document.getElementById('email_provider');
					if (emailProviderSelect) {
						setEmailProviderPreset(emailProviderSelect.value, true);
					}
				}, 0);		</script>
	</div>
}

templ OutboundTargetsCard(currentProjectID string, targets []models.ChannelTarget, explicitAllowed bool) {
	<div
		id="outbound-targets-card"
		class="card bg-base-100 shadow-sm border border-base-300 cursor-pointer hover:border-primary/40 hover:shadow-md transition-all"
		data-channel-type="outbound-targets"
		data-search-card
		data-search-text="Outbound Message Targets send_message Slack Telegram Email Discord"
		hx-get={ "/channels/outbound-targets/card?project_id=" + currentProjectID }
		hx-trigger="outbound-targets-card-refresh from:body"
		hx-target="this"
		hx-swap="outerHTML"
		onclick="openOutboundTargetsModal()"
	>
		<div class="card-body relative">
			<div class="absolute top-4 right-4" onclick="event.stopPropagation()">
				<div class="dropdown dropdown-end">
					<label tabindex="0" class="btn btn-ghost btn-sm" onclick="handleDropdownToggle(event)">
						<svg xmlns="http://www.w3.org/2000/svg" class="h-4 w-4" fill="none" viewBox="0 0 24 24" stroke="currentColor">
							<path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 5v.01M12 12v.01M12 19v.01M12 6a1 1 0 110-2 1 1 0 010 2zm0 7a1 1 0 110-2 1 1 0 010 2zm0 7a1 1 0 110-2 1 1 0 010 2z"></path>
						</svg>
					</label>
					<ul tabindex="0" class="dropdown-content z-[100] menu p-2 shadow bg-base-100 rounded-box w-48 border border-base-300">
						<li><button type="button" onclick="openOutboundTargetsModal()">Edit</button></li>
					</ul>
				</div>
			</div>
			<div class="pr-12">
				<h3 class="font-bold flex items-center gap-2">
					<svg xmlns="http://www.w3.org/2000/svg" class="h-5 w-5" fill="none" viewBox="0 0 24 24" stroke="currentColor" aria-hidden="true">
						<path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 12l2 2 4-4m5.618-4.016A11.955 11.955 0 0112 2.944a11.955 11.955 0 01-8.618 3.04A12.02 12.02 0 003 9c0 5.591 3.824 10.29 9 11.622 5.176-1.332 9-6.031 9-11.622 0-1.042-.133-2.052-.382-3.016z"></path>
					</svg>
					Outbound Message Targets
				</h3>
				<p class="text-sm opacity-60">Safety controls for where the `send_message` chat tool can send.</p>
				<div class="mt-2 flex flex-wrap items-center gap-2">
					<span class="badge badge-sm badge-ghost">{ outboundTargetSummary(targets) }</span>
					if explicitAllowed {
						<span class="badge badge-sm badge-warning">Explicit targets allowed</span>
					} else {
						<span class="badge badge-sm badge-success">Saved targets only</span>
					}
				</div>
			</div>
		</div>
	</div>
}

templ OutboundTargetsModal(currentProjectID string, targets []models.ChannelTarget, explicitAllowed bool) {
		<dialog id="outbound_targets_modal" class="modal" onclose="handleOutboundTargetsModalClose()">
		<div class="modal-box max-w-5xl">
			<button type="button" class="btn btn-circle btn-ghost btn-xs ov-modal-close" onclick="closeOutboundTargetsModal()" aria-label="Close outbound message targets" title="Close outbound message targets">
				<svg xmlns="http://www.w3.org/2000/svg" class="h-4 w-4" fill="none" viewBox="0 0 24 24" stroke="currentColor" aria-hidden="true"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M6 18L18 6M6 6l12 12"></path></svg>
			</button>
			@OutboundTargetsSection(currentProjectID, targets, explicitAllowed, "")
		</div>
		<form method="dialog" class="modal-backdrop">
			<button>close</button>
		</form>
	</dialog>
}

templ OutboundTargetsFragment(currentProjectID string, targets []models.ChannelTarget, explicitAllowed bool, notice string) {
	@OutboundTargetsSection(currentProjectID, targets, explicitAllowed, notice)
}

templ OutboundTargetsCardFragment(currentProjectID string, targets []models.ChannelTarget, explicitAllowed bool) {
	@OutboundTargetsCard(currentProjectID, targets, explicitAllowed)
}

templ OutboundTargetsSection(currentProjectID string, targets []models.ChannelTarget, explicitAllowed bool, notice string) {
		<div id="outbound-targets-section" data-project-id={ currentProjectID }>
			<div>
				<div class="pr-10">
					<h3 class="card-title">Outbound Message Targets</h3>
				</div>
				<div class="alert alert-info mt-3 mb-4 text-sm">
					<svg xmlns="http://www.w3.org/2000/svg" fill="none" viewBox="0 0 24 24" class="stroke-current shrink-0 w-5 h-5">
						<path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M13 16h-1v-4h-1m1-4h.01M21 12a9 9 0 11-18 0 9 9 0 0118 0z"></path>
					</svg>
					<div>
						<p class="font-semibold">Saved destinations for send_message</p>
						<p class="text-xs opacity-80 mt-1">These saved destinations are available to the `send_message` chat tool. Use names like `slack:#ops`, `telegram:#alerts`, `discord:#ops`, or `email:#client`. Saved targets and Home targets are preferred first.</p>
						<p class="text-xs opacity-70 mt-1">Authorized Users control who can talk to OpenVibely. Outbound targets control where agents may send messages.</p>
						<p class="text-xs opacity-70 mt-1">Authorized channel users/senders can also be direct recipients, such as authorized Email senders, Telegram numeric user IDs, or Slack/Discord user DMs. Other arbitrary unsaved targets require the project policy below.</p>
					</div>
				</div>
				if notice != "" {
					<div class="alert alert-success py-2 text-sm mt-3">{ notice }</div>
				}
				<form id="outbound-target-add-form" class="grid gap-3 md:grid-cols-6 mt-4" onclick="event.stopPropagation()" onsubmit="return addOutboundTargetDraft(event)">				<select name="platform" id="outbound-target-platform-select" class="select select-bordered select-sm" required onchange="outboundTargetKindOnPlatformChange(this)">
					<option value="slack">Slack</option>
					<option value="telegram">Telegram</option>
					<option value="email">Email</option>
					<option value="discord">Discord</option>
				</select>
				<div id="outbound-target-kind-wrapper">
					<select name="target_kind" class="select select-bordered select-sm w-full">
						<option value="channel">Channel</option>
						<option value="user">User DM</option>
					</select>
					<span id="outbound-target-kind-fixed-label" class="hidden select select-bordered select-sm w-full pointer-events-none opacity-60 flex items-center text-sm"></span>
				</div>
				<input name="name" class="input input-bordered input-sm" placeholder="name, e.g. ops"/>
				<input name="target_id" class="input input-bordered input-sm md:col-span-2" placeholder="channel/chat/user ID or email" required/>
				<input name="thread_id" class="input input-bordered input-sm" placeholder="thread/topic ID"/>
				<label class="label cursor-pointer justify-start gap-2 py-0">
					<input type="checkbox" name="is_home" value="true" class="checkbox checkbox-sm"/>
					<span class="label-text text-sm">Home</span>
				</label>
				<input name="default_subject" class="input input-bordered input-sm md:col-span-5" placeholder="default email subject (optional)"/>
					<button type="submit" class="btn btn-primary btn-sm">Add Target</button>
			</form>
				<div class="overflow-x-auto mt-4">
					<table class="table table-sm">
						<thead>
							<tr>
								<th>Platform</th>
								<th>Type</th>
								<th>Name</th>
								<th>Target</th>
								<th>Thread/Topic</th>
								<th>Home</th>
								<th></th>
							</tr>
						</thead>
							<tbody id="outbound-targets-draft-tbody">
								if len(targets) == 0 {
									<tr id="outbound-targets-empty-row"><td colspan="7" class="opacity-60">No outbound targets saved yet.</td></tr>
								}
								for _, target := range targets {
									<tr data-outbound-target-draft-key={ target.ID } data-platform={ target.Platform }>
									<td>{ target.Platform }</td>
									<td>
										if target.TargetKind == "user" {
											<span class="badge badge-sm badge-outline">User DM</span>
										} else {
											<span class="opacity-60 text-xs">{ target.TargetKind }</span>
										}
									</td>
									<td>
										if target.Name != "" {
											<span>#{ target.Name }</span>
										} else {
											<span class="opacity-50">unnamed</span>
										}
									</td>
									<td class="font-mono text-xs break-all">{ target.TargetID }</td>
									<td class="font-mono text-xs">{ target.ThreadID }</td>
									<td class="outbound-target-home-cell">
										if target.Home {
											<span class="badge badge-sm badge-primary">Home</span>
										}
									</td>
									<td class="text-right whitespace-nowrap">
										<button type="button" class="btn btn-xs mr-1" onclick="editOutboundTargetDraft(this)">Edit</button>
										<button type="button" class="btn btn-xs mr-1" hx-post={ "/channels/outbound-targets/" + target.ID + "/test?project_id=" + currentProjectID } hx-target={ "#outbound-target-test-label-" + target.ID } hx-swap="innerHTML" hx-on::before-request="outboundTargetTestBefore(this)" hx-on::after-request="outboundTargetTestAfter(this, event)"><span id={ "outbound-target-test-label-" + target.ID } data-outbound-target-test-label aria-live="polite">Test</span></button>
										<button type="button" class="btn btn-xs btn-error" onclick="removeOutboundTargetDraft(this)">Delete</button>
									</td>
								</tr>
							}
						</tbody>
					</table>
				</div>
						<form id="outbound-targets-policy-form" method="post" hx-post="/channels/send-message-explicit-targets" hx-target="#outbound-targets-section" hx-swap="outerHTML" class="modal-action flex flex-col gap-3 sm:flex-row sm:items-center sm:justify-between" onclick="event.stopPropagation()">
							<input type="hidden" name="project_id" value={ currentProjectID }/>
								<div id="outbound-targets-draft-fields" class="hidden">
									for _, target := range targets {
										<div id={ "outbound-target-draft-fields-" + target.ID } data-outbound-target-draft-key={ target.ID }>
										<input type="hidden" name="target_row_id" value={ target.ID }/>
										<input type="hidden" name="target_platform" value={ target.Platform }/>
										<input type="hidden" name="target_kind" value={ target.TargetKind }/>
										<input type="hidden" name="target_name" value={ target.Name }/>
										<input type="hidden" name="target_target_id" value={ target.TargetID }/>
										<input type="hidden" name="target_thread_id" value={ target.ThreadID }/>
										<input type="hidden" name="target_is_home" value={ fmt.Sprintf("%t", target.Home) }/>
										<input type="hidden" name="target_default_subject" value={ target.DefaultSubject }/>
									</div>
								}
							</div>
							<div class="form-control">
								<label class="label cursor-pointer gap-3 justify-start px-0">
									<input type="checkbox" name="enabled" value="true" class="toggle toggle-primary toggle-sm" if explicitAllowed { checked }/>
									<div>
										<span class="label-text text-sm font-semibold">Allow explicit unsaved targets</span>
										<p class="text-xs opacity-50 mt-1">Permit send_message to use direct destinations that are not saved here.</p>
									</div>
								</label>
							</div>
							<div class="flex justify-end gap-2">
								<button type="button" class="btn" onclick="closeOutboundTargetsModal()">Cancel</button>
								<button type="submit" class="btn btn-primary">Save Settings</button>
							</div>
						</form>		</div>	</div>
}
