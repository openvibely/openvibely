package pages

import (
	"encoding/json"
	"fmt"
	"strings"

	"github.com/openvibely/openvibely/internal/models"
	"github.com/openvibely/openvibely/internal/repository"
	"github.com/openvibely/openvibely/internal/service"
	"github.com/openvibely/openvibely/web/templates/components"
	"github.com/openvibely/openvibely/web/templates/layout"
)

type channelStatusBadge struct {
	Label string
	Class string
}

type channelStatusBadgeOptions struct {
	ConfiguredLabel    string
	NotConfiguredLabel string
	NotConfiguredClass string
}

func channelConnectionStatusBadge(configured, connectedOrRunning bool, options channelStatusBadgeOptions) channelStatusBadge {
	configuredLabel := options.ConfiguredLabel
	if configuredLabel == "" {
		configuredLabel = "Not Connected"
	}
	notConfiguredLabel := options.NotConfiguredLabel
	if notConfiguredLabel == "" {
		notConfiguredLabel = "Not Configured"
	}
	notConfiguredClass := options.NotConfiguredClass
	if notConfiguredClass == "" {
		notConfiguredClass = "badge-ghost"
	}

	if !configured {
		return channelStatusBadge{Label: notConfiguredLabel, Class: notConfiguredClass}
	}
	if connectedOrRunning {
		return channelStatusBadge{Label: "Connected", Class: "badge-success"}
	}
	return channelStatusBadge{Label: configuredLabel, Class: "badge-warning"}
}

func githubConnectionBadge(status service.GitHubConnectionStatus) channelStatusBadge {
	return channelConnectionStatusBadge(status.Configured, status.Connected, channelStatusBadgeOptions{})
}

func githubPrivateKeyPlaceholder(hasPrivateKey bool) string {
	if hasPrivateKey {
		return "Leave blank to keep existing private key, or paste a new key to rotate."
	}
	return "Paste your GitHub App private key (PEM format)."
}

func githubPATPlaceholder(hasPAT bool) string {
	if hasPAT {
		return "Leave blank to keep existing token, or paste a new token to rotate."
	}
	return "Paste a GitHub personal access token (classic or fine-grained)."
}

func slackConnectionBadge(status service.SlackConnectionStatus) channelStatusBadge {
	return channelConnectionStatusBadge(status.Configured, status.Connected, channelStatusBadgeOptions{})
}

func slackSecretPlaceholder(hasSecret bool, label string) string {
	if hasSecret {
		return "Leave blank to keep existing " + label + ", or paste a new value to rotate."
	}
	return "Enter " + label + "."
}

func discordConnectionBadge(status service.DiscordConnectionStatus) channelStatusBadge {
	return channelConnectionStatusBadge(status.Configured, status.Running, channelStatusBadgeOptions{ConfiguredLabel: "Gateway Offline"})
}

func telegramConnectionBadge(isBotRunning bool) channelStatusBadge {
	return channelConnectionStatusBadge(true, isBotRunning, channelStatusBadgeOptions{})
}

func telegramChannelStatusText(isBotRunning bool) string {
	if isBotRunning {
		return "Running"
	}
	return "Not Running"
}

func emailConnectionBadge(status service.EmailConnectionStatus) channelStatusBadge {
	return channelConnectionStatusBadge(status.Configured, status.Running, channelStatusBadgeOptions{
		ConfiguredLabel:    "Configured",
		NotConfiguredLabel: "Not Connected",
		NotConfiguredClass: "badge-warning",
	})
}

func selectedWebhookAgentIDs(webhooks []models.WebhookEndpoint, webhookAgents map[string][]models.WebhookEndpointAgent, webhookID string) string {
	agents := webhookAgents[webhookID]
	if len(agents) == 0 {
		return ""
	}
	ids := make([]string, 0, len(agents))
	for _, agent := range agents {
		ids = append(ids, agent.AgentDefinitionID)
	}
	return strings.Join(ids, ",")
}

func agentsJSON(agents []repository.AgentPickerOption) string {
	type agentData struct {
		ID   string `json:"id"`
		Name string `json:"name"`
	}
	data := make([]agentData, len(agents))
	for i, agent := range agents {
		data[i] = agentData{ID: agent.ID, Name: agent.Name}
	}
	b, err := json.Marshal(data)
	if err != nil {
		return "[]"
	}
	return string(b)
}

func outboundTargetSummary(targets []models.ChannelTarget) string {
	if len(targets) == 0 {
		return "No saved outbound targets"
	}
	counts := map[string]int{}
	for _, target := range targets {
		counts[strings.ToLower(target.Platform)]++
	}
	parts := []string{}
	for _, platform := range []string{"email", "slack", "telegram", "discord"} {
		if counts[platform] > 0 {
			parts = append(parts, fmt.Sprintf("%s: %d", platform, counts[platform]))
		}
	}
	if len(parts) == 0 {
		return fmt.Sprintf("%d saved outbound target(s)", len(targets))
	}
	return strings.Join(parts, " • ")
}

templ SettingsPage(projects []models.Project, view ChannelsSettingsView) {
	@layout.Base("Channels", projects, view.CurrentProjectID) {
		@settingsContent(view)
	}
}

// SettingsContent renders just the settings content for HTMX requests
templ SettingsContent(view ChannelsSettingsView) {
	@settingsContent(view)
}

templ settingsContent(view ChannelsSettingsView) {
	<div
		id="channels-container"
		data-search-container
		hx-get={ "/channels?project_id=" + view.CurrentProjectID }
		hx-trigger="channels-refresh from:body"
		hx-target="this"
		hx-swap="outerHTML"
	>
		@layout.PageTitle("Channels")
		<div class="flex items-center justify-between mb-6">
			<h2 class="text-2xl font-bold">Channels</h2>
			<div class="dropdown dropdown-end">
				<label tabindex="0" class="btn btn-primary btn-sm" onclick="handleDropdownToggle(event)">
					+ Add Channel
				</label>
				<ul tabindex="0" class="dropdown-content z-[100] menu p-2 shadow bg-base-100 rounded-box w-48 border border-base-300">
					if !view.HasGitHubChannel {
						<li>
							<button type="button" onclick="openGitHubChannelFromMenu(event)">
								GitHub
							</button>
						</li>
					}
					if !view.HasSlackChannel {
						<li>
							<button type="button" onclick="openSlackChannelFromMenu(event)">
								Slack
							</button>
						</li>
					}
					if !view.HasTelegramChannel {
						<li>
							<button type="button" onclick="openTelegramChannelFromMenu(event)">
								Telegram Bot
							</button>
						</li>
					}
					if !view.HasDiscordChannel {
						<li>
							<button type="button" onclick="openDiscordChannelFromMenu(event)">
								Discord
							</button>
						</li>
					}
					if !view.HasEmailChannel {
						<li>
							<button type="button" onclick="openEmailChannelFromMenu(event)">
								Email
							</button>
						</li>
					}
					<li>
						<button type="button" onclick="openWebhookCreateModal(event)">
							Webhook
						</button>
					</li>
					if view.HasGitHubChannel && view.HasTelegramChannel && view.HasSlackChannel && view.HasDiscordChannel && view.HasEmailChannel {
						<li class="hidden"></li>
					}
				</ul>
			</div>
		</div>

		@CardSearchInput("channels", "Search channels...")

			<!-- Active Channels -->
			<div class="grid gap-4 mb-8">
				@OutboundTargetsCard(view.CurrentProjectID, view.ChannelTargets, view.SendMessageExplicitTargets)

				if view.HasGitHubChannel {
				<!-- GitHub Card -->
				<div
					class="card bg-base-100 shadow-sm border border-base-300 cursor-pointer hover:border-primary/40 hover:shadow-md transition-all"
					data-channel-type="github"
					data-search-card
					data-search-text={ "GitHub " + githubConnectionBadge(view.GitHubStatus).Label }
					onclick="editChannelFromData(this)"
				>
					<div class="card-body relative">
						<div class="absolute top-4 right-4" onclick="event.stopPropagation()">
							<div class="dropdown dropdown-end">
								<label tabindex="0" class="btn btn-ghost btn-sm" onclick="handleDropdownToggle(event)">
									<svg xmlns="http://www.w3.org/2000/svg" class="h-4 w-4" fill="none" viewBox="0 0 24 24" stroke="currentColor">
										<path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 5v.01M12 12v.01M12 19v.01M12 6a1 1 0 110-2 1 1 0 010 2zm0 7a1 1 0 110-2 1 1 0 010 2zm0 7a1 1 0 110-2 1 1 0 010 2z"></path>
									</svg>
								</label>
								<ul tabindex="0" class="dropdown-content z-[100] menu p-2 shadow bg-base-100 rounded-box w-48 border border-base-300">
									<li><button type="button" onclick="openGitHubConfigModal()">Edit</button></li>
									<li>
											<button
												type="button"
												class="text-error"
												onclick="openDeleteChannelConfirm('GitHub', '/channels/github/remove', 'POST')"
											>
												Delete
											</button>									</li>
								</ul>
							</div>
						</div>
						<div class="pr-12">
							<h3 class="font-bold flex items-center gap-2">
								<svg xmlns="http://www.w3.org/2000/svg" class="h-5 w-5" viewBox="0 0 24 24" fill="currentColor">
									<path d="M12 .5a12 12 0 00-3.792 23.39c.6.112.82-.258.82-.576 0-.285-.011-1.04-.017-2.04-3.338.726-4.043-1.61-4.043-1.61-.546-1.387-1.333-1.756-1.333-1.756-1.09-.746.083-.73.083-.73 1.205.085 1.84 1.237 1.84 1.237 1.07 1.835 2.807 1.305 3.492.998.108-.775.419-1.305.762-1.605-2.665-.304-5.467-1.334-5.467-5.932 0-1.31.468-2.381 1.235-3.22-.124-.303-.535-1.527.117-3.181 0 0 1.007-.322 3.3 1.23A11.52 11.52 0 0112 6.317c1.02.005 2.047.138 3.007.404 2.291-1.553 3.297-1.23 3.297-1.23.653 1.655.242 2.879.12 3.181.77.839 1.233 1.91 1.233 3.22 0 4.61-2.807 5.625-5.48 5.922.43.37.814 1.102.814 2.222 0 1.604-.014 2.896-.014 3.29 0 .32.216.694.825.576A12 12 0 0012 .5z"/>
								</svg>
								GitHub
							</h3>
							if view.GitHubStatus.AuthMode == service.GitHubAuthModePAT {
								if view.GitHubStatus.Connected {
									<p class="text-sm opacity-60">Connected with personal access token.</p>
								} else {
									<p class="text-sm opacity-60">Add a personal access token to import repositories and create pull requests.</p>
								}
							} else {
								if view.GitHubStatus.Connected {
									<p class="text-sm opacity-60">Connected using installation `{ view.GitHubStatus.InstallationID }`.</p>
								} else {
									<p class="text-sm opacity-60">Connect your GitHub App installation to import repositories and create pull requests.</p>
								}
							}
							if view.GitHubStatus.AccountLogin != "" {
								<p class="text-sm opacity-60">Account: { view.GitHubStatus.AccountLogin }</p>
							}
							<div class="mt-3 flex items-center gap-2">
								<span class={ "badge badge-sm", githubConnectionBadge(view.GitHubStatus).Class }>{ githubConnectionBadge(view.GitHubStatus).Label }</span>
							</div>
							if view.GitHubStatus.AuthMode == service.GitHubAuthModeApp {
								<div class="mt-3">
									<div onclick="event.stopPropagation()">
									if view.GitHubStatus.Configured && !view.GitHubStatus.Connected {
										<a class="btn btn-primary btn-sm" href="/channels/github/connect">Connect</a>
									} else if view.GitHubStatus.Connected {
										<form method="post" hx-post="/channels/github/disconnect" hx-swap="none" class="inline">
											<button type="submit" class="btn btn-ghost btn-sm">Disconnect</button>
										</form>
									}
									</div>
								</div>
							}
						</div>
					</div>
				</div>
			}

			if view.HasSlackChannel {
				<!-- Slack Card -->
				<div
					class="card bg-base-100 shadow-sm border border-base-300 cursor-pointer hover:border-primary/40 hover:shadow-md transition-all"
					data-channel-type="slack"
					data-search-card
					data-search-text={ "Slack " + slackConnectionBadge(view.SlackStatus).Label }
					onclick="editChannelFromData(this)"
				>
					<div class="card-body relative">
						<div class="absolute top-4 right-4" onclick="event.stopPropagation()">
							<div class="dropdown dropdown-end">
								<label tabindex="0" class="btn btn-ghost btn-sm" onclick="handleDropdownToggle(event)">
									<svg xmlns="http://www.w3.org/2000/svg" class="h-4 w-4" fill="none" viewBox="0 0 24 24" stroke="currentColor">
										<path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 5v.01M12 12v.01M12 19v.01M12 6a1 1 0 110-2 1 1 0 010 2zm0 7a1 1 0 110-2 1 1 0 010 2zm0 7a1 1 0 110-2 1 1 0 010 2z"></path>
									</svg>
								</label>
								<ul tabindex="0" class="dropdown-content z-[100] menu p-2 shadow bg-base-100 rounded-box w-48 border border-base-300">
									<li><button type="button" onclick="openSlackConfigModal()">Edit</button></li>
									<li>
										<button
											type="button"
											hx-post="/channels/slack/test"
											hx-target="#test-result-slack"
											hx-swap="innerHTML"
										>
											Test Connection
										</button>
									</li>
									<li>
											<button
												type="button"
												class="text-error"
												onclick="openDeleteChannelConfirm('Slack', '/channels/slack/remove', 'POST')"
											>
												Delete
											</button>									</li>
								</ul>
							</div>
						</div>
						<div class="pr-12">
							<h3 class="font-bold flex items-center gap-2">
								<svg xmlns="http://www.w3.org/2000/svg" class="h-5 w-5" viewBox="0 0 24 24" fill="currentColor">
									<path d="M6.6 15.6c0 1.32-1.08 2.4-2.4 2.4S1.8 16.92 1.8 15.6s1.08-2.4 2.4-2.4h2.4v2.4zM7.8 15.6c0-1.32 1.08-2.4 2.4-2.4s2.4 1.08 2.4 2.4v6c0 1.32-1.08 2.4-2.4 2.4s-2.4-1.08-2.4-2.4v-6zM10.2 6c-1.32 0-2.4-1.08-2.4-2.4S8.88 1.2 10.2 1.2s2.4 1.08 2.4 2.4V6h-2.4zM10.2 7.2c1.32 0 2.4 1.08 2.4 2.4s-1.08 2.4-2.4 2.4H4.2c-1.32 0-2.4-1.08-2.4-2.4S2.88 7.2 4.2 7.2h6zM19.8 9.6c0-1.32 1.08-2.4 2.4-2.4s2.4 1.08 2.4 2.4-1.08 2.4-2.4 2.4h-2.4V9.6zM18.6 9.6c0 1.32-1.08 2.4-2.4 2.4s-2.4-1.08-2.4-2.4v-6c0-1.32 1.08-2.4 2.4-2.4s2.4 1.08 2.4 2.4v6zM16.2 19.2c1.32 0 2.4 1.08 2.4 2.4S17.52 24 16.2 24s-2.4-1.08-2.4-2.4v-2.4h2.4zM16.2 18c-1.32 0-2.4-1.08-2.4-2.4s1.08-2.4 2.4-2.4h6c1.32 0 2.4 1.08 2.4 2.4s-1.08 2.4-2.4 2.4h-6z"/>
								</svg>
								Slack
							</h3>
							if view.SlackStatus.Connected {
								<p class="text-sm opacity-60">Connected via OAuth.</p>
							} else {
								<p class="text-sm opacity-60">Connect Slack to chat with OpenVibely from app mentions and direct messages.</p>
							}
							if view.SlackStatus.TeamName != "" {
								<p class="text-sm opacity-60">Workspace: { view.SlackStatus.TeamName }</p>
							}
							if len(view.SlackAuthorizedUsers) > 0 {
								<div class="mt-2 flex items-center gap-2">
									<span class="text-sm opacity-60">Authorized users:</span>
									<span class="badge badge-sm badge-ghost">
										{ fmt.Sprintf("%d user(s)", len(view.SlackAuthorizedUsers)) }
									</span>
								</div>
							}
							<div class="mt-3 flex items-center gap-2">
								<span class={ "badge badge-sm", slackConnectionBadge(view.SlackStatus).Class }>{ slackConnectionBadge(view.SlackStatus).Label }</span>
							</div>
							<div class="mt-3" onclick="event.stopPropagation()">
								if view.SlackStatus.Configured && !view.SlackStatus.Connected {
									<a class="btn btn-primary btn-sm" href="/channels/slack/connect">Connect</a>
								}
							</div>
							<div id="test-result-slack" class="mt-2"></div>
						</div>
					</div>
				</div>
			}

			if view.HasTelegramChannel {
				<!-- Telegram Bot Card -->
				<div
					class="card bg-base-100 shadow-sm border border-base-300 cursor-pointer hover:border-primary/40 hover:shadow-md transition-all"
					data-channel-type="telegram"
					data-channel-token={ view.TelegramToken }
					data-channel-running={ templ.JSONString(view.IsBotRunning) }
					data-search-card
					data-search-text={ "Telegram Bot " + telegramChannelStatusText(view.IsBotRunning) }
					onclick="editChannelFromData(this)"
				>
					<div class="card-body relative">
						<!-- Kebab menu in top right -->
						<div class="absolute top-4 right-4" onclick="event.stopPropagation()">
							<div class="dropdown dropdown-end">
								<label tabindex="0" class="btn btn-ghost btn-sm" onclick="handleDropdownToggle(event)">
									<svg xmlns="http://www.w3.org/2000/svg" class="h-4 w-4" fill="none" viewBox="0 0 24 24" stroke="currentColor">
										<path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 5v.01M12 12v.01M12 19v.01M12 6a1 1 0 110-2 1 1 0 010 2zm0 7a1 1 0 110-2 1 1 0 010 2zm0 7a1 1 0 110-2 1 1 0 010 2z"></path>
									</svg>
								</label>
								<ul tabindex="0" class="dropdown-content z-[100] menu p-2 shadow bg-base-100 rounded-box w-48 border border-base-300">
									<li>
										<button onclick="editChannelFromData(this.closest('[data-channel-type]'))">
											Edit
										</button>
									</li>
									<li>
										<button
											hx-post="/channels/telegram/test"
											hx-target="#test-result-telegram"
											hx-swap="innerHTML"
										>
											Test Connection
										</button>
									</li>
									<li>
											<button
												type="button"
												class="text-error"
												onclick="openDeleteChannelConfirm('Telegram Bot', '/channels/telegram/remove', 'POST')"
											>
												Delete
											</button>									</li>
								</ul>
							</div>
						</div>
						<!-- Channel content with padding for kebab menu -->
						<div class="pr-12">
							<h3 class="font-bold flex items-center gap-2">
								<svg xmlns="http://www.w3.org/2000/svg" class="h-5 w-5" viewBox="0 0 24 24" fill="currentColor" aria-hidden="true" data-icon="telegram-brand">
									<path d="M11.944 0A12 12 0 0 0 0 12a12 12 0 0 0 12 12 12 12 0 0 0 12-12A12 12 0 0 0 12 0a12 12 0 0 0-.056 0zm4.962 7.224c.1-.002.321.023.465.14a.506.506 0 0 1 .171.325c.016.093.036.306.02.472-.18 1.898-.962 6.502-1.36 8.627-.168.9-.499 1.201-.82 1.23-.696.065-1.225-.46-1.9-.902-1.056-.693-1.653-1.124-2.678-1.8-1.185-.78-.417-1.21.258-1.91.177-.184 3.247-2.977 3.307-3.23.007-.032.014-.15-.056-.212s-.174-.041-.249-.024c-.106.024-1.793 1.14-5.061 3.345-.48.33-.913.49-1.302.48-.428-.008-1.252-.241-1.865-.44-.752-.245-1.349-.374-1.297-.789.027-.216.325-.437.893-.663 3.498-1.524 5.83-2.529 6.998-3.014 3.332-1.386 4.025-1.627 4.476-1.635z"/>
								</svg>
								Telegram Bot
							</h3>
							<p class="text-sm opacity-60">
								Chat with your bot to manage tasks and get insights
							</p>
							if len(view.AuthorizedUsers) > 0 {
								<div class="mt-2 flex items-center gap-2">
									<span class="text-sm opacity-60">Authorized users:</span>
									<span class="badge badge-sm badge-ghost">
										{ fmt.Sprintf("%d user(s)", len(view.AuthorizedUsers)) }
									</span>
								</div>
							}
							<div class="mt-3 flex items-center gap-2">
								<span class={ "badge badge-sm", telegramConnectionBadge(view.IsBotRunning).Class }>{ telegramConnectionBadge(view.IsBotRunning).Label }</span>
							</div>
							<div id="test-result-telegram" class="mt-2"></div>
						</div>
					</div>
				</div>
				}

				if view.HasDiscordChannel {
					<div
						class="card bg-base-100 shadow-sm border border-base-300 cursor-pointer hover:border-primary/40 hover:shadow-md transition-all"
						data-channel-type="discord"
						data-search-card
						data-search-text={ "Discord " + discordConnectionBadge(view.DiscordStatus).Label }
						onclick="editChannelFromData(this)"
					>
						<div class="card-body relative">
							<div class="absolute top-4 right-4" onclick="event.stopPropagation()">
								<div class="dropdown dropdown-end">
									<label tabindex="0" class="btn btn-ghost btn-sm" onclick="handleDropdownToggle(event)">
										<svg xmlns="http://www.w3.org/2000/svg" class="h-4 w-4" fill="none" viewBox="0 0 24 24" stroke="currentColor"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 5v.01M12 12v.01M12 19v.01"></path></svg>
									</label>
									<ul tabindex="0" class="dropdown-content z-[100] menu p-2 shadow bg-base-100 rounded-box w-48 border border-base-300">
										<li><button type="button" onclick="openDiscordConfigModal()">Edit</button></li>
										<li><button type="button" hx-post="/channels/discord/test" hx-target="#test-result-discord" hx-swap="innerHTML">Test Connection</button></li>
										<li>
											<button
												type="button"
												class="text-error"
												data-channel-delete-name="Discord"
												data-channel-delete-url={ "/channels/discord/remove?project_id=" + view.CurrentProjectID }
												data-channel-delete-method="POST"
												onclick="openDeleteChannelConfirmFromButton(this)"
											>
												Delete
											</button>
										</li>
									</ul>
								</div>
							</div>
							<div class="pr-12">
								<h3 class="font-bold flex items-center gap-2">
									<svg xmlns="http://www.w3.org/2000/svg" class="h-5 w-5" viewBox="0 0 24 24" fill="currentColor" aria-hidden="true" data-icon="discord-brand">
										<path d="M20.317 4.37a19.79 19.79 0 0 0-4.885-1.516 13.78 13.78 0 0 0-.624 1.275 18.27 18.27 0 0 0-5.616 0 12.64 12.64 0 0 0-.632-1.275A19.74 19.74 0 0 0 3.677 4.37C.589 8.966-.247 13.45.171 17.87a19.9 19.9 0 0 0 5.993 3.03 14.24 14.24 0 0 0 1.28-2.083 12.78 12.78 0 0 1-2.017-.962c.169-.124.334-.252.493-.385a14.05 14.05 0 0 0 12.594 0c.161.133.326.261.493.385a12.78 12.78 0 0 1-2.017.962 14.2 14.2 0 0 0 1.28 2.083 19.9 19.9 0 0 0 5.993-3.03c.483-5.188-.826-9.681-3.18-13.688l-.77.188ZM8.02 15.331c-1.183 0-2.157-1.086-2.157-2.419 0-1.333.955-2.419 2.157-2.419 1.21 0 2.176 1.095 2.157 2.419 0 1.333-.955 2.419-2.157 2.419Zm7.975 0c-1.183 0-2.157-1.086-2.157-2.419 0-1.333.955-2.419 2.157-2.419 1.21 0 2.176 1.095 2.157 2.419 0 1.333-.946 2.419-2.157 2.419Z"/>
									</svg>
									Discord
								</h3>
								<p class="text-sm opacity-60">Chat with OpenVibely from Discord DMs and mentioned server channels.</p>
								if len(view.DiscordAuthorizedUsers) > 0 {
									<div class="mt-2 flex items-center gap-2">
										<span class="text-sm opacity-60">Authorized users:</span>
										<span class="badge badge-sm badge-ghost">{ fmt.Sprintf("%d user(s)", len(view.DiscordAuthorizedUsers)) }</span>
									</div>
								}
								<div class="mt-3 flex items-center gap-2">
									<span class={ "badge badge-sm", discordConnectionBadge(view.DiscordStatus).Class }>{ discordConnectionBadge(view.DiscordStatus).Label }</span>
									if view.DiscordStatus.Running {
										<span class="badge badge-sm badge-success">Gateway running</span>
									} else if view.DiscordStatus.Configured {
										<span class="badge badge-sm badge-warning">Gateway offline</span>
									}
								</div>
								if view.DiscordStatus.Configured && !view.DiscordStatus.Running && view.DiscordStatus.LastError != "" {
									<p class="mt-2 text-xs text-warning">Gateway failed to start: { view.DiscordStatus.LastError }</p>
								}
								<div id="test-result-discord" class="mt-2"></div>
							</div>
						</div>
					</div>
				}

				if view.HasEmailChannel {
					<div
						class="card bg-base-100 shadow-sm border border-base-300 cursor-pointer hover:border-primary/40 hover:shadow-md transition-all"
						data-channel-type="email"
						data-search-card
						data-search-text={ "Email " + view.EmailStatus.Address }
						onclick="openEmailConfigModal()"
					>
						<div class="card-body relative">
							<div class="absolute top-4 right-4" onclick="event.stopPropagation()">
								<div class="dropdown dropdown-end">
									<label tabindex="0" class="btn btn-ghost btn-sm" onclick="handleDropdownToggle(event)">
										<svg xmlns="http://www.w3.org/2000/svg" class="h-4 w-4" fill="none" viewBox="0 0 24 24" stroke="currentColor"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 5v.01M12 12v.01M12 19v.01"></path></svg>
									</label>
									<ul tabindex="0" class="dropdown-content z-[100] menu p-2 shadow bg-base-100 rounded-box w-48 border border-base-300">
										<li><button type="button" onclick="openEmailConfigModal()">Edit</button></li>
										<li><button type="button" hx-post="/channels/email/test" hx-target="#test-result-email" hx-swap="innerHTML">Test Connection</button></li>
										<li><button type="button" class="text-error" onclick="openDeleteChannelConfirm('Email', '/channels/email/remove', 'POST')">Delete</button></li>
									</ul>
								</div>
							</div>
							<div class="pr-12">
								<h3 class="font-bold flex items-center gap-2">
									<svg xmlns="http://www.w3.org/2000/svg" class="h-5 w-5" fill="none" viewBox="0 0 24 24" stroke="currentColor"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M3 8l7.89 5.26a2 2 0 002.22 0L21 8m-18 8h18a2 2 0 002-2V8a2 2 0 00-2-2H3a2 2 0 00-2 2v6a2 2 0 002 2z"></path></svg>
									Email
								</h3>
								<p class="text-sm opacity-60">Poll a dedicated IMAP inbox and reply by SMTP.</p>
								if view.EmailStatus.Address != "" {
									<p class="text-sm opacity-60">Inbox: { view.EmailStatus.Address }</p>
								}
								<div class="mt-2 flex items-center gap-2">
									<span class="text-sm opacity-60">Authorized senders:</span>
									<span class="badge badge-sm badge-ghost">{ fmt.Sprintf("%d sender(s)", len(view.EmailAuthorizedSenders)) }</span>
								</div>
								<div class="mt-3 flex items-center gap-2">
									<span class={ "badge badge-sm", emailConnectionBadge(view.EmailStatus).Class }>{ emailConnectionBadge(view.EmailStatus).Label }</span>
								</div>
								<div id="test-result-email" class="mt-2"></div>
							</div>
						</div>
					</div>
				}
				for _, wh := range view.Webhooks {
					<!-- Webhook Card -->
					<div
						class="card bg-base-100 shadow-sm border border-base-300 cursor-pointer hover:border-primary/40 hover:shadow-md transition-all"
						data-channel-type="webhook"
						data-search-card
						data-search-text={ "Webhook " + wh.Name }
						data-webhook-id={ wh.ID }
						data-webhook-name={ wh.Name }
						data-webhook-enabled={ fmt.Sprintf("%t", wh.Enabled) }
						data-webhook-token={ wh.PathToken }
							data-webhook-default-priority={ fmt.Sprintf("%d", wh.DefaultPriority) }
						onclick={ templ.ComponentScript{Call: fmt.Sprintf("openWebhookEditModal('%s')", wh.ID)} }
				>
				<div class="card-body relative">
					<div class="absolute top-4 right-4" onclick="event.stopPropagation()">
						<div class="dropdown dropdown-end">
							<label tabindex="0" class="btn btn-ghost btn-sm" onclick="handleDropdownToggle(event)">
								<svg xmlns="http://www.w3.org/2000/svg" class="h-4 w-4" fill="none" viewBox="0 0 24 24" stroke="currentColor">
									<path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 5v.01M12 12v.01M12 19v.01M12 6a1 1 0 110-2 1 1 0 010 2zm0 7a1 1 0 110-2 1 1 0 010 2z"></path>
								</svg>
							</label>
							<ul tabindex="0" class="dropdown-content z-[100] menu p-2 shadow bg-base-100 rounded-box w-48 border border-base-300">
								<li><button type="button" onclick={ templ.ComponentScript{Call: fmt.Sprintf("openWebhookEditModal('%s')", wh.ID)} }>Edit</button></li>									<li>
										<button
											type="button"
											hx-post={ "/channels/webhooks/" + wh.ID + "/rotate-secret" }
											hx-swap="none"
											hx-confirm="Rotate the secret for this webhook? Existing integrations will need to be updated."
										>
											Rotate Secret
										</button>
									</li>
									<li>
										<button
											type="button"
											hx-post={ "/channels/webhooks/" + wh.ID + "/test" }
											hx-target={ "#webhook-test-" + wh.ID }
											hx-swap="innerHTML"
										>
											Test
										</button>
									</li>
									<li>
											<button
												type="button"
												class="text-error"
												data-channel-delete-name={ wh.Name }
												data-channel-delete-url={ "/channels/webhooks/" + wh.ID }
												data-channel-delete-method="DELETE"
												onclick="openDeleteChannelConfirmFromButton(this)"
											>
												Delete
											</button>									</li>
								</ul>
							</div>
						</div>
						<div class="pr-12">
							<h3 class="font-bold flex items-center gap-2">
								<svg xmlns="http://www.w3.org/2000/svg" class="h-5 w-5" fill="none" viewBox="0 0 24 24" stroke="currentColor">
									<path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M13 10V3L4 14h7v7l9-11h-7z"></path>
								</svg>
								{ wh.Name }
								</h3>
								<div class="mt-2 flex items-center gap-2">
									if wh.Enabled {
										<span class="badge badge-sm badge-success">Active</span>
									} else {
										<span class="badge badge-sm badge-ghost">Disabled</span>
									}
								</div>
								<div class="mt-2" onclick="event.stopPropagation()">
									<button type="button" class="btn btn-xs" onclick={ templ.ComponentScript{Call: fmt.Sprintf("copyWebhookEndpointUrl('%s', this)", wh.ID)} }>Copy URL</button>
								</div>
							<div id={ "webhook-test-" + wh.ID } class="mt-2"></div>
						</div>
					</div>
				</div>
			}
				if !view.HasGitHubChannel && !view.HasTelegramChannel && !view.HasSlackChannel && !view.HasDiscordChannel && !view.HasEmailChannel && len(view.Webhooks) == 0 {
					<div class="card bg-base-100 shadow-sm border border-dashed border-base-300" data-search-card data-search-text="No channels added yet">
						<div class="card-body">
							<h3 class="font-semibold">No channels added yet</h3>
							<p class="text-sm opacity-70">Use `Add Channel` to configure GitHub, Slack, Discord, Telegram Bot, Email, or Webhooks.</p>
						</div>
					</div>
				}		</div>

					@OutboundTargetsModal(view.CurrentProjectID, view.ChannelTargets, view.SendMessageExplicitTargets)
			<dialog id="delete_channel_confirm_modal" class="modal">
				<div class="modal-box">
					<button type="button" class="btn btn-circle btn-ghost btn-xs ov-modal-close" onclick="closeDeleteChannelConfirm()" aria-label="Close delete confirmation" title="Close delete confirmation">
						<svg xmlns="http://www.w3.org/2000/svg" class="h-4 w-4" fill="none" viewBox="0 0 24 24" stroke="currentColor" aria-hidden="true"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M6 18L18 6M6 6l12 12"></path></svg>
					</button>
					<h3 class="font-bold text-lg text-error pr-10">Delete Channel</h3>
					<p class="py-4">
						Are you sure you want to delete <span id="delete_channel_name" class="font-semibold">this channel</span>? This action cannot be undone.
					</p>
					<div class="modal-action">
						<button type="button" class="btn" onclick="closeDeleteChannelConfirm()">Cancel</button>
						<button type="button" class="btn btn-error" onclick="confirmDeleteChannel()">Delete Channel</button>
					</div>
				</div>
				<form method="dialog" class="modal-backdrop">
					<button>close</button>
				</form>
			</dialog>

			<!-- Channel Configuration Modal -->
			<dialog id="channel_modal" class="modal">			<div class="modal-box max-w-2xl">
				<button type="button" class="btn btn-circle btn-ghost btn-xs ov-modal-close" onclick="closeChannelModal()" aria-label="Close channel configuration" title="Close channel configuration">
					<svg xmlns="http://www.w3.org/2000/svg" class="h-4 w-4" fill="none" viewBox="0 0 24 24" stroke="currentColor" aria-hidden="true"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M6 18L18 6M6 6l12 12"></path></svg>
				</button>
				<h3 id="channel_modal_title" class="font-bold text-lg mb-4 pr-10">Configure Telegram Bot</h3>
				<form id="channel_form" method="post" action="/channels/telegram" hx-post="/channels/telegram" hx-swap="none">
					<div class="form-control mb-4">
						<label class="label">
							<span class="label-text">Bot Token</span>
						</label>
							@components.SecretInput(components.SecretInputConfig{
								ID:           "channel_telegram_token",
								Name:         "token",
								Class:        "input input-bordered w-full pr-10",
								Placeholder:  "123456789:ABCdefGHIjklMNOpqrsTUVwxyz",
								AutoComplete: "off",
								AriaLabel:    "Toggle token visibility",
								Required:     true,
							})
						<label class="label">
							<span class="label-text-alt opacity-70">
								Get your bot token from <a href="https://t.me/BotFather" target="_blank" class="link">BotFather</a>
							</span>
						</label>
					</div>

					<!-- Help Section -->
					<div class="alert alert-info mb-4">
						<svg xmlns="http://www.w3.org/2000/svg" fill="none" viewBox="0 0 24 24" class="stroke-current shrink-0 w-6 h-6">
							<path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M13 16h-1v-4h-1m1-4h.01M21 12a9 9 0 11-18 0 9 9 0 0118 0z"></path>
						</svg>
						<div>
							<p class="font-semibold text-sm">How to Use the Bot</p>
							<p class="text-xs opacity-80 mt-1">
								Send natural language messages to your bot just like the Chat page. The bot can answer questions, create tasks, view execution output, and more.
							</p>
							<details class="text-xs opacity-70 mt-2">
								<summary class="cursor-pointer hover:opacity-100">Optional slash command shortcuts</summary>
								<ul class="list-disc list-inside space-y-1 ml-2 mt-2">
									<li><code class="bg-base-300 px-1 rounded">/start</code> - Welcome message and project setup</li>
									<li><code class="bg-base-300 px-1 rounded">/projects</code> - List all projects</li>
									<li><code class="bg-base-300 px-1 rounded">/switch &lt;project_id&gt;</code> - Switch active project</li>
								</ul>
							</details>
						</div>
					</div>

					<!-- Authorized Users Section -->
					if view.CurrentProjectID != "" {
						<div class="divider"></div>
						<h4 class="font-semibold text-sm mb-2 flex items-center gap-2">
							<svg xmlns="http://www.w3.org/2000/svg" class="h-4 w-4" fill="none" viewBox="0 0 24 24" stroke="currentColor">
								<path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 15v2m-6 4h12a2 2 0 002-2v-6a2 2 0 00-2-2H6a2 2 0 00-2 2v6a2 2 0 002 2zm10-10V7a4 4 0 00-8 0v4h8z"></path>
							</svg>
							Authorized Users
						</h4>
						<p class="text-xs opacity-50 mb-3">
							Authorized Telegram users are system-level for this channel and can use Telegram across projects. If no users are added, the bot is open to everyone. Outbound Message Targets remain project-specific.
						</p>
						@components.TelegramAuthorizedUsersList(view.AuthorizedUsers, view.CurrentProjectID)
					}

					<!-- Notification Settings -->
					<div class="divider"></div>
					<h4 class="font-semibold text-sm mb-2 flex items-center gap-2">
						<svg xmlns="http://www.w3.org/2000/svg" class="h-4 w-4" fill="none" viewBox="0 0 24 24" stroke="currentColor">
							<path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M15 17h5l-1.405-1.405A2.032 2.032 0 0118 14.158V11a6.002 6.002 0 00-4-5.659V5a2 2 0 10-4 0v.341C7.67 6.165 6 8.388 6 11v3.159c0 .538-.214 1.055-.595 1.436L4 17h5m6 0v1a3 3 0 11-6 0v-1m6 0H9"></path>
						</svg>
						Notification Settings
					</h4>
					<div class="form-control">
						<label class="label cursor-pointer justify-start gap-3">
							<input
								type="checkbox"
								class="toggle toggle-primary"
								if view.SendResponses {
									checked
								}
								hx-post="/channels/telegram/send-responses"
								hx-swap="none"
								hx-trigger="change"
								hx-include="this"
								name="enabled"
								value="true"
							/>
							<div>
								<span class="label-text font-semibold">Send task responses to Telegram</span>
								<p class="text-xs opacity-50 mt-1">
									When tasks created via Telegram complete or fail, send the result back to the user who created them
								</p>
							</div>
						</label>
					</div>
					<div class="form-control mt-3">
						<label class="label cursor-pointer justify-start gap-3">
							<input
								id="channel_telegram_rich_messages_v2"
								type="checkbox"
								class="toggle toggle-primary"
								if view.RichMessagesV2 {
									checked
								}
								name="telegram_rich_messages_v2"
								value="true"
							/>
							<div>
								<span class="label-text font-semibold">Telegram Rich Messages V2</span>
								<p class="text-xs opacity-50 mt-1">
									Use Telegram Bot API 10.1 rich formatting for assistant responses when supported.
								</p>
							</div>
						</label>
					</div>

					<div class="modal-action">
						<button type="button" class="btn" onclick="closeChannelModal()">Cancel</button>
						<button type="submit" id="channel_submit_btn" class="btn btn-primary">Save & Start Bot</button>
					</div>
				</form>
			</div>
			<form method="dialog" class="modal-backdrop">
				<button>close</button>
			</form>
		</dialog>

		<dialog id="github_config_modal" class="modal">
			<div class="modal-box max-w-2xl">
				<button type="button" class="btn btn-circle btn-ghost btn-xs ov-modal-close" onclick="closeGitHubConfigModal()" aria-label="Close GitHub configuration" title="Close GitHub configuration">
					<svg xmlns="http://www.w3.org/2000/svg" class="h-4 w-4" fill="none" viewBox="0 0 24 24" stroke="currentColor" aria-hidden="true"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M6 18L18 6M6 6l12 12"></path></svg>
				</button>
				<h3 class="font-bold text-lg mb-4 pr-10">Configure GitHub</h3>
				<form id="github_config_form" method="post" action="/channels/github/configure" hx-post="/channels/github/configure" hx-swap="none">
					<div class="form-control mb-4">
						<label class="label"><span class="label-text">Authentication</span></label>
						<select id="github_auth_mode" name="github_auth_mode" class="select select-bordered w-full" onchange="toggleGitHubAuthMode(this.value)">
							<option value={ service.GitHubAuthModePAT } if view.GitHubAuthMode == service.GitHubAuthModePAT { selected }>Personal Access Token (Recommended)</option>
							<option value={ service.GitHubAuthModeApp } if view.GitHubAuthMode == service.GitHubAuthModeApp { selected }>GitHub App (Advanced)</option>
						</select>
						<label class="label">
							<span class="label-text-alt opacity-70">Use PAT for local/self-hosted installs. Use GitHub App for centralized cloud deployments.</span>
						</label>
					</div>

					<div id="github_pat_section">
						<div class="alert alert-info mb-3 text-sm">
							PAT mode is the fastest setup for local open-source usage. Create a token with repository read/write and pull request permissions.
						</div>
						<div class="form-control mb-3">
							<label class="label"><span class="label-text">GitHub Personal Access Token</span></label>
							@components.SecretInput(components.SecretInputConfig{
								ID:           "github_pat",
								Name:         "github_pat",
								Value:        view.GitHubPATValue,
								Class:        "input input-bordered w-full pr-10 font-mono text-xs",
								Placeholder:  githubPATPlaceholder(view.GitHubHasPAT),
								AutoComplete: "off",
								AriaLabel:    "Toggle token visibility",
							})
						</div>
					</div>

					<div id="github_app_section">
						<div class="alert mb-3 text-sm">
							GitHub App mode is for advanced/cloud deployments where one app installation is shared by your deployment.
						</div>
						<div class="form-control mb-3">
							<label class="label"><span class="label-text">GitHub App ID</span></label>
							<input type="text" name="github_app_id" class="input input-bordered" value={ view.GitHubAppID }/>
						</div>
						<div class="form-control mb-3">
							<label class="label"><span class="label-text">GitHub App Slug</span></label>
							<input type="text" name="github_app_slug" class="input input-bordered" value={ view.GitHubAppSlug }/>
						</div>
						<div class="form-control mb-3">
							<label class="label"><span class="label-text">GitHub App Private Key (PEM)</span></label>
							<div class="relative">
								<textarea
									id="github_app_private_key"
									name="github_app_private_key"
									class="textarea textarea-bordered h-40 w-full pr-10 font-mono text-xs secret-textarea-masked"
									placeholder={ githubPrivateKeyPlaceholder(view.GitHubHasPrivateKey) }
								>{ view.GitHubPrivateKeyValue }</textarea>
								<button
									type="button"
									class="password-toggle-btn btn btn-ghost btn-sm absolute right-1 top-2 h-8 min-h-0 px-2"
									onclick="toggleSecretTextareaVisibility('github_app_private_key', this)"
									aria-label="Toggle private key visibility"
									aria-pressed="false"
								>
									<svg class="eye-open h-4 w-4 hidden" xmlns="http://www.w3.org/2000/svg" fill="none" viewBox="0 0 24 24" stroke="currentColor">
										<path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M15 12a3 3 0 11-6 0 3 3 0 016 0z"/>
										<path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M2.458 12C3.732 7.943 7.523 5 12 5c4.478 0 8.268 2.943 9.542 7-1.274 4.057-5.064 7-9.542 7-4.477 0-8.268-2.943-9.542-7z"/>
									</svg>
									<svg class="eye-closed h-4 w-4" xmlns="http://www.w3.org/2000/svg" fill="none" viewBox="0 0 24 24" stroke="currentColor">
										<path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M13.875 18.825A10.05 10.05 0 0112 19c-4.478 0-8.268-2.943-9.543-7a9.97 9.97 0 011.563-3.029m5.858.908a3 3 0 114.243 4.243M9.878 9.878l4.242 4.242M9.88 9.88l-3.29-3.29m7.532 7.532l3.29 3.29M3 3l3.59 3.59m0 0A9.953 9.953 0 0112 5c4.478 0 8.268 2.943 9.543 7a10.025 10.025 0 01-4.132 5.411m0 0L21 21"/>
									</svg>
								</button>
							</div>
						</div>
					</div>
					<div class="divider"></div>
					<div class="form-control mb-3">
						<label class="label"><span class="label-text">GitHub API endpoint</span></label>
						<input
							type="url"
							name="github_api_endpoint"
							class="input input-bordered"
							value={ view.GitHubAPIEndpoint }
							placeholder="https://api.github.com"
						/>
					</div>
					if view.CurrentProjectID != "" {
						<div class="divider"></div>
						<div
							id="github-runtime-settings"
							hx-get={ "/channels/github/runtime-settings?project_id=" + view.CurrentProjectID }
							hx-trigger="load"
							hx-target="this"
							hx-swap="outerHTML"
						>
							<div class="flex items-center gap-2 text-sm opacity-70">
								<span class="loading loading-spinner loading-xs"></span>
								<span>Loading GitHub runtime settings...</span>
							</div>
						</div>
					}
					<div class="modal-action sticky bottom-0 z-10 border-t border-base-300 bg-base-100 py-3">
						<button type="button" class="btn" onclick="closeGitHubConfigModal()">Cancel</button>
						<button type="submit" class="btn btn-primary">Save GitHub Settings</button>
					</div>
				</form>
			</div>
			<form method="dialog" class="modal-backdrop">
				<button>close</button>
			</form>
		</dialog>

		<dialog id="slack_config_modal" class="modal">
			<div class="modal-box max-w-2xl">
				<button type="button" class="btn btn-circle btn-ghost btn-xs ov-modal-close" onclick="closeSlackConfigModal()" aria-label="Close Slack configuration" title="Close Slack configuration">
					<svg xmlns="http://www.w3.org/2000/svg" class="h-4 w-4" fill="none" viewBox="0 0 24 24" stroke="currentColor" aria-hidden="true"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M6 18L18 6M6 6l12 12"></path></svg>
				</button>
				<h3 class="font-bold text-lg mb-4 pr-10">Configure Slack</h3>
				<form id="slack_config_form" method="post" action="/channels/slack/configure" hx-post="/channels/slack/configure" hx-swap="none">
					<div class="alert alert-info mb-4 text-sm">
						<div>
							<p class="font-semibold">Use OAuth + Socket Mode</p>
							<p class="mt-1 opacity-80">Configure `Client ID`, `Client Secret`, and `App-Level Token (xapp-...)`, then click Connect from the Slack card.</p>
							<p class="mt-1 opacity-80">If Slack blocks local OAuth with “use a complete URL beginning with https”, either use an HTTPS tunnel callback URL or select `Manual Override Token` mode with an `xoxb-...` token.</p>
						</div>
					</div>
					<div class="form-control mb-3">
						<label class="label"><span class="label-text">Client ID</span></label>
						<input type="text" name="slack_client_id" class="input input-bordered" value={ view.SlackClientID } placeholder={ slackSecretPlaceholder(view.SlackHasClientID, "Client ID") }/>
					</div>
					<div class="form-control mb-3">
						<label class="label"><span class="label-text">Client Secret</span></label>
						@components.SecretInput(components.SecretInputConfig{
							ID:           "slack_client_secret",
							Name:         "slack_client_secret",
							Value:        view.SlackClientSecret,
							Class:        "input input-bordered w-full pr-10 font-mono text-xs",
							Placeholder:  slackSecretPlaceholder(view.SlackHasClientSecret, "Client Secret"),
							AutoComplete: "off",
							AriaLabel:    "Toggle client secret visibility",
						})
					</div>
					<div class="form-control mb-3">
						<label class="label"><span class="label-text">App-Level Token (xapp-...)</span></label>
						@components.SecretInput(components.SecretInputConfig{
							ID:           "slack_app_token",
							Name:         "slack_app_token",
							Value:        view.SlackAppToken,
							Class:        "input input-bordered w-full pr-10 font-mono text-xs",
							Placeholder:  slackSecretPlaceholder(view.SlackHasAppToken, "App-Level Token"),
							AutoComplete: "off",
							AriaLabel:    "Toggle app token visibility",
						})
					</div>
					<div class="form-control mb-3">
						<label class="label"><span class="label-text">Bot Token Source</span></label>
						<select
							id="slack_bot_token_mode"
							name="slack_bot_token_mode"
							class="select select-bordered w-full"
							onchange="toggleSlackBotTokenMode(this.value)"
						>
							<option value={ service.SlackBotTokenSourceOAuth } if view.SlackBotTokenMode == service.SlackBotTokenSourceOAuth { selected }>
								OAuth Callback Token (Recommended)
							</option>
							<option value={ service.SlackBotTokenSourceManual } if view.SlackBotTokenMode == service.SlackBotTokenSourceManual { selected }>
								Manual Override Token
							</option>
						</select>
						<label class="label">
							<span class="label-text-alt opacity-70">
								OAuth mode uses the token returned by Connect. Manual mode uses a fixed `xoxb-...` override token.
							</span>
						</label>
					</div>
					<div id="slack_bot_token_override_section" class="form-control mb-3">
						<label class="label"><span class="label-text">Bot Token Override (xoxb-...)</span></label>
						@components.SecretInput(components.SecretInputConfig{
							ID:           "slack_bot_token",
							Name:         "slack_bot_token",
							Value:        view.SlackBotToken,
							Class:        "input input-bordered w-full pr-10 font-mono text-xs",
							Placeholder:  slackSecretPlaceholder(view.SlackHasBotToken, "Bot Token"),
							AutoComplete: "off",
							AriaLabel:    "Toggle bot token visibility",
						})
					</div>
					if view.CurrentProjectID != "" {
						<div class="divider"></div>
						<h4 class="font-semibold text-sm mb-2 flex items-center gap-2">
							<svg xmlns="http://www.w3.org/2000/svg" class="h-4 w-4" fill="none" viewBox="0 0 24 24" stroke="currentColor">
								<path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 15v2m-6 4h12a2 2 0 002-2v-6a2 2 0 00-2-2H6a2 2 0 00-2 2v6a2 2 0 002 2zm10-10V7a4 4 0 00-8 0v4h8z"></path>
							</svg>
							Authorized Users
						</h4>
						<p class="text-xs opacity-50 mb-3">
							Authorized Slack users are system-level for this channel and can use Slack across projects. If no users are configured, access is denied until authorized users are added. Outbound Message Targets remain project-specific.
						</p>
						@components.SlackAuthorizedUsersList(view.SlackAuthorizedUsers, view.CurrentProjectID)
					}
					<div class="divider"></div>
					<h4 class="font-semibold text-sm mb-2 flex items-center gap-2">
						<svg xmlns="http://www.w3.org/2000/svg" class="h-4 w-4" fill="none" viewBox="0 0 24 24" stroke="currentColor">
							<path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M15 17h5l-1.405-1.405A2.032 2.032 0 0118 14.158V11a6.002 6.002 0 00-4-5.659V5a2 2 0 10-4 0v.341C7.67 6.165 6 8.388 6 11v3.159c0 .538-.214 1.055-.595 1.436L4 17h5m6 0v1a3 3 0 11-6 0v-1m6 0H9"></path>
						</svg>
						Notification Settings
					</h4>
					<div class="form-control mb-4">
						<label class="label cursor-pointer justify-start gap-3">
							<input type="checkbox" class="checkbox checkbox-primary" name="slack_send_responses" value="true" if view.SlackSendResponses { checked }/>
							<span class="label-text">Send task completion/failure notifications for Slack-created tasks</span>
						</label>
					</div>
					<div class="modal-action">
						<button type="button" class="btn" onclick="closeSlackConfigModal()">Cancel</button>
						<button type="submit" class="btn btn-primary">Save Slack Settings</button>
					</div>
				</form>
			</div>
			<form method="dialog" class="modal-backdrop">
				<button>close</button>
			</form>
			</dialog>

		<dialog id="discord_config_modal" class="modal" onclose="resetDiscordConfigForm()">
			<div class="modal-box max-w-2xl">
				<button type="button" class="btn btn-circle btn-ghost btn-xs ov-modal-close" onclick="closeDiscordConfigModal()" aria-label="Close Discord configuration" title="Close Discord configuration">×</button>
				<h3 class="font-bold text-lg mb-4 pr-10">Configure Discord</h3>
					<form id="discord_config_form" method="post" action="/channels/discord/configure" hx-post="/channels/discord/configure" hx-swap="none">
						<div class="alert alert-info mb-4 text-sm">
						<div>
							<p class="font-semibold">Use a Discord bot token</p>
							<p class="mt-1 opacity-80">Create a Discord application bot, enable message content intent, invite it to your server, then add its token here.</p>
							<p class="mt-1 opacity-80">DMs are supported. In guild channels, users must mention the bot.</p>
						</div>
					</div>
					<div class="form-control mb-3">
						<label class="label"><span class="label-text">Bot Token</span></label>
						@components.SecretInput(components.SecretInputConfig{
							ID: "discord_bot_token",
							Name: "discord_bot_token",
							Value: view.DiscordBotToken,
							Class: "input input-bordered w-full pr-10 font-mono text-xs",
							Placeholder: "Leave blank to keep existing token, or paste a new token to rotate.",
							AutoComplete: "off",
							AriaLabel: "Toggle bot token visibility",
						})
					</div>
					if view.CurrentProjectID != "" {
						<div class="divider"></div>
						<h4 class="font-semibold text-sm mb-2">Authorized Users</h4>
						<p class="text-xs opacity-50 mb-3">Authorized Discord users are system-level for this channel and can use Discord across projects. If no users are configured, access is denied until authorized users are added. Outbound Message Targets remain project-specific.</p>
						@components.DiscordAuthorizedUsersList(view.DiscordAuthorizedUsers, view.CurrentProjectID)
					}
					<div class="divider"></div>
					<label class="label cursor-pointer justify-start gap-3">
						<input type="checkbox" class="checkbox checkbox-primary" name="discord_send_responses" value="true" if view.DiscordSendResponses { checked }/>
						<span class="label-text">Send task completion/failure notifications for Discord-created tasks</span>
					</label>
					<div class="modal-action">
						<button type="button" class="btn btn-ghost" onclick="closeDiscordConfigModal()">Cancel</button>
						<button type="submit" class="btn btn-primary">Save Discord</button>
					</div>
				</form>
			</div>
			<form method="dialog" class="modal-backdrop"><button onclick="closeDiscordConfigModal()">close</button></form>
		</dialog>

			<dialog id="email_config_modal" class="modal">
				<div class="modal-box max-w-2xl">
					<button type="button" class="btn btn-circle btn-ghost btn-xs ov-modal-close" onclick="closeEmailConfigModal()" aria-label="Close Email configuration" title="Close Email configuration">
						<svg xmlns="http://www.w3.org/2000/svg" class="h-4 w-4" fill="none" viewBox="0 0 24 24" stroke="currentColor" aria-hidden="true"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M6 18L18 6M6 6l12 12"></path></svg>
					</button>
					<h3 class="font-bold text-lg mb-4 pr-10">Configure Email</h3>
					<form id="email_config_form" method="post" action="/channels/email/configure" hx-post="/channels/email/configure" hx-swap="none">
						<div class="alert alert-info mb-4 text-sm">
							<div>
								<p class="font-semibold">Use a dedicated inbox</p>
								<p class="mt-1 opacity-80" id="email_provider_help">Use an app password where your email provider requires one. Inbound messages are accepted only from authorized senders.</p>
							</div>
						</div>
						<div class="form-control mb-3">
							<label class="label"><span class="label-text">Provider</span></label>
							<select id="email_provider" name="email_provider" class="select select-bordered w-full" onchange="setEmailProviderPreset(this.value, false)">
								for _, preset := range service.EmailProviderPresets() {
									<option value={ preset.Key } data-imap-host={ preset.IMAPHost } data-imap-port={ fmt.Sprintf("%d", preset.IMAPPort) } data-smtp-host={ preset.SMTPHost } data-smtp-port={ fmt.Sprintf("%d", preset.SMTPPort) } data-help={ preset.HelpText } if view.EmailStatus.Provider == preset.Key { selected }>{ preset.Label }</option>
								}
							</select>
						</div>
						<div class="form-control mb-3">
							<label class="label"><span class="label-text">Email Address</span></label>
							<input type="email" name="email_address" class="input input-bordered" value={ view.EmailStatus.Address } placeholder="bot@example.com"/>
						</div>
						<div class="form-control mb-3">
							<label class="label"><span class="label-text">App Password</span></label>
							@components.SecretInput(components.SecretInputConfig{ID: "email_password", Name: "email_password", Value: view.EmailPasswordValue, Class: "input input-bordered w-full pr-10 font-mono text-xs", Placeholder: slackSecretPlaceholder(view.EmailPasswordValue != "", "App password"), AutoComplete: "off", AriaLabel: "Toggle email password visibility"})
						</div>
						<details id="email_advanced_details" class="collapse collapse-arrow bg-base-200 mb-3" if view.EmailStatus.Provider == service.EmailProviderCustom { open }>
							<summary class="collapse-title text-sm font-medium">Advanced IMAP/SMTP settings</summary>
							<div class="collapse-content grid grid-cols-1 md:grid-cols-2 gap-3">
								<div class="form-control">
									<label class="label"><span class="label-text">IMAP Host</span></label>
									<input id="email_imap_host" type="text" name="email_imap_host" class="input input-bordered" value={ view.EmailStatus.IMAPHost } oninput="markEmailProviderCustom()"/>
								</div>
								<div class="form-control">
									<label class="label"><span class="label-text">IMAP Port</span></label>
									<input id="email_imap_port" type="number" name="email_imap_port" class="input input-bordered" value={ fmt.Sprintf("%d", view.EmailStatus.IMAPPort) } oninput="markEmailProviderCustom()"/>
								</div>
								<div class="form-control">
									<label class="label"><span class="label-text">SMTP Host</span></label>
									<input id="email_smtp_host" type="text" name="email_smtp_host" class="input input-bordered" value={ view.EmailStatus.SMTPHost } oninput="markEmailProviderCustom()"/>
								</div>
								<div class="form-control">
									<label class="label"><span class="label-text">SMTP Port</span></label>
									<input id="email_smtp_port" type="number" name="email_smtp_port" class="input input-bordered" value={ fmt.Sprintf("%d", view.EmailStatus.SMTPPort) } oninput="markEmailProviderCustom()"/>
								</div>
							</div>
						</details>
						<div class="form-control mb-3">
							<label class="label"><span class="label-text">Poll interval seconds</span></label>
							<input type="number" min="5" name="email_poll_interval_seconds" class="input input-bordered" value={ view.EmailPollIntervalSeconds }/>
						</div>
						if view.CurrentProjectID != "" {
							<div class="divider"></div>
							<h4 class="font-semibold text-sm mb-2 flex items-center gap-2">Authorized Senders</h4>
							<p class="text-xs opacity-50 mb-3">Authorized email senders are system-level for this channel and can use Email across projects. If no senders are configured, access is denied until authorized senders are added. Outbound Message Targets remain project-specific.</p>
							@components.EmailAuthorizedSendersList(view.EmailAuthorizedSenders, view.CurrentProjectID)
						}
						<div class="divider"></div>
						<div class="space-y-2 mb-4">
							<label class="label cursor-pointer justify-start gap-3">
								<input type="checkbox" class="toggle toggle-primary" name="email_send_responses" value="true" if view.EmailSendResponses { checked }/>
								<span class="label-text">Send task completion/failure replies by email</span>
							</label>
							<label class="label cursor-pointer justify-start gap-3">
								<input type="checkbox" class="toggle toggle-primary" name="email_skip_attachments" value="true" if view.EmailSkipAttachments { checked }/>
								<span class="label-text">Skip incoming attachments</span>
							</label>
							<label class="label cursor-pointer justify-start gap-3">
								<input type="checkbox" class="toggle toggle-primary" name="email_mark_existing_seen_on_start" value="true" if view.EmailMarkExistingSeenOnStart { checked }/>
								<span class="label-text">Mark existing unread messages seen on start</span>
							</label>
						</div>
						<div class="modal-action">
							<button type="button" class="btn" onclick="closeEmailConfigModal()">Cancel</button>
							<button type="submit" class="btn btn-primary">Save Email Settings</button>
						</div>
					</form>
				</div>
				<form method="dialog" class="modal-backdrop"><button>close</button></form>
			</dialog>

			<!-- Webhook Configuration Modal -->		<dialog id="webhook_modal" class="modal">
			<div class="modal-box max-w-4xl p-0 overflow-hidden">
				<button type="button" class="btn btn-circle btn-ghost btn-xs ov-modal-close" onclick="closeWebhookModal()" aria-label="Close webhook configuration" title="Close webhook configuration">
					<svg xmlns="http://www.w3.org/2000/svg" class="h-4 w-4" fill="none" viewBox="0 0 24 24" stroke="currentColor" aria-hidden="true"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M6 18L18 6M6 6l12 12"></path></svg>
				</button>
				<div class="px-6 pt-6 pb-2 pr-14">
					<h3 id="webhook_modal_title" class="font-bold text-lg">Add Webhook</h3>
				</div>
					<form id="webhook_form" hx-post={ "/channels/webhooks?project_id=" + view.CurrentProjectID } hx-swap="none" data-project-id={ view.CurrentProjectID } data-webhook-mode="create" data-webhook-detail-ready="true" onsubmit="return submitWebhookForm(event)" class="flex flex-col h-[78vh]">
						<input type="hidden" name="project_id" value={ view.CurrentProjectID }/>
					<div class="px-6 pb-3 border-b border-base-300">
						<div role="tablist" class="tabs tabs-bordered tabs-sm w-full overflow-x-auto flex-nowrap">
							<button type="button" role="tab" class="tab tab-active" data-webhook-section-tab="config" aria-selected="true" onclick="setWebhookSection('config')">Webhook Config</button>
							<button type="button" role="tab" class="tab" data-webhook-section-tab="agents" aria-selected="false" onclick="setWebhookSection('agents')">Agents</button>
						</div>
					</div>

					<div class="flex-1 min-h-0 px-6 py-3">
						<div data-webhook-section-panel="config" class="h-full overflow-y-auto pr-1">
							<div class="form-control mb-3">
								<label class="label"><span class="label-text">Name</span></label>
								<input type="text" id="webhook_name" name="name" class="input input-bordered w-full" placeholder="e.g. PagerDuty Alerts" required/>
							</div>
							<div class="form-control mb-3">
								<label class="label cursor-pointer justify-start gap-2">
									<input type="checkbox" id="webhook_enabled" name="enabled" value="true" class="toggle toggle-primary" checked/>
									<span class="label-text">Enabled</span>
								</label>
							</div>
							<div class="form-control mb-3" id="webhook_url_row" style="display:none">
								<label class="label"><span class="label-text">Webhook URL</span></label>
								<div class="join w-full">
									<div class="text-sm font-mono bg-base-200 p-2 rounded-l break-all join-item flex-1" id="webhook_url_display">
										(Save first to generate URL)
									</div>
									<button type="button" class="btn btn-sm join-item" id="webhook_url_copy_btn" onclick="copyWebhookAbsoluteUrl('webhook_url_display', this)">Copy</button>
								</div>
							</div>
								<div class="form-control mb-3" id="webhook_secret_row" style="display:none">
									<label class="label"><span class="label-text">Secret</span></label>
									@components.SecretInput(components.SecretInputConfig{
										ID:           "webhook_secret_display",
										Class:        "input input-bordered w-full pr-10 font-mono text-sm",
										Placeholder:  "(Secret is set on creation)",
										AutoComplete: "off",
										AriaLabel:    "Toggle secret visibility",
										ReadOnly:     true,
									})
									</div>
									<div class="form-control mb-3">
										<label class="label"><span class="label-text">System Instructions</span></label>								<textarea id="webhook_system_instructions" name="system_instructions" class="textarea textarea-bordered w-full h-20" placeholder="Optional system context for the agent..."></textarea>
							</div>
							<div class="form-control mb-3">
								<label class="label"><span class="label-text">Default Priority</span></label>
								<select id="webhook_default_priority" name="default_priority" class="select select-bordered w-full">
									<option value="1">Low</option>
									<option value="2" selected>Normal</option>
									<option value="3">High</option>
									<option value="4">Urgent</option>
								</select>
							</div>
							<div class="form-control mb-3">
								<label class="label"><span class="label-text">Title Template</span></label>
								<input type="text" id="webhook_title_template" name="title_template" class="input input-bordered w-full" placeholder="Optional task title template"/>
							</div>
							<div class="form-control mb-3">
								<label class="label"><span class="label-text">Prompt Template</span></label>
								<textarea id="webhook_prompt_template" name="prompt_template" class="textarea textarea-bordered w-full h-24" placeholder="Optional task prompt template"></textarea>
							</div>
						</div>

						<div data-webhook-section-panel="agents" class="h-full overflow-y-auto pr-1 hidden">
							<div class="space-y-3">
								<div class="border border-base-300 rounded-lg p-3">
									<div class="flex items-center justify-between mb-2">
										<p class="text-sm font-medium">Agents</p>
										<p id="webhook_agent_selected_count" class="text-xs opacity-60">No agents selected</p>
									</div>
									<div class="mb-2">
										<input
											type="text"
											id="webhook_agent_search_input"
											class="input input-bordered input-sm w-full"
											placeholder="Search agents by name"
											oninput="renderWebhookAgentList()"
										/>
									</div>
									<div id="webhook_agent_list" class="space-y-2 max-h-[500px] overflow-auto"></div>
								</div>
							</div>
						</div>
					</div>
					<input type="hidden" id="webhook_agent_ids_hidden" name="agent_ids"/>

					<div class="modal-action mt-0 sticky bottom-0 z-10 border-t border-base-300 bg-base-100 px-6 py-3">
						<form method="dialog" class="inline">
							<button type="button" class="btn" onclick="closeWebhookModal()">Cancel</button>
						</form>
						<button type="submit" id="webhook_submit_button" class="btn btn-primary">Save Webhook</button>
					</div>
				</form>
			</div>
		<form method="dialog" class="modal-backdrop">
			<button>close</button>
		</form>
	</dialog>

	<!-- Webhook available agents data for JavaScript -->
	<div id="webhook_agents_data" data-agents={ agentsJSON(view.AgentPickerOptions) } style="display:none"></div>

		<style>
			/* Keep password toggle button fixed inside input across press/focus states */
			.password-toggle-btn:active,
			.password-toggle-btn:focus,
			.password-toggle-btn:focus-visible {
				transform: translate(0, -50%) !important;
			}
			.password-toggle-btn.top-2:active,
			.password-toggle-btn.top-2:focus,
			.password-toggle-btn.top-2:focus-visible {
				transform: translate(0, 0) !important;
			}
			.secret-textarea-masked {
				-webkit-text-security: disc;
			}
		</style>

			<script>
				var pendingDeleteChannelURL = '';
				var pendingDeleteChannelMethod = 'POST';

				function openDeleteChannelConfirm(name, url, method) {
					pendingDeleteChannelURL = url || '';
					pendingDeleteChannelMethod = method || 'POST';
					var nameEl = document.getElementById('delete_channel_name');
					if (nameEl) nameEl.textContent = name || 'this channel';
					document.getElementById('delete_channel_confirm_modal')?.showModal();
				}

				function openDeleteChannelConfirmFromButton(button) {
					if (!button) return;
					openDeleteChannelConfirm(button.dataset.channelDeleteName, button.dataset.channelDeleteUrl, button.dataset.channelDeleteMethod);
				}

				function closeDeleteChannelConfirm() {
					document.getElementById('delete_channel_confirm_modal')?.close();
				}

				function confirmDeleteChannel() {
					if (!pendingDeleteChannelURL) return;
					htmx.ajax(pendingDeleteChannelMethod, pendingDeleteChannelURL, { swap: 'none' });
					closeDeleteChannelConfirm();
				}

					// Webhook agent state
					var webhookAvailableAgents = [];
					var selectedWebhookAgentIDs = [];
					var activeWebhookSection = 'config';
					var webhookEditRequestGeneration = 0;

				function setWebhookSubmitState(enabled, label) {
					var button = document.getElementById('webhook_submit_button');
					if (!button) return;
					button.disabled = !enabled;
					button.classList.toggle('btn-disabled', !enabled);
					button.textContent = label || 'Save Webhook';
				}

				function submitWebhookForm(event) {
					var form = document.getElementById('webhook_form');
					if (form && form.dataset.webhookMode === 'edit' && form.dataset.webhookDetailReady !== 'true') {
						if (event) event.preventDefault();
						if (window.showToast) window.showToast('Webhook details are still loading', 'failed');
						return false;
					}
					serializeWebhookAgentData();
					return true;
				}

				function setWebhookSection(sectionName) {
					const sectionNameMap = {
					config: 'config',
					agents: 'agents'
				};
				const nextSection = sectionNameMap[sectionName] || 'config';
				activeWebhookSection = nextSection;
				document.querySelectorAll('[data-webhook-section-tab]').forEach(tab => {
					const isActive = tab.dataset.webhookSectionTab === nextSection;
					tab.classList.toggle('tab-active', isActive);
					tab.setAttribute('aria-selected', isActive ? 'true' : 'false');
				});
				document.querySelectorAll('[data-webhook-section-panel]').forEach(panel => {
					panel.classList.toggle('hidden', panel.dataset.webhookSectionPanel !== nextSection);
				});
			}

			function renderWebhookAgentList() {
				const root = document.getElementById('webhook_agent_list');
				if (!root) return;

				const searchTerm = (document.getElementById('webhook_agent_search_input')?.value || '').toLowerCase();
				const filteredAgents = webhookAvailableAgents.filter(agent => {
					if (!searchTerm) return true;
					return (agent.name || '').toLowerCase().includes(searchTerm) ||
						(agent.id || '').toLowerCase().includes(searchTerm);
				});

				let html = '';
				if (filteredAgents.length === 0) {
					html = '<p class="text-xs opacity-60 py-2">No agents found.</p>';
				} else {
					html = filteredAgents.map(agent => {
						const checked = selectedWebhookAgentIDs.includes(agent.id) ? 'checked' : '';
						return `
							<div class="border border-base-300 rounded-lg px-3 py-2 mb-2">
								<div class="flex items-center justify-between gap-3">
									<div class="flex items-center gap-2 min-w-0 flex-1">
										<span class="font-medium text-sm truncate" title="${escapeHtml(agent.id)}">${escapeHtml(agent.name)}</span>
										<span class="text-[11px] opacity-60 truncate">${escapeHtml(agent.id)}</span>
									</div>
									<input
										type="checkbox"
										class="toggle toggle-sm toggle-primary webhook-agent-checkbox"
										value="${escapeHtml(agent.id)}"
										aria-label="Enable ${escapeHtml(agent.name)}"
										${checked}
										onchange="refreshSelectedWebhookAgentsFromDOM()"
									/>
								</div>
							</div>`;
					}).join('');
				}

				root.innerHTML = html;
				renderWebhookSelectedAgentCount();
			}

			function refreshSelectedWebhookAgentsFromDOM() {
				const checkboxes = document.querySelectorAll('.webhook-agent-checkbox');
				selectedWebhookAgentIDs = Array.from(checkboxes)
					.filter(cb => cb.checked)
					.map(cb => cb.value);
				renderWebhookSelectedAgentCount();
			}

			function renderWebhookSelectedAgentCount() {
				const countEl = document.getElementById('webhook_agent_selected_count');
				if (!countEl) return;
				const count = selectedWebhookAgentIDs.length;
				if (count === 0) {
					countEl.textContent = 'No agents selected';
				} else if (count === 1) {
					countEl.textContent = '1 agent selected';
				} else {
					countEl.textContent = count + ' agents selected';
				}
			}

			function serializeWebhookAgentData() {
				// Collect selected agent IDs from toggles and put into hidden field
				const hiddenField = document.getElementById('webhook_agent_ids_hidden');
				if (hiddenField) {
					hiddenField.value = selectedWebhookAgentIDs.join(',');
				}
			}

		function escapeHtml(text) {
			const div = document.createElement('div');
			div.textContent = text || '';
			return div.innerHTML;
		}

		function initializeWebhookAgents() {
			if (webhookAvailableAgents.length > 0) return; // Already initialized
			const dataEl = document.getElementById('webhook_agents_data');
			if (!dataEl) return;
			try {
				const agentsJSON = dataEl.getAttribute('data-agents');
				webhookAvailableAgents = JSON.parse(agentsJSON || '[]');
			} catch (e) {
				console.error('Failed to parse webhook agents data:', e);
				webhookAvailableAgents = [];
			}
		}
			function togglePasswordVisibility(inputId, button) {
				const input = document.getElementById(inputId);
				if (!input || !button) return;
				const eyeOpen = button.querySelector('.eye-open');
				const eyeClosed = button.querySelector('.eye-closed');
				const willReveal = input.type === 'password';
				input.type = willReveal ? 'text' : 'password';
				if (eyeOpen) eyeOpen.classList.toggle('hidden', willReveal);
				if (eyeClosed) eyeClosed.classList.toggle('hidden', !willReveal);
				button.setAttribute('aria-pressed', willReveal ? 'true' : 'false');
			}

			function resetSecretInputVisibility(inputId) {
				const input = document.getElementById(inputId);
				if (!input) return;
				input.type = 'password';
				const button = document.querySelector("button[onclick=\"togglePasswordVisibility('" + inputId + "', this)\"]");
				if (!button) return;
				const eyeOpen = button.querySelector('.eye-open');
				const eyeClosed = button.querySelector('.eye-closed');
				if (eyeOpen) eyeOpen.classList.remove('hidden');
				if (eyeClosed) eyeClosed.classList.add('hidden');
				button.setAttribute('aria-pressed', 'false');
			}


			function toggleSecretTextareaVisibility(textareaId, button) {
				const textarea = document.getElementById(textareaId);
				if (!textarea) return;
				const eyeOpen = button.querySelector('.eye-open');
				const eyeClosed = button.querySelector('.eye-closed');
				const isMasked = textarea.classList.contains('secret-textarea-masked');
				if (isMasked) {
					textarea.classList.remove('secret-textarea-masked');
					if (eyeOpen) eyeOpen.classList.remove('hidden');
					if (eyeClosed) eyeClosed.classList.add('hidden');
					button.setAttribute('aria-pressed', 'true');
				} else {
					textarea.classList.add('secret-textarea-masked');
					if (eyeOpen) eyeOpen.classList.add('hidden');
					if (eyeClosed) eyeClosed.classList.remove('hidden');
					button.setAttribute('aria-pressed', 'false');
				}
			}

			function resetSecretTextareaVisibility(textareaId) {
				const textarea = document.getElementById(textareaId);
				if (!textarea) return;
				textarea.classList.add('secret-textarea-masked');
				const button = document.querySelector("button[onclick=\"toggleSecretTextareaVisibility('" + textareaId + "', this)\"]");
				if (!button) return;
				const eyeOpen = button.querySelector('.eye-open');
				const eyeClosed = button.querySelector('.eye-closed');
				if (eyeOpen) eyeOpen.classList.add('hidden');
				if (eyeClosed) eyeClosed.classList.remove('hidden');
				button.setAttribute('aria-pressed', 'false');
			}

				function openWebhookCreateModal(event) {
					if (event) event.stopPropagation();
					closeAllDropdownMenus();
					var modal = document.getElementById('webhook_modal');
					if (!modal) return;
					document.getElementById('webhook_modal_title').textContent = 'Add Webhook';
					var form = document.getElementById('webhook_form');
					var pid = form.getAttribute('data-project-id') || '';
					form.setAttribute('hx-post', '/channels/webhooks?project_id=' + encodeURIComponent(pid));
					form.removeAttribute('hx-put');
					form.dataset.webhookMode = 'create';
					form.dataset.webhookDetailReady = 'true';
					setWebhookSubmitState(true, 'Save Webhook');
					document.getElementById('webhook_name').value = '';
					document.getElementById('webhook_enabled').checked = true;
					document.getElementById('webhook_system_instructions').value = '';
					document.getElementById('webhook_title_template').value = '';
					document.getElementById('webhook_prompt_template').value = '';
					document.getElementById('webhook_default_priority').value = '2';
					document.getElementById('webhook_url_display').textContent = '(Save first to generate URL)';
					document.getElementById('webhook_secret_display').value = '';
					resetSecretInputVisibility('webhook_secret_display');
					var secretRow = document.getElementById('webhook_secret_row');
					if (secretRow) secretRow.style.display = 'none';
					var urlRow = document.getElementById('webhook_url_row');
					if (urlRow) urlRow.style.display = 'none';
					
					// Initialize webhook agents from page data
					initializeWebhookAgents();
					selectedWebhookAgentIDs = [];
					renderWebhookAgentList();
					setWebhookSection('config');
					
					htmx.process(form);
					modal.showModal();
				}

				function openWebhookEditModal(id) {
					var modal = document.getElementById('webhook_modal');
					if (!modal) return;
					closeAllDropdownMenus();
					document.getElementById('webhook_modal_title').textContent = 'Edit Webhook';
					var form = document.getElementById('webhook_form');
					var pid = form.getAttribute('data-project-id') || '';
					form.removeAttribute('hx-post');
					form.setAttribute('hx-put', '/channels/webhooks/' + id + '?project_id=' + encodeURIComponent(pid));
					form.dataset.webhookMode = 'edit';
					form.dataset.webhookDetailReady = 'false';
					setWebhookSubmitState(false, 'Loading Webhook…');

					var card = document.querySelector('[data-webhook-id="' + id + '"]');
					document.getElementById('webhook_name').value = card ? (card.getAttribute('data-webhook-name') || '') : '';
					document.getElementById('webhook_enabled').checked = card ? ((card.getAttribute('data-webhook-enabled') || '') === 'true') : true;
					document.getElementById('webhook_system_instructions').value = '';
					document.getElementById('webhook_title_template').value = '';
					document.getElementById('webhook_prompt_template').value = '';
					document.getElementById('webhook_default_priority').value = card ? (card.getAttribute('data-webhook-default-priority') || '2') : '2';
					document.getElementById('webhook_secret_display').value = '';
					resetSecretInputVisibility('webhook_secret_display');
					var token = card ? (card.getAttribute('data-webhook-token') || '') : '';
					document.getElementById('webhook_url_display').textContent = token ? (window.location.origin + '/webhooks/inbound/' + token) : '(Loading...)';
					selectedWebhookAgentIDs = [];

					var secretRow = document.getElementById('webhook_secret_row');
					if (secretRow) secretRow.style.display = '';
					var urlRow = document.getElementById('webhook_url_row');
					if (urlRow) urlRow.style.display = '';

					initializeWebhookAgents();
					renderWebhookAgentList();
					setWebhookSection('config');
					htmx.process(form);
					modal.showModal();

					var requestGeneration = ++webhookEditRequestGeneration;
					fetch('/channels/webhooks/' + encodeURIComponent(id) + '?project_id=' + encodeURIComponent(pid), {
						headers: { 'Accept': 'application/json' }
					}).then(function(response) {
						if (!response.ok) throw new Error('Failed to load webhook');
						return response.json();
					}).then(function(detail) {
						if (requestGeneration !== webhookEditRequestGeneration || !detail || detail.id !== id) return;
						form.dataset.webhookDetailReady = 'true';
						setWebhookSubmitState(true, 'Save Webhook');
						document.getElementById('webhook_name').value = detail.name || '';
						document.getElementById('webhook_enabled').checked = !!detail.enabled;
						document.getElementById('webhook_system_instructions').value = detail.system_instructions || '';
						document.getElementById('webhook_title_template').value = detail.title_template || '';
						document.getElementById('webhook_prompt_template').value = detail.prompt_template || '';
						document.getElementById('webhook_default_priority').value = String(detail.default_priority || 2);
						document.getElementById('webhook_secret_display').value = detail.secret || '';
						resetSecretInputVisibility('webhook_secret_display');
						var detailToken = detail.path_token || '';
						document.getElementById('webhook_url_display').textContent = detailToken ? (window.location.origin + '/webhooks/inbound/' + detailToken) : '(Not available)';
						selectedWebhookAgentIDs = Array.isArray(detail.agent_ids) ? detail.agent_ids.slice() : [];
						renderWebhookAgentList();
					}).catch(function() {
						if (requestGeneration !== webhookEditRequestGeneration) return;
						form.dataset.webhookDetailReady = 'false';
						setWebhookSubmitState(false, 'Load failed');
						document.getElementById('webhook_url_display').textContent = '(Failed to load)';
						if (window.showToast) window.showToast('Failed to load webhook details', 'failed');
					});
				}

				function writeToClipboardWithFeedback(text, button, successMessage, failureMessage) {
						if (!text) {
							if (window.showToast) window.showToast(failureMessage || 'Nothing to copy', 'failed');
							return;
						}

						function onCopySuccess() {
							if (button) {
								var original = button.textContent;
								button.textContent = 'Copied';
								setTimeout(function() { button.textContent = original; }, 1000);
							}
							if (window.showToast) window.showToast(successMessage || 'Copied to clipboard', 'completed');
						}

						function onCopyFailure() {
							if (window.showToast) window.showToast(failureMessage || 'Failed to copy to clipboard', 'failed');
						}

						if (navigator.clipboard && typeof navigator.clipboard.writeText === 'function') {
							navigator.clipboard.writeText(text).then(onCopySuccess).catch(function() {
								var textarea = document.createElement('textarea');
								textarea.value = text;
								textarea.setAttribute('readonly', '');
								textarea.style.position = 'fixed';
								textarea.style.opacity = '0';
								document.body.appendChild(textarea);
								textarea.select();
								textarea.setSelectionRange(0, textarea.value.length);
								try {
									if (document.execCommand('copy')) {
										onCopySuccess();
									} else {
										onCopyFailure();
									}
								} catch (e) {
									onCopyFailure();
								} finally {
									document.body.removeChild(textarea);
								}
							});
							return;
						}

						var fallbackTextarea = document.createElement('textarea');
						fallbackTextarea.value = text;
						fallbackTextarea.setAttribute('readonly', '');
						fallbackTextarea.style.position = 'fixed';
						fallbackTextarea.style.opacity = '0';
						document.body.appendChild(fallbackTextarea);
						fallbackTextarea.select();
						fallbackTextarea.setSelectionRange(0, fallbackTextarea.value.length);
						try {
							if (document.execCommand('copy')) {
								onCopySuccess();
							} else {
								onCopyFailure();
							}
						} catch (e) {
							onCopyFailure();
						} finally {
							document.body.removeChild(fallbackTextarea);
						}
					}

				function copyWebhookEndpointUrl(webhookID, button) {
					var card = document.querySelector('[data-webhook-id="' + webhookID + '"]');
					if (!card) {
						if (window.showToast) window.showToast('Webhook URL not available', 'failed');
						return;
					}
					var token = (card.getAttribute('data-webhook-token') || '').trim();
					if (!token) {
						if (window.showToast) window.showToast('Webhook URL not available', 'failed');
						return;
					}
					var url = window.location.origin + '/webhooks/inbound/' + token;
					writeToClipboardWithFeedback(url, button, 'Webhook URL copied', 'Failed to copy webhook URL');
				}

				function copyWebhookAbsoluteUrl(elementId, button) {
					var el = document.getElementById(elementId);
					if (!el) return;
					var val = (el.textContent || '').trim();
					if (!val || val.indexOf('(Save first') === 0 || val.indexOf('(Not available') === 0) {
						if (window.showToast) window.showToast('Webhook URL not available', 'failed');
						return;
					}
					writeToClipboardWithFeedback(val, button, 'Webhook URL copied', 'Failed to copy webhook URL');
				}

				function closeWebhookModal() {
					webhookEditRequestGeneration++;
					var modal = document.getElementById('webhook_modal');
					if (modal) modal.close();
				}

				function editChannelFromData(card) {
					const type = card.dataset.channelType;
					if (type === 'telegram') {
						const token = card.dataset.channelToken || '';
						document.getElementById('channel_telegram_token').value = token;
						var richToggle = document.getElementById('channel_telegram_rich_messages_v2');
						if (richToggle) richToggle.checked = richToggle.defaultChecked;
						document.getElementById('channel_modal_title').textContent = 'Configure Telegram Bot';
						resetSecretInputVisibility('channel_telegram_token');
						channel_modal.showModal();
				} else if (type === 'github') {
					openGitHubConfigModal();
				} else if (type === 'slack') {
					openSlackConfigModal();
				} else if (type === 'discord') {
					openDiscordConfigModal();
				} else if (type === 'email') {
					openEmailConfigModal();
				}
			}
				function closeAllDropdownMenus() {
					document.querySelectorAll('.dropdown ul').forEach(m => m.classList.remove('show'));
					document.querySelectorAll('.dropdown :focus').forEach(el => {
						if (typeof el.blur === 'function') el.blur();
					});
				}

			function openTelegramChannelFromMenu(event) {
				if (event) event.stopPropagation();
				closeAllDropdownMenus();
				document.getElementById('channel_telegram_token').value = '';
				var richToggle = document.getElementById('channel_telegram_rich_messages_v2');
				if (richToggle) richToggle.checked = true;
				document.getElementById('channel_modal_title').textContent = 'Add Telegram Bot';
				resetSecretInputVisibility('channel_telegram_token');
				channel_modal.showModal();
			}

			function openGitHubChannelFromMenu(event) {
				if (event) event.stopPropagation();
				closeAllDropdownMenus();
				openGitHubConfigModal();
			}

				function openSlackChannelFromMenu(event) {
					if (event) event.stopPropagation();
					closeAllDropdownMenus();
					openSlackConfigModal();
				}

				function openDiscordChannelFromMenu(event) {
					if (event) event.stopPropagation();
					closeAllDropdownMenus();
					openDiscordConfigModal();
				}

				function openEmailChannelFromMenu(event) {
					if (event) event.stopPropagation();
					closeAllDropdownMenus();
					openEmailConfigModal();
				}

				function closeChannelModal() {				channel_modal.close();
			}

			function openGitHubConfigModal() {
				const modal = document.getElementById('github_config_modal');
				if (!modal) return;
				const modeSelect = document.getElementById('github_auth_mode');
					if (modeSelect) {
						toggleGitHubAuthMode(modeSelect.value);
					}
					resetSecretInputVisibility('github_pat');
					resetSecretTextareaVisibility('github_app_private_key');
					modal.showModal();
			}

			function closeGitHubConfigModal() {
				const modal = document.getElementById('github_config_modal');
				if (modal) modal.close();
			}

			function openSlackConfigModal() {
				const modal = document.getElementById('slack_config_modal');
				if (!modal) return;
