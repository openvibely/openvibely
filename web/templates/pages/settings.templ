					resetSecretInputVisibility('discord_bot_token');
				}

				function openDiscordConfigModal() {
					const modal = document.getElementById('discord_config_modal');
					if (!modal) return;
					resetDiscordConfigForm();
					modal.showModal();
				}

				function closeDiscordConfigModal() {
