package pages

import (
	"fmt"

	"github.com/openvibely/openvibely/internal/models"
	"github.com/openvibely/openvibely/internal/service"
	"github.com/openvibely/openvibely/web/templates/components"
)

// WorktreeInfoPanel renders the worktree information panel for a task detail page.
templ WorktreeInfoPanel(task *models.Task, fileStats []service.WorktreeFileStat) {
	<div id="worktree-info-panel" class="card bg-base-200/50 border border-base-300 mb-4">
		<div class="card-body p-4 gap-3">
			<div class="flex items-center justify-between gap-3">
				<h4 class="text-sm font-semibold flex items-center gap-2">
					<svg xmlns="http://www.w3.org/2000/svg" class="h-4 w-4" fill="none" viewBox="0 0 24 24" stroke="currentColor">
						<path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M8 7h12m0 0l-4-4m4 4l-4 4m0 6H4m0 0l4 4m-4-4l4-4"></path>
					</svg>
					Git Worktree
				</h4>
				if task.MergeStatus != "" {
					<span class={ "badge badge-sm", mergeStatusBadgeClass(task.MergeStatus) }>
						{ mergeStatusLabel(task.MergeStatus) }
					</span>
				}
			</div>

			if task.WorktreeBranch != "" {
				<div class="grid grid-cols-1 md:grid-cols-2 gap-2 text-sm mb-3">
					<div>
						<span class="opacity-60">Branch:</span>
						<code class="ml-1 bg-base-200 px-2 py-0.5 rounded text-xs">{ task.WorktreeBranch }</code>
					</div>
					if task.MergeTargetBranch != "" {
						<div>
							<span class="opacity-60">Target:</span>
							<code class="ml-1 bg-base-200 px-2 py-0.5 rounded text-xs">{ task.MergeTargetBranch }</code>
						</div>
					}
					if task.WorktreePath != "" {
						<div class="col-span-2">
							<span class="opacity-60">Path:</span>
							<code class="ml-1 bg-base-200 px-2 py-0.5 rounded text-xs truncate">{ task.WorktreePath }</code>
						</div>
					}
				</div>

				// File change summary
				if len(fileStats) > 0 {
					<div class="mb-3">
						<span class="text-xs opacity-60">
							{ fmt.Sprintf("%d file(s) changed", len(fileStats)) }
							{ fileStatsSummary(fileStats) }
						</span>
					</div>
					}
				// Action buttons
				<div class="flex flex-wrap gap-2">
					if task.MergeStatus == models.MergeStatusConflict {
							<button
								type="button"
								class="btn btn-warning btn-xs"
								hx-post={ fmt.Sprintf("/tasks/%s/worktree/resolve", task.ID) }							hx-target="#worktree-info-panel"
							hx-swap="outerHTML"
						>
							AI Resolve Conflicts
						</button>
							<button
								type="button"
								class="btn btn-ghost btn-xs"
								hx-post={ fmt.Sprintf("/tasks/%s/worktree/abort", task.ID) }							hx-target="#worktree-info-panel"
							hx-swap="outerHTML"
						>
							Abort Merge
						</button>
						} else if task.MergeStatus != models.MergeStatusMerged {
							// Merge buttons with dropdown
							<div class="dropdown dropdown-end" id="merge-dropdown">
								<div tabindex="0" role="button" class="btn btn-primary btn-xs">
									Merge to { components.TaskWorktreeMergeTarget(task) }
								</div>
								<ul tabindex="0" class="dropdown-content z-[1] menu p-2 shadow bg-base-100 rounded-box w-52 border border-base-300">
									<li class="menu-title"><span>Local</span></li>
									for _, action := range components.TaskWorktreeMergeActions() {
										if !action.RequiresRebaseEligibility {
											@components.TaskWorktreeMergeActionItem(task, action, "worktree", "#worktree-info-panel", "outerHTML", "", "")
										}
									}
								</ul>
							</div>
						}
					if task.WorktreePath != "" && task.MergeStatus != "" {
						<button
							type="button"
							class="btn btn-ghost btn-xs"
							hx-post={ fmt.Sprintf("/tasks/%s/worktree/cleanup", task.ID) }
							hx-target="#worktree-info-panel"
							hx-swap="outerHTML"
							hx-vals='{"delete_branch": "true"}'
							hx-confirm="Delete worktree and branch? This cannot be undone."
						>
							Cleanup Worktree
						</button>
					}
				</div>
			} else {
				<p class="text-sm opacity-50">No worktree created for this task.</p>
				<p class="text-xs opacity-40 mt-1">A worktree will be created automatically when this task starts executing in a project with a git repository.</p>
			}
		</div>
	</div>
}

// TaskChangesWorktreeContent renders the changes tab for worktree-based tasks.
//
// localMergeUnavailable is true when current task/Git state does not safely
// permit local merge or conflict-recovery actions.
templ TaskChangesWorktreeContent(diffOutput string, task *models.Task, fileStats []service.WorktreeFileStat, reviewComments []models.ReviewComment, taskPR *models.TaskPullRequest, localMergeUnavailable bool, rebaseAvailable bool) {
	@TaskChangesWorktreeContentWithView(diffOutput, task, fileStats, reviewComments, taskPR, localMergeUnavailable, task.MergeStatus == models.MergeStatusConflict && !localMergeUnavailable, rebaseAvailable, "inline")
}

templ TaskChangesWorktreeContentWithView(diffOutput string, task *models.Task, fileStats []service.WorktreeFileStat, reviewComments []models.ReviewComment, taskPR *models.TaskPullRequest, localMergeUnavailable bool, conflictRecovery bool, rebaseAvailable bool, diffView string) {
	<div class="card bg-base-100 shadow-sm border border-base-300">
		<div class="card-body">
			// Worktree branch info header
			if task.WorktreeBranch != "" {
				<div class="flex flex-wrap items-start justify-between gap-2 mb-4 min-w-0 max-w-full">
					<div class="min-w-0 max-w-full flex-1">
						<h4 class="text-lg font-bold">Worktree Changes</h4>
						<p class="text-sm opacity-60 min-w-0 max-w-full break-words [overflow-wrap:anywhere]">
							Changes on branch
							<code class="bg-base-200 px-1.5 py-0.5 rounded text-xs break-all">{ task.WorktreeBranch }</code>
							vs
							<code class="bg-base-200 px-1.5 py-0.5 rounded text-xs break-all">{ components.TaskWorktreeMergeTarget(task) }</code>
						</p>
					</div>
						// Unified actions dropdown with Local and GitHub sections
						<div class="dropdown dropdown-end relative z-[60] flex-shrink-0" id="changes-actions-dropdown">
							<div tabindex="0" role="button" class="btn btn-primary btn-sm whitespace-nowrap">
								Actions
								<svg xmlns="http://www.w3.org/2000/svg" class="h-4 w-4" fill="none" viewBox="0 0 24 24" stroke="currentColor">
									<path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M19 9l-7 7-7-7"></path>
								</svg>
							</div>
							<ul tabindex="0" class="dropdown-content z-[100] menu p-2 shadow bg-base-100 rounded-box w-52 max-w-[calc(100vw-2rem)] border border-base-300">
								if conflictRecovery {
									<li class="menu-title"><span>Conflict recovery</span></li>
									<li>
										<button
											type="button"
											hx-post={ fmt.Sprintf("/tasks/%s/worktree/resolve", task.ID) }
											hx-target="#changes-content"
											hx-swap="innerHTML"
											hx-disabled-elt="#changes-actions-dropdown button"
											hx-vals='{"merge_source": "changes_tab"}'
										>
											AI Resolve Conflicts
										</button>
									</li>
									<li>
										<button
											type="button"
											hx-post={ fmt.Sprintf("/tasks/%s/worktree/abort", task.ID) }
											hx-target="#changes-content"
											hx-swap="innerHTML"
											hx-disabled-elt="#changes-actions-dropdown button"
											hx-vals='{"merge_source": "changes_tab"}'
										>
											Abort Merge
										</button>
									</li>
								} else if !localMergeUnavailable && task.MergeStatus != models.MergeStatusMerged {
								<li class="menu-title"><span>Local</span></li>
								for _, action := range components.TaskWorktreeMergeActions() {
									if !action.RequiresRebaseEligibility || rebaseAvailable {
										@components.TaskWorktreeMergeActionItem(task, action, "changes", "#changes-content", "innerHTML", "#changes-actions-dropdown button", "changes_tab")
									}
								}
							}
							<li class="menu-title"><span>GitHub</span></li>
							if taskPR != nil {
								<li>
									<a href={ templ.SafeURL(taskPR.PRURL) } target="_blank" rel="noopener noreferrer">
										<span class="htmx-indicator"><span class="loading loading-spinner loading-xs"></span></span>
										View PR #{ fmt.Sprintf("%d", taskPR.PRNumber) }
									</a>
								</li>
							} else {
								<li>
									<button
										type="button"
										hx-post={ fmt.Sprintf("/tasks/%s/worktree/pull-request", task.ID) }
										hx-target="#changes-content"
										hx-swap="innerHTML"
										hx-indicator="#create-pr-indicator"
									>
										<span class="htmx-indicator" id="create-pr-indicator"><span class="loading loading-spinner loading-xs"></span></span>
										Create PR
									</button>
								</li>
							}
							</ul>
						</div>
					</div>
				}
				if conflictRecovery {
					<div class="alert alert-warning mb-4 text-sm" role="status" data-merge-conflict-guidance>
						<span>A merge conflict is active. Resolve the conflicting files or abort the merge before retrying.</span>
					</div>
				}
				// File change summary list
				if len(fileStats) > 0 {
					<div class="mb-4 p-3 bg-base-200 rounded-lg min-w-0 max-w-full overflow-hidden">
					<div class="text-sm font-semibold mb-2 min-w-0">
						{ fmt.Sprintf("%d file(s) changed", len(fileStats)) }
					</div>
					<ul class="text-xs space-y-1 min-w-0 max-w-full overflow-hidden">
						for _, fs := range fileStats {
							<li class="flex items-center gap-2 min-w-0 max-w-full overflow-hidden">
								<span class={ fileStatusBadgeClass(fs.Status), "shrink-0" }>{ fileStatusChar(fs.Status) }</span>
								<span class="font-mono min-w-0 flex-1 truncate" title={ fs.Path }>{ fs.Path }</span>
							</li>
						}
					</ul>
				</div>
			}

			// Diff viewer
			@components.DiffViewerWithReviewView(diffOutput, task.ID, reviewComments, diffView)
		</div>
	</div>
}

// Helper functions for worktree templates

func mergeStatusBadgeClass(status models.MergeStatus) string {
	switch status {
	case models.MergeStatusPending:
		return "badge-warning"
	case models.MergeStatusMerged:
		return "badge-success"
	case models.MergeStatusFailed:
		return "badge-error"
	case models.MergeStatusConflict:
		return "badge-error"
	default:
		return "badge-ghost"
	}
}

func mergeStatusLabel(status models.MergeStatus) string {
	switch status {
	case models.MergeStatusPending:
		return "Pending Merge"
	case models.MergeStatusMerged:
		return "Merged"
	case models.MergeStatusFailed:
		return "Merge Failed"
	case models.MergeStatusConflict:
		return "Conflicts"
	default:
		return ""
	}
}

func fileStatusBadgeClass(status string) string {
	switch status {
	case "added":
		return "badge badge-xs badge-success"
	case "deleted":
		return "badge badge-xs badge-error"
	default:
		return "badge badge-xs badge-warning"
	}
}

func fileStatusChar(status string) string {
	switch status {
	case "added":
		return "A"
	case "deleted":
		return "D"
	default:
		return "M"
	}
}

func fileStatsSummary(stats []service.WorktreeFileStat) string {
	added, modified, deleted := 0, 0, 0
	for _, s := range stats {
		switch s.Status {
		case "added":
			added++
		case "modified":
			modified++
		case "deleted":
			deleted++
		}
	}
	parts := []string{}
	if added > 0 {
		parts = append(parts, fmt.Sprintf("+%d", added))
	}
	if modified > 0 {
		parts = append(parts, fmt.Sprintf("~%d", modified))
	}
	if deleted > 0 {
		parts = append(parts, fmt.Sprintf("-%d", deleted))
	}
	if len(parts) == 0 {
		return ""
	}
	return "(" + joinParts(parts) + ")"
}

func joinParts(parts []string) string {
	result := ""
	for i, p := range parts {
		if i > 0 {
			result += ", "
		}
		result += p
	}
	return result
}
