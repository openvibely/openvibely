package pages

import "github.com/openvibely/openvibely/web/templates/components"

// TaskDetailPanel keeps supporting information outside the permanent thread workspace.
templ TaskDetailPanel() {
	@components.SidePanel("task-details-panel", "task-panel-divider", "Task details") {
        @components.InspectorTabs("inspector-tab-", "tab-", "Task details", []components.InspectorTab{{"details", "Details"}, {"schedules", "Schedule"}, {"chaining", "Chaining"}, {"attachments", "Files"}, {"lifecycle", "Lifecycle"}})

		<div id="task-inspector-body" class="inspector-body flex flex-col">
			{ children... }
		</div>
	}
	<style>
		/* Prevent scroll-boundary gestures from bouncing the app shell independently
		   of the fixed inspector. The thread and panel retain their own scrolling. */
		html:has(#task-detail-content), body:has(#task-detail-content), #main-content:has(#task-detail-content) { overscroll-behavior-y:none; }
		#task-detail-content > [data-page-header] > nav { flex-shrink:1; flex-wrap:nowrap; }
		#task-details-opener, #task-workspace-back { flex-shrink:0; }
		#task-workspace-back:not([hidden]) + #task-details-opener { margin-left:-4px; }
		#task-breadcrumb-changes { font-size:16px; line-height:22px; }
		#task-breadcrumb-toolbar button:focus-visible { outline:1px solid oklch(var(--bc) / .5); outline-offset:2px; border-radius:6px; }
		#task-breadcrumb-changes[hidden] { display:none; }
		#task-workspaces { display:flex; position:relative; flex:1; min-height:0; min-width:0; gap:12px; }
		#tab-chat, #tab-changes { order:0; flex:1; min-width:0; min-height:0; }
		#tab-changes { overflow:auto; }
		/* Keep inspector navigation compact and conversation prose comfortable to read. */
		#task-details-panel .inspector-tabs > [role="tab"] { font-size:.8125rem; padding-inline:8px; }
		#task-thread-messages .chat-markdown,
		#task-thread-messages .chat-bubble-user-msg .chat-bubble-inner > .whitespace-pre-wrap { font-size:.9375rem; }
		/* Changes owns its scrollport; no page-padding offset is needed. */
		#tab-changes .diff-file-header { top:0; }
			#task-detail-content[data-inspector-overlay="true"] #task-details-opener { position:fixed; top:var(--side-panel-top,0px); right:0; z-index:61; }

		#task-detail-actions { margin-bottom:max(0px, calc(var(--task-actions-bottom, 24px) - 12px)); }
		/* Keep gutters local to each tab, independent of active-tab visibility.
		   Existing Details owns a separate scrollport and applies its gutter there. */
		#task-inspector-body { padding-inline:0; overflow-x:hidden; }
		#task-inspector-body > .task-tab-panel { min-height:0; padding-inline:24px; }
		#task-inspector-body > .task-details-scroll-panel { padding-inline:0; }
		#task-detail-view, #task-detail-edit { min-width:0; padding-inline:24px; overflow-x:hidden; overflow-wrap:anywhere; }
		#tab-details { min-width:0; }
		#tab-details #task-detail-actions { margin-inline:24px; flex-wrap:wrap; }

	</style>
}
