package pages

// TaskDetailPanel keeps supporting information outside the permanent thread workspace.
templ TaskDetailPanel() {
	<aside id="task-details-panel" aria-label="Task details" class="bg-base-200 border border-base-300" hidden>
		<div id="task-panel-divider" role="separator" aria-label="Resize details panel" aria-orientation="vertical" aria-valuemin="340" aria-valuemax="720" aria-valuenow="420" tabindex="0"></div>
		<div role="tablist" aria-label="Task details" class="tabs tabs-bordered tabs-sm overflow-x-auto flex-nowrap">
			for _, tab := range []struct{ Key, Label string }{{"details", "Details"}, {"schedules", "Schedule"}, {"chaining", "Chaining"}, {"attachments", "Files"}, {"lifecycle", "Lifecycle"}} {
				<button type="button" role="tab" class="tab" id={ "inspector-tab-" + tab.Key } data-tab={ tab.Key } aria-controls={ "tab-" + tab.Key } aria-selected="false" tabindex="-1">{ tab.Label }</button>
			}
		</div>
		<div id="task-inspector-body" class="flex flex-col flex-1 min-h-0 overflow-y-auto p-3">
			{ children... }
		</div>
	</aside>
	<style>
		/* Prevent scroll-boundary gestures from bouncing the app shell independently
		   of the fixed inspector. The thread and panel retain their own scrolling. */
		html:has(#task-detail-content), body:has(#task-detail-content), #main-content:has(#task-detail-content) { overscroll-behavior-y:none; }
		#task-detail-content > [data-page-header] > nav { flex-shrink:1; flex-wrap:nowrap; }
		#task-details-opener, #task-workspace-back { flex-shrink:0; }
		#task-workspace-back:not([hidden]) + #task-details-opener { margin-left:-4px; }
		#task-breadcrumb-changes { font-size:16px; line-height:22px; }
		#task-breadcrumb-toolbar button:focus-visible { outline:2px solid oklch(var(--p)); outline-offset:2px; border-radius:6px; }
		#task-breadcrumb-changes[hidden] { display:none; }
		#task-workspaces { display:flex; position:relative; flex:1; min-height:0; min-width:0; gap:12px; }
		#tab-chat, #tab-changes { order:0; flex:1; min-width:0; min-height:0; }
		#tab-changes { overflow:auto; }
		/* Changes owns its scrollport; no page-padding offset is needed. */
		#tab-changes .diff-file-header { top:0; }
		#task-detail-content[data-inspector-docked="true"] { padding-right:var(--task-panel-reserved-width); }
			#task-detail-content[data-inspector-overlay="true"] #task-details-opener { position:fixed; top:var(--task-panel-top,0px); right:0; z-index:61; }
			#task-details-panel[data-overlay="true"] > [role="tablist"] { padding-right:2.5rem; }
			#task-details-panel { position:fixed; right:0; top:var(--task-panel-top,0px); bottom:0; z-index:40; display:flex; flex-direction:column; width:var(--task-panel-width,420px); min-height:0; max-width:100%; border-width:0 0 0 1px; border-radius:0; }
		[data-theme="light"] #task-details-panel { background-color:var(--ov-l-surface); }
		#task-details-panel > [role="tablist"] { flex-shrink:0; margin:8px 12px 16px; box-shadow:inset 0 -1px color-mix(in srgb, currentColor 20%, transparent); }
		#task-details-panel > [role="tablist"] > .tab { outline:none !important; box-shadow:none !important; height:auto; color:inherit; opacity:.6; font-weight:400; line-height:20px; padding-top:6px; padding-bottom:6px; border-bottom:2px solid transparent !important; }
		#task-details-panel > [role="tablist"] > .tab[aria-selected="true"] { color:inherit; opacity:1; font-weight:400; border-bottom-color:currentColor !important; }
		#task-details-panel > [role="tablist"] > .tab:hover { opacity:1; background-color:var(--ov-hover-subtle); }
		#task-details-panel[hidden] { display:none; }
		#task-panel-divider { position:absolute; left:-7px; top:0; bottom:0; width:10px; cursor:col-resize; touch-action:none; z-index:2; }
		#task-panel-divider:focus { outline:none; }
		#task-panel-divider::after { content:""; position:absolute; top:0; bottom:0; left:6px; width:2px; background:currentColor; background:color-mix(in srgb, currentColor 60%, transparent); opacity:0; transition:opacity .12s; pointer-events:none; }
		#task-panel-divider:hover::after, #task-panel-divider[data-resizing]::after { opacity:.45; }
		#task-panel-divider:focus-visible:not([data-pointer-focus])::after { opacity:.45; }
		#task-detail-actions { margin-bottom:max(0px, calc(var(--task-actions-bottom, 24px) - 12px)); }
		#task-inspector-body > .task-tab-panel { min-height:0; }
		/* Reserve 12px beyond the rows’ 12px highlight padding at both panel edges. */
		#task-inspector-body { padding-inline:24px; }
		#task-inspector-body:has(#tab-details:not(.hidden) #task-detail-view) { padding-inline:0; overflow-x:hidden; }
		#task-detail-view { min-width:0; padding-inline:24px; overflow-x:hidden; overflow-wrap:anywhere; }
		#tab-details { min-width:0; }
		#tab-details #task-detail-actions { margin-inline:24px; flex-wrap:wrap; }

		#task-details-panel[data-overlay="true"] { box-shadow:0 8px 30px #0003; }
		@media(max-width:640px) {
			#task-details-panel[data-overlay="true"] { position:fixed; inset:var(--task-panel-top,0px) 0 0; width:100%; max-width:none; z-index:60; }
			#task-panel-divider { display:none; }
		}
	</style>
}
