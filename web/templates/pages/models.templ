					{ value: 'llama3.2:3b', label: 'Llama 3.2 (3B)', efforts: [] },
					{ value: 'codellama:7b', label: 'Code Llama (7B)', efforts: [] },
					{ value: 'codellama:13b', label: 'Code Llama (13B)', efforts: [] },
					{ value: 'mistral:7b', label: 'Mistral (7B)', efforts: [] },
					{ value: 'deepseek-coder-v2:16b', label: 'DeepSeek Coder V2 (16B)', efforts: [] },
					{ value: 'qwen2.5-coder:7b', label: 'Qwen 2.5 Coder (7B)', efforts: [] },
					{ value: 'gemma2:9b', label: 'Gemma 2 (9B)', efforts: [] },
					{ value: 'phi3:14b', label: 'Phi-3 (14B)', efforts: [] }
				]
			};

				function canonicalProvider(provider) {
					return provider && provider.indexOf('openai_compatible_') === 0 ? 'openai_compatible' : provider;
				}
					function openAICompatiblePresetForProvider(provider) {
						var prefix = 'openai_compatible_';
						if (provider && provider.indexOf(prefix) === 0) return provider.substring(prefix.length) || 'custom';
						if (provider === 'openai_compatible') return document.getElementById('model_openai_compatible_preset').value || 'custom';
						return 'custom';
					}

					function isOpenAICompatibleProvider(provider) {
					return canonicalProvider(provider) === 'openai_compatible';
				}

				function modelOptionsForProvider(provider) {
					return modelOptionsByProvider[provider] || modelOptionsByProvider[canonicalProvider(provider)] || [];
				}

				function selectedModelOption(provider, model) {				var options = modelOptionsForProvider(provider);
				for (var i = 0; i < options.length; i++) {
					if (options[i].value === model) {
						return options[i];
					}
				}
				return null;
			}

				function preferredReasoningEffort(supportedEfforts, provider, model) {
					var normalizedModel = (model || '').trim().toLowerCase();
					if (isOpenAICompatibleProvider(provider) && (normalizedModel === 'kimi-k3' || normalizedModel === 'glm-5.2') && supportedEfforts.indexOf('max') !== -1) {
						return 'max';
					}
					var preferred = ['medium', 'high', 'low', 'xhigh', 'max'];				for (var i = 0; i < preferred.length; i++) {
					if (supportedEfforts.indexOf(preferred[i]) !== -1) {
						return preferred[i];
					}
				}
				if (supportedEfforts.length > 0) {
					return supportedEfforts[0];
				}
				return 'high';
			}

				function setReasoningEffortOptions(provider, model, selectedEffort) {
					var reasoningField = document.getElementById('reasoning_effort_field');
					var reasoningSelect = document.getElementById('model_reasoning_effort');
					var reasoningLabel = document.getElementById('reasoning_effort_label');
					var reasoningHelp = document.getElementById('reasoning_effort_help');

					var modelOption = selectedModelOption(provider, model);
					var supportedEfforts = [];
					if (modelOption && modelOption.efforts && modelOption.efforts.length > 0) {
						supportedEfforts = modelOption.efforts;
					}
					if (supportedEfforts.length === 0) {
						reasoningField.classList.add('hidden');
						reasoningSelect.disabled = true;
						reasoningSelect.innerHTML = '';
						return;
					}

					reasoningField.classList.remove('hidden');
					reasoningSelect.disabled = false;
					if (provider === 'anthropic') {
						reasoningLabel.textContent = 'Claude Effort';
						reasoningHelp.textContent = 'Matches Claude Code effort: low, medium, high, xhigh, or max. Availability varies by model. Blank saved configs keep the provider default.';
					} else if (isOpenAICompatibleProvider(provider) && (model || '').trim().toLowerCase() === 'kimi-k3') {
						reasoningLabel.textContent = 'Kimi Reasoning Effort';
						reasoningHelp.textContent = 'Controls Kimi K3 reasoning effort: low, high, or max.';
					} else if (isOpenAICompatibleProvider(provider) && (model || '').trim().toLowerCase() === 'glm-5.2') {
						reasoningLabel.textContent = 'GLM Reasoning Effort';
						reasoningHelp.textContent = 'Controls GLM 5.2 reasoning effort from none through max.';
					} else {
						reasoningLabel.textContent = 'Codex Reasoning Effort';
						reasoningHelp.textContent = 'Matches Codex reasoning effort for supported OpenAI models.';
					}
					reasoningSelect.innerHTML = '';				for (var i = 0; i < supportedEfforts.length; i++) {
					var effort = supportedEfforts[i];
					var opt = document.createElement('option');
					opt.value = effort;
					opt.textContent = reasoningEffortOptions[effort] || effort;
					reasoningSelect.appendChild(opt);
				}

				var normalizedSelected = (selectedEffort || '').toLowerCase();
				if (normalizedSelected && supportedEfforts.indexOf(normalizedSelected) !== -1) {
					reasoningSelect.value = normalizedSelected;
					return;
				}
				reasoningSelect.value = preferredReasoningEffort(supportedEfforts, provider, model);
			}

				function setModelOptions(provider, selectedModel) {
					var modelSelect = document.getElementById('model_id');
					var options = modelOptionsForProvider(provider);				modelSelect.innerHTML = '';
				var hasSelected = false;
				for (var i = 0; i < options.length; i++) {
					var opt = document.createElement('option');
					opt.value = options[i].value;
					opt.textContent = options[i].label;
					if (selectedModel && selectedModel === options[i].value) {
						hasSelected = true;
					}
					modelSelect.appendChild(opt);
				}

				if (selectedModel && !hasSelected) {
					var customOpt = document.createElement('option');
					customOpt.value = selectedModel;
					customOpt.textContent = selectedModel + ' (custom)';
					modelSelect.appendChild(customOpt);
				}

					if (selectedModel) {
						modelSelect.value = selectedModel;
					} else if (options.length > 0) {
						modelSelect.value = options[0].value;
					} else if (isOpenAICompatibleProvider(provider)) {
						var manualOpt = document.createElement('option');
						manualOpt.value = '';
						manualOpt.textContent = 'Enter model ID manually';
						modelSelect.appendChild(manualOpt);
						modelSelect.value = '';
					}

					return modelSelect.value;			}

				function handleModelChange() {
					var provider = document.getElementById('model_provider').value;
					var model = document.getElementById('model_id').value;
					var selectedEffort = document.getElementById('model_reasoning_effort').value;
					setReasoningEffortOptions(provider, model, selectedEffort);
					updateTemperatureField(provider, model);
					if (isOpenAICompatibleProvider(provider)) {
						document.getElementById('model_openai_compatible_custom_model').value = model;
					}
				}

				function modelSupportsTemperature(provider, model) {
					var normalizedModel = (model || '').trim().toLowerCase();
					if (provider === 'mixture') return false;
					if (provider === 'openai') return normalizedModel !== 'gpt-6-astra';
					if (!isOpenAICompatibleProvider(provider)) return true;
					return normalizedModel.indexOf('kimi-') !== 0;
				}

				function updateTemperatureField(provider, model) {
					var supported = modelSupportsTemperature(provider, model);
					var field = document.getElementById('model_temperature_field');
					var input = document.getElementById('model_temperature');
					if (field) field.classList.toggle('hidden', !supported);
					if (input) input.disabled = !supported;
				}
				var openAICompatiblePresetDefaults = {
					openrouter: 'https://openrouter.ai/api/v1/',
					nvidia_nim: 'https://integrate.api.nvidia.com/v1/',
					vllm: 'http://127.0.0.1:8000/v1/',
					lm_studio: 'http://127.0.0.1:1234/v1/',
					sglang: 'http://127.0.0.1:30000/v1/',
					litellm: 'http://localhost:4000/v1/',
					deepinfra: 'https://api.deepinfra.com/v1/openai/',
					fireworks: 'https://api.fireworks.ai/inference/v1/',
					groq: 'https://api.groq.com/openai/v1/',
					mistral: 'https://api.mistral.ai/v1/',
					cerebras: 'https://api.cerebras.ai/v1/',
					together: 'https://api.together.xyz/v1/',
					huggingface_router: 'https://router.huggingface.co/v1/',
					deepseek: 'https://api.deepseek.com/v1/',
					moonshot: 'https://api.moonshot.ai/v1/',
					dashscope: 'https://dashscope.aliyuncs.com/compatible-mode/v1/',
					dashscope_intl: 'https://dashscope-intl.aliyuncs.com/compatible-mode/v1/',
					alibaba_coding_plan: 'https://coding-intl.dashscope.aliyuncs.com/v1/',
					zai_glm: 'https://api.z.ai/api/paas/v4/',
					novita: 'https://api.novita.ai/openai/v1/',
					venice: 'https://api.venice.ai/api/v1/',
					qianfan: 'https://qianfan.baidubce.com/v2/',
					kilo_code: 'https://api.kilo.ai/api/gateway/',
					arcee: 'https://api.arcee.ai/api/v1/',
					stepfun: 'https://api.stepfun.ai/v1/',
					stepfun_step_plan: 'https://api.stepfun.ai/step_plan/v1/',
					gmi_cloud: 'https://api.gmi-serving.com/v1/',
					chutes: 'https://llm.chutes.ai/v1/',
					tokenhub: 'https://tokenhub.tencentmaas.com/v1/',
					tokenhub_intl: 'https://tokenhub-intl.tencentmaas.com/v1/',
					xiaomi_mimo: 'https://api.xiaomimimo.com/v1/',
					inferrs: 'http://127.0.0.1:8080/v1/',
					ds4: 'http://127.0.0.1:18000/v1/',
					custom: ''
				};

							function isDiscoverableOpenAICompatiblePreset() {
								var preset = document.getElementById('model_openai_compatible_preset').value || 'custom';
								return (preset !== 'custom' && !!openAICompatiblePresetDefaults[preset]) ||
									(preset === 'custom' && !!document.getElementById('model_custom_models_url').value.trim());
							}

						var openAICompatibleDiscoveryTimer = null;

							function maybeAutoDiscoverOpenAICompatibleModels() {
								var provider = document.getElementById('model_provider').value;
								if (isOpenAICompatibleProvider(provider) && isDiscoverableOpenAICompatiblePreset()) {
									discoverOpenAICompatibleModels();
								}
							}

							function scheduleAutoDiscoverOpenAICompatibleModels() {
								if (openAICompatibleDiscoveryTimer) clearTimeout(openAICompatibleDiscoveryTimer);
								openAICompatibleDiscoveryTimer = setTimeout(maybeAutoDiscoverOpenAICompatibleModels, 400);
							}

							function runAutoDiscoverOpenAICompatibleModels() {
								if (openAICompatibleDiscoveryTimer) clearTimeout(openAICompatibleDiscoveryTimer);
								maybeAutoDiscoverOpenAICompatibleModels();
							}
						function applyOpenAICompatiblePreset(force) {
							var provider = document.getElementById('model_provider').value;
							var presetInput = document.getElementById('model_openai_compatible_preset');
							var currentPreset = presetInput.value || 'custom';
							var preset = openAICompatiblePresetForProvider(provider);
							if (!force && provider === 'openai_compatible_custom' && currentPreset !== 'custom' && !openAICompatiblePresetDefaults[currentPreset]) preset = currentPreset;
							presetInput.value = preset;
							var baseURL = document.getElementById('model_base_url');
							var status = document.getElementById('openai_compatible_discovery_status');
							var hasPresetDefault = Object.prototype.hasOwnProperty.call(openAICompatiblePresetDefaults, preset);
							var next = hasPresetDefault ? openAICompatiblePresetDefaults[preset] : '';
							if (hasPresetDefault && preset !== 'custom' && (force || (!isEditingModelForm() && !baseURL.value))) {
								baseURL.value = next;
							}
							if (isDiscoverableOpenAICompatiblePreset()) {
									runAutoDiscoverOpenAICompatibleModels();
								} else if (status) {								status.textContent = 'Enter the model ID manually for local or custom endpoints.';
								}
							toggleCustomProviderAuthFields();
						}
						function readMixtureModelOptions() {
							var el = document.getElementById('mixture_fields');
							if (!el) return [];
							try { return JSON.parse(el.dataset.options || '[]'); } catch(e) { return []; }
						}
						var mixtureModelOptions = readMixtureModelOptions();

								function selectedMixtureReferenceIDs() {
									var select = document.getElementById('model_mixture_references');
									var ids = [];
									if (!select) return ids;
									for (var i = 0; i < select.options.length; i++) {
										ids.push(select.options[i].value);
									}
									return ids;
								}

								function syncMixtureReferenceOrderInput() {
									var input = document.getElementById('model_mixture_reference_ids_order');
									if (input) input.value = selectedMixtureReferenceIDs().join(',');
								}

								function mixtureReferenceOptionLabel(option) {
									if (!option) return '';
									return option.name + ' (' + option.provider + '/' + option.model + ')';
								}

								function appendMixtureReferenceOption(select, option) {
									if (!select || !option) return null;
									var opt = document.createElement('option');
									opt.value = option.id;
									opt.textContent = mixtureReferenceOptionLabel(option);
									select.appendChild(opt);
									return opt;
								}

									function renderMixtureReferenceOptions(selectedIDs) {
										var selectedSelect = document.getElementById('model_mixture_references');
										var availableSelect = document.getElementById('model_mixture_reference_available');
										if (!selectedSelect || !availableSelect) return;
										var selected = {};
										selectedSelect.innerHTML = '';
										availableSelect.innerHTML = '<option value="">Select reference to add</option>';
										for (var i = 0; i < (selectedIDs || []).length; i++) {
											var id = selectedIDs[i];
											var option = mixtureOptionByID(id);
											if (!option || selected[id]) continue;
											selected[id] = true;
											appendMixtureReferenceOption(selectedSelect, option);
										}
										for (var k = 0; k < mixtureModelOptions.length; k++) {
											if (selected[mixtureModelOptions[k].id]) continue;
											appendMixtureReferenceOption(availableSelect, mixtureModelOptions[k]);
										}
										syncMixtureReferenceOrderInput();
									}
								function addMixtureReference() {
									var availableSelect = document.getElementById('model_mixture_reference_available');
									var selectedSelect = document.getElementById('model_mixture_references');
									if (!availableSelect || !selectedSelect || !availableSelect.value) return;
									var option = mixtureOptionByID(availableSelect.value);
									if (!option) return;
									var added = appendMixtureReferenceOption(selectedSelect, option);
									if (added) added.selected = true;
									availableSelect.remove(availableSelect.selectedIndex);
									availableSelect.value = '';
									syncMixtureReferenceOrderInput();
									updateMixtureCostWarning();
								}

								function removeMixtureReference() {
									var selectedSelect = document.getElementById('model_mixture_references');
									if (!selectedSelect || selectedSelect.selectedIndex < 0) return;
									var removedID = selectedSelect.value;
									selectedSelect.remove(selectedSelect.selectedIndex);
									var ids = selectedMixtureReferenceIDs();
									renderMixtureReferenceOptions(ids);
									var availableSelect = document.getElementById('model_mixture_reference_available');
									if (availableSelect) availableSelect.value = removedID;
									updateMixtureCostWarning();
								}

								function moveMixtureReference(direction) {
									var select = document.getElementById('model_mixture_references');
									if (!select || !direction || select.selectedIndex < 0) return;
									var index = select.selectedIndex;
									var option = select.options[index];
									if (direction < 0 && index > 0) {
										select.insertBefore(option, select.options[index - 1]);
									} else if (direction > 0 && index < select.options.length - 1) {
										select.insertBefore(select.options[index + 1], option);
									}
									option.selected = true;
									syncMixtureReferenceOrderInput();
									updateMixtureCostWarning();
									select.focus();
								}

							function mixtureOptionByID(id) {							for (var i = 0; i < mixtureModelOptions.length; i++) {
								if (mixtureModelOptions[i].id === id) return mixtureModelOptions[i];
							}
							return null;
						}

								function setMixtureValidationError(message) {
									var error = document.getElementById('model_mixture_validation_error');
									if (!error) return;
									error.textContent = message || '';
									error.classList.toggle('hidden', !message);
								}

									function updateMixtureCostWarning() {
										var refs = selectedMixtureReferenceIDs();
										var workers = document.getElementById('model_mixture_max_workers');									if (workers && (!workers.value || workers.value === '0')) workers.value = Math.min(8, Math.max(1, refs.length)).toString();
									var warning = document.getElementById('model_mixture_cost_warning');
									if (warning) warning.textContent = 'This mixture calls ' + refs.length + ' reference model' + (refs.length === 1 ? '' : 's') + ' plus 1 aggregator model per turn.';
									setMixtureValidationError('');
								}
						function buildMixtureConfigJSON() {
							var aggregatorID = document.getElementById('model_mixture_aggregator').value;
							var aggregator = mixtureOptionByID(aggregatorID) || {id: aggregatorID, provider: '', model: '', name: ''};
							var refs = selectedMixtureReferenceIDs().map(function(id) {
								var option = mixtureOptionByID(id) || {id: id, provider: '', model: '', name: ''};
								return {agent_config_id: id, provider: option.provider, model: option.model, label: option.name};
							});
							return JSON.stringify({
								enabled: document.getElementById('model_mixture_enabled').checked,
								reference_models: refs,
								aggregator: {agent_config_id: aggregatorID, provider: aggregator.provider, model: aggregator.model, label: aggregator.name},
								reference_temperature: parseFloat(document.getElementById('model_mixture_reference_temperature').value || '0.6'),
								aggregator_temperature: parseFloat(document.getElementById('model_mixture_aggregator_temperature').value || '0.4'),
								reference_timeout_seconds: parseInt(document.getElementById('model_mixture_timeout').value || '90'),
								max_reference_workers: parseInt(document.getElementById('model_mixture_max_workers').value || '8')
							});
						}

								function mixtureConfigValue(value, fallback) {
									return value === undefined || value === null ? fallback : value;
								}

								function applyMixtureConfig(raw) {
									var cfg = {};
									try { cfg = raw ? JSON.parse(raw) : {}; } catch(e) { cfg = {}; }
									document.getElementById('model_mixture_enabled').checked = cfg.enabled !== false;
									document.getElementById('model_mixture_aggregator').value = (cfg.aggregator && cfg.aggregator.agent_config_id) || '';
									var selectedIDs = [];
									(cfg.reference_models || []).forEach(function(ref) { if (ref.agent_config_id) selectedIDs.push(ref.agent_config_id); });
									renderMixtureReferenceOptions(selectedIDs);
									document.getElementById('model_mixture_reference_temperature').value = mixtureConfigValue(cfg.reference_temperature, 0.6).toString();							document.getElementById('model_mixture_aggregator_temperature').value = mixtureConfigValue(cfg.aggregator_temperature, 0.4).toString();
							document.getElementById('model_mixture_timeout').value = (cfg.reference_timeout_seconds || 90).toString();
							document.getElementById('model_mixture_max_workers').value = (cfg.max_reference_workers || Math.min(8, Math.max(1, (cfg.reference_models || []).length))).toString();
							updateMixtureCostWarning();
						}

						function normalizeModelFormBeforeSubmit() {
							syncModelAPIKeySubmitValue();
							var provider = document.getElementById('model_provider').value;
							var providerValue = document.getElementById('model_provider_value');
								if (provider === 'mixture') {
									providerValue.value = 'mixture';
									var aggregatorID = document.getElementById('model_mixture_aggregator').value;
									var refs = selectedMixtureReferenceIDs();
									if (!aggregatorID) {
										setMixtureValidationError('Choose an aggregator model.');
										return false;
									}
									if (refs.length === 0 && document.getElementById('model_mixture_enabled').checked) {
										setMixtureValidationError('Add at least one reference model, or disable reference fan-out.');
										return false;
									}
									var modelSelect = document.getElementById('model_id');
									if (modelSelect) {
										modelSelect.innerHTML = '<option value="mixture">Mixture of Models</option>';
										modelSelect.value = 'mixture';
									}
									document.getElementById('model_mixture_config_json').value = buildMixtureConfigJSON();
									setMixtureValidationError('');
									return true;
								} else if (isOpenAICompatibleProvider(provider)) {
									var presetInput = document.getElementById('model_openai_compatible_preset');								var currentPreset = presetInput.value || 'custom';
								var nextPreset = openAICompatiblePresetForProvider(provider);
								if (provider === 'openai_compatible_custom' && currentPreset !== 'custom' && !openAICompatiblePresetDefaults[currentPreset]) nextPreset = currentPreset;
								presetInput.value = nextPreset;
								providerValue.value = 'openai_compatible';
							} else {
								providerValue.value = provider;
							}
							return true;
						}

						function setOpenAICompatibleModelValue(modelID, label, selectModel) {						var modelSelect = document.getElementById('model_id');
						if (!modelID) return;
						var found = false;
						for (var i = 0; i < modelSelect.options.length; i++) {
							if (modelSelect.options[i].value === modelID) found = true;
						}
						if (!found) {
							var opt = document.createElement('option');
							opt.value = modelID;
							opt.textContent = label || (modelID + ' (custom)');
							modelSelect.appendChild(opt);
						}
						if (selectModel !== false) {
							modelSelect.value = modelID;
							document.getElementById('model_openai_compatible_custom_model').value = modelID;
							updateTemperatureField(document.getElementById('model_provider').value, modelID);
						}
					}

					function syncOpenAICompatibleModel() {
						var custom = document.getElementById('model_openai_compatible_custom_model').value.trim();
						setOpenAICompatibleModelValue(custom, custom ? custom + ' (custom)' : '', true);
					}

						function discoverOpenAICompatibleModels() {
							var provider = document.getElementById('model_provider').value;
							var baseURL = document.getElementById('model_base_url').value.trim();
							var status = document.getElementById('openai_compatible_discovery_status');
							if (!isDiscoverableOpenAICompatiblePreset()) {
								if (status) status.textContent = 'Enter the model ID manually for local or custom endpoints.';
								return;
							}
							if (!baseURL) {
								status.textContent = 'Enter a base URL before discovering models.';
								return;
							}
							status.textContent = 'Discovering models...';
							var params = new URLSearchParams({base_url: baseURL});
							var configID = document.getElementById('model_config_id').value.trim();
							var modelsURL = document.getElementById('model_custom_models_url').value.trim();
							var form = document.getElementById('model_form');
							if (configID && form &&
								(baseURL !== (form.dataset.originalBaseUrl || '') ||
								 modelsURL !== (form.dataset.originalModelsUrl || ''))) {
								status.textContent = 'Save endpoint changes and reconnect before discovering models.';
								return;
							}
							if (configID) params.set('config_id', configID);
							if (modelsURL || configID) params.set('models_url', modelsURL);
							var preset = document.getElementById('model_openai_compatible_preset').value || 'custom';
							var allowPrivate = document.getElementById('model_custom_allow_private_endpoints').checked ||
								['vllm', 'lm_studio', 'sglang', 'litellm', 'inferrs', 'ds4'].indexOf(preset) !== -1;
							if (allowPrivate) params.set('allow_private', '1');
							var apiKey = document.getElementById('model_api_key').value.trim();
							var headers = {'Accept': 'application/json'};
							if (apiKey) headers['X-OpenAI-Compatible-API-Key'] = apiKey;
							var customAuthMethod = document.getElementById('model_custom_auth_method').value;
							if (preset === 'custom' && (!configID || customAuthMethod === 'api_key')) {
								var liveExtraHeaders = document.getElementById('model_compatible_extra_headers').value.trim();
								var clearExtraHeaders = form && form.querySelector('[name="clear_extra_headers"]');
								if (!liveExtraHeaders && clearExtraHeaders && clearExtraHeaders.checked) liveExtraHeaders = '{}';
								headers['X-OpenAI-Compatible-Auth-Header-Name'] = document.getElementById('model_compatible_auth_header_name').value.trim();
								headers['X-OpenAI-Compatible-Auth-Header-Prefix'] = document.getElementById('model_compatible_auth_header_prefix').value;
								headers['X-OpenAI-Compatible-Extra-Headers'] = liveExtraHeaders;
								headers['X-OpenAI-Compatible-Models-Array-Path'] = document.getElementById('model_custom_models_array_path').value.trim();
								headers['X-OpenAI-Compatible-Model-ID-Field'] = document.getElementById('model_custom_model_id_field').value.trim();
							}
							fetch('/models/openai-compatible/available?' + params.toString(), {headers: headers})
								.then(function(resp) {								return resp.json().then(function(data) {
									if (!resp.ok) throw new Error(data.error || 'Model discovery failed');
									return data;
								});
							})
								.then(function(data) {
									if (document.getElementById('model_provider').value !== provider ||
										document.getElementById('model_base_url').value.trim() !== baseURL ||
										document.getElementById('model_custom_models_url').value.trim() !== modelsURL ||
										!isDiscoverableOpenAICompatiblePreset()) return;
									var models = data.models || [];								for (var i = 0; i < models.length; i++) {
									if (models[i].id) setOpenAICompatibleModelValue(models[i].id, models[i].id, false);
								}
								if (data.resolved_id) setOpenAICompatibleModelValue(data.resolved_id, data.resolved_id, true);
								status.textContent = models.length ? ('Discovered ' + models.length + ' model' + (models.length === 1 ? ' and selected it.' : 's. Choose one or enter the model ID manually.')) : 'No models returned; enter the model ID manually.';
							})
								.catch(function(err) {
									if (document.getElementById('model_provider').value !== provider ||
										document.getElementById('model_base_url').value.trim() !== baseURL ||
										document.getElementById('model_custom_models_url').value.trim() !== modelsURL ||
										!isDiscoverableOpenAICompatiblePreset()) return;
									status.textContent = err.message || 'Model discovery failed; enter the model ID manually.';
								});					}

					function hideAllInfoBoxes() {
						document.getElementById('subscription_info_oauth').classList.add('hidden');
							document.getElementById('ollama_info').classList.add('hidden');
						document.getElementById('ollama_fields').classList.add('hidden');
								document.getElementById('openai_compatible_info').classList.add('hidden');
								document.getElementById('openai_compatible_fields').classList.add('hidden');
								document.getElementById('mixture_fields').classList.add('hidden');
									document.getElementById('openai_api_key_info').classList.add('hidden');					document.getElementById('openai_subscription_info_oauth').classList.add('hidden');
				}

				function selectedProjectIDForModelMutation() {
					var selector = document.getElementById('project-selector');
					if (selector && selector.value) return selector.value;
					var params = new URLSearchParams(window.location.search);
					return params.get('project_id') || '';
				}

				function modelMutationURL(path) {
					var projectID = selectedProjectIDForModelMutation();
					return path + (projectID ? (path.indexOf('?') === -1 ? '?' : '&') + 'project_id=' + encodeURIComponent(projectID) : '');
				}

				var _deleteModelId = '';
				var _deleteModelName = '';
				var _deleteModelIsDefault = false;

				function deleteModel(button) {
					var id = button.dataset.modelId;
					var name = button.dataset.modelName;
					var isDefault = button.dataset.modelIsDefault === 'true';
					if (!id) return;
					_deleteModelId = id;
					_deleteModelName = name || 'this model';
					_deleteModelIsDefault = isDefault;
						window.openDestructiveConfirmDialog('delete_model_confirm_modal', 'delete_model_confirm_name', _deleteModelName);
				}

				function confirmDeleteModel() {
					if (!_deleteModelId) return;
					var confirmModal = document.getElementById('delete_model_confirm_modal');
					if (confirmModal) confirmModal.close();
					if (_deleteModelIsDefault) {
						var select = document.getElementById('reassign_default_select');
						if (select && select.options.length > 0) {
							reassign_default_modal.showModal();
							return;
						}
					}
					htmx.ajax('DELETE', modelMutationURL('/models/' + _deleteModelId), {
						target: '#models-container',
						swap: 'outerHTML'
					}).catch(function(xhr) {
						var msg = 'Failed to delete model.';
						try {
							var data = JSON.parse(xhr.responseText);
							if (data.message) msg = data.message;
						} catch(e) {}
						alert(msg);
					});
				}

			function confirmDeleteDefault() {
				var newDefaultId = document.getElementById('reassign_default_select').value;
				if (!newDefaultId) {
					alert('Please select a new default model.');
					return;
				}
				reassign_default_modal.close();
				htmx.ajax('DELETE', modelMutationURL('/models/' + _deleteModelId + '?new_default_id=' + encodeURIComponent(newDefaultId)), {
					target: '#models-container',
					swap: 'outerHTML'
				}).catch(function(xhr) {
					var msg = 'Failed to delete model.';
					try {
						var data = JSON.parse(xhr.responseText);
						if (data.message) msg = data.message;
					} catch(e) {}
					alert(msg);
				});
			}

				function setDefaultModel(button) {
					var path = button.dataset.modelSetDefaultUrl;
					if (!path) return;
					htmx.ajax('POST', modelMutationURL(path), {
						target: '#models-container',
						swap: 'outerHTML'
					});
				}

			function editModelFromData(button) {
				var id = button && button.dataset ? button.dataset.modelId : '';
				if (!id) return;
				window._modelEditRequestGeneration = (window._modelEditRequestGeneration || 0) + 1;
				var generation = window._modelEditRequestGeneration;
				window._modelEditRequestedID = id;
				fetch(modelMutationURL('/models/' + encodeURIComponent(id) + '/edit-details'), {
					credentials: 'same-origin',
					headers: {'Accept': 'application/json'},
					cache: 'no-store'
				}).then(function(resp) {
					if (!resp.ok) throw new Error('Could not load model configuration.');
					return resp.json();
				}).then(function(details) {
					if (generation !== window._modelEditRequestGeneration || window._modelEditRequestedID !== id || details.id !== id) return;
					populateModelEditForm({dataset: {
						modelId: details.id,
						modelName: details.name || '',
						modelProvider: details.provider || '',
						modelModel: details.model || '',
						modelReasoningEffort: details.reasoning_effort || '',
						modelTemperature: String(details.temperature || 0),
						modelIsDefault: String(details.is_default === true),
						modelApiKey: details.api_key || '',
						modelAuthMethod: details.auth_method || 'api_key',
						modelMaxWorkers: String(details.max_workers || 0),
						modelWorkerTimeout: String(details.worker_timeout || 0),
						modelOauthClientId: details.oauth_client_id || '',
						modelOauthClientSecret: details.oauth_client_secret || '',
						modelOauthAuthorizeUrl: details.oauth_authorize_url || '',
						modelOauthTokenUrl: details.oauth_token_url || '',
						modelOauthScopes: details.oauth_scopes || '',
						modelOllamaBaseUrl: details.ollama_base_url || '',
						modelBaseUrl: details.base_url || '',
						modelTransport: details.transport || '',
						modelPresetSlug: details.preset_slug || '',
						modelModelsUrl: details.models_url || '',
						modelAuthHeaderName: details.auth_header_name || '',
						modelAuthHeaderValuePrefix: details.auth_header_value_prefix || '',
						modelExtraHeadersJson: details.extra_headers_json || '',
						modelExtraBodyJson: details.extra_body_json || '',
						modelCustomAuthConfig: details.custom_auth_config_json || '',
						modelAutoStartTasks: String(details.auto_start_tasks === true),
						modelMixtureConfigJson: details.mixture_config_json || ''
					}});
				}).catch(function(err) {
					if (generation !== window._modelEditRequestGeneration || window._modelEditRequestedID !== id) return;
					alert(err.message || 'Could not load model configuration.');
				});
			}

			function populateModelEditForm(button) {
				var id = button.dataset.modelId;
				var name = button.dataset.modelName;
					var dbProvider = button.dataset.modelProvider;
					var model = button.dataset.modelModel;
					var reasoningEffort = button.dataset.modelReasoningEffort || '';
					var temperature = parseFloat(button.dataset.modelTemperature);
						var isDefault = button.dataset.modelIsDefault === 'true';
						var apiKey = button.dataset.modelApiKey || '';
						var hasAPIKey = apiKey !== '';
							var authMethod = button.dataset.modelAuthMethod || 'api_key';					var modelMaxWorkers = parseInt(button.dataset.modelMaxWorkers) || 0;
					var workerTimeout = parseInt(button.dataset.modelWorkerTimeout) || 0;
					var ollamaBaseUrl = button.dataset.modelOllamaBaseUrl || '';
					var baseUrl = button.dataset.modelBaseUrl || '';
					var transport = button.dataset.modelTransport || 'chat_completions';
					var presetSlug = button.dataset.modelPresetSlug || 'custom';
					var modelsUrl = button.dataset.modelModelsUrl || '';
					var authHeaderName = button.dataset.modelAuthHeaderName || '';
					var authHeaderValuePrefix = button.dataset.modelAuthHeaderValuePrefix || '';
					var extraHeadersJSON = button.dataset.modelExtraHeadersJson || '';
					var extraBodyJSON = button.dataset.modelExtraBodyJson || '';
					var customAuthConfigJSON = button.dataset.modelCustomAuthConfig || '';
					var oauthAuthorizeUrl = button.dataset.modelOauthAuthorizeUrl || '';
					var oauthTokenUrl = button.dataset.modelOauthTokenUrl || '';
					var oauthClientId = button.dataset.modelOauthClientId || '';
					var oauthClientSecret = button.dataset.modelOauthClientSecret || '';
					var oauthScopes = button.dataset.modelOauthScopes || '';
						var autoStartTasks = button.dataset.modelAutoStartTasks === 'true';
						var mixtureConfigJSON = button.dataset.modelMixtureConfigJson || '';

						/* Map DB provider values to UI values. */
						var uiProvider = dbProvider;				var anthropicAuthType = 'api_key';
				var openaiAuthType = 'api_key';
				var openaiConnectionMethod = 'oauth';
					if (dbProvider === 'anthropic') {
						uiProvider = 'anthropic';
						if (authMethod === 'api_key' || (authMethod === '' && !dbProvider)) {
							anthropicAuthType = 'api_key';
						} else {
							anthropicAuthType = 'oauth';
						}
						} else if (dbProvider === 'openai_compatible') {
							if (presetSlug && presetSlug !== 'custom' && openAICompatiblePresetDefaults.hasOwnProperty(presetSlug)) {
								uiProvider = 'openai_compatible_' + presetSlug;
							} else {
								uiProvider = 'openai_compatible_custom';
							}
						} else if (dbProvider === 'mixture') {
							uiProvider = 'mixture';
						} else if (dbProvider === 'openai') {					if (authMethod === 'api_key') {
						openaiAuthType = 'api_key';
					} else {
						openaiAuthType = 'oauth';
							openaiConnectionMethod = 'oauth';
					}
				}

					var form = document.getElementById('model_form');
					clearModelFormError();
					document.getElementById('model_modal_title').textContent = 'Edit Model Configuration';
					var _editUrl = modelMutationURL('/models/' + id);
					form.action = _editUrl;
					form.removeAttribute('hx-post');
					form.setAttribute('hx-put', _editUrl);
					form.method = 'post';
					form.dataset.mode = 'edit';
					form.dataset.originalApiKey = apiKey;
					form.dataset.originalBaseUrl = baseUrl;
					form.dataset.originalModelsUrl = modelsUrl;
					document.getElementById('model_config_id').value = id;					document.getElementById('model_name').value = name;				document.getElementById('model_provider').value = uiProvider;
				document.getElementById('model_anthropic_auth_type').value = anthropicAuthType;
				document.getElementById('model_openai_auth_type').value = openaiAuthType;
					document.getElementById('model_openai_connection_method').value = openaiConnectionMethod;
					document.getElementById('model_api_key').value = apiKey;
					syncModelAPIKeySubmitValue();
					setModelAPIKeyEditHelp(hasAPIKey);
					document.getElementById('model_api_key').required = false;				document.getElementById('model_temperature').value = temperature.toString();
				document.getElementById('model_is_default').checked = isDefault;
					document.getElementById('model_auth_method').value = authMethod;
					document.getElementById('model_max_workers').value = modelMaxWorkers.toString();
					document.getElementById('model_worker_timeout').value = workerTimeout.toString();
					document.getElementById('model_ollama_base_url').value = ollamaBaseUrl || 'http://localhost:11434';
					document.getElementById('model_ollama_custom_model').value = '';
					document.getElementById('model_base_url').value = baseUrl;
					document.getElementById('model_openai_compatible_transport').value = transport || 'chat_completions';
					document.getElementById('model_openai_compatible_preset').value = presetSlug || 'custom';
					document.getElementById('model_custom_auth_method').value = dbProvider === 'openai_compatible' && authMethod === 'oauth' ? 'oauth' : 'api_key';
					document.getElementById('model_compatible_auth_header_name').value = authHeaderName || 'Authorization';
					document.getElementById('model_compatible_auth_header_prefix').value = (authHeaderName || authHeaderValuePrefix) ? authHeaderValuePrefix : 'Bearer ';
					document.getElementById('model_compatible_extra_headers').value = extraHeadersJSON;
					document.getElementById('model_compatible_extra_body').value = extraBodyJSON;
					document.getElementById('model_custom_authorize_url').value = oauthAuthorizeUrl;
					document.getElementById('model_custom_token_url').value = oauthTokenUrl;
					document.getElementById('model_custom_oauth_client_id').value = oauthClientId;
					document.getElementById('model_custom_oauth_client_secret').value = oauthClientSecret;
					document.getElementById('model_custom_oauth_scopes').value = oauthScopes;
					document.getElementById('model_custom_models_url').value = modelsUrl;
					applyCustomAuthConfig(customAuthConfigJSON);
						document.getElementById('model_openai_compatible_custom_model').value = dbProvider === 'openai_compatible' ? model : '';
						document.getElementById('model_auto_start_tasks').checked = autoStartTasks;				document.getElementById('model_submit_btn').textContent = 'Save';
				toggleProviderFields(model, reasoningEffort);
				applyMixtureConfig(dbProvider === 'mixture' ? mixtureConfigJSON : '');
				resetSecretInputVisibility('model_api_key');
				resetSecretInputVisibility('model_custom_oauth_client_secret');
				resetSecretInputVisibility('model_custom_signing_secret');
				resetSecretInputVisibility('model_compatible_extra_headers');
				resetSecretInputVisibility('model_custom_static_headers_json');
				resetSecretInputVisibility('model_custom_token_headers_json');
				resetSecretInputVisibility('model_custom_refresh_headers_json');
				resetSecretInputVisibility('model_custom_refresh_parameters_json');
				new_model_modal.showModal();
			}

			function toggleProviderFields(selectedModel, selectedReasoningEffort) {
				var provider = document.getElementById('model_provider').value;
				var effectiveProvider = canonicalProvider(provider);
				var modelField = document.getElementById('model_field');
				var apiKeyField = document.getElementById('api_key_field');
				var apiKeyInput = document.getElementById('model_api_key');
				var anthropicAuthTypeField = document.getElementById('anthropic_auth_type_field');
				var openaiAuthTypeField = document.getElementById('openai_auth_type_field');
				var openaiConnectionMethodField = document.getElementById('openai_connection_method_field');
				var authMethodField = document.getElementById('auth_method_field');
				var ollamaInfo = document.getElementById('ollama_info');
				var forcePresetDefaults = selectedModel === undefined && selectedReasoningEffort === undefined;

				document.getElementById('model_provider_value').value = effectiveProvider;
				hideAllInfoBoxes();
				var activeModel = setModelOptions(provider, selectedModel);
				if (modelField) modelField.classList.toggle('hidden', provider === 'mixture');
				if (provider === 'anthropic') {
					anthropicAuthTypeField.classList.remove('hidden');
					openaiAuthTypeField.classList.add('hidden');
					openaiConnectionMethodField.classList.add('hidden');
					document.getElementById('model_openai_connection_method').disabled = true;
					toggleAnthropicAuthFields();
				} else if (provider === 'openai') {
					anthropicAuthTypeField.classList.add('hidden');
					openaiAuthTypeField.classList.remove('hidden');
					authMethodField.classList.add('hidden');
					document.getElementById('model_auth_method').disabled = true;
					toggleOpenAIAuthFields();
						} else if (effectiveProvider === 'openai_compatible') {
							anthropicAuthTypeField.classList.add('hidden');
							openaiAuthTypeField.classList.add('hidden');
							openaiConnectionMethodField.classList.add('hidden');
							authMethodField.classList.add('hidden');
							apiKeyField.classList.remove('hidden');
							apiKeyInput.required = false;
							document.getElementById('openai_compatible_info').classList.remove('hidden');
							document.getElementById('openai_compatible_fields').classList.remove('hidden');
							document.getElementById('model_auth_method').disabled = true;
							document.getElementById('model_openai_connection_method').disabled = true;
								applyOpenAICompatiblePreset(forcePresetDefaults);
								toggleCustomProviderAuthFields();
								document.getElementById('model_openai_compatible_custom_model').value = activeModel || '';
						} else if (provider === 'mixture') {
							anthropicAuthTypeField.classList.add('hidden');
							openaiAuthTypeField.classList.add('hidden');
							openaiConnectionMethodField.classList.add('hidden');
							authMethodField.classList.add('hidden');
							apiKeyField.classList.add('hidden');
							apiKeyInput.required = false;
							document.getElementById('mixture_fields').classList.remove('hidden');
							document.getElementById('model_auth_method').disabled = true;
							document.getElementById('model_openai_connection_method').disabled = true;
							updateMixtureCostWarning();
					} else if (provider === 'ollama') {
						anthropicAuthTypeField.classList.add('hidden');					openaiAuthTypeField.classList.add('hidden');
					openaiConnectionMethodField.classList.add('hidden');
					authMethodField.classList.add('hidden');
					apiKeyField.classList.add('hidden');
					apiKeyInput.required = false;
					ollamaInfo.classList.remove('hidden');
					document.getElementById('ollama_fields').classList.remove('hidden');
					document.getElementById('model_auth_method').disabled = true;
					document.getElementById('model_openai_connection_method').disabled = true;
				} else {
					anthropicAuthTypeField.classList.add('hidden');
					openaiAuthTypeField.classList.add('hidden');
					openaiConnectionMethodField.classList.add('hidden');
					authMethodField.classList.add('hidden');
					apiKeyField.classList.remove('hidden');
					apiKeyInput.required = true;
					document.getElementById('model_auth_method').disabled = true;
					document.getElementById('model_openai_connection_method').disabled = true;
				}
						setReasoningEffortOptions(provider, activeModel, selectedReasoningEffort);
						updateTemperatureField(provider, activeModel);
					}

				function isEditingModelForm() {
					return document.getElementById('model_form').dataset.mode === 'edit';
				}

				function toggleAnthropicAuthFields() {				var authType = document.getElementById('model_anthropic_auth_type').value;
				var apiKeyField = document.getElementById('api_key_field');
				var apiKeyInput = document.getElementById('model_api_key');
				var authMethodField = document.getElementById('auth_method_field');
				var authMethodSelect = document.getElementById('model_auth_method');

				hideAllInfoBoxes();

					if (authType === 'api_key') {
						apiKeyField.classList.remove('hidden');
						apiKeyInput.required = !isEditingModelForm();
						authMethodField.classList.add('hidden');
					} else {
					// OAuth via API is the only supported path; CLI option is not exposed in the UI
					apiKeyField.classList.add('hidden');
					apiKeyInput.required = false;
					authMethodField.classList.add('hidden');
					authMethodSelect.value = 'oauth';
					document.getElementById('subscription_info_oauth').classList.remove('hidden');
				}
			}

				function setCustomAuthField(id, value) {
					var el = document.getElementById(id);
					if (el && value !== undefined && value !== null) el.value = value;
				}

				function applyCustomAuthConfig(raw) {
					var cfg = {};
					try { cfg = raw ? JSON.parse(raw) : {}; } catch(e) {}
					setCustomAuthField('model_custom_refresh_url', cfg.refresh_url || '');
					setCustomAuthField('model_custom_profile_url', cfg.profile_url || '');
					setCustomAuthField('model_custom_user_agent', cfg.user_agent || '');
					setCustomAuthField('model_custom_authorization_mode', cfg.authorization_mode || 'auto');
					setCustomAuthField('model_custom_access_token_header', cfg.access_token_header || 'Authorization');
					setCustomAuthField('model_custom_access_token_prefix', cfg.access_token_prefix || '');
					setCustomAuthField('model_custom_instance_path', cfg.profile_instance_path || 'instances.0.instance_id');
					setCustomAuthField('model_custom_team_path', cfg.profile_team_path || 'instances.0.teams.0.id');
					setCustomAuthField('model_custom_instance_header', cfg.instance_header || 'x-instance-id');
					setCustomAuthField('model_custom_team_header', cfg.team_header || 'x-team-id');
					setCustomAuthField('model_custom_timestamp_header', cfg.timestamp_header || 'x-request-timestamp');
					setCustomAuthField('model_custom_signature_header', cfg.signature_header || 'x-request-signature');
					setCustomAuthField('model_custom_models_array_path', cfg.models_array_path || 'data');
					setCustomAuthField('model_custom_model_id_field', cfg.model_id_field || 'id');
					setCustomAuthField('model_custom_token_request_format', cfg.token_request_format || 'json');
					setCustomAuthField('model_custom_refresh_request_format', cfg.refresh_request_format || cfg.token_request_format || 'json');
					setCustomAuthField('model_custom_access_token_field', cfg.access_token_field || 'token');
					setCustomAuthField('model_custom_refresh_token_field', cfg.refresh_token_field || 'refresh_token');
					setCustomAuthField('model_custom_expires_in_field', cfg.expires_in_field || 'expires_in');
					setCustomAuthField('model_custom_callback_parameter', cfg.callback_parameter || 'callback_uri');
					setCustomAuthField('model_custom_local_callback_host', cfg.local_callback_host || 'localhost');
					setCustomAuthField('model_custom_local_callback_path', cfg.local_callback_path || '/callback');
					setCustomAuthField('model_custom_authorization_parameters_json', cfg.authorization_parameters ? JSON.stringify(cfg.authorization_parameters, null, 2) : '');
					setCustomAuthField('model_custom_refresh_parameters_json', cfg.refresh_parameters ? JSON.stringify(cfg.refresh_parameters) : '');
					var standardFields = document.getElementById('model_custom_standard_token_fields');
					if (standardFields) standardFields.checked = cfg.standard_token_fields === true;
					var pkce = document.getElementById('model_custom_oauth_pkce');
					if (pkce) pkce.checked = cfg.pkce === true;
					var allowPrivate = document.getElementById('model_custom_allow_private_endpoints');
					if (allowPrivate) allowPrivate.checked = cfg.allow_private_endpoints === true;
					var refreshGrant = document.getElementById('model_custom_refresh_include_grant_type');
					if (refreshGrant) refreshGrant.checked = cfg.refresh_include_grant_type === true;
					var refreshClient = document.getElementById('model_custom_refresh_include_client');
					if (refreshClient) refreshClient.checked = cfg.refresh_include_client === true;
					setCustomAuthField('model_custom_static_headers_json', cfg.static_headers ? JSON.stringify(cfg.static_headers) : '');
					setCustomAuthField('model_custom_token_headers_json', cfg.token_headers ? JSON.stringify(cfg.token_headers) : '');
					setCustomAuthField('model_custom_refresh_headers_json', cfg.refresh_headers ? JSON.stringify(cfg.refresh_headers) : '');
					setCustomAuthField('model_custom_signing_secret', cfg.signing_secret || '');
					toggleCustomProviderAuthFields();
				}

				function toggleCustomProviderAuthFields() {
					var provider = document.getElementById('model_provider').value;
					var preset = openAICompatiblePresetForProvider(provider);
					var root = document.getElementById('custom_provider_auth_fields');
					var oauthFields = document.getElementById('custom_provider_oauth_fields');
					var methodInput = document.getElementById('model_custom_auth_method');
					var showCustom = canonicalProvider(provider) === 'openai_compatible' && preset === 'custom';
					if (!showCustom) methodInput.value = 'api_key';
					var method = methodInput.value;
					if (root) root.classList.toggle('hidden', !showCustom);
					if (oauthFields) oauthFields.classList.toggle('hidden', !showCustom || method !== 'oauth');
					if (root) root.querySelectorAll('input, select, textarea').forEach(function(el) { el.disabled = !showCustom; });
					if (oauthFields) oauthFields.querySelectorAll('input, select, textarea').forEach(function(el) { el.disabled = !showCustom || method !== 'oauth'; });
					var apiKeyField = document.getElementById('api_key_field');
					if (apiKeyField && canonicalProvider(provider) === 'openai_compatible') {
						apiKeyField.classList.toggle('hidden', showCustom && method === 'oauth');
					}
				}

				function toggleSubscriptionMethodFields() {
					var method = document.getElementById('model_auth_method').value;
					var subscriptionInfoOauth = document.getElementById('subscription_info_oauth');
					if (method === 'oauth') {
						subscriptionInfoOauth.classList.remove('hidden');
					} else {
						subscriptionInfoOauth.classList.remove('hidden');
					}
				}

			function toggleOpenAIAuthFields() {
				var authType = document.getElementById('model_openai_auth_type').value;
				var apiKeyField = document.getElementById('api_key_field');
				var apiKeyInput = document.getElementById('model_api_key');
				var openaiConnectionMethodField = document.getElementById('openai_connection_method_field');
				var openaiConnectionMethodSelect = document.getElementById('model_openai_connection_method');

				hideAllInfoBoxes();

					if (authType === 'api_key') {
						apiKeyField.classList.remove('hidden');
						apiKeyInput.required = !isEditingModelForm();
						openaiConnectionMethodField.classList.add('hidden');
						document.getElementById('openai_api_key_info').classList.remove('hidden');
					} else {
					// OAuth via API is the only supported path; CLI option is not exposed in the UI
					apiKeyField.classList.add('hidden');
					apiKeyInput.required = false;
					openaiConnectionMethodField.classList.add('hidden');
					openaiConnectionMethodSelect.value = 'oauth';
					document.getElementById('openai_subscription_info_oauth').classList.remove('hidden');
				}
			}

					function toggleOpenAIConnectionMethodFields() {
						hideAllInfoBoxes();
						document.getElementById('openai_subscription_info_oauth').classList.remove('hidden');
					}

				function closeModelModal() {
					window._modelEditRequestGeneration = (window._modelEditRequestGeneration || 0) + 1;
					window._modelEditRequestedID = '';
					new_model_modal.close();
				}

				function clearModelFormError() {
					var errorBox = document.getElementById('model_form_error');
					var errorMessage = document.getElementById('model_form_error_message');
					if (errorMessage) errorMessage.textContent = '';
					if (errorBox) errorBox.classList.add('hidden');
				}

				function showModelFormError(message) {
					var errorBox = document.getElementById('model_form_error');
					var errorMessage = document.getElementById('model_form_error_message');
					if (!errorBox || !errorMessage) return;
					errorMessage.textContent = message || 'Could not save model.';
					errorBox.classList.remove('hidden');
					errorBox.scrollIntoView({behavior: 'smooth', block: 'nearest'});
					errorBox.focus({preventScroll: true});
				}

				function modelSaveErrorMessage(xhr) {
					var fallback = 'Could not save model.';
					if (!xhr || !xhr.responseText) return fallback;
					try {
						var payload = JSON.parse(xhr.responseText);
						return payload.message || payload.error || fallback;
					} catch (e) {
						return xhr.responseText.trim() || fallback;
					}
				}

				function openNewModelModal() {
					window._modelEditRequestGeneration = (window._modelEditRequestGeneration || 0) + 1;
					window._modelEditRequestedID = '';
					var form = document.getElementById('model_form');
					clearModelFormError();
					document.getElementById('model_modal_title').textContent = 'New Model Configuration';
					var _createUrl = modelMutationURL('/models');
					form.action = _createUrl;
					form.removeAttribute('hx-put');
					form.setAttribute('hx-post', _createUrl);
					form.method = 'post';
					form.dataset.mode = 'create';
					form.dataset.originalApiKey = '';
					form.dataset.originalBaseUrl = '';
					form.dataset.originalModelsUrl = '';
					document.getElementById('model_config_id').value = '';
					document.getElementById('model_name').value = '';				document.getElementById('model_provider').value = 'anthropic';
				document.getElementById('model_anthropic_auth_type').value = 'api_key';
				document.getElementById('model_openai_auth_type').value = 'api_key';
				document.getElementById('model_openai_connection_method').value = 'oauth';
				document.getElementById('model_api_key').value = '';
				document.getElementById('model_api_key_submit').value = '';
				document.getElementById('model_api_key').placeholder = 'sk-ant-...';
				document.getElementById('model_api_key_help').textContent = 'API keys are hidden by default.';
				document.getElementById('model_api_key').required = true;
				document.getElementById('model_temperature').value = '0';
				document.getElementById('model_is_default').checked = false;
					document.getElementById('model_auth_method').value = 'oauth';
					document.getElementById('model_max_workers').value = '0';
					document.getElementById('model_worker_timeout').value = '0';
					document.getElementById('model_ollama_base_url').value = 'http://localhost:11434';
					document.getElementById('model_ollama_custom_model').value = '';
					document.getElementById('model_openai_compatible_preset').value = 'openrouter';
					document.getElementById('model_openai_compatible_transport').value = 'chat_completions';
					document.getElementById('model_base_url').value = '';
					document.getElementById('model_custom_auth_method').value = 'api_key';
					document.getElementById('model_compatible_auth_header_name').value = 'Authorization';
					document.getElementById('model_compatible_auth_header_prefix').value = 'Bearer ';
					document.getElementById('model_compatible_extra_headers').value = '';
					document.getElementById('model_compatible_extra_body').value = '';
						document.getElementById('model_custom_authorize_url').value = '';
						document.getElementById('model_custom_token_url').value = '';
						document.getElementById('model_custom_oauth_client_id').value = '';
						document.getElementById('model_custom_oauth_client_secret').value = '';
						document.getElementById('model_custom_oauth_scopes').value = '';
						document.getElementById('model_custom_models_url').value = '';
						applyCustomAuthConfig('');
						document.getElementById('model_openai_compatible_custom_model').value = '';
						applyMixtureConfig('');
						document.getElementById('model_auto_start_tasks').checked = false;				document.getElementById('model_submit_btn').textContent = 'Create';
				toggleProviderFields('', '');
				resetSecretInputVisibility('model_api_key');
				resetSecretInputVisibility('model_custom_oauth_client_secret');
				resetSecretInputVisibility('model_custom_signing_secret');
				resetSecretInputVisibility('model_compatible_extra_headers');
				resetSecretInputVisibility('model_custom_static_headers_json');
				resetSecretInputVisibility('model_custom_token_headers_json');
				resetSecretInputVisibility('model_custom_refresh_headers_json');
				resetSecretInputVisibility('model_custom_refresh_parameters_json');
				new_model_modal.showModal();
			}
		</script>
		<script>
				// Close modal after successful HTMX form submission
				document.body.addEventListener('htmx:afterSwap', function(event) {
					if (event.detail.target && event.detail.target.id === 'models-container') {
						var modal = document.getElementById('new_model_modal');
						if (modal && modal.open) {
							modal.close();
						}
					}
				});
				document.body.addEventListener('htmx:responseError', function(event) {
					var form = document.getElementById('model_form');
					if (!form || !event.detail || event.detail.elt !== form) return;
					showModelFormError(modelSaveErrorMessage(event.detail.xhr));
				});
				document.getElementById('model_form').addEventListener('invalid', function(event) {
					var field = event.target;
					var control = field && field.closest ? field.closest('.form-control') : null;
					var label = field && field.id ? document.querySelector('label[for="' + field.id + '"]') : null;
					if (!label && control) label = control.querySelector('.label-text');
					var fieldName = label ? label.textContent.trim() : ((field && field.name) || 'a required field');
					showModelFormError('Complete the required field: ' + fieldName + '.');
				}, true);		</script>
	</div>
}
