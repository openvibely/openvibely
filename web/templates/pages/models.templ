package pages

import (
	"encoding/json"
	"fmt"
	"os"
	"strings"
	"github.com/openvibely/openvibely/internal/models"
	"github.com/openvibely/openvibely/web/templates/components"
	"github.com/openvibely/openvibely/web/templates/layout"
)

templ Models(projects []models.Project, currentProjectID string, agents []models.LLMConfig, modelWorkerStats map[string]int, desktopMode bool) {
	@layout.Base("Models", projects, currentProjectID) {
		@modelsContent(agents, agents, modelWorkerStats, desktopMode, false, CardListState{ProjectID: currentProjectID})
	}
}

// ModelsPage renders a paged Models card list while keeping dialog options
// separate from the visible card page.
templ ModelsPage(projects []models.Project, currentProjectID string, agents []models.LLMConfig, modelOptions []models.LLMConfig, modelWorkerStats map[string]int, desktopMode bool) {
	@layout.Base("Models", projects, currentProjectID) {
		@modelsContent(agents, modelOptions, modelWorkerStats, desktopMode, false, CardListState{ProjectID: currentProjectID})
	}
}

// ModelsPageWithPagination includes the authoritative boundary for the initial
// server-rendered page so mixed card projections do not infer it from DOM count.
templ ModelsPageWithPagination(projects []models.Project, currentProjectID string, agents []models.LLMConfig, modelOptions []models.LLMConfig, modelWorkerStats map[string]int, desktopMode bool, hasMore bool) {
	@layout.Base("Models", projects, currentProjectID) {
		@modelsContent(agents, modelOptions, modelWorkerStats, desktopMode, hasMore, CardListState{ProjectID: currentProjectID})
	}
}

// AgentsContent renders just the agents content for HTMX requests
templ ModelsContent(agents []models.LLMConfig, modelWorkerStats map[string]int, desktopMode bool) {
	@modelsContent(agents, agents, modelWorkerStats, desktopMode, false, CardListState{})
}

// ModelsContentPage renders one bounded card page as an HTMX/browser fragment.
templ ModelsContentPage(agents []models.LLMConfig, modelOptions []models.LLMConfig, modelWorkerStats map[string]int, desktopMode bool) {
	@modelsContent(agents, modelOptions, modelWorkerStats, desktopMode, false, CardListState{})
}

// ModelsContentPageWithPagination renders a bounded card page with its end
// boundary for the browser loader.
templ ModelsContentPageWithPagination(agents []models.LLMConfig, modelOptions []models.LLMConfig, modelWorkerStats map[string]int, desktopMode bool, hasMore bool) {
	@modelsContent(agents, modelOptions, modelWorkerStats, desktopMode, hasMore, CardListState{})
}

templ ModelsPageWithPaginationAndState(projects []models.Project, currentProjectID string, agents []models.LLMConfig, modelOptions []models.LLMConfig, modelWorkerStats map[string]int, desktopMode bool, hasMore bool, state CardListState) {
	@layout.Base("Models", projects, currentProjectID) {
		@modelsContent(agents, modelOptions, modelWorkerStats, desktopMode, hasMore, state)
	}
}

templ ModelsContentPageWithPaginationAndState(agents []models.LLMConfig, modelOptions []models.LLMConfig, modelWorkerStats map[string]int, desktopMode bool, hasMore bool, state CardListState) {
	@modelsContent(agents, modelOptions, modelWorkerStats, desktopMode, hasMore, state)
}

func hasDefault(agents []models.LLMConfig) bool {
	for _, a := range agents {
		if a.IsDefault {
			return true
		}
	}
	return false
}

func modelCardShowsTemperature(agent models.LLMConfig) bool {
	return models.ModelSupportsTemperature(agent.Provider, agent.Model)
}

func oauthStatusText(agent models.LLMConfig) string {
	if !agent.IsOAuth() {
		return ""
	}
	if agent.HasValidOAuthToken() {
		return "Connected"
	}
	if agent.OAuthAccessToken != "" {
		return "Token Expired"
	}
	return "Not Connected"
}

func oauthStatusClass(agent models.LLMConfig) string {
	if !agent.IsOAuth() {
		return ""
	}
	if agent.HasValidOAuthToken() {
		return "badge-success"
	}
	if agent.OAuthAccessToken != "" {
		return "badge-warning"
	}
	return "badge-error"
}

func modelSearchText(agent models.LLMConfig) string {
	status := "active"
	if agent.IsDefault {
		status = "default"
	}
	if agent.IsOAuth() {
		if agent.HasValidOAuthToken() {
			status += " connected"
		} else {
			status += " not connected"
		}
	}
	return agent.Name + " " + string(agent.Provider) + " " + agent.Model + " " + status
}

func modelWorkerRunning(stats map[string]int, id string) int {
	if stats == nil {
		return 0
	}
	return stats[id]
}

func callableMixtureModels(agents []models.LLMConfig) []models.LLMConfig {
	out := make([]models.LLMConfig, 0, len(agents))
	for _, agent := range agents {
		if agent.IsCallableMixtureSlot() {
			out = append(out, agent)
		}
	}
	return out
}

func mixtureModelOptionsJSON(agents []models.LLMConfig) string {
	type modelOption struct {
		ID       string `json:"id"`
		Name     string `json:"name"`
		Provider string `json:"provider"`
		Model    string `json:"model"`
	}
	callable := callableMixtureModels(agents)
	data := make([]modelOption, 0, len(callable))
	for _, agent := range callable {
		data = append(data, modelOption{ID: agent.ID, Name: agent.Name, Provider: string(agent.Provider), Model: agent.Model})
	}
	b, err := json.Marshal(data)
	if err != nil {
		return "[]"
	}
	return string(b)
}

func mixtureAggregatorSummary(agent models.LLMConfig, agents []models.LLMConfig) string {
	if agent.MixtureAggregatorLabel != "" {
		return agent.MixtureAggregatorLabel
	}
	for _, option := range agents {
		if option.ID == agent.MixtureAggregatorID {
			return option.Name
		}
	}
	if agent.MixtureAggregatorID == "" {
		return "Not configured"
	}
	return "Missing aggregator"
}

func mixtureReferenceCount(agent models.LLMConfig) int {
	return agent.MixtureReferenceCount
}

func showOAuthLocalhostFallback() bool {
	return strings.EqualFold(strings.TrimSpace(os.Getenv("OAUTH_REDIRECT_MODE")), "localhost_manual")
}


templ providerIcon(provider models.LLMProvider) {
	if provider == models.ProviderAnthropic {
		<svg xmlns="http://www.w3.org/2000/svg" class="h-5 w-5 shrink-0" viewBox="0 0 24 24" fill="currentColor">
			<path d="M17.3041 3.541h-3.6718l6.696 16.918H24Z"/>
			<path d="M6.6959 3.541 0 20.459h3.7442l1.3693-3.5527h7.0052l1.3693 3.5528h3.7442L10.5363 3.5409Zm-.3712 10.2232 2.2914-5.9456 2.2914 5.9456Z"/>
		</svg>
	} else if provider == models.ProviderOpenAI {
		<svg xmlns="http://www.w3.org/2000/svg" class="h-5 w-5 shrink-0" viewBox="0 0 24 24" fill="currentColor">
			<path d="M22.282 9.821a5.985 5.985 0 0 0-.516-4.91 6.046 6.046 0 0 0-6.51-2.9A6.065 6.065 0 0 0 4.981 4.18a5.998 5.998 0 0 0-3.998 2.9 6.046 6.046 0 0 0 .743 7.097 5.98 5.98 0 0 0 .51 4.911 6.051 6.051 0 0 0 6.515 2.9A5.985 5.985 0 0 0 13.26 24a6.056 6.056 0 0 0 5.772-4.206 5.99 5.99 0 0 0 3.997-2.9 6.056 6.056 0 0 0-.747-7.073zM13.26 22.43a4.476 4.476 0 0 1-2.876-1.04l.141-.081 4.779-2.758a.795.795 0 0 0 .392-.681v-6.737l2.02 1.168a.071.071 0 0 1 .038.052v5.583a4.504 4.504 0 0 1-4.494 4.494zM3.6 18.304a4.47 4.47 0 0 1-.535-3.014l.142.085 4.783 2.759a.771.771 0 0 0 .78 0l5.843-3.369v2.332a.08.08 0 0 1-.033.062L9.74 19.95a4.5 4.5 0 0 1-6.14-1.646zM2.34 7.896a4.485 4.485 0 0 1 2.366-1.973V11.6a.766.766 0 0 0 .388.676l5.815 3.355-2.02 1.168a.076.076 0 0 1-.071 0l-4.83-2.786A4.504 4.504 0 0 1 2.34 7.872zm16.597 3.855l-5.833-3.387L15.119 7.2a.076.076 0 0 1 .071 0l4.83 2.791a4.494 4.494 0 0 1-.676 8.105v-5.678a.79.79 0 0 0-.407-.667zm2.01-3.023l-.141-.085-4.774-2.782a.776.776 0 0 0-.785 0L9.409 9.23V6.897a.066.066 0 0 1 .028-.061l4.83-2.787a4.5 4.5 0 0 1 6.68 4.66zm-12.64 4.135l-2.02-1.164a.08.08 0 0 1-.038-.057V6.085a4.5 4.5 0 0 1 7.375-3.453l-.142.08L8.704 5.46a.795.795 0 0 0-.393.681zm1.097-2.365l2.602-1.5 2.607 1.5v2.999l-2.597 1.5-2.607-1.5z"/>
		</svg>
	} else if provider == models.ProviderOllama {
		<svg xmlns="http://www.w3.org/2000/svg" class="h-5 w-5 shrink-0" fill="none" viewBox="0 0 24 24" stroke="currentColor">
			<path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M5 12h14M5 12a2 2 0 01-2-2V6a2 2 0 012-2h14a2 2 0 012 2v4a2 2 0 01-2 2M5 12a2 2 0 00-2 2v4a2 2 0 002 2h14a2 2 0 002-2v-4a2 2 0 00-2-2m-2-4h.01M17 16h.01"></path>
		</svg>
	} else {
		<svg xmlns="http://www.w3.org/2000/svg" class="h-5 w-5 shrink-0" fill="none" viewBox="0 0 24 24" stroke="currentColor">
			<path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9.75 17L9 20l-1 1h8l-1-1-.75-3M3 13h18M5 17h14a2 2 0 002-2V5a2 2 0 00-2-2H5a2 2 0 00-2 2v10a2 2 0 002 2z"></path>
		</svg>
	}
}

templ modelsContent(agents []models.LLMConfig, modelOptions []models.LLMConfig, modelWorkerStats map[string]int, desktopMode bool, hasMore bool, state CardListState) {
		<div id="models-container" data-search-container hx-history="false" data-card-pagination-root data-card-pagination-url={ CardListURL("models", state) } data-card-pagination-list="#models-card-list" data-card-pagination-card-selector="[data-model-id]" data-card-pagination-key="data-model-id" data-card-pagination-page-size="20" data-card-pagination-has-more={ cardPaginationHasMoreAttribute(hasMore) }>
		@layout.PageTitle("Models")
	<div class="flex items-center justify-between mb-6">
			<h2 class="text-2xl font-bold">Models</h2>
			<button class="btn btn-primary btn-sm" onclick="openNewModelModal()">
				+ Add Model
			</button>
		</div>
			@CardListToolbar(collectionToolbarConfigWithState("models", state))

			<div id="models-card-list" data-card-pagination-list>
				if len(agents) == 0 {
						<div class="text-center py-12" data-search-empty-state>
						<p class="opacity-50 mb-4">No models configured yet. Add one to start executing tasks.</p>
						<button class="btn btn-primary" onclick="openNewModelModal()">
							Configure Model
						</button>
					</div>
				}
				if len(agents) > 0 {
					if showOAuthLocalhostFallback() {
						<div class="alert mb-4">
							<div class="flex-1">
								<div class="font-semibold">OAuth localhost fallback</div>
								<p class="text-sm opacity-80 mt-1">If OAuth redirects to a failed localhost URL, copy that full URL and paste it here to finish connection.</p>
								<div class="mt-3 flex gap-2">
									<input id="oauth_manual_callback_url" type="text" class="input input-bordered w-full" placeholder="http://localhost:1455/auth/callback?code=...&state=..." onclick="event.stopPropagation()"/>
									<button class="btn btn-sm btn-primary" type="button" onclick="event.stopPropagation(); submitOAuthManualComplete()">Complete OAuth</button>
								</div>
							</div>
						</div>
					}
				<div class="grid gap-4">
				for _, agent := range agents {
					<div
						class="card bg-base-100 shadow-sm border border-base-300 cursor-pointer hover:border-primary/40 hover:shadow-md transition-all"
						data-model-id={ agent.ID }
						data-model-name={ agent.Name }
						data-model-provider={ string(agent.Provider) }
						data-model-model={ agent.Model }
						data-search-card
						data-search-text={ modelSearchText(agent) }
						data-card-select-id={ agent.ID }
						data-card-select-eligible={ boolString(!agent.IsDefault) }
						if agent.IsDefault {
							data-card-select-disabled-reason="Default models cannot be deleted"
						}
						onclick="editModelFromData(this)"
					>
						<div class="card-body relative">
							<!-- Kebab menu in top right -->
							<div class="absolute top-4 right-4" onclick="event.stopPropagation()">
								<div class="dropdown dropdown-end">
									<label tabindex="0" class="btn btn-ghost btn-sm" onclick="handleDropdownToggle(event)">
										<svg xmlns="http://www.w3.org/2000/svg" class="h-4 w-4" fill="none" viewBox="0 0 24 24" stroke="currentColor">
											<path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 5v.01M12 12v.01M12 19v.01M12 6a1 1 0 110-2 1 1 0 010 2zm0 7a1 1 0 110-2 1 1 0 010 2zm0 7a1 1 0 110-2 1 1 0 010 2z"></path>
										</svg>
									</label>
									<ul tabindex="0" class="dropdown-content z-[100] menu p-2 shadow bg-base-100 rounded-box w-48 border border-base-300">
										<li>
										<button onclick="event.stopPropagation(); editModelFromData(this.closest('[data-model-id]'))">
											Edit
										</button>										</li>
										if !agent.IsDefault {
											<li>
											<button
												data-model-set-default-url={ fmt.Sprintf("/models/%s/set-default", agent.ID) }
												onclick="event.stopPropagation(); setDefaultModel(this)"
											>													Set as Default
												</button>
											</li>
										}
										<li>
											<button
												class="text-error"
												data-model-id={ agent.ID }
												data-model-name={ agent.Name }
												data-model-is-default={ fmt.Sprintf("%t", agent.IsDefault) }
												onclick="event.stopPropagation(); deleteModel(this)"
											>
												Delete
											</button>
										</li>
									</ul>
								</div>
							</div>
							<!-- Model content with padding for kebab menu -->
							<div class="pr-12">
								<h3 class="font-bold flex items-center gap-2">
									@providerIcon(agent.Provider)
									{ agent.Name }
									if agent.IsDefault {
										<span class="badge badge-sm ov-badge-default">Default</span>
									}
								</h3>
									<p class="text-sm opacity-60">
										if agent.Provider == models.ProviderAnthropic {
											if agent.AuthMethod == models.AuthMethodOAuth {
												Anthropic (OAuth - API) / { agent.Model }
											} else {
												Anthropic (API Key) / { agent.Model }
											}
										} else if agent.Provider == models.ProviderMixture {
											Mixture of Models / { agent.Model }
										} else if agent.Provider == models.ProviderOpenAI {
											if agent.AuthMethod == models.AuthMethodAPIKey {
												OpenAI (API Key) / { agent.Model }
											} else if agent.AuthMethod == models.AuthMethodOAuth {
												OpenAI (OAuth - API) / { agent.Model }
											} else {
												OpenAI (API Key) / { agent.Model }
											}
										} else if agent.Provider == models.ProviderOpenAICompatible {
											OpenAI-Compatible (API Key) / { agent.Model }
											if agent.BaseURL != "" {
												<span class="text-xs opacity-40">({ agent.BaseURL })</span>
											}
										} else if agent.Provider == models.ProviderOllama {
											Ollama / { agent.Model }
											if agent.OllamaBaseURL != "" && agent.OllamaBaseURL != "http://localhost:11434" {
												<span class="text-xs opacity-40">({ agent.OllamaBaseURL })</span>
											}
										} else {
											{ string(agent.Provider) } / { agent.Model }
										}
									</p>
									if agent.Provider == models.ProviderMixture {
										<p class="text-sm opacity-60">Aggregator: { mixtureAggregatorSummary(agent, modelOptions) }</p>
										<p class="text-sm opacity-60">References: { fmt.Sprintf("%d", mixtureReferenceCount(agent)) }</p>
									} else if modelCardShowsTemperature(agent) {
										<p class="text-sm opacity-60">
											{ fmt.Sprintf("Temperature: %.1f", agent.Temperature) }
										</p>
									}
									if agent.ReasoningEffort != "" {
									<p class="text-sm opacity-60">
										Reasoning effort: { agent.ReasoningEffort }
									</p>
								}
								if agent.IsOAuth() {
									<div class="mt-2 flex items-center gap-2">
										<span class={ "badge badge-sm", oauthStatusClass(agent) }>
											{ oauthStatusText(agent) }
										</span>
									if !agent.HasValidOAuthToken() {
											<a href={ templ.SafeURL(fmt.Sprintf("/models/%s/oauth/initiate", agent.ID)) } data-oauth-path={ fmt.Sprintf("/models/%s/oauth/initiate", agent.ID) } data-oauth-external={ fmt.Sprintf("%t", desktopMode) } class="btn btn-xs btn-outline" onclick="event.stopPropagation(); return launchOAuthInSystemBrowser(this.dataset.oauthPath, this)">
											Connect with OAuth
										</a>
									} else {
											<a href={ templ.SafeURL(fmt.Sprintf("/models/%s/oauth/initiate", agent.ID)) } data-oauth-path={ fmt.Sprintf("/models/%s/oauth/initiate", agent.ID) } data-oauth-external={ fmt.Sprintf("%t", desktopMode) } class="btn btn-xs btn-ghost" onclick="event.stopPropagation(); return launchOAuthInSystemBrowser(this.dataset.oauthPath, this)">
												Re-authorize
											</a>
									}
									</div>
								}
								if agent.MaxWorkers > 0 {
									<div class="mt-2 flex items-center gap-2">
										<span class="text-sm opacity-60">Workers:</span>
										<span class={ "badge badge-sm", templ.KV("badge-warning", modelWorkerRunning(modelWorkerStats, agent.ID) >= agent.MaxWorkers), templ.KV("badge-success", modelWorkerRunning(modelWorkerStats, agent.ID) > 0 && modelWorkerRunning(modelWorkerStats, agent.ID) < agent.MaxWorkers), templ.KV("badge-ghost", modelWorkerRunning(modelWorkerStats, agent.ID) == 0) }>
											{ fmt.Sprintf("%d / %d active", modelWorkerRunning(modelWorkerStats, agent.ID), agent.MaxWorkers) }
										</span>
										if agent.WorkerTimeout > 0 {
											<span class="text-xs opacity-50">
												{ fmt.Sprintf("timeout: %ds", agent.WorkerTimeout) }
											</span>
										}
									</div>
								}
							</div>
						</div>
					</div>
				}
				</div>
				}
			</div>
			@CardPaginationStatusWithBoundary(hasMore)

			<!-- Reassign Default Modal -->		<dialog id="reassign_default_modal" class="modal" onclose="if (typeof syncToastContainerHost === 'function') syncToastContainerHost()">
			<div class="modal-box">
				@ModalCloseButton("reassign_default_modal", "Close reassign default model dialog")
				<h3 class="font-bold text-lg mb-2 pr-10">Reassign Default Model</h3>
				<p class="text-sm opacity-70 mb-4">You are deleting the default model. Please select a new default before proceeding.</p>
				<div class="form-control mb-4">
					<label class="label"><span class="label-text">New Default Model</span></label>
					<select id="reassign_default_select" class="select select-bordered w-full">
for _, agent := range modelOptions {
							if !agent.IsDefault {
								<option value={ agent.ID }>{ agent.Name }</option>
							}
						}
					</select>
				</div>
				<div class="modal-action">
					<button type="button" class="btn" onclick="reassign_default_modal.close()">Cancel</button>
					<button type="button" class="btn btn-error" onclick="confirmDeleteDefault()">Delete &amp; Reassign</button>
				</div>
			</div>
			<form method="dialog" class="modal-backdrop">
				<button>close</button>
			</form>
		</dialog>
				@DestructiveConfirmDialog("delete_model_confirm_modal", "Close delete model confirmation", "Delete Model", "Are you sure you want to delete ", "delete_model_confirm_name", "", "? This action cannot be undone.", templ.ComponentScript{Call: "delete_model_confirm_modal.close()"}, templ.ComponentScript{Call: "confirmDeleteModel()"}) {
					Tasks using this model will no longer be able to select it.
				}

			<!-- Model Modal (for both create and edit) -->		<dialog id="new_model_modal" class="modal" onclose="if (typeof syncToastContainerHost === 'function') syncToastContainerHost()">
			<div class="modal-box">
				<button type="button" class="btn btn-circle btn-ghost btn-xs ov-modal-close" onclick="closeModelModal()" aria-label="Close model configuration" title="Close model configuration">
					<svg xmlns="http://www.w3.org/2000/svg" class="h-4 w-4" fill="none" viewBox="0 0 24 24" stroke="currentColor" aria-hidden="true"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M6 18L18 6M6 6l12 12"></path></svg>
				</button>
					<h3 id="model_modal_title" class="font-bold text-lg mb-4 pr-10">New Model Configuration</h3>
						<form id="model_form" method="post" action="/models" hx-post="/models" hx-target="#models-container" hx-swap="outerHTML" onsubmit="clearModelFormError(); return normalizeModelFormBeforeSubmit()">					<input type="hidden" id="model_config_id" name="model_config_id" value=""/>
					<div id="model_form_error" class="alert alert-error hidden mb-4" role="alert" aria-live="assertive" tabindex="-1">
						<span id="model_form_error_message">Could not save model.</span>
					</div>
					<div class="form-control mb-3">						<label class="label"><span class="label-text">Name</span></label>
							<input type="text" id="model_name" name="name" class="input input-bordered" required placeholder="My Model"/>
					</div>
					<div class="form-control mb-3">
						<label class="label"><span class="label-text">Provider</span></label>
							<input type="hidden" id="model_provider_value" name="provider" value="anthropic"/>
							<select id="model_provider" class="select select-bordered" onchange="toggleProviderFields()">
								<optgroup label="Virtual Providers">
									<option value="mixture">Mixture of Models</option>
								</optgroup>
								<optgroup label="Model Providers">
									<option value="anthropic">Anthropic</option>
									<option value="openai">OpenAI</option>
									<option value="openai_compatible_openrouter">OpenRouter</option>
									<option value="openai_compatible_nvidia_nim">NVIDIA NIM</option>
									<option value="openai_compatible_vllm">Local vLLM</option>
									<option value="openai_compatible_lm_studio">LM Studio</option>
									<option value="openai_compatible_sglang">SGLang</option>
									<option value="openai_compatible_litellm">LiteLLM</option>
									<option value="openai_compatible_deepinfra">DeepInfra</option>
									<option value="openai_compatible_fireworks">Fireworks</option>
									<option value="openai_compatible_groq">Groq</option>
									<option value="openai_compatible_mistral">Mistral</option>
									<option value="openai_compatible_cerebras">Cerebras</option>
									<option value="openai_compatible_together">Together</option>
									<option value="openai_compatible_huggingface_router">Hugging Face Router</option>
									<option value="openai_compatible_deepseek">DeepSeek</option>
									<option value="openai_compatible_moonshot">Moonshot</option>
									<option value="openai_compatible_dashscope">Qwen / DashScope</option>
									<option value="openai_compatible_dashscope_intl">Qwen / DashScope Intl</option>
									<option value="openai_compatible_alibaba_coding_plan">Alibaba Coding Plan</option>
									<option value="openai_compatible_zai_glm">Z.AI / GLM</option>
									<option value="openai_compatible_novita">NovitaAI</option>
									<option value="openai_compatible_venice">Venice</option>
									<option value="openai_compatible_qianfan">Qianfan</option>
									<option value="openai_compatible_kilo_code">Kilo Code</option>
									<option value="openai_compatible_arcee">Arcee AI</option>
									<option value="openai_compatible_stepfun">StepFun</option>
									<option value="openai_compatible_stepfun_step_plan">StepFun Step Plan</option>
									<option value="openai_compatible_gmi_cloud">GMI Cloud</option>
									<option value="openai_compatible_chutes">Chutes</option>
									<option value="openai_compatible_tokenhub">Tencent TokenHub</option>
									<option value="openai_compatible_tokenhub_intl">Tencent TokenHub Intl</option>
									<option value="openai_compatible_xiaomi_mimo">Xiaomi MiMo</option>
									<option value="openai_compatible_inferrs">Inferrs Local</option>
									<option value="openai_compatible_ds4">ds4 Local</option>
									<option value="openai_compatible_custom">Custom OpenAI-Compatible</option>
									<option value="ollama">Ollama</option>
								</optgroup>
							</select>					</div>
					<!-- Auth type selector for Anthropic -->
					<div id="anthropic_auth_type_field" class="form-control mb-3">
						<label class="label"><span class="label-text">Authentication</span></label>
						<select name="anthropic_auth_type" id="model_anthropic_auth_type" class="select select-bordered" onchange="toggleAnthropicAuthFields()">
							<option value="api_key">API Key</option>
							<option value="oauth">OAuth</option>
						</select>
					</div>
					<!-- Auth type selector for OpenAI -->
					<div id="openai_auth_type_field" class="form-control mb-3 hidden">
						<label class="label"><span class="label-text">Authentication</span></label>
						<select name="openai_auth_type" id="model_openai_auth_type" class="select select-bordered" onchange="toggleOpenAIAuthFields()">
							<option value="api_key">API Key</option>
							<option value="oauth">OAuth</option>
						</select>
					</div>
					<!-- Connection method selector for OpenAI OAuth (CLI option removed) -->
					<div id="openai_connection_method_field" class="form-control mb-3 hidden">
						<label class="label"><span class="label-text">Connection Method</span></label>
						<select name="auth_method" id="model_openai_connection_method" class="select select-bordered" onchange="toggleOpenAIConnectionMethodFields()">
							<option value="oauth">API (OAuth via web)</option>
						</select>
					</div>
						<div id="model_field" class="form-control mb-3">
							<label class="label"><span class="label-text">Model</span></label>
							<select name="model" id="model_id" class="select select-bordered" onchange="handleModelChange()">
							<option value="claude-sonnet-5">Claude Sonnet 5</option>
							<option value="claude-opus-5">Claude Opus 5</option>
							<option value="claude-sonnet-4-6">Claude Sonnet 4.6</option>
							<option value="claude-opus-4-8">Claude Opus 4.8</option>
							<option value="claude-opus-4-7">Claude Opus 4.7</option>
							<option value="claude-sonnet-4-5-20250929">Claude Sonnet 4.5</option>
							<option value="claude-haiku-4-5-20251001">Claude Haiku 4.5</option>
							<option value="claude-opus-4-6">Claude Opus 4.6</option>
							<option value="claude-fable-5-1">Claude Fable 5.1</option>
							<option value="claude-mythos-5-1">Claude Mythos 5.1</option>
							<option value="claude-fable-5">Claude Fable 5</option>
							<option value="claude-mythos-5">Claude Mythos 5</option>
						</select>
					</div>
							<div id="reasoning_effort_field" class="form-control mb-3 hidden">
								<label class="label"><span id="reasoning_effort_label" class="label-text">Effort</span></label>
								<select name="reasoning_effort" id="model_reasoning_effort" class="select select-bordered"></select>
								<label class="label">
									<span id="reasoning_effort_help" class="label-text-alt opacity-70">Controls provider reasoning/thinking effort for supported models.</span>
								</label>
							</div>
						<div id="api_key_field" class="form-control mb-3">
							<label class="label"><span class="label-text">API Key</span></label>
								@components.SecretInput(components.SecretInputConfig{
									ID:           "model_api_key",
									Class:        "input input-bordered w-full pr-10 font-mono text-xs",
									Placeholder:  "sk-ant-...",
									AutoComplete: "off",
									OnInput:      "syncModelAPIKeySubmitValue(); scheduleAutoDiscoverOpenAICompatibleModels()",
									AriaLabel:    "Toggle API key visibility",
								})
								<input type="hidden" id="model_api_key_submit" name="api_key" value=""/>							<label class="label">
								<span id="model_api_key_help" class="label-text-alt opacity-70">API keys are hidden by default. When editing, leave empty to keep the saved key.</span>
							</label>
							</div>
						<!-- Connection method selector for Anthropic OAuth (CLI option removed) -->
						<div id="auth_method_field" class="form-control mb-3 hidden">						<label class="label"><span class="label-text">Connection Method</span></label>
						<select name="auth_method" id="model_auth_method" class="select select-bordered" onchange="toggleSubscriptionMethodFields()">
							<option value="oauth">API (OAuth via web)</option>
						</select>
					</div>
					<div id="subscription_info_oauth" class="mb-3 hidden">
						<div class="alert alert-info">
							<svg xmlns="http://www.w3.org/2000/svg" fill="none" viewBox="0 0 24 24" class="stroke-current shrink-0 w-6 h-6"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M13 16h-1v-4h-1m1-4h.01M21 12a9 9 0 11-18 0 9 9 0 0118 0z"></path></svg>
							<div>
								<p class="font-semibold">OAuth via API</p>
								<p class="text-sm">Uses the Anthropic API directly via OAuth. After saving, click "Connect with OAuth" on the model card to authorize.</p>
							</div>
						</div>
					</div>
						<div id="openai_subscription_info_oauth" class="mb-3 hidden">
							<div class="alert alert-info">
								<svg xmlns="http://www.w3.org/2000/svg" fill="none" viewBox="0 0 24 24" class="stroke-current shrink-0 w-6 h-6"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M13 16h-1v-4h-1m1-4h.01M21 12a9 9 0 11-18 0 9 9 0 0118 0z"></path></svg>
								<div>
									<p class="font-semibold">OAuth via API</p>
									<p class="text-sm">Uses the OpenAI API directly via OAuth. After saving, click "Connect with OAuth" on the model card to authorize.</p>
								</div>
							</div>
						</div>
					<div id="ollama_info" class="mb-3 hidden">
						<div class="alert alert-info">
							<svg xmlns="http://www.w3.org/2000/svg" fill="none" viewBox="0 0 24 24" class="stroke-current shrink-0 w-6 h-6"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M13 16h-1v-4h-1m1-4h.01M21 12a9 9 0 11-18 0 9 9 0 0118 0z"></path></svg>
							<div>
								<p class="font-semibold">Local Ollama Instance</p>
								<p class="text-sm">Connects to your local Ollama server. Make sure Ollama is running with <code>ollama serve</code>.</p>
							</div>
						</div>
					</div>
							<div id="openai_compatible_fields" class="hidden">
								<input type="hidden" id="model_openai_compatible_preset" name="preset_slug" value="custom"/>
								<input type="hidden" id="model_openai_compatible_transport" name="transport" value="chat_completions"/>							<div class="form-control mb-3">
								<label class="label"><span class="label-text">Base URL</span></label>
								<input type="text" id="model_base_url" name="base_url" class="input input-bordered" placeholder="https://openrouter.ai/api/v1/"/>
								<label class="label"><span class="label-text-alt opacity-70">API root; requests go to base URL + /chat/completions.</span></label>
							</div>
								<div class="form-control mb-3">
									<label class="label"><span class="label-text">Custom Model ID</span></label>
									<input type="text" id="model_openai_compatible_custom_model" class="input input-bordered" placeholder="provider/model-id" oninput="syncOpenAICompatibleModel()"/>
									<label class="label"><span class="label-text-alt opacity-70">Stored exactly as entered, after trimming whitespace.</span></label>
								</div>
									<div class="form-control mb-3">
										<label class="label"><span id="openai_compatible_discovery_status" class="label-text-alt opacity-70">OpenAI-compatible presets auto-load available models when selected; Custom stays manual.</span></label>
										<button type="button" class="btn btn-sm btn-outline self-start" onclick="discoverOpenAICompatibleModels()">Discover Models</button>
									</div>
								<div id="custom_provider_auth_fields">
									<div class="form-control mb-3">
										<label class="label"><span class="label-text">Authentication</span></label>
										<select id="model_custom_auth_method" name="custom_auth_method" class="select select-bordered" onchange="toggleCustomProviderAuthFields()">
											<option value="api_key">API Key / None</option>
											<option value="oauth">OAuth + signed requests</option>
										</select>
									</div>
									<div id="custom_provider_request_fields" class="grid grid-cols-1 md:grid-cols-2 gap-3 mb-3">
										<div class="form-control md:col-span-2"><label class="label"><span class="label-text">Models URL</span></label><input id="model_custom_models_url" name="models_url" class="input input-bordered" placeholder="https://…/models" oninput="scheduleAutoDiscoverOpenAICompatibleModels()"/><label class="label"><span class="label-text-alt opacity-70">Optional dedicated endpoint used by Discover Models.</span></label></div>
										<div class="form-control"><label class="label"><span class="label-text">Models array path</span></label><input id="model_custom_models_array_path" name="custom_models_array_path" class="input input-bordered" value="data"/></div>
										<div class="form-control"><label class="label"><span class="label-text">Model ID field</span></label><input id="model_custom_model_id_field" name="custom_model_id_field" class="input input-bordered" value="id"/></div>
										<div class="form-control"><label class="label"><span class="label-text">API key header</span></label><input id="model_compatible_auth_header_name" name="auth_header_name" class="input input-bordered" value="Authorization" placeholder="Authorization"/></div>
										<div class="form-control"><label class="label"><span class="label-text">API key value prefix</span></label><input id="model_compatible_auth_header_prefix" name="auth_header_value_prefix" class="input input-bordered" value="Bearer " placeholder="Leave empty for a raw API key"/><label class="label"><span class="label-text-alt opacity-70">Use an empty value for headers such as X-API-Key.</span></label></div>
										<div class="form-control">
											<label class="label"><span class="label-text">Additional inference headers (JSON)</span></label>
											@components.SecretInput(components.SecretInputConfig{
												ID:           "model_compatible_extra_headers",
												Name:         "extra_headers_json",
												Class:        "input input-bordered w-full pr-10 font-mono text-xs",
												Placeholder:  `{"X-Required-Header":"value"}`,
												AutoComplete: "off",
												AriaLabel:    "Toggle additional inference headers visibility",
											})
											<label class="label"><span class="label-text-alt opacity-70">Saved headers are hidden by default. Click the eye to reveal or edit them; remove the JSON to clear them.</span></label>
										</div>
										<div class="form-control"><label class="label"><span class="label-text">Additional request body (JSON)</span></label><textarea id="model_compatible_extra_body" name="extra_body_json" class="textarea textarea-bordered" placeholder='{"provider_option":true}'></textarea><label class="label"><span class="label-text-alt opacity-70">The saved object is loaded here. Remove the JSON to clear it.</span></label></div>
									</div>
									<div id="custom_provider_oauth_fields" class="hidden">
										<input type="hidden" name="custom_auth_enabled" value="on"/>
											<div class="grid grid-cols-1 md:grid-cols-2 gap-3">
												<div class="form-control"><label class="label"><span class="label-text">Authorize URL</span></label><input id="model_custom_authorize_url" name="oauth_authorize_url" class="input input-bordered" placeholder="https://…/login"/></div>
												<div class="form-control"><label class="label"><span class="label-text">Token URL</span></label><input id="model_custom_token_url" name="oauth_token_url" class="input input-bordered" placeholder="https://…/token"/></div>
												<div class="form-control"><label class="label"><span class="label-text">Refresh URL</span></label><input id="model_custom_refresh_url" name="custom_refresh_url" class="input input-bordered" placeholder="https://…/refresh"/></div>
												<div class="form-control"><label class="label"><span class="label-text">Profile URL</span></label><input id="model_custom_profile_url" name="custom_profile_url" class="input input-bordered" placeholder="https://…/profile"/></div>
												<div class="form-control"><label class="label"><span class="label-text">Required User-Agent</span></label><input id="model_custom_user_agent" name="custom_user_agent" class="input input-bordered" placeholder="client/version"/></div>
												<div class="form-control"><label class="label"><span class="label-text">OAuth client ID</span></label><input id="model_custom_oauth_client_id" name="oauth_client_id" class="input input-bordered" autocomplete="off"/></div>
												<div class="form-control">
													<label class="label"><span class="label-text">OAuth client secret</span></label>
													@components.SecretInput(components.SecretInputConfig{
														ID:           "model_custom_oauth_client_secret",
														Name:         "oauth_client_secret",
														Class:        "input input-bordered w-full pr-10 font-mono text-xs",
														AutoComplete: "off",
														AriaLabel:    "Toggle OAuth client secret visibility",
													})
													<label class="label"><span class="label-text-alt opacity-70">The saved secret is hidden by default. Click the eye to reveal or edit it; remove it to clear it.</span></label>
												</div>
												<div class="form-control"><label class="label"><span class="label-text">OAuth scopes</span></label><input id="model_custom_oauth_scopes" name="oauth_scopes" class="input input-bordered" placeholder="openid profile"/></div>
												<div class="form-control"><label class="label"><span class="label-text">Callback query parameter</span></label><input id="model_custom_callback_parameter" name="custom_callback_parameter" class="input input-bordered" value="callback_uri"/></div>
												<div class="form-control"><label class="label"><span class="label-text">Local callback host</span></label><select id="model_custom_local_callback_host" name="custom_local_callback_host" class="select select-bordered"><option value="localhost">localhost</option><option value="127.0.0.1">127.0.0.1</option></select><label class="label"><span class="label-text-alt opacity-70">The callback port is always selected automatically.</span></label></div>
												<div class="form-control"><label class="label"><span class="label-text">Local callback path</span></label><input id="model_custom_local_callback_path" name="custom_local_callback_path" class="input input-bordered" value="/callback" placeholder="/callback"/></div>
												<div class="form-control">
													<label class="label"><span class="label-text">Signing secret</span></label>
													@components.SecretInput(components.SecretInputConfig{
														ID:           "model_custom_signing_secret",
														Name:         "custom_signing_secret",
														Class:        "input input-bordered w-full pr-10 font-mono text-xs",
														AutoComplete: "off",
														AriaLabel:    "Toggle signing secret visibility",
													})
													<label class="label"><span class="label-text-alt opacity-70">The saved secret is hidden by default. Click the eye to reveal or edit it; remove it to clear it.</span></label>
												</div>
												<div class="form-control"><label class="label"><span class="label-text">Authorization mode</span></label><select id="model_custom_authorization_mode" name="custom_authorization_mode" class="select select-bordered"><option value="auto">Automatic Bearer/Apikey</option><option value="bearer">Bearer</option><option value="apikey">Apikey</option><option value="raw">Raw token</option></select></div>
												<div class="form-control"><label class="label"><span class="label-text">OAuth token header</span></label><input id="model_custom_access_token_header" name="custom_access_token_header" class="input input-bordered" value="Authorization" placeholder="Authorization"/></div>
												<div class="form-control"><label class="label"><span class="label-text">Custom token value prefix</span></label><input id="model_custom_access_token_prefix" name="custom_access_token_prefix" class="input input-bordered" placeholder="Optional, for example Token "/></div>
											</div>
											<div class="grid grid-cols-1 md:grid-cols-2 gap-3 mt-3">
												<div class="form-control">
													<label class="label"><span class="label-text">Additional request headers (JSON)</span></label>
													@components.SecretInput(components.SecretInputConfig{
														ID:           "model_custom_static_headers_json",
														Name:         "custom_static_headers_json",
														Class:        "input input-bordered w-full pr-10 font-mono text-xs",
														Placeholder:  `{"X-Required-Header":"value"}`,
														AutoComplete: "off",
														AriaLabel:    "Toggle additional request headers visibility",
													})
												</div>
												<div class="form-control"><label class="label"><span class="label-text">Authorization parameters (JSON)</span></label><textarea id="model_custom_authorization_parameters_json" name="custom_authorization_parameters_json" class="textarea textarea-bordered" placeholder='{"audience":"example"}'></textarea></div>
												<div class="form-control">
													<label class="label"><span class="label-text">Token endpoint headers (JSON)</span></label>
													@components.SecretInput(components.SecretInputConfig{
														ID:           "model_custom_token_headers_json",
														Name:         "custom_token_headers_json",
														Class:        "input input-bordered w-full pr-10 font-mono text-xs",
														Placeholder:  `{"X-Token-Header":"value"}`,
														AutoComplete: "off",
														AriaLabel:    "Toggle token endpoint headers visibility",
													})
												</div>
												<div class="form-control">
													<label class="label"><span class="label-text">Refresh endpoint headers (JSON)</span></label>
													@components.SecretInput(components.SecretInputConfig{
														ID:           "model_custom_refresh_headers_json",
														Name:         "custom_refresh_headers_json",
														Class:        "input input-bordered w-full pr-10 font-mono text-xs",
														Placeholder:  `{"X-Refresh-Header":"value"}`,
														AutoComplete: "off",
														AriaLabel:    "Toggle refresh endpoint headers visibility",
													})
												</div>
												<div class="form-control">
													<label class="label"><span class="label-text">Refresh parameters (JSON)</span></label>
													@components.SecretInput(components.SecretInputConfig{
														ID:           "model_custom_refresh_parameters_json",
														Name:         "custom_refresh_parameters_json",
														Class:        "input input-bordered w-full pr-10 font-mono text-xs",
														Placeholder:  `{"audience":"example"}`,
														AutoComplete: "off",
														AriaLabel:    "Toggle refresh parameters visibility",
													})
												</div>
											</div>
											<div class="flex flex-wrap gap-5 mt-3">
												<label class="label cursor-pointer justify-start gap-2"><input id="model_custom_standard_token_fields" name="custom_standard_token_fields" type="checkbox" class="checkbox checkbox-sm"/><span class="label-text">Include standard token fields</span></label>
												<label class="label cursor-pointer justify-start gap-2"><input id="model_custom_oauth_pkce" name="custom_oauth_pkce" type="checkbox" class="checkbox checkbox-sm"/><span class="label-text">Use PKCE</span></label>
												<label class="label cursor-pointer justify-start gap-2"><input id="model_custom_refresh_include_grant_type" name="custom_refresh_include_grant_type" type="checkbox" class="checkbox checkbox-sm"/><span class="label-text">Include refresh grant_type</span></label>
												<label class="label cursor-pointer justify-start gap-2"><input id="model_custom_refresh_include_client" name="custom_refresh_include_client" type="checkbox" class="checkbox checkbox-sm"/><span class="label-text">Include client credentials on refresh</span></label>
											</div>
										<div class="grid grid-cols-2 gap-3 mt-3">
											<div class="form-control"><label class="label"><span class="label-text">Instance JSON path</span></label><input id="model_custom_instance_path" name="custom_profile_instance_path" class="input input-bordered" value="instances.0.instance_id"/></div>
											<div class="form-control"><label class="label"><span class="label-text">Team JSON path</span></label><input id="model_custom_team_path" name="custom_profile_team_path" class="input input-bordered" value="instances.0.teams.0.id"/></div>
											<div class="form-control"><label class="label"><span class="label-text">Instance header</span></label><input id="model_custom_instance_header" name="custom_instance_header" class="input input-bordered" value="x-instance-id"/></div>
											<div class="form-control"><label class="label"><span class="label-text">Team header</span></label><input id="model_custom_team_header" name="custom_team_header" class="input input-bordered" value="x-team-id"/></div>
											<div class="form-control"><label class="label"><span class="label-text">Timestamp header</span></label><input id="model_custom_timestamp_header" name="custom_timestamp_header" class="input input-bordered" value="x-request-timestamp"/></div>
											<div class="form-control"><label class="label"><span class="label-text">Signature header</span></label><input id="model_custom_signature_header" name="custom_signature_header" class="input input-bordered" value="x-request-signature"/></div>
										</div>
											<div class="grid grid-cols-1 md:grid-cols-3 gap-3 mt-3">
												<div class="form-control"><label class="label"><span class="label-text">Token request format</span></label><select id="model_custom_token_request_format" name="custom_token_request_format" class="select select-bordered"><option value="json">JSON</option><option value="form">Form</option></select></div>
												<div class="form-control"><label class="label"><span class="label-text">Refresh request format</span></label><select id="model_custom_refresh_request_format" name="custom_refresh_request_format" class="select select-bordered"><option value="json">JSON</option><option value="form">Form</option></select></div>
												<div class="form-control"><label class="label"><span class="label-text">Access token field</span></label><input id="model_custom_access_token_field" name="custom_access_token_field" class="input input-bordered" value="token"/></div>
												<div class="form-control"><label class="label"><span class="label-text">Refresh token field</span></label><input id="model_custom_refresh_token_field" name="custom_refresh_token_field" class="input input-bordered" value="refresh_token"/></div>
												<div class="form-control"><label class="label"><span class="label-text">Expires-in field</span></label><input id="model_custom_expires_in_field" name="custom_expires_in_field" class="input input-bordered" value="expires_in"/></div>
											</div>
											<p class="text-xs opacity-70 mt-3">HMAC-SHA256 signs METHOD, request path, ISO timestamp, and the SHA-256 hash of the exact request body.</p>
									</div>
									<label class="label cursor-pointer justify-start gap-2"><input id="model_custom_allow_private_endpoints" name="custom_allow_private_endpoints" type="checkbox" class="checkbox checkbox-sm"/><span class="label-text">Allow private/local endpoint access for this model (requires server policy)</span></label>
								</div>
							</div>
						<div id="ollama_fields" class="hidden">
							<div class="form-control mb-3">							<label class="label"><span class="label-text">Base URL</span></label>
							<input type="text" id="model_ollama_base_url" name="ollama_base_url" class="input input-bordered" placeholder="http://localhost:11434" value="http://localhost:11434"/>
							<label class="label">
								<span class="label-text-alt opacity-70">Default: http://localhost:11434</span>
							</label>
						</div>
						<div class="form-control mb-3">
							<label class="label"><span class="label-text">Custom Model Name</span></label>
							<input type="text" id="model_ollama_custom_model" name="ollama_custom_model" class="input input-bordered" placeholder="e.g. llama3.1:8b, codellama:13b"/>
							<label class="label">
								<span class="label-text-alt opacity-70">Enter any model name from <code>ollama list</code>, or select from common ones above</span>
							</label>
						</div>
						</div>
						<div id="mixture_fields" class="hidden" data-options={ mixtureModelOptionsJSON(modelOptions) }>
							<input type="hidden" id="model_mixture_config_json" name="mixture_config_json" value=""/>
							<div class="alert alert-info mb-3">
								<div>
									<p class="font-semibold">Mixture of Models</p>
									<p class="text-sm">Compose an aggregator model with one or more advisory reference models. Need another model? Add a model first.</p>
								</div>
							</div>
							<div class="form-control mb-3">
								<label class="label"><span class="label-text">Aggregator Model</span></label>
								<select id="model_mixture_aggregator" name="mixture_aggregator_id" class="select select-bordered" onchange="renderMixtureReferenceOptions(selectedMixtureReferenceIDs()); updateMixtureCostWarning()">
									<option value="">Select aggregator</option>
									for _, option := range callableMixtureModels(modelOptions) {
										<option value={ option.ID }>{ option.Name } ({ string(option.Provider) }/{ option.Model })</option>
									}
								</select>
							</div>
									<div class="form-control mb-3">
										<label class="label"><span class="label-text">Reference Models</span></label>
										<input type="hidden" id="model_mixture_reference_ids_order" name="mixture_reference_ids" value=""/>
										<div class="flex flex-col gap-2 sm:flex-row">
											<select id="model_mixture_reference_available" class="select select-bordered flex-1" aria-label="Available reference models">
												<option value="">Select reference to add</option>
												for _, option := range callableMixtureModels(modelOptions) {
													<option value={ option.ID }>{ option.Name } ({ string(option.Provider) }/{ option.Model })</option>
												}
											</select>
											<button type="button" class="btn btn-outline" onclick="addMixtureReference()">Add Reference</button>
										</div>
										<select id="model_mixture_references" class="select select-bordered min-h-32 mt-2" size="5" onchange="updateMixtureCostWarning()" aria-describedby="model_mixture_reference_order_help" aria-label="Selected reference model order"></select>
										<div class="flex flex-wrap gap-2 mt-2">
											<button type="button" class="btn btn-xs btn-outline" onclick="moveMixtureReference(-1)">Move Up</button>
											<button type="button" class="btn btn-xs btn-outline" onclick="moveMixtureReference(1)">Move Down</button>
											<button type="button" class="btn btn-xs btn-outline" onclick="removeMixtureReference()">Remove</button>
										</div>
										<label class="label"><span id="model_mixture_reference_order_help" class="label-text-alt opacity-70">Add reference models, select one in the ordered list, then use Move Up and Move Down to place it before or after other selected references.</span></label>
									</div>							<div class="grid grid-cols-2 gap-3">								<div class="form-control mb-3">
									<label class="label"><span class="label-text">Max Reference Workers</span></label>
									<input type="text" inputmode="numeric" pattern="[0-9]*" id="model_mixture_max_workers" name="mixture_max_reference_workers" class="input input-bordered" value="8" oninput="updateMixtureCostWarning()"/>
								</div>
								<div class="form-control mb-3">
									<label class="label"><span class="label-text">Reference Timeout</span></label>
									<input type="text" inputmode="numeric" pattern="[0-9]*" id="model_mixture_timeout" name="mixture_reference_timeout_seconds" class="input input-bordered" value="90"/>
								</div>
								<div class="form-control mb-3">
									<label class="label"><span class="label-text">Reference Temperature</span></label>
									<input type="text" inputmode="decimal" pattern="[0-9]*.?[0-9]*" id="model_mixture_reference_temperature" name="mixture_reference_temperature" class="input input-bordered" value="0.6"/>
								</div>
								<div class="form-control mb-3">
									<label class="label"><span class="label-text">Aggregator Temperature</span></label>
									<input type="text" inputmode="decimal" pattern="[0-9]*.?[0-9]*" id="model_mixture_aggregator_temperature" name="mixture_aggregator_temperature" class="input input-bordered" value="0.4"/>
								</div>
							</div>
							<div class="form-control mt-2">
								<label class="label cursor-pointer justify-start gap-2">
									<input type="checkbox" id="model_mixture_enabled" name="mixture_enabled" class="checkbox checkbox-sm" checked onchange="updateMixtureCostWarning()"/>
									<span class="label-text">Enable reference fan-out</span>
								</label>
							</div>
							<p id="model_mixture_cost_warning" class="text-sm text-warning mt-2">This mixture calls 0 reference models plus 1 aggregator model per turn.</p>
							<p id="model_mixture_validation_error" class="text-sm text-error mt-2 hidden" role="alert"></p>
						</div>
							<div id="openai_compatible_info" class="mb-3 hidden">							<div class="alert alert-info">
								<svg xmlns="http://www.w3.org/2000/svg" fill="none" viewBox="0 0 24 24" class="stroke-current shrink-0 w-6 h-6"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M13 16h-1v-4h-1m1-4h.01M21 12a9 9 0 11-18 0 9 9 0 0118 0z"></path></svg>
								<div>
									<p class="font-semibold">OpenAI-Compatible Chat Completions</p>
									<p class="text-sm">Use OpenAI-compatible Chat Completions providers such as OpenRouter, NVIDIA NIM, LM Studio, LiteLLM, Groq, Mistral, DeepSeek, or custom endpoints. API keys are optional for local servers.</p>
								</div>
							</div>
						</div>
						<div id="openai_api_key_info" class="mb-3 hidden">
							<div class="alert alert-info">							<svg xmlns="http://www.w3.org/2000/svg" fill="none" viewBox="0 0 24 24" class="stroke-current shrink-0 w-6 h-6"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M13 16h-1v-4h-1m1-4h.01M21 12a9 9 0 11-18 0 9 9 0 0118 0z"></path></svg>
							<div>
								<p class="font-semibold">OpenAI API Key</p>
								<p class="text-sm">Enter your OpenAI API key to make direct API calls.</p>
							</div>
						</div>
					</div>
						<div id="model_temperature_field" class="form-control">
							<label class="label"><span class="label-text">Temperature</span></label>
							<input type="text" inputmode="decimal" pattern="[0-9]*.?[0-9]*" id="model_temperature" name="temperature" class="input input-bordered" value="0" placeholder="0–1"/>
							<label class="label">
								<span class="label-text-alt opacity-70">Optional. Leave default unless you know you need more randomness.</span>
							</label>
						</div>
						<div class="form-control mt-3">
						<label class="label cursor-pointer justify-start gap-2">
							<input type="checkbox" id="model_is_default" name="is_default" class="checkbox checkbox-sm"/>
							<span class="label-text">Set as default model</span>
						</label>
					</div>
					<div class="form-control mt-2">
						<label class="label cursor-pointer justify-start gap-2">
							<input type="checkbox" id="model_auto_start_tasks" name="auto_start_tasks" class="checkbox checkbox-sm"/>
							<span class="label-text">Auto-start created tasks</span>
						</label>
						<label class="label">
							<span class="label-text-alt opacity-70">When enabled, tasks created with this model automatically move to "active" status</span>
						</label>
					</div>
					<div class="divider text-sm opacity-60 mt-4 mb-2">Worker Pool</div>
					<div class="grid grid-cols-2 gap-3">
						<div class="form-control">
							<label class="label"><span class="label-text">Max Workers</span></label>
							<input type="text" inputmode="numeric" pattern="[0-9]*" id="model_max_workers" name="model_max_workers" class="input input-bordered" value="0" placeholder="0"/>
							<label class="label">
								<span class="label-text-alt opacity-70">0 = use global pool</span>
							</label>
						</div>
						<div class="form-control">
							<label class="label"><span class="label-text">Inactivity timeout (seconds)</span></label>
							<input type="text" inputmode="numeric" pattern="[0-9]*" id="model_worker_timeout" name="worker_timeout" class="input input-bordered" value="0" placeholder="0"/>
							<label class="label">
								<span class="label-text-alt opacity-70">Resets on model and tool activity. 0 = 30-minute default</span>
							</label>
						</div>
					</div>
					<div class="modal-action">
						<button type="button" class="btn" onclick="closeModelModal()">Cancel</button>
						<button type="submit" id="model_submit_btn" class="btn btn-primary">Create</button>
					</div>
				</form>
			</div>
			<form method="dialog" class="modal-backdrop">
				<button>close</button>
			</form>
		</dialog>

		<style>
			/* Keep password toggle button fixed inside input across press/focus states */
			.password-toggle-btn:active,
			.password-toggle-btn:focus,
			.password-toggle-btn:focus-visible {
				transform: translate(0, -50%) !important;
			}
		</style>

			<script>
					function launchOAuthInSystemBrowser(path, anchor) {
						var href = path || '';
						if (!href) return false;
						href = modelMutationURL(href);
						if (!anchor || anchor.dataset.oauthExternal !== 'true') {
							if (anchor) anchor.href = href;
							return true;
						}
						var externalURL = href;
						if (externalURL.indexOf('?') === -1) {
							externalURL += '?external=1';
						} else if (externalURL.indexOf('external=') === -1) {
							externalURL += '&external=1';
						}
						fetch(externalURL, {
							method: 'GET',
							headers: {
								'X-Requested-With': 'XMLHttpRequest'
							}
						}).then(function(resp) {
							if (!resp.ok) {
								throw new Error('Failed to open OAuth in browser');
							}
							if (window.showToast) window.showToast('Opened browser for OAuth', 'completed');
						}).catch(function(err) {
							if (window.showToast) window.showToast(err.message || 'Failed to open OAuth in browser', 'failed');
						});
						return false;
					}

					function togglePasswordVisibility(inputId, button) {
						const input = document.getElementById(inputId);
						if (!input || !button) return;
						const eyeOpen = button.querySelector('.eye-open');
						const eyeClosed = button.querySelector('.eye-closed');
						const willReveal = input.type === 'password';
						input.type = willReveal ? 'text' : 'password';
						if (eyeOpen) eyeOpen.classList.toggle('hidden', willReveal);
						if (eyeClosed) eyeClosed.classList.toggle('hidden', !willReveal);
						button.setAttribute('aria-pressed', willReveal ? 'true' : 'false');
					}

						function resetSecretInputVisibility(inputId) {
							const input = document.getElementById(inputId);
							if (!input) return;
							input.type = 'password';
							const button = document.querySelector("button[onclick=\"togglePasswordVisibility('" + inputId + "', this)\"]");
							if (!button) return;
							const eyeOpen = button.querySelector('.eye-open');
							const eyeClosed = button.querySelector('.eye-closed');
							if (eyeOpen) eyeOpen.classList.remove('hidden');
							if (eyeClosed) eyeClosed.classList.add('hidden');
							button.setAttribute('aria-pressed', 'false');
						}

						function syncModelAPIKeySubmitValue() {
							const form = document.getElementById('model_form');
							const input = document.getElementById('model_api_key');
							const submit = document.getElementById('model_api_key_submit');
							if (!form || !input || !submit) return;
							const original = form.dataset.originalApiKey || '';
							if (form.dataset.mode === 'edit' && input.value === original) {
								submit.value = '';
								return;
							}
							submit.value = input.value;
						}

							function setModelAPIKeyEditHelp(hasAPIKey) {
								const input = document.getElementById('model_api_key');
								const help = document.getElementById('model_api_key_help');
								if (input) {
									input.placeholder = hasAPIKey ? 'Saved API key' : 'Type an API key to save for this model';
								}
								if (help) {
									help.textContent = hasAPIKey
										? 'Saved API key is hidden by default. Click the eye to reveal or edit it.'
										: 'No API key is currently saved for this model. Type a key to save one, or leave empty to keep it blank.';
								}
							}
					function submitOAuthManualComplete() {
					var input = document.getElementById('oauth_manual_callback_url');
					if (!input) return;
					var callbackUrl = (input.value || '').trim();
					if (!callbackUrl) {
						if (window.showToast) window.showToast('Paste a localhost callback URL first', 'failed');
						return;
					}

					fetch(modelMutationURL('/models/oauth/manual-complete'), {
						method: 'POST',
						headers: {
							'Content-Type': 'application/json',
							'HX-Request': 'true'
						},
						body: JSON.stringify({ callback_url: callbackUrl })
					}).then(function(resp) {
						if (!resp.ok) {
							return resp.json().then(function(data) {
								throw new Error((data && data.error) || 'OAuth completion failed');
							}).catch(function() {
								throw new Error('OAuth completion failed');
							});
						}
						return resp.json();
					}).then(function() {
						if (window.showToast) window.showToast('OAuth connected', 'completed');
						input.value = '';
						window.location.href = modelMutationURL('/models');
					}).catch(function(err) {
						if (window.showToast) window.showToast(err.message || 'OAuth completion failed', 'failed');
					});
				}

				var reasoningEffortOptions = {
					none: 'None',
					minimal: 'Minimal',
					low: 'Low',
					medium: 'Medium',
					high: 'High',
					xhigh: 'XHigh',
					max: 'Max'
				};
			var modelOptionsByProvider = {
