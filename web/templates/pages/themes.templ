package pages

import (
	"strings"

	"github.com/openvibely/openvibely/internal/models"
	"github.com/openvibely/openvibely/internal/themes"
	"github.com/openvibely/openvibely/web/templates/layout"
)

// Keep hidden palettes available to existing saved preferences.
func themeVisibleInPicker(id string) bool {
	switch id {
	case "openvibely-graphite", "openvibely-slate", "openvibely-layered", "vscode-dark-modern", "vscode-default-high-contrast", "vscode-abyss",
		"vscode-kimbie-dark", "vscode-monokai", "vscode-monokai-dimmed",
		"vscode-red", "vscode-solarized-dark", "vscode-solarized-light",
		"vscode-tomorrow-night-blue", "nord", "openvibely-paper",
		"vscode-default-high-contrast-light", "vscode-light", "vscode-dark":
		return false
	default:
		return true
	}
}

templ Themes(projects []models.Project, currentProjectID string, catalog []themes.Theme) {
	@layout.Base("Appearance", projects, currentProjectID) {
		@ThemesContent(catalog)
	}
}

templ ThemesContent(catalog []themes.Theme) {
	<div id="themes-container" data-search-container>
		@layout.PageTitle("Appearance")
		<div data-page-header class="flex items-center justify-between mb-6">
			<h2 id="appearance-section-title" class="text-2xl font-bold">Themes</h2>
		</div>
		<style>
            .theme-thumbnail { --tp-frame: var(--tp-default-frame); --tp-page: var(--tp-default-page); --tp-rail: var(--tp-default-rail); --tp-card: var(--tp-default-card); background: var(--tp-frame); padding-top: 8px; }
            html[data-surface-style="layered"] .theme-thumbnail { --tp-frame: var(--tp-layered-frame); --tp-page: var(--tp-layered-page); --tp-rail: var(--tp-layered-card); --tp-card: var(--tp-layered-card); }
            .theme-thumbnail-rail { background: var(--tp-rail); }
            .theme-thumbnail-page { background: var(--tp-page); }
            .theme-thumbnail-card { background: var(--tp-card); border: 1px solid var(--tp-default-border, transparent); border-radius: 4px; padding: 4px; }
            html[data-surface-style="layered"] .theme-thumbnail-card { border-color: var(--tp-layered-border, var(--tp-frame)); }

			.display-preview { --dp-page: var(--shell-page, oklch(var(--b2))); --dp-card: var(--conversation-card-base); background: var(--dp-frame); height: 104px; border-radius: 8px; overflow: hidden; padding: 8px; width: 100%; }
            .display-preview[data-preview-surfaces="default"] { --dp-frame: var(--surface-default-frame); --dp-page: var(--surface-default-page); --dp-rail: var(--surface-default-rail); --dp-surface-card: var(--surface-default-card); }
            .display-preview[data-preview-surfaces="layered"] { --dp-frame: var(--surface-layered-frame); --dp-page: var(--surface-layered-page); --dp-rail: var(--surface-layered-card); --dp-surface-card: var(--surface-layered-card); }
            .dp-surface-card { padding: 6px; background: var(--dp-surface-card); border: 1px solid transparent; border-radius: 4px; }
            [data-preview-surfaces="default"] .dp-surface-card { border-color: var(--ov-surface-default-border, transparent); }
            [data-preview-surfaces="layered"] .dp-surface-card { border-color: var(--dp-frame); }
			.display-preview[data-kind="output"] { height: 184px; }
			.display-preview i { display: block; height: 4px; border-radius: 2px; background: currentColor; opacity: .3; margin-bottom: 6px; width: 80%; }
			.display-preview i:last-child { width: 55%; margin-bottom: 0; }
			.dp-tabs { height: 18px; display: flex; gap: 5px; padding-left: calc(30% + var(--dp-gap, 0px) + var(--dp-tab-inset, 0px)); }
			.dp-tabs span { width: 42%; height: 14px; border-radius: 5px; background: var(--dp-page); }
			.dp-tabs span + span { opacity: .4; }
			.dp-workspace { display: flex; height: 70px; }
			.dp-list { flex: 0 0 30%; padding: 12px 6px; background: var(--dp-rail); border-right: 1px solid oklch(var(--bc) / .12); border-radius: 7px 0 0 0; }
			.dp-page { flex: 1; padding: 12px; background: var(--dp-page); }
			.display-preview[data-preview-layout="floating"] { --dp-gap: 7px; }
			.display-preview[data-preview-tabs="attached"] { --dp-tab-inset: 6px; }
			.display-preview[data-preview-layout="floating"][data-preview-tabs="attached"] { --dp-tab-inset: 13px; }
			.display-preview[data-preview-layout="floating"] .dp-workspace { gap: var(--dp-gap); }
			.display-preview[data-preview-layout="floating"] :is(.dp-list,.dp-page) { border-radius: 7px 7px 0 0; border: 0; }
			.display-preview[data-preview-tabs="attached"] .dp-tabs span:first-child { height: 18px; border-radius: 7px 7px 0 0; position: relative; }
			.display-preview[data-preview-tabs="attached"] .dp-tabs span:first-child::after { content: ""; position: absolute; width: 6px; height: 6px; right: -6px; bottom: 0; background: radial-gradient(circle at 100% 0, transparent 6px, var(--dp-page) 6px); }
			.display-preview[data-preview-tabs="attached"] .dp-tabs span:first-child::before { content: ""; position: absolute; width: 6px; height: 6px; left: -6px; bottom: 0; background: radial-gradient(circle at 0 0, transparent 6px, var(--dp-page) 6px); }
			.dp-conversation { height: 100%; background: var(--dp-page); padding: 6px; }
			.dp-user, .dp-assistant, .dp-composer { padding: 6px; border-radius: 5px; }
			.dp-user { margin-left: 45%; background: var(--dp-card); margin-bottom: 4px; }
			.dp-composer { background: var(--dp-card); margin-top: 4px; }
			.display-preview[data-preview-thread="focused"] .dp-conversation { padding-left: 22%; padding-right: 22%; }
			.display-preview[data-preview-bubbles="on"] .dp-assistant { background: var(--dp-card); }
			.display-preview[data-preview-step="on"] { --dp-card: var(--conversation-card-raised); }
		</style>
		<section class="mb-8" data-display-prefs data-settings-section="layout" hidden>
			<div class="flex flex-col gap-3 max-w-2xl mb-6">
				@displayToggle("surfaces", "Surfaces", "Choose the background colors used for the outer frame, page and cards.", "default", "Default", "layered", "Layered")
				@displayToggle("layout", "Task list", "Float the task list beside the page with a gap, or join them into one surface.", "floating", "Floating", "unified", "Unified")
				@displayToggle("tabs", "Project tabs", "Keep project tabs separate from the page, or connect the active tab to it.", "detached", "Detached", "attached", "Attached")
			</div>
			<h3 class="text-sm font-medium mt-6 mb-2">Task board columns</h3>
			<p class="text-xs opacity-60 mb-2">How the Backlog, Active and Completed drop zones are marked on the Tasks page.</p>
			<div class="grid gap-4 sm:grid-cols-2 xl:grid-cols-4 max-w-6xl">
				@boardColumnsCard("tint", "Faint tint", "Columns tinted a quarter of the way from page to frame.")
				@boardColumnsCard("filled", "Filled", "Columns filled with the frame color.")
				@boardColumnsCard("inset", "Inset cards", "Columns in the card color, cards sunk in the page color.")
				@boardColumnsCard("tintstrip", "Tint + header strip", "Faint tint columns with the frame color behind the heading.")
			</div>
		</section>
		<section data-display-prefs data-settings-section="chat" hidden>
			<div class="flex flex-col gap-3 max-w-2xl">
				@displayToggle("output", "Tool output", "Compact folds consecutive tool activity into a single expandable row. Assistant messages stay visible.", "full", "Full", "compact", "Compact")
				@displayToggle("thread", "Width", "Use the available width for conversations, or center them in a narrower column for easier reading.", "full", "Full width", "focused", "Focused")
				@displayToggle("bubbles", "Assistant bubbles", "Show assistant messages directly on the page, or give them a filled bubble background.", "off", "Off", "on", "On")
				@displayToggle("step", "Bubble and composer color step", "Lift chat bubbles and the composer one shade above cards.", "off", "Off", "on", "On")
			</div>
		</section>
		<section data-settings-section="themes">
			@CardSearchInput("themes", "Search themes...")
			<div class="grid gap-4 md:grid-cols-2 xl:grid-cols-3" data-themes-grid>
				for _, theme := range catalog {
					if themeVisibleInPicker(theme.ID) {
						@themeCard(theme)
					}
				}
			</div>
		</section>
		<script>
			(function() {
				function refreshDisplayPrefs() {
					var display = window.openVibelyDisplay;
					if (!display) return;
					document.querySelectorAll('.display-preview').forEach(function(preview) {
						['surfaces', 'layout', 'tabs', 'thread', 'bubbles', 'step'].forEach(function(pref) {
							preview.setAttribute('data-preview-' + pref, preview.dataset.kind === pref ? preview.dataset.variant : display.get(pref));
						});
					});
					document.querySelectorAll('[data-board-columns-card]').forEach(function(card) {
						var active = card.getAttribute('data-board-columns-id') === display.get('columns');
						card.setAttribute('aria-pressed', active ? 'true' : 'false');
						card.classList.toggle('border-primary', active);
						card.querySelectorAll('[data-board-columns-active-badge]').forEach(function(badge) { badge.classList.toggle('hidden', !active); });
					});
					document.querySelectorAll('[data-display-option]').forEach(function(btn) {
						var active = display.get(btn.getAttribute('data-display-pref')) === btn.getAttribute('data-display-option');
						btn.setAttribute('aria-pressed', active ? 'true' : 'false');
						btn.classList.toggle('border-primary', active);
						btn.querySelector('[data-display-active]').classList.toggle('hidden', !active);
					});
				}
				window.selectOpenVibelyDisplay = function(name, value) {
					if (window.openVibelyDisplay) window.openVibelyDisplay.set(name, value);
					refreshDisplayPrefs();
				};
				refreshDisplayPrefs();
				function refreshThemeCards() {
					var root = document.getElementById('themes-container');
					if (!root) return;
					var current = document.documentElement.getAttribute('data-color-theme') || '';
					var cards = Array.prototype.slice.call(root.querySelectorAll('[data-theme-card]'));
					cards.forEach(function(card) {
						var active = card.getAttribute('data-theme-id') === current;
						card.setAttribute('aria-pressed', active ? 'true' : 'false');
						card.classList.toggle('border-primary', active);
						card.classList.toggle('shadow-md', active);
						card.querySelectorAll('[data-theme-active-badge]').forEach(function(badge) {
							badge.classList.toggle('hidden', !active);
						});
					});
					if (window.refreshCardSearches) window.refreshCardSearches(root);
				}
				window.openVibelyThemes = window.openVibelyThemes || {};
				window.openVibelyThemes.refreshThemeCards = refreshThemeCards;
				window.selectOpenVibelyTheme = function(id) {
					if (window.openVibelyThemes && typeof window.openVibelyThemes.apply === 'function') {
						window.openVibelyThemes.apply(id);
					}
					refreshThemeCards();
				};
				refreshThemeCards();
                if (window.syncAppearanceSettings) window.syncAppearanceSettings();
			})();
		</script>
	</div>
}

templ themeCard(theme themes.Theme) {
	<button
		type="button"
		class="card bg-base-100 shadow-sm border border-base-300 cursor-pointer hover:border-primary/40 hover:shadow-md transition-all text-left w-full focus-visible:outline focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-primary"
		data-theme-card
		data-theme-id={ theme.ID }
		data-theme-name={ theme.Name }
		data-search-card
		data-search-text={ theme.SearchText }
		aria-pressed="false"
		onclick="window.selectOpenVibelyTheme && window.selectOpenVibelyTheme(this.getAttribute('data-theme-id'))"
	>
		<div class="card-body gap-4">
			<div class="flex items-start justify-between gap-3">
				<div class="min-w-0">
					<h3 class="font-bold truncate">{ theme.Name }</h3>
					<p class="text-xs opacity-60 truncate">{ theme.Source }</p>
				</div>
				<div class="flex flex-wrap gap-2 justify-end shrink-0">
					<span class={ "badge badge-sm", themeKindBadgeClass(theme.Kind) }>{ themeKindLabel(theme.Kind) }</span>
					<span class="badge badge-primary badge-sm hidden" data-theme-active-badge>Active</span>
				</div>
			</div>
			<div class="theme-thumbnail rounded-lg border overflow-hidden" style={ previewOuterStyle(theme) } aria-hidden="true">
				<div class="flex min-h-24">
					<div class="theme-thumbnail-rail w-16 p-2 space-y-2">
						<div class="h-2 rounded" style={ previewAccentStyle(theme) }></div>
						<div class="h-2 rounded opacity-70" style={ previewMutedBarStyle(theme) }></div>
						<div class="h-2 rounded opacity-50" style={ previewMutedBarStyle(theme) }></div>
					</div>
					<div class="theme-thumbnail-page flex-1 p-3 space-y-2">
						<div class="theme-thumbnail-card flex items-center gap-2">
							<div class="h-3 w-20 rounded" style={ previewTextBarStyle(theme) }></div>
							<div class="h-3 w-12 rounded" style={ previewAccentStyle(theme) }></div>
						</div>
						<div class="rounded p-2 text-xs font-mono leading-relaxed" style={ previewCodeStyle(theme) }>
							<span style={ previewSyntaxStyle(theme, "keyword") }>{ "func" }</span>
							<span style={ previewSyntaxStyle(theme, "function") }>{ " theme" }</span>
							<span style={ previewSyntaxStyle(theme, "foreground") }>{ ">() " }</span>
							<span style={ previewSyntaxStyle(theme, "comment") }>{ "// preview" }</span>
							<br/>
							<span style={ previewSyntaxStyle(theme, "string") }>{ "\"OpenVibely\"" }</span>
							<span style={ previewSyntaxStyle(theme, "number") }>{ " 130" }</span>
						</div>
					</div>
				</div>
			</div>
		</div>
	</button>
}

func themeKindLabel(kind string) string {
	switch kind {
	case themes.KindHighContrastLight, themes.KindHighContrastDark:
		return "High Contrast"
	case themes.KindLight:
		return "Light"
	default:
		return "Dark"
	}
}

func themeKindBadgeClass(kind string) string {
	if strings.HasPrefix(kind, "high-contrast") {
		return "badge-warning"
	}
	if kind == themes.KindLight {
		return "badge-info"
	}
	return "badge-ghost"
}

func previewColor(theme themes.Theme, group, key, fallback string) string {
	var source map[string]string
	if group == "syntax" {
		source = theme.Syntax
	} else if group == "preview" {
		source = theme.Preview
	} else {
		source = theme.Semantic
	}
	if source != nil && source[key] != "" {
		return source[key]
	}
	return fallback
}

// Give every thumbnail its own palette so it does not borrow the selected theme.
func previewOuterStyle(theme themes.Theme) string {
	values := map[string]string{
		"default-frame": theme.CSS["--ov-kanban-column-bg"], "default-page": theme.Semantic["contentBg"],
		"default-rail": theme.Semantic["surface"], "default-card": theme.Semantic["surface"],
		"layered-frame": "color-mix(in srgb, " + theme.Semantic["surface"] + " 94%, " + theme.Semantic["text"] + ")",
		"layered-page":  "color-mix(in srgb, " + theme.Semantic["contentBg"] + " 92%, black)", "layered-card": theme.Semantic["surface"],
	}

	if theme.Mode == "light" {
		values["layered-page"] = "color-mix(in srgb, " + theme.Semantic["contentBg"] + " 94%, " + theme.Semantic["text"] + ")"
	}
	for key, value := range theme.SurfaceCSS {
		if strings.HasPrefix(key, "--ov-surface-default-") || strings.HasPrefix(key, "--ov-surface-layered-") {
			values[strings.TrimPrefix(key, "--ov-surface-")] = value
		}
	}
	style := "border-color:" + previewColor(theme, "semantic", "border", "#444") + ";color:" + previewColor(theme, "semantic", "text", "#ddd")
	for _, key := range []string{"default-frame", "default-page", "default-rail", "default-card", "default-border", "layered-frame", "layered-page", "layered-card", "layered-border"} {
		if value := values[key]; value != "" {
			style += ";--tp-" + key + ":" + value
		}
	}
	return style
}

func previewAccentStyle(theme themes.Theme) string {
	return "background:" + previewColor(theme, "semantic", "primary", "#0078d4")
}

func previewMutedBarStyle(theme themes.Theme) string {
	return "background:" + previewColor(theme, "semantic", "textMuted", "#888")
}

func previewTextBarStyle(theme themes.Theme) string {
	return "background:" + previewColor(theme, "semantic", "text", "#ddd")
}

func previewCodeStyle(theme themes.Theme) string {
	return "background:" + previewColor(theme, "syntax", "background", "#1e1e1e") + ";color:" + previewColor(theme, "syntax", "foreground", "#d4d4d4")
}

func previewSyntaxStyle(theme themes.Theme, key string) string {
	return "color:" + previewColor(theme, "syntax", key, previewColor(theme, "syntax", "foreground", "#d4d4d4"))
}

templ displayToggle(pref, label, description, firstValue, firstLabel, secondValue, secondLabel string) {
	<fieldset>
		<legend class="text-sm font-medium mb-2">{ label }</legend>
		<p class="text-xs opacity-60 mb-2">{ description }</p>
		<div class="grid grid-cols-2 gap-3">
			for _, opt := range [][2]string{{firstValue, firstLabel}, {secondValue, secondLabel}} {
				<button type="button" class="display-option card bg-base-100 border border-base-300 p-3 text-left hover:border-primary/40 focus-visible:outline focus-visible:outline-2 focus-visible:outline-primary" data-display-pref={ pref } data-display-option={ opt[0] } aria-pressed="false" onclick="window.selectOpenVibelyDisplay && window.selectOpenVibelyDisplay(this.getAttribute('data-display-pref'), this.getAttribute('data-display-option'))">
					<span class="flex justify-between items-center gap-2 mb-3"><span class="text-sm font-medium">{ opt[1] }</span><span class="badge badge-primary badge-sm hidden" data-display-active>Active</span></span>
					<div class="display-preview" data-kind={ pref } data-variant={ opt[0] } aria-hidden="true">
						if pref == "output" {
                            <div class="p-3 text-xs flex flex-col gap-2">
                                <span class="opacity-70">I’ll check the files.</span>
                                <div class="border border-base-300 rounded p-2">
                                    <span>
                                        if opt[0] == "compact" {
                                            <span>›</span>
                                        } else {
                                            <span>⌄</span>
                                        }
                                        if opt[0] == "compact" {
                                            2 tool calls
                                        } else {
                                            Read file
                                        }
                                    </span>
                                    if opt[0] == "full" {
                                        <div class="opacity-50 mt-2 font-mono">IN · app.go<br/>OUT · File contents…</div>
                                    }
                                </div>
                                <span class="opacity-70">Here’s what I found.</span>
                            </div>
                        } else if pref == "surfaces" || pref == "layout" || pref == "tabs" {
							<div class="dp-tabs"><span></span><span></span></div>
							<div class="dp-workspace"><div class="dp-list"><i></i><i></i><i></i></div><div class="dp-page"><div class="dp-surface-card"><i></i><i></i></div></div></div>
						} else {
							<div class="dp-conversation"><div class="dp-user"><i></i></div><div class="dp-assistant"><i></i><i></i><i></i></div><div class="dp-composer"><i></i></div></div>
						}
					</div>
				</button>
			}
		</div>
	</fieldset>
}

templ boardColumnsCard(id, name, description string) {
	<button
		type="button"
		class="card bg-base-100 shadow-sm border border-base-300 cursor-pointer hover:border-primary/40 transition-all text-left w-full focus-visible:outline focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-primary"
		data-board-columns-card
		data-board-columns-id={ id }
		aria-pressed="false"
		onclick="window.selectOpenVibelyDisplay && window.selectOpenVibelyDisplay('columns', this.getAttribute('data-board-columns-id'))"
	>
		<div class="card-body gap-3 p-4">
			<div class="flex items-center justify-between">
				<span class="font-semibold">{ name }</span>
				<span class="badge badge-primary badge-sm hidden" data-board-columns-active-badge>Active</span>
			</div>
			<div class="board-columns-preview" data-preview={ id } aria-hidden="true">
				for i := 0; i < 3; i++ {
					<div class="bcp-col">
						<div class="bcp-head"></div>
						if i != 1 {
							<div class="bcp-card"></div>
							<div class="bcp-card"></div>
						}
					</div>
				}
			</div>
			<p class="text-xs opacity-70">{ description }</p>
		</div>
	</button>
}
