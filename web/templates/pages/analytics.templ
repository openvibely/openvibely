								table.querySelectorAll('[data-model-evidence]').forEach(function(button){button.addEventListener('click',function(){navigateEvidence('outcomes','model_id',button.dataset.modelEvidence,{category:button.dataset.categoryEvidence});},{signal:eventSignal});});
