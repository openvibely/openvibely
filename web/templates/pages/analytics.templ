package pages

import (
	"github.com/openvibely/openvibely/internal/models"
	"github.com/openvibely/openvibely/web/templates/layout"
)

templ Analytics(projects []models.Project, currentProject *models.Project) {
	@layout.Base("Analytics Dashboard", projects, projectID(currentProject)) {
		@analyticsContent(currentProject)
	}
}

// AnalyticsContent renders just the analytics content for HTMX requests
templ AnalyticsContent(currentProject *models.Project) {
	@analyticsContent(currentProject)
}

templ analyticsContent(currentProject *models.Project) {
	<div class="flex justify-between items-center mb-6">
		@layout.PageTitle("Analytics Dashboard")
			<h2 class="text-2xl font-bold">Analytics Dashboard</h2>
			if currentProject != nil {
				<div class="flex gap-2 items-center">
					<span class="opacity-60">Project:</span>
					<span class="font-semibold">{ currentProject.Name }</span>
				</div>
			}
		</div>
		if currentProject != nil {
				<!-- Shared filters and reloadable view navigation -->
				<div class="sticky top-0 z-20 bg-base-200/95 backdrop-blur pb-3 mb-6" data-analytics-navigation>
					<div class="card bg-base-100 shadow-sm border border-base-300">
						<div class="card-body p-4">
							<div class="flex flex-wrap gap-4 items-end">
								<div class="form-control"><label class="label" for="dateRange"><span class="label-text">Date Range</span></label><select id="dateRange" class="select select-bordered select-sm"><option value="7">Last 7 Days</option><option value="30" selected>Last 30 Days</option><option value="90">Last 90 Days</option><option value="365">Last Year</option><option value="all">All Time</option></select></div>
								<div class="form-control"><label class="label" for="groupBy"><span class="label-text">Group By</span></label><select id="groupBy" class="select select-bordered select-sm"><option value="day" selected>Day</option><option value="week">Week</option><option value="month">Month</option></select></div>
								<label class="label cursor-pointer gap-2 pb-2"><input id="comparePeriod" type="checkbox" class="checkbox checkbox-sm" checked/><span class="label-text">Compare previous period</span></label>
								<div class="form-control"><label class="label" for="analyticsAgentFilter"><span class="label-text">Agent</span></label><select id="analyticsAgentFilter" class="select select-bordered select-sm"><option value="">All Agents</option></select></div>
								<div class="form-control"><label class="label" for="analyticsWorkflowFilter"><span class="label-text">Workflow</span></label><select id="analyticsWorkflowFilter" class="select select-bordered select-sm"><option value="">All Workflows</option></select></div>
								<button id="refreshBtn" class="btn btn-primary btn-sm">Refresh</button>
							</div>
							<nav class="flex gap-2 overflow-x-auto mt-4 pb-1" aria-label="Analytics views"><button class="btn btn-sm whitespace-nowrap" data-analytics-view="overview">Overview</button><button class="btn btn-sm whitespace-nowrap" data-analytics-view="outcomes">Outcomes</button><button class="btn btn-sm whitespace-nowrap" data-analytics-view="agents">Agents</button><button class="btn btn-sm whitespace-nowrap" data-analytics-view="workflows">Workflows</button><button class="btn btn-sm whitespace-nowrap" data-analytics-view="learning">Learning</button><button class="btn btn-sm whitespace-nowrap" data-analytics-view="usage">Usage</button><button class="btn btn-sm whitespace-nowrap" data-analytics-view="all">All Metrics</button></nav>
						</div>
					</div>
					<nav id="analyticsJumpLinks" class="hidden flex gap-3 overflow-x-auto pt-2 text-sm" aria-label="Jump to analytics section"><a class="link" href="#analytics-overview">Overview</a><a class="link" href="#analytics-outcomes">Outcomes</a><a class="link" href="#analytics-agents">Agents</a><a class="link" href="#analytics-workflows">Workflows</a><a class="link" href="#analytics-learning">Learning</a><a class="link" href="#analytics-usage">Usage</a></nav>
				</div>
				<div id="analyticsError" class="alert alert-error hidden mb-6" role="alert"></div>
				<section id="analytics-overview" data-analytics-section="overview" class="space-y-6 mb-6">
					<div><h3 class="text-xl font-bold">Overview</h3><p class="text-sm opacity-60">Task outcomes with technical status kept separate from goal evidence.</p></div>
					<div id="analyticsKpis" class="grid grid-cols-1 sm:grid-cols-2 xl:grid-cols-4 gap-4"></div>
					<div class="grid grid-cols-1 lg:grid-cols-2 gap-6"><div class="card bg-base-100 border border-base-300"><div class="card-body"><h4 class="card-title text-success">Notable improvements</h4><div id="analyticsImprovements"><p class="opacity-50">No supported comparison insight yet.</p></div></div></div><div class="card bg-base-100 border border-base-300"><div class="card-body"><h4 class="card-title text-warning">Needs attention</h4><div id="analyticsAttention"><p class="opacity-50">No supported attention insight yet.</p></div></div></div></div>
					<div class="card bg-base-100 border border-base-300"><div class="card-body"><h4 class="card-title">Recent outcomes</h4><div class="overflow-x-auto"><table class="table table-sm"><thead><tr><th>Task</th><th>Technical result</th><th>Goal result</th><th>Merge/review</th><th>Agent definition</th><th>Model</th><th>Executions</th><th>Follow-ups</th><th>Cycle time</th><th>Known cost</th></tr></thead><tbody id="recentOutcomesTable"></tbody></table></div></div></div>
				</section>
					<section id="analytics-outcomes" data-analytics-section="outcomes" class="space-y-6 mb-6"><div><h3 class="text-xl font-bold">Outcomes</h3><p class="text-sm opacity-60">Execution completion is not proof that a goal was achieved.</p></div><div class="card bg-base-100 border border-base-300"><div class="card-body"><h4 class="card-title">Outcome funnel</h4><div id="outcomeFunnel" class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-5 gap-3"></div></div></div><div class="grid grid-cols-1 lg:grid-cols-2 gap-6"><div class="card bg-base-100 border border-base-300"><div class="card-body"><h4 class="card-title">Cycle-time distribution</h4><div class="h-64"><canvas id="cycleDistributionChart"></canvas></div></div></div><div class="card bg-base-100 border border-base-300"><div class="card-body"><h4 class="card-title">Follow-up / rework distribution</h4><div class="h-64"><canvas id="followupDistributionChart"></canvas></div></div></div></div><div class="card bg-base-100 border border-base-300"><div class="card-body"><h4 class="card-title">Task-level outcome evidence</h4><div class="overflow-x-auto"><table class="table table-sm"><thead><tr><th>Task</th><th>Technical result</th><th>Goal result</th><th>Agent</th><th>Model</th><th>Executions</th><th>Follow-ups</th><th>Cycle time</th><th>Known cost</th></tr></thead><tbody id="outcomeEvidenceTable"></tbody></table></div></div></div></section>					<section id="analytics-agents" data-analytics-section="agents" class="space-y-6 mb-6"><div><h3 class="text-xl font-bold">Agent performance</h3><p class="text-sm opacity-60">Reusable Agent definitions, separate from model configurations.</p></div><div class="card bg-base-100 border border-base-300"><div class="card-body"><div class="overflow-x-auto"><table class="table table-sm"><thead><tr><th>Agent</th><th>Tasks</th><th>Technical completion</th><th>Goal achievement</th><th>First pass</th><th>Follow-up</th><th>Duration</th><th>Cost / achieved goal</th><th>Most-used model</th></tr></thead><tbody id="agentPerformanceTable"></tbody></table></div></div></div><div class="card bg-base-100 border border-base-300"><div class="card-body"><h4 class="card-title text-lg">Recent supporting tasks for selected Agent</h4><div class="overflow-x-auto"><table class="table table-sm"><thead><tr><th>Task</th><th>Technical result</th><th>Goal result</th><th>Model</th><th>Executions</th><th>Follow-ups</th></tr></thead><tbody id="agentEvidenceTable"></tbody></table></div></div></div></section>				<section id="analytics-workflows" data-analytics-section="workflows" class="space-y-6 mb-6"><div><h3 class="text-xl font-bold">Workflow performance</h3><p class="text-sm opacity-60">Automation invocations use the selected period; waiting, blocked, and health are labeled current state.</p></div><div class="card bg-base-100 border border-base-300"><div class="card-body"><div class="overflow-x-auto"><table class="table table-sm"><thead><tr><th>Workflow</th><th>Invocations</th><th>Completion</th><th>Failures</th><th>Duration</th><th>Waiting / blocked</th><th>Known cost</th><th>Health</th></tr></thead><tbody id="workflowPerformanceTable"></tbody></table></div></div></div></section>
					<section id="analytics-learning" data-analytics-section="learning" class="space-y-4"><div><h3 class="text-xl font-bold mt-6">Learning</h3><p class="text-sm opacity-60">Observed skill activity and task outcomes; association is not causation.</p></div><div class="card bg-base-100 border border-base-300"><div class="card-body"><h4 class="card-title text-lg">Observed outcomes among tasks using skills</h4><p class="text-sm opacity-60">Tasks where a skill was selected or loaded in the selected period. Small samples are descriptive only.</p><div class="overflow-x-auto"><table class="table table-sm"><thead><tr><th>Skill</th><th>Tasks</th><th>Technical task outcome</th><th>Goal achievement</th><th>Follow-up</th></tr></thead><tbody id="skillOutcomeTable"></tbody></table></div></div></div></section>				<div id="analytics-usage" data-analytics-section="usage"><h3 class="text-xl font-bold mt-6">Usage</h3><p class="text-sm opacity-60 mb-4">Local provider usage and available recorded cost.</p><div id="usageOutcomeContext" class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-4 gap-4 mb-6"></div></div>
					<!-- Provider Account Cards: current account state, intentionally independent of the date window. -->
					<div class="mb-2"><h3 class="text-lg font-semibold">Provider account limits</h3><p class="text-xs opacity-60">Current account state · not date-filtered</p></div>
					<div id="accountUsageCards" class="grid grid-cols-1 lg:grid-cols-2 gap-6 mb-6">					<p class="opacity-50 lg:col-span-2">No connected OAuth account snapshots yet.</p>
				</div>
				<!-- Usage Charts -->
				<div class="grid grid-cols-1 lg:grid-cols-2 gap-6 mb-6">
					<div class="card bg-base-100 shadow-sm border border-base-300">
						<div class="card-body">
							<div class="flex flex-wrap items-end justify-between gap-3 mb-2 min-w-0">
								<h3 class="card-title text-lg">Token Usage</h3>
								<div class="form-control min-w-0 w-full sm:w-auto">
									<select id="usageRateModelSelect" class="select select-bordered select-xs w-full max-w-full sm:min-w-48"></select>
								</div>
							</div>
							<div class="relative h-64"><canvas id="usageRateChart"></canvas></div>
						</div>
					</div>
					<div class="card bg-base-100 shadow-sm border border-base-300">
						<div class="card-body">
							<h3 class="card-title text-lg">Model Breakdown by Tokens</h3>
							<div class="h-64">
								<canvas id="modelTokenBreakdownChart"></canvas>
							</div>
						</div>
					</div>
				</div>
				<!-- Token Usage Tracking -->
				<div class="card bg-base-100 shadow-sm border border-base-300 mb-6 self-start h-fit">
					<div class="card-body">
						<div class="flex items-center justify-between gap-3 mb-2">
							<h3 class="card-title text-lg">Token Usage Breakdown</h3>
							<span id="usageLastUpdated" class="text-xs opacity-60">Usage loading…</span>
						</div>
						<div class="overflow-x-auto">
							<table class="table table-sm">
								<thead><tr><th>Provider</th><th>Model</th><th>Input</th><th>Output</th><th>Cache</th><th>Reasoning</th><th>Total</th><th>Cost</th></tr></thead>
								<tbody id="usageBreakdownTable"><tr><td colspan="8" class="text-center opacity-50">No usage recorded yet</td></tr></tbody>
							</table>
						</div>
					</div>
				</div>
				<!-- Charts Grid -->
				<div class="grid grid-cols-1 lg:grid-cols-2 gap-6">				<!-- Success/Failure Rates -->
				<div class="card bg-base-100 shadow-sm border border-base-300">
					<div class="card-body">
						<h3 class="card-title text-lg">Technical Execution Completion Over Time</h3>
						<div class="relative h-64">
							<canvas id="successFailureChart"></canvas>
						</div>
					</div>
				</div>
				<!-- Execution Trends by Hour -->
				<div class="card bg-base-100 shadow-sm border border-base-300">
					<div class="card-body">
						<h3 class="card-title text-lg">Task Execution by Hour</h3>
						<div class="h-64">
							<canvas id="hourlyTrendsChart"></canvas>
						</div>
					</div>
				</div>
				<!-- Average Execution Time by Task -->
				<div class="card bg-base-100 shadow-sm border border-base-300">
					<div class="card-body">
						<h3 class="card-title text-lg">Average Execution Time by Task</h3>
						<div class="h-64">
							<canvas id="avgTimeTaskChart"></canvas>
						</div>
					</div>
				</div>
					<!-- Average Execution Time by Model -->
					<div class="card bg-base-100 shadow-sm border border-base-300">
						<div class="card-body">
							<h3 class="card-title text-lg">Average Execution Time by Model</h3>
							<div class="h-64">
								<canvas id="avgTimeAgentChart"></canvas>
							</div>
						</div>
					</div>
					<!-- Model Breakdown by Executions -->
					<div class="card bg-base-100 shadow-sm border border-base-300">
						<div class="card-body">
							<h3 class="card-title text-lg">Model Breakdown by Executions</h3>
							<div class="h-64">
								<canvas id="agentUsageChart"></canvas>
							</div>
						</div>
					</div>
					<!-- Most Frequent Tasks -->
				<div class="card bg-base-100 shadow-sm border border-base-300">
					<div class="card-body">
						<h3 class="card-title text-lg">Most Frequently Run Tasks</h3>
						<div class="h-64 overflow-y-auto" id="frequentTasksList"></div>
					</div>
				</div>
			</div>

				<!-- Skill Curator Analytics -->
				<div class="grid grid-cols-1 lg:grid-cols-2 gap-6 mt-6 mb-6">
					<div class="card bg-base-100 shadow-sm border border-base-300">
						<div class="card-body">
							<div class="mb-2">
								<h3 class="card-title text-lg">Skill Activity Over Time</h3>
								<p class="text-sm opacity-60">Created, edited, and used skill activity.</p>
							</div>
							<div class="relative h-64">
								<canvas id="skillUsageTrendChart"></canvas>
							</div>
						</div>
					</div>
					<div class="card bg-base-100 shadow-sm border border-base-300">
						<div class="card-body">
							<div class="mb-2">
								<h3 class="card-title text-lg">Top Skills</h3>
								<p class="text-sm opacity-60">Highest skill activity by event type.</p>
							</div>
							<div class="h-64">
								<canvas id="skillTopChart"></canvas>
							</div>
						</div>
					</div>
					<div class="card bg-base-100 shadow-sm border border-base-300">
						<div class="card-body">
							<div class="mb-2">
								<h3 class="card-title text-lg">Follow-through / Selected Outcomes</h3>
								<p class="text-sm opacity-60">Selected skills that were later used or ignored.</p>
							</div>
							<div class="h-64">
								<canvas id="skillFollowChart"></canvas>
							</div>
						</div>
					</div>
					<div class="card bg-base-100 shadow-sm border border-base-300">
						<div class="card-body">
							<div class="mb-2">
								<h3 class="card-title text-lg">Top Agent/Skill Pairs</h3>
								<p class="text-sm opacity-60">Most active agent and skill combinations.</p>
							</div>
							<div class="h-64">
								<canvas id="skillAgentChart"></canvas>
							</div>
						</div>
					</div>
				</div>
				<div class="card bg-base-100 shadow-sm border border-base-300 mb-6">
					<div class="card-body">
						<div class="mb-2">
							<h3 class="card-title text-lg">Least Active Enabled Skills</h3>
							<p class="text-sm opacity-60">Enabled skills with the least recent activity.</p>
						</div>
						<div class="overflow-x-auto">
							<table class="table table-sm">
								<thead><tr><th>Skill</th><th>Scope</th><th>Activity</th><th>Last activity</th></tr></thead>
								<tbody id="underusedSkillsTable"><tr><td colspan="4" class="text-center opacity-50">No enabled skills found</td></tr></tbody>
							</table>
						</div>
					</div>
				</div>
						<div id="memoryEffectivenessUnavailable" class="card bg-base-100 shadow-sm border border-base-300 mb-6">
							<div class="card-body">
								<h3 class="card-title text-lg">Memory effectiveness unavailable</h3>
								<p class="text-sm opacity-60">Memory recall lacks reliable task-outcome instrumentation. Recall alone does not establish usefulness.</p>
							</div>
						</div>				<!-- Failed Task Patterns -->
			<div class="card bg-base-100 shadow-sm border border-base-300">
				<div class="card-body">
					<h3 class="card-title text-lg">Failed Task Patterns</h3>
					<div class="overflow-x-auto">
						<table class="table table-sm" id="failedPatternsTable">
							<thead>
								<tr>
									<th>Task</th>
									<th>Failure Count</th>
									<th>Last Error</th>
									<th>Last Failed At</th>
								</tr>
							</thead>
							<tbody></tbody>
						</table>
					</div>
				</div>
			</div>
			<!-- Chart.js and Custom Script -->
			<div id="analytics-data" data-project-id={ currentProject.ID } class="hidden"></div>
			<script type="text/javascript">
				(function() {
				// Destroy any charts from a previous analytics page visit
				if (window._analyticsCharts) {
					Object.values(window._analyticsCharts).forEach(function(c) {
						try { c.destroy(); } catch(e) {}
					});
				}
					window._analyticsCharts = {};
					if (window._analyticsAbortController) window._analyticsAbortController.abort();
					window._analyticsAbortController = new AbortController();

					function initAnalytics() {
					var dataEl = document.getElementById('analytics-data');
					if (!dataEl) return;
					var projectID = dataEl.dataset.projectId;
						var charts = window._analyticsCharts;
						var eventSignal = window._analyticsAbortController.signal;
						var latestUsageAnalytics = null;
						var latestDashboard = null;

						// Fetch JSON or surface a controlled error. Never preserve stale data.
						async function fetchJSON(url) {
							const response = await fetch(url);
							if (!response.ok) throw new Error('Analytics request failed (' + response.status + ')');
							return await response.json();
						}

						function destroyChart(key) {
							if (!charts[key]) return;
							try { charts[key].destroy(); } catch (e) {}
							delete charts[key];
						}
							function showAnalyticsError(error) {
								Object.keys(charts).forEach(destroyChart);
								const box = document.getElementById('analyticsError');
								box.textContent = error && error.message ? error.message : 'Analytics request failed';
								box.classList.remove('hidden');
								[['recentOutcomesTable',10],['outcomeEvidenceTable',9],['agentPerformanceTable',9],['agentEvidenceTable',6],['workflowPerformanceTable',8],['skillOutcomeTable',5],['usageBreakdownTable',8],['underusedSkillsTable',4]].forEach(function(item) {
									const table = document.getElementById(item[0]);
									if (table) table.innerHTML = '<tr><td colspan="' + item[1] + '" class="text-center opacity-50">Analytics unavailable</td></tr>';
								});
								['analyticsKpis','outcomeFunnel','analyticsImprovements','analyticsAttention','usageOutcomeContext','accountUsageCards','frequentTasksList'].forEach(function(id) { const node=document.getElementById(id); if (node) node.textContent='Analytics unavailable'; });
								const failedBody = document.querySelector('#failedPatternsTable tbody');
								if (failedBody) failedBody.innerHTML = '<tr><td colspan="4" class="text-center opacity-50">Analytics unavailable</td></tr>';
							}
						function renderChartState(key, canvasID, rows, message) {
							destroyChart(key);
								const canvas = document.getElementById(canvasID);
								if (!canvas) return null;
								const chartLabels = { cycleDistributionChart: 'Cycle-time distribution', followupDistributionChart: 'Follow-up distribution', skillUsageTrendChart: 'Skill activity over time', skillTopChart: 'Top skills by activity', skillFollowChart: 'Skill selection follow-through', skillAgentChart: 'Agent and skill activity pairs', usageRateChart: 'Token usage over time', modelTokenBreakdownChart: 'Model breakdown by tokens', successFailureChart: 'Technical execution completion over time', hourlyTrendsChart: 'Task executions by hour', avgTimeTaskChart: 'Average execution duration by task', avgTimeAgentChart: 'Average execution duration by model', agentUsageChart: 'Model breakdown by executions' };
								canvas.setAttribute('role', 'img');
								canvas.setAttribute('aria-label', chartLabels[canvasID] || 'Analytics chart');							const old = canvas.parentElement.querySelector('[data-analytics-chart-state]');
							if (old) old.remove();
							if (!rows || rows.length === 0) {
								canvas.classList.add('hidden');
								const state = document.createElement('p');
								state.setAttribute('data-analytics-chart-state', '');
								state.className = 'text-center opacity-50 py-12';
								state.textContent = message || 'No data in this period';
								canvas.parentElement.appendChild(state);
								return null;
							}
							canvas.classList.remove('hidden');
							return canvas;
						}

						const validViews = ['overview', 'outcomes', 'agents', 'workflows', 'learning', 'usage', 'all'];
						let selectedView = 'overview';
						function analyticsURL(view) {
							const params = new URLSearchParams(window.location.search);
							params.set('project_id', projectID);
							params.set('view', view);
							params.set('range', usageRangeParam());
							params.set('group_by', document.getElementById('groupBy').value);
								params.set('compare', document.getElementById('comparePeriod').checked ? '1' : '0');
								const agent = document.getElementById('analyticsAgentFilter').value;
								const workflow = document.getElementById('analyticsWorkflowFilter').value;
								if (agent) params.set('agent', agent); else params.delete('agent');
								if (workflow) params.set('workflow', workflow); else params.delete('workflow');
								return '/analytics?' + params.toString();						}
						function viewDetailElements(view) {
							const ids = {
								outcomes: ['successFailureChart', 'avgTimeTaskChart', 'failedPatternsTable'],
								agents: ['avgTimeAgentChart', 'agentUsageChart'],
									learning: ['skillUsageTrendChart', 'skillTopChart', 'skillFollowChart', 'skillAgentChart', 'underusedSkillsTable', 'memoryEffectivenessUnavailable'],								usage: ['accountUsageCards', 'usageRateChart', 'modelTokenBreakdownChart', 'usageBreakdownTable'],
								activity: ['hourlyTrendsChart', 'frequentTasksList']
							};
							return (ids[view] || []).map(function(id) {
								const node = document.getElementById(id);
								return node ? (node.closest('.card') || node) : null;
							}).filter(Boolean);
						}
						function applyView(view, updateHistory) {
							selectedView = validViews.includes(view) ? view : 'overview';
							document.querySelectorAll('[data-analytics-section]').forEach(function(section) { section.classList.add('hidden'); });
							['outcomes', 'agents', 'learning', 'usage', 'activity'].forEach(function(name) { viewDetailElements(name).forEach(function(node) { node.classList.add('hidden'); }); });
							if (selectedView === 'all') {
								document.querySelectorAll('[data-analytics-section]').forEach(function(section) { section.classList.remove('hidden'); });
								['outcomes', 'agents', 'learning', 'usage', 'activity'].forEach(function(name) { viewDetailElements(name).forEach(function(node) { node.classList.remove('hidden'); }); });
							} else {
								const section = document.querySelector('[data-analytics-section="' + selectedView + '"]');
								if (section) section.classList.remove('hidden');
								viewDetailElements(selectedView).forEach(function(node) { node.classList.remove('hidden'); });
							}
							document.getElementById('analyticsJumpLinks').classList.toggle('hidden', selectedView !== 'all');
							document.querySelectorAll('[data-analytics-view]').forEach(function(button) { button.classList.toggle('btn-primary', button.dataset.analyticsView === selectedView); });
								if (updateHistory) history.pushState({}, '', analyticsURL(selectedView));						}

						function ratioText(value) { return formatNumber(value.numerator) + ' / ' + formatNumber(value.denominator) + ' (' + Number(value.percent || 0).toFixed(1) + '%)'; }
						function costCoverageText(value) { return value ? formatCost(value.value) + ' across ' + value.covered + ' of ' + value.eligible : 'Unavailable'; }
						function renderDashboard(data) {
							const current = data.current || {};
							const previous = data.previous || null;
							const definitions = new Map((data.definitions || []).map(function(item) { return [item.key, item]; }));
							const cards = [
								['technical_completion', 'Technical completion rate', ratioText(current.technical_completion || {})],
								['goal_achievement', 'Goal achievement rate', ratioText(current.goal_achievement || {})],
								['first_pass', 'Technical first-pass rate', ratioText(current.first_pass || {})],
								['follow_up', 'Follow-up rate', ratioText(current.follow_up || {})],
								['median_cycle_time', 'Median task cycle time', formatDuration(current.median_cycle_time_ms || 0)],
								['known_cost_per_achieved_goal', 'Cost per achieved goal', costCoverageText(current.known_cost_per_achieved_goal)],
								['sample_size', 'Sample size', formatNumber(current.tasks_evaluated || 0) + ' tasks']
							];
							document.getElementById('analyticsKpis').innerHTML = cards.map(function(card) {
								const definition = definitions.get(card[0]);
								let delta = '';
									if (previous && previous[card[0]] && current[card[0]] && typeof current[card[0]].percent === 'number') { const change = Number(current[card[0]].percent) - Number(previous[card[0]].percent || 0); delta = '<div class="text-xs opacity-60">' + (change >= 0 ? '+' : '') + change.toFixed(1) + ' percentage points · previous ' + Number(previous[card[0]].percent).toFixed(1) + '% · n=' + previous[card[0]].denominator + '</div>'; }								return '<a class="card bg-base-100 border border-base-300 hover:border-primary" href="' + escapeHTML(analyticsURL(card[0] === 'known_cost_per_achieved_goal' ? 'usage' : 'outcomes')) + '"><div class="card-body p-4"><div class="text-sm font-semibold">' + escapeHTML(card[1]) + '</div><div class="text-xl font-bold">' + escapeHTML(card[2]) + '</div>' + delta + '<div class="text-xs opacity-60" title="' + escapeHTML(definition ? definition.definition + ' Denominator: ' + definition.denominator : 'Selected-period task sample.') + '">Definition and denominator</div></div></a>';
							}).join('');
							const recent = data.recent_outcomes || [];
								document.getElementById('recentOutcomesTable').innerHTML = recent.length ? recent.map(function(row) {
									const taskURL = '/tasks/' + encodeURIComponent(row.task_id) + '?project_id=' + encodeURIComponent(projectID);
									const agent = row.agent_id ? '<a class="link" href="/agents?project_id=' + encodeURIComponent(projectID) + '&agent_id=' + encodeURIComponent(row.agent_id) + '">' + escapeHTML(row.agent_name) + '</a>' : escapeHTML(row.agent_name);
									return '<tr><td><a class="link" href="' + taskURL + '">' + escapeHTML(row.task_title) + '</a></td><td>' + escapeHTML(row.technical_result) + '</td><td>' + escapeHTML(row.goal_result || 'Not goal-bearing') + '</td><td>' + escapeHTML(row.merge_state || 'Not applicable') + '</td><td>' + agent + '</td><td>' + escapeHTML(row.model) + '</td><td>' + row.execution_count + '</td><td>' + row.follow_up_count + '</td><td>' + escapeHTML(formatDuration(row.cycle_time_ms || 0)) + '</td><td>' + escapeHTML(row.known_cost_usd == null ? 'Unavailable' : formatCost(row.known_cost_usd)) + '</td></tr>';
								}).join('') : '<tr><td colspan="10" class="text-center opacity-50">No task outcomes in this period</td></tr>';
								document.getElementById('outcomeEvidenceTable').innerHTML = recent.length ? recent.map(function(row) {
									const taskURL = '/tasks/' + encodeURIComponent(row.task_id) + '?project_id=' + encodeURIComponent(projectID);
									return '<tr><td><a class="link" href="' + taskURL + '">' + escapeHTML(row.task_title) + '</a></td><td>' + escapeHTML(row.technical_result) + '</td><td>' + escapeHTML(row.goal_result || 'Not goal-bearing') + '</td><td>' + escapeHTML(row.agent_name) + '</td><td>' + escapeHTML(row.model) + '</td><td>' + row.execution_count + '</td><td>' + row.follow_up_count + '</td><td>' + escapeHTML(formatDuration(row.cycle_time_ms || 0)) + '</td><td>' + escapeHTML(row.known_cost_usd == null ? 'Unavailable' : formatCost(row.known_cost_usd)) + '</td></tr>';
								}).join('') : '<tr><td colspan="9" class="text-center opacity-50">No task outcomes in this period</td></tr>';							document.getElementById('outcomeFunnel').innerHTML = (data.funnel || []).map(function(stage) { return '<a class="card bg-base-200" href="' + escapeHTML(analyticsURL('outcomes')) + '"><div class="card-body p-3"><span class="text-sm">' + escapeHTML(stage.label) + '</span><strong class="text-xl">' + stage.count + '</strong><span class="text-xs opacity-60">denominator ' + stage.denominator + '</span></div></a>'; }).join('') || '<p class="opacity-50">No funnel evidence in this period.</p>';
							renderDistributionChart('cycleDistribution', 'cycleDistributionChart', data.cycle_distribution || []);
							renderDistributionChart('followupDistribution', 'followupDistributionChart', data.follow_up_distribution || []);
								renderAgentPerformance(data.agents || []);
								renderSkillOutcomes(data.skill_outcomes || []);
								renderWorkflowPerformance(data.workflows || []);							renderInsights(data.insights || []);
								renderUsageOutcomeContext(current, latestUsageAnalytics ? latestUsageAnalytics.totals : null);
							}
							function renderUsageOutcomeContext(current, totals) {
								const usageContext = document.getElementById('usageOutcomeContext');
								if (!usageContext) return;
								const inputTokens = totals && totals.input_tokens ? Number(totals.input_tokens) : 0;
								const cachedTokens = totals && totals.cached_input_tokens ? Number(totals.cached_input_tokens) : 0;
								const cacheText = inputTokens > 0 ? formatNumber(cachedTokens) + ' / ' + formatNumber(inputTokens) + ' input tokens (' + (cachedTokens * 100 / inputTokens).toFixed(1) + '%)' : 'Unavailable';
								usageContext.innerHTML = [['Known cost / achieved goal', costCoverageText(current.known_cost_per_achieved_goal)], ['Known cost / technical completion', costCoverageText(current.known_cost_per_completed_task)], ['Known failed execution cost', formatCost(current.known_failed_execution_cost || 0)], ['Tokens / achieved goal', current.tokens_per_achieved_goal ? formatNumber(current.tokens_per_achieved_goal.value) + ' across ' + current.tokens_per_achieved_goal.covered + ' of ' + current.tokens_per_achieved_goal.eligible : 'Unavailable'], ['Cache utilization', cacheText]].map(function(item) { return '<div class="card bg-base-100 border border-base-300"><div class="card-body p-4"><span class="text-sm">' + escapeHTML(item[0]) + '</span><strong>' + escapeHTML(item[1]) + '</strong></div></div>'; }).join('');
							}
						function renderDistributionChart(key, canvasID, rows) {
							const canvas = renderChartState(key, canvasID, rows, 'No task samples in this period');
							if (!canvas) return;
							charts[key] = new Chart(canvas.getContext('2d'), { type: 'bar', data: { labels: rows.map(function(row) { return row.label; }), datasets: [{ label: 'Tasks (sample n=' + rows.reduce(function(sum, row) { return sum + row.count; }, 0) + ')', data: rows.map(function(row) { return row.count; }), backgroundColor: 'rgba(59, 130, 246, 0.6)' }] }, options: { responsive: true, maintainAspectRatio: false, scales: { y: { beginAtZero: true } } } });
						}
							function renderAgentPerformance(rows) {
								const filter = document.getElementById('analyticsAgentFilter');
								const selected = filter.value || new URLSearchParams(window.location.search).get('agent') || '';							filter.innerHTML = '<option value="">All Agents</option>' + rows.map(function(row) { return '<option value="' + escapeHTML(row.agent_id || '__unassigned__') + '">' + escapeHTML(row.agent_name) + '</option>'; }).join(''); filter.value = selected;
							const visible = rows.filter(function(row) { return !selected || (row.agent_id || '__unassigned__') === selected; });
								document.getElementById('agentPerformanceTable').innerHTML = visible.length ? visible.map(function(row) { const name = row.agent_id ? '<a class="link" href="/agents?project_id=' + encodeURIComponent(projectID) + '&agent_id=' + encodeURIComponent(row.agent_id) + '">' + escapeHTML(row.agent_name) + '</a>' : escapeHTML(row.agent_name); return '<tr><td>' + name + '</td><td>' + row.tasks_evaluated + '</td><td>' + escapeHTML(ratioText(row.technical_completion)) + '</td><td>' + escapeHTML(ratioText(row.goal_achievement)) + '</td><td>' + escapeHTML(ratioText(row.first_pass)) + '</td><td>' + escapeHTML(ratioText(row.follow_up)) + '</td><td>' + escapeHTML(formatDuration(row.median_duration_ms || 0)) + '</td><td>' + escapeHTML(costCoverageText(row.known_cost_per_achieved_goal)) + '</td><td>' + escapeHTML(row.most_used_model || 'Unavailable') + '</td></tr>'; }).join('') : '<tr><td colspan="9" class="text-center opacity-50">No Agent evidence in this period</td></tr>';
								const evidence = ((latestDashboard && latestDashboard.recent_outcomes) || []).filter(function(row) { return !selected || (row.agent_id || '__unassigned__') === selected; });
								document.getElementById('agentEvidenceTable').innerHTML = evidence.length ? evidence.map(function(row) { const taskURL='/tasks/'+encodeURIComponent(row.task_id)+'?project_id='+encodeURIComponent(projectID); return '<tr><td><a class="link" href="'+taskURL+'">'+escapeHTML(row.task_title)+'</a></td><td>'+escapeHTML(row.technical_result)+'</td><td>'+escapeHTML(row.goal_result||'Not goal-bearing')+'</td><td>'+escapeHTML(row.model)+'</td><td>'+row.execution_count+'</td><td>'+row.follow_up_count+'</td></tr>'; }).join('') : '<tr><td colspan="6" class="text-center opacity-50">No recent supporting tasks in this period</td></tr>';						}
							function renderSkillOutcomes(rows) {
								const table = document.getElementById('skillOutcomeTable');
								if (!table) return;
								table.innerHTML = rows.length ? rows.map(function(row) {
									return '<tr><td><code>' + escapeHTML(row.skill_handle) + '</code></td><td>' + row.tasks_evaluated + '</td><td>' + escapeHTML(ratioText(row.technical_completion)) + '</td><td>' + escapeHTML(ratioText(row.goal_achievement)) + '</td><td>' + escapeHTML(ratioText(row.follow_up)) + '</td></tr>';
								}).join('') : '<tr><td colspan="5" class="text-center opacity-50">No selected or loaded skills have task outcome evidence in this period</td></tr>';
							}
							function renderWorkflowPerformance(rows) {
								const filter = document.getElementById('analyticsWorkflowFilter'); const selected = filter.value || new URLSearchParams(window.location.search).get('workflow') || '';							filter.innerHTML = '<option value="">All Workflows</option>' + rows.map(function(row) { return '<option value="' + escapeHTML(row.workflow_id) + '">' + escapeHTML(row.workflow_name) + '</option>'; }).join(''); filter.value = selected;
							const visible = rows.filter(function(row) { return !selected || row.workflow_id === selected; });
							document.getElementById('workflowPerformanceTable').innerHTML = visible.length ? visible.map(function(row) { const url='/automations/'+encodeURIComponent(row.workflow_id)+'?project_id='+encodeURIComponent(projectID); return '<tr><td><a class="link" href="'+url+'">'+escapeHTML(row.workflow_name)+'</a></td><td>'+row.invocation_count+'</td><td>'+row.completed_count+' / '+(row.completed_count+row.failed_count)+' ('+Number(row.completion_rate||0).toFixed(1)+'%)</td><td>'+row.failed_count+'</td><td>'+escapeHTML(formatDuration(row.average_duration_ms||0))+'</td><td>'+row.waiting_count+' / '+row.blocked_count+'</td><td>Unavailable</td><td>'+escapeHTML(row.health)+'</td></tr>'; }).join('') : '<tr><td colspan="8" class="text-center"><span class="opacity-50">No automations in this project.</span> <a class="link" href="/automations?project_id='+encodeURIComponent(projectID)+'">Inspect or create automations</a></td></tr>';
						}
						function renderInsights(rows) { ['improvement', 'attention'].forEach(function(kind) { const target=document.getElementById(kind === 'improvement' ? 'analyticsImprovements' : 'analyticsAttention'); const items=rows.filter(function(row){return row.kind===kind;}); target.innerHTML=items.length?items.map(function(row){return '<a class="block link" href="'+escapeHTML(analyticsURL(row.evidence_view||'outcomes'))+'"><strong>'+escapeHTML(row.title)+'</strong><br><span>'+escapeHTML(row.detail)+' n='+row.sample_size+' · '+escapeHTML(row.comparison_window)+'</span></a>';}).join(''):'<p class="opacity-50">No supported '+(kind==='improvement'?'improvement':'attention')+' insight at the minimum sample size.</p>'; }); }

						async function loadDashboard() {
							const params = new URLSearchParams({ project_id: projectID, range: usageRangeParam(), compare: document.getElementById('comparePeriod').checked ? '1' : '0' });
							try { latestDashboard = await fetchJSON('/api/analytics/dashboard?' + params.toString()); renderDashboard(latestDashboard); }
							catch (error) { showAnalyticsError(error); }
						}

						function formatNumber(value) {
							return new Intl.NumberFormat().format(value || 0);
						}

						function formatCost(value) {
							if (value === null || value === undefined) return 'cost unavailable';
							return '$' + Number(value).toFixed(4);
						}

						function formatResetCountdown(value) {
							if (!value) return '';
							const resetAt = new Date(value);
							if (Number.isNaN(resetAt.getTime())) return '';
							const remainingMilliseconds = resetAt.getTime() - Date.now();
							if (remainingMilliseconds <= 0) return 'Reset due';
							const totalMinutes = Math.ceil(remainingMilliseconds / 60000);
							const days = Math.floor(totalMinutes / 1440);
							const hours = Math.floor((totalMinutes % 1440) / 60);
							const minutes = totalMinutes % 60;
							const parts = [];
							if (days > 0) parts.push(days + ' ' + (days === 1 ? 'day' : 'days'));
							if (hours > 0) parts.push(hours + ' ' + (hours === 1 ? 'hour' : 'hours'));
							if (minutes > 0 || parts.length === 0) parts.push(minutes + ' ' + (minutes === 1 ? 'minute' : 'minutes'));
							return 'Resets: ' + parts.join(', ');
						}


								function usageModelKey(row) {
									return JSON.stringify([row.provider || 'unknown', row.model || 'unknown']);
								}

								function usageModelParts(rowOrKey) {
									if (typeof rowOrKey !== 'string') return [rowOrKey.provider || 'unknown', rowOrKey.model || 'unknown'];
									try {
										const parts = JSON.parse(rowOrKey);
										if (Array.isArray(parts) && parts.length >= 2) return [parts[0] || 'unknown', parts[1] || 'unknown'];
									} catch (e) {}
									const fallback = rowOrKey.split('/');
									return [fallback[0] || 'unknown', fallback.slice(1).join('/') || 'unknown'];
								}

								function usageModelLabel(rowOrKey) {
									const parts = usageModelParts(rowOrKey);
									return parts[0] + '/' + parts[1];
								}

								function escapeHTML(value) {
									return String(value).replace(/[&<>"']/g, function(ch) {
										return ({ '&': '&amp;', '<': '&lt;', '>': '&gt;', '"': '&quot;', "'": '&#39;' })[ch];
									});
								}


								function relativeTime(value) {
									if (!value) return 'never';
									const date = new Date(value);
									if (Number.isNaN(date.getTime())) return 'never';
									const seconds = Math.max(0, Math.floor((Date.now() - date.getTime()) / 1000));
									if (seconds < 60) return 'today';
									const minutes = Math.floor(seconds / 60);
									if (minutes < 60) return minutes + 'm ago';
									const hours = Math.floor(minutes / 60);
									if (hours < 24) return hours + 'h ago';
									const days = Math.floor(hours / 24);
									return days + 'd ago';
								}

								function skillRangeParam() { return usageRangeParam(); }

								async function loadSkillAnalytics() {
									try {
										const groupBy = document.getElementById('groupBy').value;
									const params = new URLSearchParams({ project_id: projectID, range: skillRangeParam(), group_by: groupBy });
										const data = await fetchJSON('/api/analytics/skills?' + params.toString());
										renderSkillAnalytics(data);
									} catch (e) { console.error('loadSkillAnalytics:', e); showAnalyticsError(e); }
								}

								function renderSkillAnalytics(data) {
									renderSkillUsageTrend(data?.usage_over_time || []);
									renderSkillTop(data?.top_skills || []);
									renderSkillFollow(data?.follow_through || []);
									renderSkillAgentUsage(data?.agent_usage || {});
									renderUnderusedSkills(data?.underused || []);
								}

								function skillLabel(value) {
									const text = String(value || 'unknown');
									return text.length > 34 ? text.slice(0, 31) + '…' : text;
								}

								function skillEventTotals(rows) {
									return (rows || []).reduce(function(acc, row) {
										acc.selected += row.selected_count || 0;
										acc.loaded += row.loaded_count || 0;
										acc.viewed += row.viewed_count || 0;
										acc.created += row.created_count || 0;
										acc.edited += row.edited_count || 0;
										return acc;
									}, { selected: 0, loaded: 0, viewed: 0, created: 0, edited: 0 });
								}


									const analyticsActivePointOnTop = {
										id: 'analyticsActivePointOnTop',
										beforeEvent: function(chart, args) {
											const event = args.event;
											const previous = chart.$analyticsHoveredPoint || null;
											if (!event || event.type === 'mouseout' || !args.inChartArea) {
												chart.$analyticsHoveredPoint = null;
											} else {
												const nearest = chart.getElementsAtEventForMode(event, 'nearest', { intersect: false }, false);
												chart.$analyticsHoveredPoint = nearest.length > 0 ? nearest[0] : null;
											}
											const current = chart.$analyticsHoveredPoint;
											if ((!previous && current) || (previous && !current) || (previous && current && (previous.datasetIndex !== current.datasetIndex || previous.index !== current.index))) {
												args.changed = true;
											}
										},
										afterDraw: function(chart) {
											let marker = chart.$analyticsHoverMarker;
											if (!marker) {
												marker = document.createElement('span');
												marker.setAttribute('data-analytics-hover-marker', '');
												marker.setAttribute('aria-hidden', 'true');
												marker.style.position = 'absolute';
												marker.style.width = '12px';
												marker.style.height = '12px';
												marker.style.boxSizing = 'border-box';
												marker.style.border = '3px solid rgba(255, 255, 255, 0.96)';
												marker.style.borderRadius = '9999px';
												marker.style.transform = 'translate(-50%, -50%)';
												marker.style.pointerEvents = 'none';
												marker.style.zIndex = '2';
												chart.canvas.parentElement.appendChild(marker);
												chart.$analyticsHoverMarker = marker;
											}
											const point = chart.$analyticsHoveredPoint;
											const tooltip = chart.tooltip;
											if (!tooltip || tooltip.opacity === 0 || !point) {
												marker.style.display = 'none';
												return;
											}
											const element = point.element;
											const canvasRect = chart.canvas.getBoundingClientRect();
											const parentRect = chart.canvas.parentElement.getBoundingClientRect();
											const scaleX = chart.width ? canvasRect.width / chart.width : 1;
											const scaleY = chart.height ? canvasRect.height / chart.height : 1;
											const dataset = chart.data.datasets[point.datasetIndex] || {};
											const datasetColor = dataset.borderColor || element.options?.borderColor || element.options?.backgroundColor;
											const markerLeft = canvasRect.left - parentRect.left + element.x * scaleX;
											const markerTop = canvasRect.top - parentRect.top + element.y * scaleY;
											const chartLeft = canvasRect.left - parentRect.left + chart.chartArea.left * scaleX;
											const chartTop = canvasRect.top - parentRect.top + chart.chartArea.top * scaleY;
											const chartRight = canvasRect.left - parentRect.left + chart.chartArea.right * scaleX;
											const chartBottom = canvasRect.top - parentRect.top + chart.chartArea.bottom * scaleY;
											marker.style.left = markerLeft + 'px';
											marker.style.top = markerTop + 'px';
											marker.style.clipPath = 'inset(' + Math.max(0, chartTop - markerTop + 6) + 'px ' + Math.max(0, markerLeft + 6 - chartRight) + 'px ' + Math.max(0, markerTop + 6 - chartBottom) + 'px ' + Math.max(0, chartLeft - markerLeft + 6) + 'px)';
											marker.style.backgroundColor = typeof datasetColor === 'string' ? datasetColor : 'rgb(59, 130, 246)';
											marker.style.display = 'block';
										},
										beforeDestroy: function(chart) {
											chart.$analyticsHoverMarker?.remove();
											chart.$analyticsHoverMarker = null;
										}
									};

									function analyticsLineTooltipOptions() {
										return {
											position: 'nearest',
											caretPadding: 6,
											itemSort: function(a, b) {
												const hovered = a.chart?.$analyticsHoveredPoint || b.chart?.$analyticsHoveredPoint;
												if (!hovered) return 0;
												const aIsHovered = a.datasetIndex === hovered.datasetIndex;
												const bIsHovered = b.datasetIndex === hovered.datasetIndex;
												if (aIsHovered === bIsHovered) return 0;
												return aIsHovered ? -1 : 1;
											}
										};
									}

									function lineDataset(label, data, color) {
										return { label: label, data: data, borderColor: color, backgroundColor: color, tension: 0.25, fill: false, pointRadius: 2, pointHoverRadius: 4 };
									}
							function renderSkillUsageTrend(totals) {
								const totalRows = totals || [];
								const canvas = renderChartState('skillUsageTrend', 'skillUsageTrendChart', totalRows, 'No skill activity in this period');
								if (!canvas) return;
								const labels = totalRows.map(row => row.period || '');
									const datasets = [
										lineDataset('Used', totalRows.map(row => (row.selected_count || 0) + (row.loaded_count || 0) + (row.viewed_count || 0)), 'rgb(59, 130, 246)'),
										lineDataset('Created', totalRows.map(row => row.created_count || 0), 'rgb(20, 184, 166)'),
										lineDataset('Edited', totalRows.map(row => row.edited_count || 0), 'rgb(147, 51, 234)')
									];
									charts.skillUsageTrend = new Chart(canvas.getContext('2d'), {
										type: 'line',
										plugins: [analyticsActivePointOnTop],
										data: { labels: labels, datasets: datasets },
										options: { responsive: true, maintainAspectRatio: false, interaction: { mode: 'index', intersect: false }, plugins: { legend: { position: 'bottom' }, tooltip: analyticsLineTooltipOptions() }, scales: { y: { beginAtZero: true } } }
									});
								}

								function renderSkillTop(rows) {
									const chartRows = rows.slice(0, 8).map(function(row) {
										return Object.assign({}, row, {
											activity: (row.selected_count || 0) + (row.loaded_count || 0) + (row.viewed_count || 0) + (row.created_count || 0) + (row.edited_count || 0)
										});
									});
									const canvas = renderChartState('skillTop', 'skillTopChart', chartRows, 'No skill activity in this period');
									if (canvas) {
										charts.skillTop = new Chart(canvas.getContext('2d'), {
											type: 'bar',
											data: { labels: chartRows.map(r => skillLabel(r.skill_handle)), datasets: [
												{ label: 'Selected', data: chartRows.map(r => r.selected_count || 0), backgroundColor: 'rgba(59, 130, 246, 0.5)', borderColor: 'rgb(59, 130, 246)', borderWidth: 1 },
												{ label: 'Loaded', data: chartRows.map(r => r.loaded_count || 0), backgroundColor: 'rgba(34, 197, 94, 0.5)', borderColor: 'rgb(34, 197, 94)', borderWidth: 1 },
												{ label: 'Viewed', data: chartRows.map(r => r.viewed_count || 0), backgroundColor: 'rgba(251, 146, 60, 0.5)', borderColor: 'rgb(251, 146, 60)', borderWidth: 1 },
												{ label: 'Created', data: chartRows.map(r => r.created_count || 0), backgroundColor: 'rgba(20, 184, 166, 0.5)', borderColor: 'rgb(20, 184, 166)', borderWidth: 1 },
												{ label: 'Edited', data: chartRows.map(r => r.edited_count || 0), backgroundColor: 'rgba(147, 51, 234, 0.5)', borderColor: 'rgb(147, 51, 234)', borderWidth: 1 }
											] },
											options: { indexAxis: 'y', responsive: true, maintainAspectRatio: false, scales: { x: { beginAtZero: true, stacked: true }, y: { stacked: true } }, plugins: { legend: { position: 'bottom' } } }
										});
									}
								}

								function renderSkillFollow(rows) {
									const chartRows = rows.slice(0, 8);
									const canvas = renderChartState('skillFollow', 'skillFollowChart', chartRows, 'No skill follow-through evidence in this period');
									if (canvas) {
										charts.skillFollow = new Chart(canvas.getContext('2d'), {
											type: 'bar',
											data: { labels: chartRows.map(r => skillLabel(r.skill_handle)), datasets: [
												{ label: 'Used', data: chartRows.map(r => r.loaded_or_viewed_count || 0), backgroundColor: 'rgba(34, 197, 94, 0.5)', borderColor: 'rgb(34, 197, 94)', borderWidth: 1 },
												{ label: 'Ignored', data: chartRows.map(r => r.ignored_count || 0), backgroundColor: 'rgba(239, 68, 68, 0.5)', borderColor: 'rgb(239, 68, 68)', borderWidth: 1 }
											] },
											options: { indexAxis: 'y', responsive: true, maintainAspectRatio: false, scales: { x: { beginAtZero: true, stacked: true }, y: { stacked: true } }, plugins: { legend: { position: 'bottom' } } }
										});
									}
								}

								function renderSkillAgentUsage(heatmap) {
									const cells = heatmap.cells || [];
									const agentNames = new Map((heatmap.agents || []).map(a => [a.agent_id || '', a.agent_name || a.agent_id || 'Unassigned']));
									const rows = cells.map(function(cell) {
										return Object.assign({}, cell, {
											agent_name: agentNames.get(cell.agent_id || '') || 'Unassigned',
											activity: (cell.selected_count || 0) + (cell.loaded_count || 0) + (cell.viewed_count || 0)
										});
									}).filter(row => row.activity > 0).sort((a, b) => b.activity - a.activity).slice(0, 8);
									const canvas = renderChartState('skillAgent', 'skillAgentChart', rows, 'No Agent and skill pair activity in this period');
									if (canvas) {
										charts.skillAgent = new Chart(canvas.getContext('2d'), {
											type: 'bar',
											data: {
												labels: rows.map(row => skillLabel(row.agent_name + ' · ' + row.skill_handle)),
												datasets: [{ label: 'Activity', data: rows.map(row => row.activity), backgroundColor: 'rgba(20, 184, 166, 0.5)', borderColor: 'rgb(20, 184, 166)', borderWidth: 1 }]
											},
											options: { indexAxis: 'y', responsive: true, maintainAspectRatio: false, scales: { x: { beginAtZero: true } }, plugins: { legend: { position: 'bottom' } } }
										});
									}
								}

								function renderUnderusedSkills(rows) {
									const tbody = document.getElementById('underusedSkillsTable');
									if (!tbody) return;
									if (rows.length === 0) { tbody.innerHTML = '<tr><td colspan="4" class="text-center opacity-50">No enabled skills found</td></tr>'; return; }
									tbody.innerHTML = rows.slice(0, 8).map(function(r) {
										const activity = (r.selected_count || 0) + (r.loaded_count || 0) + (r.viewed_count || 0);
										const alwaysUse = r.always_use ? ' · always-use' : '';
										return '<tr><td><code>' + escapeHTML(r.skill_handle) + '</code></td><td><span class="badge badge-ghost badge-sm">' + escapeHTML((r.skill_scope || '') + alwaysUse) + '</span></td><td>' + formatNumber(activity) + '</td><td class="text-xs opacity-70">' + relativeTime(r.last_activity) + '</td></tr>';
									}).join('');
								}

								function modelSeriesKeys(rows) {
									return Array.from(new Set((rows || []).map(usageModelKey))).sort(function(a, b) { return usageModelLabel(a).localeCompare(usageModelLabel(b)); });
								}

								function fillModelChoiceSelect(selectID, keys) {
									const select = document.getElementById(selectID);
									if (!select) return 'combined';
									const previous = select.value || 'combined';
									const validChoices = ['combined', 'all'].concat(keys || []);
									const keep = validChoices.includes(previous) ? previous : 'combined';
									const modelOptions = (keys || []).map(key => '<option value="' + escapeHTML(key) + '">' + escapeHTML(usageModelLabel(key)) + '</option>').join('');
									select.innerHTML = '<option value="combined">All models combined</option><option value="all">Each model</option>' + modelOptions;
									select.value = keep;
									select.disabled = (keys || []).length === 0;
									return keep;
								}

							const usageSeriesColors = [
								'rgb(59, 130, 246)',
								'rgb(34, 197, 94)',
								'rgb(251, 146, 60)',
								'rgb(147, 51, 234)',
								'rgb(239, 68, 68)',
								'rgb(20, 184, 166)',
								'rgb(236, 72, 153)',
								'rgb(132, 204, 22)'
							];

							function colorForIndex(index, alpha) {
								const color = usageSeriesColors[index % usageSeriesColors.length];
								return color.replace('rgb(', 'rgba(').replace(')', ', ' + alpha + ')');
							}

							function uniquePeriods(rows) {
								return Array.from(new Set((rows || []).map(row => row.period))).sort();
							}
							function usageRangeParam() {
							const range = document.getElementById('dateRange').value;
							if (range === '7') return '7d';
							if (range === '90') return '90d';
							if (range === '365') return '365d';
							if (range === 'all') return 'all';
							return '30d';
						}
						// Format milliseconds as human-readable duration (e.g., "5m 30s", "2h 15m")
					function formatDuration(ms) {
						if (ms < 1000) return ms.toFixed(0) + 'ms';
						var totalSeconds = Math.round(ms / 1000);
						var hours = Math.floor(totalSeconds / 3600);
						var minutes = Math.floor((totalSeconds % 3600) / 60);
						var seconds = totalSeconds % 60;
						if (hours > 0) return hours + 'h ' + minutes + 'm';
						if (minutes > 0) return minutes + 'm ' + seconds + 's';
						return seconds + 's';
					}

					// Utility function to get date range
					function getDateRange() {
						const range = document.getElementById('dateRange').value;
						if (range === 'all') {
							return { dateFrom: '', dateTo: '' };
						}
						const dateTo = new Date();
						const dateFrom = new Date();
						dateFrom.setDate(dateTo.getDate() - parseInt(range));
						return {
							dateFrom: dateFrom.toISOString(),
							dateTo: dateTo.toISOString()
						};
					}

								function renderUsageRateChart(data) {
									const rate = data?.usage_rate || [];
									const rateByModel = data?.usage_rate_by_model || [];
								const rateKeys = modelSeriesKeys(rateByModel);
								const choice = fillModelChoiceSelect('usageRateModelSelect', rateKeys);
								const rateCtx = renderChartState('usageRate', 'usageRateChart', rate, 'No token usage in this period');
								if (!rateCtx) return;
									let labels = [];
									let datasets = [];
									if (choice === 'combined' || rateByModel.length === 0) {
										labels = rate.map(d => d.period);
										datasets = [{ label: 'All models', data: rate.map(d => d.total_tokens || 0), borderColor: 'rgb(147, 51, 234)', backgroundColor: 'rgba(147, 51, 234, 0.12)', tension: 0.25 }];
									} else {
										const rows = choice === 'all' ? rateByModel : rateByModel.filter(row => usageModelKey(row) === choice);
										labels = uniquePeriods(rows);
										const keys = choice === 'all' ? rateKeys : (choice ? [choice] : []);
										datasets = keys.map((key, index) => {
											const totalsByPeriod = new Map(rows.filter(row => usageModelKey(row) === key).map(row => [row.period, row.total_tokens || 0]));
											return { label: usageModelLabel(key), data: labels.map(period => totalsByPeriod.get(period) || 0), borderColor: usageSeriesColors[index % usageSeriesColors.length], backgroundColor: colorForIndex(index, 0.12), tension: 0.25 };
										});
									}
									charts.usageRate = new Chart(rateCtx.getContext('2d'), {
										type: 'line',
										plugins: [analyticsActivePointOnTop],
										data: { labels: labels, datasets: datasets },
										options: { responsive: true, maintainAspectRatio: false, interaction: { mode: 'index', intersect: false }, plugins: { legend: { position: 'bottom' }, tooltip: analyticsLineTooltipOptions() }, scales: { y: { beginAtZero: true } } }
									});
								}

								function renderUsageAnalytics(data) {
									const totals = data.totals || {};
									renderUsageOutcomeContext(latestDashboard ? latestDashboard.current || {} : {}, totals);
									const lastUpdated = document.getElementById('usageLastUpdated');
									lastUpdated.textContent = data.last_updated_at ? 'Last updated ' + new Date(data.last_updated_at).toLocaleString() : 'Local usage history';
										renderUsageRateChart(data);

									const breakdown = data.model_breakdown || [];
									const table = document.getElementById('usageBreakdownTable');
									if (table) {
										if (breakdown.length === 0 && (totals.call_count || 0) === 0) {
											table.innerHTML = '<tr><td colspan="8" class="text-center opacity-50">No usage recorded yet</td></tr>';
										} else {
											const rows = breakdown.map(row => '<tr><td>' + escapeHTML(row.provider || 'unknown') + '</td><td>' + escapeHTML(row.model || 'unknown') + '</td><td>' + formatNumber(row.input_tokens) + '</td><td>' + formatNumber(row.output_tokens) + '</td><td>' + formatNumber(row.cached_input_tokens) + '</td><td>' + formatNumber(row.reasoning_output_tokens) + '</td><td>' + formatNumber(row.total_tokens) + '</td><td>' + formatCost(row.cost_usd) + '</td></tr>');
											const totalCost = totals.cost_available ? formatCost(totals.cost_usd) : 'cost unavailable';
											rows.push('<tr class="font-semibold border-t border-base-300"><td>Total</td><td>All models</td><td>' + formatNumber(totals.input_tokens) + '</td><td>' + formatNumber(totals.output_tokens) + '</td><td>' + formatNumber(totals.cached_input_tokens) + '</td><td>' + formatNumber(totals.reasoning_output_tokens) + '</td><td>' + formatNumber(totals.total_tokens) + '</td><td>' + totalCost + '</td></tr>');
											table.innerHTML = rows.join('');
										}
									}
								const modelCtx = renderChartState('modelTokenBreakdown', 'modelTokenBreakdownChart', breakdown, 'No model token usage in this period');
								if (modelCtx) {
									charts.modelTokenBreakdown = new Chart(modelCtx.getContext('2d'), {
										type: 'bar',
											data: {
												labels: breakdown.map(row => `${row.provider}/${row.model}`),
												datasets: [{
													data: breakdown.map(row => row.total_tokens || 0),
													backgroundColor: [
														'rgba(239, 68, 68, 0.7)',
														'rgba(34, 197, 94, 0.7)',
														'rgba(59, 130, 246, 0.7)',
														'rgba(251, 146, 60, 0.7)',
														'rgba(147, 51, 234, 0.7)',
														'rgba(20, 184, 166, 0.7)'
													]
												}]
											},
											options: {
												responsive: true,
												maintainAspectRatio: false,
												plugins: { legend: { position: 'bottom' } }
											}
										});
									}
									const accountContainer = document.getElementById('accountUsageCards');
									const accounts = data.account_limits || [];
									if (accountContainer) {
										if (accounts.length === 0) {
											accountContainer.innerHTML = '<p class="opacity-50 lg:col-span-2">No connected OAuth account snapshots yet.</p>';
										} else {
											accountContainer.innerHTML = accounts.map(account => {
												let accountLimits = account.limits || [];
												if (accountLimits.length === 0) {
													if (account.primary_limit) accountLimits.push(account.primary_limit);
													if (account.secondary_limit) accountLimits.push(account.secondary_limit);
													accountLimits = accountLimits.concat(account.extra_limits || []);
												}
												const limits = accountLimits.map(limit => {
													const pct = limit.used_percent === null || limit.used_percent === undefined ? null : Number(limit.used_percent);
													const width = pct === null ? 0 : Math.max(0, Math.min(100, pct));
													const resetLabel = formatResetCountdown(limit.resets_at);
													const reset = resetLabel ? `<div class="text-xs opacity-60">${resetLabel}</div>` : '';
													return `<div class="mt-2"><div class="flex justify-between text-xs"><span>${escapeHTML(limit.label || 'limit')}</span><span>${pct === null ? 'unknown' : pct.toFixed(1) + '%'}</span></div><div class="ov-account-limit-bar" role="meter" aria-label="${escapeHTML(limit.label || 'limit')} usage" aria-valuemin="0" aria-valuemax="100" aria-valuenow="${width.toFixed(1)}"><div class="ov-account-limit-bar-fill" style="width: ${width}%"></div></div>${reset}</div>`;
												}).join('');
												const error = account.error ? `<div class="alert alert-warning py-2 text-xs mt-2">${escapeHTML(account.error)}</div>` : '';
												const providerName = (account.provider || '').toLowerCase();
												const providerTitle = providerName === 'openai' ? 'OpenAI' : (providerName === 'anthropic' ? 'Anthropic' : 'OAuth account');
												const subscription = account.plan_type || '';
												const metaParts = providerName === 'anthropic' ? [account.extra_usage_label] : [account.status_label, account.billing_label, account.extra_usage_label];
												const meta = metaParts.filter(Boolean).join(' · ');
												const detail = providerName === 'anthropic' ? '' : (account.account_detail || '');
												const usedCredits = account.extra_usage_used_usd !== null && account.extra_usage_used_usd !== undefined ? ' · Used: $' + Number(account.extra_usage_used_usd).toFixed(2) : '';
												const extraUsage = account.extra_usage_monthly_usd !== null && account.extra_usage_monthly_usd !== undefined ? '<div class="text-xs opacity-60">Monthly limit: $' + Number(account.extra_usage_monthly_usd).toFixed(2) + usedCredits + '</div>' : '';
													const subscriptionHtml = subscription ? '<div class="text-sm opacity-90">' + escapeHTML(subscription) + '</div>' : '';
													const metaHtml = meta ? '<div class="text-xs opacity-80">' + escapeHTML(meta) + '</div>' : '';
													const detailHtml = detail ? '<div class="text-xs opacity-60">' + escapeHTML(detail) + '</div>' : '';
													return '<div class="card bg-base-100 shadow-sm border border-base-300 h-full"><div class="card-body"><div class="font-semibold">' + escapeHTML(providerTitle) + '</div>' + subscriptionHtml + metaHtml + detailHtml + extraUsage + (limits || '<div class="text-xs opacity-50 mt-2">No live limit snapshot yet</div>') + error + '</div></div>';
												}).join('');
										}
									}
								}

								async function loadUsageAnalytics(refreshUsage) {
									try {
										const groupBy = document.getElementById('groupBy').value;
										const params = new URLSearchParams({ project_id: projectID, range: usageRangeParam(), group_by: groupBy });
										if (refreshUsage) params.append('refresh', 'true');
										latestUsageAnalytics = await fetchJSON('/api/analytics/usage?' + params.toString());
										renderUsageAnalytics(latestUsageAnalytics);
									} catch (e) { console.error('loadUsageAnalytics:', e); showAnalyticsError(e); }
								}

								// Load Success/Failure Rates
					async function loadSuccessFailureRates() {
						try {
						const groupBy = document.getElementById('groupBy').value;
						const { dateFrom, dateTo } = getDateRange();
						const params = new URLSearchParams({ project_id: projectID, group_by: groupBy });
						if (dateFrom) params.append('date_from', dateFrom);
						if (dateTo) params.append('date_to', dateTo);

							const data = await fetchJSON(`/api/analytics/success-failure-rates?${params}`);
							const ctx = renderChartState('successFailure', 'successFailureChart', data, 'No terminal executions in this period');
							if (!ctx) return;

							charts.successFailure = new Chart(ctx.getContext('2d'), {
							type: 'line',
							plugins: [analyticsActivePointOnTop],
							data: {
								labels: data.map(d => d.Period || 'N/A'),
								datasets: [
									{
										label: 'Technical completion rate (%)',
										data: data.map(d => d.SuccessRate || 0),
										borderColor: 'rgb(34, 197, 94)',
										backgroundColor: 'rgba(34, 197, 94, 0.1)',
										yAxisID: 'y'
									},
									{
										label: 'Total Executions',
										data: data.map(d => d.TotalCount || 0),
										borderColor: 'rgb(59, 130, 246)',
										backgroundColor: 'rgba(59, 130, 246, 0.1)',
										yAxisID: 'y1'
									}
								]
							},
							options: {
								responsive: true,
								maintainAspectRatio: false,
								interaction: { mode: 'index', intersect: false },
								plugins: { tooltip: analyticsLineTooltipOptions() },
								scales: {
									y: { type: 'linear', display: true, position: 'left', max: 100, title: { display: true, text: 'Technical completion rate (%)' } },
									y1: { type: 'linear', display: true, position: 'right', title: { display: true, text: 'Total Executions' }, grid: { drawOnChartArea: false } }
								}
							}
						});
						} catch (e) { console.error('loadSuccessFailureRates:', e); showAnalyticsError(e); }
					}

					// Load Hourly Trends
					async function loadHourlyTrends() {
						try {
						const { dateFrom, dateTo } = getDateRange();
						const params = new URLSearchParams({ project_id: projectID });
						if (dateFrom) params.append('date_from', dateFrom);
						if (dateTo) params.append('date_to', dateTo);

							const data = await fetchJSON(`/api/analytics/execution-trends-by-hour?${params}`);

							const ctx = renderChartState('hourlyTrends', 'hourlyTrendsChart', data, 'No executions in this period');
							if (!ctx) return;
							charts.hourlyTrends = new Chart(ctx.getContext('2d'), {
							type: 'bar',
							data: {
								labels: Array.from({ length: 24 }, (_, i) => `${i}:00`),
								datasets: [{
									label: 'Executions',
									data: Array.from({ length: 24 }, (_, i) => {
										const found = data.find(d => d.Hour === i);
										return found ? found.Count : 0;
									}),
									backgroundColor: 'rgba(147, 51, 234, 0.5)',
									borderColor: 'rgb(147, 51, 234)',
									borderWidth: 1
								}]
							},
							options: {
								responsive: true,
								maintainAspectRatio: false,
								scales: { y: { beginAtZero: true, title: { display: true, text: 'Count' } } }
							}
						});
						} catch (e) { console.error('loadHourlyTrends:', e); showAnalyticsError(e); }
					}

					// Load Avg Execution Time by Task
					async function loadAvgTimeByTask() {
						try {
							const { dateFrom, dateTo } = getDateRange();
							const params = new URLSearchParams({ project_id: projectID, limit: '10' });
							if (dateFrom) params.set('date_from', dateFrom);
							if (dateTo) params.set('date_to', dateTo);
							const data = await fetchJSON('/api/analytics/avg-execution-time-by-task?' + params.toString());
							const ctx = renderChartState('avgTimeTask', 'avgTimeTaskChart', data, 'No completed execution durations in this period');
							if (!ctx) return;
							charts.avgTimeTask = new Chart(ctx.getContext('2d'), {
							type: 'bar',
							data: {
								labels: data.map(d => d.Name || 'Unknown'),
								datasets: [{
									label: 'Avg Time (min)',
									data: data.map(d => (d.AvgMs || 0) / 60000),
									backgroundColor: 'rgba(251, 146, 60, 0.5)',
									borderColor: 'rgb(251, 146, 60)',
									borderWidth: 1
								}]
							},
							options: {
								responsive: true,
								maintainAspectRatio: false,
								indexAxis: 'y',
								scales: { x: { beginAtZero: true, title: { display: true, text: 'Minutes' } } },
								plugins: {
									tooltip: {
										callbacks: {
											label: function(context) {
												return 'Avg: ' + formatDuration(data[context.dataIndex].AvgMs || 0) + ' · n=' + (data[context.dataIndex].Count || 0);
											}
										}
									}
								}
							}
						});
						} catch (e) { console.error('loadAvgTimeByTask:', e); showAnalyticsError(e); }
					}

					// Load Avg Execution Time by Agent
					async function loadAvgTimeByAgent() {
						try {
							const { dateFrom, dateTo } = getDateRange();
							const params = new URLSearchParams({ project_id: projectID });
							if (dateFrom) params.set('date_from', dateFrom);
							if (dateTo) params.set('date_to', dateTo);
							const data = await fetchJSON('/api/analytics/avg-execution-time-by-agent?' + params.toString());
							const ctx = renderChartState('avgTimeAgent', 'avgTimeAgentChart', data, 'No model duration samples in this period');
							if (!ctx) return;
							charts.avgTimeAgent = new Chart(ctx.getContext('2d'), {
							type: 'bar',
							data: {
								labels: data.map(d => d.Name || 'Unknown'),
								datasets: [{
									label: 'Avg Time (min)',
									data: data.map(d => (d.AvgMs || 0) / 60000),
									backgroundColor: 'rgba(20, 184, 166, 0.5)',
									borderColor: 'rgb(20, 184, 166)',
									borderWidth: 1
								}]
							},
							options: {
								responsive: true,
								maintainAspectRatio: false,
								scales: { y: { beginAtZero: true, title: { display: true, text: 'Minutes' } } },
								plugins: {
									tooltip: {
										callbacks: {
											label: function(context) {
												return 'Avg: ' + formatDuration(data[context.dataIndex].AvgMs || 0) + ' · n=' + (data[context.dataIndex].Count || 0);
											}
										}
									}
								}
							}
						});
						} catch (e) { console.error('loadAvgTimeByAgent:', e); showAnalyticsError(e); }
					}

					// Load Agent Usage
					async function loadAgentUsage() {
						try {
							const { dateFrom, dateTo } = getDateRange();
							const params = new URLSearchParams({ project_id: projectID });
							if (dateFrom) params.set('date_from', dateFrom);
							if (dateTo) params.set('date_to', dateTo);
							const data = await fetchJSON('/api/analytics/agent-usage-by-project?' + params.toString());
							const ctx = renderChartState('agentUsage', 'agentUsageChart', data, 'No model executions in this period');
							if (!ctx) return;
							charts.agentUsage = new Chart(ctx.getContext('2d'), {
								type: 'bar',
							data: {
								labels: data.map(d => d.AgentName || 'Unknown'),
								datasets: [{
									data: data.map(d => d.ExecutionCount || 0),
									backgroundColor: [
										'rgba(239, 68, 68, 0.7)',
										'rgba(34, 197, 94, 0.7)',
										'rgba(59, 130, 246, 0.7)',
										'rgba(251, 146, 60, 0.7)',
										'rgba(147, 51, 234, 0.7)',
										'rgba(20, 184, 166, 0.7)'
									]
								}]
							},
							options: {
								responsive: true,
								maintainAspectRatio: false,
								plugins: { legend: { position: 'bottom' } }
							}
						});
						} catch (e) { console.error('loadAgentUsage:', e); showAnalyticsError(e); }
					}

					// Load Most Frequent Tasks
					async function loadMostFrequentTasks() {
						try {
							const { dateFrom, dateTo } = getDateRange();
							const params = new URLSearchParams({ project_id: projectID, limit: '10' });
							if (dateFrom) params.set('date_from', dateFrom);
							if (dateTo) params.set('date_to', dateTo);
							const data = await fetchJSON('/api/analytics/most-frequent-tasks?' + params.toString());

						const container = document.getElementById('frequentTasksList');
						if (!container) return;
						if (data.length === 0) {
							container.innerHTML = '<p class="text-center opacity-50 py-4">No data available</p>';
							return;
						}

							container.innerHTML = data.map((task, idx) => `
								<div class="flex items-center justify-between gap-3 py-2 border-b border-base-300">
									<div class="flex-1 min-w-0 pr-2">
										<span class="font-mono text-sm opacity-50">${idx + 1}.</span>
										<span class="ml-2 break-words"><a class="link" href="/tasks/${encodeURIComponent(task.TaskID)}?project_id=${encodeURIComponent(projectID)}">${escapeHTML(task.TaskTitle || 'Unknown')}</a></span>
									</div>
									<span class="badge badge-primary shrink-0 inline-flex items-center justify-center whitespace-nowrap h-auto min-h-6 px-3 py-1 leading-none text-center">${task.ExecutionCount || 0} runs</span>
								</div>
							`).join('');						} catch (e) { console.error('loadMostFrequentTasks:', e); showAnalyticsError(e); }
					}

					// Load Failed Task Patterns
					async function loadFailedTaskPatterns() {
						try {
							const { dateFrom, dateTo } = getDateRange();
							const params = new URLSearchParams({ project_id: projectID, limit: '10' });
							if (dateFrom) params.set('date_from', dateFrom);
							if (dateTo) params.set('date_to', dateTo);
							const data = await fetchJSON('/api/analytics/failed-task-patterns?' + params.toString());

						const tbody = document.querySelector('#failedPatternsTable tbody');
						if (!tbody) return;
						if (data.length === 0) {
							tbody.innerHTML = '<tr><td colspan="4" class="text-center opacity-50">No failed tasks</td></tr>';
							return;
						}

						tbody.innerHTML = data.map(pattern => {
							const lastError = pattern.LastError || 'N/A';
							const truncatedError = lastError.length > 50 ? lastError.substring(0, 50) + '...' : lastError;
							const lastFailedAt = pattern.LastFailedAt ? new Date(pattern.LastFailedAt).toLocaleString() : 'N/A';
							return `
								<tr>
									<td><a class="link" href="/tasks/${encodeURIComponent(pattern.TaskID)}?project_id=${encodeURIComponent(projectID)}">${escapeHTML(pattern.TaskTitle || 'Unknown')}</a></td>
									<td><span class="badge badge-error">${pattern.FailureCount || 0}</span></td>
									<td><span class="text-xs" title="${escapeHTML(lastError)}">${escapeHTML(truncatedError)}</span></td>
									<td class="text-xs opacity-60">${escapeHTML(lastFailedAt)}</td>
								</tr>
							`;
						}).join('');
						} catch (e) { console.error('loadFailedTaskPatterns:', e); showAnalyticsError(e); }
					}

						// Load all data; each card clears stale state independently.
						async function loadAllData(refreshUsage) {
							document.getElementById('analyticsError').classList.add('hidden');
							await Promise.allSettled([
								loadDashboard(), loadUsageAnalytics(refreshUsage), loadSkillAnalytics(),
								loadSuccessFailureRates(), loadHourlyTrends(), loadAvgTimeByTask(),
								loadAvgTimeByAgent(), loadAgentUsage(), loadMostFrequentTasks(), loadFailedTaskPatterns()
							]);
						}

						function restoreURLState() {
							const params = new URLSearchParams(window.location.search);
							const range = params.get('range') || '30d';
							const rangeValue = range === 'all' ? 'all' : range.replace(/d$/, '');
							if (Array.from(document.getElementById('dateRange').options).some(function(option) { return option.value === rangeValue; })) document.getElementById('dateRange').value = rangeValue;
							const group = params.get('group_by') || 'day';
							if (['day', 'week', 'month'].includes(group)) document.getElementById('groupBy').value = group;
							document.getElementById('comparePeriod').checked = params.get('compare') !== '0' && range !== 'all';
							applyView(params.get('view') || 'overview', false);
						}
						document.querySelectorAll('[data-analytics-view]').forEach(function(button) { button.addEventListener('click', function() { applyView(button.dataset.analyticsView, true); }, { signal: eventSignal }); });
						document.getElementById('refreshBtn').addEventListener('click', function() { history.replaceState({}, '', analyticsURL(selectedView)); loadAllData(true); }, { signal: eventSignal });
						['dateRange', 'groupBy', 'comparePeriod'].forEach(function(id) { document.getElementById(id).addEventListener('change', function() { if (document.getElementById('dateRange').value === 'all') document.getElementById('comparePeriod').checked = false; history.replaceState({}, '', analyticsURL(selectedView)); loadAllData(false); }, { signal: eventSignal }); });
							document.getElementById('analyticsAgentFilter').addEventListener('change', function() { history.replaceState({}, '', analyticsURL(selectedView)); if (latestDashboard) renderAgentPerformance(latestDashboard.agents || []); }, { signal: eventSignal });
							document.getElementById('analyticsWorkflowFilter').addEventListener('change', function() { history.replaceState({}, '', analyticsURL(selectedView)); if (latestDashboard) renderWorkflowPerformance(latestDashboard.workflows || []); }, { signal: eventSignal });						const usageRateSelect = document.getElementById('usageRateModelSelect');
						if (usageRateSelect) usageRateSelect.addEventListener('change', function() { if (latestUsageAnalytics) renderUsageRateChart(latestUsageAnalytics); }, { signal: eventSignal });
						window.addEventListener('popstate', function() { restoreURLState(); loadAllData(false); }, { signal: eventSignal });
						restoreURLState();
						loadAllData(false);
				}

				// Load Chart.js dynamically if not already loaded, then initialize.
				// This fixes HTMX navigation: external <script src> tags load async during
				// HTMX swaps, so the inline script would run before Chart.js was available.
				if (typeof Chart !== 'undefined') {
					setTimeout(initAnalytics, 0);
				} else {
					var script = document.createElement('script');
					script.src = 'https://cdn.jsdelivr.net/npm/chart.js@4.4.1/dist/chart.umd.min.js';
					script.onload = initAnalytics;
					document.head.appendChild(script);
				}
				})();
			</script>
	} else {
		<div class="text-center py-12 opacity-50">
			<p>No projects yet. Create one to view analytics.</p>
		</div>
	}
}
