							}
						function renderChartState(key, canvasID, rows, message) {
							if (preserveActiveCharts && charts[key]) return null;
							destroyChart(key);
							const canvas = document.getElementById(canvasID);
								if (!canvas) return null;
								const chartLabels = { projectOutcomeTrendChart: 'Project outcome trend', cycleDistributionChart: 'Task duration distribution', followupDistributionChart: 'Follow-up run distribution', failedPatternsChart: 'Failed task patterns', agentComparisonChart: 'Agent outcome comparison', agentEfficiencyChart: 'Agent quality versus efficiency', agentCategoryChart: 'Selected Agent performance by task category', automationComparisonChart: 'Automation comparison', automationFunnelChart: 'Automation node funnel', automationDurationChart: 'Automation duration by node', automationFailureChart: 'Automation failures by node', automationBottleneckChart: 'Automation bottlenecks by node', skillUsageTrendChart: 'Skill activity over time', skillTopChart: 'Top skills by activity', skillFollowChart: 'Skill selection follow-through', skillAgentChart: 'Agent and skill activity pairs', skillOutcomeChart: 'Observed skill outcomes', skillEffectivenessChart: 'Skill outcomes versus usage', usageRateChart: 'Token usage over time', modelTokenBreakdownChart: 'Model breakdown by tokens', successFailureChart: 'Run results over time', hourlyTrendsChart: 'Runs by hour', avgTimeTaskChart: 'Average run duration by task', agentOutcomeTrendChart: 'Selected Agent run outcomes over time' };
								canvas.setAttribute('role', 'img');
								canvas.setAttribute('aria-label', chartLabels[canvasID] || ({modelTimeChart:'Run time per task by model',modelTokensChart:'Tokens per task by model',modelGoalsTrendChart:'Goal achievement over time',modelMergesTrendChart:'Merged work over time'})[canvasID] || 'Analytics chart');							const old = canvas.parentElement.querySelector('[data-analytics-chart-state]');
							if (old) old.remove();
