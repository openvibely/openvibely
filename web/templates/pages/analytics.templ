								if (previous && (card.kind === 'duration' || card.kind === 'p90')) { const field=card.kind==='p90'?'p90_cycle_time_ms':'median_cycle_time_ms'; const change = Number(current[field] || 0) - Number(previous[field] || 0); delta = (change >= 0 ? '+' : '-') + formatDuration(Math.abs(change)) + '; previous ' + formatDuration(previous[field] || 0) + '; n=' + (previous.cycle_sample_size || 0); }
