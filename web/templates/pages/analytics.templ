							function finishPanelLoading(failed) {
								document.querySelectorAll('[data-analytics-panel-loading]').forEach(function(target){
									target.style.minHeight=target.dataset.analyticsPanelLoading;
									delete target.dataset.analyticsPanelLoading;target.removeAttribute('aria-busy');
