							if (dateTo) params.set('date_to', dateTo);
							const data = await fetchJSON('/api/analytics/agent-usage-by-project?' + params.toString());
							const ctx = renderChartState('agentUsage', 'agentUsageChart', data, 'No model executions in this period');
