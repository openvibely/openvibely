					// Load Most Frequent Tasks
					async function loadMostFrequentTasks() {
						try {
							const { dateFrom, dateTo } = getDateRange();
							const params = analyticsParams({ project_id: projectID, limit: '10' });
							if (dateFrom) params.set('date_from', dateFrom);
							if (dateTo) params.set('date_to', dateTo);
							const data = await fetchJSON('/api/analytics/most-frequent-tasks?' + params.toString());

						const container = document.getElementById('frequentTasksList');
						if (!container) return;
						if (data.length === 0) {
							container.innerHTML = '<p class="text-center opacity-50 py-4">No data available</p>';
							return;
						}

							container.innerHTML = data.map((task, idx) => `
								<div class="flex items-center justify-between gap-3 py-2 border-b border-base-300">
									<div class="flex-1 min-w-0 pr-2">
										<span class="font-mono text-sm opacity-50">${idx + 1}.</span>
										<span class="ml-2 break-words"><a class="link" href="/tasks/${encodeURIComponent(task.TaskID)}?project_id=${encodeURIComponent(projectID)}">${escapeHTML(task.TaskTitle || 'Unknown')}</a></span>
									</div>
									<span class="badge badge-primary shrink-0 inline-flex items-center justify-center whitespace-nowrap h-auto min-h-6 px-3 py-1 leading-none text-center">${task.ExecutionCount || 0} runs</span>
								</div>
							`).join('');						} catch (e) { console.error('loadMostFrequentTasks:', e); showAnalyticsError(e); }
					}

					// Load Failed Task Patterns
					async function loadFailedTaskPatterns() {
						try {
							const { dateFrom, dateTo } = getDateRange();
							const params = analyticsParams({ project_id: projectID, limit: '10' });
							if (dateFrom) params.set('date_from', dateFrom);
							if (dateTo) params.set('date_to', dateTo);
							const data = await fetchJSON('/api/analytics/failed-task-patterns?' + params.toString());

						const tbody = document.querySelector('#failedPatternsTable tbody');
						if (!tbody) return;
						if (data.length === 0) {
							tbody.innerHTML = '<tr><td colspan="4" class="text-center opacity-50">No failed tasks</td></tr>';
							return;
						}

						tbody.innerHTML = data.map(pattern => {
							const lastError = pattern.LastError || 'N/A';
							const truncatedError = lastError.length > 50 ? lastError.substring(0, 50) + '...' : lastError;
							const lastFailedAt = pattern.LastFailedAt ? new Date(pattern.LastFailedAt).toLocaleString() : 'N/A';
							return `
								<tr>
									<td><a class="link" href="/tasks/${encodeURIComponent(pattern.TaskID)}?project_id=${encodeURIComponent(projectID)}">${escapeHTML(pattern.TaskTitle || 'Unknown')}</a></td>
									<td><span class="badge badge-error">${pattern.FailureCount || 0}</span></td>
									<td><span class="text-xs" title="${escapeHTML(lastError)}">${escapeHTML(truncatedError)}</span></td>
									<td class="text-xs opacity-60">${escapeHTML(lastFailedAt)}</td>
								</tr>
							`;
						}).join('');
						} catch (e) { console.error('loadFailedTaskPatterns:', e); showAnalyticsError(e); }
					}

						// Load only the active view. Bounded batches keep database work and chart rendering responsive.
						async function loadAllData(refreshUsage) {
							beginDataGeneration();
							const loadGeneration = dataGeneration;
							document.getElementById('analyticsError').classList.add('hidden');
							const loaders = [loadDashboard];
							if (selectedView === 'outcomes' || selectedView === 'all') loaders.push(loadSuccessFailureRates, loadAvgTimeByTask, loadFailedTaskPatterns);
							if (selectedView === 'agents' || selectedView === 'all') loaders.push(loadAvgTimeByAgent, loadAgentUsage);
							if (selectedView === 'learning' || selectedView === 'all') loaders.push(loadSkillAnalytics);
							if (selectedView === 'usage' || selectedView === 'all') {
								loaders.push(function() { return loadUsageAnalytics(refreshUsage); });
								if (selectedView === 'usage') loaders.push(loadAgentUsage);
							}
							if (selectedView === 'all') loaders.push(loadHourlyTrends, loadMostFrequentTasks);
							for (let index = 0; index < loaders.length; index += 2) {
								if (loadGeneration !== dataGeneration) return;
								await Promise.allSettled(loaders.slice(index, index + 2).map(function(load) { return load(); }));
								if (loadGeneration !== dataGeneration) return;
									await new Promise(function(resolve) { setTimeout(resolve, 0); });							}
						}

						function restoreURLState() {
							const params = new URLSearchParams(window.location.search);
							const range = params.get('range') || '30d';
							const rangeValue = range === 'all' ? 'all' : range.replace(/d$/, '');
							if (Array.from(document.getElementById('dateRange').options).some(function(option) { return option.value === rangeValue; })) document.getElementById('dateRange').value = rangeValue;
							const group = params.get('group_by') || 'day';
							if (['day', 'week', 'month'].includes(group)) document.getElementById('groupBy').value = group;
							document.getElementById('comparePeriod').checked = params.get('compare') !== '0' && range !== 'all';
								selectedAgent = params.get('agent') || '';
								selectedWorkflow = params.get('workflow') || '';
								document.getElementById('analyticsAgentFilter').value = selectedAgent;
								document.getElementById('analyticsWorkflowFilter').value = selectedWorkflow;
								applyView(params.get('view') || 'overview', false);
								restoreAggregateSelectionState();
						}
						document.querySelectorAll('[data-analytics-view]').forEach(function(button) { button.addEventListener('click', function() { applyView(button.dataset.analyticsView, true); loadAllData(false); }, { signal: eventSignal }); });
						document.getElementById('refreshBtn').addEventListener('click', function() { history.replaceState({}, '', analyticsURL(selectedView)); loadAllData(true); }, { signal: eventSignal });
						['dateRange', 'groupBy', 'comparePeriod'].forEach(function(id) { document.getElementById(id).addEventListener('change', function() { if (document.getElementById('dateRange').value === 'all') document.getElementById('comparePeriod').checked = false; history.replaceState({}, '', analyticsURL(selectedView)); loadAllData(false); }, { signal: eventSignal }); });
							document.getElementById('analyticsAgentFilter').addEventListener('change', function() { selectedAgent = document.getElementById('analyticsAgentFilter').value; history.pushState({}, '', analyticsURL(selectedView)); loadAllData(false); }, { signal: eventSignal });
							document.getElementById('analyticsWorkflowFilter').addEventListener('change', function() { selectedWorkflow = document.getElementById('analyticsWorkflowFilter').value; history.pushState({}, '', analyticsURL(selectedView)); loadAllData(false); }, { signal: eventSignal });
							const loadMoreEvidence = document.getElementById('loadMoreEvidence');
							if (loadMoreEvidence) loadMoreEvidence.addEventListener('click', function() { loadDashboard(Number(loadMoreEvidence.dataset.nextOffset || 0), true); }, { signal: eventSignal });
							const usageRateSelect = document.getElementById('usageRateModelSelect');						if (usageRateSelect) usageRateSelect.addEventListener('change', function() { if (latestUsageAnalytics) renderUsageRateChart(latestUsageAnalytics); }, { signal: eventSignal });
							document.addEventListener('click', function(event) {
								const link = event.target.closest && event.target.closest('[data-skill-outcome-evidence]');
								if (!link) return;
								event.preventDefault();
								history.pushState({}, '', link.getAttribute('href'));
								restoreURLState();
								loadAllData(false);
							}, { signal: eventSignal });
							window.addEventListener('popstate', function() { restoreURLState(); loadAllData(false); }, { signal: eventSignal });						restoreURLState();
						loadAllData(false);
				}

				// Share one Chart.js load across HTMX swaps. The generation fence above
				// prevents stale page closures from initializing the current document.
				if (typeof Chart !== 'undefined') {
					setTimeout(initAnalytics, 0);
				} else {
					if (!window._analyticsChartLoader) {
						window._analyticsChartLoader = new Promise(function(resolve, reject) {
							var script = document.querySelector('script[data-analytics-chart-loader]');
							var shouldAppend = false;
							if (!script) {
								script = document.createElement('script');
								script.src = 'https://cdn.jsdelivr.net/npm/chart.js@4.4.1/dist/chart.umd.min.js';
								script.setAttribute('data-analytics-chart-loader', '');
								shouldAppend = true;
							}
							script.addEventListener('load', resolve, { once: true });
							script.addEventListener('error', reject, { once: true });
							if (shouldAppend) document.head.appendChild(script);
						});
					}
					window._analyticsChartLoader.then(initAnalytics).catch(function() {
						if (analyticsGeneration !== window._analyticsGeneration) return;
						var failedLoader = document.querySelector('script[data-analytics-chart-loader]');
						if (failedLoader) failedLoader.remove();
						window._analyticsChartLoader = null;
						var box = document.getElementById('analyticsError');
						if (box) { box.textContent = 'Analytics charts failed to load'; box.classList.remove('hidden'); }
					});
				}
				})();
			</script>
	} else {
		<div class="text-center py-12 opacity-50">
			<p>No projects yet. Create one to view analytics.</p>
		</div>
	}
}
