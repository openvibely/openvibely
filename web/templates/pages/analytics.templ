										return '<tr><td>' + agent + '</td><td><a class="link" data-skill-outcome-evidence href="' + escapeHTML(skillOutcomeEvidenceURL(row, row.agent_id || '__unassigned__')) + '"><code>' + escapeHTML(row.skill_handle) + '</code></a> <span class="badge badge-ghost badge-xs">' + escapeHTML(row.skill_scope || 'unknown') + '</span></td><td>' + row.tasks_evaluated + '</td><td>' + escapeHTML(ratioText(row.technical_completion)) + '</td><td>' + escapeHTML(ratioText(row.goal_achievement)) + '</td><td>' + escapeHTML(ratioText(row.follow_up)) + '</td></tr>';									}).join('') : '<tr><td colspan="6" class="text-center opacity-50">No Agent and skill combinations have outcome evidence in this period</td></tr>';
								}
