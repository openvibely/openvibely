								});
							}
							function showAnalyticsLoading() {
								const panels=selectedView==='models'?[['modelScorecard',0]]:selectedView==='agents'?[['agentFindings',0],['agentPerformanceTable',8],['agentEvidenceTable',6],['agentCategoryTable',5],['agentFailureTable',3],['agentSkillTable',5]]:[];
								panels.forEach(function(entry){
									const target=document.getElementById(entry[0]);if(!target)return;
									const height=Math.max(120,target.getBoundingClientRect().height);
									if(!target.hasAttribute('data-analytics-panel-loading'))target.dataset.analyticsPanelLoading=target.style.minHeight;
									target.setAttribute('aria-busy','true');
									const text=document.createElement('p');text.className='text-center opacity-50 py-12';text.dataset.panelLoadingText='';text.textContent='Loading analytics…';
									if(entry[1]){const row=document.createElement('tr'),cell=document.createElement('td');cell.colSpan=entry[1];cell.style.height=height+'px';cell.appendChild(text);row.appendChild(cell);target.replaceChildren(row);}
									else {target.style.minHeight=height+'px';target.replaceChildren(text);}
								});
								if(selectedView==='usage') {
									document.querySelectorAll('[data-usage-summary-value]').forEach(node=>{node.textContent='Loading analytics…';node.className='text-center opacity-50 font-normal text-base';});
									function loadingText(target){const p=document.createElement('p');p.className='text-center opacity-50 py-12';p.textContent='Loading analytics…';target.replaceChildren(p);}
									const accounts=document.getElementById('accountUsageCards');
									accounts.setAttribute('aria-busy','true');
									accounts.querySelectorAll('.card-body').forEach(body=>{body.style.minHeight=body.getBoundingClientRect().height+'px';loadingText(body);});
									loadingText(document.getElementById('usageFindings'));
								}
								const loadingCharts = {
									overview: { projectOutcomeTrend: 'projectOutcomeTrendChart' },
							outcomes: { cycleDistribution: 'cycleDistributionChart', followupDistribution: 'followupDistributionChart', successFailure: 'successFailureChart', hourlyTrends: 'hourlyTrendsChart', avgTimeTask: 'avgTimeTaskChart', failedPatterns: 'failedPatternsChart' },
							agents: { agentComparison: 'agentComparisonChart', agentEfficiency: 'agentEfficiencyChart', agentOutcomeTrend: 'agentOutcomeTrendChart', agentCategory: 'agentCategoryChart' },
							models: { modelTime: 'modelTimeChart', modelTokens: 'modelTokensChart', modelGoalsTrend: 'modelGoalsTrendChart', modelMergesTrend: 'modelMergesTrendChart' },
							automations: { automationComparison: 'automationComparisonChart', automationFunnel: 'automationFunnelChart', automationDuration: 'automationDurationChart', automationFailure: 'automationFailureChart', automationBottleneck: 'automationBottleneckChart' },
									learning: { skillUsageTrend: 'skillUsageTrendChart', skillTop: 'skillTopChart', skillFollow: 'skillFollowChart', skillAgent: 'skillAgentChart', skillOutcome: 'skillOutcomeChart', skillEffectiveness: 'skillEffectivenessChart' },
									usage: { usageRate: 'usageRateChart', modelTokenBreakdown: 'modelTokenBreakdownChart' }
								};
								Object.entries(loadingCharts[selectedView] || {}).forEach(function(entry) { renderChartState(entry[0], entry[1], [], 'Loading analytics…'); });
							}

							const validViews = ['overview', 'outcomes', 'agents', 'models', 'automations', 'learning', 'usage'];
							const visibleViews = ['usage', 'models', 'learning', 'agents'];						const initialURLParams = new URLSearchParams(window.location.search);
						const savedViewKey = 'openvibely.analytics.lastView.' + projectID;
						let selectedView = 'usage';
								let selectedAgent = initialURLParams.get('agent') || '';
								let selectedWorkflow = initialURLParams.get('workflow') || '';
						function savedAnalyticsView() {
							try {
								const saved = window.localStorage.getItem(savedViewKey);
								return visibleViews.includes(saved) ? saved : '';
							} catch (_) {
								return '';
							}
						}
						function rememberAnalyticsView(view) {
							try { window.localStorage.setItem(savedViewKey, view); } catch (_) {}
						}
						function comparisonEnabled(view) {
							return ['overview','outcomes'].includes(view) && document.getElementById('comparePeriod').checked;
						}
						function analyticsURL(view) {
							const params = new URLSearchParams(window.location.search);
							params.set('project_id', projectID);
							params.set('view', view);
							params.set('range', usageRangeParam());
							params.set('group_by', document.getElementById('groupBy').value);
								params.set('compare', comparisonEnabled(view) ? '1' : '0');
								if (selectedAgent && ['agents','outcomes'].includes(view)) params.set('agent', selectedAgent); else params.delete('agent');
								if (selectedWorkflow && ['overview','automations'].includes(view)) params.set('workflow', selectedWorkflow); else params.delete('workflow');
								params.delete('work_type');
								return '/analytics?' + params.toString();						}
							function analyticsParams(initial) {
								const params = new URLSearchParams(initial || {});
								if (selectedAgent && ['agents','outcomes'].includes(selectedView)) params.set('agent', selectedAgent);
								if (selectedWorkflow && ['overview','automations'].includes(selectedView)) params.set('workflow', selectedWorkflow);
								return params;
							}
								function applyView(view, updateHistory) {
									selectedView = validViews.includes(view) ? view : 'usage';
									rememberAnalyticsView(selectedView);
									document.querySelectorAll('[data-analytics-section]').forEach(function(section) { section.classList.toggle('hidden', section.dataset.analyticsSection !== selectedView); });
									document.querySelectorAll('[data-analytics-view]').forEach(function(button) { button.classList.toggle('btn-primary', button.dataset.analyticsView === selectedView); });
									const agentFilter = document.querySelector('[data-agent-filter]');
									if (agentFilter) agentFilter.classList.toggle('hidden', selectedView !== 'agents');
									const automationFilter = document.querySelector('[data-automation-filter]');
									if (automationFilter) automationFilter.classList.toggle('hidden', !['overview','automations'].includes(selectedView));
									const compareFilter = document.querySelector('[data-compare-filter]');
									if (compareFilter) compareFilter.classList.toggle('hidden', !['overview','outcomes'].includes(selectedView));
									if (updateHistory) history.pushState({}, '', analyticsURL(selectedView));
								}

							function clearEvidenceParams(params) {
								['evidence','model','model_id','category','period','technical_status','cycleDistribution','followupDistribution','execution_hour','skill_period','skill_event','skill_agent','skill_handle','skill_evidence_scope','evidence_skill_handle','evidence_skill_scope','evidence_skill_agent','usage_period','usage_model','usage_provider','usage_model_name'].forEach(function(key) { params.delete(key); });
								return params;
							}
							function skillOutcomeEvidenceURL(row, agentID) {
								const params = clearEvidenceParams(new URLSearchParams(window.location.search));
								params.set('project_id', projectID);
								params.set('view', 'outcomes');
								params.set('evidence', 'skill_outcomes');
								params.set('evidence_skill_handle', row.skill_handle);
								params.set('evidence_skill_scope', row.skill_scope);
								if (agentID) params.set('evidence_skill_agent', agentID); else params.delete('evidence_skill_agent');
								return '/analytics?' + params.toString();
							}
							function showAggregateSelection(view, values, labelID, text) {
							const params = clearEvidenceParams(new URLSearchParams(window.location.search));
							params.set('view', view);
							Object.entries(values).forEach(function(entry) { if (entry[1] !== undefined && entry[1] !== null && entry[1] !== '') params.set(entry[0], String(entry[1])); });
							history.pushState({}, '', '/analytics?' + params.toString());
							applyView(view, false);
							const label = document.getElementById(labelID);
							if (label) { label.textContent = text; label.classList.remove('hidden'); }
						}
						function restoreAggregateSelectionState() {
							const params = new URLSearchParams(window.location.search);
							const skillLabel = document.getElementById('skillEvidenceSelection');
							const usageLabel = document.getElementById('usageEvidenceSelection');
							if (skillLabel) {
								const scope = params.get('skill_evidence_scope');
								const skillText = params.get('skill_handle') ? (params.has('skill_agent') ? (params.get('skill_agent') || 'Unassigned') : 'All Agents') + ' · ' + params.get('skill_handle') + (scope ? ' [' + scope + ']' : '') + (params.get('skill_event') ? ' · ' + params.get('skill_event') : '') : (params.get('skill_event') && params.get('skill_period') ? params.get('skill_event') + ' · ' + params.get('skill_period') : '');
								skillLabel.textContent = skillText ? 'Selected skill activity · ' + skillText : '';
								skillLabel.classList.toggle('hidden', !skillText);
							}
							if (usageLabel) {
									const usageText = params.get('usage_period') ? params.get('usage_period') + ' · ' + (params.get('usage_model') || 'combined') : (params.get('usage_provider') || params.get('usage_model_name') ? (params.get('usage_provider') || 'unknown') + '/' + (params.get('usage_model_name') || 'unknown') : '');								usageLabel.textContent = usageText ? 'Selected token usage · ' + usageText : '';
								usageLabel.classList.toggle('hidden', !usageText);
							}
						}
						function ratioText(value) {
							if (!value || Number(value.denominator || 0) === 0) return 'Unavailable · n=0';
							return formatNumber(value.numerator) + ' / ' + formatNumber(value.denominator) + ' (' + Number(value.percent || 0).toFixed(1) + '%)';
						}
						function cycleBucket(value) { value=Number(value||0); if(value<60000)return '\x3c 1m'; if(value<600000)return '1-10m'; if(value<3600000)return '10-60m'; if(value<86400000)return '1-24h'; return '>= 24h'; }
						function followupBucket(value) { value=Number(value||0); return value>=3?'3+':String(value); }
						function costCoverageText(value) { return value ? formatCost(value.value) + ' across ' + value.covered + ' of ' + value.eligible : 'Unavailable'; }
						function renderOutcomeReadout(current, previous) {
							const target = document.getElementById('outcomeReadout'); if (!target) return;
							if (!current || !current.tasks_evaluated) { target.innerHTML = '\x3cp class="opacity-50">No task outcome evidence in this period.\x3c/p>'; return; }
							const changes = [
								{label:'Run success', key:'technical_completion', lowerBetter:false},
								{label:'Goal achievement', key:'goal_achievement', lowerBetter:false},
								{label:'First-run success', key:'first_pass', lowerBetter:false},
								{label:'Follow-up', key:'follow_up', lowerBetter:true}
							].map(function(item){const now=current[item.key]||{},before=previous?(previous[item.key]||{}):{};return {...item,now:now, before:before, delta:Number(now.percent||0)-Number(before.percent||0)};}).filter(function(item){return item.now.denominator && item.before.denominator;}).sort(function(a,b){return Math.abs(b.delta)-Math.abs(a.delta);});
							const lines = [];
							if (changes.length) { const change=changes[0],better=change.lowerBetter?change.delta<0:change.delta>0; lines.push('\x3cp>\x3cstrong>Largest change:\x3c/strong> '+escapeHTML(change.label)+' '+(change.delta>=0?'+':'')+change.delta.toFixed(1)+' points versus the previous period ('+(better?'better':'worse')+'). Current n='+change.now.denominator+'; previous n='+change.before.denominator+'.\x3c/p>'); }
							else lines.push('\x3cp>No comparable prior-period denominator is available.\x3c/p>');
							const followUp=current.follow_up||{}; if (followUp.denominator) lines.push('\x3cp>\x3cstrong>Current rework:\x3c/strong> '+Number(followUp.percent||0).toFixed(1)+'% of '+followUp.denominator+' eligible tasks had follow-up work.\x3c/p>');
							target.innerHTML=lines.join('');
						}
						function renderDashboard(data) {
							finishPanelLoading(false);
							const current = data.current || {};
							const previous = data.previous || null;
							const definitionList = document.getElementById('analyticsMetricDefinitions');
							if (definitionList) definitionList.innerHTML = (data.definitions || []).map(function(item) { return '\x3cdiv>\x3cdt class="font-semibold">'+escapeHTML(item.label)+'\x3c/dt>\x3cdd class="opacity-70">'+escapeHTML(item.definition)+' \x3cstrong>Denominator:\x3c/strong> '+escapeHTML(item.denominator)+'\x3c/dd>\x3c/div>'; }).join('') || '\x3cp class="opacity-50">Metric definitions unavailable.\x3c/p>';
							const cards = [
								{key:'technical_completion', label:'Run success rate', value:ratioText(current.technical_completion || {}), sample:(current.technical_completion || {}).denominator || 0, sampleUnit:'finished runs', kind:'ratio'},
								{key:'goal_achievement', label:'Goal achievement rate', value:ratioText(current.goal_achievement || {}), sample:(current.goal_achievement || {}).denominator || 0, sampleUnit:'goal-bearing tasks', kind:'ratio'},
								{key:'first_pass', label:'First-run success rate', value:ratioText(current.first_pass || {}), sample:(current.first_pass || {}).denominator || 0, sampleUnit:'tasks with a finished run', kind:'ratio'},
								{key:'follow_up', label:'Follow-up run rate', value:ratioText(current.follow_up || {}), sample:(current.follow_up || {}).denominator || 0, sampleUnit:'tasks with runs', kind:'ratio'},
								{key:'median_cycle_time', label:'Median task duration', value:current.cycle_sample_size ? formatDuration(current.median_cycle_time_ms || 0) : 'Unavailable', sample:current.cycle_sample_size || 0, sampleUnit:'eligible tasks', kind:'duration'},
								{key:'cycle_time_p90', label:'P90 task duration', value:current.cycle_sample_size ? formatDuration(current.p90_cycle_time_ms || 0) : 'Unavailable', sample:current.cycle_sample_size || 0, sampleUnit:'eligible tasks', kind:'p90'},
								{key:'known_cost_per_achieved_goal', label:'Cost per achieved goal', value:costCoverageText(current.known_cost_per_achieved_goal), sample:current.known_cost_per_achieved_goal ? current.known_cost_per_achieved_goal.covered : 0, sampleUnit:'achieved goals with known cost', kind:'cost'},
								{key:'cancelled_executions', label:'Cancelled runs', value:formatNumber(current.cancelled_execution_count || 0) + ' / ' + formatNumber((current.technical_completion || {}).denominator || 0), sample:(current.technical_completion || {}).denominator || 0, sampleUnit:'finished runs', kind:'count'}
							];
								const cardHTML = cards.map(function(card) {
									let delta = '', previousSample = 0;
									if (previous && card.kind === 'ratio' && previous[card.key] && current[card.key] && previous[card.key].denominator && current[card.key].denominator) { const change = Number(current[card.key].percent || 0) - Number(previous[card.key].percent || 0); previousSample=previous[card.key].denominator; delta = (change >= 0 ? '+' : '') + change.toFixed(1) + ' percentage points · previous ' + Number(previous[card.key].percent || 0).toFixed(1) + '%'; }
									if (previous && previous.cycle_sample_size && current.cycle_sample_size && (card.kind === 'duration' || card.kind === 'p90')) { const field=card.kind==='p90'?'p90_cycle_time_ms':'median_cycle_time_ms'; const change = Number(current[field] || 0) - Number(previous[field] || 0); previousSample=previous.cycle_sample_size; delta = (change >= 0 ? '+' : '-') + formatDuration(Math.abs(change)) + ' · previous ' + formatDuration(previous[field] || 0); }
									if (previous && card.kind === 'cost' && previous.known_cost_per_achieved_goal) { previousSample=previous.known_cost_per_achieved_goal.covered||0; delta = 'previous ' + costCoverageText(previous.known_cost_per_achieved_goal); }
									if (previous && card.kind === 'count' && (previous.technical_completion||{}).denominator) { previousSample=previous.technical_completion.denominator; const change=Number(current.cancelled_execution_count||0)-Number(previous.cancelled_execution_count||0); delta=(change>=0?'+':'')+change+' cancelled · previous '+Number(previous.cancelled_execution_count||0); }
									return '\x3cdiv class="card bg-base-100 border border-base-300">\x3cdiv class="card-body p-4">\x3cdiv class="text-sm font-semibold">' + escapeHTML(card.label) + '\x3c/div>\x3cdiv class="text-xl font-bold">' + escapeHTML(card.value) + '\x3c/div>\x3cdiv class="text-xs opacity-60">Current: n=' + card.sample + ' ' + escapeHTML(card.sampleUnit) + '\x3c/div>' + (delta ? '\x3cdiv class="text-xs opacity-60">Compared with previous: ' + escapeHTML(delta) + ' · n=' + previousSample + '\x3c/div>' : '') + '\x3c/div>\x3c/div>';
								}).join('');
								const kpis = document.getElementById('analyticsKpis'); if (kpis) kpis.innerHTML = cardHTML;
								const outcomeSummary = document.getElementById('outcomeSummaryCards'); if (outcomeSummary) outcomeSummary.innerHTML = cardHTML;
								renderOutcomeReadout(current, previous);
								const recent = data.recent_outcomes || [];
								renderProjectOutcomeTrend(data.outcome_trend || []);
								renderOutcomeFunnel('overviewOutcomeFunnel', data.funnel || []);
								renderActionableExceptions(recent);									if (selectedView === 'outcomes') {										const evidenceParams = new URLSearchParams(window.location.search);									const evidenceKey = evidenceParams.get('evidence') || '';
									const selectedSkillOutcome = evidenceParams.get('evidence_skill_handle') ? evidenceParams.get('evidence_skill_handle') + (evidenceParams.get('evidence_skill_scope') ? ' [' + evidenceParams.get('evidence_skill_scope') + ']' : '') + (evidenceParams.get('evidence_skill_agent') ? ' · Agent ' + evidenceParams.get('evidence_skill_agent') : '') : '';
									const evidenceValue = selectedSkillOutcome || evidenceParams.get('model_id') || evidenceParams.get('model') || evidenceParams.get('period') || '';								const evidence = recent.filter(function(row) {
									if (evidenceParams.get('model_id') && !(row.model_config_ids || []).includes(evidenceParams.get('model_id'))) return false;
									if (!evidenceParams.get('model_id') && evidenceParams.get('model') && row.model !== evidenceParams.get('model')) return false;
									if (evidenceParams.get('category') && row.category !== evidenceParams.get('category')) return false;
									const selectedPeriod = evidenceParams.get('period') || '';
									const terminalEvidence = row.terminal_period_statuses || [];
									if (selectedPeriod && evidenceKey === 'technical_status' && !terminalEvidence.includes(selectedPeriod + '|' + evidenceParams.get('technical_status'))) return false;
									if (selectedPeriod && evidenceKey === 'period' && !terminalEvidence.some(function(value) { return value.startsWith(selectedPeriod + '|'); })) return false;
									switch (evidenceKey) {
									case 'technical_completion': return Number(row.period_completed_count || 0) > 0;
									case 'technical_completed': return row.created_in_period === true && row.funnel_technical_completed === true;
									case 'technical_status': return Number(row['period_' + evidenceParams.get('technical_status') + '_count'] || 0) > 0;
									case 'goal_achievement': return row.goal_achievement_eligible === true && row.goal_achieved_in_period === true;
									case 'goal_achieved': return row.created_in_period === true && row.funnel_goal_eligible === true && row.funnel_goal_achieved === true;
									case 'first_pass': return row.first_pass_eligible === true && row.first_pass_completed === true;
									case 'follow_up': return row.started_in_period === true && Number(row.follow_up_count || 0) > 0;
									case 'cancelled_executions': return Number(row.period_cancelled_count || 0) > 0;
									case 'known_cost_per_achieved_goal': return row.known_cost_eligible === true;
									case 'median_cycle_time': case 'cycle_time_p90': return row.cycle_eligible === true;
									case 'sample_size': return row.started_in_period === true;
									case 'execution_hour': return (row.execution_hours || []).includes(Number(evidenceParams.get('execution_hour')));
									case 'created': return row.created_in_period === true;
									case 'started': return row.created_in_period === true && row.started_in_period === true;
									case 'merged': return row.funnel_merge_eligible === true && row.funnel_merged === true;
									case 'cycleDistribution': return row.cycle_eligible === true && cycleBucket(row.cycle_time_ms || 0) === evidenceParams.get('cycleDistribution');
									case 'followupDistribution': return row.started_in_period === true && followupBucket(row.follow_up_count || 0) === evidenceParams.get('followupDistribution');
									default: return true;
									}
								});
									const evidenceLabel = document.getElementById('outcomeEvidenceFilter');
									const evidenceTotal = Number(data.evidence_total || recent.length);
									const coverage = 'loaded ' + recent.length + ' of ' + evidenceTotal + ' project-scoped tasks';
									if (evidenceLabel) evidenceLabel.textContent = evidenceKey || evidenceValue ? 'Filtered supporting tasks: ' + (evidenceKey || 'selection') + (evidenceValue ? ' · ' + evidenceValue : '') + ' · matching loaded rows n=' + evidence.length + ' · ' + coverage : 'Task evidence · ' + coverage;
									const loadMore = document.getElementById('loadMoreEvidence');
									if (loadMore) { loadMore.classList.toggle('hidden', recent.length >= evidenceTotal); loadMore.disabled = evidencePageLoading; loadMore.textContent = 'Load more evidence (' + recent.length + ' of ' + evidenceTotal + ')'; loadMore.dataset.nextOffset = String(recent.length); }
									const evidenceTechnicalResult = function(row) {
										if (evidenceKey === 'skill_outcomes') {
											const completed = Number(row.period_completed_count || 0);
											const failed = Number(row.period_failed_count || 0);
											const cancelled = Number(row.period_cancelled_count || 0);
											const counts = completed + ' completed, ' + failed + ' failed, ' + cancelled + ' cancelled';
											if (completed > 0) return 'Completed (numerator; ' + counts + ')';
											if (failed + cancelled > 0) return 'Not completed (denominator only; ' + counts + ')';
										return 'Excluded from run-success rate (no finished run)';
										}
									if (evidenceKey === 'technical_completion' || evidenceKey === 'technical_completed') return 'completed (' + Number(row.period_completed_count || 0) + ' runs)';
									if (evidenceKey === 'technical_status') { const status=evidenceParams.get('technical_status') || ''; return status + ' (' + Number(row['period_' + status + '_count'] || 0) + ' runs)'; }
										return row.technical_result;
									};
									const evidenceGoalResult = function(row) {
										if (evidenceKey !== 'skill_outcomes') return row.goal_result || 'Not goal-bearing';
										if (row.goal_achievement_eligible !== true) return 'Excluded from goal denominator';
										if (row.goal_achieved_in_period === true) return 'Achieved (numerator)';
										return 'Not achieved (denominator only)';
									};
									document.getElementById('outcomeEvidenceTable').innerHTML = evidence.length ? evidence.map(function(row) {
										const taskURL = '/tasks/' + encodeURIComponent(row.task_id) + '?project_id=' + encodeURIComponent(projectID);
										return '\x3ctr>\x3ctd>\x3ca class="link" href="' + taskURL + '">' + escapeHTML(row.task_title) + '\x3c/a>\x3c/td>\x3ctd>' + escapeHTML(evidenceTechnicalResult(row)) + '\x3c/td>\x3ctd>' + escapeHTML(evidenceGoalResult(row)) + '\x3c/td>\x3ctd>' + escapeHTML(row.agent_name) + '\x3c/td>\x3ctd>' + escapeHTML(row.model) + '\x3c/td>\x3ctd>' + row.execution_count + '\x3c/td>\x3ctd>' + row.follow_up_count + '\x3c/td>\x3ctd>' + escapeHTML(row.cycle_eligible ? formatDuration(row.cycle_time_ms || 0) : 'Unavailable') + '\x3c/td>\x3ctd>' + escapeHTML(row.known_cost_usd == null ? 'Unavailable' : formatCost(row.known_cost_usd)) + '\x3c/td>\x3c/tr>';								}).join('') : '\x3ctr>\x3ctd colspan="9" class="text-center opacity-50">No task outcomes in this period\x3c/td>\x3c/tr>';							renderOutcomeFunnel('outcomeFunnel', data.funnel || []);
								renderDistributionChart('cycleDistribution', 'cycleDistributionChart', data.cycle_distribution || []);
								renderDistributionChart('followupDistribution', 'followupDistributionChart', data.follow_up_distribution || []);
									}
									renderDashboardFilterOptions(data.agents || [], data.workflows || []);
									if (selectedView === 'agents') {
										renderAgentPerformance(data.agents || []);
										renderAgentComparison(data.agents || []);
										renderAgentDetail(data.agent_detail || null);
									}
									if (selectedView === 'models') {
										renderModelPerformance(data.models || []);
									}
									if (selectedView === 'learning') {
										renderSkillOutcomes(data.skill_outcomes || []);
										renderSkillOutcomeCharts(data.skill_outcomes || []);
										renderAgentSkillOutcomes(data.agent_skill_outcomes || []);
									}
									if (selectedView === 'usage') {
										// Usage cards are populated only by the usage response, not the dashboard response.
									}
									if (selectedView === 'automations') {
										renderWorkflowPerformance(data.workflows || []);
										renderWorkflowDetail(data.workflow_detail || null);
									}
									renderInsights(data.insights || []);							}
							function renderOutcomeFunnel(targetID, stages) {
								const target = document.getElementById(targetID); if (!target) return;
								const max = Math.max(1, ...stages.map(function(stage){ return Number(stage.denominator || stage.count || 0); }));
								target.innerHTML = stages.length ? stages.map(function(stage) { const width=Math.max(18,Number(stage.count||0)*100/max); return '\x3cdiv class="flex-1 card bg-base-200 border border-transparent">\x3cdiv class="card-body p-3">\x3cspan class="text-sm">'+escapeHTML(stage.label)+'\x3c/span>\x3cdiv class="h-3 bg-base-300 rounded">\x3cdiv class="h-3 bg-primary rounded" style="width:'+width.toFixed(1)+'%">\x3c/div>\x3c/div>\x3cstrong>'+stage.count+'\x3c/strong>\x3cspan class="text-xs opacity-60">eligible n='+stage.denominator+'\x3c/span>\x3c/div>\x3c/div>'; }).join('') : '\x3cp class="opacity-50">No funnel evidence in this period.\x3c/p>';
							}
							function renderProjectOutcomeTrend(rows) {
								const canvas=renderChartState('projectOutcomeTrend','projectOutcomeTrendChart',rows,'No grouped outcome evidence in this period'); if(!canvas)return;
								const series=function(key){return rows.map(function(row){return Number((row[key]||{}).percent||0);});};
								const tooltipFooter=function(items){if(!items.length)return '';const row=rows[items[0].dataIndex],key=['technical_completion','goal_achievement','first_pass','follow_up'][items[0].datasetIndex],metric=row[key]||{};return 'sample n='+Number(metric.denominator||0);};
								charts.projectOutcomeTrend=new Chart(canvas.getContext('2d'),{
									type:'line',
									data:{labels:rows.map(r=>r.period),datasets:[{label:'Run success',data:series('technical_completion'),borderColor:'#22c55e'},{label:'Goal achievement',data:series('goal_achievement'),borderColor:'#3b82f6'},{label:'First-run success',data:series('first_pass'),borderColor:'#8b5cf6'},{label:'Follow-up runs',data:series('follow_up'),borderColor:'#f59e0b'}]},
									options:{responsive:true,maintainAspectRatio:false,scales:{y:{beginAtZero:true,max:100,title:{display:true,text:'Percent'}}},plugins:{tooltip:{callbacks:{footer:tooltipFooter}}}}
								});
							}
							function renderActionableExceptions(rows) {
								const target=document.getElementById('actionableExceptions'); if(!target)return;
								const ranked=rows.map(function(row){const reasons=[];let score=0;if(Number(row.period_failed_count||0)>0){score+=6+Number(row.period_failed_count);reasons.push(row.period_failed_count+' failed run(s)');}if(Number(row.follow_up_count||0)>1){score+=Number(row.follow_up_count);reasons.push(row.follow_up_count+' follow-up runs');}if(Number(row.cycle_time_ms||0)>=86400000){score+=2;reasons.push('task duration '+formatDuration(row.cycle_time_ms));}if(Number(row.known_cost_usd||0)>0){score+=1;reasons.push(formatCost(row.known_cost_usd)+' known cost');}return {row:row,reasons:reasons,score:score};}).filter(x=>x.score>0).sort((a,b)=>b.score-a.score).slice(0,5);
								target.innerHTML=ranked.length?ranked.map(function(item){const row=item.row,url='/tasks/'+encodeURIComponent(row.task_id)+'?project_id='+encodeURIComponent(projectID);return '\x3ca class="block py-2 border-b border-base-300 link" href="'+url+'">\x3cstrong>'+escapeHTML(row.task_title)+'\x3c/strong>\x3cbr>\x3cspan class="text-sm">'+escapeHTML(item.reasons.join(' · '))+'\x3c/span>\x3c/a>';}).join(''):'\x3cp class="opacity-50">No actionable exceptions meet the current thresholds.\x3c/p>';
							}
							function renderAgentComparison(rows) {
								const supported=rows.filter(r=>Number(r.tasks_evaluated||0)>=3); let canvas=renderChartState('agentComparison','agentComparisonChart',supported,'At least three task samples per Agent are required');
								if(canvas)charts.agentComparison=new Chart(canvas.getContext('2d'),{type:'bar',data:{labels:supported.map(r=>r.agent_name),datasets:[{label:'Goal achievement',data:supported.map(r=>Number((r.goal_achievement||{}).percent||0)),backgroundColor:'#3b82f6'},{label:'First-run success',data:supported.map(r=>Number((r.first_pass||{}).percent||0)),backgroundColor:'#8b5cf6'},{label:'Follow-up runs',data:supported.map(r=>Number((r.follow_up||{}).percent||0)),backgroundColor:'#f59e0b'}]},options:{indexAxis:'y',responsive:true,maintainAspectRatio:false,scales:{x:{beginAtZero:true,max:100}},plugins:{tooltip:{callbacks:{footer:function(items){return items.length?'sample n='+supported[items[0].dataIndex].tasks_evaluated:'';}}}}}});
								const efficiency=supported.filter(r=>Number(r.duration_sample_size||0)>=3); canvas=renderChartState('agentEfficiency','agentEfficiencyChart',efficiency,'At least three duration samples per Agent are required');
								if(canvas)charts.agentEfficiency=new Chart(canvas.getContext('2d'),{type:'bubble',data:{datasets:efficiency.map(function(r,i){return {label:r.agent_name,data:[{x:Number(r.median_duration_ms||0)/60000,y:Number((r.goal_achievement||{}).percent||0),r:Math.min(20,5+Math.sqrt(r.tasks_evaluated||0)*2)}],backgroundColor:'hsla('+(i*67%360)+',70%,55%,.65)'};})},options:{responsive:true,maintainAspectRatio:false,scales:{x:{title:{display:true,text:'Median duration (minutes)'}},y:{beginAtZero:true,max:100,title:{display:true,text:'Goal achievement (%)'}}}}});
								const comparable=supported.filter(r=>Number((r.first_pass||{}).denominator||0)>=3).sort((a,b)=>Number((b.first_pass||{}).percent||0)-Number((a.first_pass||{}).percent||0));const findings=document.getElementById('agentFindings');if(findings){if(!comparable.length)findings.innerHTML='\x3cp class="opacity-50">At least three first-run-eligible tasks per Agent are required.\x3c/p>';else{const best=comparable[0],lowest=comparable[comparable.length-1],lines=['\x3cp>\x3cstrong>Strongest first-run success:\x3c/strong> '+escapeHTML(best.agent_name)+' at '+Number((best.first_pass||{}).percent||0).toFixed(1)+'% (n='+(best.first_pass||{}).denominator+').\x3c/p>'];if(lowest.agent_id!==best.agent_id)lines.push('\x3cp>\x3cstrong>Needs inspection:\x3c/strong> '+escapeHTML(lowest.agent_name)+' at '+Number((lowest.first_pass||{}).percent||0).toFixed(1)+'% first-run success and '+Number((lowest.follow_up||{}).percent||0).toFixed(1)+'% follow-up runs.\x3c/p>');findings.innerHTML=lines.join('');}}
							}
							function renderSkillOutcomeCharts(rows) {
								const chartRows=rows.slice().sort((a,b)=>Number(b.tasks_evaluated||0)-Number(a.tasks_evaluated||0)).slice(0,12);
								let canvas=renderChartState('skillOutcome','skillOutcomeChart',chartRows,'No skill outcome samples in this period');if(canvas){canvas.parentElement.style.height=Math.max(288,chartRows.length*42+80)+'px';charts.skillOutcome=new Chart(canvas.getContext('2d'),{type:'bar',data:{labels:chartRows.map(r=>r.skill_handle),datasets:[{label:'Goal achievement',data:chartRows.map(r=>(r.goal_achievement||{}).denominator?Number(r.goal_achievement.percent||0):null),backgroundColor:'#3b82f6'},{label:'Run success',data:chartRows.map(r=>(r.technical_completion||{}).denominator?Number(r.technical_completion.percent||0):null),backgroundColor:'#22c55e'},{label:'Follow-up runs',data:chartRows.map(r=>(r.follow_up||{}).denominator?Number(r.follow_up.percent||0):null),backgroundColor:'#f59e0b'}]},options:{indexAxis:'y',responsive:true,maintainAspectRatio:false,plugins:{tooltip:{callbacks:{title:function(items){return items.length?chartRows[items[0].dataIndex].skill_handle:'';}}}},scales:{x:{beginAtZero:true,max:100},y:{ticks:{callback:function(value,index){const label=chartRows[index].skill_handle;return label.length>32?label.slice(0,29)+'…':label;}}}}}});}
								const supported=rows.filter(r=>Number(r.tasks_evaluated||0)>=2&&Number((r.goal_achievement||{}).denominator||0)>0).sort((a,b)=>Number(b.tasks_evaluated||0)-Number(a.tasks_evaluated||0)).slice(0,20);canvas=renderChartState('skillEffectiveness','skillEffectivenessChart',supported,'At least two task samples with goal evidence per skill are required');if(canvas){const points=supported.map((r,i)=>({x:r.tasks_evaluated,y:Number((r.goal_achievement||{}).percent||0),skill:r.skill_handle,color:'hsla('+(i*61%360)+',70%,55%,.75)'}));charts.skillEffectiveness=new Chart(canvas.getContext('2d'),{type:'scatter',data:{datasets:[{label:'Skills',data:points,pointRadius:7,pointHoverRadius:9,pointBackgroundColor:points.map(p=>p.color),clip:false}]},options:{responsive:true,maintainAspectRatio:false,layout:{padding:{top:12,right:10}},plugins:{legend:{display:false},tooltip:{callbacks:{label:function(context){const point=context.raw;return point.skill+': '+point.x+' tasks, '+point.y.toFixed(1)+'% goal achievement';}}}},scales:{x:{beginAtZero:true,grace:'5%',title:{display:true,text:'Tasks using skill'}},y:{beginAtZero:true,max:100,title:{display:true,text:'Observed goal achievement (%)'}}}}});}
								const comparable=supported.filter(r=>Number((r.goal_achievement||{}).denominator||0)>=2).sort((a,b)=>Number((b.goal_achievement||{}).percent||0)-Number((a.goal_achievement||{}).percent||0));const rec=document.getElementById('skillRecommendations');if(rec){if(!comparable.length)rec.innerHTML='\x3cp class="opacity-50">At least two goal-eligible tasks per skill are required.\x3c/p>';else{const strongest=comparable[0],weakest=comparable[comparable.length-1],lines=['\x3cp>\x3cstrong>Strongest observed association:\x3c/strong> '+escapeHTML(strongest.skill_handle)+' had '+Number((strongest.goal_achievement||{}).percent||0).toFixed(1)+'% goal achievement (n='+(strongest.goal_achievement||{}).denominator+').\x3c/p>'];if(weakest.skill_handle!==strongest.skill_handle||weakest.skill_scope!==strongest.skill_scope)lines.push('\x3cp>\x3cstrong>Weakest observed association:\x3c/strong> '+escapeHTML(weakest.skill_handle)+' had '+Number((weakest.goal_achievement||{}).percent||0).toFixed(1)+'% goal achievement (n='+(weakest.goal_achievement||{}).denominator+').\x3c/p>');rec.innerHTML=lines.join('');}}
							}
							function modelConfigLabel(row) {
								return row.config_name || row.model || 'Unknown configuration';
							}
							function modelDetailLabel(row) {
								return [row.provider, row.model, row.reasoning_effort ? row.reasoning_effort + ' reasoning' : ''].filter(Boolean).join(' · ');
							}
							function setupModelHelp() {
								const root=document.getElementById('analytics-models'),tip=document.getElementById('modelMetricHelp');
								let active=null,pinned=false;
								function close() {
									if(active){active.removeAttribute('aria-describedby');active.setAttribute('aria-expanded','false');}
									active=null;pinned=false;if(tip.matches(':popover-open'))tip.hidePopover();
								}
								function show(button,pin) {
									if(active!==button)close();active=button;pinned=pinned||pin;
									tip.textContent=button.dataset.modelHelp;button.setAttribute('aria-describedby',tip.id);button.setAttribute('aria-expanded','true');
									if(!tip.matches(':popover-open'))tip.showPopover();
									const r=button.getBoundingClientRect(),box=tip.getBoundingClientRect();
									tip.style.left=Math.max(8,Math.min(r.left,window.innerWidth-box.width-8))+'px';
									tip.style.top=Math.max(8,r.bottom+box.height+8<=window.innerHeight?r.bottom:r.top-box.height)+'px';
								}
								root.addEventListener('pointerover',function(e){const b=e.target.closest('[data-model-help]');if(b&&!pinned)show(b,false);},{signal:eventSignal});
								root.addEventListener('pointerout',function(e){if(!pinned&&active&&!active.contains(e.relatedTarget)&&!tip.contains(e.relatedTarget))close();},{signal:eventSignal});
								root.addEventListener('focusin',function(e){const b=e.target.closest('[data-model-help]');if(b)show(b,false);},{signal:eventSignal});
								root.addEventListener('focusout',function(e){if(active===e.target)close();},{signal:eventSignal});
								root.addEventListener('click',function(e){const b=e.target.closest('[data-model-help]');if(!b)return;if(active===b&&pinned)close();else show(b,true);},{signal:eventSignal});
								document.addEventListener('keydown',function(e){if(e.key==='Escape')close();},{signal:eventSignal});
								document.addEventListener('click',function(e){if(active&&!active.contains(e.target)&&!tip.contains(e.target))close();},{signal:eventSignal});
								tip.addEventListener('toggle',function(){if(!tip.matches(':popover-open'))close();},{signal:eventSignal});
								window.addEventListener('resize',close,{signal:eventSignal});
								document.addEventListener('scroll',function(e){if(e.target!==tip)close();},{capture:true,signal:eventSignal});
								eventSignal.addEventListener('abort',close,{once:true});
							}
							function renderModelCharts(rows) {
								const models=rows.filter(r=>!r.mixed_models).sort((a,b)=>Number(b.tasks_used||0)-Number(a.tasks_used||0)||modelConfigLabel(a).localeCompare(modelConfigLabel(b)));
								const palette=['#60a5fa','#34d399','#c084fc','#fb923c','#22d3ee','#f472b6'];
								const compact=n=>new Intl.NumberFormat(undefined,{notation:'compact',maximumFractionDigits:1}).format(n);
								function bar(key,id,supported,number,format,sample,axis) {
									const existing=document.getElementById(id);if(existing)existing.parentElement.style.minWidth='';
									const canvas=renderChartState(key,id,supported,'No recorded task samples in this period');if(!canvas)return;
									canvas.closest('.card').style.minWidth='0';
									const plot=canvas.parentElement;
									if(!plot.parentElement.hasAttribute('data-model-chart-scroll')) {
										const scroll=document.createElement('div');scroll.className='overflow-x-auto';scroll.setAttribute('data-model-chart-scroll','');
										plot.parentElement.insertBefore(scroll,plot);scroll.appendChild(plot);
									}
									plot.style.minWidth=Math.max(320,supported.length*100)+'px';
									charts[key]=new Chart(canvas.getContext('2d'),{
										type:'bar',data:{labels:supported.map(r=>{const label=modelConfigLabel(r);return label.length>24?label.slice(0,21)+'…':label;}),datasets:[{data:supported.map(number),backgroundColor:'#60a5fa',maxBarThickness:48}]},
										plugins:[{id:'modelValues',afterDatasetsDraw:function(chart){
											const ctx=chart.ctx;ctx.save();ctx.fillStyle='#9ca3af';ctx.font='12px sans-serif';ctx.textAlign='center';ctx.textBaseline='bottom';
											chart.getDatasetMeta(0).data.forEach((bar,i)=>ctx.fillText(format(number(supported[i])),bar.x,bar.y-6));ctx.restore();
										}}],
										options:{responsive:true,maintainAspectRatio:false,layout:{padding:{top:24}},plugins:{legend:{display:false},tooltip:{callbacks:{title:items=>items.length?modelConfigLabel(supported[items[0].dataIndex])+' · '+modelDetailLabel(supported[items[0].dataIndex]):'',label:item=>format(number(supported[item.dataIndex]))+' · n='+sample(supported[item.dataIndex])}}},scales:{x:{ticks:{autoSkip:false,maxRotation:45,minRotation:0}},y:{beginAtZero:true,grace:'15%',title:{display:true,text:axis},ticks:{callback:format}}}}
									});
								}
								bar('modelTime','modelTimeChart',models.filter(r=>r.duration_sample_size>0),r=>Number(r.median_duration_ms||0),formatDuration,r=>r.duration_sample_size,'Run time per task');
								bar('modelTokens','modelTokensChart',models.filter(r=>r.token_covered_tasks>0),r=>Number(r.total_tokens||0)/r.token_covered_tasks,compact,r=>r.token_covered_tasks,'Recorded tokens / task');
								const busiest=models.slice(0,6),periods=Array.from(new Set(busiest.flatMap(r=>(r.outcome_trend||[]).map(p=>p.period)))).sort();
								function trend(key,id,metric) {
									const supported=busiest.filter(r=>(r.outcome_trend||[]).some(p=>p[metric]&&p[metric].denominator>0));
									const canvas=renderChartState(key,id,supported,'No outcome evidence in this period');if(!canvas)return;
									const datasets=supported.map(function(r){
										const points=new Map((r.outcome_trend||[]).map(p=>[p.period,p[metric]]));
										return {label:modelConfigLabel(r),data:periods.map(p=>{const m=points.get(p);return m&&m.denominator>0?m.percent:null;}),borderColor:palette[busiest.indexOf(r)],backgroundColor:palette[busiest.indexOf(r)],pointRadius:4,pointHoverRadius:6,clip:false,spanGaps:false};
									});
									charts[key]=new Chart(canvas.getContext('2d'),{type:'line',data:{labels:periods,datasets:datasets},options:{responsive:true,maintainAspectRatio:false,layout:{padding:{top:10,right:10}},plugins:{legend:{position:'bottom',labels:{boxWidth:12}},tooltip:{callbacks:{label:function(item){const r=supported[item.datasetIndex],p=r.outcome_trend.find(p=>p.period===periods[item.dataIndex]),m=p[metric];return modelConfigLabel(r)+': '+Number(m.percent).toFixed(1)+'% · '+m.numerator+'/'+m.denominator+' tasks';}}}},scales:{y:{beginAtZero:true,max:100,ticks:{callback:v=>v+'%'}},x:{title:{display:true,text:'Task finish period'},ticks:{maxTicksLimit:8}}}}});
								}
								trend('modelGoalsTrend','modelGoalsTrendChart','goal_achievement');
								trend('modelMergesTrend','modelMergesTrendChart','merge_completion');
							}
							function renderModelPerformance(rows) {
								renderModelCharts(rows);
								const ordered=rows.slice().sort((a,b)=>Number(!!a.mixed_models)-Number(!!b.mixed_models)||Number(b.tasks_used||0)-Number(a.tasks_used||0)||modelConfigLabel(a).localeCompare(modelConfigLabel(b)));
								function value(main,sample,tone) {
									const color=main==='Unavailable'?'bg-base-200/40':(tone||'bg-primary/10');
									return '\x3ctd class="'+color+'">\x3cstrong class="text-lg tabular-nums whitespace-nowrap">'+escapeHTML(main)+'\x3c/strong>\x3cdiv class="text-xs opacity-60">'+escapeHTML(sample)+'\x3c/div>\x3c/td>';
								}
								function outcome(metric) {
									metric=metric||{};
									const n=Number(metric.denominator||0),percent=Number(metric.percent||0);
									const tone=percent>=80?'bg-success/10':(percent>=50?'bg-warning/10':'bg-error/10');
									return n?value(percent.toFixed(1)+'%',Number(metric.numerator||0)+' / '+n+' tasks',tone):value('Unavailable','n=0');
								}
								const headings=[
									['Model / reasoning','Saved model configuration. Tasks that used more than one configuration appear separately under Mixed models.'],
									['Goal achieved','Tasks whose current goal is marked achieved / tasks with a non-cleared goal. An unmet or changed goal is not necessarily a model failure. Tasks without goals are excluded.'],
									['Merged','Tasks with work merged into the target branch / tasks with a worktree or merge status. Goal achievement does not imply delivery; merging does not imply the goal was evaluated.'],
									['Run time / task','Median total duration of finished runs started in the selected period, per task. Includes scheduled tasks. Excludes waiting between runs and unfinished runs; not time to merge.'],
									['Tokens / task','Average recorded tokens per task within the selected period, including unsuccessful work. Only tasks with recorded usage are included; older records may be incomplete.'],
									['Cost / task','Average recorded cost per task within the selected period, including unsuccessful work. Only tasks with recorded cost are included; partial cost records may understate total cost.'],
									['Follow-ups / task','Average number of runs marked as follow-ups per task. Additional effort can mean clarification, changed goals, or corrections—not necessarily model failure.']
								];
								const target=document.getElementById('modelScorecard');if(!target)return;
								target.innerHTML=ordered.length?'\x3ctable class="table table-sm">\x3cthead>\x3ctr>'+headings.map(h=>'\x3cth scope="col">'+escapeHTML(h[0])+' \x3cbutton type="button" class="btn btn-ghost btn-circle btn-xs" data-model-help="'+escapeHTML(h[1])+'" aria-label="'+escapeHTML(h[1])+'">ⓘ\x3c/button>\x3c/th>').join('')+'\x3c/tr>\x3c/thead>\x3ctbody>'+ordered.map(function(r){
									const tokens=Number(r.token_covered_tasks||0),costs=Number(r.cost_covered_tasks||0),tasks=Number(r.tasks_used||0);
									const label=r.mixed_models?'Multiple configurations':modelDetailLabel(r);
									return '\x3ctr'+(r.mixed_models?' class="border-t-2 border-base-300"':'')+'>\x3cth scope="row" class="font-normal whitespace-normal">\x3cstrong>'+escapeHTML(modelConfigLabel(r))+'\x3c/strong>\x3cdiv class="text-xs opacity-60">'+escapeHTML(label)+'\x3c/div>\x3cdiv class="text-xs opacity-60">'+tasks+' tasks\x3c/div>\x3c/th>'+
										outcome(r.goal_achievement)+outcome(r.merge_completion)+
										(Number(r.duration_sample_size||0)>0?value(formatDuration(r.median_duration_ms||0),'Median · n='+r.duration_sample_size):value('Unavailable','n=0'))+
										(tokens?value(formatNumber(Math.round(Number(r.total_tokens||0)/tokens)),'Recorded · n='+tokens):value('Unavailable','n=0'))+
										(costs&&r.known_cost_usd!=null?value(formatCost(Number(r.known_cost_usd)/costs),'Recorded · n='+costs):value('Unavailable','n=0'))+
										(tasks?value(Number(r.average_follow_ups||0).toFixed(1),'Average · n='+tasks):value('Unavailable','n=0'))+'\x3c/tr>';
								}).join('')+'\x3c/tbody>\x3c/table>':'\x3cp class="opacity-50">No finished tasks in this period.\x3c/p>';
							}

							function renderUsageSummary(totals) {
								const usageContext = document.getElementById('usageSummary');
								if (!usageContext) return;
								const inputTokens = totals && totals.input_tokens ? Number(totals.input_tokens) : 0;
								const cachedTokens = totals && totals.cached_input_tokens ? Number(totals.cached_input_tokens) : 0;
								const cacheText = inputTokens > 0 ? (cachedTokens * 100 / inputTokens).toFixed(1) + '%' : 'Unavailable';
