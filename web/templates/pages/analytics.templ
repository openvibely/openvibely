						function renderInsights(rows) { ['improvement', 'attention'].forEach(function(kind) { const target=document.getElementById(kind === 'improvement' ? 'analyticsImprovements' : 'analyticsAttention'); const items=rows.filter(function(row){return row.kind===kind;}).slice(0,3); target.innerHTML=items.length?items.map(function(row){const params=clearEvidenceParams(new URLSearchParams(window.location.search));params.set('view',row.evidence_view||'outcomes');params.set('evidence',row.metric_key);if(row.evidence_id&&row.metric_key==='workflow_blocked')params.set('workflow',row.evidence_id);return '\x3ca class="block link" href="/analytics?'+escapeHTML(params.toString())+'">\x3cstrong>'+escapeHTML(row.title)+'\x3c/strong>\x3cbr>\x3cspan>'+escapeHTML(row.detail)+' n='+row.sample_size+' · '+escapeHTML(row.comparison_window)+'\x3c/span>\x3c/a>';}).join(''):'\x3cp class="opacity-50">Not enough prior-period evidence for a reliable comparison. Current-period results are shown above.\x3c/p>'; }); }

							async function loadDashboard(offset, appendEvidence) {
								if (appendEvidence && (evidencePageLoading || !latestDashboard)) return;
								const requestGeneration = dataGeneration;
								const evidenceRequest = ++evidenceRequestGeneration;
								const evidenceOffset = Number(offset || 0);
								const baseDashboard = latestDashboard;
								const loadMore = document.getElementById('loadMoreEvidence');
								if (appendEvidence) {
									evidencePageLoading = true;
									if (loadMore) { loadMore.disabled = true; loadMore.setAttribute('aria-busy', 'true'); }
								}
									const params = analyticsParams({ project_id: projectID, view: selectedView, range: usageRangeParam(), group_by: document.getElementById('groupBy').value, compare: comparisonEnabled(selectedView) ? '1' : '0', evidence_limit: '20', evidence_offset: String(evidenceOffset) });
								const selectedEvidence = new URLSearchParams(window.location.search);
								['evidence_skill_handle', 'evidence_skill_scope', 'evidence_skill_agent'].forEach(function(key) {
									if (selectedEvidence.has(key)) params.set(key, selectedEvidence.get(key));
								});
								try {
									const data = await fetchJSON('/api/analytics/dashboard?' + params.toString());
									if (requestGeneration !== dataGeneration || evidenceRequest !== evidenceRequestGeneration) return;
									if (appendEvidence && baseDashboard && latestDashboard === baseDashboard) {
										data.recent_outcomes = (baseDashboard.recent_outcomes || []).concat(data.recent_outcomes || []);
										data.evidence_offset = 0;
									}
									latestDashboard = data;
									renderDashboard(latestDashboard);
								} catch (error) { showAnalyticsError(error); }
								finally {
									if (appendEvidence && requestGeneration === dataGeneration && evidenceRequest === evidenceRequestGeneration) {
										evidencePageLoading = false;
										if (loadMore) { loadMore.disabled = false; loadMore.removeAttribute('aria-busy'); }
									}
								}
							}						function formatNumber(value) {
							return new Intl.NumberFormat().format(value || 0);
						}

						function formatCost(value) {
							if (value === null || value === undefined) return 'cost unavailable';
							return '$' + Number(value).toFixed(4);
						}

						function formatResetCountdown(value) {
							if (!value) return '';
							const resetAt = new Date(value);
							if (Number.isNaN(resetAt.getTime())) return '';
							const remainingMilliseconds = resetAt.getTime() - Date.now();
							if (remainingMilliseconds <= 0) return 'Reset due';
							const totalMinutes = Math.ceil(remainingMilliseconds / 60000);
							const days = Math.floor(totalMinutes / 1440);
							const hours = Math.floor((totalMinutes % 1440) / 60);
							const minutes = totalMinutes % 60;
							const parts = [];
							if (days > 0) parts.push(days + ' ' + (days === 1 ? 'day' : 'days'));
							if (hours > 0) parts.push(hours + ' ' + (hours === 1 ? 'hour' : 'hours'));
							if (minutes > 0 || parts.length === 0) parts.push(minutes + ' ' + (minutes === 1 ? 'minute' : 'minutes'));
							return 'Resets: ' + parts.join(', ');
						}


								function usageModelKey(row) {
									return JSON.stringify([row.provider || 'unknown', row.model || 'unknown']);
								}

								function usageModelParts(rowOrKey) {
									if (typeof rowOrKey !== 'string') return [rowOrKey.provider || 'unknown', rowOrKey.model || 'unknown'];
									try {
										const parts = JSON.parse(rowOrKey);
										if (Array.isArray(parts) && parts.length >= 2) return [parts[0] || 'unknown', parts[1] || 'unknown'];
									} catch (e) {}
									const fallback = rowOrKey.split('/');
									return [fallback[0] || 'unknown', fallback.slice(1).join('/') || 'unknown'];
								}

								function usageModelLabel(rowOrKey) {
									const parts = usageModelParts(rowOrKey);
									return parts[0] + '/' + parts[1];
								}

								function escapeHTML(value) {
									return String(value).replace(/[&<>"']/g, function(ch) {
										return ({ '&': '&amp;', '\x3c': '&lt;', '>': '&gt;', '"': '&quot;', "'": '&#39;' })[ch];
									});
								}


								function relativeTime(value) {
									if (!value) return 'never';
									const date = new Date(value);
									if (Number.isNaN(date.getTime())) return 'never';
									const seconds = Math.max(0, Math.floor((Date.now() - date.getTime()) / 1000));
									if (seconds < 60) return 'today';
									const minutes = Math.floor(seconds / 60);
									if (minutes < 60) return minutes + 'm ago';
									const hours = Math.floor(minutes / 60);
									if (hours < 24) return hours + 'h ago';
									const days = Math.floor(hours / 24);
									return days + 'd ago';
								}

								function skillRangeParam() { return usageRangeParam(); }

									function skillEvidenceParams() {
										const selected = new URLSearchParams(window.location.search);
										const params = analyticsParams({ project_id: projectID, range: skillRangeParam(), group_by: document.getElementById('groupBy').value });
										['skill_period','skill_event','skill_agent','skill_handle','skill_evidence_scope'].forEach(function(key) { const value=selected.get(key); if(value) params.set(key,value); });
										return params;
									}

									function renderSkillEventEvidence(rows, total) {
										const selected = new URLSearchParams(window.location.search);
										const active = Boolean(selected.get('skill_period') || selected.get('skill_handle'));
										const card = document.getElementById('skillEventEvidenceCard');
										if (card) card.classList.toggle('hidden', !active);
										if (!active) return;
										const evidence = rows || [];
										const coverage = document.getElementById('skillEventEvidenceCoverage');
										if (coverage) coverage.textContent = 'Showing ' + evidence.length + ' of ' + Number(total || 0) + ' matching project-scoped skill events';
										const table = document.getElementById('skillEventEvidenceTable');
										if (!table) return;
										table.innerHTML = evidence.length ? evidence.map(function(row) {
											const task = row.task_id ? '\x3ca class="link" href="/tasks/' + encodeURIComponent(row.task_id) + '?project_id=' + encodeURIComponent(projectID) + '">' + escapeHTML(row.task_id) + '\x3c/a>' : 'No task';
										const execution = row.execution_id ? '\x3ccode>' + escapeHTML(row.execution_id) + '\x3c/code>' : 'No run';
											const agent = row.agent_id ? '\x3ca class="link" href="/agents?project_id=' + encodeURIComponent(projectID) + '&agent_id=' + encodeURIComponent(row.agent_id) + '">' + escapeHTML(row.agent_name || row.agent_id) + '\x3c/a>' : escapeHTML(row.agent_name || 'Unassigned');
											const occurred = row.created_at ? new Date(row.created_at).toLocaleString() : 'Unavailable';
											return '\x3ctr>\x3ctd>\x3ccode>' + escapeHTML(row.id) + '\x3c/code>\x3c/td>\x3ctd>' + escapeHTML(occurred) + '\x3c/td>\x3ctd>\x3ccode>' + escapeHTML(row.skill_handle) + '\x3c/code>\x3cbr>\x3cspan class="badge badge-ghost badge-xs">' + escapeHTML(row.skill_scope || 'unknown') + '\x3c/span>\x3c/td>\x3ctd>' + agent + '\x3c/td>\x3ctd>' + escapeHTML(row.event_type) + '\x3c/td>\x3ctd>' + escapeHTML((row.source || 'unknown') + ' / ' + (row.surface || 'unknown')) + '\x3c/td>\x3ctd>' + task + '\x3cbr>' + execution + '\x3c/td>\x3c/tr>';
										}).join('') : '\x3ctr>\x3ctd colspan="7" class="text-center opacity-50">No matching skill events\x3c/td>\x3c/tr>';
									}

									async function loadSkillEvidence() {
										const request = ++skillEvidenceRequest;
										try {
											const data = await fetchJSON('/api/analytics/skills?' + skillEvidenceParams().toString());
											if (request !== skillEvidenceRequest) return;
											renderSkillEventEvidence(data.evidence || [], data.evidence_total || 0);
										} catch (e) { if (request === skillEvidenceRequest) { console.error('loadSkillEvidence:', e); showAnalyticsError(e); } }
									}

									async function loadSkillAnalytics() {
										try {
											const data = await fetchJSON('/api/analytics/skills?' + skillEvidenceParams().toString());
											renderSkillAnalytics(data);
										} catch (e) { console.error('loadSkillAnalytics:', e); showAnalyticsError(e); }
									}

									function renderSkillAnalytics(data) {
										renderSkillUsageTrend(data?.usage_over_time || []);
										renderSkillTop(data?.top_skills || []);
										renderSkillFollow(data?.follow_through || []);
										renderSkillAgentUsage(data?.agent_usage || {});
										renderUnderusedSkills(data?.underused || []);
										renderSkillEventEvidence(data?.evidence || [], data?.evidence_total || 0);
									}
								function skillLabel(value) {
									const text = String(value || 'unknown');
									return text.length > 34 ? text.slice(0, 31) + '…' : text;
								}
								function scopedSkillLabel(value, scope) {
									const suffix = ' [' + (scope || 'unknown') + ']';
									const text = String(value || 'unknown');
									const available = Math.max(1, 34 - suffix.length);
									return (text.length > available ? text.slice(0, Math.max(1, available - 1)) + '…' : text) + suffix;
								}

								function skillEventTotals(rows) {
									return (rows || []).reduce(function(acc, row) {
										acc.selected += row.selected_count || 0;
										acc.loaded += row.loaded_count || 0;
										acc.viewed += row.viewed_count || 0;
										acc.created += row.created_count || 0;
										acc.edited += row.edited_count || 0;
										return acc;
									}, { selected: 0, loaded: 0, viewed: 0, created: 0, edited: 0 });
								}


									const analyticsActivePointOnTop = {
										id: 'analyticsActivePointOnTop',
										beforeEvent: function(chart, args) {
											const event = args.event;
											const previous = chart.$analyticsHoveredPoint || null;
											if (!event || event.type === 'mouseout' || !args.inChartArea) {
												chart.$analyticsHoveredPoint = null;
											} else {
												const nearest = chart.getElementsAtEventForMode(event, 'nearest', { intersect: false }, false);
												chart.$analyticsHoveredPoint = nearest.length > 0 ? nearest[0] : null;
											}
											const current = chart.$analyticsHoveredPoint;
											if ((!previous && current) || (previous && !current) || (previous && current && (previous.datasetIndex !== current.datasetIndex || previous.index !== current.index))) {
												args.changed = true;
											}
										},
										afterDraw: function(chart) {
											let marker = chart.$analyticsHoverMarker;
											if (!marker) {
												marker = document.createElement('span');
												marker.setAttribute('data-analytics-hover-marker', '');
												marker.setAttribute('aria-hidden', 'true');
												marker.style.position = 'absolute';
												marker.style.width = '12px';
												marker.style.height = '12px';
												marker.style.boxSizing = 'border-box';
												marker.style.border = '3px solid rgba(255, 255, 255, 0.96)';
												marker.style.borderRadius = '9999px';
												marker.style.transform = 'translate(-50%, -50%)';
												marker.style.pointerEvents = 'none';
												marker.style.zIndex = '2';
												chart.canvas.parentElement.appendChild(marker);
												chart.$analyticsHoverMarker = marker;
											}
											const point = chart.$analyticsHoveredPoint;
											const tooltip = chart.tooltip;
											if (!tooltip || tooltip.opacity === 0 || !point) {
												marker.style.display = 'none';
												return;
											}
											const element = point.element;
											const canvasRect = chart.canvas.getBoundingClientRect();
											const parentRect = chart.canvas.parentElement.getBoundingClientRect();
											const scaleX = chart.width ? canvasRect.width / chart.width : 1;
											const scaleY = chart.height ? canvasRect.height / chart.height : 1;
											const dataset = chart.data.datasets[point.datasetIndex] || {};
											const datasetColor = dataset.borderColor || element.options?.borderColor || element.options?.backgroundColor;
											const markerLeft = canvasRect.left - parentRect.left + element.x * scaleX;
											const markerTop = canvasRect.top - parentRect.top + element.y * scaleY;
											const chartLeft = canvasRect.left - parentRect.left + chart.chartArea.left * scaleX;
											const chartTop = canvasRect.top - parentRect.top + chart.chartArea.top * scaleY;
											const chartRight = canvasRect.left - parentRect.left + chart.chartArea.right * scaleX;
											const chartBottom = canvasRect.top - parentRect.top + chart.chartArea.bottom * scaleY;
											marker.style.left = markerLeft + 'px';
											marker.style.top = markerTop + 'px';
											marker.style.clipPath = 'inset(' + Math.max(0, chartTop - markerTop + 6) + 'px ' + Math.max(0, markerLeft + 6 - chartRight) + 'px ' + Math.max(0, markerTop + 6 - chartBottom) + 'px ' + Math.max(0, chartLeft - markerLeft + 6) + 'px)';
											marker.style.backgroundColor = typeof datasetColor === 'string' ? datasetColor : 'rgb(59, 130, 246)';
											marker.style.display = 'block';
										},
										beforeDestroy: function(chart) {
											chart.$analyticsHoverMarker?.remove();
											chart.$analyticsHoverMarker = null;
										}
									};

									function analyticsLineTooltipOptions() {
										return {
											position: 'nearest',
											caretPadding: 6,
											itemSort: function(a, b) {
												const hovered = a.chart?.$analyticsHoveredPoint || b.chart?.$analyticsHoveredPoint;
												if (!hovered) return 0;
												const aIsHovered = a.datasetIndex === hovered.datasetIndex;
												const bIsHovered = b.datasetIndex === hovered.datasetIndex;
												if (aIsHovered === bIsHovered) return 0;
												return aIsHovered ? -1 : 1;
											}
										};
									}

									function lineDataset(label, data, color) {
										return { label: label, data: data, borderColor: color, backgroundColor: color, tension: 0.25, fill: false, pointRadius: 2, pointHoverRadius: 4 };
									}
							function renderSkillUsageTrend(totals) {
								const totalRows = totals || [];
								const canvas = renderChartState('skillUsageTrend', 'skillUsageTrendChart', totalRows, 'No skill activity in this period');
								if (!canvas) return;
								const labels = totalRows.map(row => row.period || '');
									const datasets = [
										lineDataset('Used', totalRows.map(row => (row.selected_count || 0) + (row.loaded_count || 0) + (row.viewed_count || 0)), 'rgb(59, 130, 246)'),
										lineDataset('Created', totalRows.map(row => row.created_count || 0), 'rgb(20, 184, 166)'),
										lineDataset('Edited', totalRows.map(row => row.edited_count || 0), 'rgb(147, 51, 234)')
									];
									charts.skillUsageTrend = new Chart(canvas.getContext('2d'), {
										type: 'line',
										plugins: [analyticsActivePointOnTop],
										data: { labels: labels, datasets: datasets },
										options: { responsive: true, maintainAspectRatio: false, interaction: { mode: 'index', intersect: false }, plugins: { legend: { position: 'bottom' }, tooltip: analyticsLineTooltipOptions() }, scales: { y: { beginAtZero: true } } }
									});
								}

								function renderSkillTop(rows) {
									const chartRows = rows.slice(0, 8).map(function(row) {
										return Object.assign({}, row, {
											activity: (row.selected_count || 0) + (row.loaded_count || 0) + (row.viewed_count || 0) + (row.created_count || 0) + (row.edited_count || 0)
										});
									});
									const canvas = renderChartState('skillTop', 'skillTopChart', chartRows, 'No skill activity in this period');
									if (canvas) {
										charts.skillTop = new Chart(canvas.getContext('2d'), {
											type: 'bar',
											data: { labels: chartRows.map(r => scopedSkillLabel(r.skill_handle, r.skill_scope)), datasets: [
												{ label: 'Selected', data: chartRows.map(r => r.selected_count || 0), backgroundColor: 'rgba(59, 130, 246, 0.5)', borderColor: 'rgb(59, 130, 246)', borderWidth: 1 },
												{ label: 'Loaded', data: chartRows.map(r => r.loaded_count || 0), backgroundColor: 'rgba(34, 197, 94, 0.5)', borderColor: 'rgb(34, 197, 94)', borderWidth: 1 },
												{ label: 'Viewed', data: chartRows.map(r => r.viewed_count || 0), backgroundColor: 'rgba(251, 146, 60, 0.5)', borderColor: 'rgb(251, 146, 60)', borderWidth: 1 },
												{ label: 'Created', data: chartRows.map(r => r.created_count || 0), backgroundColor: 'rgba(20, 184, 166, 0.5)', borderColor: 'rgb(20, 184, 166)', borderWidth: 1 },
											{ label: 'Edited', data: chartRows.map(r => r.edited_count || 0), backgroundColor: 'rgba(147, 51, 234, 0.5)', borderColor: 'rgb(147, 51, 234)', borderWidth: 1 }
										] },
										options: { indexAxis: 'y', responsive: true, maintainAspectRatio: false, scales: { x: { beginAtZero: true, stacked: true }, y: { stacked: true } }, plugins: { legend: { position: 'bottom' } } }										});
									}
								}

								function renderSkillFollow(rows) {
									const chartRows = rows.slice(0, 8);
									const canvas = renderChartState('skillFollow', 'skillFollowChart', chartRows, 'No skill follow-through evidence in this period');
									if (canvas) {
										charts.skillFollow = new Chart(canvas.getContext('2d'), {
											type: 'bar',
											data: { labels: chartRows.map(r => scopedSkillLabel(r.skill_handle, r.skill_scope)), datasets: [
												{ label: 'Used', data: chartRows.map(r => r.loaded_or_viewed_count || 0), backgroundColor: 'rgba(34, 197, 94, 0.5)', borderColor: 'rgb(34, 197, 94)', borderWidth: 1 },
											{ label: 'Ignored', data: chartRows.map(r => r.ignored_count || 0), backgroundColor: 'rgba(239, 68, 68, 0.5)', borderColor: 'rgb(239, 68, 68)', borderWidth: 1 }
										] },
										options: { indexAxis: 'y', responsive: true, maintainAspectRatio: false, scales: { x: { beginAtZero: true, stacked: true }, y: { stacked: true } }, plugins: { legend: { position: 'bottom' } } }										});
									}
								}

								function renderSkillAgentUsage(heatmap) {
									const cells = heatmap.cells || [];
									const agentNames = new Map((heatmap.agents || []).map(a => [a.agent_id || '', a.agent_name || a.agent_id || 'Unassigned']));
									const rows = cells.map(function(cell) {
										return Object.assign({}, cell, {
											agent_name: agentNames.get(cell.agent_id || '') || 'Unassigned',
											activity: (cell.selected_count || 0) + (cell.loaded_count || 0) + (cell.viewed_count || 0)
										});
									}).filter(row => row.activity > 0).sort((a, b) => b.activity - a.activity).slice(0, 8);
									const canvas = renderChartState('skillAgent', 'skillAgentChart', rows, 'No Agent and skill pair activity in this period');
									if (canvas) {
										charts.skillAgent = new Chart(canvas.getContext('2d'), {
											type: 'bar',
											data: {
													labels: rows.map(row => scopedSkillLabel(row.agent_name + ' · ' + row.skill_handle, row.skill_scope)),												datasets: [{ label: 'Activity', data: rows.map(row => row.activity), backgroundColor: 'rgba(20, 184, 166, 0.5)', borderColor: 'rgb(20, 184, 166)', borderWidth: 1 }]
											},
											options: { indexAxis: 'y', responsive: true, maintainAspectRatio: false, scales: { x: { beginAtZero: true } }, plugins: { legend: { position: 'bottom' } } }
										});
									}
								}

								function renderUnderusedSkills(rows) {
									const tbody = document.getElementById('underusedSkillsTable');
									if (!tbody) return;
									if (rows.length === 0) { tbody.innerHTML = '\x3ctr>\x3ctd colspan="4" class="text-center opacity-50">No enabled skills found\x3c/td>\x3c/tr>'; return; }
									tbody.innerHTML = rows.slice(0, 8).map(function(r) {
										const activity = (r.selected_count || 0) + (r.loaded_count || 0) + (r.viewed_count || 0);
										const alwaysUse = r.always_use ? ' · always-use' : '';
										return '\x3ctr>\x3ctd>\x3ccode>' + escapeHTML(r.skill_handle) + '\x3c/code>\x3c/td>\x3ctd>\x3cspan class="badge badge-ghost badge-sm">' + escapeHTML((r.skill_scope || '') + alwaysUse) + '\x3c/span>\x3c/td>\x3ctd>' + formatNumber(activity) + '\x3c/td>\x3ctd class="text-xs opacity-70">' + relativeTime(r.last_activity) + '\x3c/td>\x3c/tr>';
									}).join('');
								}

								function modelSeriesKeys(rows) {
									return Array.from(new Set((rows || []).map(usageModelKey))).sort(function(a, b) { return usageModelLabel(a).localeCompare(usageModelLabel(b)); });
								}

								function fillModelChoiceSelect(selectID, keys) {
									const select = document.getElementById(selectID);
									if (!select) return 'combined';
									const previous = select.value || 'combined';
									const validChoices = ['combined', 'all'].concat(keys || []);
									const keep = validChoices.includes(previous) ? previous : 'combined';
									const modelOptions = (keys || []).map(key => '\x3coption value="' + escapeHTML(key) + '">' + escapeHTML(usageModelLabel(key)) + '\x3c/option>').join('');
									select.innerHTML = '\x3coption value="combined">All models combined\x3c/option>\x3coption value="all">Each model\x3c/option>' + modelOptions;
									select.value = keep;
									select.disabled = (keys || []).length === 0;
									return keep;
								}

							const usageSeriesColors = [
								'rgb(59, 130, 246)',
								'rgb(34, 197, 94)',
								'rgb(251, 146, 60)',
								'rgb(147, 51, 234)',
								'rgb(239, 68, 68)',
								'rgb(20, 184, 166)',
								'rgb(236, 72, 153)',
								'rgb(132, 204, 22)'
							];

							function colorForIndex(index, alpha) {
								const color = usageSeriesColors[index % usageSeriesColors.length];
								return color.replace('rgb(', 'rgba(').replace(')', ', ' + alpha + ')');
							}

							function uniquePeriods(rows) {
								return Array.from(new Set((rows || []).map(row => row.period))).sort();
							}
							function usageRangeParam() {
							const range = document.getElementById('dateRange').value;
							if (range === '7') return '7d';
							if (range === '90') return '90d';
							if (range === '365') return '365d';
							if (range === 'all') return 'all';
							return '30d';
						}
						// Format milliseconds as human-readable duration (e.g., "5m 30s", "2h 15m")
					function formatDuration(ms) {
						if (ms < 1000) return ms.toFixed(0) + 'ms';
						var totalSeconds = Math.round(ms / 1000);
						var hours = Math.floor(totalSeconds / 3600);
						var minutes = Math.floor((totalSeconds % 3600) / 60);
						var seconds = totalSeconds % 60;
						if (hours > 0) return hours + 'h ' + minutes + 'm';
						if (minutes > 0) return minutes + 'm ' + seconds + 's';
						return seconds + 's';
					}

					// Utility function to get date range
					function getDateRange() {
						const range = document.getElementById('dateRange').value;
						if (range === 'all') {
							return { dateFrom: '', dateTo: '' };
						}
						const dateTo = new Date();
						const dateFrom = new Date();
						dateFrom.setDate(dateTo.getDate() - parseInt(range));
						return {
							dateFrom: dateFrom.toISOString(),
							dateTo: dateTo.toISOString()
						};
					}

									function usageEvidenceParams() {
										const selected = new URLSearchParams(window.location.search);
										const params = analyticsParams({ project_id: projectID, range: usageRangeParam(), group_by: document.getElementById('groupBy').value });
										['usage_period','usage_provider','usage_model_name'].forEach(function(key) { const value=selected.get(key); if(value) params.set(key,value); });
										return params;
									}

									function renderUsageEventEvidence(rows, total) {
										const selected = new URLSearchParams(window.location.search);
									const active = Boolean(selected.get('usage_period') || selected.get('usage_provider') || selected.get('usage_model_name'));
										const card = document.getElementById('usageEventEvidenceCard');
										if (card) card.classList.toggle('hidden', !active);
										if (!active) return;
										const evidence = rows || [];
										const coverage = document.getElementById('usageEventEvidenceCoverage');
										if (coverage) coverage.textContent = 'Showing ' + evidence.length + ' of ' + Number(total || 0) + ' matching project-scoped usage events';
										const table = document.getElementById('usageEventEvidenceTable');
										if (!table) return;
										table.innerHTML = evidence.length ? evidence.map(function(row) {
											const task = row.task_id ? '\x3ca class="link" href="/tasks/' + encodeURIComponent(row.task_id) + '?project_id=' + encodeURIComponent(projectID) + '">' + escapeHTML(row.task_id) + '\x3c/a>' : 'No task';
										const execution = row.execution_id ? '\x3ccode>' + escapeHTML(row.execution_id) + '\x3c/code>' : 'No run';
											const occurred = row.occurred_at ? new Date(row.occurred_at).toLocaleString() : 'Unavailable';
											return '\x3ctr>\x3ctd>\x3ccode>' + escapeHTML(row.id) + '\x3c/code>\x3c/td>\x3ctd>' + escapeHTML(occurred) + '\x3c/td>\x3ctd>' + escapeHTML((row.provider || 'unknown') + ' / ' + (row.model || 'unknown')) + '\x3c/td>\x3ctd>' + escapeHTML(row.operation || 'unknown') + '\x3c/td>\x3ctd>' + escapeHTML(row.status || 'unknown') + '\x3c/td>\x3ctd>' + formatNumber(row.total_tokens) + '\x3c/td>\x3ctd>' + escapeHTML(formatCost(row.cost_usd)) + '\x3c/td>\x3ctd>' + task + '\x3cbr>' + execution + '\x3c/td>\x3c/tr>';
										}).join('') : '\x3ctr>\x3ctd colspan="8" class="text-center opacity-50">No matching usage events\x3c/td>\x3c/tr>';
									}

									async function loadUsageEvidence() {
										const request = ++usageEvidenceRequest;
										try {
											const data = await fetchJSON('/api/analytics/usage?' + usageEvidenceParams().toString());
											if (request !== usageEvidenceRequest) return;
											renderUsageEventEvidence(data.evidence || [], data.evidence_total || 0);
										} catch (e) { if (request === usageEvidenceRequest) { console.error('loadUsageEvidence:', e); showAnalyticsError(e); } }
									}

									function focusUsageEvidence(row) {									const table = document.getElementById('usageBreakdownTable');
									if (!table) return;
									table.querySelectorAll('[data-usage-model]').forEach(function(node) { node.classList.remove('bg-primary/10'); });
									if (row) {
										const key = usageModelKey(row);
										const target = Array.from(table.querySelectorAll('[data-usage-model]')).find(function(node) { return node.dataset.usageModel === key; });
										if (target) target.classList.add('bg-primary/10');
									}
								}
									function showUsageSelection(period, modelKey, tokens, row) {
										const modelLabel = modelKey === 'combined' ? 'All models combined' : usageModelLabel(modelKey);
										const values = {usage_period:period,usage_model:modelKey};
										if (row) { values.usage_provider=row.provider; values.usage_model_name=row.model; }
										showAggregateSelection('usage',values,'usageEvidenceSelection','Token usage · '+period+' · '+modelLabel+' · '+formatNumber(tokens)+' tokens');
										focusUsageEvidence(row || null);
										loadUsageEvidence();
									}
								function showUsageModelEvidence(row) {
									if (!row) return;
									const modelKey = usageModelKey(row);
									showAggregateSelection('usage',{usage_model:modelKey,usage_provider:row.provider,usage_model_name:row.model},'usageEvidenceSelection','Model token usage · '+usageModelLabel(modelKey)+' · '+formatNumber(row.total_tokens)+' tokens');
									focusUsageEvidence(row);
									loadUsageEvidence();
								}
								function renderUsageRateChart(data) {
									const rate = data?.usage_rate || [];
									const rateByModel = data?.usage_rate_by_model || [];
								const rateKeys = modelSeriesKeys(rateByModel);
								const choice = fillModelChoiceSelect('usageRateModelSelect', rateKeys);
								const rateCtx = renderChartState('usageRate', 'usageRateChart', rate, 'No token usage in this period');
								if (!rateCtx) return;
									let labels = [];
									let datasets = [];
									if (choice === 'combined' || rateByModel.length === 0) {
										labels = rate.map(d => d.period);
										datasets = [{ label: 'All models', data: rate.map(d => d.total_tokens || 0), borderColor: 'rgb(147, 51, 234)', backgroundColor: 'rgba(147, 51, 234, 0.12)', tension: 0.25 }];
									} else {
										const rows = choice === 'all' ? rateByModel : rateByModel.filter(row => usageModelKey(row) === choice);
										labels = uniquePeriods(rows);
										const keys = choice === 'all' ? rateKeys : (choice ? [choice] : []);
										datasets = keys.map((key, index) => {
											const totalsByPeriod = new Map(rows.filter(row => usageModelKey(row) === key).map(row => [row.period, row.total_tokens || 0]));
											return { label: usageModelLabel(key), data: labels.map(period => totalsByPeriod.get(period) || 0), borderColor: usageSeriesColors[index % usageSeriesColors.length], backgroundColor: colorForIndex(index, 0.12), tension: 0.25 };
										});
									}
									charts.usageRate = new Chart(rateCtx.getContext('2d'), {
										type: 'line',
										plugins: [analyticsActivePointOnTop],
										data: { labels: labels, datasets: datasets },
										options: { responsive: true, maintainAspectRatio: false, interaction: { mode: 'index', intersect: false }, plugins: { legend: { position: 'bottom' }, tooltip: analyticsLineTooltipOptions() }, scales: { y: { beginAtZero: true } } }
									});
								}

								function renderUsageAnalytics(data) {
									const totals = data.totals || {};
									renderUsageEventEvidence(data.evidence || [], data.evidence_total || 0);									renderUsageSummary(totals);
									renderUsageFindings(data);
									const lastUpdated = document.getElementById('usageLastUpdated');
									lastUpdated.textContent = data.last_updated_at ? 'Last updated ' + new Date(data.last_updated_at).toLocaleString() : 'Local usage history';
										renderUsageRateChart(data);

									const breakdown = data.model_breakdown || [];
									const table = document.getElementById('usageBreakdownTable');
									if (table) {
										if (breakdown.length === 0 && (totals.call_count || 0) === 0) {
											table.innerHTML = '\x3ctr>\x3ctd colspan="8" class="text-center opacity-50">No usage recorded yet\x3c/td>\x3c/tr>';
										} else {
											const rows = breakdown.map(row => '\x3ctr data-usage-model="' + escapeHTML(usageModelKey(row)) + '">\x3ctd>' + escapeHTML(row.provider || 'unknown') + '\x3c/td>\x3ctd>' + escapeHTML(row.model || 'unknown') + '\x3c/td>\x3ctd>' + formatNumber(row.input_tokens) + '\x3c/td>\x3ctd>' + formatNumber(row.output_tokens) + '\x3c/td>\x3ctd>' + formatNumber(row.cached_input_tokens) + '\x3c/td>\x3ctd>' + formatNumber(row.reasoning_output_tokens) + '\x3c/td>\x3ctd>' + formatNumber(row.total_tokens) + '\x3c/td>\x3ctd>' + formatCost(row.cost_usd) + '\x3c/td>\x3c/tr>');
											const totalCost = totals.cost_available ? formatCost(totals.cost_usd) : 'cost unavailable';
											rows.push('\x3ctr class="font-semibold border-t border-base-300">\x3ctd>Total\x3c/td>\x3ctd>All models\x3c/td>\x3ctd>' + formatNumber(totals.input_tokens) + '\x3c/td>\x3ctd>' + formatNumber(totals.output_tokens) + '\x3c/td>\x3ctd>' + formatNumber(totals.cached_input_tokens) + '\x3c/td>\x3ctd>' + formatNumber(totals.reasoning_output_tokens) + '\x3c/td>\x3ctd>' + formatNumber(totals.total_tokens) + '\x3c/td>\x3ctd>' + totalCost + '\x3c/td>\x3c/tr>');
											table.innerHTML = rows.join('');
										}
									}
								const modelCtx = renderChartState('modelTokenBreakdown', 'modelTokenBreakdownChart', breakdown, 'No model token usage in this period');
								if (modelCtx) {
									charts.modelTokenBreakdown = new Chart(modelCtx.getContext('2d'), {
										type: 'bar',
											data: {
												labels: breakdown.map(row => `${row.provider}/${row.model}`),
												datasets: [{
													data: breakdown.map(row => row.total_tokens || 0),
													backgroundColor: [
														'rgba(239, 68, 68, 0.7)',
														'rgba(34, 197, 94, 0.7)',
														'rgba(59, 130, 246, 0.7)',
														'rgba(251, 146, 60, 0.7)',
														'rgba(147, 51, 234, 0.7)',
														'rgba(20, 184, 166, 0.7)'
													]
												}]
											},
												options: {
													responsive: true,
													maintainAspectRatio: false,
														plugins: { legend: { position: 'bottom' } }
												}
											});
											}
											renderAccountUsageCards(data.account_limits || []);
										}
									function renderAccountUsageCards(accounts) {
										const accountContainers = ['accountUsageCards'].map(function(id){return document.getElementById(id);}).filter(Boolean);
										if (!accountContainers.length) return;
										if (accounts.length === 0) {
											accountContainers.forEach(function(container){container.removeAttribute('aria-busy');container.innerHTML = '\x3cp class="opacity-50 lg:col-span-2">No connected OAuth account snapshots yet.\x3c/p>';});
											return;
										}
										const accountHTML = accounts.map((account, index) => {
											let accountLimits = account.limits || [];
											if (accountLimits.length === 0) {
												if (account.primary_limit) accountLimits.push(account.primary_limit);
												if (account.secondary_limit) accountLimits.push(account.secondary_limit);
												accountLimits = accountLimits.concat(account.extra_limits || []);
											}
											const limits = accountLimits.map(limit => {
												const pct = limit.used_percent === null || limit.used_percent === undefined ? null : Number(limit.used_percent);
												const width = pct === null ? 0 : Math.max(0, Math.min(100, pct));
												const resetLabel = formatResetCountdown(limit.resets_at);
												const reset = resetLabel ? `\x3cdiv class="text-xs opacity-60">${resetLabel}\x3c/div>` : '';
												return `\x3cdiv class="mt-2">\x3cdiv class="flex justify-between text-xs">\x3cspan>${escapeHTML(limit.label || 'limit')}\x3c/span>\x3cspan>${pct === null ? 'unknown' : pct.toFixed(1) + '%'}\x3c/span>\x3c/div>\x3cdiv class="ov-account-limit-bar" role="meter" aria-label="${escapeHTML(limit.label || 'limit')} usage" aria-valuemin="0" aria-valuemax="100" aria-valuenow="${width.toFixed(1)}">\x3cdiv class="ov-account-limit-bar-fill" style="width: ${width}%">\x3c/div>\x3c/div>${reset}\x3c/div>`;
											}).join('');
											const error = account.error ? `\x3cdiv class="alert alert-warning py-2 text-xs mt-2">${escapeHTML(account.error)}\x3c/div>` : '';
											const providerName = (account.provider || '').toLowerCase();
											const providerTitle = providerName === 'openai' ? 'OpenAI' : (providerName === 'anthropic' ? 'Anthropic' : 'OAuth account');
											const subscription = account.plan_type || '';
											const metaParts = providerName === 'anthropic' ? [account.extra_usage_label] : [account.status_label, account.billing_label, account.extra_usage_label];
											const meta = metaParts.filter(Boolean).join(' · ');
											const detail = providerName === 'anthropic' ? '' : (account.account_detail || '');
											const usedCredits = account.extra_usage_used_usd !== null && account.extra_usage_used_usd !== undefined ? ' · Used: $' + Number(account.extra_usage_used_usd).toFixed(2) : '';
											const extraUsage = account.extra_usage_monthly_usd !== null && account.extra_usage_monthly_usd !== undefined ? '\x3cdiv class="text-xs opacity-60">Monthly limit: $' + Number(account.extra_usage_monthly_usd).toFixed(2) + usedCredits + '\x3c/div>' : '';
											const subscriptionHtml = subscription ? '\x3cdiv class="text-sm opacity-90">' + escapeHTML(subscription) + '\x3c/div>' : '';
											const metaHtml = meta ? '\x3cdiv class="text-xs opacity-80">' + escapeHTML(meta) + '\x3c/div>' : '';
											const detailHtml = detail ? '\x3cdiv class="text-xs opacity-60">' + escapeHTML(detail) + '\x3c/div>' : '';
											const span = accounts.length % 2 === 1 && index === accounts.length - 1 ? ' lg:col-span-2' : '';
											return '\x3cdiv class="card bg-base-100 shadow-sm border border-base-300 h-full' + span + '">\x3cdiv class="card-body">\x3cdiv class="font-semibold">' + escapeHTML(providerTitle) + '\x3c/div>' + subscriptionHtml + metaHtml + detailHtml + extraUsage + (limits || '\x3cdiv class="text-xs opacity-50 mt-2">No live limit snapshot yet\x3c/div>') + error + '\x3c/div>\x3c/div>';
										}).join('');
										accountContainers.forEach(function(container){container.removeAttribute('aria-busy');container.innerHTML=accountHTML;});
									}

									async function loadUsageAnalytics(refreshUsage) {
										try {
											const params = usageEvidenceParams();
											if (refreshUsage) params.append('refresh', 'true');
										latestUsageAnalytics = await fetchJSON('/api/analytics/usage?' + params.toString());
										if (selectedView === 'usage') renderUsageAnalytics(latestUsageAnalytics);
										else renderAccountUsageCards(latestUsageAnalytics.account_limits || []);
										} catch (e) { console.error('loadUsageAnalytics:', e); showAnalyticsError(e); }
									}
								// Load Success/Failure Rates
					async function loadSuccessFailureRates() {
						try {
						const groupBy = document.getElementById('groupBy').value;
						const { dateFrom, dateTo } = getDateRange();
						const params = analyticsParams({ project_id: projectID, group_by: groupBy });
						if (dateFrom) params.append('date_from', dateFrom);
						if (dateTo) params.append('date_to', dateTo);

							const data = await fetchJSON(`/api/analytics/success-failure-rates?${params}`);
							const ctx = renderChartState('successFailure', 'successFailureChart', data, 'No finished runs in this period');
							if (!ctx) return;

							charts.successFailure = new Chart(ctx.getContext('2d'), {
							type: 'line',
							plugins: [analyticsActivePointOnTop],
							data: {
								labels: data.map(d => d.Period || 'N/A'),
								datasets: [
									{
										label: 'Run success rate (%)',
										data: data.map(d => d.SuccessRate || 0),
										borderColor: 'rgb(34, 197, 94)',
										backgroundColor: 'rgba(34, 197, 94, 0.1)',
										yAxisID: 'y'
									},
									{
										label: 'Total finished runs',
										data: data.map(d => d.TotalCount || 0),
										borderColor: 'rgb(59, 130, 246)',
										backgroundColor: 'rgba(59, 130, 246, 0.1)',
										yAxisID: 'y1'
									},
									{
										label: 'Completed runs',
										data: data.map(d => d.SuccessCount || 0),
										borderColor: 'rgb(22, 163, 74)',
										backgroundColor: 'rgba(22, 163, 74, 0.1)',
										yAxisID: 'y1'
									},
									{
										label: 'Failed runs',
										data: data.map(d => d.FailureCount || 0),
										borderColor: 'rgb(239, 68, 68)',
										backgroundColor: 'rgba(239, 68, 68, 0.1)',
										yAxisID: 'y1'
									},
									{
										label: 'Cancelled runs',
										data: data.map(d => d.CancelledCount || 0),
										borderColor: 'rgb(245, 158, 11)',
										backgroundColor: 'rgba(245, 158, 11, 0.1)',
										yAxisID: 'y1'
									}
								]
							},
							options: {
								responsive: true,
								maintainAspectRatio: false,
									interaction: { mode: 'index', intersect: false },
									plugins: { tooltip: analyticsLineTooltipOptions() },								scales: {
									y: { type: 'linear', display: true, position: 'left', max: 100, title: { display: true, text: 'Run success rate (%)' } },
									y1: { type: 'linear', display: true, position: 'right', title: { display: true, text: 'Total runs' }, grid: { drawOnChartArea: false } }
								}
							}
						});
						} catch (e) { console.error('loadSuccessFailureRates:', e); showAnalyticsError(e); }
					}

					// Load Hourly Trends
					async function loadHourlyTrends() {
						try {
						const { dateFrom, dateTo } = getDateRange();
						const params = analyticsParams({ project_id: projectID });
						if (dateFrom) params.append('date_from', dateFrom);
						if (dateTo) params.append('date_to', dateTo);

							const data = await fetchJSON(`/api/analytics/execution-trends-by-hour?${params}`);

							const ctx = renderChartState('hourlyTrends', 'hourlyTrendsChart', data, 'No runs in this period');
							if (!ctx) return;
							charts.hourlyTrends = new Chart(ctx.getContext('2d'), {
							type: 'bar',
							data: {
								labels: Array.from({ length: 24 }, (_, i) => `${i}:00`),
								datasets: [{
									label: 'Runs',
									data: Array.from({ length: 24 }, (_, i) => {
										const found = data.find(d => d.Hour === i);
										return found ? found.Count : 0;
									}),
									backgroundColor: 'rgba(147, 51, 234, 0.5)',
									borderColor: 'rgb(147, 51, 234)',
									borderWidth: 1
								}]
							},
							options: {
								responsive: true,
									maintainAspectRatio: false,
									scales: { y: { beginAtZero: true, title: { display: true, text: 'Count' } } }							}
						});
						} catch (e) { console.error('loadHourlyTrends:', e); showAnalyticsError(e); }
					}

					// Load Avg Execution Time by Task
					async function loadAvgTimeByTask() {
						try {
							const { dateFrom, dateTo } = getDateRange();
							const params = analyticsParams({ project_id: projectID, limit: '10' });
							if (dateFrom) params.set('date_from', dateFrom);
							if (dateTo) params.set('date_to', dateTo);
							const data = await fetchJSON('/api/analytics/avg-execution-time-by-task?' + params.toString());
							const ctx = renderChartState('avgTimeTask', 'avgTimeTaskChart', data, 'No completed run durations in this period');
							if (!ctx) return;
							charts.avgTimeTask = new Chart(ctx.getContext('2d'), {
							type: 'bar',
							data: {
								labels: data.map(d => d.Name || 'Unknown'),
								datasets: [{
									label: 'Avg Time (min)',
									data: data.map(d => (d.AvgMs || 0) / 60000),
									backgroundColor: 'rgba(251, 146, 60, 0.5)',
									borderColor: 'rgb(251, 146, 60)',
									borderWidth: 1
								}]
							},
							options: {
								responsive: true,
								maintainAspectRatio: false,
								indexAxis: 'y',
								scales: { x: { beginAtZero: true, title: { display: true, text: 'Minutes' } } },
								plugins: {
									tooltip: {
										callbacks: {
											label: function(context) {
												return 'Avg: ' + formatDuration(data[context.dataIndex].AvgMs || 0) + ' · n=' + (data[context.dataIndex].Count || 0);
											}
										}
									}
								}
							}
						});
						} catch (e) { console.error('loadAvgTimeByTask:', e); showAnalyticsError(e); }
					}

					// Load Most Frequent Tasks
					async function loadMostFrequentTasks() {
						try {
							const { dateFrom, dateTo } = getDateRange();
							const params = analyticsParams({ project_id: projectID, limit: '10' });
							if (dateFrom) params.set('date_from', dateFrom);
							if (dateTo) params.set('date_to', dateTo);
							const data = await fetchJSON('/api/analytics/most-frequent-tasks?' + params.toString());

						const container = document.getElementById('frequentTasksList');
						if (!container) return;
						if (data.length === 0) {
							container.innerHTML = '\x3cp class="text-center opacity-50 py-4">No data available\x3c/p>';
							return;
						}

							container.innerHTML = data.map((task, idx) => `
								\x3cdiv class="flex items-center justify-between gap-3 py-2 border-b border-base-300">
									\x3cdiv class="flex-1 min-w-0 pr-2">
										\x3cspan class="font-mono text-sm opacity-50">${idx + 1}.\x3c/span>
										\x3cspan class="ml-2 break-words">\x3ca class="link" href="/tasks/${encodeURIComponent(task.TaskID)}?project_id=${encodeURIComponent(projectID)}">${escapeHTML(task.TaskTitle || 'Unknown')}\x3c/a>\x3c/span>
									\x3c/div>
									\x3cspan class="badge badge-primary shrink-0 inline-flex items-center justify-center whitespace-nowrap h-auto min-h-6 px-3 py-1 leading-none text-center">${task.ExecutionCount || 0} runs\x3c/span>
								\x3c/div>
							`).join('');						} catch (e) { console.error('loadMostFrequentTasks:', e); showAnalyticsError(e); }
					}

					// Load Failed Task Patterns
					async function loadFailedTaskPatterns() {
						try {
							const { dateFrom, dateTo } = getDateRange();
							const params = analyticsParams({ project_id: projectID, limit: '10' });
							if (dateFrom) params.set('date_from', dateFrom);
							if (dateTo) params.set('date_to', dateTo);
							const data = await fetchJSON('/api/analytics/failed-task-patterns?' + params.toString());

							const canvas = renderChartState('failedPatterns', 'failedPatternsChart', data, 'No failed task patterns in this period');
							if (canvas) charts.failedPatterns = new Chart(canvas.getContext('2d'), {type:'bar',data:{labels:data.map(pattern=>pattern.TaskTitle||'Unknown'),datasets:[{label:'Failed runs',data:data.map(pattern=>Number(pattern.FailureCount||0)),backgroundColor:'#ef4444'}]},options:{indexAxis:'y',responsive:true,maintainAspectRatio:false,scales:{x:{beginAtZero:true}}}});

							const tbody = document.querySelector('#failedPatternsTable tbody');
						if (!tbody) return;
						if (data.length === 0) {
							tbody.innerHTML = '\x3ctr>\x3ctd colspan="4" class="text-center opacity-50">No failed tasks\x3c/td>\x3c/tr>';
							return;
						}

						tbody.innerHTML = data.map(pattern => {
							const lastError = pattern.LastError || 'N/A';
							const truncatedError = lastError.length > 50 ? lastError.substring(0, 50) + '...' : lastError;
							const lastFailedAt = pattern.LastFailedAt ? new Date(pattern.LastFailedAt).toLocaleString() : 'N/A';
							return `
								\x3ctr>
									\x3ctd>\x3ca class="link" href="/tasks/${encodeURIComponent(pattern.TaskID)}?project_id=${encodeURIComponent(projectID)}">${escapeHTML(pattern.TaskTitle || 'Unknown')}\x3c/a>\x3c/td>
									\x3ctd>\x3cspan class="badge badge-error">${pattern.FailureCount || 0}\x3c/span>\x3c/td>
									\x3ctd>\x3cspan class="text-xs" title="${escapeHTML(lastError)}">${escapeHTML(truncatedError)}\x3c/span>\x3c/td>
									\x3ctd class="text-xs opacity-60">${escapeHTML(lastFailedAt)}\x3c/td>
								\x3c/tr>
							`;
						}).join('');
						} catch (e) { console.error('loadFailedTaskPatterns:', e); showAnalyticsError(e); }
					}

						// Load only the active view. Bounded batches keep database work and chart rendering responsive.
						async function loadAllData(refreshUsage) {
							beginDataGeneration();
							const loadGeneration = dataGeneration;
							document.getElementById('analyticsError').classList.add('hidden');
							const loaders = selectedView === 'usage' ? [] : [loadDashboard];
								if (selectedView === 'outcomes') loaders.push(loadSuccessFailureRates, loadHourlyTrends, loadAvgTimeByTask, loadMostFrequentTasks, loadFailedTaskPatterns);
								if (selectedView === 'learning') loaders.push(loadSkillAnalytics);
								if (selectedView === 'usage') loaders.push(function() { return loadUsageAnalytics(refreshUsage); });							for (let index = 0; index < loaders.length; index += 2) {
								if (loadGeneration !== dataGeneration) return;
								await Promise.allSettled(loaders.slice(index, index + 2).map(function(load) { return load(); }));
								if (loadGeneration !== dataGeneration) return;
									await new Promise(function(resolve) { setTimeout(resolve, 0); });							}
						}

						function restoreURLState() {
							const params = new URLSearchParams(window.location.search);
							const range = params.get('range') || '30d';
							const rangeValue = range === 'all' ? 'all' : range.replace(/d$/, '');
							if (Array.from(document.getElementById('dateRange').options).some(function(option) { return option.value === rangeValue; })) document.getElementById('dateRange').value = rangeValue;
							const group = params.get('group_by') || 'day';
							if (['day', 'week', 'month'].includes(group)) document.getElementById('groupBy').value = group;
							document.getElementById('comparePeriod').checked = params.get('compare') !== '0' && range !== 'all';
								selectedAgent = params.get('agent') || '';
								selectedWorkflow = params.get('workflow') || '';
								document.getElementById('analyticsAgentFilter').value = selectedAgent;
								document.getElementById('analyticsWorkflowFilter').value = selectedWorkflow;
								const requestedView = params.get('view');
								applyView(validViews.includes(requestedView) ? requestedView : (savedAnalyticsView() || 'usage'), false);
								restoreAggregateSelectionState();
						}
						document.querySelectorAll('[data-analytics-view]').forEach(function(button) { button.addEventListener('click', function() { applyView(button.dataset.analyticsView, true); loadAllData(false); }, { signal: eventSignal }); });
						document.getElementById('refreshBtn').addEventListener('click', function() { history.replaceState({}, '', analyticsURL(selectedView)); loadAllData(true); }, { signal: eventSignal });
						['dateRange', 'groupBy', 'comparePeriod'].forEach(function(id) { document.getElementById(id).addEventListener('change', function() { if (document.getElementById('dateRange').value === 'all') document.getElementById('comparePeriod').checked = false; history.replaceState({}, '', analyticsURL(selectedView)); loadAllData(false); }, { signal: eventSignal }); });
							document.getElementById('analyticsAgentFilter').addEventListener('change', function() { selectedAgent = document.getElementById('analyticsAgentFilter').value; history.pushState({}, '', analyticsURL(selectedView)); loadAllData(false); }, { signal: eventSignal });
							document.getElementById('analyticsWorkflowFilter').addEventListener('change', function() { selectedWorkflow = document.getElementById('analyticsWorkflowFilter').value; history.pushState({}, '', analyticsURL(selectedView)); loadAllData(false); }, { signal: eventSignal });
							const loadMoreEvidence = document.getElementById('loadMoreEvidence');
							if (loadMoreEvidence) loadMoreEvidence.addEventListener('click', function() { loadDashboard(Number(loadMoreEvidence.dataset.nextOffset || 0), true); }, { signal: eventSignal });
							const usageRateSelect = document.getElementById('usageRateModelSelect');						if (usageRateSelect) usageRateSelect.addEventListener('change', function() { if (latestUsageAnalytics) renderUsageRateChart(latestUsageAnalytics); }, { signal: eventSignal });
							document.addEventListener('click', function(event) {
								const link = event.target.closest && event.target.closest('[data-skill-outcome-evidence]');
								if (!link) return;
								event.preventDefault();
								history.pushState({}, '', link.getAttribute('href'));
								restoreURLState();
								loadAllData(false);
							}, { signal: eventSignal });
							window.addEventListener('popstate', function() { restoreURLState(); loadAllData(false); }, { signal: eventSignal });						restoreURLState();
						setupModelHelp();
						loadAllData(false);
				}

				// Share one Chart.js load across HTMX swaps. The generation fence above
				// prevents stale page closures from initializing the current document.
				if (typeof Chart !== 'undefined') {
					setTimeout(initAnalytics, 0);
				} else {
					if (!window._analyticsChartLoader) {
						window._analyticsChartLoader = new Promise(function(resolve, reject) {
							var script = document.querySelector('script[data-analytics-chart-loader]');
							var shouldAppend = false;
							if (!script) {
								script = document.createElement('script');
								script.src = 'https://cdn.jsdelivr.net/npm/chart.js@4.4.1/dist/chart.umd.min.js';
								script.setAttribute('data-analytics-chart-loader', '');
								shouldAppend = true;
							}
							script.addEventListener('load', resolve, { once: true });
							script.addEventListener('error', reject, { once: true });
							if (shouldAppend) document.head.appendChild(script);
						});
					}
					window._analyticsChartLoader.then(initAnalytics).catch(function() {
						if (analyticsGeneration !== window._analyticsGeneration) return;
						var failedLoader = document.querySelector('script[data-analytics-chart-loader]');
						if (failedLoader) failedLoader.remove();
						window._analyticsChartLoader = null;
						var box = document.getElementById('analyticsError');
						if (box) { box.textContent = 'Analytics charts failed to load'; box.classList.remove('hidden'); }
					});
				}
				})();
			</script>
	} else {
		<div class="text-center py-12 opacity-50">
			<p>No projects yet. Create one to view analytics.</p>
		</div>
	}
}
