package pages

import (
	"github.com/openvibely/openvibely/internal/models"
	"github.com/openvibely/openvibely/web/templates/layout"
)

templ Analytics(projects []models.Project, currentProject *models.Project) {
	@layout.Base("Analytics Dashboard", projects, projectID(currentProject)) {
		@analyticsContent(currentProject)
	}
}

templ analyticsChartCard(title, description, canvasID, heightClass string) {
	<div class="card bg-base-100 border border-base-300"><div class="card-body">
		<h4 class="card-title">{ title }</h4>
		if description != "" {
			<p class="text-sm opacity-60">{ description }</p>
		}
		<div class={ "relative "+heightClass }><canvas id={ canvasID }></canvas></div>
	</div></div>
}

// AnalyticsContent renders just the analytics content for HTMX requests
templ AnalyticsContent(currentProject *models.Project) {
	@analyticsContent(currentProject)
}

templ analyticsContent(currentProject *models.Project) {
	<div class="flex justify-between items-center mb-6">
		@layout.PageTitle("Analytics Dashboard")
			<h2 class="text-2xl font-bold">Analytics Dashboard</h2>
			if currentProject != nil {
				<div class="flex gap-2 items-center">
					<span class="opacity-60">Project:</span>
					<span class="font-semibold">{ currentProject.Name }</span>
				</div>
			}
		</div>
		if currentProject != nil {
				<!-- Shared filters and reloadable view navigation -->
				<div class="mb-6" data-analytics-navigation>
					<div class="card bg-base-100 border border-base-300"><div class="card-body p-4">
						<div class="flex flex-wrap gap-4 items-end">
							<div class="form-control"><label class="label" for="dateRange"><span class="label-text">Date Range</span></label><select id="dateRange" class="select select-bordered select-sm"><option value="7">Last 7 Days</option><option value="30" selected>Last 30 Days</option><option value="90">Last 90 Days</option><option value="365">Last Year</option><option value="all">All Time</option></select></div>
							<div class="form-control"><label class="label" for="groupBy"><span class="label-text">Group By</span></label><select id="groupBy" class="select select-bordered select-sm"><option value="day" selected>Day</option><option value="week">Week</option><option value="month">Month</option></select></div>
							<label class="label cursor-pointer gap-2 pb-2" data-compare-filter><input id="comparePeriod" type="checkbox" class="checkbox checkbox-sm" checked/><span class="label-text">Compare previous period</span></label>
							<div class="form-control" data-agent-filter><label class="label" for="analyticsAgentFilter"><span class="label-text">Agent</span></label><select id="analyticsAgentFilter" class="select select-bordered select-sm"><option value="">All Agents</option></select></div>
							<div class="form-control" data-automation-filter><label class="label" for="analyticsWorkflowFilter"><span class="label-text">Automation</span></label><select id="analyticsWorkflowFilter" class="select select-bordered select-sm"><option value="">All Automations</option></select></div>
							<button id="refreshBtn" class="btn btn-primary btn-sm">Refresh</button>
						</div>
						<nav class="flex gap-2 overflow-x-auto mt-4" aria-label="Analytics views"><button class="btn btn-sm" data-analytics-view="usage">Usage</button><button class="btn btn-sm" data-analytics-view="models">Models</button><button class="btn btn-sm" data-analytics-view="learning">Learning</button><button class="btn btn-sm" data-analytics-view="agents">Agents</button></nav>
					</div></div>
				</div>
				<div id="analyticsError" class="alert alert-error hidden mb-6" role="alert"></div>

				<section id="analytics-overview" data-analytics-section="overview" class="space-y-6 mb-6">
					<div><h3 class="text-xl font-bold">Overview</h3><p class="text-sm opacity-60">What changed, what drove it, and what to inspect next.</p></div>
					<div id="analyticsKpis" class="grid grid-cols-1 sm:grid-cols-2 xl:grid-cols-3 gap-4"></div>
					@analyticsChartCard("Project outcome trend", "Run success, goal achievement, first-run success, and follow-up runs by selected interval.", "projectOutcomeTrendChart", "h-72")
					<div class="card bg-base-100 border border-base-300"><div class="card-body"><h4 class="card-title">Outcome funnel</h4><p class="text-sm opacity-60">Stage denominators are explicit because not every task is goal-bearing or merge-eligible.</p><div id="overviewOutcomeFunnel" class="flex flex-col lg:flex-row gap-2"></div></div></div>
					<div class="grid grid-cols-1 lg:grid-cols-2 gap-6"><div class="card bg-base-100 border border-base-300"><div class="card-body"><h4 class="card-title text-success">Biggest improvements</h4><div id="analyticsImprovements"></div></div></div><div class="card bg-base-100 border border-base-300"><div class="card-body"><h4 class="card-title text-warning">Needs attention</h4><div id="analyticsAttention"></div></div></div></div>
					<div class="card bg-base-100 border border-base-300"><div class="card-body"><h4 class="card-title">Actionable exceptions</h4><p class="text-sm opacity-60">Up to five repeatedly failing, slow, costly, or reworked tasks.</p><div id="actionableExceptions"></div></div></div>
					<div class="collapse collapse-arrow bg-base-100 border border-base-300"><input type="checkbox" aria-label="Show metric definitions"/><div class="collapse-title font-semibold">Metric definitions and denominators</div><div class="collapse-content"><dl id="analyticsMetricDefinitions" class="grid grid-cols-1 lg:grid-cols-2 gap-3 text-sm"></dl></div></div>
				</section>

				<section id="analytics-outcomes" data-analytics-section="outcomes" class="space-y-6 mb-6">
					<div><h3 class="text-xl font-bold">Outcomes</h3><p class="text-sm opacity-60">Visual outcome, rework, timing, and failure evidence.</p></div><div id="outcomeSummaryCards" class="grid grid-cols-1 sm:grid-cols-2 xl:grid-cols-4 gap-4"></div>
					<div class="card bg-base-100 border border-base-300"><div class="card-body"><h4 class="card-title">What changed</h4><div id="outcomeReadout"></div></div></div>
					@analyticsChartCard("Run results over time", "Completed, failed, and cancelled runs.", "successFailureChart", "h-72")
					<div class="card bg-base-100 border border-base-300"><div class="card-body"><h4 class="card-title">Detailed visual Outcome Funnel</h4><div id="outcomeFunnel" class="flex flex-col lg:flex-row gap-2"></div></div></div>
					<div class="grid grid-cols-1 lg:grid-cols-2 gap-6">@analyticsChartCard("Task duration distribution", "Elapsed time from the first run through the final result, including retries and follow-up runs.", "cycleDistributionChart", "h-64") @analyticsChartCard("Follow-up run distribution", "Follow-up run count per task.", "followupDistributionChart", "h-64")</div>
					<div class="grid grid-cols-1 lg:grid-cols-2 gap-6">@analyticsChartCard("Runs by hour", "Run starts by local hour.", "hourlyTrendsChart", "h-64") @analyticsChartCard("Average run time by task", "Completed run duration by task.", "avgTimeTaskChart", "h-64")</div>
					@analyticsChartCard("Failed Task Patterns", "Repeated failures ranked by task; select a bar to inspect the task.", "failedPatternsChart", "h-64")
					<details class="collapse collapse-arrow bg-base-100 border border-base-300"><summary class="collapse-title font-semibold">Supporting failed task records</summary><div class="collapse-content overflow-x-auto"><table class="table table-sm" id="failedPatternsTable"><thead><tr><th>Task</th><th>Failure Count</th><th>Last Error</th><th>Last Failed At</th></tr></thead><tbody></tbody></table></div></details>
					<div class="card bg-base-100 border border-base-300"><div class="card-body"><h4 class="card-title">Most Frequently Run Tasks</h4><div class="h-64 overflow-y-auto" id="frequentTasksList"></div></div></div>
					<details class="collapse collapse-arrow bg-base-100 border border-base-300"><summary class="collapse-title font-semibold">Supporting task evidence</summary><div class="collapse-content"><p id="outcomeEvidenceFilter" class="text-sm opacity-60"></p><div class="overflow-x-auto"><table class="table table-sm"><thead><tr><th>Task</th><th>Run result</th><th>Goal</th><th>Agent</th><th>Model</th><th>Runs</th><th>Follow-up runs</th><th>Task duration</th><th>Known cost</th></tr></thead><tbody id="outcomeEvidenceTable"></tbody></table></div><button id="loadMoreEvidence" type="button" class="btn btn-sm btn-outline hidden">Load more evidence</button></div></details>
				</section>

				<section id="analytics-agents" data-analytics-section="agents" class="space-y-6 mb-6">
					<div><h3 class="text-xl font-bold">Agents</h3><p class="text-sm opacity-60">Compare reusable Agent definitions and inspect how each one performs.</p></div>
					<div class="grid grid-cols-1 lg:grid-cols-2 gap-6">@analyticsChartCard("Agent outcome comparison", "Goal achievement, first-run success, and follow-up runs with sample sizes.", "agentComparisonChart", "h-80") @analyticsChartCard("Quality versus efficiency", "Outcome quality against duration or covered cost.", "agentEfficiencyChart", "h-80")</div>
					<div id="agentDetail">@analyticsChartCard("Selected Agent outcome trend", "Select an Agent for period detail.", "agentOutcomeTrendChart", "h-64")</div>
					@analyticsChartCard("Performance by task category", "Run success, goal achievement, and follow-up runs for the selected Agent.", "agentCategoryChart", "h-72")
					<div class="card bg-base-100 border border-base-300"><div class="card-body"><h4 class="card-title">Agent findings</h4><div id="agentFindings" style="min-height:7.5rem"></div></div></div>
					<details class="collapse collapse-arrow bg-base-100 border border-base-300"><summary class="collapse-title font-semibold">Exact values and category evidence</summary><div class="collapse-content space-y-4"><div class="overflow-x-auto"><table class="table table-sm"><thead><tr><th>Agent</th><th>Tasks</th><th>Run success</th><th>Goal</th><th>First-run success</th><th>Follow-up runs</th><th>Task duration</th><th>Cost / goal</th></tr></thead><tbody id="agentPerformanceTable"></tbody></table></div><table class="table table-sm"><tbody id="agentCategoryTable"></tbody></table><table class="table table-sm"><tbody id="agentFailureTable"></tbody></table><table class="table table-sm"><tbody id="agentSkillTable"></tbody></table></div></details>
					<details class="collapse collapse-arrow bg-base-100 border border-base-300"><summary class="collapse-title font-semibold">Supporting Agent tasks</summary><div class="collapse-content"><table class="table table-sm"><tbody id="agentEvidenceTable"></tbody></table></div></details>
				</section>
				<section id="analytics-models" data-analytics-section="models" class="space-y-6 mb-6">
					<div class="flex items-center gap-2">
						<h3 class="text-xl font-bold">Models</h3>
						<button type="button" class="btn btn-ghost btn-circle btn-xs" data-model-attribution-help
							data-model-help="Tasks with activity in the selected period. Runs are counted by start date; tokens and cost by usage date. Only activity in the selected period is included. Mixed configurations are kept separate. Model labels use the saved configuration; different task difficulty and changing goals affect comparisons."
							aria-label="Tasks with activity in the selected period. Runs are counted by start date; tokens and cost by usage date. Only activity in the selected period is included. Mixed configurations are kept separate. Model labels use the saved configuration; different task difficulty and changing goals affect comparisons."
						>
							<svg xmlns="http://www.w3.org/2000/svg" class="h-4 w-4" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2" aria-hidden="true"><circle cx="12" cy="12" r="9"></circle><path stroke-linecap="round" d="M12 11v6"></path><path stroke-linecap="round" d="M12 7h.01"></path></svg>
						</button>
					</div>
					<div id="modelMetricHelp" popover="auto" role="tooltip" class="bg-base-100 text-base-content border border-base-300 rounded-lg shadow-xl p-3 text-sm" style="position:fixed;margin:0;width:min(360px,calc(100vw - 16px));max-height:calc(100vh - 16px);overflow:auto"></div>
					<div class="card bg-base-100 border border-base-300"><div class="card-body">
						<h4 class="card-title">Model comparison</h4>
						<p class="text-sm opacity-60">Goals met, work delivered, and the effort required. Follow-ups can reflect changed goals—not just corrections.</p>
						<div id="modelScorecard" class="overflow-x-auto" style="min-height:12rem"></div>
					</div></div>
					<div class="grid grid-cols-1 xl:grid-cols-2 gap-6">
						@analyticsChartCard("Run time per task by model", "Median total run time per task for runs started in the selected period. Includes scheduled tasks; excludes waiting between runs and unfinished runs. Mixed models excluded.", "modelTimeChart", "h-80")
						@analyticsChartCard("Tokens per task by model", "Average recorded tokens, including unsuccessful work. Lower means less usage. Mixed models excluded.", "modelTokensChart", "h-80")
					</div>
					<p class="text-sm opacity-60">Trends show the six busiest single-model configurations, grouped by each task's latest activity date in the selected period. Goal and merge statuses reflect what is known now.</p>
					<div class="grid grid-cols-1 xl:grid-cols-2 gap-6">
						@analyticsChartCard("Goal achievement over time", "Are more tasks meeting their goals? Hover for each period's task count. Missing evidence leaves a gap.", "modelGoalsTrendChart", "h-80")
						@analyticsChartCard("Merged work over time", "Are more eligible tasks getting delivered? This is separate from whether their goals were met.", "modelMergesTrendChart", "h-80")
					</div>
				</section>

				<section id="analytics-automations" data-analytics-section="automations" class="space-y-6 mb-6">
					<div><h3 class="text-xl font-bold">Automations</h3><p class="text-sm opacity-60">Automation graph invocation and node behavior.</p></div>
					@analyticsChartCard("Automation comparison", "Invocation, completion, failure, duration, and current waiting state.", "automationComparisonChart", "h-80")<div id="automationEmptyState" class="hidden alert"></div>
					<div id="workflowDetail" class="space-y-6">@analyticsChartCard("Visual node funnel", "Entered count and conversion through the graph.", "automationFunnelChart", "h-72")<div class="grid grid-cols-1 lg:grid-cols-2 gap-6">@analyticsChartCard("Duration by node", "Average elapsed transition time.", "automationDurationChart", "h-64") @analyticsChartCard("Failures by node", "Failed activity count.", "automationFailureChart", "h-64")</div>@analyticsChartCard("Current bottlenecks", "Current waiting and blocked positions.", "automationBottleneckChart", "h-64")</div>
						<div class="card bg-base-100 border border-base-300"><div class="card-body"><h4 class="card-title">Automation findings</h4><div id="automationFindings"></div></div></div>
					<details id="automationExactValues" class="collapse collapse-arrow bg-base-100 border border-base-300"><summary class="collapse-title font-semibold">Exact automation and node values</summary><div class="collapse-content"><table class="table table-sm"><tbody id="workflowPerformanceTable"></tbody></table><table class="table table-sm"><tbody id="workflowFunnelTable"></tbody></table><table class="table table-sm"><tbody id="workflowDurationTable"></tbody></table><table class="table table-sm"><tbody id="workflowFailureTable"></tbody></table><table class="table table-sm"><tbody id="workflowBottleneckTable"></tbody></table></div></details>
				</section>

				<section id="analytics-learning" data-analytics-section="learning" class="space-y-6 mb-6">
					<div><h3 class="text-xl font-bold">Learning</h3><p class="text-sm opacity-60">Observed skill activity and outcomes. Association only; not causation.</p><p id="skillEvidenceSelection" class="hidden"></p></div>
					<div class="grid grid-cols-1 lg:grid-cols-2 gap-6">@analyticsChartCard("Skill Activity Over Time", "Created, edited, and used skill activity.", "skillUsageTrendChart", "h-64") @analyticsChartCard("Top Skills", "Highest skill activity by event type.", "skillTopChart", "h-64") @analyticsChartCard("Follow-through / Selected Outcomes", "Selected skills later used or ignored.", "skillFollowChart", "h-64") @analyticsChartCard("Top Agent/Skill Pairs", "Most active Agent and skill combinations.", "skillAgentChart", "h-64")</div>
					<div class="card bg-base-100 border border-base-300"><div class="card-body"><h4 class="card-title">Least Active Enabled Skills</h4><table class="table table-sm"><tbody id="underusedSkillsTable"></tbody></table></div></div>
					<div class="grid grid-cols-1 lg:grid-cols-2 gap-6 items-start">@analyticsChartCard("Observed skill outcomes", "The 12 most-used skills; exact values remain available below.", "skillOutcomeChart", "h-72") @analyticsChartCard("Skill outcomes versus usage", "Farther right means used on more tasks; higher means more goals achieved. Association only.", "skillEffectivenessChart", "h-72")</div>
					<div class="card bg-base-100 border border-base-300"><div class="card-body"><h4 class="card-title">Observed skill signals</h4><div id="skillRecommendations"></div><p class="text-xs opacity-60">Associations are not causal. Memory effectiveness is unavailable because reliable outcome instrumentation does not exist.</p></div></div>
					<details class="collapse collapse-arrow bg-base-100 border border-base-300"><summary class="collapse-title font-semibold">Exact skill outcome values</summary><div class="collapse-content"><table class="table table-sm"><tbody id="skillOutcomeTable"></tbody></table><table class="table table-sm"><tbody id="agentSkillOutcomeTable"></tbody></table></div></details>
					<details id="skillEventEvidenceCard" class="collapse collapse-arrow bg-base-100 border border-base-300 hidden"><summary class="collapse-title font-semibold">Supporting skill events</summary><div class="collapse-content"><p id="skillEventEvidenceCoverage"></p><table class="table table-sm"><tbody id="skillEventEvidenceTable"></tbody></table></div></details>
				</section>

				<section id="analytics-usage" data-analytics-section="usage" class="space-y-6 mb-6">
					<div><h3 class="text-xl font-bold">Usage</h3><p class="text-sm opacity-60">Provider limits, token usage, cache utilization, and recorded cost.</p><p id="usageEvidenceSelection" class="hidden"></p></div>
					<div id="usageSummary" class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-3 gap-4">
						for _, label := range []string{"Known total cost", "Total tokens", "Cache utilization"} {
							<div class="card bg-base-100 border border-base-300"><div class="card-body p-4"><span class="text-sm">{ label }</span><strong data-usage-summary-value class="text-center opacity-50 font-normal text-base" style="min-height:1.5rem" aria-live="polite">Loading analytics…</strong></div></div>
						}
					</div>
					<div><h4 class="font-semibold mb-2">Provider Account Limits</h4><div id="accountUsageCards" class="relative grid grid-cols-1 lg:grid-cols-2 gap-6" style="min-height:12rem">
						for range 2 {
							<div class="card bg-base-100 border border-base-300" style="min-height:12rem"><div class="card-body"><p class="text-center opacity-50 py-12">Loading analytics…</p></div></div>
						}
					</div></div>
					<div class="card bg-base-100 border border-base-300"><div class="card-body"><h4 class="card-title">Usage readout</h4><div id="usageFindings" style="min-height:7.5rem"><p class="text-center opacity-50 py-12">Loading analytics…</p></div></div></div>
					<div class="grid grid-cols-1 lg:grid-cols-2 gap-6"><div class="card bg-base-100 border border-base-300"><div class="card-body"><div class="flex flex-wrap items-end justify-between gap-3 mb-2 min-w-0"><h4 class="card-title">Token Usage</h4><div class="form-control min-w-0 w-full sm:w-auto"><select id="usageRateModelSelect" class="select select-bordered select-xs w-full max-w-full sm:min-w-48"></select></div></div><div class="relative h-64"><canvas id="usageRateChart"></canvas></div></div></div>@analyticsChartCard("Model Breakdown by Tokens", "Recorded token share by model.", "modelTokenBreakdownChart", "h-64")</div>
					<div class="card bg-base-100 border border-base-300"><div class="card-body"><div class="flex justify-between"><h4 class="card-title">Token Usage Breakdown</h4><span id="usageLastUpdated" class="text-xs opacity-60"></span></div><table class="table table-sm"><tbody id="usageBreakdownTable"></tbody></table></div></div>
					<details id="usageEventEvidenceCard" class="collapse collapse-arrow bg-base-100 border border-base-300 hidden"><summary class="collapse-title font-semibold">Supporting usage events</summary><div class="collapse-content"><p id="usageEventEvidenceCoverage"></p><table class="table table-sm"><tbody id="usageEventEvidenceTable"></tbody></table></div></details>
				</section>
			<!-- Chart.js and Custom Script -->
			<div id="analytics-data" data-project-id={ currentProject.ID } class="hidden"></div>
			<script type="text/javascript">
				(function() {
				window._analyticsGeneration = (window._analyticsGeneration || 0) + 1;
				const analyticsGeneration = window._analyticsGeneration;
				// Destroy any charts from a previous analytics page visit
				if (window._analyticsCharts) {
					Object.values(window._analyticsCharts).forEach(function(c) {
						try { c.destroy(); } catch(e) {}
					});
				}
					window._analyticsCharts = {};
					if (window._analyticsAbortController) window._analyticsAbortController.abort();
					window._analyticsAbortController = new AbortController();
					if (window._analyticsDataAbortController) window._analyticsDataAbortController.abort();

					function initAnalytics() {
					if (analyticsGeneration !== window._analyticsGeneration) return;
					var dataEl = document.getElementById('analytics-data');
					if (!dataEl) return;
					var projectID = dataEl.dataset.projectId;
						var charts = window._analyticsCharts;
						var eventSignal = window._analyticsAbortController.signal;
								var latestUsageAnalytics = null;
								var latestDashboard = null;
								var evidencePageLoading = false;
								var preserveActiveCharts = false;
								var evidenceRequestGeneration = 0;
								var skillEvidenceRequest = 0;
								var usageEvidenceRequest = 0;
								var dataGeneration = 0;
									var dataAbortController = null;
									function abortAnalyticsData() {
										dataGeneration++;
										evidenceRequestGeneration++;
										skillEvidenceRequest++;
										usageEvidenceRequest++;
										if (dataAbortController) dataAbortController.abort();
									}
									function beginDataGeneration() {
										abortAnalyticsData();
										dataAbortController = new AbortController();
									window._analyticsDataAbortController = dataAbortController;
									latestDashboard = null;
									evidencePageLoading = false;
									showAnalyticsLoading();
									const loadMore = document.getElementById('loadMoreEvidence');
									if (loadMore) { loadMore.disabled = true; loadMore.classList.add('hidden'); loadMore.removeAttribute('aria-busy'); }
								}							// Fetch JSON for the current filter generation only. Never preserve stale data.
							async function fetchJSON(url) {
								const requestGeneration = dataGeneration;
								const controller = dataAbortController;
								const response = await fetch(url, controller ? { signal: controller.signal } : undefined);
								if (!response.ok) throw new Error('Analytics request failed (' + response.status + ')');
								const data = await response.json();
								if (requestGeneration !== dataGeneration || (controller && controller.signal.aborted)) throw new DOMException('Stale Analytics response', 'AbortError');
									return data;
								}
								function leaveAnalytics() {
									abortAnalyticsData();
									if (analyticsGeneration === window._analyticsGeneration) window._analyticsGeneration++;
									if (window._analyticsAbortController && !window._analyticsAbortController.signal.aborted) window._analyticsAbortController.abort();
								}
								function navigationLeavesAnalytics(event) {
									const link = event.target && event.target.closest ? event.target.closest('a[href], [data-nav-base]') : null;
									if (!link) return false;
									const destination = link.getAttribute('hx-get') || link.getAttribute('href') || link.getAttribute('data-nav-base');
									if (!destination) return false;
									try { return new URL(destination, window.location.href).pathname !== '/analytics'; } catch (_) { return false; }
								}
								document.addEventListener('pointerdown', function(event) {
									if (navigationLeavesAnalytics(event)) leaveAnalytics();
								}, { capture: true, signal: eventSignal });
								document.body.addEventListener('htmx:beforeRequest', function(event) {
									const detail = event.detail || {};
									const target = detail.target || (detail.requestConfig && detail.requestConfig.target);
									const path = detail.pathInfo && detail.pathInfo.requestPath;
									if (target && target.id === 'main-content' && path && new URL(path, window.location.href).pathname !== '/analytics') leaveAnalytics();
								}, { signal: eventSignal });
								window.addEventListener('pagehide', leaveAnalytics, { once: true, signal: eventSignal });
						function destroyChart(key) {
							if (!charts[key]) return;
							try { charts[key].destroy(); } catch (e) {}
							delete charts[key];
						}
							function showAnalyticsError(error) {
								finishPanelLoading(true);
								if (error && error.name === 'AbortError') return;
								Object.keys(charts).forEach(destroyChart);								const box = document.getElementById('analyticsError');
								box.textContent = error && error.message ? error.message : 'Analytics request failed';
								box.classList.remove('hidden');
								[['recentOutcomesTable',10],['outcomeEvidenceTable',9],['agentPerformanceTable',8],['agentEvidenceTable',6],['agentCategoryTable',5],['agentFailureTable',3],['agentSkillTable',5],['workflowPerformanceTable',10],['workflowFunnelTable',3],['workflowDurationTable',3],['workflowFailureTable',3],['workflowBottleneckTable',3],['skillOutcomeTable',5],['agentSkillOutcomeTable',6],['skillEventEvidenceTable',7],['usageBreakdownTable',8],['usageEventEvidenceTable',8],['underusedSkillsTable',4]].forEach(function(item) {
									const table = document.getElementById(item[0]);
									if (table) table.innerHTML = '\x3ctr>\x3ctd colspan="' + item[1] + '" class="text-center opacity-50">Analytics unavailable\x3c/td>\x3c/tr>';
								});
								['analyticsKpis','analyticsMetricDefinitions','outcomeFunnel','analyticsImprovements','analyticsAttention','modelScorecard','frequentTasksList'].forEach(function(id) { const node=document.getElementById(id); if (node) node.textContent='Analytics unavailable'; });
								document.querySelectorAll('[data-usage-summary-value]').forEach(node=>node.textContent='Analytics unavailable');
