								usageContext.innerHTML = [['Known cost / achieved goal', costCoverageText(current.known_cost_per_achieved_goal)], ['Known cost / technical completion', costCoverageText(current.known_cost_per_completed_task)], ['Known failed execution cost', current.known_failed_execution_cost ? formatCost(current.known_failed_execution_cost.value) + ' recorded across ' + current.known_failed_execution_cost.covered + ' of ' + current.known_failed_execution_cost.eligible + ' failed executions' : 'Unavailable'], ['Tokens / achieved goal', current.tokens_per_achieved_goal ? formatNumber(current.tokens_per_achieved_goal.value) + ' across ' + current.tokens_per_achieved_goal.covered + ' of ' + current.tokens_per_achieved_goal.eligible : 'Unavailable'], ['Cache utilization', cacheText]].map(function(item) { return '<div class="card bg-base-100 border border-base-300"><div class="card-body p-4"><span class="text-sm">' + escapeHTML(item[0]) + '</span><strong>' + escapeHTML(item[1]) + '</strong></div></div>'; }).join('');
