package pages

import (
	"github.com/openvibely/openvibely/internal/models"
	"github.com/openvibely/openvibely/web/templates/layout"
)

templ Analytics(projects []models.Project, currentProject *models.Project) {
	@layout.Base("Analytics Dashboard", projects, projectID(currentProject)) {
		@analyticsContent(currentProject)
	}
}

// AnalyticsContent renders just the analytics content for HTMX requests
templ AnalyticsContent(currentProject *models.Project) {
	@analyticsContent(currentProject)
}

templ analyticsContent(currentProject *models.Project) {
	<div class="flex justify-between items-center mb-6">
		@layout.PageTitle("Analytics Dashboard")
			<h2 class="text-2xl font-bold">Analytics Dashboard</h2>
			if currentProject != nil {
				<div class="flex gap-2 items-center">
					<span class="opacity-60">Project:</span>
					<span class="font-semibold">{ currentProject.Name }</span>
				</div>
			}
		</div>
		if currentProject != nil {
				<!-- Shared filters and reloadable view navigation -->
				<div class="sticky top-0 z-20 bg-base-200/95 backdrop-blur pb-3 mb-6" data-analytics-navigation>
					<div class="card bg-base-100 shadow-sm border border-base-300">
						<div class="card-body p-4">
							<div class="flex flex-wrap gap-4 items-end">
								<div class="form-control"><label class="label" for="dateRange"><span class="label-text">Date Range</span></label><select id="dateRange" class="select select-bordered select-sm"><option value="7">Last 7 Days</option><option value="30" selected>Last 30 Days</option><option value="90">Last 90 Days</option><option value="365">Last Year</option><option value="all">All Time</option></select></div>
								<div class="form-control"><label class="label" for="groupBy"><span class="label-text">Group By</span></label><select id="groupBy" class="select select-bordered select-sm"><option value="day" selected>Day</option><option value="week">Week</option><option value="month">Month</option></select></div>
								<label class="label cursor-pointer gap-2 pb-2"><input id="comparePeriod" type="checkbox" class="checkbox checkbox-sm" checked/><span class="label-text">Compare previous period</span></label>
								<div class="form-control"><label class="label" for="analyticsAgentFilter"><span class="label-text">Agent</span></label><select id="analyticsAgentFilter" class="select select-bordered select-sm"><option value="">All Agents</option></select></div>
								<div class="form-control"><label class="label" for="analyticsWorkflowFilter"><span class="label-text">Workflow</span></label><select id="analyticsWorkflowFilter" class="select select-bordered select-sm"><option value="">All Workflows</option></select></div>
								<button id="refreshBtn" class="btn btn-primary btn-sm">Refresh</button>
							</div>
							<nav class="flex gap-2 overflow-x-auto mt-4 pb-1" aria-label="Analytics views"><button class="btn btn-sm whitespace-nowrap" data-analytics-view="overview">Overview</button><button class="btn btn-sm whitespace-nowrap" data-analytics-view="outcomes">Outcomes</button><button class="btn btn-sm whitespace-nowrap" data-analytics-view="agents">Agents</button><button class="btn btn-sm whitespace-nowrap" data-analytics-view="workflows">Workflows</button><button class="btn btn-sm whitespace-nowrap" data-analytics-view="learning">Learning</button><button class="btn btn-sm whitespace-nowrap" data-analytics-view="usage">Usage</button><button class="btn btn-sm whitespace-nowrap" data-analytics-view="all">All Metrics</button></nav>
						</div>
					</div>
					<nav id="analyticsJumpLinks" class="hidden flex gap-3 overflow-x-auto pt-2 text-sm" aria-label="Jump to analytics section"><a class="link" href="#analytics-overview">Overview</a><a class="link" href="#analytics-outcomes">Outcomes</a><a class="link" href="#analytics-agents">Agents</a><a class="link" href="#analytics-workflows">Workflows</a><a class="link" href="#analytics-learning">Learning</a><a class="link" href="#analytics-usage">Usage</a></nav>
				</div>
				<div id="analyticsError" class="alert alert-error hidden mb-6" role="alert"></div>
				<section id="analytics-overview" data-analytics-section="overview" class="space-y-6 mb-6">
					<div><h3 class="text-xl font-bold">Overview</h3><p class="text-sm opacity-60">Task outcomes with technical status kept separate from goal evidence.</p></div>
					<div id="analyticsKpis" class="grid grid-cols-1 sm:grid-cols-2 xl:grid-cols-4 gap-4"></div>
					<div class="collapse collapse-arrow bg-base-100 border border-base-300"><input type="checkbox" aria-label="Show metric definitions"/><div class="collapse-title font-semibold">Metric definitions and denominators</div><div class="collapse-content"><dl id="analyticsMetricDefinitions" class="grid grid-cols-1 lg:grid-cols-2 gap-3 text-sm"></dl></div></div>
					<div class="grid grid-cols-1 lg:grid-cols-2 gap-6"><div class="card bg-base-100 border border-base-300"><div class="card-body"><h4 class="card-title text-success">Notable improvements</h4><div id="analyticsImprovements"><p class="opacity-50">No supported comparison insight yet.</p></div></div></div><div class="card bg-base-100 border border-base-300"><div class="card-body"><h4 class="card-title text-warning">Needs attention</h4><div id="analyticsAttention"><p class="opacity-50">No supported attention insight yet.</p></div></div></div></div>
					<div class="card bg-base-100 border border-base-300"><div class="card-body"><h4 class="card-title">Recent outcomes</h4><div class="overflow-x-auto"><table class="table table-sm"><thead><tr><th>Task</th><th>Technical result</th><th>Goal result</th><th>Merge/review</th><th>Agent definition</th><th>Model</th><th>Executions</th><th>Follow-ups</th><th>Cycle time</th><th>Known cost</th></tr></thead><tbody id="recentOutcomesTable"></tbody></table></div></div></div>
				</section>
					<section id="analytics-outcomes" data-analytics-section="outcomes" class="space-y-6 mb-6"><div><h3 class="text-xl font-bold">Outcomes</h3><p class="text-sm opacity-60">Execution completion is not proof that a goal was achieved.</p></div><div class="card bg-base-100 border border-base-300"><div class="card-body"><h4 class="card-title">Outcome funnel</h4><div id="outcomeFunnel" class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-5 gap-3"></div></div></div><div class="grid grid-cols-1 lg:grid-cols-2 gap-6"><div class="card bg-base-100 border border-base-300"><div class="card-body"><h4 class="card-title">Cycle-time distribution</h4><div class="h-64"><canvas id="cycleDistributionChart"></canvas></div></div></div><div class="card bg-base-100 border border-base-300"><div class="card-body"><h4 class="card-title">Follow-up / rework distribution</h4><div class="h-64"><canvas id="followupDistributionChart"></canvas></div></div></div></div><div class="card bg-base-100 border border-base-300"><div class="card-body"><h4 class="card-title">Task-level outcome evidence</h4><p id="outcomeEvidenceFilter" class="text-sm opacity-60">Project-scoped task evidence for the selected filters.</p><div class="overflow-x-auto"><table class="table table-sm"><thead><tr><th>Task</th><th>Technical result</th><th>Goal result</th><th>Agent</th><th>Model</th><th>Executions</th><th>Follow-ups</th><th>Cycle time</th><th>Known cost</th></tr></thead><tbody id="outcomeEvidenceTable"></tbody></table></div><div class="card-actions justify-center mt-3"><button id="loadMoreEvidence" type="button" class="btn btn-sm btn-outline hidden">Load more evidence</button></div></div></div></section>					<section id="analytics-agents" data-analytics-section="agents" class="space-y-6 mb-6">
						<div><h3 class="text-xl font-bold">Agent performance</h3><p class="text-sm opacity-60">Reusable Agent definitions, separate from model configurations. Select an Agent for detailed evidence.</p></div>
						<div class="card bg-base-100 border border-base-300"><div class="card-body"><div class="overflow-x-auto"><table class="table table-sm"><thead><tr><th>Agent</th><th>Tasks</th><th>Technical completion</th><th>Goal achievement</th><th>First pass</th><th>Follow-up</th><th>Duration</th><th>Cost / achieved goal</th><th>Most-used model</th></tr></thead><tbody id="agentPerformanceTable"></tbody></table></div></div></div>
						<div id="agentDetail" class="grid grid-cols-1 lg:grid-cols-2 gap-6">
							<div class="card bg-base-100 border border-base-300"><div class="card-body"><h4 class="card-title text-lg">Selected Agent outcome trend</h4><div class="h-64"><canvas id="agentOutcomeTrendChart"></canvas></div></div></div>
							<div class="card bg-base-100 border border-base-300"><div class="card-body"><h4 class="card-title text-lg">Selected Agent model mix</h4><div class="h-64"><canvas id="agentModelMixChart"></canvas></div></div></div>
							<div class="card bg-base-100 border border-base-300"><div class="card-body"><h4 class="card-title text-lg">Performance by task category</h4><div class="overflow-x-auto"><table class="table table-sm"><thead><tr><th>Category</th><th>Tasks</th><th>Technical</th><th>Goal</th><th>Follow-up</th></tr></thead><tbody id="agentCategoryTable"></tbody></table></div></div></div>
							<div class="card bg-base-100 border border-base-300"><div class="card-body"><h4 class="card-title text-lg">Recurring failures</h4><div class="overflow-x-auto"><table class="table table-sm"><thead><tr><th>Task</th><th>Failures</th><th>Last error</th></tr></thead><tbody id="agentFailureTable"></tbody></table></div></div></div>
							<div class="card bg-base-100 border border-base-300 lg:col-span-2"><div class="card-body"><h4 class="card-title text-lg">Skills used by selected Agent</h4><div class="overflow-x-auto"><table class="table table-sm"><thead><tr><th>Skill</th><th>Tasks</th><th>Technical</th><th>Goal</th><th>Follow-up</th></tr></thead><tbody id="agentSkillTable"></tbody></table></div></div></div>
						</div>
						<div class="card bg-base-100 border border-base-300"><div class="card-body"><h4 class="card-title text-lg">Recent supporting tasks for selected Agent</h4><div class="overflow-x-auto"><table class="table table-sm"><thead><tr><th>Task</th><th>Technical result</th><th>Goal result</th><th>Model</th><th>Executions</th><th>Follow-ups</th></tr></thead><tbody id="agentEvidenceTable"></tbody></table></div></div></div>
					</section>
					<section id="analytics-workflows" data-analytics-section="workflows" class="space-y-6 mb-6">
						<div><h3 class="text-xl font-bold">Workflow performance</h3><p class="text-sm opacity-60">Automation invocations use the selected period; waiting, blocked, bottleneck, and health values are current state.</p></div>
						<div class="card bg-base-100 border border-base-300"><div class="card-body"><div class="overflow-x-auto"><table class="table table-sm"><thead><tr><th>Workflow</th><th>Invocations</th><th>Completion</th><th>Failures</th><th>Duration</th><th>Waiting / blocked</th><th>Known cost</th><th>Health</th></tr></thead><tbody id="workflowPerformanceTable"></tbody></table></div></div></div>
						<div id="workflowDetail" class="grid grid-cols-1 lg:grid-cols-2 gap-6">
							<div class="card bg-base-100 border border-base-300"><div class="card-body"><h4 class="card-title text-lg">Node funnel</h4><div class="overflow-x-auto"><table class="table table-sm"><thead><tr><th>Node</th><th>Entered</th><th>Conversion</th></tr></thead><tbody id="workflowFunnelTable"></tbody></table></div></div></div>
							<div class="card bg-base-100 border border-base-300"><div class="card-body"><h4 class="card-title text-lg">Node durations</h4><div class="overflow-x-auto"><table class="table table-sm"><thead><tr><th>Node</th><th>Samples</th><th>Average</th></tr></thead><tbody id="workflowDurationTable"></tbody></table></div></div></div>
							<div class="card bg-base-100 border border-base-300"><div class="card-body"><h4 class="card-title text-lg">Node failures</h4><div class="overflow-x-auto"><table class="table table-sm"><thead><tr><th>Node</th><th>Count</th><th>Last failure</th></tr></thead><tbody id="workflowFailureTable"></tbody></table></div></div></div>
							<div class="card bg-base-100 border border-base-300"><div class="card-body"><h4 class="card-title text-lg">Current bottlenecks</h4><div class="overflow-x-auto"><table class="table table-sm"><thead><tr><th>Node</th><th>Waiting</th><th>Blocked</th></tr></thead><tbody id="workflowBottleneckTable"></tbody></table></div></div></div>
						</div>
					</section>
					<section id="analytics-learning" data-analytics-section="learning" class="space-y-4"><div><h3 class="text-xl font-bold mt-6">Learning</h3><p class="text-sm opacity-60">Observed skill activity and task outcomes; association is not causation.</p><p id="skillEvidenceSelection" class="text-sm font-medium hidden"></p></div><div id="skillEventEvidenceCard" class="card bg-base-100 border border-base-300 hidden"><div class="card-body"><h4 class="card-title text-lg">Supporting skill events</h4><p id="skillEventEvidenceCoverage" class="text-sm opacity-60"></p><div class="overflow-x-auto"><table class="table table-sm"><thead><tr><th>Event</th><th>Time</th><th>Skill</th><th>Agent</th><th>Type</th><th>Source / surface</th><th>Task / execution</th></tr></thead><tbody id="skillEventEvidenceTable"></tbody></table></div></div></div><div class="card bg-base-100 border border-base-300"><div class="card-body"><h4 class="card-title text-lg">Observed outcomes among tasks using skills</h4><p class="text-sm opacity-60">Tasks where a skill was selected or loaded in the selected period. Small samples are descriptive only.</p><div class="overflow-x-auto"><table class="table table-sm"><thead><tr><th>Skill</th><th>Tasks</th><th>Technical task outcome</th><th>Goal achievement</th><th>Follow-up</th></tr></thead><tbody id="skillOutcomeTable"></tbody></table></div></div></div><div class="card bg-base-100 border border-base-300"><div class="card-body"><h4 class="card-title text-lg">Observed outcomes by Agent and skill</h4><p class="text-sm opacity-60">Agent-definition and skill combinations observed on tasks; association is not causation.</p><div class="overflow-x-auto"><table class="table table-sm"><thead><tr><th>Agent</th><th>Skill</th><th>Tasks</th><th>Technical</th><th>Goal</th><th>Follow-up</th></tr></thead><tbody id="agentSkillOutcomeTable"></tbody></table></div></div></div></section>
					<div id="analytics-usage" data-analytics-section="usage"><h3 class="text-xl font-bold mt-6">Usage</h3><p class="text-sm opacity-60 mb-4">Local provider usage and available recorded cost.</p><p id="usageEvidenceSelection" class="text-sm font-medium hidden mb-4"></p><div id="usageEventEvidenceCard" class="card bg-base-100 border border-base-300 mb-6 hidden"><div class="card-body"><h4 class="card-title text-lg">Supporting usage events</h4><p id="usageEventEvidenceCoverage" class="text-sm opacity-60"></p><div class="overflow-x-auto"><table class="table table-sm"><thead><tr><th>Event</th><th>Time</th><th>Provider / model</th><th>Operation</th><th>Status</th><th>Tokens</th><th>Cost</th><th>Task / execution</th></tr></thead><tbody id="usageEventEvidenceTable"></tbody></table></div></div></div><div id="usageOutcomeContext" class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-4 gap-4 mb-6"></div><div class="card bg-base-100 border border-base-300 mb-6"><div class="card-body"><h4 class="card-title text-lg">Model performance by task category</h4><p class="text-sm opacity-60">Technical terminal outcomes only; every row shows its sample.</p><div class="overflow-x-auto"><table class="table table-sm"><thead><tr><th>Model</th><th>Task category</th><th>Tasks</th><th>Technical completion</th></tr></thead><tbody id="modelCategoryTable"></tbody></table></div></div></div></div>
					<!-- Provider Account Cards: current account state, intentionally independent of the date window. -->
					<div class="mb-2"><h3 class="text-lg font-semibold">Provider account limits</h3><p class="text-xs opacity-60">Current account state · not date-filtered</p></div>
					<div id="accountUsageCards" class="grid grid-cols-1 lg:grid-cols-2 gap-6 mb-6">					<p class="opacity-50 lg:col-span-2">No connected OAuth account snapshots yet.</p>
				</div>
				<!-- Usage Charts -->
				<div class="grid grid-cols-1 lg:grid-cols-2 gap-6 mb-6">
					<div class="card bg-base-100 shadow-sm border border-base-300">
						<div class="card-body">
							<div class="flex flex-wrap items-end justify-between gap-3 mb-2 min-w-0">
								<h3 class="card-title text-lg">Token Usage</h3>
								<div class="form-control min-w-0 w-full sm:w-auto">
									<select id="usageRateModelSelect" class="select select-bordered select-xs w-full max-w-full sm:min-w-48"></select>
								</div>
							</div>
							<div class="relative h-64"><canvas id="usageRateChart"></canvas></div>
						</div>
					</div>
					<div class="card bg-base-100 shadow-sm border border-base-300">
						<div class="card-body">
							<h3 class="card-title text-lg">Model Breakdown by Tokens</h3>
							<div class="h-64">
								<canvas id="modelTokenBreakdownChart"></canvas>
							</div>
						</div>
					</div>
				</div>
				<!-- Token Usage Tracking -->
				<div class="card bg-base-100 shadow-sm border border-base-300 mb-6 self-start h-fit">
					<div class="card-body">
						<div class="flex items-center justify-between gap-3 mb-2">
							<h3 class="card-title text-lg">Token Usage Breakdown</h3>
							<span id="usageLastUpdated" class="text-xs opacity-60">Usage loading…</span>
						</div>
						<div class="overflow-x-auto">
							<table class="table table-sm">
								<thead><tr><th>Provider</th><th>Model</th><th>Input</th><th>Output</th><th>Cache</th><th>Reasoning</th><th>Total</th><th>Cost</th></tr></thead>
								<tbody id="usageBreakdownTable"><tr><td colspan="8" class="text-center opacity-50">No usage recorded yet</td></tr></tbody>
							</table>
						</div>
					</div>
				</div>
				<!-- Charts Grid -->
				<div class="grid grid-cols-1 lg:grid-cols-2 gap-6">				<!-- Success/Failure Rates -->
				<div class="card bg-base-100 shadow-sm border border-base-300">
					<div class="card-body">
						<h3 class="card-title text-lg">Technical Execution Completion Over Time</h3>
						<div class="relative h-64">
							<canvas id="successFailureChart"></canvas>
						</div>
					</div>
				</div>
				<!-- Execution Trends by Hour -->
				<div class="card bg-base-100 shadow-sm border border-base-300">
					<div class="card-body">
						<h3 class="card-title text-lg">Task Execution by Hour</h3>
						<div class="h-64">
							<canvas id="hourlyTrendsChart"></canvas>
						</div>
					</div>
				</div>
				<!-- Average Execution Time by Task -->
				<div class="card bg-base-100 shadow-sm border border-base-300">
					<div class="card-body">
						<h3 class="card-title text-lg">Average Execution Time by Task</h3>
						<div class="h-64">
							<canvas id="avgTimeTaskChart"></canvas>
						</div>
					</div>
				</div>
					<!-- Average Execution Time by Model -->
					<div class="card bg-base-100 shadow-sm border border-base-300">
						<div class="card-body">
							<h3 class="card-title text-lg">Average Execution Time by Model</h3>
							<div class="h-64">
								<canvas id="avgTimeAgentChart"></canvas>
							</div>
						</div>
					</div>
					<!-- Model Breakdown by Executions -->
					<div class="card bg-base-100 shadow-sm border border-base-300">
						<div class="card-body">
							<h3 class="card-title text-lg">Model Breakdown by Executions</h3>
							<div class="h-64">
								<canvas id="agentUsageChart"></canvas>
							</div>
						</div>
					</div>
					<!-- Most Frequent Tasks -->
				<div class="card bg-base-100 shadow-sm border border-base-300">
					<div class="card-body">
						<h3 class="card-title text-lg">Most Frequently Run Tasks</h3>
						<div class="h-64 overflow-y-auto" id="frequentTasksList"></div>
					</div>
				</div>
			</div>

				<!-- Skill Curator Analytics -->
				<div class="grid grid-cols-1 lg:grid-cols-2 gap-6 mt-6 mb-6">
					<div class="card bg-base-100 shadow-sm border border-base-300">
						<div class="card-body">
							<div class="mb-2">
								<h3 class="card-title text-lg">Skill Activity Over Time</h3>
								<p class="text-sm opacity-60">Created, edited, and used skill activity.</p>
							</div>
							<div class="relative h-64">
								<canvas id="skillUsageTrendChart"></canvas>
							</div>
						</div>
					</div>
					<div class="card bg-base-100 shadow-sm border border-base-300">
						<div class="card-body">
							<div class="mb-2">
								<h3 class="card-title text-lg">Top Skills</h3>
								<p class="text-sm opacity-60">Highest skill activity by event type.</p>
							</div>
							<div class="h-64">
								<canvas id="skillTopChart"></canvas>
							</div>
						</div>
					</div>
					<div class="card bg-base-100 shadow-sm border border-base-300">
						<div class="card-body">
							<div class="mb-2">
								<h3 class="card-title text-lg">Follow-through / Selected Outcomes</h3>
								<p class="text-sm opacity-60">Selected skills that were later used or ignored.</p>
							</div>
							<div class="h-64">
								<canvas id="skillFollowChart"></canvas>
							</div>
						</div>
					</div>
					<div class="card bg-base-100 shadow-sm border border-base-300">
						<div class="card-body">
							<div class="mb-2">
								<h3 class="card-title text-lg">Top Agent/Skill Pairs</h3>
								<p class="text-sm opacity-60">Most active agent and skill combinations.</p>
							</div>
							<div class="h-64">
								<canvas id="skillAgentChart"></canvas>
							</div>
						</div>
					</div>
				</div>
				<div class="card bg-base-100 shadow-sm border border-base-300 mb-6">
					<div class="card-body">
						<div class="mb-2">
							<h3 class="card-title text-lg">Least Active Enabled Skills</h3>
							<p class="text-sm opacity-60">Enabled skills with the least recent activity.</p>
						</div>
						<div class="overflow-x-auto">
							<table class="table table-sm">
								<thead><tr><th>Skill</th><th>Scope</th><th>Activity</th><th>Last activity</th></tr></thead>
								<tbody id="underusedSkillsTable"><tr><td colspan="4" class="text-center opacity-50">No enabled skills found</td></tr></tbody>
							</table>
						</div>
					</div>
				</div>
						<div id="memoryEffectivenessUnavailable" class="card bg-base-100 shadow-sm border border-base-300 mb-6">
							<div class="card-body">
								<h3 class="card-title text-lg">Memory effectiveness unavailable</h3>
								<p class="text-sm opacity-60">Memory recall lacks reliable task-outcome instrumentation. Recall alone does not establish usefulness.</p>
							</div>
						</div>				<!-- Failed Task Patterns -->
			<div class="card bg-base-100 shadow-sm border border-base-300">
				<div class="card-body">
					<h3 class="card-title text-lg">Failed Task Patterns</h3>
					<div class="overflow-x-auto">
						<table class="table table-sm" id="failedPatternsTable">
							<thead>
								<tr>
									<th>Task</th>
									<th>Failure Count</th>
									<th>Last Error</th>
									<th>Last Failed At</th>
								</tr>
							</thead>
							<tbody></tbody>
						</table>
					</div>
				</div>
			</div>
			<!-- Chart.js and Custom Script -->
			<div id="analytics-data" data-project-id={ currentProject.ID } class="hidden"></div>
			<script type="text/javascript">
				(function() {
				window._analyticsGeneration = (window._analyticsGeneration || 0) + 1;
				const analyticsGeneration = window._analyticsGeneration;
				// Destroy any charts from a previous analytics page visit
				if (window._analyticsCharts) {
					Object.values(window._analyticsCharts).forEach(function(c) {
						try { c.destroy(); } catch(e) {}
					});
				}
					window._analyticsCharts = {};
					if (window._analyticsAbortController) window._analyticsAbortController.abort();
					window._analyticsAbortController = new AbortController();
					if (window._analyticsDataAbortController) window._analyticsDataAbortController.abort();

					function initAnalytics() {
					if (analyticsGeneration !== window._analyticsGeneration) return;
					var dataEl = document.getElementById('analytics-data');
					if (!dataEl) return;
					var projectID = dataEl.dataset.projectId;
