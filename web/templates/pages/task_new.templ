package pages

import (
 "fmt"
 "github.com/openvibely/openvibely/web/templates/components"
 "github.com/openvibely/openvibely/internal/models"
 "github.com/openvibely/openvibely/internal/repository"
 "github.com/openvibely/openvibely/web/templates/layout"
)

templ NewTask(projects []models.Project, project *models.Project, agents []models.LLMConfig, agentDefs []repository.AgentTaskUIOption) {
 @layout.Base("New Task", projects, project.ID) {
  @NewTaskContent(project, agents, agentDefs)
 }
}

templ NewTaskContent(project *models.Project, agents []models.LLMConfig, agentDefs []repository.AgentTaskUIOption) {
 <div id="task-detail-content" class="h-full flex flex-col" data-task-id="" data-project-id={ project.ID } data-initial-tab="chat">
  @layout.PageTitle("New Task")
  <div data-page-header class="flex items-center gap-2 mb-6 flex-shrink-0 min-w-0">
   <nav class="flex min-w-0 flex-1 flex-shrink-0 flex-wrap items-start" aria-label="Breadcrumb" data-page-header>
    <a class="flex-shrink-0 text-2xl text-base-content/50 transition-colors hover:text-base-content/80" href={ templ.URL("/tasks?project_id=" + project.ID) } hx-get={ "/tasks?project_id=" + project.ID } hx-target="#main-content" hx-push-url="true">Tasks</a>
    <span class="ml-2 flex-shrink-0 text-2xl text-base-content/30">/</span>
    <input name="title" form="task-thread-form" aria-label="Task title" placeholder="New task" maxlength="200" class="input input-bordered ml-1 h-8 min-w-0 flex-1 px-[3px] py-0 text-xl font-bold leading-none sm:max-w-xl sm:text-2xl"/>
    @components.BreadcrumbSelector(models.BreadcrumbSelector{ID: "task-resource-selector", Kind: "Task", CurrentName: "New task", SearchURL: fmt.Sprintf("/breadcrumb-selectors/tasks?project_id=%s", project.ID), CaretOnly: true, ContextName: "tab", ContextValue: "chat", CreateURL: fmt.Sprintf("/tasks/new?project_id=%s", project.ID), CreateLabel: "Create New Task"})
   </nav>
   <button id="task-workspace-back" type="button" hidden></button>
   <button id="task-details-opener" type="button" class="sidebar-toggle-btn btn btn-ghost btn-sm btn-square" aria-label="Open details panel" aria-controls="task-details-panel" aria-expanded="false" onclick="window.taskWorkspace.togglePanel()"><svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" aria-hidden="true"><path class="panel-toggle-fill" d="M15 3h4a2 2 0 0 1 2 2v14a2 2 0 0 1-2 2h-4Z" stroke="none"/><rect x="3" y="3" width="18" height="18" rx="2"/><line x1="15" y1="3" x2="15" y2="21"/></svg></button>
  </div>
  <div id="task-workspaces">
   @TaskDetailPanel() {
    <div id="tab-details" class="task-tab-panel hidden">
     @NewTaskDetails(agents, agentDefs)
    </div>
    <div id="tab-attachments" class="task-tab-panel hidden">
     <div class="flex items-center justify-between mb-3" style="height:20px"><h3 class="text-sm font-semibold">Attachments</h3>
     <button id="new-task-files" type="button" class="btn btn-ghost btn-xs" aria-label="Add attachments" onclick="document.getElementById('task-thread-form-file-input').click()">+</button></div>
     <div id="draft-panel-attachments" class="space-y-2" data-image-gallery-group=""><p class="text-sm opacity-60">No attachments</p></div>
     <script>
      (()=>{
       const panel=document.getElementById('draft-panel-attachments'),root=panel.closest('#task-detail-content');
       const update=()=>{const list=root.querySelector('[id$="-attachments-list"]');if(!list)return;panel.replaceChildren(...Array.from(list.children).map(row=>{const clone=row.cloneNode(true);clone.removeAttribute('id');
        clone.className='attachment-gallery-row';
        const link=clone.querySelector('a'),size=clone.querySelector(':scope > span:last-child');
        if(link){link.className='attachment-gallery-open';const name=link.querySelector('span');const text=document.createElement('span');text.className='min-w-0';name.className='block text-sm break-all';text.appendChild(name);if(size){size.className='block text-xs opacity-60';text.appendChild(size);}link.appendChild(text);}
        return clone;}));if(!panel.children.length)panel.innerHTML='<p class="text-sm opacity-60">No attachments</p>';};
       const observer=new MutationObserver(()=>{if(!root.isConnected){observer.disconnect();return;}update();});
       const start=()=>{const list=root.querySelector('[id$="-attachments-list"]');if(list){observer.observe(list,{childList:true,subtree:true});update();}};
       if(document.readyState==='loading')document.addEventListener('DOMContentLoaded',start,{once:true});else requestAnimationFrame(start);
       document.body.addEventListener('htmx:beforeCleanupElement',function cleanup(e){if(e.detail.elt===root){observer.disconnect();document.body.removeEventListener('htmx:beforeCleanupElement',cleanup);}});
      })();
     </script>
    </div>
    <div id="tab-schedules" class="task-tab-panel hidden">
     @TaskSchedulePanel(&models.Task{ProjectID:project.ID}, nil)
    </div>
    <div id="tab-chaining" class="task-tab-panel hidden">@TaskChainPanel(&models.Task{ProjectID:project.ID}, agents)</div>
    for _, tab := range []string{"lifecycle"} {
     <div id={ "tab-" + tab } class="task-tab-panel hidden"><p class="text-sm opacity-60">Available after the task is created.</p></div>
    }
   }
   <div id="tab-changes" class="hidden"></div>
   <div id="tab-chat" class="flex flex-col flex-1 min-h-0">
    <div id="task-thread-messages" class="flex-1 min-h-0 overflow-y-auto"></div>
    <div id="new-task-error" role="alert" class="text-error text-sm"></div>
    @components.ChatInputForm(components.ChatInputFormConfig{
     FormID: "task-thread-form", InputID: "task-message-input",
     PostEndpoint: fmt.Sprintf("/tasks?project_id=%s&from=new&thread=1", project.ID),
     TargetID: "main-content", DiscardDraftOnLeave: true, SelectedAgentID: "default", DefaultAgentID: projectDefaultAgentID(project), Agents: agents, ShowModelSelector: true,
    })
   </div>
  </div>
  @TaskDetailEditors(&models.Task{}, agents, agentDefs)
  @TaskWorkspaceScript()
  <script>
   (function() {
    var root = document.getElementById('task-detail-content');
    root.querySelectorAll('#tab-details input, #tab-details select, #tab-details textarea').forEach(function(input) {
     input.setAttribute('form', 'task-thread-form');
    });
    function titleDraftRoot(node) {
     var candidate = node && node.closest ? node.closest('#task-detail-content') : null;
     return candidate && candidate.getAttribute('data-task-id') === '' ? candidate : null;
    }
    function titleDraftKey(pageRoot) {
     return 'openvibely.new-task-title.' + pageRoot.getAttribute('data-project-id');
    }
    function titleDraftInput(pageRoot) {
     return pageRoot && pageRoot.querySelector('input[name="title"][form="task-thread-form"]');
    }
    function composerDraftKey(pageRoot) {
     return 'openvibely.new-task-composer.' + pageRoot.getAttribute('data-project-id');
    }
    function saveComposerDraft(pageRoot) {
     if (!pageRoot || pageRoot.__openVibelyTaskCreationSucceeded) return;
     var message = pageRoot.querySelector('#task-message-input');
     var model = pageRoot.querySelector('#task-thread-form-agent-id');
     if (!message || !model) return;
     try { sessionStorage.setItem(composerDraftKey(pageRoot), JSON.stringify({message: message.value, model: model.value})); } catch (_) {}
    }
    function hydrateComposerDraft(pageRoot) {
     if (!pageRoot) return;
     var saved;
     try { saved = JSON.parse(sessionStorage.getItem(composerDraftKey(pageRoot))); } catch (_) { return; }
     if (!saved) return;
     var message = pageRoot.querySelector('#task-message-input');
     var model = pageRoot.querySelector('#task-thread-form-agent-id');
     var picker = pageRoot.querySelector('#task-thread-form-agent-select');
     if (message && typeof saved.message === 'string') {
      message.value = saved.message;
      message.style.height = 'auto';
      message.style.height = Math.min(message.scrollHeight, 200) + 'px';
     }
     if (model && picker && typeof saved.model === 'string') {
      var exists = Array.from(picker.parentElement.querySelectorAll('li[data-value]')).some(function(option) { return option.dataset.value === saved.model; });
      if (exists) {
       model.value = saved.model;
       if (window._setChatCustomSelectValue) window._setChatCustomSelectValue(picker, saved.model);
       if (window.ovModelPicker) window.ovModelPicker.changed(picker);
      }
     }
    }
    function saveTitleDraft(pageRoot) {
     if (!pageRoot || pageRoot.__openVibelyTaskCreationSucceeded) return;
     var input = titleDraftInput(pageRoot);
     if (!input) return;
     try { sessionStorage.setItem(titleDraftKey(pageRoot), input.value); } catch (_) {}
    }
    function clearTitleDraft(pageRoot) {
     if (!pageRoot) return;
     pageRoot.__openVibelyTaskCreationSucceeded = true;
     try { sessionStorage.removeItem(titleDraftKey(pageRoot)); sessionStorage.removeItem(composerDraftKey(pageRoot)); } catch (_) {}
    }
    function hydrateTitleDraft(pageRoot) {
     if (!pageRoot) return;
     var input = titleDraftInput(pageRoot);
     if (!input) return;
     try {
      var savedTitle = sessionStorage.getItem(titleDraftKey(pageRoot));
      input.value = savedTitle === null ? '' : savedTitle;
     } catch (_) {}
    }
    function resetCreationDraft(pageRoot, saveTitle) {
     if (!pageRoot) return;
     if (saveTitle || !pageRoot.__openVibelyTaskTitleSavedForCleanup) { saveTitleDraft(pageRoot); saveComposerDraft(pageRoot); }
     pageRoot.__openVibelyTaskTitleSavedForCleanup = true;
     var pageForm = pageRoot.querySelector('#task-thread-form');
     if (pageForm) {
      pageForm.reset();
      var clear = window[pageForm.getAttribute('data-clear-func-name')];
      if (clear) clear();
     }
     var messageInput = pageRoot.querySelector('#task-message-input');
     if (messageInput) messageInput.value = '';
    }
    function handleTaskCreationAfterRequest(pageRoot, event) {
     var detail = event.detail || {};
     var submittedForm = pageRoot && pageRoot.querySelector('#task-thread-form');
     if (!submittedForm || detail.elt !== submittedForm) return;
     var xhr = detail.xhr;
     // A 204 model-setup guard is successful HTTP, but creates no task.
     // Normal creation acknowledges the ID; swarm creation redirects to its task.
     var succeeded = xhr && xhr.status >= 200 && xhr.status < 300 && typeof xhr.getResponseHeader === 'function' &&
      (xhr.getResponseHeader('X-Created-Task-ID') || (xhr.getResponseHeader('HX-Location') || '').indexOf('/tasks/') === 0);
     var error = pageRoot.querySelector('#new-task-error');
     if (succeeded) {
      clearTitleDraft(pageRoot);
      if (error) error.textContent = '';
      return;
     }
     if (!error || !pageRoot.isConnected) return;
     var message = 'Unable to create the task. Please try again.';
     if (xhr && typeof xhr.getResponseHeader === 'function') {
      var contentType = xhr.getResponseHeader('Content-Type') || '';
      if (contentType.indexOf('application/json') !== -1) {
       try { var body = JSON.parse(xhr.responseText); if (typeof body.message === 'string') message = body.message; } catch (_) {}
      } else if (contentType.indexOf('text/plain') !== -1 && xhr.responseText.trim()) {
       message = xhr.responseText;
      }
     }
     error.textContent = message;
    }
    function bindTaskCreationAfterRequest(pageRoot) {
     var pageForm = pageRoot && pageRoot.querySelector('#task-thread-form');
     if (!pageForm || pageForm.__openVibelyTaskCreationAfterRequestInstalled) return;
     pageForm.__openVibelyTaskCreationAfterRequestInstalled = true;
     pageForm.addEventListener('htmx:afterRequest', function(event) {
      handleTaskCreationAfterRequest(pageRoot, event);
     });
    }
    if (!window.openVibelyNewTaskTitleDraftLifecycleInstalled) {
     window.openVibelyNewTaskTitleDraftLifecycleInstalled = true;
     document.body.addEventListener('input', function(event) {
      var input = event.target;
      if (!input || !input.matches || !input.matches('input[name="title"][form="task-thread-form"], #task-message-input')) return;
      var pageRoot = titleDraftRoot(input);
      if (!pageRoot) return;
      pageRoot.__openVibelyTaskTitleSavedForCleanup = false;
      saveTitleDraft(pageRoot);
      saveComposerDraft(pageRoot);
     });
     document.body.addEventListener('chat-select-change', function(event) {
      if (event.target.id !== 'task-thread-form-agent-select') return;
      var pageRoot = titleDraftRoot(event.target);
      if (!pageRoot) return;
      pageRoot.__openVibelyTaskTitleSavedForCleanup = false;
      saveComposerDraft(pageRoot);
     });
     document.body.addEventListener('htmx:beforeHistorySave', function() {
      resetCreationDraft(titleDraftRoot(document.getElementById('task-detail-content')), true);
     });
     document.body.addEventListener('htmx:beforeCleanupElement', function(event) {
      var pageRoot = document.getElementById('task-detail-content');
      if (pageRoot && event.detail && event.detail.elt === pageRoot) resetCreationDraft(titleDraftRoot(pageRoot), false);
     });
     document.body.addEventListener('htmx:historyRestore', function() {
      var restoredRoot = titleDraftRoot(document.getElementById('task-detail-content'));
      if (restoredRoot) {
       hydrateTitleDraft(restoredRoot);
       hydrateComposerDraft(restoredRoot);
       bindTaskCreationAfterRequest(restoredRoot);
      }
     });
    }
    bindTaskCreationAfterRequest(titleDraftRoot(root));
    hydrateTitleDraft(titleDraftRoot(root));
    hydrateComposerDraft(titleDraftRoot(root));
    // Keep creation fields out of HTMX history; the app-level lifecycle handler
    // saves the title, message and model before resetting and restores cached views.
   })();
  </script>
 </div>
}

 templ NewTaskOptions(agents []models.LLMConfig, agentDefs []repository.AgentTaskUIOption) {
<div class="form-control mb-3">
								<label class="label"><span class="label-text">Goal (optional)</span></label>
								<textarea name="goal" class="textarea textarea-bordered h-20" placeholder="Completion condition for automatic continuation"></textarea>
							</div>						<div class="form-control mb-3">
							<label class="label"><span class="label-text">Model</span></label>
							<select name="agent_id" class="select select-bordered">
								<option value="">Use Default Model</option>
								for _, agent := range agents {
									<option value={ agent.ID }>
										{ agent.Name }
										if agent.IsDefault {
											(Default)
										}
									</option>
								}
							</select>
						</div>
						if len(agentDefs) > 0 {
							<div class="form-control mb-3">
								<label class="label"><span class="label-text">Agent</span></label>
								<select name="agent_definition_id" class="select select-bordered" id="task-agent-def-select">
									<option value="">No Agent</option>
									for _, ad := range agentDefs {
										<option value={ ad.ID } data-agent-model={ ad.Model }>
											{ ad.Name }
											if ad.Model != "inherit" {
												({ ad.Model })
											}
										</option>
									}
								</select>
							</div>
						}
							<div class="grid grid-cols-1 gap-3 sm:grid-cols-2">							<div class="form-control">
								<label class="label"><span class="label-text">Category</span></label>
								<select name="category" class="select select-bordered" id="task-category-select">
									for _, cat := range models.SelectableCategories {
										<option value={ string(cat) }>
											{ string(cat) }
										</option>
									}
								</select>
							</div>
							<div class="form-control">
								<label class="label"><span class="label-text">Priority</span></label>
								<select name="priority" class="select select-bordered">
									<option value="1">Low</option>
									<option value="2" selected>Normal</option>
									<option value="3">High</option>
									<option value="4">Urgent</option>
								</select>
							</div>
						</div>
							<div class="form-control mt-3">
								<label class="label"><span class="label-text">Tag</span></label>
								<select name="tag" class="select select-bordered">
									<option value="">None</option>
									<option value="feature">Feature</option>
									<option value="bug">Bug</option>
								</select>
							</div>
								 @NewTaskAdvancedOptions()
 @TaskAutoMergeSwitches(&models.Task{})
}

templ NewTaskAdvancedOptions() {
<div class="card bg-base-200/50 border border-base-300 mt-3">
									<div class="card-body p-3 space-y-3">
										<label class="label cursor-pointer justify-start gap-2 p-0">
											<input type="checkbox" name="swarm_mode" id="create-task-swarm-mode-toggle" onchange="document.getElementById('create-task-swarm-options').classList.toggle('hidden', !this.checked)" class="toggle toggle-sm toggle-primary"/>
											<span class="label-text font-medium">Swarm mode</span>
										</label>
										<div id="create-task-swarm-options" class="hidden space-y-3">
											<p class="text-xs opacity-70">Swarm planning starts when the parent task becomes Active. Choose Backlog to defer the planner until you run the task or move it to Active.</p>
											<div class="grid grid-cols-1 gap-3 sm:grid-cols-2">
												<div class="form-control">
													<label class="label"><span class="label-text">Max workers</span></label>
													<input type="number" name="swarm_max_workers" class="input input-bordered" min="1" max="8" value="3"/>
												</div>
												<div class="form-control">
													<label class="label"><span class="label-text">Worker isolation</span></label>
													<select name="swarm_worker_isolation" class="select select-bordered">
														<option value="worktree" selected>Worktree</option>
														<option value="read_only">Read only</option>
														<option value="shared">Shared</option>
													</select>
												</div>
											</div>
											<div class="flex flex-wrap gap-4">
												<input type="hidden" name="swarm_reviewer_enabled" value="false"/>
												<label class="label cursor-pointer justify-start gap-2 p-0">
													<input type="checkbox" name="swarm_reviewer_enabled" value="true" class="checkbox checkbox-sm" checked/>
													<span class="label-text">Reviewer enabled</span>
												</label>
												<input type="hidden" name="swarm_merger_enabled" value="false"/>
												<label class="label cursor-pointer justify-start gap-2 p-0">
													<input type="checkbox" name="swarm_merger_enabled" value="true" class="checkbox checkbox-sm" checked/>
													<span class="label-text">Merger enabled</span>
												</label>
											</div>
										</div>
									</div>
								</div>


}

templ NewTaskDetails(agents []models.LLMConfig, agentDefs []repository.AgentTaskUIOption) {
 <div class="min-w-0">
  @TaskDetailMetrics(&models.Task{Category:models.CategoryActive, Priority:2, AgentID: newTaskDefaultModel()}, models.TaskExecutionMetrics{}, agents, "")
  for _, field := range []struct{ Name, Value string }{{"agent_definition_id",""},{"category","active"},{"priority","2"},{"tag",""},{"goal",""}} {
   <input type="hidden" name={ field.Name } value={ field.Value } data-draft-property={ field.Name } form="task-thread-form"/>
  }
  @TaskGoalPanel("", nil)
  @TaskAutoMergePanel(&models.Task{})
  <p class="text-xs opacity-60 mb-4">Settings apply when you send your first message. Active tasks start immediately; Backlog tasks are saved without running.</p>
  <details><summary class="text-sm cursor-pointer">Advanced options</summary>@NewTaskAdvancedOptions()</details>
 </div>
}

func newTaskDefaultModel() *string { value := "default"; return &value }

func projectDefaultAgentID(project *models.Project) string {
	if project == nil || project.DefaultAgentConfigID == nil {
		return ""
	}
	return *project.DefaultAgentConfigID
}
