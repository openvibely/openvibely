package pages

import (
 "fmt"
 "context"
 "net/url"
 "github.com/openvibely/openvibely/web/templates/components"
 "github.com/openvibely/openvibely/internal/models"
 "github.com/openvibely/openvibely/internal/persistence"
 "github.com/openvibely/openvibely/web/templates/layout"
 templateui "github.com/openvibely/openvibely/web/templates"
)

func newTaskPostURL(ctx context.Context, projectID string) string {
 if !models.IsAggregateProject(layout.WorkspaceProjectID(ctx, projectID)) { return fmt.Sprintf("/tasks?project_id=%s&from=new&thread=1", projectID) }
 q := url.Values{"project_id": {layout.WorkspaceProjectID(ctx, projectID)}, "from": {"new"}, "thread": {"1"}}
 if !models.IsAggregateProject(projectID) { q.Set("destination_project", projectID) }
 return "/tasks?" + q.Encode()
}

templ NewTask(projects []models.Project, project *models.Project, agents []models.LLMConfig, agentDefs []persistence.AgentTaskUIOption) {
 @layout.Base("New Task", projects, layout.WorkspaceProjectID(ctx, project.ID)) {
  @NewTaskContent(project, agents, agentDefs, projects...)
 }
}

templ NewTaskContent(project *models.Project, agents []models.LLMConfig, agentDefs []persistence.AgentTaskUIOption, projects ...models.Project) {
 <div id="task-detail-content" class="h-full flex flex-col" data-task-id="" data-project-id={ project.ID } data-initial-tab="chat">
  @layout.PageTitle("New Task")
  <div data-page-header class="flex items-center gap-2 mb-6 flex-shrink-0 min-w-0">
   <nav class="flex min-w-0 flex-1 flex-shrink-0 flex-wrap items-start" aria-label="Breadcrumb" data-page-header>
    <a data-workspace-list-return class="flex-shrink-0 text-2xl text-base-content/50 transition-colors hover:text-base-content/80" href={ templ.URL("/tasks?project_id=" + layout.WorkspaceProjectID(ctx, project.ID)) } hx-get={ "/tasks?project_id=" + layout.WorkspaceProjectID(ctx, project.ID) } hx-target="#main-content" hx-push-url="true">Tasks</a>
    <span class="ml-2 flex-shrink-0 text-2xl text-base-content/30">/</span>
    <input name="title" form="task-thread-form" aria-label="Task title" placeholder="New task" maxlength="200" class="ov-breadcrumb-name input input-bordered ml-1 h-8 min-w-0 flex-1 px-[3px] py-0 text-xl font-bold leading-none sm:max-w-xl sm:text-2xl"/>
    @components.BreadcrumbSelector(models.BreadcrumbSelector{ID: "task-resource-selector", Kind: "Task", CurrentName: "New task", SearchURL: fmt.Sprintf("/breadcrumb-selectors/tasks?project_id=%s", layout.WorkspaceProjectID(ctx, project.ID)), CaretOnly: true, ContextName: "tab", ContextValue: "chat", CreateURL: fmt.Sprintf("/tasks/new?project_id=%s", layout.WorkspaceProjectID(ctx, project.ID)), CreateLabel: "Create New Task"})
   </nav>
   <button id="task-workspace-back" type="button" hidden></button>
   <button id="task-details-opener" type="button" class="sidebar-toggle-btn btn btn-ghost btn-sm btn-square" aria-label="Open details panel" aria-controls="task-details-panel" aria-expanded="false" onclick="window.taskWorkspace.togglePanel()"><svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" aria-hidden="true"><path class="panel-toggle-fill" d="M15 3h4a2 2 0 0 1 2 2v14a2 2 0 0 1-2 2h-4Z" stroke="none"/><rect x="3" y="3" width="18" height="18" rx="2"/><line x1="15" y1="3" x2="15" y2="21"/></svg></button>
  </div>
  <div id="task-workspaces">
   @TaskDetailPanel() {
    <div id="tab-details" class="task-tab-panel hidden">
     @NewTaskDetails(agents, agentDefs, NewTaskProjectRow(project, projects))
    </div>
    <div id="tab-computer" class="task-tab-panel hidden">
 @TaskComputerToggle(project.ID, "")
 </div>
 <div id="tab-attachments" class="task-tab-panel hidden">
     <div class="flex items-center justify-between mb-3" style="height:20px"><h3 class="text-sm font-semibold">Attachments</h3>
     <button id="new-task-files" type="button" class="btn btn-ghost btn-xs" aria-label="Add attachments" onclick="document.getElementById('task-thread-form-file-input').click()">+</button></div>
     <div id="draft-panel-attachments" class="space-y-2" data-image-gallery-group=""><p class="text-sm opacity-60">No attachments</p></div>
     <script>
      (()=>{
       const panel=document.getElementById('draft-panel-attachments'),root=panel.closest('#task-detail-content');
       const update=()=>{const list=root.querySelector('[id$="-attachments-list"]');if(!list)return;panel.replaceChildren(...Array.from(list.children).map(row=>{const clone=row.cloneNode(true);clone.removeAttribute('id');
        clone.className='attachment-gallery-row';
        const link=clone.querySelector('a'),size=clone.querySelector(':scope > span:last-child');
        if(link){link.className='attachment-gallery-open';const name=link.querySelector('span');const text=document.createElement('span');text.className='min-w-0';name.className='block text-sm break-all';text.appendChild(name);if(size){size.className='block text-xs opacity-60';text.appendChild(size);}link.appendChild(text);}
        return clone;}));if(!panel.children.length)panel.innerHTML='<p class="text-sm opacity-60">No attachments</p>';};
       const observer=new MutationObserver(()=>{if(!root.isConnected){observer.disconnect();return;}update();});
       const start=()=>{const list=root.querySelector('[id$="-attachments-list"]');if(list){observer.observe(list,{childList:true,subtree:true});update();}};
       if(document.readyState==='loading')document.addEventListener('DOMContentLoaded',start,{once:true});else requestAnimationFrame(start);
       document.body.addEventListener('htmx:beforeCleanupElement',function cleanup(e){if(e.detail.elt===root){observer.disconnect();document.body.removeEventListener('htmx:beforeCleanupElement',cleanup);}});
      })();
     </script>
    </div>
    <div id="tab-schedules" class="task-tab-panel hidden">
     @TaskSchedulePanel(&models.Task{ProjectID:project.ID}, nil)
    </div>
    <div id="tab-chaining" class="task-tab-panel hidden">@TaskChainPanel(&models.Task{ProjectID:project.ID}, agents)</div>
    for _, tab := range []string{"lifecycle"} {
     <div id={ "tab-" + tab } class="task-tab-panel hidden"><p class="text-sm opacity-60">Available after the task is created.</p></div>
    }
   }
   <div id="tab-changes" class="hidden"></div>
   <div id="tab-chat" class="flex flex-col flex-1 min-h-0">
    <div id="task-thread-messages" data-chat-transcript class="flex-1 min-h-0 overflow-y-auto">@components.ChatEmptyStage("Describe the task below")</div>
    <div id="new-task-error" role="alert" class="text-error text-sm"></div>
    @components.ChatInputForm(components.ChatInputFormConfig{
     FormID: "task-thread-form", InputID: "task-message-input",
     PostEndpoint: newTaskPostURL(ctx, project.ID),
     TargetID: "main-content", DiscardDraftOnLeave: true, SelectedAgentID: "default", DefaultAgentID: projectDefaultAgentID(project), Agents: agents, ShowModelSelector: true,
     ProjectServerOnly: models.IsSharedProjectID(layout.WorkspaceProjectID(ctx, project.ID)),
     DestinationScope: layout.WorkspaceProjectID(ctx, project.ID),
     ProjectChoices: newTaskProjectChoices(ctx, project), ProjectInputID: "new-task-project",
    })
    @NewTaskOptionsRow()
   </div>
  </div>
  @TaskDetailEditors(&models.Task{ProjectID: project.ID}, agents, agentDefs)
  @TaskWorkspaceScript()
  <script>
   (function() {
    var root = document.getElementById('task-detail-content');
    var destination = root.querySelector('#new-task-project');
    if (destination) {
     var modelRequest = 0;
     function syncDetailModels(options, loading) {
      root.querySelector('#task-chain-panel')?.dispatchEvent(new CustomEvent('draft-destination-models', {detail: {
       loading: loading,
       models: Array.from(options.querySelectorAll('li[data-value]')).filter(function(option) {
        return option.dataset.value !== 'default' && option.dataset.value !== 'auto';
       }).map(function(option) { return {id: option.dataset.value, name: option.dataset.pickerName || option.textContent}; })
      }}));
      var menu = root.querySelector('#task-property-picker [data-options="agent_id"]');
      var row = root.querySelector('[data-detail-property="agent_id"]');
      if (!menu || !row) return;
      menu.replaceChildren();
      options.querySelectorAll('li[data-value]').forEach(function(option) {
       var button = document.createElement('button');
       button.type = 'button';
       button.className = 'ov-menu-option w-full';
       button.dataset.value = option.dataset.value === 'auto' ? '' : option.dataset.value;
       button.textContent = option.dataset.pickerName || option.textContent;
       menu.appendChild(button);
      });
      row.dataset.value = 'default';
      row.querySelector('[data-property-label]').textContent = 'Default';
      row.disabled = loading;
     }
     var agentRequest = 0;
     async function refreshDestinationAgents() {
      var token = ++agentRequest;
      var menu = root.querySelector('#task-property-picker [data-options="agent_definition_id"]');
      var row = root.querySelector('#tab-details [data-detail-property="agent_definition_id"]');
      var input = root.querySelector('[data-draft-property="agent_definition_id"]');
      if (!menu || !row || !input) return;
      input.value = '';
      row.dataset.value = '';
      row.querySelector('[data-property-label]').textContent = 'No agent';
      row.disabled = true;
      menu.replaceChildren();
      var empty = document.createElement('button');
      empty.type = 'button';
      empty.className = 'ov-menu-option w-full';
      empty.dataset.value = '';
      empty.textContent = 'No agent';
      menu.appendChild(empty);
      if (!destination.value) return;
      try {
       var response = await fetch('/tasks/new?agent_options=1&project_id=' + encodeURIComponent(destination.value));
       if (!response.ok) throw new Error('Could not load agents');
       var agents = await response.json();
       if (token !== agentRequest || !root.isConnected) return;
       agents.forEach(function(agent) {
        var button = document.createElement('button');
        button.type = 'button';
        button.className = 'ov-menu-option w-full';
        button.dataset.value = agent.id;
        button.dataset.agentScope = agent.scope;
        button.dataset.agentProject = agent.project;
        button.textContent = agent.name;
        menu.appendChild(button);
       });
       row.disabled = false;
       row.title = '';
      } catch (_) {
       if (token !== agentRequest || !root.isConnected) return;
       row.querySelector('[data-property-label]').textContent = 'Agents unavailable';
       row.title = 'Select the project again to retry loading its agents.';
      }
     }
     async function refreshDestinationModels() {
      var token = ++modelRequest;
      var form = root.querySelector('#task-thread-form');
      form.dataset.destinationModelsPending = 'true';
      var send = form.querySelector('[id$="-primary-action"] button[type="submit"]');
      if (send) send.disabled = true;
      var picker = root.querySelector('#task-thread-form-agent-select');
      var input = root.querySelector('#task-thread-form-agent-id');
      if (!picker || !input) return;
      window.ovModelPicker?.close();
      input.value = 'default';
      window._setChatCustomSelectValue?.(picker, 'default');
      var options = picker.parentElement.querySelector('.chat-custom-select-options');
      options.innerHTML = '<li data-value="default">Default</li>';
      syncDetailModels(options, true);
      root.querySelectorAll('[name="reasoning_effort"], [name="service_tier"]').forEach(function(field) { field.value = ''; });
      picker.disabled = true;
      picker.querySelector('.chat-custom-select-label').textContent = destination.value ? 'Loading models…' : 'Choose a project';
      if (!destination.value) {
       form.dataset.destinationModelsPending = 'false';
       if (send) send.disabled = form.dataset.destinationAttachmentsPending === 'true' || form.dataset.destinationCatalogPending === 'true';
       return;
      }
      try {
       var response = await fetch('/tasks/new?model_options=1&project_id=' + encodeURIComponent(destination.value));
       if (!response.ok) throw new Error('Could not load models');
       var html = await response.text();
       if (token !== modelRequest || !root.isConnected) return;
       options.innerHTML = html;
       syncDetailModels(options, false);
       picker.disabled = false;
       window._setChatCustomSelectValue?.(picker, 'default');
       window.ovModelPicker?.changed(picker);
       form.dataset.destinationModelsPending = 'false';
       if (send) send.disabled = form.dataset.destinationAttachmentsPending === 'true' || form.dataset.destinationCatalogPending === 'true';
      } catch (_) {
       if (token !== modelRequest || !root.isConnected) return;
       picker.querySelector('.chat-custom-select-label').textContent = 'Models unavailable';
       picker.title = 'Select the project again to retry loading its models.';
      }
     }
     // The composer picker and the Details row edit the same input.
     destination.addEventListener('change', function() {
      refreshDestinationModels();
      refreshDestinationAgents();
      var row = destination.closest('[data-detail-property="destination_project"]');
      var option = root.querySelector('#task-property-picker [data-options="destination_project"] button[data-value="' + CSS.escape(destination.value) + '"]');
      row.dataset.value = destination.value;
      row.querySelector('[data-property-label]').textContent = option ? option.textContent.trim() : row.dataset.placeholder;
     });
    }
    root.querySelectorAll('#tab-details input, #tab-details select, #tab-details textarea').forEach(function(input) {
     input.setAttribute('form', 'task-thread-form');
    });
    function titleDraftRoot(node) {
     var candidate = node && node.closest ? node.closest('#task-detail-content') : null;
     return candidate && candidate.getAttribute('data-task-id') === '' ? candidate : null;
    }
    function titleDraftKey(pageRoot) {
     return 'openvibely.new-task-title.' + pageRoot.getAttribute('data-project-id');
    }
    function titleDraftInput(pageRoot) {
     return pageRoot && pageRoot.querySelector('input[name="title"][form="task-thread-form"]');
    }
    function composerDraftKey(pageRoot) {
     return 'openvibely.new-task-composer.' + pageRoot.getAttribute('data-project-id');
    }
    function saveComposerDraft(pageRoot) {
     if (!pageRoot || pageRoot.__openVibelyTaskCreationSucceeded) return;
     var message = pageRoot.querySelector('#task-message-input');
     var model = pageRoot.querySelector('#task-thread-form-agent-id');
     if (!message || !model) return;
     try { sessionStorage.setItem(composerDraftKey(pageRoot), JSON.stringify({message: message.value, model: model.value})); } catch (_) {}
    }
    function hydrateComposerDraft(pageRoot) {
     if (!pageRoot) return;
     var saved;
     try { saved = JSON.parse(sessionStorage.getItem(composerDraftKey(pageRoot))); } catch (_) { return; }
     if (!saved) return;
     var message = pageRoot.querySelector('#task-message-input');
     var model = pageRoot.querySelector('#task-thread-form-agent-id');
     var picker = pageRoot.querySelector('#task-thread-form-agent-select');
     if (message && typeof saved.message === 'string') {
      message.value = saved.message;
      message.style.height = 'auto';
      message.style.height = Math.min(message.scrollHeight, 200) + 'px';
     }
     if (model && picker && typeof saved.model === 'string') {
      var exists = Array.from(picker.parentElement.querySelectorAll('li[data-value]')).some(function(option) { return option.dataset.value === saved.model; });
      if (exists) {
       model.value = saved.model;
       if (window._setChatCustomSelectValue) window._setChatCustomSelectValue(picker, saved.model);
       if (window.ovModelPicker) window.ovModelPicker.changed(picker);
      }
     }
    }
    function saveTitleDraft(pageRoot) {
     if (!pageRoot || pageRoot.__openVibelyTaskCreationSucceeded) return;
     var input = titleDraftInput(pageRoot);
     if (!input) return;
     try { sessionStorage.setItem(titleDraftKey(pageRoot), input.value); } catch (_) {}
    }
    function clearTitleDraft(pageRoot) {
     if (!pageRoot) return;
     pageRoot.__openVibelyTaskCreationSucceeded = true;
     try { sessionStorage.removeItem(titleDraftKey(pageRoot)); sessionStorage.removeItem(composerDraftKey(pageRoot)); } catch (_) {}
    }
    function hydrateTitleDraft(pageRoot) {
     if (!pageRoot) return;
     var input = titleDraftInput(pageRoot);
     if (!input) return;
     try {
      var savedTitle = sessionStorage.getItem(titleDraftKey(pageRoot));
      input.value = savedTitle === null ? '' : savedTitle;
     } catch (_) {}
    }
    function resetCreationDraft(pageRoot, saveTitle) {
     if (!pageRoot) return;
     if (saveTitle || !pageRoot.__openVibelyTaskTitleSavedForCleanup) { saveTitleDraft(pageRoot); saveComposerDraft(pageRoot); }
     pageRoot.__openVibelyTaskTitleSavedForCleanup = true;
     var pageForm = pageRoot.querySelector('#task-thread-form');
     if (pageForm) {
      pageForm.reset();
      var clear = window[pageForm.getAttribute('data-clear-func-name')];
      if (clear) clear();
     }
     var messageInput = pageRoot.querySelector('#task-message-input');
     if (messageInput) messageInput.value = '';
    }
    function handleTaskCreationAfterRequest(pageRoot, event) {
     var detail = event.detail || {};
     var submittedForm = pageRoot && pageRoot.querySelector('#task-thread-form');
     if (!submittedForm || detail.elt !== submittedForm) return;
     var xhr = detail.xhr;
     // A 204 model-setup guard is successful HTTP, but creates no task.
     // Normal creation acknowledges the ID; swarm creation redirects to its task.
     var succeeded = xhr && xhr.status >= 200 && xhr.status < 300 && typeof xhr.getResponseHeader === 'function' &&
      (xhr.getResponseHeader('X-Created-Task-ID') || (xhr.getResponseHeader('HX-Location') || '').indexOf('/tasks/') === 0);
     var error = pageRoot.querySelector('#new-task-error');
     if (succeeded) {
      clearTitleDraft(pageRoot);
      if (error) error.textContent = '';
      return;
     }
     if (!error || !pageRoot.isConnected) return;
     var message = 'Unable to create the task. Please try again.';
     if (xhr && typeof xhr.getResponseHeader === 'function') {
      var contentType = xhr.getResponseHeader('Content-Type') || '';
      if (contentType.indexOf('application/json') !== -1) {
       try { var body = JSON.parse(xhr.responseText); if (typeof body.message === 'string') message = body.message; } catch (_) {}
      } else if (contentType.indexOf('text/plain') !== -1 && xhr.responseText.trim()) {
       message = xhr.responseText;
      }
     }
     error.textContent = message;
    }
    function bindTaskCreationAfterRequest(pageRoot) {
     var pageForm = pageRoot && pageRoot.querySelector('#task-thread-form');
     if (!pageForm || pageForm.__openVibelyTaskCreationAfterRequestInstalled) return;
     pageForm.__openVibelyTaskCreationAfterRequestInstalled = true;
     pageForm.addEventListener('htmx:afterRequest', function(event) {
      handleTaskCreationAfterRequest(pageRoot, event);
     });
    }
    if (!window.openVibelyNewTaskTitleDraftLifecycleInstalled) {
     window.openVibelyNewTaskTitleDraftLifecycleInstalled = true;
     document.body.addEventListener('input', function(event) {
      var input = event.target;
      if (!input || !input.matches || !input.matches('input[name="title"][form="task-thread-form"], #task-message-input')) return;
      var pageRoot = titleDraftRoot(input);
      if (!pageRoot) return;
      pageRoot.__openVibelyTaskTitleSavedForCleanup = false;
      saveTitleDraft(pageRoot);
      saveComposerDraft(pageRoot);
     });
     document.body.addEventListener('chat-select-change', function(event) {
      if (event.target.id !== 'task-thread-form-agent-select') return;
      var pageRoot = titleDraftRoot(event.target);
      if (!pageRoot) return;
      pageRoot.__openVibelyTaskTitleSavedForCleanup = false;
      saveComposerDraft(pageRoot);
     });
     document.body.addEventListener('htmx:beforeHistorySave', function() {
      resetCreationDraft(titleDraftRoot(document.getElementById('task-detail-content')), true);
     });
     document.body.addEventListener('htmx:beforeCleanupElement', function(event) {
      var pageRoot = document.getElementById('task-detail-content');
      if (pageRoot && event.detail && event.detail.elt === pageRoot) resetCreationDraft(titleDraftRoot(pageRoot), false);
     });
     document.body.addEventListener('htmx:historyRestore', function() {
      var restoredRoot = titleDraftRoot(document.getElementById('task-detail-content'));
      if (restoredRoot) {
       hydrateTitleDraft(restoredRoot);
       hydrateComposerDraft(restoredRoot);
       bindTaskCreationAfterRequest(restoredRoot);
      }
     });
    }
    bindTaskCreationAfterRequest(titleDraftRoot(root));
    hydrateTitleDraft(titleDraftRoot(root));
    hydrateComposerDraft(titleDraftRoot(root));
    // Keep creation fields out of HTMX history; the app-level lifecycle handler
    // saves the title, message and model before resetting and restores cached views.
   })();
  </script>
 </div>
}

 templ NewTaskOptions(agents []models.LLMConfig, agentDefs []persistence.AgentTaskUIOption) {
<div class="form-control mb-3">
								<label class="label"><span class="label-text">Goal (optional)</span></label>
								<textarea name="goal" class="textarea textarea-bordered h-20" placeholder="Completion condition for automatic continuation"></textarea>
							</div>						<div class="form-control mb-3">
							<label class="label"><span class="label-text">Model</span></label>
							<select name="agent_id" class="select select-bordered">
								<option value="">Use Default Model</option>
								for _, agent := range agents {
									<option value={ agent.ID }>
										{ agent.Name }
										if agent.IsDefault {
											(Default)
										}
									</option>
								}
							</select>
						</div>
						if len(agentDefs) > 0 {
							<div class="form-control mb-3">
								<label class="label"><span class="label-text">Agent</span></label>
								<select name="agent_definition_id" class="select select-bordered" id="task-agent-def-select">
									<option value="">No Agent</option>
									for _, ad := range agentDefs {
										<option value={ ad.ID } data-agent-model={ ad.Model }>
											{ ad.Name }
											if ad.Model != "inherit" {
												({ ad.Model })
											}
										</option>
									}
								</select>
							</div>
						}
							<div class="grid grid-cols-1 gap-3 sm:grid-cols-2">							<div class="form-control">
								<label class="label"><span class="label-text">Category</span></label>
								<select name="category" class="select select-bordered" id="task-category-select">
									for _, cat := range models.SelectableCategories {
										<option value={ string(cat) }>
											{ string(cat) }
										</option>
									}
								</select>
							</div>
							<div class="form-control">
								<label class="label"><span class="label-text">Priority</span></label>
								<select name="priority" class="select select-bordered">
									<option value="1">Low</option>
									<option value="2" selected>Normal</option>
									<option value="3">High</option>
									<option value="4">Urgent</option>
								</select>
							</div>
						</div>
							<div class="form-control mt-3">
								<label class="label"><span class="label-text">Tag</span></label>
								@components.TaskTagInput(models.TagNone)
							</div>
								 @NewTaskAdvancedOptions()
 @TaskAutoMergeSwitches(&models.Task{})
}

// Quick controls under the composer; they mirror the Details rows.
templ NewTaskOptionsRow() {
 <div class="ov-task-options" data-new-task-options aria-label="Task options">
  <div class="ov-task-options-group">
   <button type="button" class="ov-task-option" data-picker-align="auto" data-detail-property="category" data-value="active" aria-haspopup="dialog" aria-label="Category">
    <svg width="13" height="13" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><circle cx="12" cy="12" r="9"/><polygon points="10 8 16 12 10 16 10 8"/></svg>
    <span data-property-label class="capitalize">active</span>
   </button>
   <button type="button" class="ov-task-option" data-picker-align="auto" data-detail-property="agent_definition_id" data-value="" aria-haspopup="dialog" aria-label="Agent">
    <svg width="13" height="13" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><circle cx="12" cy="8" r="4"/><path d="M4 20a8 8 0 0 1 16 0"/></svg>
    <span data-property-label>No agent</span>
   </button>
   <button type="button" class="ov-task-option" data-picker-align="auto" data-detail-property="tag" data-quick-tag data-value="" aria-haspopup="dialog" aria-label="Tag">
    <svg width="13" height="13" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M20.59 13.41 13.42 20.58a2 2 0 0 1-2.83 0L2 12V2h10l8.59 8.59a2 2 0 0 1 0 2.82z"/><line x1="7" y1="7" x2="7.01" y2="7"/></svg>
    <span data-quick-label>No tag</span>
   </button>
  </div>
  <div class="ov-task-options-group">
   <button type="button" class="ov-task-option" data-quick-auto-merge aria-pressed="false">
    <span class="ov-task-option-dot" aria-hidden="true"></span><span>Auto-merge</span>
   </button>
  </div>
  <style>
   #main-content #tab-chat:has([data-new-task-options]) .chat-input-shadow-gutter { padding-bottom:0; }
   .ov-task-options { display:flex; align-items:center; justify-content:space-between; gap:8px; padding:4px 4px 0; }
   html[data-thread-width="focused"] .ov-task-options { max-width:820px; width:100%; margin:0 auto; }
   .ov-task-options-group { display:flex; align-items:center; gap:2px; flex-wrap:wrap; min-width:0; }
   .ov-task-option { display:inline-flex; align-items:center; gap:5px; height:28px; padding:0 9px; border:0; border-radius:8px; background:transparent; color:oklch(var(--bc)/.52); font-size:12px; line-height:1; white-space:nowrap; cursor:pointer; transition:background .14s ease, color .14s ease; }
   .ov-task-option:hover, .ov-task-option[data-picker-return-focus] { background:oklch(var(--bc)/.06); color:oklch(var(--bc)/.9); }
   .ov-task-option:disabled { opacity:.5; cursor:default; }
   .ov-task-option[data-on="true"] { color:oklch(var(--bc)/.9); }
   .ov-task-option svg { opacity:.78; flex-shrink:0; }
   .ov-task-option-dot { width:6px; height:6px; border-radius:50%; background:oklch(var(--bc)/.32); transition:background .15s ease; }
   .ov-task-option[data-on="true"] .ov-task-option-dot { background:oklch(var(--su)); }
   #tab-chat:has([data-thread-empty-stage][hidden]) [data-new-task-options] { display:none; }
  </style>
  <script>
   (function() {
    var root = document.getElementById('task-detail-content');
    var row = root.querySelector('[data-new-task-options]');
    var details = root.querySelector('#tab-details');
    // Keep the quick buttons and Details rows showing the same value.
    function mirror(from) {
     var name = from.dataset.detailProperty, source = from.querySelector('[data-property-label]');
     root.querySelectorAll('[data-detail-property="' + name + '"]').forEach(function(to) {
      var label = to.querySelector('[data-property-label]');
      if (to === from || !label || !source || (to.dataset.value === from.dataset.value && label.textContent === source.textContent)) return;
      to.dataset.value = from.dataset.value;
      label.textContent = source.textContent;
     });
    }
    var tagRow = details.querySelector('[data-detail-property="tag"]');
    var quickTag = row.querySelector('[data-quick-tag]');
    var agentRow = details.querySelector('[data-detail-property="agent_definition_id"]');
    var quickAgent = row.querySelector('[data-detail-property="agent_definition_id"]');
    var quickCategory = row.querySelector('[data-detail-property="category"]');
    function syncState() {
     quickTag.dataset.value = tagRow.dataset.value;
     quickTag.querySelector('[data-quick-label]').textContent = tagRow.querySelector('[data-property-label]').textContent;
     quickTag.dataset.on = String(!!tagRow.dataset.value);
     if (quickAgent.disabled !== agentRow.disabled) quickAgent.disabled = agentRow.disabled;
     quickAgent.dataset.on = String(!!quickAgent.dataset.value);
     quickCategory.dataset.on = String(quickCategory.dataset.value === 'active');
    }
    var observer = new MutationObserver(function(records) {
     if (!root.isConnected) { observer.disconnect(); return; }
     records.forEach(function(record) {
      var node = record.target.nodeType === 1 ? record.target : record.target.parentElement;
      var target = node && node.closest('[data-detail-property]');
      if (target && target.dataset.detailProperty !== 'tag') mirror(target);
     });
     syncState();
    });
    root.querySelectorAll('[data-detail-property="category"], [data-detail-property="agent_definition_id"]').forEach(function(el) {
     observer.observe(el, {attributes:true, attributeFilter:['data-value', 'disabled'], childList:true, subtree:true, characterData:true});
    });
    observer.observe(tagRow, {attributes:true, attributeFilter:['data-value'], childList:true, subtree:true, characterData:true});
    syncState();
    var merge = row.querySelector('[data-quick-auto-merge]');
    function autoMerge() { return details.querySelector('#task-auto-merge-panel [name="auto_merge"]'); }
    function syncMerge() { var on = !!autoMerge()?.checked; merge.dataset.on = String(on); merge.setAttribute('aria-pressed', String(on)); }
    merge.addEventListener('click', function() { var input = autoMerge(); if (!input) return; input.checked = !input.checked; input.dispatchEvent(new Event('change', {bubbles:true})); });
    details.addEventListener('change', function(event) { if (event.target.name === 'auto_merge') syncMerge(); });
    syncMerge();
   })();
  </script>
 </div>
}

templ NewTaskAdvancedOptions() {
<div class="mt-3">
									<div class="space-y-3">
										<label class="label cursor-pointer justify-start gap-2 p-0">
											<input type="checkbox" name="swarm_mode" id="create-task-swarm-mode-toggle" onchange="document.getElementById('create-task-swarm-options').classList.toggle('hidden', !this.checked)" class="toggle toggle-sm toggle-primary"/>
											<span class="label-text font-medium">Swarm mode</span>
										</label>
										<div id="create-task-swarm-options" class="hidden space-y-3">
											<p class="text-xs opacity-70">Swarm planning starts when the parent task becomes Active. Choose Backlog to defer the planner until you run the task or move it to Active.</p>
											<div class="grid grid-cols-1 gap-3 sm:grid-cols-2">
												<div class="form-control">
													<label class="label"><span class="label-text">Max workers</span></label>
													<input type="number" name="swarm_max_workers" class="input input-bordered" min="1" max="8" value="3"/>
												</div>
												<div class="form-control">
													<label class="label"><span class="label-text">Worker isolation</span></label>
													<select name="swarm_worker_isolation" class="select select-bordered">
														<option value="worktree" selected>Worktree</option>
														<option value="read_only">Read only</option>
														<option value="shared">Shared</option>
													</select>
												</div>
											</div>
											<div class="flex flex-wrap gap-4">
												<input type="hidden" name="swarm_reviewer_enabled" value="false"/>
												<label class="label cursor-pointer justify-start gap-2 p-0">
													<input type="checkbox" name="swarm_reviewer_enabled" value="true" class="checkbox checkbox-sm" checked/>
													<span class="label-text">Reviewer enabled</span>
												</label>
												<input type="hidden" name="swarm_merger_enabled" value="false"/>
												<label class="label cursor-pointer justify-start gap-2 p-0">
													<input type="checkbox" name="swarm_merger_enabled" value="true" class="checkbox checkbox-sm" checked/>
													<span class="label-text">Merger enabled</span>
												</label>
											</div>
										</div>
									</div>
								</div>


}

templ NewTaskDetails(agents []models.LLMConfig, agentDefs []persistence.AgentTaskUIOption, projectRows ...templ.Component) {
 <div class="min-w-0">
  @TaskDetailMetrics(&models.Task{Category:models.CategoryActive, Priority:2, AgentID: newTaskDefaultModel()}, models.TaskExecutionMetrics{}, agents, "", projectRows...)
  for _, field := range []struct{ Name, Value string }{{"agent_definition_id",""},{"category","active"},{"priority","2"},{"tag",""},{"goal",""}} {
   <input type="hidden" name={ field.Name } value={ field.Value } data-draft-property={ field.Name } form="task-thread-form"/>
  }
  @TaskGoalPanel("", nil)
  @TaskAutoMergePanel(&models.Task{})
  <p class="text-xs opacity-60 mb-4">Settings apply when you send your first message. Active tasks start immediately; Backlog tasks are saved without running.</p>
  <details><summary class="text-sm cursor-pointer">Advanced options</summary>@NewTaskAdvancedOptions()</details>
 </div>
}

func newTaskDefaultModel() *string { value := "default"; return &value }

func projectDefaultAgentID(project *models.Project) string {
	if project == nil || project.DefaultAgentConfigID == nil {
		return ""
	}
	return *project.DefaultAgentConfigID
}

// Project selection uses the same compact row as the other Task properties.
templ NewTaskProjectRow(project *models.Project, projects []models.Project) {
  <button hidden?={ !models.IsAggregateProject(layout.WorkspaceProjectID(ctx, project.ID)) } type="button" class="task-property-row inspector-property-row" data-detail-property="destination_project" data-value={ newTaskDestinationValue(project) } aria-haspopup="dialog" data-placeholder={ components.ComposerDestinationPrompt(models.IsSharedProjectID(layout.WorkspaceProjectID(ctx, project.ID))) }>
   @components.InspectorPropertyContent(newTaskDestinationProperty(ctx, project), newTaskDestinationLabel(ctx, project))
   <input type="hidden" id="new-task-project" name="destination_project" form="task-thread-form" data-draft-property="destination_project" value={ newTaskDestinationValue(project) }/>
  </button>
}

func newTaskProjectChoices(ctx context.Context, project *models.Project) []models.Project {
 if !models.IsAggregateProject(layout.WorkspaceProjectID(ctx, project.ID)) { return []models.Project{*project} }
 return templateui.ProjectOptions(ctx)
}

func newTaskDestinationValue(project *models.Project) string {
 if models.IsAggregateProject(project.ID) { return "" }
 return project.ID
}
func newTaskDestinationProperty(ctx context.Context, project *models.Project) string {
 if models.IsSharedProjectID(layout.WorkspaceProjectID(ctx, project.ID)) { return "Server" }
 return "Project"
}
func newTaskDestinationLabel(ctx context.Context, project *models.Project) string {
 serverOnly := models.IsSharedProjectID(layout.WorkspaceProjectID(ctx, project.ID))
 if models.IsAggregateProject(project.ID) { return components.ComposerDestinationPrompt(serverOnly) }
 return components.ComposerDestinationLabel(ctx, *project, serverOnly)
}
