package pages

import (
	"encoding/json"
	"fmt"
	"strings"
	"time"
	"github.com/openvibely/openvibely/internal/models"
	"github.com/openvibely/openvibely/web/templates/layout"
)

templ Automations(projects []models.Project, currentProjectID string, cards []models.AutomationCard) {
	@layout.Base("Automations", projects, currentProjectID) {
		@automationsContent(cards, currentProjectID)
	}
}

templ AutomationsContent(cards []models.AutomationCard, currentProjectID string) {
	@automationsContent(cards, currentProjectID)
}

templ automationsContent(cards []models.AutomationCard, currentProjectID string) {
	<div id="automations-container" class="h-full overflow-y-auto min-w-0 max-w-full">
		@layout.PageTitle("Automations")
		<div class="mb-6 flex flex-wrap items-start justify-between gap-3">
			<div>
				<h2 class="text-2xl font-bold">Automations</h2>
				<p class="mt-1 text-sm text-base-content/65">Published autonomous processes explicitly created or registered for this project.</p>
			</div>
			<a class="btn btn-primary btn-sm" href={ templ.URL(fmt.Sprintf("/automations/new?project_id=%s", currentProjectID)) } hx-get={ fmt.Sprintf("/automations/new?project_id=%s", currentProjectID) } hx-target="#main-content" hx-push-url="true">New Automation</a>
		</div>
		if len(cards) == 0 {
			<div class="rounded-box bg-base-200/60 p-8 text-center">
				<h3 class="font-semibold">No published automations</h3>
					<p class="mt-2 text-sm text-base-content/65">Create one from Template, Describe It, or Blank. Maintained Native and GitHub setup can also register newly created resources. Existing tasks and schedules are never inferred or backfilled.</p>			</div>
		} else {
			<div class="grid grid-cols-1 gap-4 md:grid-cols-2 xl:grid-cols-3" data-card-search>
				for _, card := range cards {
					<a class="card min-w-0 border border-base-300 bg-base-100 shadow-sm transition hover:border-primary/50 hover:shadow-md" href={ templ.URL(fmt.Sprintf("/automations/%s?project_id=%s", card.Automation.ID, currentProjectID)) } hx-get={ fmt.Sprintf("/automations/%s?project_id=%s", card.Automation.ID, currentProjectID) } hx-target="#main-content" hx-push-url="true" data-search-card data-search-text={ automationCardSearchText(card) }>
						<div class="card-body min-w-0 p-5">
							<div class="flex min-w-0 items-start justify-between gap-3">
								<div class="min-w-0">
									<h3 class="truncate text-lg font-semibold">{ card.Automation.Name }</h3>
									<p class="mt-1 line-clamp-2 text-sm text-base-content/65">{ card.Automation.Description }</p>
								</div>
								<span class="badge badge-primary badge-outline shrink-0">{ string(card.Automation.LifecycleState) }</span>
							</div>
							<div class="mt-3 flex flex-wrap gap-2 text-xs">
								<span class="badge badge-ghost">{ card.Version.AdapterKey }</span>
								<span class="badge badge-ghost">v{ fmt.Sprintf("%d", card.Version.Version) }</span>
								<span class="badge badge-ghost">{ string(card.Automation.HealthState) }</span>
							</div>
							<div class="mt-3 grid grid-cols-2 gap-2 text-xs text-base-content/70">
								<div><span class="block font-medium text-base-content">Last activity</span>{ automationTime(card.LastRun, "Not run") }</div>
								<div><span class="block font-medium text-base-content">Next activity</span>{ automationTime(card.NextRun, "Not scheduled") }</div>
							</div>
							<div class="mt-2 text-xs text-base-content/60">{ fmt.Sprintf("%d linked resources", len(card.Resources)) }</div>
						</div>
					</a>
				}
			</div>
		}
	</div>
}

templ AutomationLive(projects []models.Project, currentProjectID string, graph models.AutomationLiveGraph) {
	@layout.Base(graph.Automation.Name, projects, currentProjectID) {
		@automationLiveContent(graph, currentProjectID)
	}
}

templ AutomationLiveContent(graph models.AutomationLiveGraph, currentProjectID string) {
	@automationLiveContent(graph, currentProjectID)
}

templ automationLiveContent(graph models.AutomationLiveGraph, currentProjectID string) {
	<div id="automation-live" class="h-full overflow-y-auto min-w-0 max-w-full" data-automation-id={ graph.Automation.ID } data-project-id={ currentProjectID }
		hx-get={ fmt.Sprintf("/automations/%s?project_id=%s", graph.Automation.ID, currentProjectID) }
		hx-trigger="every 20s [document.visibilityState === 'visible']" hx-target="this" hx-swap="outerHTML">
		@layout.PageTitle(graph.Automation.Name)
		<a class="btn btn-ghost btn-sm mb-3" href={ templ.URL(fmt.Sprintf("/automations?project_id=%s", currentProjectID)) } hx-get={ fmt.Sprintf("/automations?project_id=%s", currentProjectID) } hx-target="#main-content" hx-push-url="true">← Automations</a>
		<div class="mb-5 flex flex-wrap items-start justify-between gap-3">
			<div class="min-w-0"><h2 class="break-words text-2xl font-bold">{ graph.Automation.Name }</h2><p class="mt-1 max-w-3xl text-sm text-base-content/65">{ graph.Automation.Description }</p></div>
			<div class="flex flex-wrap items-center gap-2"><span class="badge badge-primary badge-outline">{ string(graph.Automation.LifecycleState) }</span><span class="badge badge-ghost">{ string(graph.Automation.HealthState) }</span><a class="btn btn-ghost btn-xs" href={ templ.URL(fmt.Sprintf("/automations/%s/history?project_id=%s", graph.Automation.ID, currentProjectID)) } hx-get={ fmt.Sprintf("/automations/%s/history?project_id=%s", graph.Automation.ID, currentProjectID) } hx-target="#main-content" hx-push-url="true">History</a><a class="btn btn-ghost btn-xs" href={ templ.URL(fmt.Sprintf("/automations/%s/definition?project_id=%s", graph.Automation.ID, currentProjectID)) } hx-get={ fmt.Sprintf("/automations/%s/definition?project_id=%s", graph.Automation.ID, currentProjectID) } hx-target="#main-content" hx-push-url="true">Definition</a><form method="post" action={ templ.SafeURL(fmt.Sprintf("/automations/%s/drafts?project_id=%s", graph.Automation.ID, currentProjectID)) } hx-post={ fmt.Sprintf("/automations/%s/drafts?project_id=%s", graph.Automation.ID, currentProjectID) } hx-target="#main-content"><input type="hidden" name="project_id" value={ currentProjectID }/><button class="btn btn-outline btn-xs" type="submit">Edit as new draft</button></form>
				if graph.Automation.LifecycleState == models.AutomationActive {
					<form method="post" action={ templ.SafeURL(fmt.Sprintf("/automations/%s/pause?project_id=%s", graph.Automation.ID, currentProjectID)) }><input type="hidden" name="project_id" value={ currentProjectID }/><button class="btn btn-ghost btn-xs" type="submit">Pause</button></form>
				}
				if graph.Automation.LifecycleState == models.AutomationPaused {
					<form method="post" action={ templ.SafeURL(fmt.Sprintf("/automations/%s/resume?project_id=%s", graph.Automation.ID, currentProjectID)) }><input type="hidden" name="project_id" value={ currentProjectID }/><button class="btn btn-ghost btn-xs" type="submit">Resume</button></form>
				}
				if graph.Automation.LifecycleState != models.AutomationArchived {
					<form method="post" action={ templ.SafeURL(fmt.Sprintf("/automations/%s/archive?project_id=%s", graph.Automation.ID, currentProjectID)) }><input type="hidden" name="project_id" value={ currentProjectID }/><button class="btn btn-ghost btn-xs text-error" type="submit">Archive</button></form>
				}
			</div>
		</div>
		<div class="mb-4 grid grid-cols-2 gap-3 md:grid-cols-4">
			<div class="stat rounded-box bg-base-200/60 p-3"><div class="stat-title text-xs">Active invocations</div><div class="stat-value text-xl">{ fmt.Sprintf("%d", graph.ActiveInvocations) }</div></div>
			<div class="stat rounded-box bg-base-200/60 p-3"><div class="stat-title text-xs">Open work items</div><div class="stat-value text-xl">{ fmt.Sprintf("%d", graph.ActiveWorkItems) }</div></div>
			<div class="stat rounded-box bg-base-200/60 p-3"><div class="stat-title text-xs">Topology</div><div class="stat-value text-sm">v{ fmt.Sprintf("%d", graph.Version.Version) }</div></div>
			<div class="stat rounded-box bg-base-200/60 p-3"><div class="stat-title text-xs">Recent since</div><div class="stat-value text-sm">{ graph.RecentCutoff.Local().Format("Jan 2, 3:04 PM") }</div></div>
		</div>
		if len(graph.LegacyWork) > 0 {
			<div class="mb-4 rounded-box border border-warning/40 bg-warning/10 px-4 py-3" aria-label="Legacy automation work">
				<h3 class="text-sm font-semibold">Legacy work</h3>
				<div class="mt-2 flex flex-wrap gap-2">
					for _, group := range graph.LegacyWork {
						<span class="badge badge-warning badge-outline">v{ fmt.Sprintf("%d", group.Version) }: { fmt.Sprintf("%d", group.Count) } unmapped</span>
					}
				</div>
			</div>
		}
		<div class="grid min-w-0 grid-cols-1 gap-4 xl:grid-cols-[minmax(0,1fr)_22rem]">
			<div class="rounded-box border border-base-300 bg-base-100 p-4 min-w-0">
				<div class="mb-3 flex flex-wrap gap-2 text-xs" aria-label="Graph status legend">
					for _, state := range []string{"failed", "blocked", "waiting_human", "running", "recently_completed", "idle"} {
						<span class="badge badge-ghost">{ automationStateLabel(state) }</span>
					}
				</div>
				<div class="w-full overflow-auto" role="region" aria-label="Live automation graph">
					<svg viewBox={ fmt.Sprintf("0 0 %d %d", automationLiveGraphWidth(graph.Nodes), automationLiveGraphHeight(graph.Nodes)) } class="min-h-[420px] min-w-[900px] w-full" role="img" aria-label={ graph.Automation.Name + " live automation graph" }>
						<defs><marker id="automation-live-arrow" markerWidth="10" markerHeight="10" refX="8" refY="3" orient="auto"><path d="M0,0 L0,6 L9,3 z" class="fill-base-content/35"></path></marker></defs>
					for _, edge := range graph.Edges {
						if source, target, ok := automationLiveEdgeNodes(graph.Nodes, edge.AutomationEdge); ok {
							<line x1={ fmt.Sprintf("%.0f", source.PositionX+145) } y1={ fmt.Sprintf("%.0f", source.PositionY+55) } x2={ fmt.Sprintf("%.0f", target.PositionX+15) } y2={ fmt.Sprintf("%.0f", target.PositionY+55) } class={ templ.KV("stroke-primary", edge.Highlighted), templ.KV("stroke-base-content/35", !edge.Highlighted) } stroke-width="2" marker-end="url(#automation-live-arrow)" aria-label={ fmt.Sprintf("%s, %d transitions, %d recent", edge.Label, edge.TransitionCount, edge.RecentTransitionCount) }></line>
						}
					}
					for _, node := range graph.Nodes {
							<a href="#automation-node-resources" tabindex="0" aria-label={ automationLiveNodeAria(node) } hx-get={ fmt.Sprintf("/automations/%s/nodes/%s/resources?project_id=%s", graph.Automation.ID, node.ID, currentProjectID) } hx-target="#automation-node-resources" hx-swap="innerHTML">
								<rect x={ fmt.Sprintf("%.0f", node.PositionX+10) } y={ fmt.Sprintf("%.0f", node.PositionY+20) } width="140" height="76" rx="10" class={ automationLiveNodeClass(node.DisplayState) } stroke-width="3"></rect>
								<text x={ fmt.Sprintf("%.0f", node.PositionX+80) } y={ fmt.Sprintf("%.0f", node.PositionY+47) } text-anchor="middle" class="fill-base-content text-[12px] font-semibold">{ automationNodeLabel(node.Name, 20) }</text>
								<text x={ fmt.Sprintf("%.0f", node.PositionX+80) } y={ fmt.Sprintf("%.0f", node.PositionY+66) } text-anchor="middle" class="fill-base-content/70 text-[10px]">{ automationStateLabel(node.DisplayState) }</text>
								<text x={ fmt.Sprintf("%.0f", node.PositionX+80) } y={ fmt.Sprintf("%.0f", node.PositionY+83) } text-anchor="middle" class="fill-base-content/60 text-[9px]">{ automationNodeCountLabel(node.Counts) }</text>
							</a>
						}
					</svg>
				</div>
			</div>
			<aside id="automation-node-resources" class="rounded-box border border-base-300 bg-base-100 p-4" aria-live="polite"><h3 class="font-semibold">Node resources</h3><p class="mt-2 text-sm text-base-content/60">Select a node to inspect bounded task, execution, Alert, issue, and pull request links.</p></aside>
		</div>
	</div>
	<script>
		(function() {
			if (window._automationLiveEventBound) return;
			window._automationLiveEventBound = true;
			window.addEventListener('sse-automation-event', function(event) {
				var root = document.getElementById('automation-live');
				if (!root || !event.detail) return;
				if (event.detail.project_id && event.detail.project_id !== root.dataset.projectId) return;
				if (event.detail.automation_id && event.detail.automation_id !== root.dataset.automationId) return;
				clearTimeout(window._automationLiveRefreshTimer);
				window._automationLiveRefreshTimer = setTimeout(function() { if (document.getElementById('automation-live')) htmx.ajax('GET', root.getAttribute('hx-get'), {target: '#automation-live', swap: 'outerHTML'}); }, 250);
			});
		})();
	</script>
}

templ AutomationNodeResources(resources []models.AutomationNodeResource) {
	<h3 class="font-semibold">Node resources</h3>
	if len(resources) == 0 {
		<p class="mt-2 text-sm text-base-content/60">No recent runtime resources.</p>
	} else {
		<div class="mt-3 space-y-2">
			for _, resource := range resources {
				if resource.URL != "" {
					<a class="block rounded-lg bg-base-200/60 p-3 hover:bg-base-200" href={ templ.URL(resource.URL) }>
						<div class="flex items-start justify-between gap-2"><span class="min-w-0 break-words text-sm font-medium">{ resource.Name }</span><span class="badge badge-sm">{ resource.Status }</span></div>
						<p class="mt-1 text-xs text-base-content/55">{ resource.ResourceType }</p>
					</a>
				} else {
					<div class="rounded-lg bg-base-200/60 p-3"><div class="flex items-start justify-between gap-2"><span class="min-w-0 break-words text-sm font-medium">{ resource.Name }</span><span class="badge badge-sm">{ resource.Status }</span></div><p class="mt-1 text-xs text-base-content/55">{ resource.ResourceType }</p></div>
				}
			}
		</div>
	}
}

func automationLiveGraphWidth(nodes []models.AutomationLiveNode) int { max := 900.0; for _, n := range nodes { if n.PositionX+180 > max { max = n.PositionX+180 } }; return int(max) }
func automationLiveGraphHeight(nodes []models.AutomationLiveNode) int { max := 420.0; for _, n := range nodes { if n.PositionY+140 > max { max = n.PositionY+140 } }; return int(max) }
func automationLiveEdgeNodes(nodes []models.AutomationLiveNode, edge models.AutomationEdge) (models.AutomationLiveNode, models.AutomationLiveNode, bool) { var source, target models.AutomationLiveNode; var foundSource, foundTarget bool; for _, n := range nodes { if n.ID == edge.SourceNodeID { source, foundSource = n, true }; if n.ID == edge.TargetNodeID { target, foundTarget = n, true } }; return source, target, foundSource && foundTarget }
func automationLiveNodeClass(state string) string { base := "fill-base-200 stroke-base-content/30"; switch state { case "failed": return "fill-error/15 stroke-error"; case "blocked": return "fill-warning/15 stroke-warning"; case "waiting_human": return "fill-info/15 stroke-info"; case "running": return "fill-primary/15 stroke-primary"; case "recently_completed": return "fill-success/15 stroke-success" }; return base }
func automationStateLabel(state string) string { return strings.ReplaceAll(strings.Title(strings.ReplaceAll(state, "_", " ")), "Human", "human") }
func automationNodeCountLabel(c models.AutomationNodeCounts) string { return fmt.Sprintf("%d run · %d wait · %d block · %d fail · %d done", c.Running, c.Waiting, c.Blocked, c.Failed, c.CompletedRecently) }
func automationLiveNodeAria(node models.AutomationLiveNode) string { return node.Name + ", " + automationStateLabel(node.DisplayState) + ", " + automationNodeCountLabel(node.Counts) }

templ AutomationDefinition(projects []models.Project, currentProjectID string, definition models.AutomationDefinition, resources []models.AutomationResourceSummary) {
	@layout.Base(definition.Automation.Name, projects, currentProjectID) {
		@automationDefinitionContent(definition, resources, currentProjectID)
	}
}

templ AutomationDefinitionContent(definition models.AutomationDefinition, resources []models.AutomationResourceSummary, currentProjectID string) {
	@automationDefinitionContent(definition, resources, currentProjectID)
}

templ automationDefinitionContent(definition models.AutomationDefinition, resources []models.AutomationResourceSummary, currentProjectID string) {
	<div id="automation-definition" class="h-full overflow-y-auto min-w-0 max-w-full">
		@layout.PageTitle(definition.Automation.Name)
		<a class="btn btn-ghost btn-sm mb-3" href={ templ.URL(fmt.Sprintf("/automations?project_id=%s", currentProjectID)) } hx-get={ fmt.Sprintf("/automations?project_id=%s", currentProjectID) } hx-target="#main-content" hx-push-url="true">← Automations</a>
		<div class="mb-5 flex flex-wrap items-start justify-between gap-3">
			<div class="min-w-0">
				<h2 class="break-words text-2xl font-bold">{ definition.Automation.Name }</h2>
				<p class="mt-1 max-w-3xl text-sm text-base-content/65">{ definition.Automation.Description }</p>
			</div>
			<div class="flex flex-wrap gap-2">
				<span class="badge badge-primary badge-outline">{ string(definition.Automation.LifecycleState) }</span>
				<span class="badge badge-ghost">{ definition.Version.AdapterKey }</span>
				<span class="badge badge-ghost">v{ fmt.Sprintf("%d", definition.Version.Version) }</span>
				<a class="btn btn-ghost btn-xs" href={ templ.URL(fmt.Sprintf("/automations/%s?project_id=%s", definition.Automation.ID, currentProjectID)) } hx-get={ fmt.Sprintf("/automations/%s?project_id=%s", definition.Automation.ID, currentProjectID) } hx-target="#main-content" hx-push-url="true">Live</a>
				<a class="btn btn-ghost btn-xs" href={ templ.URL(fmt.Sprintf("/automations/%s/history?project_id=%s", definition.Automation.ID, currentProjectID)) } hx-get={ fmt.Sprintf("/automations/%s/history?project_id=%s", definition.Automation.ID, currentProjectID) } hx-target="#main-content" hx-push-url="true">History</a>
			</div>
		</div>
		<div class="mb-5 rounded-box border border-base-300 bg-base-100 p-4">
			<div class="mb-3 flex items-center justify-between gap-3"><h3 class="font-semibold">Published definition</h3><span class="text-xs text-base-content/60">Read-only</span></div>
			<div class="w-full overflow-x-auto" role="region" aria-label="Automation definition graph">
				<svg viewBox={ fmt.Sprintf("0 0 %d %d", automationGraphWidth(definition.Nodes), automationGraphHeight(definition.Nodes)) } class="min-h-[420px] min-w-[900px] w-full" role="img" aria-label={ definition.Automation.Name + " automation graph" }>
					<defs><marker id="automation-arrow" markerWidth="10" markerHeight="10" refX="8" refY="3" orient="auto"><path d="M0,0 L0,6 L9,3 z" class="fill-base-content/35"></path></marker></defs>
					for _, edge := range definition.Edges {
						if source, target, ok := automationEdgeNodes(definition.Nodes, edge); ok {
							<line x1={ fmt.Sprintf("%.0f", source.PositionX+145) } y1={ fmt.Sprintf("%.0f", source.PositionY+55) } x2={ fmt.Sprintf("%.0f", target.PositionX+15) } y2={ fmt.Sprintf("%.0f", target.PositionY+55) } class="stroke-base-content/35" stroke-width="2" marker-end="url(#automation-arrow)"></line>
						}
					}
					for _, node := range definition.Nodes {
						<a href={ templ.SafeURL("#automation-node-" + node.ID) } aria-label={ node.Name + ", " + string(node.NodeType) }>
							<rect x={ fmt.Sprintf("%.0f", node.PositionX+10) } y={ fmt.Sprintf("%.0f", node.PositionY+20) } width="140" height="70" rx="10" class="fill-base-200 stroke-base-content/25" stroke-width="2"></rect>
							<text x={ fmt.Sprintf("%.0f", node.PositionX+80) } y={ fmt.Sprintf("%.0f", node.PositionY+50) } text-anchor="middle" class="fill-base-content text-[12px] font-semibold">{ automationNodeLabel(node.Name, 20) }</text>
							<text x={ fmt.Sprintf("%.0f", node.PositionX+80) } y={ fmt.Sprintf("%.0f", node.PositionY+70) } text-anchor="middle" class="fill-base-content/60 text-[10px]">{ string(node.NodeType) }</text>
						</a>
					}
				</svg>
			</div>
		</div>
		<div class="grid grid-cols-1 gap-3 lg:grid-cols-2">
			for _, node := range definition.Nodes {
				<div id={ "automation-node-" + node.ID } class="rounded-box border border-base-300 bg-base-100 p-4 min-w-0">
					<div class="flex items-start justify-between gap-3"><div><h3 class="font-semibold">{ node.Name }</h3><p class="text-xs text-base-content/60">{ node.Role }</p></div><span class="badge badge-ghost badge-sm">{ string(node.NodeType) }</span></div>
					<div class="mt-3 space-y-2">
						for _, resource := range resourcesForAutomationNode(resources, node.ID) {
							<a class="flex min-w-0 items-center justify-between gap-3 rounded-lg bg-base-200/60 px-3 py-2 text-sm hover:bg-base-200" href={ templ.URL(resource.URL) }>
								<span class="min-w-0 truncate">{ resource.Name }</span><span class="badge badge-sm shrink-0">{ resource.Status }</span>
							</a>
						}
						if len(resourcesForAutomationNode(resources, node.ID)) == 0 {
							<p class="text-xs text-base-content/50">No definition resource linked.</p>
						}
					</div>
				</div>
			}
		</div>
	</div>
}

templ AutomationHistory(projects []models.Project, currentProjectID string, dashboard models.AutomationHistoryDashboard, workItemStatus string) {
	@layout.Base(dashboard.Automation.Name+" History", projects, currentProjectID) {
		@automationHistoryContent(dashboard, currentProjectID, workItemStatus)
	}
}

templ AutomationHistoryContent(dashboard models.AutomationHistoryDashboard, currentProjectID string, workItemStatus string) {
	@automationHistoryContent(dashboard, currentProjectID, workItemStatus)
}

templ automationHistoryContent(dashboard models.AutomationHistoryDashboard, currentProjectID string, workItemStatus string) {
	<div id="automation-history" class="h-full overflow-y-auto min-w-0 max-w-full" data-automation-metrics={ templ.JSONString(automationMetricsJSON(dashboard.Metrics)) }>
		@layout.PageTitle(dashboard.Automation.Name + " History")
		<a class="btn btn-ghost btn-sm mb-3" href={ templ.URL(fmt.Sprintf("/automations?project_id=%s", currentProjectID)) } hx-get={ fmt.Sprintf("/automations?project_id=%s", currentProjectID) } hx-target="#main-content" hx-push-url="true">← Automations</a>
		<div class="mb-5 flex flex-wrap items-start justify-between gap-3">
			<div><h2 class="text-2xl font-bold">{ dashboard.Automation.Name }</h2><p class="mt-1 text-sm text-base-content/65">Persisted invocation and work-item history.</p></div>
			<div class="flex flex-wrap items-center gap-2"><span class={ automationHealthBadgeClass(dashboard.Health.State) }>{ string(dashboard.Health.State) }</span><a class="btn btn-ghost btn-xs" href={ templ.URL(fmt.Sprintf("/automations/%s?project_id=%s", dashboard.Automation.ID, currentProjectID)) } hx-get={ fmt.Sprintf("/automations/%s?project_id=%s", dashboard.Automation.ID, currentProjectID) } hx-target="#main-content" hx-push-url="true">Live</a><a class="btn btn-ghost btn-xs" href={ templ.URL(fmt.Sprintf("/automations/%s/definition?project_id=%s", dashboard.Automation.ID, currentProjectID)) } hx-get={ fmt.Sprintf("/automations/%s/definition?project_id=%s", dashboard.Automation.ID, currentProjectID) } hx-target="#main-content" hx-push-url="true">Definition</a></div>
		</div>
		<div class="mb-5 rounded-box border border-base-300 bg-base-100 p-4">
			<div class="flex flex-wrap items-start justify-between gap-3"><div><h3 class="font-semibold">Automation health</h3><p class="mt-1 text-sm text-base-content/65">{ dashboard.Health.Reason }</p></div><span class="text-xs text-base-content/55">Evaluated { dashboard.Health.EvaluatedAt.Local().Format("Jan 2, 3:04 PM") }</span></div>
		</div>
		<div class="mb-5 grid grid-cols-1 gap-4 xl:grid-cols-2">
			<div class="rounded-box border border-base-300 bg-base-100 p-4"><h3 class="font-semibold">Conversion funnel</h3><p class="mt-1 text-xs text-base-content/55">Entered work items relative to the first node with a persisted entry.</p><div class="mt-3 h-72"><canvas id="automation-funnel-chart" aria-label="Automation conversion funnel"></canvas></div></div>
			<div class="rounded-box border border-base-300 bg-base-100 p-4"><h3 class="font-semibold">Average node duration</h3><p class="mt-1 text-xs text-base-content/55">First entry into a node until the next persisted transition for the same work item.</p><div class="mt-3 h-72"><canvas id="automation-duration-chart" aria-label="Average automation node duration"></canvas></div></div>
		</div>
			<div class="mb-5 grid grid-cols-1 gap-4 xl:grid-cols-2">
				<div class="rounded-box border border-base-300 bg-base-100 p-4">
					<h3 class="font-semibold">Recent failures</h3>
					if len(dashboard.Metrics.Failures) == 0 {
						<p class="mt-2 text-sm text-base-content/55">No persisted failures in the last 30 days.</p>
					} else {
						<div class="mt-3 space-y-2">
							for _, failure := range dashboard.Metrics.Failures {
								<div class="flex items-center justify-between gap-3 rounded-lg bg-base-200/60 px-3 py-2 text-sm"><span>{ failure.NodeName }</span><span class="badge badge-error badge-outline">{ fmt.Sprintf("%d", failure.Count) }</span></div>
							}
						</div>
					}
				</div>
				<div class="rounded-box border border-base-300 bg-base-100 p-4">
					<h3 class="font-semibold">Current bottlenecks</h3>
					if len(dashboard.Metrics.Bottlenecks) == 0 {
						<p class="mt-2 text-sm text-base-content/55">No waiting or blocked positions.</p>
					} else {
						<div class="mt-3 space-y-2">
							for _, item := range dashboard.Metrics.Bottlenecks {
								<div class="flex items-center justify-between gap-3 rounded-lg bg-base-200/60 px-3 py-2 text-sm"><span>{ item.NodeName }</span><span class="text-xs">{ fmt.Sprintf("%d waiting · %d blocked", item.Waiting, item.Blocked) }</span></div>
							}
						</div>
					}
				</div>
			</div>
			<div class="grid grid-cols-1 gap-5 xl:grid-cols-2">
				<section class="rounded-box border border-base-300 bg-base-100 p-4"><h3 class="font-semibold">Invocations</h3>
					if len(dashboard.Invocations.Items) == 0 {
						<p class="mt-2 text-sm text-base-content/55">No invocation history.</p>
					} else {
						<div class="mt-3 space-y-2">
							for _, invocation := range dashboard.Invocations.Items {
								<a class="block rounded-lg bg-base-200/60 p-3 hover:bg-base-200" href={ templ.URL(fmt.Sprintf("/automations/%s/invocations/%s?project_id=%s", dashboard.Automation.ID, invocation.ID, currentProjectID)) } hx-get={ fmt.Sprintf("/automations/%s/invocations/%s?project_id=%s", dashboard.Automation.ID, invocation.ID, currentProjectID) } hx-target="#main-content" hx-push-url="true"><div class="flex items-center justify-between gap-3"><span class="text-sm font-medium">{ automationInvocationLabel(invocation) }</span><span class="badge badge-sm">{ string(invocation.Status) }</span></div><p class="mt-1 text-xs text-base-content/55">{ automationInvocationHistoryTime(invocation).Local().Format("Jan 2, 3:04 PM") }</p></a>
							}
						</div>
					}
					if dashboard.Invocations.NextCursor != "" {
						<a class="btn btn-ghost btn-sm mt-3" href={ templ.URL(fmt.Sprintf("/automations/%s/history?project_id=%s&invocation_cursor=%s", dashboard.Automation.ID, currentProjectID, dashboard.Invocations.NextCursor)) } hx-get={ fmt.Sprintf("/automations/%s/history?project_id=%s&invocation_cursor=%s", dashboard.Automation.ID, currentProjectID, dashboard.Invocations.NextCursor) } hx-target="#main-content" hx-push-url="true">Next invocations</a>
					}
			</section>
				<section class="rounded-box border border-base-300 bg-base-100 p-4">
					<div class="flex flex-wrap items-center justify-between gap-3">
						<h3 class="font-semibold">Work items</h3>
						<form method="get" action={ templ.SafeURL(fmt.Sprintf("/automations/%s/history", dashboard.Automation.ID)) } hx-get={ fmt.Sprintf("/automations/%s/history", dashboard.Automation.ID) } hx-target="#main-content" hx-push-url="true" class="flex gap-2">
							<input type="hidden" name="project_id" value={ currentProjectID }/>
							<select name="work_item_status" class="select select-bordered select-xs">
								<option value="" selected?={ workItemStatus == "" }>All states</option>
								for _, state := range []string{"active", "waiting", "blocked", "failed", "completed", "cancelled"} {
									<option value={ state } selected?={ workItemStatus == state }>{ state }</option>
								}
							</select>
							<button class="btn btn-ghost btn-xs" type="submit">Filter</button>
						</form>
					</div>
					if len(dashboard.WorkItems.Items) == 0 {
						<p class="mt-2 text-sm text-base-content/55">No work-item history.</p>
					} else {
						<div class="mt-3 space-y-2">
							for _, item := range dashboard.WorkItems.Items {
								<a class="block rounded-lg bg-base-200/60 p-3 hover:bg-base-200" href={ templ.URL(fmt.Sprintf("/automations/%s/work-items/%s?project_id=%s", dashboard.Automation.ID, item.ID, currentProjectID)) } hx-get={ fmt.Sprintf("/automations/%s/work-items/%s?project_id=%s", dashboard.Automation.ID, item.ID, currentProjectID) } hx-target="#main-content" hx-push-url="true"><div class="flex items-center justify-between gap-3"><span class="min-w-0 break-words text-sm font-medium">{ automationWorkItemLabel(item) }</span><span class="badge badge-sm">{ string(item.Status) }</span></div><p class="mt-1 text-xs text-base-content/55">Started { item.CreatedAt.Local().Format("Jan 2, 3:04 PM") }</p></a>
							}
						</div>
					}
					if dashboard.WorkItems.NextCursor != "" {
						<a class="btn btn-ghost btn-sm mt-3" href={ templ.URL(fmt.Sprintf("/automations/%s/history?project_id=%s&work_item_status=%s&work_item_cursor=%s", dashboard.Automation.ID, currentProjectID, workItemStatus, dashboard.WorkItems.NextCursor)) } hx-get={ fmt.Sprintf("/automations/%s/history?project_id=%s&work_item_status=%s&work_item_cursor=%s", dashboard.Automation.ID, currentProjectID, workItemStatus, dashboard.WorkItems.NextCursor) } hx-target="#main-content" hx-push-url="true">Next work items</a>
					}
				</section>		</div>
	</div>
	<script>
		(function() {
			function destroyAutomationHistoryCharts() { var charts = window._automationHistoryCharts || {}; Object.keys(charts).forEach(function(key) { if (charts[key]) charts[key].destroy(); }); window._automationHistoryCharts = {}; }
			function loadAutomationChartJS() { if (window.Chart) return Promise.resolve(); if (window._automationChartLoader) return window._automationChartLoader; window._automationChartLoader = new Promise(function(resolve, reject) { var script = document.createElement('script'); script.src = 'https://cdn.jsdelivr.net/npm/chart.js@4.4.1/dist/chart.umd.min.js'; script.onload = resolve; script.onerror = reject; document.head.appendChild(script); }); return window._automationChartLoader; }
			function initAutomationHistoryCharts() { var root = document.getElementById('automation-history'); if (!root) return; var metrics = {}; try { metrics = JSON.parse(root.dataset.automationMetrics || '{}'); } catch (_) { return; } loadAutomationChartJS().then(function() { if (!document.getElementById('automation-history')) return; destroyAutomationHistoryCharts(); var charts = window._automationHistoryCharts; var funnel = metrics.funnel || []; var durations = metrics.durations || []; var funnelCanvas = document.getElementById('automation-funnel-chart'); var durationCanvas = document.getElementById('automation-duration-chart'); if (funnelCanvas) charts.funnel = new Chart(funnelCanvas.getContext('2d'), {type:'bar',data:{labels:funnel.map(function(p){return p.node_name;}),datasets:[{label:'Conversion %',data:funnel.map(function(p){return p.conversion_percent;}),backgroundColor:'rgba(59,130,246,.5)',borderColor:'rgb(59,130,246)',borderWidth:1}]},options:{responsive:true,maintainAspectRatio:false,scales:{y:{beginAtZero:true,max:100}},plugins:{legend:{position:'bottom'}}}}); if (durationCanvas) charts.duration = new Chart(durationCanvas.getContext('2d'), {type:'bar',data:{labels:durations.map(function(p){return p.node_name;}),datasets:[{label:'Average seconds',data:durations.map(function(p){return p.average_seconds;}),backgroundColor:'rgba(20,184,166,.5)',borderColor:'rgb(20,184,166)',borderWidth:1}]},options:{indexAxis:'y',responsive:true,maintainAspectRatio:false,scales:{x:{beginAtZero:true}},plugins:{legend:{position:'bottom'}}}}); }).catch(function() {}); }
			window.initAutomationHistoryCharts = initAutomationHistoryCharts;
			if (!window._automationHistoryCleanupBound) { window._automationHistoryCleanupBound = true; document.body.addEventListener('htmx:beforeSwap', function(event) { var target = event.detail && event.detail.target; if (target && (target.id === 'main-content' || target.id === 'automation-history' || (target.querySelector && target.querySelector('#automation-history')))) destroyAutomationHistoryCharts(); }); }
			initAutomationHistoryCharts();
		})();
	</script>
}

templ AutomationInvocationHistory(projects []models.Project, currentProjectID string, history models.AutomationInvocationHistory) {
	@layout.Base(history.Definition.Automation.Name+" Invocation", projects, currentProjectID) {
		@automationInvocationHistoryContent(history, currentProjectID)
	}
}

templ AutomationInvocationHistoryContent(history models.AutomationInvocationHistory, currentProjectID string) {
	@automationInvocationHistoryContent(history, currentProjectID)
}

templ automationInvocationHistoryContent(history models.AutomationInvocationHistory, currentProjectID string) {
	<div id="automation-invocation-history" class="h-full overflow-y-auto min-w-0 max-w-full">
		@layout.PageTitle(history.Definition.Automation.Name + " Invocation")
		<a class="btn btn-ghost btn-sm mb-3" href={ templ.URL(fmt.Sprintf("/automations/%s/history?project_id=%s", history.Definition.Automation.ID, currentProjectID)) } hx-get={ fmt.Sprintf("/automations/%s/history?project_id=%s", history.Definition.Automation.ID, currentProjectID) } hx-target="#main-content" hx-push-url="true">← History</a>
		<div class="mb-5 flex flex-wrap items-start justify-between gap-3"><div><h2 class="text-2xl font-bold">Invocation</h2><p class="mt-1 text-sm text-base-content/60">{ automationInvocationLabel(history.Invocation) } · topology v{ fmt.Sprintf("%d", history.Definition.Version.Version) }</p></div><span class="badge">{ string(history.Invocation.Status) }</span></div>
		<div class="mb-5 rounded-box border border-base-300 bg-base-100 p-4">
			<h3 class="font-semibold">Invocation graph</h3><p class="mt-1 text-xs text-base-content/55">Immutable topology with nodes touched only by this occurrence highlighted.</p>
			<div class="mt-3 w-full overflow-auto">
				<svg viewBox={ fmt.Sprintf("0 0 %d %d", automationGraphWidth(history.Definition.Nodes), automationGraphHeight(history.Definition.Nodes)) } class="min-h-[420px] min-w-[900px] w-full" role="img" aria-label="Invocation graph">
					for _, edge := range history.Definition.Edges {
						if source, target, ok := automationEdgeNodes(history.Definition.Nodes, edge); ok {
							<line x1={ fmt.Sprintf("%.0f", source.PositionX+145) } y1={ fmt.Sprintf("%.0f", source.PositionY+55) } x2={ fmt.Sprintf("%.0f", target.PositionX+15) } y2={ fmt.Sprintf("%.0f", target.PositionY+55) } class="stroke-base-content/30" stroke-width="2"></line>
						}
					}
					for _, node := range history.Definition.Nodes {
						<rect x={ fmt.Sprintf("%.0f", node.PositionX+10) } y={ fmt.Sprintf("%.0f", node.PositionY+20) } width="140" height="70" rx="10" class={ automationInvocationNodeClass(history, node.ID) } stroke-width="3"></rect>
						<text x={ fmt.Sprintf("%.0f", node.PositionX+80) } y={ fmt.Sprintf("%.0f", node.PositionY+55) } text-anchor="middle" class="fill-base-content text-[12px] font-semibold">{ automationNodeLabel(node.Name, 20) }</text>
					}
				</svg>
			</div>
		</div>
		<div class="grid grid-cols-1 gap-5 xl:grid-cols-2">
				<section class="rounded-box border border-base-300 bg-base-100 p-4">
					<h3 class="font-semibold">Occurrence activities</h3>
					if len(history.Activities.Items) == 0 {
						<p class="mt-2 text-sm text-base-content/55">No activities for this occurrence.</p>
					} else {
						<div class="mt-3 space-y-2">
							for _, activity := range history.Activities.Items {
								<div class="rounded-lg bg-base-200/60 p-3"><div class="flex justify-between gap-3"><span class="text-sm font-medium">{ activity.ActivityType }</span><span class="badge badge-sm">{ string(activity.Status) }</span></div><p class="mt-1 text-xs text-base-content/55">{ activity.StartedAt.Local().Format("Jan 2, 3:04 PM") }</p></div>
							}
						</div>
					}
					if history.Activities.NextCursor != "" {
						<a class="btn btn-ghost btn-sm mt-3" href={ templ.URL(fmt.Sprintf("/automations/%s/invocations/%s?project_id=%s&activity_cursor=%s", history.Definition.Automation.ID, history.Invocation.ID, currentProjectID, history.Activities.NextCursor)) } hx-get={ fmt.Sprintf("/automations/%s/invocations/%s?project_id=%s&activity_cursor=%s", history.Definition.Automation.ID, history.Invocation.ID, currentProjectID, history.Activities.NextCursor) } hx-target="#main-content" hx-push-url="true">Next activities</a>
					}
				</section>
			<section class="rounded-box border border-base-300 bg-base-100 p-4">
				<h3 class="font-semibold">Occurrence transitions</h3>
				@automationTransitionTimeline(history.Transitions.Items, history.Definition.Nodes)
				if history.Transitions.NextCursor != "" {
					<a class="btn btn-ghost btn-sm mt-3" href={ templ.URL(fmt.Sprintf("/automations/%s/invocations/%s?project_id=%s&cursor=%s", history.Definition.Automation.ID, history.Invocation.ID, currentProjectID, history.Transitions.NextCursor)) } hx-get={ fmt.Sprintf("/automations/%s/invocations/%s?project_id=%s&cursor=%s", history.Definition.Automation.ID, history.Invocation.ID, currentProjectID, history.Transitions.NextCursor) } hx-target="#main-content" hx-push-url="true">Next transitions</a>
				}
			</section>
		</div>
	</div>
}

templ AutomationWorkItemHistory(projects []models.Project, currentProjectID string, history models.AutomationWorkItemHistory) {
	@layout.Base(history.Definition.Automation.Name+" Work Item", projects, currentProjectID) {
		@automationWorkItemHistoryContent(history, currentProjectID)
	}
}

templ AutomationWorkItemHistoryContent(history models.AutomationWorkItemHistory, currentProjectID string) {
	@automationWorkItemHistoryContent(history, currentProjectID)
}

templ automationWorkItemHistoryContent(history models.AutomationWorkItemHistory, currentProjectID string) {
	<div id="automation-work-item-history" class="h-full overflow-y-auto min-w-0 max-w-full" data-replay={ templ.JSONString(automationReplayJSON(history.Replay)) }>
		@layout.PageTitle(history.Definition.Automation.Name + " Work Item")
		<a class="btn btn-ghost btn-sm mb-3" href={ templ.URL(fmt.Sprintf("/automations/%s/history?project_id=%s", history.Definition.Automation.ID, currentProjectID)) } hx-get={ fmt.Sprintf("/automations/%s/history?project_id=%s", history.Definition.Automation.ID, currentProjectID) } hx-target="#main-content" hx-push-url="true">← History</a>
		<div class="mb-5 flex flex-wrap items-start justify-between gap-3"><div><h2 class="break-words text-2xl font-bold">{ automationWorkItemLabel(history.WorkItem) }</h2><p class="mt-1 text-sm text-base-content/60">Cross-invocation lifetime · topology v{ fmt.Sprintf("%d", history.Definition.Version.Version) }</p></div><span class="badge">{ string(history.WorkItem.Status) }</span></div>
		<div class="mb-5 rounded-box border border-base-300 bg-base-100 p-4">
			<div class="flex flex-wrap items-center justify-between gap-3">
				<div><h3 class="font-semibold">Transition replay</h3><p class="mt-1 text-xs text-base-content/55">Frames come only from append-only persisted transitions.</p></div>
				if len(history.Replay) > 0 {
					<span id="automation-replay-label" class="text-xs text-base-content/60"></span>
				}
			</div>
			if len(history.Replay) == 0 {
				<p class="mt-3 text-sm text-base-content/55">No transitions to replay.</p>
			} else {
				<input id="automation-replay-slider" class="range range-primary range-sm mt-4" type="range" min="0" max={ fmt.Sprintf("%d", len(history.Replay)-1) } value="0" aria-label="Replay transition"/>
				<div class="mt-3 w-full overflow-auto">
					<svg viewBox={ fmt.Sprintf("0 0 %d %d", automationGraphWidth(history.Definition.Nodes), automationGraphHeight(history.Definition.Nodes)) } class="min-h-[420px] min-w-[900px] w-full" role="img" aria-label="Work item transition replay">
						for _, edge := range history.Definition.Edges {
							if source, target, ok := automationEdgeNodes(history.Definition.Nodes, edge); ok {
								<line x1={ fmt.Sprintf("%.0f", source.PositionX+145) } y1={ fmt.Sprintf("%.0f", source.PositionY+55) } x2={ fmt.Sprintf("%.0f", target.PositionX+15) } y2={ fmt.Sprintf("%.0f", target.PositionY+55) } class="stroke-base-content/30" stroke-width="2"></line>
							}
						}
						for _, node := range history.Definition.Nodes {
							<rect data-replay-node={ node.ID } x={ fmt.Sprintf("%.0f", node.PositionX+10) } y={ fmt.Sprintf("%.0f", node.PositionY+20) } width="140" height="70" rx="10" class="fill-base-200 stroke-base-content/25" stroke-width="3"></rect>
							<text x={ fmt.Sprintf("%.0f", node.PositionX+80) } y={ fmt.Sprintf("%.0f", node.PositionY+55) } text-anchor="middle" class="fill-base-content text-[12px] font-semibold">{ automationNodeLabel(node.Name, 20) }</text>
						}
					</svg>
				</div>
			}
		</div>
		<div class="grid grid-cols-1 gap-5 xl:grid-cols-2">
				<section class="rounded-box border border-base-300 bg-base-100 p-4">
					<h3 class="font-semibold">Activities across invocations</h3>
					if len(history.Activities.Items) == 0 {
						<p class="mt-2 text-sm text-base-content/55">No activities.</p>
					} else {
						<div class="mt-3 space-y-2">
							for _, activity := range history.Activities.Items {
								<div class="rounded-lg bg-base-200/60 p-3"><div class="flex justify-between gap-3"><span class="text-sm font-medium">{ activity.ActivityType }</span><span class="badge badge-sm">{ string(activity.Status) }</span></div><p class="mt-1 text-xs text-base-content/55">{ activity.StartedAt.Local().Format("Jan 2, 3:04 PM") }</p></div>
							}
						</div>
					}
					if history.Activities.NextCursor != "" {
						<a class="btn btn-ghost btn-sm mt-3" href={ templ.URL(fmt.Sprintf("/automations/%s/work-items/%s?project_id=%s&activity_cursor=%s", history.Definition.Automation.ID, history.WorkItem.ID, currentProjectID, history.Activities.NextCursor)) } hx-get={ fmt.Sprintf("/automations/%s/work-items/%s?project_id=%s&activity_cursor=%s", history.Definition.Automation.ID, history.WorkItem.ID, currentProjectID, history.Activities.NextCursor) } hx-target="#main-content" hx-push-url="true">Next activities</a>
					}
				</section>
			<section class="rounded-box border border-base-300 bg-base-100 p-4">
				<h3 class="font-semibold">Transition timeline</h3>
				@automationTransitionTimeline(history.Transitions.Items, history.Definition.Nodes)
				if history.Transitions.NextCursor != "" {
					<a class="btn btn-ghost btn-sm mt-3" href={ templ.URL(fmt.Sprintf("/automations/%s/work-items/%s?project_id=%s&cursor=%s", history.Definition.Automation.ID, history.WorkItem.ID, currentProjectID, history.Transitions.NextCursor)) } hx-get={ fmt.Sprintf("/automations/%s/work-items/%s?project_id=%s&cursor=%s", history.Definition.Automation.ID, history.WorkItem.ID, currentProjectID, history.Transitions.NextCursor) } hx-target="#main-content" hx-push-url="true">Next transitions</a>
				}
			</section>
		</div>
	</div>
	<script>
		(function() { var root = document.getElementById('automation-work-item-history'); if (!root) return; var frames = []; try { frames = JSON.parse(root.dataset.replay || '[]'); } catch (_) {} var slider = document.getElementById('automation-replay-slider'); var label = document.getElementById('automation-replay-label'); function nodeClass(state) { if (state === 'failed') return 'fill-error/15 stroke-error'; if (state === 'blocked') return 'fill-warning/15 stroke-warning'; if (state === 'waiting') return 'fill-info/15 stroke-info'; if (state === 'active') return 'fill-primary/15 stroke-primary'; return 'fill-base-200 stroke-base-content/25'; } function render(index) { var frame = frames[index]; if (!frame) return; var states = {}; (frame.positions || []).forEach(function(p) { states[p.node_id] = p.state; }); root.querySelectorAll('[data-replay-node]').forEach(function(node) { node.setAttribute('class', nodeClass(states[node.dataset.replayNode] || '')); }); if (label) label.textContent = (index + 1) + ' / ' + frames.length + ' · ' + frame.state; } if (slider) { slider.addEventListener('input', function() { render(Number(slider.value)); }); render(0); } })();
	</script>
}

templ automationTransitionTimeline(transitions []models.AutomationTransition, nodes []models.AutomationNode) {
	if len(transitions) == 0 {
		<p class="mt-2 text-sm text-base-content/55">No transitions.</p>
	} else {
		<ol class="mt-3 space-y-3">
			for _, transition := range transitions {
				<li class="border-l-2 border-base-300 pl-3"><div class="flex flex-wrap items-center justify-between gap-2"><span class="text-sm font-medium">{ automationNodeName(nodes, transition.ToNodeID) }</span><span class="badge badge-sm">{ string(transition.State) }</span></div><p class="mt-1 text-xs text-base-content/55">{ transition.OccurredAt.Local().Format("Jan 2, 3:04:05 PM") }</p></li>
			}
		</ol>
	}
}

templ AutomationNew(projects []models.Project, currentProjectID string) {
	@layout.Base("New Automation", projects, currentProjectID) {
		@automationNewContent(currentProjectID, "")
	}
}

templ AutomationNewFailure(projects []models.Project, currentProjectID string, errorMessage string) {
	@layout.Base("New Automation", projects, currentProjectID) {
		@automationNewContent(currentProjectID, errorMessage)
	}
}

templ AutomationNewContent(currentProjectID string) {
	@automationNewContent(currentProjectID, "")
}

templ AutomationNewFailureContent(currentProjectID string, errorMessage string) {
	@automationNewContent(currentProjectID, errorMessage)
}

templ automationNewContent(currentProjectID string, errorMessage string) {
	<div id="automation-new" class="h-full overflow-y-auto min-w-0 max-w-full">
		@layout.PageTitle("New Automation")
		<a class="btn btn-ghost btn-sm mb-3" href={ templ.URL(fmt.Sprintf("/automations?project_id=%s", currentProjectID)) } hx-get={ fmt.Sprintf("/automations?project_id=%s", currentProjectID) } hx-target="#main-content" hx-push-url="true">← Automations</a>
		<div class="mb-6"><h2 class="text-2xl font-bold">New Automation</h2><p class="mt-1 text-sm text-base-content/65">Choose one explicit creation path. Existing tasks and schedules are never discovered or registered from this page.</p></div>
		if errorMessage != "" {
			<div class="alert alert-error mb-4" role="alert"><span>{ errorMessage }</span></div>
		}
		<div class="grid grid-cols-1 gap-4 lg:grid-cols-3">
			<section class="rounded-box border border-base-300 bg-base-100 p-5"><h3 class="text-lg font-semibold">Template</h3><p class="mt-1 text-sm text-base-content/60">Start from a maintained supported topology.</p><form method="post" action={ templ.SafeURL(fmt.Sprintf("/automations/drafts?project_id=%s", currentProjectID)) } hx-post={ fmt.Sprintf("/automations/drafts?project_id=%s", currentProjectID) } hx-target="#main-content" class="mt-4 space-y-3"><input type="hidden" name="project_id" value={ currentProjectID }/><input type="hidden" name="source" value="template"/><select name="template_key" class="select select-bordered w-full" aria-label="Automation template"><option value="native_sdlc">Native SDLC</option><option value="github_sdlc">GitHub SDLC</option><option value="vision_driver">Vision Driver</option></select><button class="btn btn-primary w-full" type="submit">Use template</button></form></section>
			<section class="rounded-box border border-base-300 bg-base-100 p-5"><h3 class="text-lg font-semibold">Describe It</h3><p class="mt-1 text-sm text-base-content/60">Generate a draft through the shared safe schema. Nothing runs yet.</p><form method="post" action={ templ.SafeURL(fmt.Sprintf("/automations/drafts?project_id=%s", currentProjectID)) } hx-post={ fmt.Sprintf("/automations/drafts?project_id=%s", currentProjectID) } hx-target="#main-content" hx-indicator="#automation-describe-loading" hx-disabled-elt="button" class="mt-4 space-y-3"><input type="hidden" name="project_id" value={ currentProjectID }/><input type="hidden" name="source" value="describe"/><textarea name="description" class="textarea textarea-bordered h-32 w-full" maxlength="4000" required placeholder="Review project vision daily, request approval, then create implementation work."></textarea><button class="btn btn-primary w-full" type="submit">Generate draft</button><div id="automation-describe-loading" class="htmx-indicator text-center text-sm text-base-content/65" role="status" aria-live="polite">Generating and validating draft…</div></form></section>
			<section class="rounded-box border border-base-300 bg-base-100 p-5"><h3 class="text-lg font-semibold">Blank</h3><p class="mt-1 text-sm text-base-content/60">Start with an unconfigured supported topology and fill its task prompts.</p><form method="post" action={ templ.SafeURL(fmt.Sprintf("/automations/drafts?project_id=%s", currentProjectID)) } hx-post={ fmt.Sprintf("/automations/drafts?project_id=%s", currentProjectID) } hx-target="#main-content" class="mt-4 space-y-3"><input type="hidden" name="project_id" value={ currentProjectID }/><input type="hidden" name="source" value="blank"/><select name="template_key" class="select select-bordered w-full" aria-label="Blank topology"><option value="vision_driver">Vision Driver</option><option value="native_sdlc">Native SDLC</option><option value="github_sdlc">GitHub SDLC</option></select><button class="btn btn-outline w-full" type="submit">Create blank draft</button></form></section>
		</div>
	</div>
}

templ AutomationBuilder(projects []models.Project, currentProjectID string, page models.AutomationBuilderPage) {
	@layout.Base("Automation Draft", projects, currentProjectID) {
		@AutomationBuilderContent(page, currentProjectID)
	}
}

templ AutomationBuilderContent(page models.AutomationBuilderPage, currentProjectID string) {
	<div id="automation-builder" class="h-full overflow-y-auto min-w-0 max-w-full" data-automation-draft>
		@layout.PageTitle(page.Result.Candidate.Name)
		<a class="btn btn-ghost btn-sm mb-3" href={ templ.URL(fmt.Sprintf("/automations?project_id=%s", currentProjectID)) } hx-get={ fmt.Sprintf("/automations?project_id=%s", currentProjectID) } hx-target="#main-content" hx-push-url="true">← Automations</a>
		<div class="mb-5 flex flex-wrap items-start justify-between gap-3"><div><h2 class="break-words text-2xl font-bold">{ page.Result.Candidate.Name }</h2><p class="mt-1 text-sm text-base-content/65">Draft · { page.Result.Candidate.AdapterKey } · Nothing is active until publication completes.</p></div><span class="badge badge-warning badge-outline">draft</span></div>
		if page.Error != "" {
			<div class="alert alert-error mb-4" role="alert">{ page.Error }</div>
		}
		if len(page.PublicationSteps) > 0 {
			<section class="mb-4 rounded-box border border-error/30 bg-base-100 p-4" aria-label="Publication attempt resources">
				<h3 class="font-semibold">Publication attempt resources</h3>
				<p class="mt-1 text-sm text-base-content/65">These visible resources were already created or reconciled before the failure. Retrying the same plan will reuse them.</p>
				<div class="mt-3 space-y-2">
					for _, step := range page.PublicationSteps {
						<div class="flex flex-wrap items-center justify-between gap-3 rounded-lg bg-base-200/60 px-3 py-2"><span class="break-all text-sm">{ step.ResourceType } { step.ResourceID }</span><span class="badge badge-outline">{ step.Status }</span></div>
					}
				</div>
			</section>
		}
		if len(page.Result.Assumptions) > 0 || len(page.Result.Warnings) > 0 {
			<div class="mb-4 grid grid-cols-1 gap-3 lg:grid-cols-2">
				<div class="rounded-box bg-base-200/60 p-4"><h3 class="font-semibold">Assumptions</h3><ul class="mt-2 list-disc pl-5 text-sm">
					for _, item := range page.Result.Assumptions {
						<li>{ item }</li>
					}
				</ul></div>
				<div class="rounded-box bg-base-200/60 p-4"><h3 class="font-semibold">Warnings</h3><ul class="mt-2 list-disc pl-5 text-sm">
					for _, item := range page.Result.Warnings {
						<li>{ item }</li>
					}
				</ul></div>
			</div>
		}
		if len(page.Result.ValidationErrors) > 0 {
			<div class="alert alert-warning mb-4"><div><h3 class="font-semibold">Draft needs attention</h3><ul class="mt-1 list-disc pl-5 text-sm">
				for _, issue := range page.Result.ValidationErrors {
					<li>{ issue.Message }</li>
				}
			</ul></div></div>
		}
		<div class="mb-5 rounded-box border border-base-300 bg-base-100 p-4"><h3 class="font-semibold">Draft graph</h3><div class="mt-3 w-full overflow-auto" role="region" aria-label="Draft automation graph"><svg viewBox={ fmt.Sprintf("0 0 %d %d", automationDraftGraphWidth(page.Result.Candidate.Nodes), automationDraftGraphHeight(page.Result.Candidate.Nodes)) } class="min-h-[420px] min-w-[900px] w-full" role="img" aria-label={ page.Result.Candidate.Name + " draft graph" }>
			for _, edge := range page.Result.Candidate.Edges {
				if source, target, ok := automationDraftEdgeNodes(page.Result.Candidate.Nodes, edge); ok {
					<line x1={ fmt.Sprintf("%.0f", source.Position.X+145) } y1={ fmt.Sprintf("%.0f", source.Position.Y+55) } x2={ fmt.Sprintf("%.0f", target.Position.X+15) } y2={ fmt.Sprintf("%.0f", target.Position.Y+55) } class="stroke-base-content/35" stroke-width="2"></line>
				}
			}
			for _, node := range page.Result.Candidate.Nodes {
				if node.Position != nil {
					<g tabindex="0" role="button" aria-label={ node.Name + ", " + string(node.Type) }><rect x={ fmt.Sprintf("%.0f", node.Position.X+10) } y={ fmt.Sprintf("%.0f", node.Position.Y+20) } width="140" height="70" rx="10" class="fill-base-200 stroke-base-content/25" stroke-width="2"></rect><text x={ fmt.Sprintf("%.0f", node.Position.X+80) } y={ fmt.Sprintf("%.0f", node.Position.Y+50) } text-anchor="middle" class="fill-base-content text-[12px] font-semibold">{ automationNodeLabel(node.Name, 20) }</text><text x={ fmt.Sprintf("%.0f", node.Position.X+80) } y={ fmt.Sprintf("%.0f", node.Position.Y+70) } text-anchor="middle" class="fill-base-content/60 text-[10px]">{ string(node.Type) }</text></g>
				}
			}
		</svg></div></div>
		<form method="post" action={ templ.SafeURL(fmt.Sprintf("/automations/%s/drafts/%s?project_id=%s", page.Result.Definition.Automation.ID, page.Result.Definition.Version.ID, currentProjectID)) } hx-post={ fmt.Sprintf("/automations/%s/drafts/%s?project_id=%s", page.Result.Definition.Automation.ID, page.Result.Definition.Version.ID, currentProjectID) } hx-target="#main-content" class="space-y-4">
			<input type="hidden" name="project_id" value={ currentProjectID }/>
			<div class="grid grid-cols-1 gap-4 xl:grid-cols-2">
				for _, node := range page.Result.Candidate.Nodes {
					<section class="rounded-box border border-base-300 bg-base-100 p-4"><div class="mb-3 flex justify-between gap-3"><div><h3 class="font-semibold">{ node.Name }</h3><p class="text-xs text-base-content/55">{ node.Key } · { node.Role }</p></div><span class="badge badge-ghost badge-sm">{ string(node.Type) }</span></div><label class="form-control"><span class="label-text">Display name</span><input class="input input-bordered" name={ "node_" + node.Key + "_name" } value={ node.Name } maxlength="200"/></label>
						if automationDraftHasConfig(node, "prompt") {
							<label class="form-control mt-3"><span class="label-text">Task prompt</span><textarea class="textarea textarea-bordered h-28" name={ "node_" + node.Key + "_prompt" } maxlength="20000">{ automationDraftStringConfig(node, "prompt") }</textarea></label><div class="mt-3 grid grid-cols-2 gap-3"><label class="form-control"><span class="label-text">Category</span><select class="select select-bordered" name={ "node_" + node.Key + "_category" }><option value="backlog" selected?={ automationDraftStringConfig(node, "category") == "backlog" }>Backlog</option><option value="scheduled" selected?={ automationDraftStringConfig(node, "category") == "scheduled" }>Scheduled</option></select></label><label class="form-control"><span class="label-text">Priority</span><input type="number" min="1" max="4" class="input input-bordered" name={ "node_" + node.Key + "_priority" } value={ fmt.Sprintf("%d", automationDraftIntConfig(node, "priority")) }/></label></div>
						}
						if automationDraftHasConfig(node, "run_at") {
							<div class="grid grid-cols-2 gap-3"><label class="form-control"><span class="label-text">Time</span><input type="time" class="input input-bordered" name={ "node_" + node.Key + "_run_at" } value={ automationDraftStringConfig(node, "run_at") }/></label><label class="form-control"><span class="label-text">Repeat</span><select class="select select-bordered" name={ "node_" + node.Key + "_repeat_type" }>
								for _, repeat := range []string{"once","minutes","hours","daily","weekly","monthly"} {
									<option value={ repeat } selected?={ automationDraftStringConfig(node, "repeat_type") == repeat }>{ repeat }</option>
								}
							</select></label><label class="form-control"><span class="label-text">Interval</span><input type="number" min="1" max="365" class="input input-bordered" name={ "node_" + node.Key + "_repeat_interval" } value={ fmt.Sprintf("%d", automationDraftIntConfig(node, "repeat_interval")) }/></label><label class="label cursor-pointer justify-start gap-3"><input type="checkbox" class="checkbox" name={ "node_" + node.Key + "_enabled" } value="true" checked?={ automationDraftBoolConfig(node, "enabled") }/><span class="label-text">Enabled after publish</span></label></div>
						}
					</section>
				}
			</div>
			<div class="rounded-box border border-base-300 bg-base-100 p-4"><h3 class="font-semibold">Transitions</h3><div class="mt-3 grid grid-cols-1 gap-3 md:grid-cols-2">
				for _, edge := range page.Result.Candidate.Edges {
					<label class="form-control"><span class="label-text">{ edge.From } → { edge.To }</span><input class="input input-bordered" name={ "edge_" + edge.Key + "_label" } value={ edge.Label } maxlength="100"/></label>
				}
			</div></div>
			<div class="flex flex-wrap gap-3"><button class="btn btn-primary" type="submit">Save draft</button><button class="btn btn-outline" type="submit" formaction={ templ.SafeURL(fmt.Sprintf("/automations/%s/drafts/%s/plan?project_id=%s", page.Result.Definition.Automation.ID, page.Result.Definition.Version.ID, currentProjectID)) } hx-post={ fmt.Sprintf("/automations/%s/drafts/%s/plan?project_id=%s", page.Result.Definition.Automation.ID, page.Result.Definition.Version.ID, currentProjectID) }>Preview publication</button></div>
		</form>
		if page.Plan != nil {
			<section class="mt-5 rounded-box border border-primary/30 bg-base-100 p-5"><h3 class="text-lg font-semibold">Publication preview</h3><p class="mt-1 text-sm text-base-content/65">Review every effect. No task or schedule has been created by this preview.</p><div class="mt-4 space-y-2">
				for _, effect := range page.Plan.Effects {
					<div class="flex flex-wrap items-center justify-between gap-3 rounded-lg bg-base-200/60 px-3 py-2"><span class="text-sm">{ effect.Name }</span><span class="badge badge-outline">{ effect.Operation } { effect.ResourceType }</span></div>
				}
			</div>
				if len(page.Plan.Validation) > 0 {
					<div class="alert alert-warning mt-4">Fix validation errors before publishing.</div>
				} else {
					<form method="post" action={ templ.SafeURL(fmt.Sprintf("/automations/%s/drafts/%s/publish?project_id=%s", page.Result.Definition.Automation.ID, page.Result.Definition.Version.ID, currentProjectID)) } hx-post={ fmt.Sprintf("/automations/%s/drafts/%s/publish?project_id=%s", page.Result.Definition.Automation.ID, page.Result.Definition.Version.ID, currentProjectID) } class="mt-4"><input type="hidden" name="project_id" value={ currentProjectID }/><input type="hidden" name="plan_revision" value={ page.Plan.PlanRevision }/><input type="hidden" name="confirmation_token" value={ page.ConfirmationToken }/><button class="btn btn-primary" type="submit">Publish automation</button></form>
				}
			</section>
		}
	</div>
}

func automationDraftHasConfig(node models.AutomationDraftNode, key string) bool { _, ok := node.Config[key]; return ok }
func automationDraftStringConfig(node models.AutomationDraftNode, key string) string { value, _ := node.Config[key].(string); return value }
func automationDraftIntConfig(node models.AutomationDraftNode, key string) int { switch value := node.Config[key].(type) { case int: return value; case float64: return int(value); case json.Number: parsed, _ := value.Int64(); return int(parsed) }; return 0 }
func automationDraftBoolConfig(node models.AutomationDraftNode, key string) bool { value, _ := node.Config[key].(bool); return value }
func automationDraftGraphWidth(nodes []models.AutomationDraftNode) int { max := 900.0; for _, node := range nodes { if node.Position != nil && node.Position.X+180 > max { max = node.Position.X+180 } }; return int(max) }
func automationDraftGraphHeight(nodes []models.AutomationDraftNode) int { max := 420.0; for _, node := range nodes { if node.Position != nil && node.Position.Y+140 > max { max = node.Position.Y+140 } }; return int(max) }
func automationDraftEdgeNodes(nodes []models.AutomationDraftNode, edge models.AutomationDraftEdge) (models.AutomationDraftNode, models.AutomationDraftNode, bool) { var source, target models.AutomationDraftNode; var sourceOK, targetOK bool; for _, node := range nodes { if node.Key == edge.From { source, sourceOK = node, node.Position != nil }; if node.Key == edge.To { target, targetOK = node, node.Position != nil } }; return source, target, sourceOK && targetOK }

func automationMetricsJSON(metrics models.AutomationMetrics) string { value, _ := json.Marshal(metrics); return string(value) }
func automationReplayJSON(frames []models.AutomationReplayFrame) string { value, _ := json.Marshal(frames); return string(value) }
func automationHealthBadgeClass(state models.AutomationHealthState) string { switch state { case models.AutomationHealthHealthy: return "badge badge-success badge-outline"; case models.AutomationHealthDegraded: return "badge badge-warning badge-outline"; case models.AutomationHealthUnhealthy: return "badge badge-error badge-outline" }; return "badge badge-ghost" }
func automationInvocationHistoryTime(invocation models.AutomationInvocation) time.Time { if invocation.ScheduledFor != nil { return *invocation.ScheduledFor }; if invocation.StartedAt != nil { return *invocation.StartedAt }; return invocation.CreatedAt }
func automationInvocationLabel(invocation models.AutomationInvocation) string { if invocation.ScheduledFor != nil { return "Scheduled occurrence" }; return "Invocation " + automationShortID(invocation.ID) }
func automationWorkItemLabel(item models.AutomationWorkItem) string { if strings.TrimSpace(item.Title) != "" { return item.Title }; return item.Kind + " " + automationShortID(item.ID) }
func automationShortID(value string) string { if len(value) <= 8 { return value }; return value[:8] }
func automationNodeName(nodes []models.AutomationNode, nodeID string) string { for _, node := range nodes { if node.ID == nodeID { return node.Name } }; return "Unknown node" }
func automationInvocationNodeClass(history models.AutomationInvocationHistory, nodeID string) string { for _, touchedNodeID := range history.TouchedNodeIDs { if touchedNodeID == nodeID { return "fill-primary/15 stroke-primary" } }; return "fill-base-200 stroke-base-content/25" }

func automationCardSearchText(card models.AutomationCard) string { return strings.Join([]string{card.Automation.Name, card.Automation.Description, card.Version.AdapterKey, string(card.Automation.LifecycleState), string(card.Automation.HealthState)}, " ") }
func automationTime(value *time.Time, empty string) string { if value == nil { return empty }; return value.Local().Format("Jan 2, 3:04 PM") }
func automationGraphWidth(nodes []models.AutomationNode) int { max := 900.0; for _, n := range nodes { if n.PositionX+180 > max { max = n.PositionX+180 } }; return int(max) }
func automationGraphHeight(nodes []models.AutomationNode) int { max := 420.0; for _, n := range nodes { if n.PositionY+130 > max { max = n.PositionY+130 } }; return int(max) }
func automationEdgeNodes(nodes []models.AutomationNode, edge models.AutomationEdge) (models.AutomationNode, models.AutomationNode, bool) { var source, target models.AutomationNode; var foundSource, foundTarget bool; for _, n := range nodes { if n.ID == edge.SourceNodeID { source, foundSource = n, true }; if n.ID == edge.TargetNodeID { target, foundTarget = n, true } }; return source, target, foundSource && foundTarget }
func automationNodeLabel(value string, limit int) string { r := []rune(value); if len(r) <= limit { return value }; return string(r[:limit-1]) + "…" }
func resourcesForAutomationNode(resources []models.AutomationResourceSummary, nodeID string) []models.AutomationResourceSummary { var out []models.AutomationResourceSummary; for _, resource := range resources { if resource.NodeID == nodeID { out = append(out, resource) } }; return out }
