package pages

import (
	"encoding/json"
	"fmt"
	"net/url"
	"strings"
	"github.com/openvibely/openvibely/internal/models"
	"github.com/openvibely/openvibely/web/templates/layout"
)

templ Automations(projects []models.Project, currentProjectID string, cards []models.AutomationCard) {
	@layout.Base("Automations", projects, currentProjectID) {
		@automationsContent(cards, currentProjectID, "", "")
	}
}

templ AutomationsDescribeFailure(projects []models.Project, currentProjectID string, cards []models.AutomationCard, description string, errorMessage string) {
	@layout.Base("Automations", projects, currentProjectID) {
		@automationsContent(cards, currentProjectID, description, errorMessage)
	}
}

templ AutomationsContent(cards []models.AutomationCard, currentProjectID string) {
	@automationsContent(cards, currentProjectID, "", "")
}

templ automationsContent(cards []models.AutomationCard, currentProjectID string, description string, errorMessage string) {
	<div id="automations-container" class="h-full min-w-0 max-w-full overflow-y-auto" data-search-container>
		@layout.PageTitle("Automations")
		<div class="mb-6 flex items-center justify-between gap-3">
			<h2 class="text-2xl font-bold">Automations</h2>
			<div class="dropdown dropdown-end">
				<label tabindex="0" class="btn btn-primary btn-sm" onclick="handleDropdownToggle(event)">+ New Automation</label>
				<ul tabindex="0" class="dropdown-content z-[100] menu w-48 rounded-box border border-base-300 bg-base-100 p-2 shadow" data-automation-new-menu>
					<li><button type="button" data-automation-new-template onclick="openAutomationNewModal(event, 'automation-template-modal')">Template</button></li>
					<li><button type="button" data-automation-new-describe onclick="openAutomationNewModal(event, 'automation-describe-modal')">Describe</button></li>
					<li><button type="button" data-automation-new-custom onclick="submitAutomationCustom(event)">Custom</button></li>
				</ul>
			</div>
			<form id="automation-custom-form" class="hidden" method="post" action={ templ.SafeURL(fmt.Sprintf("/automations/builder?project_id=%s", currentProjectID)) } hx-post={ fmt.Sprintf("/automations/builder?project_id=%s", currentProjectID) } hx-target="#main-content">
				<input type="hidden" name="project_id" value={ currentProjectID }/>
				<input type="hidden" name="source" value="blank"/>
			</form>
		</div>
		@CardSearchInput("automations", "Search automations...")
		if len(cards) == 0 {
			<div class="rounded-box bg-base-200/60 p-8 text-center">
				<h3 class="font-semibold">No saved automations</h3>
				<p class="mt-2 text-sm text-base-content/65">Create one from Template, Describe, or Custom. Maintained Native and GitHub setup can also register newly created resources. Existing tasks and schedules are never inferred or backfilled.</p>
			</div>
		} else {
			<div class="grid grid-cols-1 gap-4 min-w-0 max-w-full">
				for _, card := range cards {
					<div
						class="card bg-base-100 shadow-sm border border-base-300 cursor-pointer hover:border-primary/40 hover:shadow-md transition-all w-full min-w-0 max-w-full"
						data-automation-url={ automationCardURL(card, currentProjectID) }
						data-search-card
						data-search-text={ automationCardSearchText(card) }
						onclick="window.openVibelyNavigate(this.dataset.automationUrl)"
					>
						<div class="card-body relative">
							<div class="absolute top-4 right-4" data-automation-card-action onclick="event.stopPropagation()">
								<div class="dropdown dropdown-end">
									<label tabindex="0" class="btn btn-ghost btn-sm" title="More actions" aria-label={ "More actions for " + card.Automation.Name } onclick="handleDropdownToggle(event)">
										<svg xmlns="http://www.w3.org/2000/svg" class="h-4 w-4" fill="none" viewBox="0 0 24 24" stroke="currentColor">
											<path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 5v.01M12 12v.01M12 19v.01M12 6a1 1 0 110-2 1 1 0 010 2zm0 7a1 1 0 110-2 1 1 0 010 2zm0 7a1 1 0 110-2 1 1 0 010 2z"></path>
										</svg>
									</label>
									<ul tabindex="0" class="dropdown-content z-[100] menu p-2 shadow bg-base-100 rounded-box w-48 border border-base-300">
										<li>
											<button
												type="button"
												class="w-full"
												data-automation-card-edit={ card.Automation.ID }
												data-automation-edit-url={ fmt.Sprintf("/automations/%s/builder?project_id=%s", card.Automation.ID, currentProjectID) }
												data-project-id={ currentProjectID }
												onclick="event.stopPropagation(); openAutomationCardEdit(this)"
											>Edit</button>
										</li>
										if card.Automation.LifecycleState == models.AutomationActive {
											<li>
												<button
													class="w-full"
													type="button"
													hx-post={ fmt.Sprintf("/automations/%s/run-now?project_id=%s", card.Automation.ID, currentProjectID) }
													hx-include={ fmt.Sprintf("#run-now-automation-card-form-%s", card.Automation.ID) }
													hx-target="#automations-container"
													hx-swap="outerHTML"
													data-automation-card-run-now={ card.Automation.ID }
													data-automation-lifecycle-form={ fmt.Sprintf("run-now-automation-card-form-%s", card.Automation.ID) }
													onclick="submitAutomationLifecycleFallback(this)"
												>Run now</button>
											</li>
											<li>
												<button
													class="w-full"
													type="button"
													hx-post={ fmt.Sprintf("/automations/%s/pause?project_id=%s", card.Automation.ID, currentProjectID) }
													hx-include={ fmt.Sprintf("#pause-automation-card-form-%s", card.Automation.ID) }
													hx-target="#automations-container"
													hx-swap="outerHTML"
													data-automation-card-pause={ card.Automation.ID }
													data-automation-lifecycle-form={ fmt.Sprintf("pause-automation-card-form-%s", card.Automation.ID) }
													onclick="submitAutomationLifecycleFallback(this)"
													>Disable</button>											</li>
										}
										if card.Automation.LifecycleState == models.AutomationPaused {
											<li>
												<button
													class="w-full"
													type="button"
													hx-post={ fmt.Sprintf("/automations/%s/resume?project_id=%s", card.Automation.ID, currentProjectID) }
													hx-include={ fmt.Sprintf("#resume-automation-card-form-%s", card.Automation.ID) }
													hx-target="#automations-container"
													hx-swap="outerHTML"
													data-automation-card-resume={ card.Automation.ID }
													data-automation-lifecycle-form={ fmt.Sprintf("resume-automation-card-form-%s", card.Automation.ID) }
													onclick="submitAutomationLifecycleFallback(this)"
													>Enable</button>											</li>
										}
										<li>
											<button
												class="text-error"
												type="button"
												data-automation-card-delete={ card.Automation.ID }
												data-automation-name={ card.Automation.Name }
												data-automation-delete-url={ fmt.Sprintf("/automations/%s/delete?project_id=%s", card.Automation.ID, currentProjectID) }
												onclick="event.stopPropagation(); openAutomationCardDelete(this)"
											>Delete</button>
										</li>
									</ul>
									if card.Automation.LifecycleState == models.AutomationActive {
										<form id={ fmt.Sprintf("run-now-automation-card-form-%s", card.Automation.ID) } class="hidden" method="post" action={ templ.SafeURL(fmt.Sprintf("/automations/%s/run-now?project_id=%s", card.Automation.ID, currentProjectID)) }>
											<input type="hidden" name="project_id" value={ currentProjectID }/>
											<input type="hidden" name="return_to" value="portfolio"/>
										</form>
										<form id={ fmt.Sprintf("pause-automation-card-form-%s", card.Automation.ID) } class="hidden" method="post" action={ templ.SafeURL(fmt.Sprintf("/automations/%s/pause?project_id=%s", card.Automation.ID, currentProjectID)) }>
											<input type="hidden" name="project_id" value={ currentProjectID }/>
											<input type="hidden" name="return_to" value="portfolio"/>
										</form>
									}
									if card.Automation.LifecycleState == models.AutomationPaused {
										<form id={ fmt.Sprintf("resume-automation-card-form-%s", card.Automation.ID) } class="hidden" method="post" action={ templ.SafeURL(fmt.Sprintf("/automations/%s/resume?project_id=%s", card.Automation.ID, currentProjectID)) }>
											<input type="hidden" name="project_id" value={ currentProjectID }/>
											<input type="hidden" name="return_to" value="portfolio"/>
										</form>
									}
								</div>
							</div>
							<div class="pr-12 min-w-0 max-w-full">
								<h3 class="font-bold">{ card.Automation.Name }</h3>
								if strings.TrimSpace(card.Automation.Description) != "" {
									<p class="text-sm opacity-60 mt-1 line-clamp-2">{ card.Automation.Description }</p>
								}
								<div class="flex flex-wrap gap-2 mt-2 max-w-full overflow-x-hidden">
									<span class="badge badge-outline badge-sm max-w-full truncate">{ automationAdapterLabel(card.Version.AdapterKey) }</span>
									<span class="badge badge-outline badge-sm">{ string(card.Automation.LifecycleState) }</span>
									<span class="badge badge-outline badge-sm">{ string(card.Automation.HealthState) }</span>
								</div>
							</div>
						</div>
					</div>
				}
			</div>
		}
		<dialog id="automation-template-modal" class="modal">
			<div class="modal-box">
				@ModalCloseButton("document.getElementById('automation-template-modal')", "Close template selection")
				<h3 class="pr-10 text-lg font-bold">Create from template</h3>
				<p class="mt-2 text-sm text-base-content/65">Choose a maintained Automation design to load into the browser-local builder.</p>
				<form method="post" action={ templ.SafeURL(fmt.Sprintf("/automations/builder?project_id=%s", currentProjectID)) } hx-post={ fmt.Sprintf("/automations/builder?project_id=%s", currentProjectID) } hx-target="#main-content" class="mt-4 space-y-4">
					<input type="hidden" name="project_id" value={ currentProjectID }/>
					<input type="hidden" name="source" value="template"/>
					<label class="form-control">
						<span class="label-text mb-1 font-medium">Template</span>
						<select name="template_key" class="select select-bordered w-full" aria-label="Automation template" onchange="updateAutomationTemplateDescription(this)">
							<option value="native_sdlc" data-template-description="Reviews project direction, proposes actionable work, waits for human approval, and hands approved work to an implementation task.">Native SDLC</option>
							<option value="github_sdlc" data-template-description="Finds repository improvements, creates GitHub issues, waits for human assignment and review, and prepares implementation pull requests.">GitHub SDLC</option>
						</select>
					</label>
					<p class="rounded-box bg-base-200/60 p-3 text-sm text-base-content/70" data-template-description-card>Reviews project direction, proposes actionable work, waits for human approval, and hands approved work to an implementation task.</p>
					<div class="modal-action">
						<button class="btn" type="button" onclick="document.getElementById('automation-template-modal').close()">Cancel</button>
						<button class="btn btn-primary" type="submit">Use template</button>
					</div>
				</form>
			</div>
			<form method="dialog" class="modal-backdrop"><button>Cancel</button></form>
		</dialog>
		<dialog id="automation-describe-modal" class="modal" open?={ errorMessage != "" }>
			<div id="automation-describe-modal-content" class="modal-box">
				@ModalCloseButton("document.getElementById('automation-describe-modal')", "Close Automation description")
				@automationDescribeModalFields(currentProjectID, description, errorMessage)
			</div>
			<form method="dialog" class="modal-backdrop"><button>Cancel</button></form>
		</dialog>
		<dialog id="delete-automation-card-modal" class="modal">
			<div class="modal-box">
				@ModalCloseButton("document.getElementById('delete-automation-card-modal')", "Close delete automation confirmation")
				<h3 class="pr-10 text-lg font-bold text-error">Delete automation</h3>
				<p class="py-4">Delete <strong id="delete-automation-card-name"></strong>? This permanently deletes the saved Automation graph and Automation record.</p>
				<div class="rounded-lg bg-base-200 p-3 text-sm text-base-content/70">Existing tasks remain. Automation-owned trigger schedules will be deleted. This cannot be undone.</div>
				<div class="modal-action">
					<button class="btn" type="button" onclick="document.getElementById('delete-automation-card-modal').close()">Cancel</button>
					<form id="delete-automation-card-form" method="post" action="" onsubmit="event.preventDefault(); event.stopImmediatePropagation(); window.openVibelySubmitNavigate(this); return false;">
						<input type="hidden" name="project_id" value={ currentProjectID }/>
						<button class="btn btn-error" type="submit">Delete automation</button>
					</form>
				</div>
			</div>
			<form method="dialog" class="modal-backdrop"><button>Cancel</button></form>
		</dialog>
		<script>
			window.openAutomationNewModal = function(event, modalID) {
				if (event) {
					event.preventDefault();
					event.stopPropagation();
				}
				var menu = event && event.currentTarget ? event.currentTarget.closest('.dropdown') : null;
				var toggle = menu ? menu.querySelector('[tabindex="0"]') : null;
				if (toggle) toggle.blur();
				var modal = document.getElementById(modalID);
				if (modal) modal.showModal();
			};

			window.submitAutomationCustom = function(event) {
				if (event) {
					event.preventDefault();
					event.stopPropagation();
				}
				var form = document.getElementById('automation-custom-form');
				if (!form) return;
				if (window.htmx) {
					window.htmx.ajax('POST', form.getAttribute('action'), {
						source: form,
						target: '#main-content',
						swap: 'innerHTML',
						values: { project_id: form.querySelector('[name="project_id"]').value, source: 'blank' }
					});
					return;
				}
				form.requestSubmit();
			};

			window.updateAutomationTemplateDescription = function(select) {
				if (!select) return;
				var option = select.options[select.selectedIndex];
				var form = select.closest('form');
				var description = form ? form.querySelector('[data-template-description-card]') : null;
				if (description) {
					description.textContent = option ? option.dataset.templateDescription || '' : '';
				}
			};

			window.submitAutomationLifecycleFallback = function(button) {
				if (!button || window.htmx) return;
				var form = document.getElementById(button.dataset.automationLifecycleForm || '');
				if (form) form.requestSubmit();
			};
			window.openAutomationCardEdit = function(button) {
				if (!button || !window.htmx) return;
				var url = button.dataset.automationEditUrl || '';
				if (!url) return;
				var dropdown = button.closest('.dropdown');
				if (dropdown) {
					var toggle = dropdown.querySelector('[tabindex="0"]');
					if (toggle) toggle.blur();
				}
				window.htmx.ajax('POST', url, {
					source: button,
					target: '#main-content',
					swap: 'innerHTML',
					values: { project_id: button.dataset.projectId || '' }
				});
			};

			window.openAutomationCardDelete = function(button) {
				if (!button) return;
				var modal = document.getElementById('delete-automation-card-modal');
				var name = document.getElementById('delete-automation-card-name');
				var form = document.getElementById('delete-automation-card-form');
				if (!modal || !name || !form) return;
				name.textContent = button.dataset.automationName || 'this automation';
				form.setAttribute('action', button.dataset.automationDeleteUrl || '');
				modal.showModal();
			};
		</script>
	</div>
}

templ AutomationDescribeModalContent(currentProjectID string, description string, errorMessage string) {
	@automationDescribeModalContent(currentProjectID, description, errorMessage)
}

templ automationDescribeModalContent(currentProjectID string, description string, errorMessage string) {
	<div id="automation-describe-modal-content" class="modal-box">
		@ModalCloseButton("document.getElementById('automation-describe-modal')", "Close Automation description")
		@automationDescribeModalFields(currentProjectID, description, errorMessage)
	</div>
}

templ automationDescribeModalFields(currentProjectID string, description string, errorMessage string) {
	<h3 class="pr-10 text-lg font-bold">Describe an Automation</h3>
	<p class="mt-2 text-sm text-base-content/65">Describe what should happen. OpenVibely will generate a browser-local design for you to review before saving.</p>
	if errorMessage != "" {
		<div class="alert alert-error mt-4" role="alert"><span>{ errorMessage }</span></div>
	}
	<form method="post" action={ templ.SafeURL(fmt.Sprintf("/automations/builder?project_id=%s", currentProjectID)) } hx-post={ fmt.Sprintf("/automations/builder?project_id=%s", currentProjectID) } hx-target="#main-content" hx-indicator="#automation-describe-loading" hx-disabled-elt="button" class="mt-4 space-y-4">
		<input type="hidden" name="project_id" value={ currentProjectID }/>
		<input type="hidden" name="source" value="describe"/>
		<textarea name="description" class="textarea textarea-bordered h-32 w-full" maxlength="4000" required placeholder="Review project vision daily, request approval, then create implementation work.">{ description }</textarea>
		<div class="modal-action">
			<button class="btn" type="button" onclick="document.getElementById('automation-describe-modal').close()">Cancel</button>
			<button class="btn btn-primary" type="submit">Generate design</button>
		</div>
		<div id="automation-describe-loading" class="htmx-indicator text-center text-sm text-base-content/65" role="status" aria-live="polite">Generating and validating design…</div>
	</form>
}

templ automationLiveNodeShape(node models.AutomationLiveNode) {
	<g data-automation-live-node={ node.ID } transform={ fmt.Sprintf("translate(%.0f %.0f)", automationGraphLayoutX(node.PositionX), automationGraphLayoutY(node.PositionY)) }>
		<rect width={ fmt.Sprintf("%.0f", automationGraphNodeWidth) } height={ fmt.Sprintf("%.0f", automationGraphNodeHeight) } rx="12" class={ automationLiveNodeClass(node.DisplayState) } stroke-width="3"></rect>
		<foreignObject x="0" y="0" width={ fmt.Sprintf("%.0f", automationGraphNodeWidth) } height={ fmt.Sprintf("%.0f", automationGraphNodeHeight) } class="pointer-events-none"><div xmlns="http://www.w3.org/1999/xhtml" class="automation-node-content"><strong>{ node.Name }</strong><span class={ automationStateTextClass(node.DisplayState) }>{ automationStateLabel(node.DisplayState) }</span><small>{ automationNodeCountLabel(node.Counts) }</small></div></foreignObject>
	</g>
}

templ AutomationLive(projects []models.Project, currentProjectID string, graph models.AutomationLiveGraph, deleteAvailable bool) {
	@layout.Base(graph.Automation.Name, projects, currentProjectID) {
		@automationLiveContent(graph, currentProjectID, deleteAvailable)
	}
}

templ AutomationLiveContent(graph models.AutomationLiveGraph, currentProjectID string, deleteAvailable bool) {
	@automationLiveContent(graph, currentProjectID, deleteAvailable)
}

templ automationCanvasViewSwitcher() {
	<div class="join" role="group" aria-label="Automation canvas view" data-automation-view-switcher>
		<button class="btn btn-sm join-item btn-active" type="button" aria-pressed="true" data-automation-view-graph>Graph</button>
		<button class="btn btn-sm join-item" type="button" aria-pressed="false" data-automation-view-yaml>YAML</button>
	</div>
}

templ automationLiveContent(graph models.AutomationLiveGraph, currentProjectID string, deleteAvailable bool) {
		<div id="automation-live" class="flex h-full min-w-0 max-w-full flex-col overflow-y-auto" data-automation-id={ graph.Automation.ID } data-project-id={ currentProjectID }
			data-refresh-url={ fmt.Sprintf("/automations/%s?project_id=%s", graph.Automation.ID, currentProjectID) }
			data-external-refresh-url={ fmt.Sprintf("/automations/%s/refresh-external?project_id=%s", graph.Automation.ID, currentProjectID) }>
			@layout.PageTitle(graph.Automation.Name)
			<div class="mb-6 flex flex-wrap items-start justify-between gap-3" data-automation-live-header>
				<div class="min-w-0 flex-1">
					@automationBreadcrumb(currentProjectID, graph.Automation.ID, graph.Automation.Name, "", false)
					if graph.Automation.Description != "" {
						<p class="mt-1 text-sm opacity-60">{ graph.Automation.Description }</p>
					}
				</div>
				<div class="flex shrink-0 flex-wrap items-center justify-end gap-2" data-automation-live-header-actions>
						<button class="btn btn-outline btn-sm" type="submit" form="automation-live-edit-form" data-automation-live-edit>Edit</button>
						if graph.Automation.LifecycleState == models.AutomationActive {
							<button class="btn btn-primary btn-sm" type="submit" form="automation-live-run-now-form" data-automation-live-run-now={ graph.Automation.ID }>Run</button>					}
					@automationLiveMoreActions(graph, deleteAvailable)
				</div>
			</div>
		if graph.ExternalState.TrackedResources > 0 {
			<div class="mb-4 flex flex-wrap items-center justify-between gap-3 rounded-box border border-base-300 bg-base-100 px-4 py-3" data-automation-external-state>
				<div>
					<div class="flex flex-wrap items-center gap-2"><span class="text-sm font-semibold">GitHub state</span>
						if graph.ExternalState.Stale {
							<span class="badge badge-warning badge-sm">Stale</span>
						} else {
							<span class="badge badge-success badge-sm">Fresh</span>
						}
					</div>
					if graph.ExternalState.LastUpdatedAt != nil {
						<p class="mt-1 text-xs text-base-content/60">Last persisted update { graph.ExternalState.LastUpdatedAt.Local().Format("Jan 2, 3:04 PM") }</p>
					}
				</div>
				<form method="post" action={ templ.SafeURL(fmt.Sprintf("/automations/%s/refresh-external?project_id=%s", graph.Automation.ID, currentProjectID)) } onsubmit="event.preventDefault(); window.openVibelyAutomationLiveRefresh('POST', this.getAttribute('action')); return false;">
					<input type="hidden" name="project_id" value={ currentProjectID }/>
					<button class="btn btn-outline btn-sm" type="submit">Refresh GitHub state</button>
				</form>
			</div>
		}
					<div class="rounded-box border border-base-300 bg-base-100 p-4 min-w-0 min-h-0 flex flex-1 flex-col" data-automation-readonly-canvas data-automation-view-root>						<div class="mb-3 flex flex-wrap items-center justify-between gap-3" data-automation-live-card-actions>
							@automationCanvasViewSwitcher()
							<div class="ml-auto flex shrink-0 flex-wrap items-center justify-end gap-2" data-automation-live-badges>
							<span class="badge badge-primary badge-outline" data-automation-live-status>{ string(graph.Automation.LifecycleState) }</span>
							<span class="badge badge-ghost" data-automation-live-health>{ string(graph.Automation.HealthState) }</span>
						</div>
					</div>				<form id="automation-live-edit-form" class="hidden" method="post" action={ templ.SafeURL(fmt.Sprintf("/automations/%s/builder?project_id=%s", graph.Automation.ID, currentProjectID)) } hx-post={ fmt.Sprintf("/automations/%s/builder?project_id=%s", graph.Automation.ID, currentProjectID) } hx-target="#main-content" onsubmit="event.preventDefault(); event.stopImmediatePropagation(); window.openVibelySubmitNavigate(this); return false;">
					<input type="hidden" name="project_id" value={ currentProjectID }/>
				</form>
				if graph.Automation.LifecycleState == models.AutomationActive {
					<form id="automation-live-run-now-form" class="hidden" method="post" action={ templ.SafeURL(fmt.Sprintf("/automations/%s/run-now?project_id=%s", graph.Automation.ID, currentProjectID)) } onsubmit="event.preventDefault(); Promise.resolve(window.openVibelyAutomationLiveRefresh('POST', this.getAttribute('action'))).then(function() { window.openVibelyAutomationLiveRefresh('GET'); }); return false;"><input type="hidden" name="project_id" value={ currentProjectID }/></form>
					<form id="automation-live-pause-form" class="hidden" method="post" action={ templ.SafeURL(fmt.Sprintf("/automations/%s/pause?project_id=%s", graph.Automation.ID, currentProjectID)) }><input type="hidden" name="project_id" value={ currentProjectID }/></form>
				}
				if graph.Automation.LifecycleState == models.AutomationPaused {
					<form id="automation-live-resume-form" class="hidden" method="post" action={ templ.SafeURL(fmt.Sprintf("/automations/%s/resume?project_id=%s", graph.Automation.ID, currentProjectID)) }><input type="hidden" name="project_id" value={ currentProjectID }/></form>
				}
					<div class="automation-canvas-shell relative min-h-[20rem] w-full flex-1 overflow-hidden rounded-box border border-base-300 bg-base-200/20" data-automation-graph-panel role="region" aria-label="Live automation graph">					<div class="absolute right-3 top-3 z-10 flex gap-1 rounded-box border border-base-300 bg-base-100/90 p-1 shadow-sm backdrop-blur" data-automation-live-viewport-controls>
						<button class="btn btn-ghost btn-xs" type="button" data-automation-zoom-out aria-label="Zoom out">−</button>
						<button class="btn btn-ghost btn-xs" type="button" data-automation-zoom-in aria-label="Zoom in">+</button>
						<button class="btn btn-ghost btn-xs" type="button" data-automation-fit>Fit</button>
					</div>
					<svg data-automation-canvas viewBox={ automationLiveGraphViewBox(graph.Nodes) } class="h-full w-full touch-none select-none" role="img" aria-label={ graph.Automation.Name + " live automation graph" }>
						@automationGraphThemeStyles()
					<defs><marker id="automation-live-arrow" markerWidth="10" markerHeight="10" refX="8" refY="3" orient="auto"><path d="M0,0 L0,6 L9,3 z" class="automation-graph-arrow"></path></marker></defs>
					for _, edge := range graph.Edges {
						if source, target, ok := automationLiveEdgeNodes(graph.Nodes, edge.AutomationEdge); ok {
							<line x1={ fmt.Sprintf("%.0f", automationGraphLayoutX(source.PositionX)+automationGraphNodeWidth) } y1={ fmt.Sprintf("%.0f", automationGraphLayoutY(source.PositionY)+automationGraphNodeHeight/2) } x2={ fmt.Sprintf("%.0f", automationGraphLayoutX(target.PositionX)) } y2={ fmt.Sprintf("%.0f", automationGraphLayoutY(target.PositionY)+automationGraphNodeHeight/2) } class={ templ.KV("automation-graph-edge", true), templ.KV("automation-graph-edge--highlighted", edge.Highlighted) } stroke-width="2" marker-end="url(#automation-live-arrow)" aria-label={ fmt.Sprintf("%s, %d transitions, %d recent", edge.Label, edge.TransitionCount, edge.RecentTransitionCount) }></line>
						}
					}
					for _, node := range graph.Nodes {
						if taskURL := automationLiveNodeTaskURL(node, graph.Resources, currentProjectID, graph.Automation.ID, graph.Automation.Name); taskURL != "" {
							<a class="automation-graph-link" href={ templ.URL(taskURL) } hx-get={ taskURL } hx-target="#main-content" hx-push-url="true" draggable="false" onclick="event.preventDefault(); event.stopImmediatePropagation(); window.openVibelyNavigate(this.getAttribute('href')); return false;" aria-label={ automationLiveNodeAria(node) } data-automation-task-link>
								@automationLiveNodeShape(node)
							</a>
						} else {
							@automationLiveNodeShape(node)
						}
					}
					</svg>
				</div>
				<div class="min-h-[20rem] overflow-auto rounded-box border border-base-300 bg-base-200/20 p-4 font-mono text-sm leading-6" data-automation-yaml-panel hidden aria-label="Saved automation YAML"><pre class="whitespace-pre-wrap break-words">{ graph.YAML }</pre></div>
				</div>			if graph.TemplateUpdateAvailable {
				<dialog id="update-automation-template-modal" class="modal">
					<div class="modal-box">
						@ModalCloseButton("document.getElementById('update-automation-template-modal')", "Close template update confirmation")
						<h3 class="pr-10 text-lg font-bold">Update to latest template</h3>
						<p class="py-4">This replaces your current nodes, connections, prompts, and schedules with the latest { automationAdapterLabel(graph.Version.AdapterKey) } template.</p>
						<div class="rounded-lg bg-base-200 p-3 text-sm text-base-content/70">Your Automation name and lifecycle state are preserved. Template customizations are not merged.</div>
						<div class="modal-action">
							<button class="btn" type="button" onclick="document.getElementById('update-automation-template-modal').close()">Cancel</button>
							<form method="post" action={ templ.SafeURL(fmt.Sprintf("/automations/%s/builder?project_id=%s", graph.Automation.ID, currentProjectID)) } hx-post={ fmt.Sprintf("/automations/%s/builder?project_id=%s", graph.Automation.ID, currentProjectID) } hx-target="#main-content"><input type="hidden" name="project_id" value={ currentProjectID }/><input type="hidden" name="update_template" value="true"/><button class="btn btn-primary" type="submit">Update to latest</button></form>
						</div>
					</div>
					<form method="dialog" class="modal-backdrop"><button>Cancel</button></form>
				</dialog>
			}
				if deleteAvailable {
				<dialog id="delete-automation-modal" class="modal">
					<div class="modal-box">
						@ModalCloseButton("document.getElementById('delete-automation-modal')", "Close delete automation confirmation")
						<h3 class="pr-10 text-lg font-bold text-error">Delete automation</h3>
						<p class="py-4">Delete <strong>{ graph.Automation.Name }</strong>? This permanently deletes the saved Automation graph and Automation record.</p>
						<div class="rounded-lg bg-base-200 p-3 text-sm text-base-content/70">Existing tasks remain. Automation-owned trigger schedules will be deleted. This cannot be undone.</div>
						<div class="modal-action">
							<button class="btn" type="button" onclick="document.getElementById('delete-automation-modal').close()">Cancel</button>
							<form method="post" action={ templ.SafeURL(fmt.Sprintf("/automations/%s/delete?project_id=%s", graph.Automation.ID, currentProjectID)) } hx-post={ fmt.Sprintf("/automations/%s/delete?project_id=%s", graph.Automation.ID, currentProjectID) } hx-swap="none"><input type="hidden" name="project_id" value={ currentProjectID }/><button class="btn btn-error" type="submit">Delete automation</button></form>
						</div>
					</div>
					<form method="dialog" class="modal-backdrop"><button>Cancel</button></form>
				</dialog>
			}
		</div>		<script>
			(function() {
				var liveRoot = document.getElementById('automation-live');
				if (!liveRoot || !window.htmx) return;
				var state = window._automationLiveRefreshState;
				if (!state) {
					state = window._automationLiveRefreshState = {generation: 0, automationId: '', timer: null};
				}
				if (state.automationId !== liveRoot.dataset.automationId) {
					state.generation = 0;
					state.automationId = liveRoot.dataset.automationId;
				}
				if (state.timer) clearInterval(state.timer);
				window.openVibelyAutomationLiveRefresh = function(method, url) {
					var root = document.getElementById('automation-live');
					if (!root || !window.htmx) return;
					if (state.automationId !== root.dataset.automationId) {
						state.generation = 0;
						state.automationId = root.dataset.automationId;
					}
					var generation = ++state.generation;
					var source = document.createElement('span');
					source.hidden = true;
					source.setAttribute('data-automation-live-request-source', String(generation));
					document.body.appendChild(source);
					var request = window.htmx.ajax(method || 'GET', url || root.dataset.refreshUrl, {
						source: source,
						target: '#automation-live',
						swap: 'outerHTML',
						headers: {
							'X-OpenVibely-Automation-Live-Generation': String(generation),
							'X-OpenVibely-Automation-ID': root.dataset.automationId
						}
					});
					return Promise.resolve(request).finally(function() { source.remove(); });
				};
				if (!window._automationLiveSwapGuardBound) {
					window._automationLiveSwapGuardBound = true;
					document.body.addEventListener('htmx:beforeSwap', function(event) {
						var target = event.detail && event.detail.target;
						if (!target || target.id !== 'automation-live') return;
						var headers = event.detail.requestConfig && event.detail.requestConfig.headers || {};
						var generation = Number(headers['X-OpenVibely-Automation-Live-Generation'] || 0);
						var automationId = headers['X-OpenVibely-Automation-ID'] || '';
						var current = document.getElementById('automation-live');
						if (!generation || !current || automationId !== current.dataset.automationId || generation < state.generation) {
							event.detail.shouldSwap = false;
						}
					});
				}
				if (!window._automationLiveEventBound) {
					window._automationLiveEventBound = true;
					window.addEventListener('sse-automation-event', function(event) {
						var root = document.getElementById('automation-live');
						if (!root || !event.detail) return;
						if (event.detail.project_id && event.detail.project_id !== root.dataset.projectId) return;
						if (event.detail.automation_id && event.detail.automation_id !== root.dataset.automationId) return;
						clearTimeout(window._automationLiveRefreshTimer);
						window._automationLiveRefreshTimer = setTimeout(function() {
							window.openVibelyAutomationLiveRefresh('GET');
						}, 250);
					});
					document.addEventListener('visibilitychange', function() {
						if (document.visibilityState !== 'visible') return;
						var root = document.getElementById('automation-live');
						if (!root) return;
						if (root.dataset.externalRefreshUrl && root.querySelector('[data-automation-external-state]')) {
							window.openVibelyAutomationLiveRefresh('POST', root.dataset.externalRefreshUrl);
							return;
						}
						window.openVibelyAutomationLiveRefresh('GET');
					});
				}
				state.timer = setInterval(function() {
					if (document.visibilityState === 'visible' && document.getElementById('automation-live')) {
						window.openVibelyAutomationLiveRefresh('GET');
					}
				}, 20000);
					var canvasRoot = document.querySelector('[data-automation-readonly-canvas]');
					var graphPanel = canvasRoot && canvasRoot.querySelector('[data-automation-graph-panel]');
					var yamlPanel = canvasRoot && canvasRoot.querySelector('[data-automation-yaml-panel]');
					var graphViewButton = canvasRoot && canvasRoot.querySelector('[data-automation-view-graph]');
					var yamlViewButton = canvasRoot && canvasRoot.querySelector('[data-automation-view-yaml]');
					function selectAutomationLiveView(yamlSelected) {
						if (!graphPanel || !yamlPanel) return;
						graphPanel.hidden = yamlSelected;
						yamlPanel.hidden = !yamlSelected;
						graphViewButton.classList.toggle('btn-active', !yamlSelected);
						yamlViewButton.classList.toggle('btn-active', yamlSelected);
						graphViewButton.setAttribute('aria-pressed', String(!yamlSelected));
						yamlViewButton.setAttribute('aria-pressed', String(yamlSelected));
					}
					graphViewButton && graphViewButton.addEventListener('click', function() { selectAutomationLiveView(false); });
					yamlViewButton && yamlViewButton.addEventListener('click', function() { selectAutomationLiveView(true); });
					var svg = canvasRoot && canvasRoot.querySelector('[data-automation-canvas]');				if (canvasRoot && svg) {
					var original = svg.getAttribute('viewBox').split(/\s+/).map(Number);
					var box = original.slice();
					var pan = null;
					var panFrame = 0;
					var suppressedNodeLink = null;
					var suppressNodeClickTimer = 0;
					function apply() { svg.setAttribute('viewBox', box.join(' ')); }
					function applyPan() {
						panFrame = 0;
						if (!pan || !pan.pending) return;
						box[0] = pan.box[0] - (pan.pending.x - pan.clientX) * pan.unitsX;
						box[1] = pan.box[1] - (pan.pending.y - pan.clientY) * pan.unitsY;
						apply();
					}
					function queuePan(event) {
						if (!pan || pan.input !== 'pointer' || event.pointerId !== pan.pointerId) return;
						pan.pending = {x:event.clientX, y:event.clientY};
						if (!pan.dragged && Math.hypot(event.clientX-pan.clientX, event.clientY-pan.clientY) > 4) pan.dragged = true;
						if (!panFrame) panFrame = requestAnimationFrame(applyPan);
					}
					function queueMousePan(event) {
						if (!pan || pan.input !== 'mouse') return;
						if (!(event.buttons & 1)) { cancelMousePan(); return; }
						pan.pending = {x:event.clientX, y:event.clientY};
						if (!pan.dragged && Math.hypot(event.clientX-pan.clientX, event.clientY-pan.clientY) > 4) pan.dragged = true;
						if (!panFrame) panFrame = requestAnimationFrame(applyPan);
					}
					function stopPanTracking() {
						window.removeEventListener('pointermove', queuePan);
						window.removeEventListener('pointerup', finishPan);
						window.removeEventListener('pointercancel', finishPan);
						window.removeEventListener('mousemove', queueMousePan);
						window.removeEventListener('mouseup', finishMousePan);
						window.removeEventListener('blur', cancelMousePan);
					}
					function completePan(eventType, clientX, clientY, includePosition) {
						if (!pan) return;
						stopPanTracking();
						if (includePosition) pan.pending = {x:clientX, y:clientY};
						if (panFrame) { cancelAnimationFrame(panFrame); panFrame = 0; }
						applyPan();
						var dragged = pan.dragged;
						var nodeLink = pan.nodeLink;
						pan = null;
						if (dragged && nodeLink && eventType === 'up') {
							suppressedNodeLink = nodeLink;
							if (suppressNodeClickTimer) clearTimeout(suppressNodeClickTimer);
							suppressNodeClickTimer = setTimeout(function() {
								suppressNodeClickTimer = 0;
								suppressedNodeLink = null;
							}, 0);
						}
					}
					function finishPan(event) {
						if (!pan || pan.input !== 'pointer' || event.pointerId !== pan.pointerId) return;
						completePan(event.type === 'pointerup' ? 'up' : 'cancel', event.clientX, event.clientY, true);
					}
					function finishMousePan(event) {
						if (!pan || pan.input !== 'mouse' || event.button !== 0) return;
						completePan('up', event.clientX, event.clientY, true);
					}
					function cancelMousePan() {
						if (!pan || pan.input !== 'mouse') return;
						completePan('cancel', 0, 0, false);
					}
					function zoom(factor) { var cx=box[0]+box[2]/2, cy=box[1]+box[3]/2; box[2]=Math.max(300,Math.min(4000,box[2]*factor)); box[3]=Math.max(200,Math.min(2500,box[3]*factor)); box[0]=cx-box[2]/2; box[1]=cy-box[3]/2; apply(); }
					svg.addEventListener('wheel', function(event) { if (!event.ctrlKey && !event.metaKey) return; event.preventDefault(); zoom(event.deltaY > 0 ? 1.12 : .88); }, {passive:false});
					svg.addEventListener('dragstart', function(event) {
						if (event.target.closest('[data-automation-task-link]')) event.preventDefault();
					});
					svg.addEventListener('pointerdown', function(event) {
						if (document.documentElement.dataset.runtime === 'desktop') return;
						if (event.button !== 0) return;
						var rect = svg.getBoundingClientRect();
						if (!rect.width || !rect.height) return;
						if (suppressNodeClickTimer) { clearTimeout(suppressNodeClickTimer); suppressNodeClickTimer = 0; }
						suppressedNodeLink = null;
						pan = {input:'pointer', pointerId:event.pointerId, clientX:event.clientX, clientY:event.clientY, box:box.slice(), unitsX:box[2]/rect.width, unitsY:box[3]/rect.height, pending:null, dragged:false, nodeLink:event.target.closest('[data-automation-task-link]')};
						window.addEventListener('pointermove', queuePan);
						window.addEventListener('pointerup', finishPan);
						window.addEventListener('pointercancel', finishPan);
						if (!pan.nodeLink) { try { svg.setPointerCapture(event.pointerId); } catch (_) {} }
					});
					svg.addEventListener('mousedown', function(event) {
						if (document.documentElement.dataset.runtime !== 'desktop' || event.button !== 0) return;
						var rect = svg.getBoundingClientRect();
						if (!rect.width || !rect.height) return;
						if (suppressNodeClickTimer) { clearTimeout(suppressNodeClickTimer); suppressNodeClickTimer = 0; }
						suppressedNodeLink = null;
						pan = {input:'mouse', clientX:event.clientX, clientY:event.clientY, box:box.slice(), unitsX:box[2]/rect.width, unitsY:box[3]/rect.height, pending:null, dragged:false, nodeLink:event.target.closest('[data-automation-task-link]')};
						window.addEventListener('mousemove', queueMousePan);
						window.addEventListener('mouseup', finishMousePan);
						window.addEventListener('blur', cancelMousePan);
					});
					svg.addEventListener('click', function(event) {
						var nodeLink = event.target.closest('[data-automation-task-link]');
						if (!suppressedNodeLink || nodeLink !== suppressedNodeLink) return;
						event.preventDefault(); event.stopImmediatePropagation();
						suppressedNodeLink = null;
						if (suppressNodeClickTimer) { clearTimeout(suppressNodeClickTimer); suppressNodeClickTimer = 0; }
					}, true);
					canvasRoot.querySelector('[data-automation-zoom-in]').addEventListener('click', function(){zoom(.82);});
					canvasRoot.querySelector('[data-automation-zoom-out]').addEventListener('click', function(){zoom(1.22);});
					canvasRoot.querySelector('[data-automation-fit]').addEventListener('click', function(){box=original.slice();apply();});
				}
			})();
		</script>
}

func automationGraphLayoutX(value float64) float64 { return value }
func automationGraphLayoutY(value float64) float64 { return value }
func automationLiveGraphViewBox(nodes []models.AutomationLiveNode) string {
	if len(nodes) == 0 {
		return "-60 -60 900 540"
	}
	minX, minY := automationGraphLayoutX(nodes[0].PositionX), automationGraphLayoutY(nodes[0].PositionY)
	maxX, maxY := minX+automationGraphNodeWidth, minY+automationGraphNodeHeight
	for _, node := range nodes {
		x, y := automationGraphLayoutX(node.PositionX), automationGraphLayoutY(node.PositionY)
		if x < minX { minX = x }
		if y < minY { minY = y }
		if x+automationGraphNodeWidth > maxX { maxX = x+automationGraphNodeWidth }
		if y+automationGraphNodeHeight > maxY { maxY = y+automationGraphNodeHeight }
	}
	return fmt.Sprintf("%.0f %.0f %.0f %.0f", minX-automationGraphPadding, minY-automationGraphPadding, maxX-minX+2*automationGraphPadding, maxY-minY+2*automationGraphPadding)
}
func automationLiveEdgeNodes(nodes []models.AutomationLiveNode, edge models.AutomationEdge) (models.AutomationLiveNode, models.AutomationLiveNode, bool) { var source, target models.AutomationLiveNode; var foundSource, foundTarget bool; for _, n := range nodes { if n.ID == edge.SourceNodeID { source, foundSource = n, true }; if n.ID == edge.TargetNodeID { target, foundTarget = n, true } }; return source, target, foundSource && foundTarget }
func automationLiveNodeClass(state string) string { base := "automation-graph-node automation-graph-node--idle"; switch state { case "failed": return "automation-graph-node automation-graph-node--failed"; case "blocked": return "automation-graph-node automation-graph-node--blocked"; case "waiting_human": return "automation-graph-node automation-graph-node--waiting"; case "running": return "automation-graph-node automation-graph-node--running"; case "recently_completed": return "automation-graph-node automation-graph-node--completed" }; return base }
func automationStateLabel(state string) string { return strings.ReplaceAll(strings.Title(strings.ReplaceAll(state, "_", " ")), "Human", "human") }
func automationStateDotClass(state string) string { return "automation-state-dot automation-state-dot--" + strings.ReplaceAll(state, "_human", "") }
func automationStateTextClass(state string) string { return "automation-node-state automation-node-state--" + strings.ReplaceAll(state, "_human", "") }
func automationNodeCountLabel(c models.AutomationNodeCounts) string { values := []string{}; if c.Running > 0 { values = append(values, fmt.Sprintf("%d running", c.Running)) }; if c.Waiting > 0 { values = append(values, fmt.Sprintf("%d waiting", c.Waiting)) }; if c.Blocked > 0 { values = append(values, fmt.Sprintf("%d blocked", c.Blocked)) }; if c.Failed > 0 { values = append(values, fmt.Sprintf("%d failed", c.Failed)) }; if c.CompletedRecently > 0 { values = append(values, fmt.Sprintf("%d recent", c.CompletedRecently)) }; if len(values) == 0 { return "No active work" }; return strings.Join(values, " · ") }
func automationLiveNodeAria(node models.AutomationLiveNode) string { return node.Name + ", " + automationStateLabel(node.DisplayState) + ", " + automationNodeCountLabel(node.Counts) }

templ AutomationBuilder(projects []models.Project, currentProjectID string, page models.AutomationBuilderPage) {
	@layout.Base("Automation Builder", projects, currentProjectID) {
		@AutomationBuilderContent(page, currentProjectID)
	}
}

templ AutomationBuilderContent(page models.AutomationBuilderPage, currentProjectID string) {
	<div id="automation-builder" class="flex h-full min-w-0 max-w-full flex-col overflow-y-auto" data-automation-draft data-automation-yaml-builder>
		<div class={ templ.KV("flex h-full min-h-0 shrink-0 flex-col", page.AutomationID != "" || page.Source == "blank") } data-automation-builder-edit-pane>
		@layout.PageTitle(page.Result.Candidate.Name)
		if page.AutomationID != "" || page.Source == "blank" {
			<div class="mb-6 min-w-0 shrink-0" data-automation-builder-header>
				<div class="flex flex-wrap items-start justify-between gap-3">
					<div class="min-w-0 flex-1">@automationEditableBreadcrumb(currentProjectID, page.Result.Candidate.Name)</div>
					if page.AutomationID != "" {
						<div class="flex shrink-0 flex-wrap items-center justify-end gap-2" data-automation-builder-header-actions>
							<a class="btn btn-ghost btn-sm" href={ templ.URL(fmt.Sprintf("/automations/%s?project_id=%s", page.AutomationID, currentProjectID)) } hx-get={ fmt.Sprintf("/automations/%s?project_id=%s", page.AutomationID, currentProjectID) } hx-target="#main-content" hx-push-url="true" onclick="event.preventDefault(); event.stopImmediatePropagation(); window.openVibelyNavigate(this.getAttribute('href')); return false;" data-automation-builder-cancel>Cancel</a>
							<button class="btn btn-primary btn-sm" type="submit" form="automation-design-form" name="save_changes" value="true" data-automation-builder-save>Save</button>
							@automationBuilderMoreActions(page, currentProjectID)
						</div>
					} else {
						<div class="flex shrink-0 flex-wrap items-center justify-end gap-2" data-automation-builder-header-actions>
							<button class="btn btn-primary btn-sm" type="submit" form="automation-design-form" name="save_changes" value="true" data-automation-builder-save>Save</button>
						</div>
					}
				</div>
				if strings.TrimSpace(page.Result.Candidate.Description) != "" {
					<p class="mt-1 text-sm opacity-60">{ page.Result.Candidate.Description }</p>
				}
			</div>
		} else {
			@automationBreadcrumb(currentProjectID, "", "", "New Automation", true)
		}		if page.AutomationID == "" && page.Source != "blank" {
			<div class="mb-4 flex flex-wrap items-end justify-between gap-3">
				<div class="min-w-0 flex-1">
					<label class="form-control max-w-xl"><span class="label-text mb-1 font-medium">Automation name</span><input class="input input-bordered w-full text-xl font-bold sm:text-2xl" form="automation-design-form" name="automation_name" value={ page.Result.Candidate.Name } maxlength="200" required data-automation-name aria-label="Automation name"/></label>
					<p class="mt-2 text-sm text-base-content/65">Saving validates and applies this Automation immediately.</p>
				</div>
				<button class="btn btn-primary btn-sm" type="submit" form="automation-design-form" name="save_changes" value="true">Save changes</button>
			</div>
		}
		if page.AutomationID != "" {
			<dialog id="delete-automation-modal" class="modal">
				<div class="modal-box">
					@ModalCloseButton("document.getElementById('delete-automation-modal')", "Close delete automation confirmation")
					<h3 class="pr-10 text-lg font-bold text-error">Delete automation</h3>
					<p class="py-4">Delete <strong>{ page.Result.Candidate.Name }</strong>? This permanently deletes this Automation graph and its saved design.</p>
					<div class="rounded-lg bg-base-200 p-3 text-sm text-base-content/70">Existing tasks remain. Any Automation-owned trigger schedules will be deleted. This cannot be undone.</div>
					<div class="modal-action">
						<button class="btn" type="button" onclick="document.getElementById('delete-automation-modal').close()">Cancel</button>
						<form method="post" action={ templ.SafeURL(fmt.Sprintf("/automations/%s/delete?project_id=%s", page.AutomationID, currentProjectID)) } hx-post={ fmt.Sprintf("/automations/%s/delete?project_id=%s", page.AutomationID, currentProjectID) } hx-swap="none"><input type="hidden" name="project_id" value={ currentProjectID }/><button class="btn btn-error" type="submit">Delete automation</button></form>
					</div>
				</div>
				<form method="dialog" class="modal-backdrop"><button>Cancel</button></form>
			</dialog>
		}
		if page.AutomationID != "" && page.TemplateUpdateAvailable {
			<dialog id="update-automation-template-modal" class="modal">
				<div class="modal-box">
					@ModalCloseButton("document.getElementById('update-automation-template-modal')", "Close template update confirmation")
					<h3 class="pr-10 text-lg font-bold">Update to latest template</h3>
					<p class="py-4">This replaces your current nodes, connections, prompts, and schedules with the latest { automationAdapterLabel(page.Result.Candidate.AdapterKey) } template.</p>
					<div class="rounded-lg bg-base-200 p-3 text-sm text-base-content/70">Your Automation name and lifecycle state are preserved. Template customizations are not merged.</div>
					<div class="modal-action">
						<button class="btn" type="button" onclick="document.getElementById('update-automation-template-modal').close()">Cancel</button>
						<form method="post" action={ templ.SafeURL(automationBuilderPostURL(page, currentProjectID)) } hx-post={ automationBuilderPostURL(page, currentProjectID) } hx-target="#main-content"><input type="hidden" name="project_id" value={ currentProjectID }/><input type="hidden" name="update_template" value="true"/><button class="btn btn-primary" type="submit">Update to latest</button></form>
					</div>
				</div>
				<form method="dialog" class="modal-backdrop"><button>Cancel</button></form>
			</dialog>
		}
		if page.AutomationID == "" && page.Source == "template" {
			<div class="alert alert-info mb-4" role="status"><span>This template is browser-local until you save its YAML definition.</span></div>
		}
		if page.AutomationID == "" && page.Source == "describe" {
			<div class="alert alert-info mb-4" role="status"><span>This generated design is browser-local. Review the graph, then select <strong>Save changes</strong> to create and start the Automation.</span></div>
		}
		if page.Error != "" {
			<div class="alert alert-error mb-4" role="alert">{ page.Error }</div>
		}
		if page.AutomationID == "" && (len(page.Result.Assumptions) > 0 || len(page.Result.Warnings) > 0) {
			<div class="mb-4 grid grid-cols-1 gap-3 lg:grid-cols-2" data-automation-builder-insights>
				<div class="rounded-box bg-base-200/60 p-4"><h3 class="font-semibold">Assumptions</h3><ul class="mt-2 list-disc pl-5 text-sm">
					for _, item := range page.Result.Assumptions {
						<li>{ item }</li>
					}
				</ul></div>
				<div class="rounded-box bg-base-200/60 p-4"><h3 class="font-semibold">Warnings</h3><ul class="mt-2 list-disc pl-5 text-sm">
					for _, item := range page.Result.Warnings {
						<li>{ item }</li>
					}
				</ul></div>
			</div>
		}
			if len(page.Result.ValidationErrors) > 0 {
				<details class="mb-3 rounded-box border border-base-300 bg-base-200/40 px-4 py-3" data-automation-validation-summary data-automation-yaml-validation open?={ page.Error != "" }>
					<summary class="cursor-pointer text-sm font-medium">{ fmt.Sprintf("%d setup items before this design can run", len(automationValidationMessages(page.Result.ValidationErrors, page.NodePalette))) }</summary>
					<ul class="mt-2 list-disc pl-5 text-sm text-base-content/70">
						for _, message := range automationValidationMessages(page.Result.ValidationErrors, page.NodePalette) {
							<li>{ message }</li>
						}
					</ul>
				</details>
			}
			<section class={ "rounded-box border border-base-300 bg-base-100", templ.KV("mb-5 p-3 sm:p-4", page.AutomationID == "" && page.Source != "blank"), templ.KV("mb-0 p-4", page.AutomationID != "" || page.Source == "blank"), templ.KV("flex flex-1 min-h-[20rem] flex-col", page.AutomationID != "" || page.Source == "blank") } data-automation-draft-canvas data-automation-view-root data-edge-palette={ automationDraftEdgesJSON(page.EdgePalette) }>
				<div class={ "flex flex-wrap justify-between gap-3", templ.KV("items-start", page.AutomationID == "" && page.Source != "blank"), templ.KV("mb-3 items-center", page.AutomationID != "" || page.Source == "blank") }>
					@automationCanvasViewSwitcher()
					<div class="flex shrink-0 flex-wrap items-center justify-end gap-2" data-automation-node-tool>
						<button class="btn btn-primary btn-sm" type="button" data-automation-add-node-open onclick="document.getElementById('automation-node-dialog').showModal()">Add node</button>
					</div>
				</div>
				<span class="sr-only" data-automation-connect-status aria-live="polite"></span>
						if page.AutomationID != "" && page.LifecycleState == models.AutomationActive {
						<form id="automation-builder-pause-form" class="hidden" method="post" action={ templ.SafeURL(fmt.Sprintf("/automations/%s/pause?project_id=%s", page.AutomationID, currentProjectID)) }>
							<input type="hidden" name="project_id" value={ currentProjectID }/>
						</form>
					}
					if page.AutomationID != "" && page.LifecycleState == models.AutomationPaused {
						<form id="automation-builder-resume-form" class="hidden" method="post" action={ templ.SafeURL(fmt.Sprintf("/automations/%s/resume?project_id=%s", page.AutomationID, currentProjectID)) }>
							<input type="hidden" name="project_id" value={ currentProjectID }/>
						</form>
					}
						<div data-automation-yaml-panel hidden style="display: none" class="flex min-h-[20rem] flex-1 flex-col overflow-auto rounded-box border border-base-300 bg-base-200/20 p-4 font-mono text-sm leading-6">
							<div class="flex min-h-0 flex-1 overflow-hidden" data-automation-yaml-editor-shell>
								<pre class="m-0 w-12 shrink-0 select-none overflow-hidden whitespace-pre-wrap break-words border-r border-base-300 pr-3 text-right text-base-content/45" aria-label="YAML line numbers" data-automation-yaml-line-numbers>{ automationYAMLLineNumbers(page.YAML) }</pre>
								<div class="relative min-w-0 flex-1 overflow-hidden" data-automation-yaml-editor-viewport>
									<pre class="absolute inset-0 m-0 min-h-full overflow-hidden whitespace-pre-wrap break-words pl-9 font-mono text-sm leading-6" aria-hidden="true" data-automation-yaml-highlight></pre>
									<div class="pointer-events-none absolute inset-0 z-10 min-h-full overflow-hidden" aria-label="YAML section controls" data-automation-yaml-fold-controls></div>
									<textarea class="absolute inset-0 block h-full w-full resize-none overflow-y-auto overflow-x-hidden border-0 bg-transparent whitespace-pre-wrap break-words pl-9 font-mono text-sm leading-6 text-transparent outline-none caret-base-content" style="caret-color: hsl(var(--bc));" form="automation-design-form" name="automation_yaml" data-automation-yaml-editor data-automation-yaml-parse-url={ fmt.Sprintf("/automations/yaml/parse?project_id=%s", currentProjectID) } spellcheck="false" wrap="soft" aria-label="Automation definition. Use the arrows beside section keys to collapse YAML sections.">{ page.YAML }</textarea>
								</div>
							</div>
							<p class="mt-3 hidden rounded-box border border-error/30 bg-error/10 px-3 py-2 font-sans text-sm text-error" role="alert" data-automation-yaml-diagnostic></p>
						</div>
						<dialog id="automation-node-dialog" class="modal" data-automation-node-dialog>
							<div class="modal-box relative max-w-md">
								<div class="absolute right-4 top-4">@ModalCloseButton("document.getElementById('automation-node-dialog')", "Close add node dialog")</div>
								<div class="pr-10"><h3 class="text-lg font-semibold">Add node</h3>
									if page.Result.Candidate.AdapterKey == "custom" {
										<p class="mt-1 text-sm text-base-content/65">Add an OpenVibely capability, then connect it to the next step.</p>
									} else {
								<p class="mt-1 text-sm text-base-content/65">Add an OpenVibely capability or restore a removed template step, then connect supported handoffs.</p>
							}
						</div>
					<form class="mt-5 space-y-4" method="post" action={ templ.SafeURL(automationBuilderPostURL(page, currentProjectID)) } hx-post={ automationBuilderPostURL(page, currentProjectID) } hx-target="#main-content">
						<input type="hidden" name="project_id" value={ currentProjectID }/><input type="hidden" name="builder_source" value={ page.Source }/><input type="hidden" value={ automationDraftCandidateJSON(page.Result.Candidate) } data-candidate-json/><input type="hidden" name="automation_yaml" value={ page.YAML } data-automation-yaml-submission/><input type="hidden" name="builder_action" value="create_node"/>
						<label class="form-control"><span class="label-text">Node purpose</span><select class="select select-bordered" name="node_kind" required>
							<option value="schedule">Schedule</option>
							<option value="task">Task</option>
							<option value="create_notification">Create notification</option>
							<option value="human_approval">Human approval</option>
							<option value="native_inbox">Approved inbox</option>
							<option value="native_implementation">Native implementation</option>
							<option value="create_github_issue">Create GitHub issue</option>
							<option value="human_assignment">Human assignment</option>
							<option value="github_inbox">GitHub inbox</option>
							<option value="open_pull_request">Open pull request</option>
							<option value="human_review">Human review</option>
							<option value="outcome">Outcome</option>
							if page.Result.Candidate.AdapterKey != "custom" {
								for _, node := range page.NodePalette {
									if !automationDraftHasNode(page.Result.Candidate.Nodes, node.Key) {
										<option value={ "runtime:" + node.Key }>{ "Restore: " + node.Name + " · " + automationNodeTypeLabel(node.Type) }</option>
									}
								}
							}
						</select><span class="label-text-alt mt-1">Add real schedules, tasks, Native Alert approvals, GitHub issue/assignment/PR/review steps, and outcomes. Connect them to define supported handoffs.</span></label>
						<label class="form-control"><span class="label-text">Name</span><input class="input input-bordered" name="node_name" maxlength="200" placeholder="Review result" required autofocus/></label>
						<div class="modal-action"><button class="btn btn-ghost" type="button" onclick="document.getElementById('automation-node-dialog').close()">Cancel</button><button class="btn btn-primary" type="submit" data-automation-create-node>Add node</button></div>
					</form>
					if page.Source == "template" {
						<details class="mt-5 border-t border-base-300 pt-4"><summary class="cursor-pointer text-sm font-semibold">Suggested nodes</summary><p class="mt-1 text-xs text-base-content/60">Quick-add nodes understood by this Automation’s runtime.</p>
							<div class="mt-2 space-y-1">
								for _, node := range page.NodePalette {
									if !automationDraftHasNode(page.Result.Candidate.Nodes, node.Key) {
										<form method="post" action={ templ.SafeURL(automationBuilderPostURL(page, currentProjectID)) } hx-post={ automationBuilderPostURL(page, currentProjectID) } hx-target="#main-content"><input type="hidden" name="project_id" value={ currentProjectID }/><input type="hidden" name="builder_source" value={ page.Source }/><input type="hidden" value={ automationDraftCandidateJSON(page.Result.Candidate) } data-candidate-json/><input type="hidden" name="automation_yaml" value={ page.YAML } data-automation-yaml-submission/><input type="hidden" name="builder_action" value="add_node"/><input type="hidden" name="node_key" value={ node.Key }/><button class="btn btn-ghost h-auto min-h-11 w-full justify-start py-2 text-left" type="submit" data-automation-add-node><span><span class="block text-sm font-medium">{ node.Name }</span><span class="block text-xs font-normal text-base-content/55">{ automationNodeTypeLabel(node.Type) }</span></span></button></form>
									}
								}
							</div>
						</details>
					}
					</div>
					<form method="dialog" class="modal-backdrop"><button aria-label="Close add node dialog">close</button></form>
				</dialog>
					<div data-automation-graph-panel class={ "automation-canvas-shell relative w-full overflow-hidden rounded-box border border-base-300 bg-base-200/30", templ.KV("mt-3", page.AutomationID == "" && page.Source != "blank"), templ.KV("flex-1 min-h-[20rem]", page.AutomationID != "" || page.Source == "blank"), templ.KV("min-h-[calc(100dvh-15rem)]", page.AutomationID == "" && page.Source != "blank") } role="region" aria-label="Automation graph builder">					<div class="absolute right-3 top-3 z-10 flex flex-wrap items-center gap-1 rounded-box border border-base-300 bg-base-100/90 p-1 shadow-sm backdrop-blur" aria-label="Canvas controls" data-automation-builder-viewport-controls>
						<button class="btn btn-ghost btn-sm" type="button" data-automation-zoom-out aria-label="Zoom out">−</button>
						<button class="btn btn-ghost btn-sm" type="button" data-automation-zoom-in aria-label="Zoom in">+</button>
						<button class="btn btn-ghost btn-sm" type="button" data-automation-fit>Fit</button>
						<button class="btn btn-ghost btn-sm" type="button" data-automation-reset>Reset layout</button>
					</div>
					<svg data-automation-canvas viewBox={ automationDraftGraphViewBox(page.Result.Candidate.Nodes) } class={ "block w-full touch-none select-none", templ.KV("h-full", page.Source == "blank" || page.AutomationID != ""), templ.KV("h-[calc(100dvh-15rem)] min-h-[42rem]", page.AutomationID == "" && page.Source != "blank") } role="img" aria-label={ page.Result.Candidate.Name + " graph design" }>
						@automationGraphThemeStyles()
						<defs>
							<marker id="automation-draft-arrow" markerWidth="10" markerHeight="10" refX="8" refY="3" orient="auto"><path d="M0,0 L0,6 L9,3 z" class="automation-graph-arrow automation-edge-foreground-arrow"></path></marker>
							<marker id="automation-draft-preview-arrow" markerWidth="10" markerHeight="10" refX="8" refY="3" orient="auto"><path d="M0,0 L0,6 L9,3 z" class="automation-graph-preview-arrow"></path></marker>
						</defs>
						for _, edge := range page.Result.Candidate.Edges {
							if source, target, ok := automationDraftEdgeNodes(page.Result.Candidate.Nodes, edge); ok {
								<g class="automation-draft-edge" data-edge-key={ edge.Key } data-from={ edge.From } data-to={ edge.To } tabindex="0" role="group" aria-label={ automationDraftNodeName(page.Result.Candidate.Nodes, edge.From) + " to " + automationDraftNodeName(page.Result.Candidate.Nodes, edge.To) + " connection" }>
									<line data-edge-hit x1={ fmt.Sprintf("%.0f", source.Position.X+automationGraphNodeWidth) } y1={ fmt.Sprintf("%.0f", source.Position.Y+automationGraphNodeHeight/2) } x2={ fmt.Sprintf("%.0f", target.Position.X) } y2={ fmt.Sprintf("%.0f", target.Position.Y+automationGraphNodeHeight/2) } class="automation-edge-hit"></line>
								</g>
							}
						}
						for _, node := range page.Result.Candidate.Nodes {
							if node.Position != nil {
								<g class="automation-draft-node automation-graph-focus cursor-grab active:cursor-grabbing" data-node-key={ node.Key } data-node-x={ fmt.Sprintf("%.0f", node.Position.X) } data-node-y={ fmt.Sprintf("%.0f", node.Position.Y) } data-default-x={ fmt.Sprintf("%.0f", automationDraftDefaultX(page.NodePalette, node.Key)) } data-default-y={ fmt.Sprintf("%.0f", automationDraftDefaultY(page.NodePalette, node.Key)) } transform={ fmt.Sprintf("translate(%.0f %.0f)", node.Position.X, node.Position.Y) } tabindex="0" role="group" aria-label={ node.Name + ", " + string(node.Type) + ", use arrow keys to move" }>
									<rect width={ fmt.Sprintf("%.0f", automationGraphNodeWidth) } height={ fmt.Sprintf("%.0f", automationGraphNodeHeight) } rx="12" class="automation-graph-node automation-graph-node--idle" stroke-width="2"></rect>
									<foreignObject x="0" y="0" width={ fmt.Sprintf("%.0f", automationGraphNodeWidth) } height={ fmt.Sprintf("%.0f", automationGraphNodeHeight) } class="pointer-events-none"><div xmlns="http://www.w3.org/1999/xhtml" class="automation-node-content"><strong>{ node.Name }</strong><span>{ automationNodeTypeLabel(node.Type) }</span></div></foreignObject>
									<circle cx="0" cy={ fmt.Sprintf("%.0f", automationGraphNodeHeight/2) } r="9" class="automation-connect-handle automation-connect-handle--input" data-connect-port={ node.Key } data-port-side="left" data-port-kind="input" tabindex="0" role="button" aria-label={ "Input for " + node.Name }></circle>
									<circle cx={ fmt.Sprintf("%.0f", automationGraphNodeWidth) } cy={ fmt.Sprintf("%.0f", automationGraphNodeHeight/2) } r="9" class="automation-connect-handle automation-connect-handle--output" data-connect-port={ node.Key } data-port-side="right" data-port-kind="output" tabindex="0" role="button" aria-label={ "Output from " + node.Name }></circle>
									<g data-delete-node transform={ fmt.Sprintf("translate(%.0f 16)", automationGraphNodeWidth-16) } class="automation-node-delete" tabindex="0" role="button" aria-label={ "Delete " + node.Name }><circle r="11"></circle><path d="M-4 -4 L4 4 M4 -4 L-4 4" class="automation-delete-x"></path></g>
								</g>
								}
							}
							for _, edge := range page.Result.Candidate.Edges {
								if source, target, ok := automationDraftEdgeNodes(page.Result.Candidate.Nodes, edge); ok {
									<line data-edge-foreground data-edge-key={ edge.Key } x1={ fmt.Sprintf("%.0f", source.Position.X+automationGraphNodeWidth) } y1={ fmt.Sprintf("%.0f", source.Position.Y+automationGraphNodeHeight/2) } x2={ fmt.Sprintf("%.0f", target.Position.X) } y2={ fmt.Sprintf("%.0f", target.Position.Y+automationGraphNodeHeight/2) } class="automation-graph-edge automation-edge-foreground" stroke-width="2" marker-end="url(#automation-draft-arrow)"></line>
								}
							}
							<line data-automation-edge-preview x1="0" y1="0" x2="0" y2="0" class="automation-graph-edge automation-graph-edge--preview" marker-end="url(#automation-draft-preview-arrow)" hidden></line>
							for _, edge := range page.Result.Candidate.Edges {
								if source, target, ok := automationDraftEdgeNodes(page.Result.Candidate.Nodes, edge); ok {
									<g data-edge-controls data-edge-key={ edge.Key } class="automation-edge-controls">
										<circle data-reconnect-edge data-edge-endpoint="from" cx={ fmt.Sprintf("%.0f", source.Position.X+automationGraphNodeWidth) } cy={ fmt.Sprintf("%.0f", source.Position.Y+automationGraphNodeHeight/2) } r="7" class="automation-edge-endpoint" tabindex="0" role="button" aria-label="Reconnect connection start"></circle>
										<circle data-reconnect-edge data-edge-endpoint="to" cx={ fmt.Sprintf("%.0f", target.Position.X) } cy={ fmt.Sprintf("%.0f", target.Position.Y+automationGraphNodeHeight/2) } r="7" class="automation-edge-endpoint" tabindex="0" role="button" aria-label="Reconnect connection end"></circle>
										<g data-delete-edge transform={ fmt.Sprintf("translate(%.0f %.0f)", (source.Position.X+automationGraphNodeWidth+target.Position.X)/2, (source.Position.Y+target.Position.Y)/2+automationGraphNodeHeight/2) } class="automation-edge-delete" tabindex="0" role="button" aria-label="Delete connection"><circle r="11"></circle><path d="M-4 -4 L4 4 M4 -4 L-4 4" class="automation-delete-x"></path></g>
									</g>
								}
							}
						</svg>
						if len(page.Result.Candidate.Nodes) == 0 {
							<div class="pointer-events-none absolute inset-0 flex items-center justify-center p-6">
							<div class="pointer-events-auto max-w-sm rounded-box border border-base-300 bg-base-100/95 p-6 text-center shadow-xl"><h4 class="text-lg font-semibold">Start your graph</h4><p class="mt-2 text-sm text-base-content/65">Add nodes, drag them into place, then connect each node's right handle to the next node's left handle.</p><button class="btn btn-primary mt-4" type="button" data-automation-add-first-node onclick="document.getElementById('automation-node-dialog').showModal()">Add first node</button></div>
						</div>
					}
				</div>
			</section>
		</div>
			if page.AutomationID != "" && (len(page.Result.Assumptions) > 0 || len(page.Result.Warnings) > 0) {
				<div class="mb-4 grid grid-cols-1 gap-3 lg:grid-cols-2" data-automation-builder-insights>
					<div class="rounded-box bg-base-200/60 p-4"><h3 class="font-semibold">Assumptions</h3><ul class="mt-2 list-disc pl-5 text-sm">
						for _, item := range page.Result.Assumptions {
							<li>{ item }</li>
						}
					</ul></div>
					<div class="rounded-box bg-base-200/60 p-4"><h3 class="font-semibold">Warnings</h3><ul class="mt-2 list-disc pl-5 text-sm">
						for _, item := range page.Result.Warnings {
							<li>{ item }</li>
						}
					</ul></div>
				</div>
			}
			<form id="automation-design-form" method="post" action={ templ.SafeURL(automationBuilderPostURL(page, currentProjectID)) } hx-post={ automationBuilderPostURL(page, currentProjectID) } hx-target="#main-content" class="hidden" data-automation-yaml-form>
				<input type="hidden" name="project_id" value={ currentProjectID }/>
				<input type="hidden" name="builder_source" value={ page.Source }/>
			</form>
			<input type="hidden" value={ automationDraftCandidateJSON(page.Result.Candidate) } data-candidate-json/>
			<script>
			(function() {
				var root = document.querySelector('[data-automation-draft-canvas]');
				var builder = document.getElementById('automation-builder');
				var svg = root && root.querySelector('[data-automation-canvas]');
				var source = builder && builder.querySelector('[data-candidate-json]');
				if (!root || !builder || !svg || !source) return;
					var candidate;
					try { candidate = JSON.parse(source.value); } catch (_) { return; }
					var edgePalette = [];				try { edgePalette = JSON.parse(root.dataset.edgePalette || '[]'); } catch (_) { return; }
				var connectStatus = root.querySelector('[data-automation-connect-status]');
				var preview = svg.querySelector('[data-automation-edge-preview]');
					var selectedEdgeKey = '';
					var keyboardSource = null;
					var activeConnection = null;
					var initialViewBox = svg.getAttribute('viewBox').split(/\s+/).map(Number);
					var viewBox = initialViewBox.slice();

					function nodeCandidate(key) { return (candidate.nodes || []).find(function(node) { return node.key === key; }); }
					function edgeCandidate(key) { return (candidate.edges || []).find(function(edge) { return edge.key === key; }); }
					function nodeName(key) { var node = nodeCandidate(key); return node ? node.name : key; }
						function nodeGroup(key) { return svg.querySelector('[data-node-key="' + CSS.escape(key) + '"]'); }
						function foregroundEdge(key) { return svg.querySelector('[data-edge-foreground][data-edge-key="' + CSS.escape(key) + '"]'); }
						function edgeControls(key) { return svg.querySelector('[data-edge-controls][data-edge-key="' + CSS.escape(key) + '"]'); }					function nodePortPoint(key, side) { var group = nodeGroup(key); if (!group) return null; return {x: Number(group.dataset.nodeX) + (side === 'right' ? 170 : 0), y: Number(group.dataset.nodeY) + 52}; }
					function yamlString(value) { return JSON.stringify(String(value == null ? '' : value)); }
					function yamlJSON(value, fallback) { var encoded = JSON.stringify(value); return encoded === undefined ? fallback : encoded; }
					function visualCandidateYAML() {
						var lines = [
							'schema_version: ' + Number(candidate.schema_version || 1),
							'name: ' + yamlString(candidate.name),
							'description: ' + yamlString(candidate.description),
							'automation_type: ' + yamlString(candidate.automation_type),
							'adapter_key: ' + yamlString(candidate.adapter_key),
							'nodes:'
						];
						(candidate.nodes || []).forEach(function(node) {
							lines.push('  - key: ' + yamlString(node.key));
							lines.push('    name: ' + yamlString(node.name));
							lines.push('    type: ' + yamlString(node.type));
							lines.push('    role: ' + yamlString(node.role));
							lines.push('    config: ' + yamlJSON(node.config || {}, '{}'));
							if (node.position) lines.push('    position: ' + yamlJSON(node.position, '{}'));
						});
						lines.push('edges:');
						(candidate.edges || []).forEach(function(edge) {
							lines.push('  - key: ' + yamlString(edge.key));
							lines.push('    from: ' + yamlString(edge.from));
							lines.push('    to: ' + yamlString(edge.to));
							lines.push('    from_port: ' + yamlString(edge.from_port || 'right'));
							lines.push('    to_port: ' + yamlString(edge.to_port || 'left'));
							if (edge.label) lines.push('    label: ' + yamlString(edge.label));
							if (edge.condition && Object.keys(edge.condition).length) lines.push('    condition: ' + yamlJSON(edge.condition, '{}'));
						});
						if (candidate.assumptions && candidate.assumptions.length) lines.push('assumptions: ' + yamlJSON(candidate.assumptions, '[]'));
						if (candidate.warnings && candidate.warnings.length) lines.push('warnings: ' + yamlJSON(candidate.warnings, '[]'));
						return lines.join('\n') + '\n';
