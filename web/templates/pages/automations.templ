package pages

import (
	"fmt"
	"strings"
	"time"
	"github.com/openvibely/openvibely/internal/models"
	"github.com/openvibely/openvibely/web/templates/layout"
)

templ Automations(projects []models.Project, currentProjectID string, cards []models.AutomationCard) {
	@layout.Base("Automations", projects, currentProjectID) {
		@automationsContent(cards, currentProjectID)
	}
}

templ AutomationsContent(cards []models.AutomationCard, currentProjectID string) {
	@automationsContent(cards, currentProjectID)
}

templ automationsContent(cards []models.AutomationCard, currentProjectID string) {
	<div id="automations-container" class="h-full overflow-y-auto min-w-0 max-w-full">
		@layout.PageTitle("Automations")
		<div class="mb-6 flex flex-wrap items-start justify-between gap-3">
			<div>
				<h2 class="text-2xl font-bold">Automations</h2>
				<p class="mt-1 text-sm text-base-content/65">Published autonomous processes explicitly registered for this project.</p>
			</div>
		</div>
		if len(cards) == 0 {
			<div class="rounded-box bg-base-200/60 p-8 text-center">
				<h3 class="font-semibold">No published automations</h3>
				<p class="mt-2 text-sm text-base-content/65">Run a maintained Native or GitHub automation setup. Existing tasks and schedules are never inferred or backfilled.</p>
			</div>
		} else {
			<div class="grid grid-cols-1 gap-4 md:grid-cols-2 xl:grid-cols-3" data-card-search>
				for _, card := range cards {
					<a class="card min-w-0 border border-base-300 bg-base-100 shadow-sm transition hover:border-primary/50 hover:shadow-md" href={ templ.URL(fmt.Sprintf("/automations/%s?project_id=%s", card.Automation.ID, currentProjectID)) } hx-get={ fmt.Sprintf("/automations/%s?project_id=%s", card.Automation.ID, currentProjectID) } hx-target="#main-content" hx-push-url="true" data-search-card data-search-text={ automationCardSearchText(card) }>
						<div class="card-body min-w-0 p-5">
							<div class="flex min-w-0 items-start justify-between gap-3">
								<div class="min-w-0">
									<h3 class="truncate text-lg font-semibold">{ card.Automation.Name }</h3>
									<p class="mt-1 line-clamp-2 text-sm text-base-content/65">{ card.Automation.Description }</p>
								</div>
								<span class="badge badge-primary badge-outline shrink-0">{ string(card.Automation.LifecycleState) }</span>
							</div>
							<div class="mt-3 flex flex-wrap gap-2 text-xs">
								<span class="badge badge-ghost">{ card.Version.AdapterKey }</span>
								<span class="badge badge-ghost">v{ fmt.Sprintf("%d", card.Version.Version) }</span>
								<span class="badge badge-ghost">{ string(card.Automation.HealthState) }</span>
							</div>
							<div class="mt-3 grid grid-cols-2 gap-2 text-xs text-base-content/70">
								<div><span class="block font-medium text-base-content">Last activity</span>{ automationTime(card.LastRun, "Not run") }</div>
								<div><span class="block font-medium text-base-content">Next activity</span>{ automationTime(card.NextRun, "Not scheduled") }</div>
							</div>
							<div class="mt-2 text-xs text-base-content/60">{ fmt.Sprintf("%d linked resources", len(card.Resources)) }</div>
						</div>
					</a>
				}
			</div>
		}
	</div>
}

templ AutomationDefinition(projects []models.Project, currentProjectID string, definition models.AutomationDefinition, resources []models.AutomationResourceSummary) {
	@layout.Base(definition.Automation.Name, projects, currentProjectID) {
		@automationDefinitionContent(definition, resources, currentProjectID)
	}
}

templ AutomationDefinitionContent(definition models.AutomationDefinition, resources []models.AutomationResourceSummary, currentProjectID string) {
	@automationDefinitionContent(definition, resources, currentProjectID)
}

templ automationDefinitionContent(definition models.AutomationDefinition, resources []models.AutomationResourceSummary, currentProjectID string) {
	<div id="automation-definition" class="h-full overflow-y-auto min-w-0 max-w-full">
		@layout.PageTitle(definition.Automation.Name)
		<a class="btn btn-ghost btn-sm mb-3" href={ templ.URL(fmt.Sprintf("/automations?project_id=%s", currentProjectID)) } hx-get={ fmt.Sprintf("/automations?project_id=%s", currentProjectID) } hx-target="#main-content" hx-push-url="true">← Automations</a>
		<div class="mb-5 flex flex-wrap items-start justify-between gap-3">
			<div class="min-w-0">
				<h2 class="break-words text-2xl font-bold">{ definition.Automation.Name }</h2>
				<p class="mt-1 max-w-3xl text-sm text-base-content/65">{ definition.Automation.Description }</p>
			</div>
			<div class="flex flex-wrap gap-2">
				<span class="badge badge-primary badge-outline">{ string(definition.Automation.LifecycleState) }</span>
				<span class="badge badge-ghost">{ definition.Version.AdapterKey }</span>
				<span class="badge badge-ghost">v{ fmt.Sprintf("%d", definition.Version.Version) }</span>
			</div>
		</div>
		<div class="mb-5 rounded-box border border-base-300 bg-base-100 p-4">
			<div class="mb-3 flex items-center justify-between gap-3"><h3 class="font-semibold">Published definition</h3><span class="text-xs text-base-content/60">Read-only</span></div>
			<div class="w-full overflow-x-auto" role="region" aria-label="Automation definition graph">
				<svg viewBox={ fmt.Sprintf("0 0 %d %d", automationGraphWidth(definition.Nodes), automationGraphHeight(definition.Nodes)) } class="min-h-[420px] min-w-[900px] w-full" role="img" aria-label={ definition.Automation.Name + " automation graph" }>
					<defs><marker id="automation-arrow" markerWidth="10" markerHeight="10" refX="8" refY="3" orient="auto"><path d="M0,0 L0,6 L9,3 z" class="fill-base-content/35"></path></marker></defs>
					for _, edge := range definition.Edges {
						if source, target, ok := automationEdgeNodes(definition.Nodes, edge); ok {
							<line x1={ fmt.Sprintf("%.0f", source.PositionX+145) } y1={ fmt.Sprintf("%.0f", source.PositionY+55) } x2={ fmt.Sprintf("%.0f", target.PositionX+15) } y2={ fmt.Sprintf("%.0f", target.PositionY+55) } class="stroke-base-content/35" stroke-width="2" marker-end="url(#automation-arrow)"></line>
						}
					}
					for _, node := range definition.Nodes {
						<a href={ templ.SafeURL("#automation-node-" + node.ID) } aria-label={ node.Name + ", " + string(node.NodeType) }>
							<rect x={ fmt.Sprintf("%.0f", node.PositionX+10) } y={ fmt.Sprintf("%.0f", node.PositionY+20) } width="140" height="70" rx="10" class="fill-base-200 stroke-base-content/25" stroke-width="2"></rect>
							<text x={ fmt.Sprintf("%.0f", node.PositionX+80) } y={ fmt.Sprintf("%.0f", node.PositionY+50) } text-anchor="middle" class="fill-base-content text-[12px] font-semibold">{ automationNodeLabel(node.Name, 20) }</text>
							<text x={ fmt.Sprintf("%.0f", node.PositionX+80) } y={ fmt.Sprintf("%.0f", node.PositionY+70) } text-anchor="middle" class="fill-base-content/60 text-[10px]">{ string(node.NodeType) }</text>
						</a>
					}
				</svg>
			</div>
		</div>
		<div class="grid grid-cols-1 gap-3 lg:grid-cols-2">
			for _, node := range definition.Nodes {
				<div id={ "automation-node-" + node.ID } class="rounded-box border border-base-300 bg-base-100 p-4 min-w-0">
					<div class="flex items-start justify-between gap-3"><div><h3 class="font-semibold">{ node.Name }</h3><p class="text-xs text-base-content/60">{ node.Role }</p></div><span class="badge badge-ghost badge-sm">{ string(node.NodeType) }</span></div>
					<div class="mt-3 space-y-2">
						for _, resource := range resourcesForAutomationNode(resources, node.ID) {
							<a class="flex min-w-0 items-center justify-between gap-3 rounded-lg bg-base-200/60 px-3 py-2 text-sm hover:bg-base-200" href={ templ.URL(resource.URL) }>
								<span class="min-w-0 truncate">{ resource.Name }</span><span class="badge badge-sm shrink-0">{ resource.Status }</span>
							</a>
						}
						if len(resourcesForAutomationNode(resources, node.ID)) == 0 {
							<p class="text-xs text-base-content/50">No definition resource linked.</p>
						}
					</div>
				</div>
			}
		</div>
	</div>
}

func automationCardSearchText(card models.AutomationCard) string { return strings.Join([]string{card.Automation.Name, card.Automation.Description, card.Version.AdapterKey, string(card.Automation.LifecycleState), string(card.Automation.HealthState)}, " ") }
func automationTime(value *time.Time, empty string) string { if value == nil { return empty }; return value.Local().Format("Jan 2, 3:04 PM") }
func automationGraphWidth(nodes []models.AutomationNode) int { max := 900.0; for _, n := range nodes { if n.PositionX+180 > max { max = n.PositionX+180 } }; return int(max) }
func automationGraphHeight(nodes []models.AutomationNode) int { max := 420.0; for _, n := range nodes { if n.PositionY+130 > max { max = n.PositionY+130 } }; return int(max) }
func automationEdgeNodes(nodes []models.AutomationNode, edge models.AutomationEdge) (models.AutomationNode, models.AutomationNode, bool) { var source, target models.AutomationNode; var foundSource, foundTarget bool; for _, n := range nodes { if n.ID == edge.SourceNodeID { source, foundSource = n, true }; if n.ID == edge.TargetNodeID { target, foundTarget = n, true } }; return source, target, foundSource && foundTarget }
func automationNodeLabel(value string, limit int) string { r := []rune(value); if len(r) <= limit { return value }; return string(r[:limit-1]) + "…" }
func resourcesForAutomationNode(resources []models.AutomationResourceSummary, nodeID string) []models.AutomationResourceSummary { var out []models.AutomationResourceSummary; for _, resource := range resources { if resource.NodeID == nodeID { out = append(out, resource) } }; return out }
