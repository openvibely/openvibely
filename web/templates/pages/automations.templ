package pages

import (
	"encoding/json"
	"fmt"
	"strings"
	"time"
	"github.com/openvibely/openvibely/internal/models"
	"github.com/openvibely/openvibely/web/templates/layout"
)

templ Automations(projects []models.Project, currentProjectID string, cards []models.AutomationCard) {
	@layout.Base("Automations", projects, currentProjectID) {
		@automationsContent(cards, currentProjectID)
	}
}

templ AutomationsContent(cards []models.AutomationCard, currentProjectID string) {
	@automationsContent(cards, currentProjectID)
}

templ automationsContent(cards []models.AutomationCard, currentProjectID string) {
	<div id="automations-container" class="h-full overflow-y-auto min-w-0 max-w-full">
		@layout.PageTitle("Automations")
		<div class="mb-6 flex flex-wrap items-start justify-between gap-3">
			<div>
				<h2 class="text-2xl font-bold">Automations</h2>
				<p class="mt-1 text-sm text-base-content/65">Published autonomous processes explicitly created or registered for this project.</p>
			</div>
			<a class="btn btn-primary btn-sm" href={ templ.URL(fmt.Sprintf("/automations/new?project_id=%s", currentProjectID)) } hx-get={ fmt.Sprintf("/automations/new?project_id=%s", currentProjectID) } hx-target="#main-content" hx-push-url="true" onclick="event.preventDefault(); event.stopImmediatePropagation(); window.openVibelyNavigate(this.getAttribute('href')); return false;">New Automation</a>
		</div>
		if len(cards) == 0 {
			<div class="rounded-box bg-base-200/60 p-8 text-center">
				<h3 class="font-semibold">No published automations</h3>
					<p class="mt-2 text-sm text-base-content/65">Create one from Template, Describe It, or Blank. Maintained Native and GitHub setup can also register newly created resources. Existing tasks and schedules are never inferred or backfilled.</p>			</div>
		} else {
			<div class="grid grid-cols-1 gap-4 md:grid-cols-2 xl:grid-cols-3" data-card-search>
				for _, card := range cards {
					<a class="card min-w-0 border border-base-300 bg-base-100 shadow-sm transition hover:border-primary/50 hover:shadow-md" href={ templ.URL(automationCardURL(card, currentProjectID)) } hx-get={ automationCardURL(card, currentProjectID) } hx-target="#main-content" hx-push-url="true" onclick="event.preventDefault(); event.stopImmediatePropagation(); window.openVibelyNavigate(this.getAttribute('href')); return false;" data-search-card data-search-text={ automationCardSearchText(card) }>
						<div class="card-body min-w-0 p-5">
							<div class="flex min-w-0 items-start justify-between gap-3">
								<div class="min-w-0">
									<h3 class="truncate text-lg font-semibold">{ card.Automation.Name }</h3>
									<p class="mt-1 line-clamp-2 text-sm text-base-content/65">{ card.Automation.Description }</p>
								</div>
								<span class="badge badge-primary badge-outline shrink-0">{ string(card.Automation.LifecycleState) }</span>
							</div>
							<div class="mt-3 flex flex-wrap gap-2 text-xs">
								<span class="badge badge-ghost">{ card.Version.AdapterKey }</span>
								<span class="badge badge-ghost">v{ fmt.Sprintf("%d", card.Version.Version) }</span>
								<span class="badge badge-ghost">{ string(card.Automation.HealthState) }</span>
							</div>
							if strings.TrimSpace(card.Automation.HealthReason) != "" {
								<p class="mt-2 line-clamp-2 text-xs text-base-content/65" data-automation-health-reason>{ card.Automation.HealthReason }</p>
							}
							<div class="mt-3 flex flex-wrap gap-1.5 text-xs" aria-label="Operational work summary">
								<span class="badge badge-sm badge-ghost" data-automation-counter="running">{ fmt.Sprintf("%d running", card.Counts.Running) }</span>
								<span class="badge badge-sm badge-ghost" data-automation-counter="waiting">{ fmt.Sprintf("%d waiting", card.Counts.Waiting) }</span>
								<span class="badge badge-sm badge-ghost" data-automation-counter="blocked">{ fmt.Sprintf("%d blocked", card.Counts.Blocked) }</span>
								<span class="badge badge-sm badge-ghost" data-automation-counter="failed">{ fmt.Sprintf("%d failed", card.Counts.Failed) }</span>
								<span class="badge badge-sm badge-ghost" data-automation-counter="recent">{ fmt.Sprintf("%d recent", card.Counts.CompletedRecently) }</span>
							</div>
							<div class="mt-3 grid grid-cols-2 gap-2 text-xs text-base-content/70">
								<div><span class="block font-medium text-base-content">Last activity</span>{ automationTime(card.LastRun, "Not run") }</div>
								<div><span class="block font-medium text-base-content">Next activity</span>{ automationTime(card.NextRun, "Not scheduled") }</div>
							</div>
							<div class="mt-2 text-xs text-base-content/60">{ fmt.Sprintf("%d linked resources", len(card.Resources)) }</div>
						</div>
					</a>
				}
			</div>
		}
	</div>
}

templ AutomationLive(projects []models.Project, currentProjectID string, graph models.AutomationLiveGraph) {
	@layout.Base(graph.Automation.Name, projects, currentProjectID) {
		@automationLiveContent(graph, currentProjectID)
	}
}

templ AutomationLiveContent(graph models.AutomationLiveGraph, currentProjectID string) {
	@automationLiveContent(graph, currentProjectID)
}

templ automationLiveContent(graph models.AutomationLiveGraph, currentProjectID string) {
		<div id="automation-live" class="h-full overflow-y-auto min-w-0 max-w-full" data-automation-id={ graph.Automation.ID } data-project-id={ currentProjectID }
			data-external-refresh-url={ fmt.Sprintf("/automations/%s/refresh-external?project_id=%s", graph.Automation.ID, currentProjectID) }
			hx-get={ fmt.Sprintf("/automations/%s?project_id=%s", graph.Automation.ID, currentProjectID) }		hx-trigger="every 20s [document.visibilityState === 'visible'], automation-visible" hx-target="this" hx-swap="outerHTML">
		@layout.PageTitle(graph.Automation.Name)
		<a class="btn btn-ghost btn-sm mb-3" href={ templ.URL(fmt.Sprintf("/automations?project_id=%s", currentProjectID)) } hx-get={ fmt.Sprintf("/automations?project_id=%s", currentProjectID) } hx-target="#main-content" hx-push-url="true" onclick="event.preventDefault(); event.stopImmediatePropagation(); window.openVibelyNavigate(this.getAttribute('href')); return false;">← Automations</a>
		<div class="mb-5 flex flex-wrap items-start justify-between gap-3">
			<div class="min-w-0"><h2 class="break-words text-2xl font-bold">{ graph.Automation.Name }</h2><p class="mt-1 max-w-3xl text-sm text-base-content/65">{ graph.Automation.Description }</p></div>
			<div class="flex flex-wrap items-center gap-2"><span class="badge badge-primary badge-outline">{ string(graph.Automation.LifecycleState) }</span><span class="badge badge-ghost">{ string(graph.Automation.HealthState) }</span><form method="post" action={ templ.SafeURL(fmt.Sprintf("/automations/%s/drafts?project_id=%s", graph.Automation.ID, currentProjectID)) } hx-post={ fmt.Sprintf("/automations/%s/drafts?project_id=%s", graph.Automation.ID, currentProjectID) } hx-target="#main-content"><input type="hidden" name="project_id" value={ currentProjectID }/><button class="btn btn-outline btn-sm" type="submit">Edit automation</button></form>
				if graph.Automation.LifecycleState == models.AutomationActive {
					<form method="post" action={ templ.SafeURL(fmt.Sprintf("/automations/%s/pause?project_id=%s", graph.Automation.ID, currentProjectID)) }><input type="hidden" name="project_id" value={ currentProjectID }/><button class="btn btn-ghost btn-sm" type="submit">Pause</button></form>
				}
				if graph.Automation.LifecycleState == models.AutomationPaused {
					<form method="post" action={ templ.SafeURL(fmt.Sprintf("/automations/%s/resume?project_id=%s", graph.Automation.ID, currentProjectID)) }><input type="hidden" name="project_id" value={ currentProjectID }/><button class="btn btn-ghost btn-sm" type="submit">Resume</button></form>
				}
				<button class="btn btn-ghost btn-sm text-error" type="button" onclick="document.getElementById('delete-automation-modal').showModal()">Delete</button>
			</div>
		</div>
		@automationViewTabs(graph.Automation.ID, currentProjectID, "live")
		<div class="mb-4 grid grid-cols-2 gap-3 md:grid-cols-4">
			<div class="stat rounded-box bg-base-200/60 p-3"><div class="stat-title text-xs">Active invocations</div><div class="stat-value text-xl">{ fmt.Sprintf("%d", graph.ActiveInvocations) }</div></div>
			<div class="stat rounded-box bg-base-200/60 p-3"><div class="stat-title text-xs">Open work items</div><div class="stat-value text-xl">{ fmt.Sprintf("%d", graph.ActiveWorkItems) }</div></div>
			<div class="stat rounded-box bg-base-200/60 p-3"><div class="stat-title text-xs">Topology</div><div class="stat-value text-sm">v{ fmt.Sprintf("%d", graph.Version.Version) }</div></div>
			<div class="stat rounded-box bg-base-200/60 p-3"><div class="stat-title text-xs">Recent since</div><div class="stat-value text-sm">{ graph.RecentCutoff.Local().Format("Jan 2, 3:04 PM") }</div></div>
		</div>
		if graph.ExternalState.TrackedResources > 0 {
			<div class="mb-4 flex flex-wrap items-center justify-between gap-3 rounded-box border border-base-300 bg-base-100 px-4 py-3" data-automation-external-state>
				<div>
					<div class="flex flex-wrap items-center gap-2"><span class="text-sm font-semibold">GitHub state</span>
						if graph.ExternalState.Stale {
							<span class="badge badge-warning badge-sm">Stale</span>
						} else {
							<span class="badge badge-success badge-sm">Fresh</span>
						}
					</div>
					if graph.ExternalState.LastUpdatedAt != nil {
						<p class="mt-1 text-xs text-base-content/60">Last persisted update { graph.ExternalState.LastUpdatedAt.Local().Format("Jan 2, 3:04 PM") }</p>
					}
				</div>
				<form method="post" action={ templ.SafeURL(fmt.Sprintf("/automations/%s/refresh-external?project_id=%s", graph.Automation.ID, currentProjectID)) } hx-post={ fmt.Sprintf("/automations/%s/refresh-external?project_id=%s", graph.Automation.ID, currentProjectID) } hx-target="#automation-live" hx-swap="outerHTML">
					<input type="hidden" name="project_id" value={ currentProjectID }/>
					<button class="btn btn-outline btn-sm" type="submit">Refresh GitHub state</button>
				</form>
			</div>
		}
		if len(graph.LegacyWork) > 0 {
			<div class="mb-4 rounded-box border border-warning/40 bg-warning/10 px-4 py-3" aria-label="Legacy automation work">
				<h3 class="text-sm font-semibold">Legacy work</h3>
				<div class="mt-2 flex flex-wrap gap-2">
					for _, group := range graph.LegacyWork {
						<span class="badge badge-warning badge-outline">v{ fmt.Sprintf("%d", group.Version) }: { fmt.Sprintf("%d", group.Count) } unmapped</span>
					}
				</div>
			</div>
		}
		<div class="grid min-w-0 grid-cols-1 gap-4 xl:grid-cols-[minmax(0,1fr)_22rem]">
			<div class="rounded-box border border-base-300 bg-base-100 p-4 min-w-0" data-automation-readonly-canvas>
				<div class="mb-3 flex flex-wrap items-start justify-between gap-3">
					<div><h3 class="text-sm font-semibold">Node states</h3><p class="mt-1 text-xs text-base-content/55">A node’s border and label show the highest-priority work state currently present.</p></div>
					<div class="flex gap-2"><button class="btn btn-ghost btn-xs" type="button" data-automation-zoom-out aria-label="Zoom out">−</button><button class="btn btn-ghost btn-xs" type="button" data-automation-zoom-in aria-label="Zoom in">+</button><button class="btn btn-ghost btn-xs" type="button" data-automation-fit>Fit</button></div>
				</div>
				<ul class="mb-3 flex flex-wrap gap-x-4 gap-y-2 text-xs" aria-label="Graph status legend">
					for _, state := range []string{"failed", "blocked", "waiting_human", "running", "recently_completed", "idle"} {
						<li class="inline-flex items-center gap-1.5"><span class={ automationStateDotClass(state) } aria-hidden="true"></span><span>{ automationStateLabel(state) }</span></li>
					}
				</ul>
				<div class="automation-canvas-shell h-[34rem] w-full overflow-hidden rounded-box border border-base-300 bg-base-200/20" role="region" aria-label="Live automation graph">
					<svg data-automation-canvas viewBox={ automationLiveGraphViewBox(graph.Nodes) } class="h-full w-full touch-none select-none" role="img" aria-label={ graph.Automation.Name + " live automation graph" }>
						@automationGraphThemeStyles()
						<defs><marker id="automation-live-arrow" markerWidth="10" markerHeight="10" refX="8" refY="3" orient="auto"><path d="M0,0 L0,6 L9,3 z" class="automation-graph-arrow"></path></marker></defs>
						for _, edge := range graph.Edges {
							if source, target, ok := automationLiveEdgeNodes(graph.Nodes, edge.AutomationEdge); ok {
								<line x1={ fmt.Sprintf("%.0f", automationGraphLayoutX(source.PositionX)+automationGraphNodeWidth) } y1={ fmt.Sprintf("%.0f", automationGraphLayoutY(source.PositionY)+automationGraphNodeHeight/2) } x2={ fmt.Sprintf("%.0f", automationGraphLayoutX(target.PositionX)) } y2={ fmt.Sprintf("%.0f", automationGraphLayoutY(target.PositionY)+automationGraphNodeHeight/2) } class={ templ.KV("automation-graph-edge", true), templ.KV("automation-graph-edge--highlighted", edge.Highlighted) } stroke-width="2" marker-end="url(#automation-live-arrow)" aria-label={ fmt.Sprintf("%s, %d transitions, %d recent", edge.Label, edge.TransitionCount, edge.RecentTransitionCount) }></line>
							}
						}
						for _, node := range graph.Nodes {
							<a class="automation-graph-link" href="#automation-node-resources" tabindex="0" aria-label={ automationLiveNodeAria(node) } hx-get={ fmt.Sprintf("/automations/%s/nodes/%s/resources?project_id=%s", graph.Automation.ID, node.ID, currentProjectID) } hx-target="#automation-node-resources" hx-swap="innerHTML">
								<g transform={ fmt.Sprintf("translate(%.0f %.0f)", automationGraphLayoutX(node.PositionX), automationGraphLayoutY(node.PositionY)) }>
									<rect width={ fmt.Sprintf("%.0f", automationGraphNodeWidth) } height={ fmt.Sprintf("%.0f", automationGraphNodeHeight) } rx="12" class={ automationLiveNodeClass(node.DisplayState) } stroke-width="3"></rect>
									<foreignObject x="0" y="0" width={ fmt.Sprintf("%.0f", automationGraphNodeWidth) } height={ fmt.Sprintf("%.0f", automationGraphNodeHeight) } class="pointer-events-none"><div xmlns="http://www.w3.org/1999/xhtml" class="automation-node-content"><strong>{ node.Name }</strong><span class={ automationStateTextClass(node.DisplayState) }>{ automationStateLabel(node.DisplayState) }</span><small>{ automationNodeCountLabel(node.Counts) }</small></div></foreignObject>
								</g>
							</a>
						}
					</svg>
				</div>
			</div>
				<aside id="automation-node-resources" class="rounded-box border border-base-300 bg-base-100 p-4" aria-live="polite"><h3 class="font-semibold">Node resources</h3><p class="mt-2 text-sm text-base-content/60">Select a node to inspect bounded task, execution, Alert, issue, and pull request links.</p></aside>
			</div>
			<dialog id="delete-automation-modal" class="modal">
				<div class="modal-box">
					@ModalCloseButton("delete-automation-modal", "Close delete automation confirmation")
					<h3 class="pr-10 text-lg font-bold text-error">Delete automation</h3>
					<p class="py-4">Delete <strong>{ graph.Automation.Name }</strong>? This permanently deletes the Automation graph, versions, invocation and work-item history, and publication records.</p>
					<div class="rounded-lg bg-base-200 p-3 text-sm text-base-content/70">Existing tasks and schedules remain. Automation-owned trigger schedules will be disabled. This cannot be undone.</div>
					<div class="modal-action">
						<button class="btn" type="button" onclick="document.getElementById('delete-automation-modal').close()">Cancel</button>
						<form method="post" action={ templ.SafeURL(fmt.Sprintf("/automations/%s/delete?project_id=%s", graph.Automation.ID, currentProjectID)) } hx-post={ fmt.Sprintf("/automations/%s/delete?project_id=%s", graph.Automation.ID, currentProjectID) } hx-swap="none"><input type="hidden" name="project_id" value={ currentProjectID }/><button class="btn btn-error" type="submit">Delete automation</button></form>
					</div>
				</div>
				<form method="dialog" class="modal-backdrop"><button>Cancel</button></form>
			</dialog>
		</div>
		<script>
			(function() {
				if (!window._automationLiveEventBound) {
					window._automationLiveEventBound = true;
					window.addEventListener('sse-automation-event', function(event) {
						var root = document.getElementById('automation-live');
						if (!root || !event.detail) return;
						if (event.detail.project_id && event.detail.project_id !== root.dataset.projectId) return;
						if (event.detail.automation_id && event.detail.automation_id !== root.dataset.automationId) return;
						clearTimeout(window._automationLiveRefreshTimer);
						window._automationLiveRefreshTimer = setTimeout(function() {
							if (document.getElementById('automation-live')) {
								htmx.ajax('GET', root.getAttribute('hx-get'), {target: '#automation-live', swap: 'outerHTML'});
							}
						}, 250);
					});
					document.addEventListener('visibilitychange', function() {
						if (document.visibilityState !== 'visible') return;
						var root = document.getElementById('automation-live');
						if (!root) return;
						if (root.dataset.externalRefreshUrl && root.querySelector('[data-automation-external-state]')) {
							htmx.ajax('POST', root.dataset.externalRefreshUrl, {target: '#automation-live', swap: 'outerHTML'});
							return;
						}
						htmx.trigger(root, 'automation-visible');
					});
				}
				var canvasRoot = document.querySelector('[data-automation-readonly-canvas]');
				var svg = canvasRoot && canvasRoot.querySelector('[data-automation-canvas]');
				if (canvasRoot && svg) {
					var original = svg.getAttribute('viewBox').split(/\s+/).map(Number);
					var box = original.slice();
					var pan = null;
					function apply() { svg.setAttribute('viewBox', box.join(' ')); }
					function point(event) { var value = svg.createSVGPoint(); value.x = event.clientX; value.y = event.clientY; return value.matrixTransform(svg.getScreenCTM().inverse()); }
					function zoom(factor) { var cx=box[0]+box[2]/2, cy=box[1]+box[3]/2; box[2]=Math.max(300,Math.min(4000,box[2]*factor)); box[3]=Math.max(200,Math.min(2500,box[3]*factor)); box[0]=cx-box[2]/2; box[1]=cy-box[3]/2; apply(); }
					svg.addEventListener('wheel', function(event) { if (!event.ctrlKey && !event.metaKey) return; event.preventDefault(); zoom(event.deltaY > 0 ? 1.12 : .88); }, {passive:false});
					svg.addEventListener('pointerdown', function(event) { if (event.target !== svg || event.button !== 0) return; var p=point(event); pan={x:p.x,y:p.y,box:box.slice()}; svg.setPointerCapture(event.pointerId); });
					svg.addEventListener('pointermove', function(event) { if (!pan) return; var p=point(event); box[0]=pan.box[0]+pan.x-p.x; box[1]=pan.box[1]+pan.y-p.y; apply(); });
					svg.addEventListener('pointerup', function(){pan=null;});
					svg.addEventListener('pointercancel', function(){pan=null;});
					canvasRoot.querySelector('[data-automation-zoom-in]').addEventListener('click', function(){zoom(.82);});
					canvasRoot.querySelector('[data-automation-zoom-out]').addEventListener('click', function(){zoom(1.22);});
					canvasRoot.querySelector('[data-automation-fit]').addEventListener('click', function(){box=original.slice();apply();});
				}
			})();
		</script>
}

templ AutomationNodeResources(page models.AutomationNodeResourcePage, projectID, automationID, nodeID string) {
	<h3 class="font-semibold">Node resources</h3>
	if len(page.Items) == 0 {
		<p class="mt-2 text-sm text-base-content/60">No recent runtime resources.</p>
	} else {
		<div class="mt-3 space-y-2">
			for _, resource := range page.Items {
				if resource.URL != "" {
					<a class="block rounded-lg bg-base-200/60 p-3 hover:bg-base-200" href={ templ.URL(resource.URL) } data-automation-node-resource>
						<div class="flex items-start justify-between gap-2"><span class="min-w-0 break-words text-sm font-medium">{ resource.Name }</span><span class="badge badge-sm">{ resource.Status }</span></div>
						<p class="mt-1 text-xs text-base-content/55">{ resource.ResourceType }</p>
					</a>
				} else {
					<div class="rounded-lg bg-base-200/60 p-3" data-automation-node-resource><div class="flex items-start justify-between gap-2"><span class="min-w-0 break-words text-sm font-medium">{ resource.Name }</span><span class="badge badge-sm">{ resource.Status }</span></div><p class="mt-1 text-xs text-base-content/55">{ resource.ResourceType }</p></div>
				}
			}
		</div>
	}
	if page.NextCursor != "" {
		<button class="btn btn-ghost btn-sm mt-3" type="button" hx-get={ fmt.Sprintf("/automations/%s/nodes/%s/resources?project_id=%s&cursor=%s", automationID, nodeID, projectID, page.NextCursor) } hx-target="#automation-node-resources" hx-swap="innerHTML">Next resources</button>
	}
}

func automationGraphLayoutX(value float64) float64 { return value * 1.25 }
func automationGraphLayoutY(value float64) float64 { return value * 1.15 }
func automationLiveGraphViewBox(nodes []models.AutomationLiveNode) string { if len(nodes) == 0 { return "-60 -60 900 540" }; minX, minY := automationGraphLayoutX(nodes[0].PositionX), automationGraphLayoutY(nodes[0].PositionY); maxX, maxY := minX+automationGraphNodeWidth, minY+automationGraphNodeHeight; for _, node := range nodes { x, y := automationGraphLayoutX(node.PositionX), automationGraphLayoutY(node.PositionY); if x < minX { minX = x }; if y < minY { minY = y }; if x+automationGraphNodeWidth > maxX { maxX = x+automationGraphNodeWidth }; if y+automationGraphNodeHeight > maxY { maxY = y+automationGraphNodeHeight } }; return fmt.Sprintf("%.0f %.0f %.0f %.0f", minX-automationGraphPadding, minY-automationGraphPadding, maxX-minX+2*automationGraphPadding, maxY-minY+2*automationGraphPadding) }
func automationLiveEdgeNodes(nodes []models.AutomationLiveNode, edge models.AutomationEdge) (models.AutomationLiveNode, models.AutomationLiveNode, bool) { var source, target models.AutomationLiveNode; var foundSource, foundTarget bool; for _, n := range nodes { if n.ID == edge.SourceNodeID { source, foundSource = n, true }; if n.ID == edge.TargetNodeID { target, foundTarget = n, true } }; return source, target, foundSource && foundTarget }
func automationLiveNodeClass(state string) string { base := "automation-graph-node automation-graph-node--idle"; switch state { case "failed": return "automation-graph-node automation-graph-node--failed"; case "blocked": return "automation-graph-node automation-graph-node--blocked"; case "waiting_human": return "automation-graph-node automation-graph-node--waiting"; case "running": return "automation-graph-node automation-graph-node--running"; case "recently_completed": return "automation-graph-node automation-graph-node--completed" }; return base }
func automationStateLabel(state string) string { return strings.ReplaceAll(strings.Title(strings.ReplaceAll(state, "_", " ")), "Human", "human") }
func automationStateDotClass(state string) string { return "automation-state-dot automation-state-dot--" + strings.ReplaceAll(state, "_human", "") }
func automationStateTextClass(state string) string { return "automation-node-state automation-node-state--" + strings.ReplaceAll(state, "_human", "") }
func automationNodeCountLabel(c models.AutomationNodeCounts) string { values := []string{}; if c.Running > 0 { values = append(values, fmt.Sprintf("%d running", c.Running)) }; if c.Waiting > 0 { values = append(values, fmt.Sprintf("%d waiting", c.Waiting)) }; if c.Blocked > 0 { values = append(values, fmt.Sprintf("%d blocked", c.Blocked)) }; if c.Failed > 0 { values = append(values, fmt.Sprintf("%d failed", c.Failed)) }; if c.CompletedRecently > 0 { values = append(values, fmt.Sprintf("%d recent", c.CompletedRecently)) }; if len(values) == 0 { return "No active work" }; return strings.Join(values, " · ") }
func automationLiveNodeAria(node models.AutomationLiveNode) string { return node.Name + ", " + automationStateLabel(node.DisplayState) + ", " + automationNodeCountLabel(node.Counts) }

templ AutomationDefinition(projects []models.Project, currentProjectID string, definition models.AutomationDefinition, resources []models.AutomationResourceSummary) {
	@layout.Base(definition.Automation.Name, projects, currentProjectID) {
		@automationDefinitionContent(definition, resources, currentProjectID)
	}
}

templ AutomationDefinitionContent(definition models.AutomationDefinition, resources []models.AutomationResourceSummary, currentProjectID string) {
	@automationDefinitionContent(definition, resources, currentProjectID)
}

templ automationDefinitionContent(definition models.AutomationDefinition, resources []models.AutomationResourceSummary, currentProjectID string) {
	<div id="automation-definition" class="h-full overflow-y-auto min-w-0 max-w-full">
		@layout.PageTitle(definition.Automation.Name)
		<a class="btn btn-ghost btn-sm mb-3" href={ templ.URL(fmt.Sprintf("/automations?project_id=%s", currentProjectID)) } hx-get={ fmt.Sprintf("/automations?project_id=%s", currentProjectID) } hx-target="#main-content" hx-push-url="true" onclick="event.preventDefault(); event.stopImmediatePropagation(); window.openVibelyNavigate(this.getAttribute('href')); return false;">← Automations</a>
		<div class="mb-5 flex flex-wrap items-start justify-between gap-3">
			<div class="min-w-0">
				<h2 class="break-words text-2xl font-bold">{ definition.Automation.Name }</h2>
				<p class="mt-1 max-w-3xl text-sm text-base-content/65">{ definition.Automation.Description }</p>
			</div>
				<div class="flex flex-wrap gap-2">
					<span class="badge badge-primary badge-outline">{ string(definition.Automation.LifecycleState) }</span>
					<span class="badge badge-ghost">{ definition.Version.AdapterKey }</span>
					<span class="badge badge-ghost">v{ fmt.Sprintf("%d", definition.Version.Version) }</span>
				</div>
			</div>
			@automationViewTabs(definition.Automation.ID, currentProjectID, "definition")
		<div class="mb-5 rounded-box border border-base-300 bg-base-100 p-4">
			<div class="mb-3 flex items-center justify-between gap-3"><h3 class="font-semibold">Published definition</h3><span class="text-xs text-base-content/60">Read-only</span></div>
			<div class="automation-canvas-shell h-[30rem] w-full overflow-hidden rounded-box border border-base-300 bg-base-200/20" role="region" aria-label="Automation definition graph">
				<svg viewBox={ automationGraphViewBox(definition.Nodes) } class="h-full w-full" role="img" aria-label={ definition.Automation.Name + " automation graph" }>
					@automationGraphThemeStyles()
					<defs><marker id="automation-arrow" markerWidth="10" markerHeight="10" refX="8" refY="3" orient="auto"><path d="M0,0 L0,6 L9,3 z" class="automation-graph-arrow"></path></marker></defs>
					for _, edge := range definition.Edges {
						if source, target, ok := automationEdgeNodes(definition.Nodes, edge); ok {
							<line x1={ fmt.Sprintf("%.0f", automationGraphLayoutX(source.PositionX)+automationGraphNodeWidth) } y1={ fmt.Sprintf("%.0f", automationGraphLayoutY(source.PositionY)+automationGraphNodeHeight/2) } x2={ fmt.Sprintf("%.0f", automationGraphLayoutX(target.PositionX)) } y2={ fmt.Sprintf("%.0f", automationGraphLayoutY(target.PositionY)+automationGraphNodeHeight/2) } class="automation-graph-edge" stroke-width="2" marker-end="url(#automation-arrow)"></line>
						}
					}
					for _, node := range definition.Nodes {
						<a class="automation-graph-link" href={ templ.SafeURL("#automation-node-" + node.ID) } aria-label={ node.Name + ", " + string(node.NodeType) }>
							<g transform={ fmt.Sprintf("translate(%.0f %.0f)", automationGraphLayoutX(node.PositionX), automationGraphLayoutY(node.PositionY)) }><rect width={ fmt.Sprintf("%.0f", automationGraphNodeWidth) } height={ fmt.Sprintf("%.0f", automationGraphNodeHeight) } rx="12" class="automation-graph-node automation-graph-node--idle" stroke-width="2"></rect><foreignObject x="0" y="0" width={ fmt.Sprintf("%.0f", automationGraphNodeWidth) } height={ fmt.Sprintf("%.0f", automationGraphNodeHeight) } class="pointer-events-none"><div xmlns="http://www.w3.org/1999/xhtml" class="automation-node-content"><strong>{ node.Name }</strong><span>{ automationNodeTypeLabel(node.NodeType) }</span></div></foreignObject></g>
						</a>
					}
				</svg>
			</div>
		</div>
		<div class="grid grid-cols-1 gap-3 lg:grid-cols-2">
			for _, node := range definition.Nodes {
				<div id={ "automation-node-" + node.ID } class="rounded-box border border-base-300 bg-base-100 p-4 min-w-0">
					<div class="flex items-start justify-between gap-3"><div><h3 class="font-semibold">{ node.Name }</h3><p class="text-xs text-base-content/60">{ node.Role }</p></div><span class="badge badge-ghost badge-sm">{ string(node.NodeType) }</span></div>
					<div class="mt-3 space-y-2">
						for _, resource := range resourcesForAutomationNode(resources, node.ID) {
							<a class="flex min-w-0 items-center justify-between gap-3 rounded-lg bg-base-200/60 px-3 py-2 text-sm hover:bg-base-200" href={ templ.URL(resource.URL) }>
								<span class="min-w-0 truncate">{ resource.Name }</span><span class="badge badge-sm shrink-0">{ resource.Status }</span>
							</a>
						}
						if len(resourcesForAutomationNode(resources, node.ID)) == 0 {
							<p class="text-xs text-base-content/50">No definition resource linked.</p>
						}
					</div>
				</div>
			}
		</div>
	</div>
}

templ AutomationHistory(projects []models.Project, currentProjectID string, dashboard models.AutomationHistoryDashboard, workItemStatus string) {
	@layout.Base(dashboard.Automation.Name+" History", projects, currentProjectID) {
		@automationHistoryContent(dashboard, currentProjectID, workItemStatus)
	}
}

templ AutomationHistoryContent(dashboard models.AutomationHistoryDashboard, currentProjectID string, workItemStatus string) {
	@automationHistoryContent(dashboard, currentProjectID, workItemStatus)
}

templ automationHistoryContent(dashboard models.AutomationHistoryDashboard, currentProjectID string, workItemStatus string) {
	<div id="automation-history" class="h-full overflow-y-auto min-w-0 max-w-full" data-automation-metrics={ templ.JSONString(automationMetricsJSON(dashboard.Metrics)) }>
		@layout.PageTitle(dashboard.Automation.Name + " History")
		<a class="btn btn-ghost btn-sm mb-3" href={ templ.URL(fmt.Sprintf("/automations?project_id=%s", currentProjectID)) } hx-get={ fmt.Sprintf("/automations?project_id=%s", currentProjectID) } hx-target="#main-content" hx-push-url="true" onclick="event.preventDefault(); event.stopImmediatePropagation(); window.openVibelyNavigate(this.getAttribute('href')); return false;">← Automations</a>
			<div class="mb-5 flex flex-wrap items-start justify-between gap-3">
				<div><h2 class="text-2xl font-bold">{ dashboard.Automation.Name }</h2><p class="mt-1 text-sm text-base-content/65">Persisted invocation and work-item history.</p></div>
				<span class={ automationHealthBadgeClass(dashboard.Health.State) }>{ string(dashboard.Health.State) }</span>
			</div>
			@automationViewTabs(dashboard.Automation.ID, currentProjectID, "history")
		<div class="mb-5 rounded-box border border-base-300 bg-base-100 p-4">
			<div class="flex flex-wrap items-start justify-between gap-3"><div><h3 class="font-semibold">Automation health</h3><p class="mt-1 text-sm text-base-content/65">{ dashboard.Health.Reason }</p></div><span class="text-xs text-base-content/55">Evaluated { dashboard.Health.EvaluatedAt.Local().Format("Jan 2, 3:04 PM") }</span></div>
		</div>
		<div class="mb-5 grid grid-cols-1 gap-4 xl:grid-cols-2">
			<div class="rounded-box border border-base-300 bg-base-100 p-4"><h3 class="font-semibold">Conversion funnel</h3><p class="mt-1 text-xs text-base-content/55">Entered work items relative to the first node with a persisted entry.</p><div class="mt-3 h-72"><canvas id="automation-funnel-chart" aria-label="Automation conversion funnel"></canvas></div></div>
			<div class="rounded-box border border-base-300 bg-base-100 p-4"><h3 class="font-semibold">Average node duration</h3><p class="mt-1 text-xs text-base-content/55">First entry into a node until the next persisted transition for the same work item.</p><div class="mt-3 h-72"><canvas id="automation-duration-chart" aria-label="Average automation node duration"></canvas></div></div>
		</div>
			<div class="mb-5 grid grid-cols-1 gap-4 xl:grid-cols-2">
				<div class="rounded-box border border-base-300 bg-base-100 p-4">
					<h3 class="font-semibold">Recent failures</h3>
					if len(dashboard.Metrics.Failures) == 0 {
						<p class="mt-2 text-sm text-base-content/55">No persisted failures in the last 30 days.</p>
					} else {
						<div class="mt-3 space-y-2">
							for _, failure := range dashboard.Metrics.Failures {
								<div class="flex items-center justify-between gap-3 rounded-lg bg-base-200/60 px-3 py-2 text-sm"><span>{ failure.NodeName }</span><span class="badge badge-error badge-outline">{ fmt.Sprintf("%d", failure.Count) }</span></div>
							}
						</div>
					}
				</div>
				<div class="rounded-box border border-base-300 bg-base-100 p-4">
					<h3 class="font-semibold">Current bottlenecks</h3>
					if len(dashboard.Metrics.Bottlenecks) == 0 {
						<p class="mt-2 text-sm text-base-content/55">No waiting or blocked positions.</p>
					} else {
						<div class="mt-3 space-y-2">
							for _, item := range dashboard.Metrics.Bottlenecks {
								<div class="flex items-center justify-between gap-3 rounded-lg bg-base-200/60 px-3 py-2 text-sm"><span>{ item.NodeName }</span><span class="text-xs">{ fmt.Sprintf("%d waiting · %d blocked", item.Waiting, item.Blocked) }</span></div>
							}
						</div>
					}
				</div>
			</div>
			<div class="grid grid-cols-1 gap-5 xl:grid-cols-2">
				<section class="rounded-box border border-base-300 bg-base-100 p-4"><h3 class="font-semibold">Invocations</h3>
					if len(dashboard.Invocations.Items) == 0 {
						<p class="mt-2 text-sm text-base-content/55">No invocation history.</p>
					} else {
						<div class="mt-3 space-y-2">
							for _, invocation := range dashboard.Invocations.Items {
								<a class="block rounded-lg bg-base-200/60 p-3 hover:bg-base-200" href={ templ.URL(fmt.Sprintf("/automations/%s/invocations/%s?project_id=%s", dashboard.Automation.ID, invocation.ID, currentProjectID)) } hx-get={ fmt.Sprintf("/automations/%s/invocations/%s?project_id=%s", dashboard.Automation.ID, invocation.ID, currentProjectID) } hx-target="#main-content" hx-push-url="true" onclick="event.preventDefault(); event.stopImmediatePropagation(); window.openVibelyNavigate(this.getAttribute('href')); return false;"><div class="flex items-center justify-between gap-3"><span class="text-sm font-medium">{ automationInvocationLabel(invocation) }</span><span class="badge badge-sm">{ string(invocation.Status) }</span></div><p class="mt-1 text-xs text-base-content/55">{ automationInvocationHistoryTime(invocation).Local().Format("Jan 2, 3:04 PM") }</p></a>
							}
						</div>
					}
					if dashboard.Invocations.NextCursor != "" {
						<a class="btn btn-ghost btn-sm mt-3" href={ templ.URL(fmt.Sprintf("/automations/%s/history?project_id=%s&invocation_cursor=%s", dashboard.Automation.ID, currentProjectID, dashboard.Invocations.NextCursor)) } hx-get={ fmt.Sprintf("/automations/%s/history?project_id=%s&invocation_cursor=%s", dashboard.Automation.ID, currentProjectID, dashboard.Invocations.NextCursor) } hx-target="#main-content" hx-push-url="true" onclick="event.preventDefault(); event.stopImmediatePropagation(); window.openVibelyNavigate(this.getAttribute('href')); return false;">Next invocations</a>
					}
			</section>
				<section class="rounded-box border border-base-300 bg-base-100 p-4">
					<div class="flex flex-wrap items-center justify-between gap-3">
						<h3 class="font-semibold">Work items</h3>
						<form method="get" action={ templ.SafeURL(fmt.Sprintf("/automations/%s/history", dashboard.Automation.ID)) } hx-get={ fmt.Sprintf("/automations/%s/history", dashboard.Automation.ID) } hx-target="#main-content" hx-push-url="true" class="flex gap-2">
							<input type="hidden" name="project_id" value={ currentProjectID }/>
							<select name="work_item_status" class="select select-bordered select-xs">
								<option value="" selected?={ workItemStatus == "" }>All states</option>
								for _, state := range []string{"active", "waiting", "blocked", "failed", "completed", "cancelled"} {
									<option value={ state } selected?={ workItemStatus == state }>{ state }</option>
								}
							</select>
							<button class="btn btn-ghost btn-xs" type="submit">Filter</button>
						</form>
					</div>
					if len(dashboard.WorkItems.Items) == 0 {
						<p class="mt-2 text-sm text-base-content/55">No work-item history.</p>
					} else {
						<div class="mt-3 space-y-2">
							for _, item := range dashboard.WorkItems.Items {
								<a class="block rounded-lg bg-base-200/60 p-3 hover:bg-base-200" href={ templ.URL(fmt.Sprintf("/automations/%s/work-items/%s?project_id=%s", dashboard.Automation.ID, item.ID, currentProjectID)) } hx-get={ fmt.Sprintf("/automations/%s/work-items/%s?project_id=%s", dashboard.Automation.ID, item.ID, currentProjectID) } hx-target="#main-content" hx-push-url="true" onclick="event.preventDefault(); event.stopImmediatePropagation(); window.openVibelyNavigate(this.getAttribute('href')); return false;"><div class="flex items-center justify-between gap-3"><span class="min-w-0 break-words text-sm font-medium">{ automationWorkItemLabel(item) }</span><span class="badge badge-sm">{ string(item.Status) }</span></div><p class="mt-1 text-xs text-base-content/55">Started { item.CreatedAt.Local().Format("Jan 2, 3:04 PM") }</p></a>
							}
						</div>
					}
					if dashboard.WorkItems.NextCursor != "" {
						<a class="btn btn-ghost btn-sm mt-3" href={ templ.URL(fmt.Sprintf("/automations/%s/history?project_id=%s&work_item_status=%s&work_item_cursor=%s", dashboard.Automation.ID, currentProjectID, workItemStatus, dashboard.WorkItems.NextCursor)) } hx-get={ fmt.Sprintf("/automations/%s/history?project_id=%s&work_item_status=%s&work_item_cursor=%s", dashboard.Automation.ID, currentProjectID, workItemStatus, dashboard.WorkItems.NextCursor) } hx-target="#main-content" hx-push-url="true" onclick="event.preventDefault(); event.stopImmediatePropagation(); window.openVibelyNavigate(this.getAttribute('href')); return false;">Next work items</a>
					}
				</section>		</div>
	</div>
	<script>
		(function() {
			function destroyAutomationHistoryCharts() { var charts = window._automationHistoryCharts || {}; Object.keys(charts).forEach(function(key) { if (charts[key]) charts[key].destroy(); }); window._automationHistoryCharts = {}; }
			function loadAutomationChartJS() { if (window.Chart) return Promise.resolve(); if (window._automationChartLoader) return window._automationChartLoader; window._automationChartLoader = new Promise(function(resolve, reject) { var script = document.createElement('script'); script.src = 'https://cdn.jsdelivr.net/npm/chart.js@4.4.1/dist/chart.umd.min.js'; script.onload = resolve; script.onerror = reject; document.head.appendChild(script); }); return window._automationChartLoader; }
			function automationChartTheme(root) {
				var textColor = getComputedStyle(root).color || 'rgb(148, 163, 184)';
				var channels = textColor.match(/[\d.]+/g) || [];
				var gridColor = channels.length >= 3 ? 'rgba(' + channels.slice(0, 3).join(',') + ',0.16)' : textColor;
				return { text: textColor, grid: gridColor };
			}
			function initAutomationHistoryCharts() {
				var root = document.getElementById('automation-history');
				if (!root) return;
				var metrics = {};
				try { metrics = JSON.parse(root.dataset.automationMetrics || '{}'); } catch (_) { return; }
				loadAutomationChartJS().then(function() {
					if (!document.getElementById('automation-history')) return;
					destroyAutomationHistoryCharts();
					var charts = window._automationHistoryCharts;
					var theme = automationChartTheme(root);
					var funnel = metrics.funnel || [];
					var durations = metrics.durations || [];
					var funnelCanvas = document.getElementById('automation-funnel-chart');
					var durationCanvas = document.getElementById('automation-duration-chart');
					var legend = { position: 'bottom', labels: { color: theme.text } };
					if (funnelCanvas) charts.funnel = new Chart(funnelCanvas.getContext('2d'), {
						type: 'bar',
						data: { labels: funnel.map(function(p) { return p.node_name; }), datasets: [{ label: 'Conversion %', data: funnel.map(function(p) { return p.conversion_percent; }), backgroundColor: 'rgba(59,130,246,.5)', borderColor: 'rgb(59,130,246)', borderWidth: 1 }] },
						options: { responsive: true, maintainAspectRatio: false, scales: { x: { ticks: { color: theme.text }, grid: { color: theme.grid } }, y: { beginAtZero: true, max: 100, ticks: { color: theme.text }, grid: { color: theme.grid } } }, plugins: { legend: legend } }
					});
					if (durationCanvas) charts.duration = new Chart(durationCanvas.getContext('2d'), {
						type: 'bar',
						data: { labels: durations.map(function(p) { return p.node_name; }), datasets: [{ label: 'Average seconds', data: durations.map(function(p) { return p.average_seconds; }), backgroundColor: 'rgba(20,184,166,.5)', borderColor: 'rgb(20,184,166)', borderWidth: 1 }] },
						options: { indexAxis: 'y', responsive: true, maintainAspectRatio: false, scales: { x: { beginAtZero: true, ticks: { color: theme.text }, grid: { color: theme.grid } }, y: { ticks: { color: theme.text }, grid: { color: theme.grid } } }, plugins: { legend: legend } }
					});
				}).catch(function() {});
			}
			window.initAutomationHistoryCharts = initAutomationHistoryCharts;
			if (!window._automationHistoryCleanupBound) { window._automationHistoryCleanupBound = true; document.body.addEventListener('htmx:beforeSwap', function(event) { var target = event.detail && event.detail.target; if (target && (target.id === 'main-content' || target.id === 'automation-history' || (target.querySelector && target.querySelector('#automation-history')))) destroyAutomationHistoryCharts(); }); }
			initAutomationHistoryCharts();
		})();
	</script>
}

templ AutomationInvocationHistory(projects []models.Project, currentProjectID string, history models.AutomationInvocationHistory) {
	@layout.Base(history.Definition.Automation.Name+" Invocation", projects, currentProjectID) {
		@automationInvocationHistoryContent(history, currentProjectID)
	}
}

templ AutomationInvocationHistoryContent(history models.AutomationInvocationHistory, currentProjectID string) {
	@automationInvocationHistoryContent(history, currentProjectID)
}

templ automationInvocationHistoryContent(history models.AutomationInvocationHistory, currentProjectID string) {
	<div id="automation-invocation-history" class="h-full overflow-y-auto min-w-0 max-w-full">
		@layout.PageTitle(history.Definition.Automation.Name + " Invocation")
		<a class="btn btn-ghost btn-sm mb-3" href={ templ.URL(fmt.Sprintf("/automations/%s/history?project_id=%s", history.Definition.Automation.ID, currentProjectID)) } hx-get={ fmt.Sprintf("/automations/%s/history?project_id=%s", history.Definition.Automation.ID, currentProjectID) } hx-target="#main-content" hx-push-url="true" onclick="event.preventDefault(); event.stopImmediatePropagation(); window.openVibelyNavigate(this.getAttribute('href')); return false;">← History</a>
		<div class="mb-5 flex flex-wrap items-start justify-between gap-3"><div><h2 class="text-2xl font-bold">Invocation</h2><p class="mt-1 text-sm text-base-content/60">{ automationInvocationLabel(history.Invocation) } · topology v{ fmt.Sprintf("%d", history.Definition.Version.Version) }</p></div><span class="badge">{ string(history.Invocation.Status) }</span></div>
		<div class="mb-5 rounded-box border border-base-300 bg-base-100 p-4">
			<h3 class="font-semibold">Invocation graph</h3><p class="mt-1 text-xs text-base-content/55">Immutable topology with nodes touched only by this occurrence highlighted.</p>
			<div class="mt-3 automation-canvas-shell h-[30rem] w-full overflow-hidden rounded-box border border-base-300 bg-base-200/20">
				<svg viewBox={ automationGraphViewBox(history.Definition.Nodes) } class="h-full w-full" role="img" aria-label="Invocation graph">
					@automationGraphThemeStyles()
					for _, edge := range history.Definition.Edges {
						if source, target, ok := automationEdgeNodes(history.Definition.Nodes, edge); ok {
							<line x1={ fmt.Sprintf("%.0f", automationGraphLayoutX(source.PositionX)+automationGraphNodeWidth) } y1={ fmt.Sprintf("%.0f", automationGraphLayoutY(source.PositionY)+automationGraphNodeHeight/2) } x2={ fmt.Sprintf("%.0f", automationGraphLayoutX(target.PositionX)) } y2={ fmt.Sprintf("%.0f", automationGraphLayoutY(target.PositionY)+automationGraphNodeHeight/2) } class="automation-graph-edge" stroke-width="2"></line>
						}
					}
					for _, node := range history.Definition.Nodes {
						<g transform={ fmt.Sprintf("translate(%.0f %.0f)", automationGraphLayoutX(node.PositionX), automationGraphLayoutY(node.PositionY)) }><rect width={ fmt.Sprintf("%.0f", automationGraphNodeWidth) } height={ fmt.Sprintf("%.0f", automationGraphNodeHeight) } rx="12" class={ automationInvocationNodeClass(history, node.ID) } stroke-width="3"></rect><foreignObject x="0" y="0" width={ fmt.Sprintf("%.0f", automationGraphNodeWidth) } height={ fmt.Sprintf("%.0f", automationGraphNodeHeight) } class="pointer-events-none"><div xmlns="http://www.w3.org/1999/xhtml" class="automation-node-content"><strong>{ node.Name }</strong><span>{ automationNodeTypeLabel(node.NodeType) }</span></div></foreignObject></g>
					}
				</svg>
			</div>
		</div>
		<div class="grid grid-cols-1 gap-5 xl:grid-cols-2">
				<section class="rounded-box border border-base-300 bg-base-100 p-4">
					<h3 class="font-semibold">Occurrence activities</h3>
					if len(history.Activities.Items) == 0 {
						<p class="mt-2 text-sm text-base-content/55">No activities for this occurrence.</p>
					} else {
						<div class="mt-3 space-y-2">
							for _, activity := range history.Activities.Items {
								<div class="rounded-lg bg-base-200/60 p-3"><div class="flex justify-between gap-3"><span class="text-sm font-medium">{ activity.ActivityType }</span><span class="badge badge-sm">{ string(activity.Status) }</span></div><p class="mt-1 text-xs text-base-content/55">{ activity.StartedAt.Local().Format("Jan 2, 3:04 PM") }</p></div>
							}
						</div>
					}
					if history.Activities.NextCursor != "" {
						<a class="btn btn-ghost btn-sm mt-3" href={ templ.URL(fmt.Sprintf("/automations/%s/invocations/%s?project_id=%s&activity_cursor=%s", history.Definition.Automation.ID, history.Invocation.ID, currentProjectID, history.Activities.NextCursor)) } hx-get={ fmt.Sprintf("/automations/%s/invocations/%s?project_id=%s&activity_cursor=%s", history.Definition.Automation.ID, history.Invocation.ID, currentProjectID, history.Activities.NextCursor) } hx-target="#main-content" hx-push-url="true" onclick="event.preventDefault(); event.stopImmediatePropagation(); window.openVibelyNavigate(this.getAttribute('href')); return false;">Next activities</a>
					}
				</section>
			<section class="rounded-box border border-base-300 bg-base-100 p-4">
				<h3 class="font-semibold">Occurrence transitions</h3>
				@automationTransitionTimeline(history.Transitions.Items, history.Definition.Nodes)
				if history.Transitions.NextCursor != "" {
					<a class="btn btn-ghost btn-sm mt-3" href={ templ.URL(fmt.Sprintf("/automations/%s/invocations/%s?project_id=%s&cursor=%s", history.Definition.Automation.ID, history.Invocation.ID, currentProjectID, history.Transitions.NextCursor)) } hx-get={ fmt.Sprintf("/automations/%s/invocations/%s?project_id=%s&cursor=%s", history.Definition.Automation.ID, history.Invocation.ID, currentProjectID, history.Transitions.NextCursor) } hx-target="#main-content" hx-push-url="true" onclick="event.preventDefault(); event.stopImmediatePropagation(); window.openVibelyNavigate(this.getAttribute('href')); return false;">Next transitions</a>
				}
			</section>
		</div>
	</div>
}

templ AutomationWorkItemHistory(projects []models.Project, currentProjectID string, history models.AutomationWorkItemHistory) {
	@layout.Base(history.Definition.Automation.Name+" Work Item", projects, currentProjectID) {
		@automationWorkItemHistoryContent(history, currentProjectID)
	}
}

templ AutomationWorkItemHistoryContent(history models.AutomationWorkItemHistory, currentProjectID string) {
	@automationWorkItemHistoryContent(history, currentProjectID)
}

templ automationWorkItemHistoryContent(history models.AutomationWorkItemHistory, currentProjectID string) {
	<div id="automation-work-item-history" class="h-full overflow-y-auto min-w-0 max-w-full" data-replay={ templ.JSONString(automationReplayJSON(history.Replay)) }>
		@layout.PageTitle(history.Definition.Automation.Name + " Work Item")
		<a class="btn btn-ghost btn-sm mb-3" href={ templ.URL(fmt.Sprintf("/automations/%s/history?project_id=%s", history.Definition.Automation.ID, currentProjectID)) } hx-get={ fmt.Sprintf("/automations/%s/history?project_id=%s", history.Definition.Automation.ID, currentProjectID) } hx-target="#main-content" hx-push-url="true" onclick="event.preventDefault(); event.stopImmediatePropagation(); window.openVibelyNavigate(this.getAttribute('href')); return false;">← History</a>
		<div class="mb-5 flex flex-wrap items-start justify-between gap-3"><div><h2 class="break-words text-2xl font-bold">{ automationWorkItemLabel(history.WorkItem) }</h2><p class="mt-1 text-sm text-base-content/60">Cross-invocation lifetime · topology v{ fmt.Sprintf("%d", history.Definition.Version.Version) }</p></div><span class="badge">{ string(history.WorkItem.Status) }</span></div>
		<div class="mb-5 rounded-box border border-base-300 bg-base-100 p-4">
			<div class="flex flex-wrap items-center justify-between gap-3">
				<div><h3 class="font-semibold">Transition replay</h3><p class="mt-1 text-xs text-base-content/55">Frames come only from append-only persisted transitions.</p></div>
				if len(history.Replay) > 0 {
					<span id="automation-replay-label" class="text-xs text-base-content/60"></span>
				}
			</div>
			if len(history.Replay) == 0 {
				<p class="mt-3 text-sm text-base-content/55">No transitions to replay.</p>
			} else {
				<input id="automation-replay-slider" class="range range-primary range-sm mt-4" type="range" min="0" max={ fmt.Sprintf("%d", len(history.Replay)-1) } value="0" aria-label="Replay transition"/>
				<div class="mt-3 automation-canvas-shell h-[30rem] w-full overflow-hidden rounded-box border border-base-300 bg-base-200/20">
					<svg viewBox={ automationGraphViewBox(history.Definition.Nodes) } class="h-full w-full" role="img" aria-label="Work item transition replay">
						@automationGraphThemeStyles()
						for _, edge := range history.Definition.Edges {
							if source, target, ok := automationEdgeNodes(history.Definition.Nodes, edge); ok {
								<line x1={ fmt.Sprintf("%.0f", automationGraphLayoutX(source.PositionX)+automationGraphNodeWidth) } y1={ fmt.Sprintf("%.0f", automationGraphLayoutY(source.PositionY)+automationGraphNodeHeight/2) } x2={ fmt.Sprintf("%.0f", automationGraphLayoutX(target.PositionX)) } y2={ fmt.Sprintf("%.0f", automationGraphLayoutY(target.PositionY)+automationGraphNodeHeight/2) } class="automation-graph-edge" stroke-width="2"></line>
							}
						}
						for _, node := range history.Definition.Nodes {
							<g transform={ fmt.Sprintf("translate(%.0f %.0f)", automationGraphLayoutX(node.PositionX), automationGraphLayoutY(node.PositionY)) }><rect data-replay-node={ node.ID } width={ fmt.Sprintf("%.0f", automationGraphNodeWidth) } height={ fmt.Sprintf("%.0f", automationGraphNodeHeight) } rx="12" class="automation-graph-node automation-graph-node--idle" stroke-width="3"></rect><foreignObject x="0" y="0" width={ fmt.Sprintf("%.0f", automationGraphNodeWidth) } height={ fmt.Sprintf("%.0f", automationGraphNodeHeight) } class="pointer-events-none"><div xmlns="http://www.w3.org/1999/xhtml" class="automation-node-content"><strong>{ node.Name }</strong><span>{ automationNodeTypeLabel(node.NodeType) }</span></div></foreignObject></g>
						}
					</svg>
				</div>
			}
		</div>
		<div class="grid grid-cols-1 gap-5 xl:grid-cols-2">
				<section class="rounded-box border border-base-300 bg-base-100 p-4">
					<h3 class="font-semibold">Activities across invocations</h3>
					if len(history.Activities.Items) == 0 {
						<p class="mt-2 text-sm text-base-content/55">No activities.</p>
					} else {
						<div class="mt-3 space-y-2">
							for _, activity := range history.Activities.Items {
								<div class="rounded-lg bg-base-200/60 p-3"><div class="flex justify-between gap-3"><span class="text-sm font-medium">{ activity.ActivityType }</span><span class="badge badge-sm">{ string(activity.Status) }</span></div><p class="mt-1 text-xs text-base-content/55">{ activity.StartedAt.Local().Format("Jan 2, 3:04 PM") }</p></div>
							}
						</div>
					}
					if history.Activities.NextCursor != "" {
						<a class="btn btn-ghost btn-sm mt-3" href={ templ.URL(fmt.Sprintf("/automations/%s/work-items/%s?project_id=%s&activity_cursor=%s", history.Definition.Automation.ID, history.WorkItem.ID, currentProjectID, history.Activities.NextCursor)) } hx-get={ fmt.Sprintf("/automations/%s/work-items/%s?project_id=%s&activity_cursor=%s", history.Definition.Automation.ID, history.WorkItem.ID, currentProjectID, history.Activities.NextCursor) } hx-target="#main-content" hx-push-url="true" onclick="event.preventDefault(); event.stopImmediatePropagation(); window.openVibelyNavigate(this.getAttribute('href')); return false;">Next activities</a>
					}
				</section>
			<section class="rounded-box border border-base-300 bg-base-100 p-4">
				<h3 class="font-semibold">Transition timeline</h3>
				@automationTransitionTimeline(history.Transitions.Items, history.Definition.Nodes)
				if history.Transitions.NextCursor != "" {
					<a class="btn btn-ghost btn-sm mt-3" href={ templ.URL(fmt.Sprintf("/automations/%s/work-items/%s?project_id=%s&cursor=%s", history.Definition.Automation.ID, history.WorkItem.ID, currentProjectID, history.Transitions.NextCursor)) } hx-get={ fmt.Sprintf("/automations/%s/work-items/%s?project_id=%s&cursor=%s", history.Definition.Automation.ID, history.WorkItem.ID, currentProjectID, history.Transitions.NextCursor) } hx-target="#main-content" hx-push-url="true" onclick="event.preventDefault(); event.stopImmediatePropagation(); window.openVibelyNavigate(this.getAttribute('href')); return false;">Next transitions</a>
				}
			</section>
		</div>
	</div>
	<script>
		(function() { var root = document.getElementById('automation-work-item-history'); if (!root) return; var frames = []; try { frames = JSON.parse(root.dataset.replay || '[]'); } catch (_) {} var slider = document.getElementById('automation-replay-slider'); var label = document.getElementById('automation-replay-label'); function nodeClass(state) { if (state === 'failed') return 'automation-graph-node automation-graph-node--failed'; if (state === 'blocked') return 'automation-graph-node automation-graph-node--blocked'; if (state === 'waiting') return 'automation-graph-node automation-graph-node--waiting'; if (state === 'active') return 'automation-graph-node automation-graph-node--running'; return 'automation-graph-node automation-graph-node--idle'; } function render(index) { var frame = frames[index]; if (!frame) return; var states = {}; (frame.positions || []).forEach(function(p) { states[p.node_id] = p.state; }); root.querySelectorAll('[data-replay-node]').forEach(function(node) { node.setAttribute('class', nodeClass(states[node.dataset.replayNode] || '')); }); if (label) label.textContent = (index + 1) + ' / ' + frames.length + ' · ' + frame.state; } if (slider) { slider.addEventListener('input', function() { render(Number(slider.value)); }); render(0); } })();
	</script>
}

templ automationTransitionTimeline(transitions []models.AutomationTransition, nodes []models.AutomationNode) {
	if len(transitions) == 0 {
		<p class="mt-2 text-sm text-base-content/55">No transitions.</p>
	} else {
		<ol class="mt-3 space-y-3">
			for _, transition := range transitions {
				<li class="border-l-2 border-base-300 pl-3"><div class="flex flex-wrap items-center justify-between gap-2"><span class="text-sm font-medium">{ automationNodeName(nodes, transition.ToNodeID) }</span><span class="badge badge-sm">{ string(transition.State) }</span></div><p class="mt-1 text-xs text-base-content/55">{ transition.OccurredAt.Local().Format("Jan 2, 3:04:05 PM") }</p></li>
			}
		</ol>
	}
}

templ AutomationNew(projects []models.Project, currentProjectID string) {
	@layout.Base("New Automation", projects, currentProjectID) {
		@automationNewContent(currentProjectID, "")
	}
}

templ AutomationNewFailure(projects []models.Project, currentProjectID string, errorMessage string) {
	@layout.Base("New Automation", projects, currentProjectID) {
		@automationNewContent(currentProjectID, errorMessage)
	}
}

templ AutomationNewContent(currentProjectID string) {
	@automationNewContent(currentProjectID, "")
}

templ AutomationNewFailureContent(currentProjectID string, errorMessage string) {
	@automationNewContent(currentProjectID, errorMessage)
}

templ automationNewContent(currentProjectID string, errorMessage string) {
	<div id="automation-new" class="h-full overflow-y-auto min-w-0 max-w-full">
		@layout.PageTitle("New Automation")
		<a class="btn btn-ghost btn-sm mb-3" href={ templ.URL(fmt.Sprintf("/automations?project_id=%s", currentProjectID)) } hx-get={ fmt.Sprintf("/automations?project_id=%s", currentProjectID) } hx-target="#main-content" hx-push-url="true" onclick="event.preventDefault(); event.stopImmediatePropagation(); window.openVibelyNavigate(this.getAttribute('href')); return false;">← Automations</a>
		<div class="mb-6"><h2 class="text-2xl font-bold">New Automation</h2><p class="mt-1 text-sm text-base-content/65">Choose one explicit creation path. Existing tasks and schedules are never discovered or registered from this page.</p></div>
		if errorMessage != "" {
			<div class="alert alert-error mb-4" role="alert"><span>{ errorMessage }</span></div>
		}
		<div class="grid grid-cols-1 gap-4 lg:grid-cols-3">
			<section class="rounded-box border border-base-300 bg-base-100 p-5"><h3 class="text-lg font-semibold">Template</h3><p class="mt-1 text-sm text-base-content/60">Start from a maintained supported topology.</p><form method="post" action={ templ.SafeURL(fmt.Sprintf("/automations/drafts?project_id=%s", currentProjectID)) } hx-post={ fmt.Sprintf("/automations/drafts?project_id=%s", currentProjectID) } hx-target="#main-content" class="mt-4 space-y-3"><input type="hidden" name="project_id" value={ currentProjectID }/><input type="hidden" name="source" value="template"/><select name="template_key" class="select select-bordered w-full" aria-label="Automation template"><option value="native_sdlc">Native SDLC</option><option value="github_sdlc">GitHub SDLC</option><option value="vision_driver">Vision Driver</option></select><button class="btn btn-primary w-full" type="submit">Use template</button></form></section>
			<section class="rounded-box border border-base-300 bg-base-100 p-5"><h3 class="text-lg font-semibold">Describe It</h3><p class="mt-1 text-sm text-base-content/60">Generate a design through the shared safe schema. Nothing runs yet.</p><form method="post" action={ templ.SafeURL(fmt.Sprintf("/automations/drafts?project_id=%s", currentProjectID)) } hx-post={ fmt.Sprintf("/automations/drafts?project_id=%s", currentProjectID) } hx-target="#main-content" hx-indicator="#automation-describe-loading" hx-disabled-elt="button" class="mt-4 space-y-3"><input type="hidden" name="project_id" value={ currentProjectID }/><input type="hidden" name="source" value="describe"/><textarea name="description" class="textarea textarea-bordered h-32 w-full" maxlength="4000" required placeholder="Review project vision daily, request approval, then create implementation work."></textarea><button class="btn btn-primary w-full" type="submit">Generate design</button><div id="automation-describe-loading" class="htmx-indicator text-center text-sm text-base-content/65" role="status" aria-live="polite">Generating and validating design…</div></form></section>
			<section class="rounded-box border border-base-300 bg-base-100 p-5"><h3 class="text-lg font-semibold">Blank</h3><p class="mt-1 text-sm text-base-content/60">Build your own runnable Automation from configurable OpenVibely capabilities. Add schedules, Agent tasks, and outcomes, then connect and configure them yourself.</p><form method="post" action={ templ.SafeURL(fmt.Sprintf("/automations/drafts?project_id=%s", currentProjectID)) } hx-post={ fmt.Sprintf("/automations/drafts?project_id=%s", currentProjectID) } hx-target="#main-content" class="mt-4"><input type="hidden" name="project_id" value={ currentProjectID }/><input type="hidden" name="source" value="blank"/><button class="btn btn-outline w-full" type="submit">Open custom builder</button></form></section>
		</div>
	</div>
}

templ AutomationBuilder(projects []models.Project, currentProjectID string, page models.AutomationBuilderPage) {
	@layout.Base("Automation Builder", projects, currentProjectID) {
		@AutomationBuilderContent(page, currentProjectID)
	}
}

templ AutomationBuilderContent(page models.AutomationBuilderPage, currentProjectID string) {
	<div id="automation-builder" class="h-full overflow-y-auto min-w-0 max-w-full" data-automation-draft>
		@layout.PageTitle(page.Result.Candidate.Name)
		<a class="btn btn-ghost btn-sm mb-3" href={ templ.URL(fmt.Sprintf("/automations?project_id=%s", currentProjectID)) } hx-get={ fmt.Sprintf("/automations?project_id=%s", currentProjectID) } hx-target="#main-content" hx-push-url="true" onclick="event.preventDefault(); event.stopImmediatePropagation(); window.openVibelyNavigate(this.getAttribute('href')); return false;">← Automations</a>
		<div class="mb-4 flex flex-wrap items-end justify-between gap-3">
			<div class="min-w-0 flex-1">
				<label class="form-control max-w-xl"><span class="label-text mb-1 font-medium">Automation name</span><input class="input input-bordered w-full text-xl font-bold sm:text-2xl" form="automation-design-form" name="automation_name" value={ page.Result.Candidate.Name } maxlength="200" required data-automation-name aria-label="Automation name"/></label>
				if page.Result.Definition.Automation.PublishedVersionID != nil {
					<p class="mt-2 text-sm text-base-content/65">Editing this Automation. Save the design here, then apply executable changes when ready.</p>
				} else {
					<p class="mt-2 text-sm text-base-content/65">Build the design, save your work, then apply it when it is ready to run.</p>
				}
			</div>
			<div class="flex flex-wrap gap-2">
				<button class="btn btn-primary btn-sm" type="submit" form="automation-design-form">Save changes</button>
				<button class="btn btn-ghost btn-sm text-error" type="button" data-delete-automation-open onclick="document.getElementById('delete-automation-modal').showModal()">Delete</button>
			</div>
		</div>
		<dialog id="delete-automation-modal" class="modal">
			<div class="modal-box">
				@ModalCloseButton("delete-automation-modal", "Close delete automation confirmation")
				<h3 class="pr-10 text-lg font-bold text-error">Delete automation</h3>
				<p class="py-4">Delete <strong>{ page.Result.Candidate.Name }</strong>? This permanently deletes this Automation graph and its saved design.</p>
				<div class="rounded-lg bg-base-200 p-3 text-sm text-base-content/70">Existing tasks and schedules remain. Any Automation-owned trigger schedules will be disabled. This cannot be undone.</div>
				<div class="modal-action">
					<button class="btn" type="button" onclick="document.getElementById('delete-automation-modal').close()">Cancel</button>
					<form method="post" action={ templ.SafeURL(fmt.Sprintf("/automations/%s/delete?project_id=%s", page.Result.Definition.Automation.ID, currentProjectID)) } hx-post={ fmt.Sprintf("/automations/%s/delete?project_id=%s", page.Result.Definition.Automation.ID, currentProjectID) } hx-swap="none"><input type="hidden" name="project_id" value={ currentProjectID }/><button class="btn btn-error" type="submit">Delete automation</button></form>
				</div>
			</div>
			<form method="dialog" class="modal-backdrop"><button>Cancel</button></form>
		</dialog>
		if page.Error != "" {
			<div class="alert alert-error mb-4" role="alert">{ page.Error }</div>
		}
		if len(page.PublicationSteps) > 0 {
			<section class="mb-4 rounded-box border border-error/30 bg-base-100 p-4" aria-label="Publication attempt resources">
				<h3 class="font-semibold">Publication attempt resources</h3>
				<p class="mt-1 text-sm text-base-content/65">These visible resources were already created or reconciled before the failure. Retrying the same plan will reuse them.</p>
				<div class="mt-3 space-y-2">
					for _, step := range page.PublicationSteps {
						<div class="flex flex-wrap items-center justify-between gap-3 rounded-lg bg-base-200/60 px-3 py-2"><span class="break-all text-sm">{ step.ResourceType } { step.ResourceID }</span><span class="badge badge-outline">{ step.Status }</span></div>
					}
				</div>
			</section>
		}
		if len(page.Result.Assumptions) > 0 || len(page.Result.Warnings) > 0 {
			<div class="mb-4 grid grid-cols-1 gap-3 lg:grid-cols-2">
				<div class="rounded-box bg-base-200/60 p-4"><h3 class="font-semibold">Assumptions</h3><ul class="mt-2 list-disc pl-5 text-sm">
					for _, item := range page.Result.Assumptions {
						<li>{ item }</li>
					}
				</ul></div>
				<div class="rounded-box bg-base-200/60 p-4"><h3 class="font-semibold">Warnings</h3><ul class="mt-2 list-disc pl-5 text-sm">
					for _, item := range page.Result.Warnings {
						<li>{ item }</li>
					}
				</ul></div>
			</div>
		}
			if len(page.Result.ValidationErrors) > 0 {
				<details class="mb-3 rounded-box border border-base-300 bg-base-200/40 px-4 py-3" data-automation-validation-summary>
					<summary class="cursor-pointer text-sm font-medium">{ fmt.Sprintf("%d setup items before this design can run", len(automationValidationMessages(page.Result.ValidationErrors, page.NodePalette))) }</summary>
					<ul class="mt-2 list-disc pl-5 text-sm text-base-content/70">
						for _, message := range automationValidationMessages(page.Result.ValidationErrors, page.NodePalette) {
							<li>{ message }</li>
						}
					</ul>
				</details>
			}
			<section class="mb-5 rounded-box border border-base-300 bg-base-100 p-3 sm:p-4" data-automation-draft-canvas data-edge-palette={ automationDraftEdgesJSON(page.EdgePalette) }>
				<div class="flex flex-wrap items-start justify-between gap-3">
					<div><div class="flex flex-wrap items-center gap-2"><h3 class="font-semibold">Canvas</h3><span class="badge badge-outline badge-sm">{ automationAdapterLabel(page.Result.Candidate.AdapterKey) }</span></div><p class="mt-1 text-xs text-base-content/60">Drag nodes to arrange them and empty space to pan. Pinch or use the controls to zoom; ordinary scrolling moves the page.</p><p class="mt-2 text-sm font-medium" data-automation-connect-status aria-live="polite"><span class="text-primary">Connect from either side:</span> drag either dot on one node to either dot on another. Select a line, then use Delete connection or drag an endpoint to reconnect it.</p></div>
					<div class="flex flex-wrap items-center gap-2" aria-label="Canvas controls">
						<div data-automation-node-tool>
							<button class="btn btn-primary btn-sm" type="button" data-automation-add-node-open onclick="document.getElementById('automation-node-dialog').showModal()">Add node</button>
						</div>
						<button class="btn btn-outline btn-sm" type="button" data-automation-disconnect-edge disabled title="Select a connection line first">Delete connection</button>
						<button class="btn btn-ghost btn-sm" type="button" data-automation-zoom-out aria-label="Zoom out">−</button><button class="btn btn-ghost btn-sm" type="button" data-automation-zoom-in aria-label="Zoom in">+</button><button class="btn btn-ghost btn-sm" type="button" data-automation-fit>Fit</button><button class="btn btn-ghost btn-sm" type="button" data-automation-reset>Reset layout</button>
					</div>
				</div>
				<dialog id="automation-node-dialog" class="modal" data-automation-node-dialog>
					<div class="modal-box relative max-w-md">
						<div class="absolute right-4 top-4">@ModalCloseButton("document.getElementById('automation-node-dialog')", "Close add node dialog")</div>
						<div class="pr-10"><h3 class="text-lg font-semibold">Add node</h3>
							if page.Result.Candidate.AdapterKey == "custom" {
								<p class="mt-1 text-sm text-base-content/65">Add an OpenVibely capability, then configure it and connect it to the next step.</p>
							} else {
								<p class="mt-1 text-sm text-base-content/65">Add a step from this maintained Automation template.</p>
							}
						</div>
					<form class="mt-5 space-y-4" method="post" action={ templ.SafeURL(fmt.Sprintf("/automations/%s/drafts/%s?project_id=%s", page.Result.Definition.Automation.ID, page.Result.Definition.Version.ID, currentProjectID)) } hx-post={ fmt.Sprintf("/automations/%s/drafts/%s?project_id=%s", page.Result.Definition.Automation.ID, page.Result.Definition.Version.ID, currentProjectID) } hx-target="#main-content">
						<input type="hidden" name="project_id" value={ currentProjectID }/><input type="hidden" name="candidate_json" value={ automationDraftCandidateJSON(page.Result.Candidate) } data-candidate-json/><input type="hidden" name="builder_action" value="create_node"/>
						<label class="form-control"><span class="label-text">Node purpose</span><select class="select select-bordered" name="node_kind" required>
							if page.Result.Candidate.AdapterKey == "custom" {
								<option value="schedule">Schedule</option><option value="agent_task">Agent task</option><option value="outcome">Outcome</option>
							} else {
								for _, node := range page.NodePalette {
									if !automationDraftHasNode(page.Result.Candidate.Nodes, node.Key) {
										<option value={ "runtime:" + node.Key }>{ node.Name } · { automationNodeTypeLabel(node.Type) }</option>
									}
								}
							}
						</select><span class="label-text-alt mt-1">Schedules start real Agent tasks. Outcomes mark the end of a path.</span></label>
						<label class="form-control"><span class="label-text">Name</span><input class="input input-bordered" name="node_name" maxlength="200" placeholder="Review result" required autofocus/></label>
						<div class="modal-action"><button class="btn btn-ghost" type="button" onclick="document.getElementById('automation-node-dialog').close()">Cancel</button><button class="btn btn-primary" type="submit" data-automation-create-node>Add node</button></div>
					</form>
					if page.Result.Definition.Version.Source == "template" {
						<details class="mt-5 border-t border-base-300 pt-4"><summary class="cursor-pointer text-sm font-semibold">Suggested nodes</summary><p class="mt-1 text-xs text-base-content/60">Quick-add nodes understood by this Automation’s runtime.</p>
							<div class="mt-2 space-y-1">
								for _, node := range page.NodePalette {
									if !automationDraftHasNode(page.Result.Candidate.Nodes, node.Key) {
										<form method="post" action={ templ.SafeURL(fmt.Sprintf("/automations/%s/drafts/%s?project_id=%s", page.Result.Definition.Automation.ID, page.Result.Definition.Version.ID, currentProjectID)) } hx-post={ fmt.Sprintf("/automations/%s/drafts/%s?project_id=%s", page.Result.Definition.Automation.ID, page.Result.Definition.Version.ID, currentProjectID) } hx-target="#main-content"><input type="hidden" name="project_id" value={ currentProjectID }/><input type="hidden" name="candidate_json" value={ automationDraftCandidateJSON(page.Result.Candidate) } data-candidate-json/><input type="hidden" name="builder_action" value="add_node"/><input type="hidden" name="node_key" value={ node.Key }/><button class="btn btn-ghost h-auto min-h-11 w-full justify-start py-2 text-left" type="submit" data-automation-add-node><span><span class="block text-sm font-medium">{ node.Name }</span><span class="block text-xs font-normal text-base-content/55">{ automationNodeTypeLabel(node.Type) }</span></span></button></form>
									}
								}
							</div>
						</details>
					}
					</div>
					<form method="dialog" class="modal-backdrop"><button aria-label="Close add node dialog">close</button></form>
				</dialog>
				<div class="automation-canvas-shell relative mt-3 min-h-[calc(100dvh-15rem)] w-full overflow-hidden rounded-box border border-base-300 bg-base-200/30" role="region" aria-label="Automation graph builder">
					<svg data-automation-canvas viewBox={ automationDraftGraphViewBox(page.Result.Candidate.Nodes) } class="h-[calc(100dvh-15rem)] min-h-[42rem] w-full touch-none select-none" role="img" aria-label={ page.Result.Candidate.Name + " graph design" }>
						@automationGraphThemeStyles()
						<defs>
							<marker id="automation-draft-arrow" markerWidth="10" markerHeight="10" refX="8" refY="3" orient="auto"><path d="M0,0 L0,6 L9,3 z" class="automation-graph-arrow"></path></marker>
							<marker id="automation-draft-preview-arrow" markerWidth="10" markerHeight="10" refX="8" refY="3" orient="auto"><path d="M0,0 L0,6 L9,3 z" class="automation-graph-preview-arrow"></path></marker>
						</defs>
						for _, edge := range page.Result.Candidate.Edges {
							if source, target, ok := automationDraftEdgeNodes(page.Result.Candidate.Nodes, edge); ok {
								<g class="automation-draft-edge" data-edge-key={ edge.Key } data-from={ edge.From } data-to={ edge.To } tabindex="0" role="group" aria-label={ automationDraftNodeName(page.Result.Candidate.Nodes, edge.From) + " to " + automationDraftNodeName(page.Result.Candidate.Nodes, edge.To) + " connection" }>
									<line data-edge-hit x1={ fmt.Sprintf("%.0f", source.Position.X+automationGraphNodeWidth) } y1={ fmt.Sprintf("%.0f", source.Position.Y+automationGraphNodeHeight/2) } x2={ fmt.Sprintf("%.0f", target.Position.X) } y2={ fmt.Sprintf("%.0f", target.Position.Y+automationGraphNodeHeight/2) } class="automation-edge-hit"></line>
									<line data-edge-line x1={ fmt.Sprintf("%.0f", source.Position.X+automationGraphNodeWidth) } y1={ fmt.Sprintf("%.0f", source.Position.Y+automationGraphNodeHeight/2) } x2={ fmt.Sprintf("%.0f", target.Position.X) } y2={ fmt.Sprintf("%.0f", target.Position.Y+automationGraphNodeHeight/2) } class="automation-graph-edge" stroke-width="2" marker-end="url(#automation-draft-arrow)"></line>
									<circle data-reconnect-edge data-edge-endpoint="from" cx={ fmt.Sprintf("%.0f", source.Position.X+automationGraphNodeWidth) } cy={ fmt.Sprintf("%.0f", source.Position.Y+automationGraphNodeHeight/2) } r="7" class="automation-edge-endpoint" tabindex="0" role="button" aria-label="Reconnect connection start"></circle>
									<circle data-reconnect-edge data-edge-endpoint="to" cx={ fmt.Sprintf("%.0f", target.Position.X) } cy={ fmt.Sprintf("%.0f", target.Position.Y+automationGraphNodeHeight/2) } r="7" class="automation-edge-endpoint" tabindex="0" role="button" aria-label="Reconnect connection end"></circle>
									<g data-delete-edge transform={ fmt.Sprintf("translate(%.0f %.0f)", (source.Position.X+automationGraphNodeWidth+target.Position.X)/2, (source.Position.Y+target.Position.Y)/2+automationGraphNodeHeight/2) } class="automation-edge-delete" tabindex="0" role="button" aria-label="Delete connection"><circle r="11"></circle><text text-anchor="middle" dominant-baseline="central">×</text></g>
								</g>
							}
						}
						<line data-automation-edge-preview x1="0" y1="0" x2="0" y2="0" class="automation-graph-edge automation-graph-edge--preview" marker-end="url(#automation-draft-preview-arrow)" hidden></line>
						for _, node := range page.Result.Candidate.Nodes {
							if node.Position != nil {
								<g class="automation-draft-node automation-graph-focus cursor-grab active:cursor-grabbing" data-node-key={ node.Key } data-node-x={ fmt.Sprintf("%.0f", node.Position.X) } data-node-y={ fmt.Sprintf("%.0f", node.Position.Y) } data-default-x={ fmt.Sprintf("%.0f", automationDraftDefaultX(page.NodePalette, node.Key)) } data-default-y={ fmt.Sprintf("%.0f", automationDraftDefaultY(page.NodePalette, node.Key)) } transform={ fmt.Sprintf("translate(%.0f %.0f)", node.Position.X, node.Position.Y) } tabindex="0" role="group" aria-label={ node.Name + ", " + string(node.Type) + ", use arrow keys to move" }>
									<rect width={ fmt.Sprintf("%.0f", automationGraphNodeWidth) } height={ fmt.Sprintf("%.0f", automationGraphNodeHeight) } rx="12" class="automation-graph-node automation-graph-node--idle" stroke-width="2"></rect>
									<foreignObject x="0" y="0" width={ fmt.Sprintf("%.0f", automationGraphNodeWidth) } height={ fmt.Sprintf("%.0f", automationGraphNodeHeight) } class="pointer-events-none"><div xmlns="http://www.w3.org/1999/xhtml" class="automation-node-content"><strong>{ node.Name }</strong><span>{ automationNodeTypeLabel(node.Type) }</span></div></foreignObject>
									<circle cx="0" cy={ fmt.Sprintf("%.0f", automationGraphNodeHeight/2) } r="9" class="automation-connect-handle" data-connect-port={ node.Key } data-port-side="left" tabindex="0" role="button" aria-label={ "Connect from or to the left side of " + node.Name }></circle>
									<circle cx={ fmt.Sprintf("%.0f", automationGraphNodeWidth) } cy={ fmt.Sprintf("%.0f", automationGraphNodeHeight/2) } r="9" class="automation-connect-handle" data-connect-port={ node.Key } data-port-side="right" tabindex="0" role="button" aria-label={ "Connect from or to the right side of " + node.Name }></circle>
									<g data-delete-node transform={ fmt.Sprintf("translate(%.0f 16)", automationGraphNodeWidth-16) } class="automation-node-delete" tabindex="0" role="button" aria-label={ "Delete " + node.Name }><circle r="11"></circle><text text-anchor="middle" dominant-baseline="central">×</text></g>
								</g>
							}
						}
					</svg>
					if len(page.Result.Candidate.Nodes) == 0 {
						<div class="pointer-events-none absolute inset-0 flex items-center justify-center p-6">
							<div class="pointer-events-auto max-w-sm rounded-box border border-base-300 bg-base-100/95 p-6 text-center shadow-xl"><h4 class="text-lg font-semibold">Start your graph</h4><p class="mt-2 text-sm text-base-content/65">Add a node, drag it into place, then connect its side dots to other nodes.</p><button class="btn btn-primary mt-4" type="button" data-automation-add-first-node onclick="document.getElementById('automation-node-dialog').showModal()">Add first node</button></div>
						</div>
					}
				</div>
			</section>
			<details class="mb-5 rounded-box border border-base-300 bg-base-100 p-4">
				<summary class="cursor-pointer font-semibold">Node and connection settings</summary>
				<form id="automation-design-form" method="post" action={ templ.SafeURL(fmt.Sprintf("/automations/%s/drafts/%s?project_id=%s", page.Result.Definition.Automation.ID, page.Result.Definition.Version.ID, currentProjectID)) } hx-post={ fmt.Sprintf("/automations/%s/drafts/%s?project_id=%s", page.Result.Definition.Automation.ID, page.Result.Definition.Version.ID, currentProjectID) } hx-target="#main-content" class="mt-4 space-y-4" data-automation-draft-form>			<input type="hidden" name="project_id" value={ currentProjectID }/>
			<input type="hidden" name="candidate_json" value={ automationDraftCandidateJSON(page.Result.Candidate) } data-candidate-json/>
			<div class="grid grid-cols-1 gap-4 xl:grid-cols-2">
				for _, node := range page.Result.Candidate.Nodes {
					<section class="rounded-box border border-base-300 bg-base-100 p-4"><div class="mb-3 flex flex-wrap items-start justify-between gap-3"><div><h3 class="font-semibold">{ node.Name }</h3><p class="text-xs text-base-content/55">{ node.Key } · { node.Role }</p></div><div class="flex items-center gap-2"><span class="badge badge-ghost badge-sm">{ automationNodeTypeLabel(node.Type) }</span><button class="btn btn-ghost btn-xs text-error" type="submit" name="remove_node" value={ node.Key }>Delete node</button></div></div><label class="form-control"><span class="label-text">Display name</span><input class="input input-bordered" name={ "node_" + node.Key + "_name" } value={ node.Name } maxlength="200"/></label>
						if automationDraftHasConfig(node, "prompt") {
							<label class="form-control mt-3"><span class="label-text">Task prompt</span><textarea class="textarea textarea-bordered h-28" name={ "node_" + node.Key + "_prompt" } maxlength="20000">{ automationDraftStringConfig(node, "prompt") }</textarea></label>
							<div class="mt-3 grid grid-cols-1 gap-3 lg:grid-cols-3">
								<label class="form-control"><span class="label-text">Primary Agent</span><select class="select select-bordered" name={ "node_" + node.Key + "_agent_ref" }><option value="" selected?={ automationDraftStringConfig(node, "agent_ref") == "" }>Default (no primary Agent)</option>
									for _, agent := range page.Capabilities.Agents {
										<option value={ agent.ID } selected?={ automationDraftStringConfig(node, "agent_ref") == agent.ID }>{ agent.Name }</option>
									}
								</select></label>
								<label class="form-control"><span class="label-text">Skills</span><input type="hidden" name={ "node_" + node.Key + "_skills" } value=""/><select class="select select-bordered min-h-24" name={ "node_" + node.Key + "_skills" } multiple>
									for _, skill := range page.Capabilities.Skills {
										<option value={ skill.ID } selected?={ automationDraftStringSliceContains(node, "skills", skill.ID) }>{ skill.Name }</option>
									}
								</select></label>
								<label class="form-control"><span class="label-text">Source files</span><input type="hidden" name={ "node_" + node.Key + "_source_files" } value=""/><select class="select select-bordered min-h-24" name={ "node_" + node.Key + "_source_files" } multiple>
									for _, sourceFile := range page.Capabilities.SourceFiles {
										<option value={ sourceFile } selected?={ automationDraftStringSliceContains(node, "source_files", sourceFile) }>{ sourceFile }</option>
									}
								</select></label>
							</div>
								<div class="mt-3 grid grid-cols-2 gap-3">
									<label class="form-control"><span class="label-text">Category</span><select class="select select-bordered" name={ "node_" + node.Key + "_category" }><option value="backlog" selected?={ automationDraftStringConfig(node, "category") == "backlog" }>Backlog</option><option value="scheduled" selected?={ automationDraftStringConfig(node, "category") == "scheduled" }>Scheduled</option>
										if page.Result.Candidate.AdapterKey == "custom" {
											<option value="active" selected?={ automationDraftStringConfig(node, "category") == "active" }>Active follow-up</option>
										}
									</select></label>
									<label class="form-control"><span class="label-text">Priority</span><input type="number" min="1" max="4" class="input input-bordered" name={ "node_" + node.Key + "_priority" } value={ fmt.Sprintf("%d", automationDraftIntConfig(node, "priority")) }/></label>
								</div>						}
						if automationDraftHasConfig(node, "run_at") {
							<div class="grid grid-cols-2 gap-3"><label class="form-control"><span class="label-text">Time</span><input type="time" class="input input-bordered" name={ "node_" + node.Key + "_run_at" } value={ automationDraftStringConfig(node, "run_at") }/></label><label class="form-control"><span class="label-text">Repeat</span><select class="select select-bordered" name={ "node_" + node.Key + "_repeat_type" }>
								for _, repeat := range []string{"once","minutes","hours","daily","weekly","monthly"} {
									<option value={ repeat } selected?={ automationDraftStringConfig(node, "repeat_type") == repeat }>{ repeat }</option>
								}
							</select></label><label class="form-control"><span class="label-text">Interval</span><input type="number" min="1" max="365" class="input input-bordered" name={ "node_" + node.Key + "_repeat_interval" } value={ fmt.Sprintf("%d", automationDraftIntConfig(node, "repeat_interval")) }/></label><label class="label cursor-pointer justify-start gap-3"><input type="checkbox" class="checkbox" name={ "node_" + node.Key + "_enabled" } value="true" checked?={ automationDraftBoolConfig(node, "enabled") }/><span class="label-text">Enabled when applied</span></label></div>
						}
					</section>
				}
			</div>
			<div class="rounded-box border border-base-300 bg-base-100 p-4"><h3 class="font-semibold">Transitions</h3><div class="mt-3 grid grid-cols-1 gap-3 md:grid-cols-2">
				for _, edge := range page.Result.Candidate.Edges {
					<div class="rounded-box bg-base-200/40 p-3"><div class="mb-2 flex items-center justify-between gap-2"><span class="text-xs font-medium">{ automationDraftNodeName(page.Result.Candidate.Nodes, edge.From) } → { automationDraftNodeName(page.Result.Candidate.Nodes, edge.To) }</span><button class="btn btn-ghost btn-xs text-error" type="submit" name="remove_edge" value={ edge.Key }>Delete connection</button></div><label class="form-control"><span class="label-text">Label</span><input class="input input-bordered" name={ "edge_" + edge.Key + "_label" } value={ edge.Label } maxlength="100"/></label></div>
				}
			</div></div>
				<div class="flex flex-wrap gap-3"><button class="btn btn-primary" type="submit">Save changes</button><button class="btn btn-outline" type="submit" formaction={ templ.SafeURL(fmt.Sprintf("/automations/%s/drafts/%s/plan?project_id=%s", page.Result.Definition.Automation.ID, page.Result.Definition.Version.ID, currentProjectID)) } hx-post={ fmt.Sprintf("/automations/%s/drafts/%s/plan?project_id=%s", page.Result.Definition.Automation.ID, page.Result.Definition.Version.ID, currentProjectID) }>Review and apply</button></div>
				</form>
			</details>
			<script>
			(function() {
				var root = document.querySelector('[data-automation-draft-canvas]');
				var builder = document.getElementById('automation-builder');
				var svg = root && root.querySelector('[data-automation-canvas]');
				var source = builder && builder.querySelector('[data-candidate-json]');
				if (!root || !builder || !svg || !source) return;
				var candidate;
				try { candidate = JSON.parse(source.value); } catch (_) { return; }
				var edgePalette = [];
				try { edgePalette = JSON.parse(root.dataset.edgePalette || '[]'); } catch (_) { return; }
				var connectStatus = root.querySelector('[data-automation-connect-status]');
				var disconnectEdge = root.querySelector('[data-automation-disconnect-edge]');
				var preview = svg.querySelector('[data-automation-edge-preview]');
					var selectedEdgeKey = '';
					var keyboardSource = null;
					var activeConnection = null;
					var initialViewBox = svg.getAttribute('viewBox').split(/\s+/).map(Number);
					var viewBox = initialViewBox.slice();

					function nodeCandidate(key) { return (candidate.nodes || []).find(function(node) { return node.key === key; }); }
					function edgeCandidate(key) { return (candidate.edges || []).find(function(edge) { return edge.key === key; }); }
					function nodeName(key) { var node = nodeCandidate(key); return node ? node.name : key; }
					function nodeGroup(key) { return svg.querySelector('[data-node-key="' + CSS.escape(key) + '"]'); }
					function nodePortPoint(key, side) { var group = nodeGroup(key); if (!group) return null; return {x: Number(group.dataset.nodeX) + (side === 'right' ? 170 : 0), y: Number(group.dataset.nodeY) + 52}; }
					function syncCandidate() {
						var automationName = builder.querySelector('[data-automation-name]');
						if (automationName) candidate.name = automationName.value;
						(candidate.nodes || []).forEach(function(node) {
						var prefix = 'node_' + node.key + '_';
						var name = builder.querySelector('[name="' + prefix + 'name"]');
						if (name) node.name = name.value;
						if (node.config && Object.prototype.hasOwnProperty.call(node.config, 'prompt')) {
							var prompt = builder.querySelector('[name="' + prefix + 'prompt"]');
							var category = builder.querySelector('[name="' + prefix + 'category"]');
							var priority = builder.querySelector('[name="' + prefix + 'priority"]');
							var agentRef = builder.querySelector('[name="' + prefix + 'agent_ref"]');
							var skills = builder.querySelector('select[name="' + prefix + 'skills"]');
							var sourceFiles = builder.querySelector('select[name="' + prefix + 'source_files"]');
							if (prompt) node.config.prompt = prompt.value;
							if (category) node.config.category = category.value;
							if (priority) node.config.priority = Number(priority.value);
							if (agentRef) node.config.agent_ref = agentRef.value;
							if (skills) node.config.skills = Array.from(skills.selectedOptions).map(function(option) { return option.value; });
							if (sourceFiles) node.config.source_files = Array.from(sourceFiles.selectedOptions).map(function(option) { return option.value; });
						}
						if (node.config && Object.prototype.hasOwnProperty.call(node.config, 'run_at')) {
							var runAt = builder.querySelector('[name="' + prefix + 'run_at"]');
							var repeat = builder.querySelector('[name="' + prefix + 'repeat_type"]');
							var interval = builder.querySelector('[name="' + prefix + 'repeat_interval"]');
							var enabled = builder.querySelector('[name="' + prefix + 'enabled"]');
							if (runAt) node.config.run_at = runAt.value;
							if (repeat) node.config.repeat_type = repeat.value;
							if (interval) node.config.repeat_interval = Number(interval.value);
							if (enabled) node.config.enabled = enabled.checked;
						}
					});
					(candidate.edges || []).forEach(function(edge) {
						var label = builder.querySelector('[name="edge_' + edge.key + '_label"]');
						if (label) edge.label = label.value;
					});
					builder.querySelectorAll('[data-candidate-json]').forEach(function(input) { input.value = JSON.stringify(candidate); });
				}
				function applyViewBox() { svg.setAttribute('viewBox', viewBox.join(' ')); }
				function graphPoint(event) {
					var point = svg.createSVGPoint();
					point.x = event.clientX;
					point.y = event.clientY;
					return point.matrixTransform(svg.getScreenCTM().inverse());
				}
				function renderNode(group, x, y) {
					group.dataset.nodeX = String(x);
					group.dataset.nodeY = String(y);
					group.setAttribute('transform', 'translate(' + x + ' ' + y + ')');
					var node = nodeCandidate(group.dataset.nodeKey);
					if (node) node.position = {x: x, y: y};
				}
					function edgePoints(edge) {
						var from = nodeGroup(edge.from), to = nodeGroup(edge.to); if (!from || !to) return null;
						var fromCenter = Number(from.dataset.nodeX) + 85, toCenter = Number(to.dataset.nodeX) + 85;
						var fromSide = edge.from_port || (toCenter >= fromCenter ? 'right' : 'left');
						var toSide = edge.to_port || (toCenter >= fromCenter ? 'left' : 'right');
						return {start: nodePortPoint(edge.from, fromSide), finish: nodePortPoint(edge.to, toSide)};
					}
					function setEdgeLine(line, points) { line.setAttribute('x1', points.start.x); line.setAttribute('y1', points.start.y); line.setAttribute('x2', points.finish.x); line.setAttribute('y2', points.finish.y); }
					function renderEdge(group) {
						var edge = edgeCandidate(group.dataset.edgeKey), points = edge && edgePoints(edge); if (!edge || !points) return;
						group.dataset.from = edge.from; group.dataset.to = edge.to;
						group.querySelectorAll('[data-edge-line], [data-edge-hit]').forEach(function(line) { setEdgeLine(line, points); });
						var start = group.querySelector('[data-edge-endpoint="from"]'), finish = group.querySelector('[data-edge-endpoint="to"]');
						start.setAttribute('cx', points.start.x); start.setAttribute('cy', points.start.y); finish.setAttribute('cx', points.finish.x); finish.setAttribute('cy', points.finish.y);
						group.querySelector('[data-delete-edge]').setAttribute('transform', 'translate(' + ((points.start.x + points.finish.x) / 2) + ' ' + ((points.start.y + points.finish.y) / 2) + ')');
					}
					function renderEdges() { svg.querySelectorAll('.automation-draft-edge').forEach(renderEdge); }
					function connectionExists(from, to, exceptKey) { return (candidate.edges || []).some(function(edge) { return edge.key !== exceptKey && edge.from === from && edge.to === to; }); }
					function safeKey(value, fallback) {
					var key = String(value || '').toLowerCase().trim().replace(/[^a-z0-9]+/g, '_').replace(/^_+|_+$/g, '').slice(0, 80).replace(/_+$/g, '');
					return key || fallback;
				}
					function uniqueEdgeKey(base, exceptKey) {
						var keys = new Set((candidate.edges || []).filter(function(edge) { return edge.key !== exceptKey; }).map(function(edge) { return edge.key; }));
						if (!keys.has(base)) return base;
						for (var suffix = 2; ; suffix++) if (!keys.has(base + '_' + suffix)) return base + '_' + suffix;
					}
					function svgElement(name, attributes) { var element = document.createElementNS('http://www.w3.org/2000/svg', name); Object.keys(attributes || {}).forEach(function(key) { element.setAttribute(key, attributes[key]); }); return element; }
					function appendEdgeGroup(edge) {
						var group = svgElement('g', {class: 'automation-draft-edge', tabindex: '0', role: 'group', 'aria-label': nodeName(edge.from) + ' to ' + nodeName(edge.to) + ' connection'}); group.dataset.edgeKey = edge.key; group.dataset.from = edge.from; group.dataset.to = edge.to;
						group.appendChild(svgElement('line', {class: 'automation-edge-hit', 'data-edge-hit': ''})); group.appendChild(svgElement('line', {class: 'automation-graph-edge', 'stroke-width': '2', 'marker-end': 'url(#automation-draft-arrow)', 'data-edge-line': ''}));
						['from', 'to'].forEach(function(endpoint) { group.appendChild(svgElement('circle', {r: '7', class: 'automation-edge-endpoint', tabindex: '0', role: 'button', 'data-reconnect-edge': '', 'data-edge-endpoint': endpoint, 'aria-label': 'Reconnect connection ' + (endpoint === 'from' ? 'start' : 'end')})); });
						var remove = svgElement('g', {class: 'automation-edge-delete', tabindex: '0', role: 'button', 'data-delete-edge': '', 'aria-label': 'Delete connection'}); remove.appendChild(svgElement('circle', {r: '11'})); var x = svgElement('text', {'text-anchor': 'middle', 'dominant-baseline': 'central'}); x.textContent = '×'; remove.appendChild(x); group.appendChild(remove);
						svg.insertBefore(group, svg.querySelector('.automation-draft-node')); bindEdgeGroup(group); renderEdge(group);
					}
					function canonicalEdge(from, to, exceptKey) { return edgePalette.find(function(edge) { return edge.from === from && edge.to === to && !(candidate.edges || []).some(function(current) { return current.key !== exceptKey && current.key === edge.key; }); }); }
					function addConnection(from, to, fromSide, toSide) {
						if (!from || !to || from === to) { if (connectStatus) connectStatus.textContent = 'Connect two different nodes.'; return; }
						if (connectionExists(from, to, '')) { if (connectStatus) connectStatus.textContent = 'Those nodes are already connected in that direction.'; return; }
						candidate.edges = candidate.edges || [];
						var canonical = canonicalEdge(from, to, '');
						var edge = canonical ? JSON.parse(JSON.stringify(canonical)) : {key: uniqueEdgeKey('edge_' + safeKey(from, 'source') + '_' + safeKey(to, 'target'), ''), from: from, to: to, label: '', condition: {}};
						edge.from_port = fromSide; edge.to_port = toSide; candidate.edges.push(edge);
						appendEdgeGroup(edge); syncCandidate();
						if (connectStatus) connectStatus.textContent = 'Connected ' + nodeName(from) + ' to ' + nodeName(to) + '. Select a line to rewire or delete it.';
					}
					function reconnectEdge(key, endpoint, nodeKey, side) {
						var edge = edgeCandidate(key); if (!edge) return; var from = endpoint === 'from' ? nodeKey : edge.from; var to = endpoint === 'to' ? nodeKey : edge.to;
						if (!from || !to || from === to || connectionExists(from, to, key)) { if (connectStatus) connectStatus.textContent = 'That reconnection would duplicate or loop back to the same node.'; return; }
						var oldKey = edge.key, canonical = canonicalEdge(from, to, oldKey); edge.from = from; edge.to = to; if (endpoint === 'from') edge.from_port = side; else edge.to_port = side;
						if (canonical) { edge.key = canonical.key; edge.label = canonical.label || ''; edge.condition = canonical.condition || {}; } else if (edgePalette.some(function(item) { return item.key === edge.key; })) { edge.key = uniqueEdgeKey('edge_' + safeKey(from, 'source') + '_' + safeKey(to, 'target'), oldKey); edge.condition = {}; }
						var group = svg.querySelector('.automation-draft-edge[data-edge-key="' + CSS.escape(oldKey) + '"]'); if (group) { group.dataset.edgeKey = edge.key; renderEdge(group); } syncCandidate(); if (connectStatus) connectStatus.textContent = 'Reconnected ' + nodeName(from) + ' to ' + nodeName(to) + '.';
					}
					function removeEdge(key) {
						candidate.edges = (candidate.edges || []).filter(function(edge) { return edge.key !== key; });
						var group = svg.querySelector('.automation-draft-edge[data-edge-key="' + CSS.escape(key) + '"]'); if (group) group.remove();
						if (selectedEdgeKey === key) selectEdge(null);
						syncCandidate(); if (connectStatus) connectStatus.textContent = 'Connection disconnected. Draw a new one from either side when ready.';
					}
					function removeNode(key) { var name = nodeName(key); candidate.nodes = (candidate.nodes || []).filter(function(node) { return node.key !== key; }); candidate.edges = (candidate.edges || []).filter(function(edge) { return edge.from !== key && edge.to !== key; }); var group = nodeGroup(key); if (group) group.remove(); svg.querySelectorAll('.automation-draft-edge').forEach(function(edgeGroup) { if (!edgeCandidate(edgeGroup.dataset.edgeKey)) edgeGroup.remove(); }); if (selectedEdgeKey && !edgeCandidate(selectedEdgeKey)) selectEdge(null); syncCandidate(); if (connectStatus) connectStatus.textContent = name + ' deleted with its connections.'; }
					function selectEdge(group) {
						selectedEdgeKey = group ? group.dataset.edgeKey : '';
						svg.querySelectorAll('.automation-draft-edge').forEach(function(edge) { edge.classList.toggle('automation-draft-edge--selected', edge === group); });
						if (disconnectEdge) disconnectEdge.disabled = !selectedEdgeKey;
						if (group && connectStatus) connectStatus.textContent = 'Connection selected. Drag either endpoint to reconnect it, or choose Delete connection.';
					}
					function beginReconnect(group, handle, event) {
						if (event.button !== 0) return; event.preventDefault(); event.stopPropagation(); clearActiveConnection(); var edge = edgeCandidate(group.dataset.edgeKey), points = edge && edgePoints(edge); if (!points) return;
						var endpoint = handle.dataset.edgeEndpoint, start = endpoint === 'from' ? points.start : points.finish; activeConnection = {reconnectKey: edge.key, endpoint: endpoint, pointerId: event.pointerId}; preview.setAttribute('x1', start.x); preview.setAttribute('y1', start.y); preview.setAttribute('x2', start.x); preview.setAttribute('y2', start.y); preview.removeAttribute('hidden');
						svg.querySelectorAll('[data-connect-port]').forEach(function(port) { port.classList.add('automation-connect-handle--eligible'); }); window.addEventListener('pointermove', moveConnection); window.addEventListener('pointerup', finishConnection); window.addEventListener('pointercancel', cancelConnection);
					}
					function bindEdgeGroup(group) {
						var hit = group.querySelector('[data-edge-hit]'); hit.addEventListener('pointerdown', function(event) { event.stopPropagation(); }); hit.addEventListener('click', function(event) { event.preventDefault(); event.stopPropagation(); selectEdge(group); });
						group.querySelectorAll('[data-reconnect-edge]').forEach(function(handle) { handle.addEventListener('pointerdown', function(event) { beginReconnect(group, handle, event); }); });
						var remove = group.querySelector('[data-delete-edge]'); function deleteCurrent(event) { event.preventDefault(); event.stopPropagation(); removeEdge(group.dataset.edgeKey); } remove.addEventListener('pointerdown', function(event) { event.stopPropagation(); }); remove.addEventListener('click', deleteCurrent); remove.addEventListener('keydown', function(event) { if (event.key === 'Enter' || event.key === ' ') deleteCurrent(event); });
						group.addEventListener('keydown', function(event) { if (event.key === 'Delete' || event.key === 'Backspace') { event.preventDefault(); removeEdge(group.dataset.edgeKey); } });
					}
					function clearConnectionHandles() {
						svg.querySelectorAll('[data-connect-port]').forEach(function(handle) { handle.classList.remove('automation-connect-handle--selected', 'automation-connect-handle--eligible'); });
					}
					function showConnectionTargets(from, side) {
						clearConnectionHandles();
						var sourceHandle = svg.querySelector('[data-connect-port="' + CSS.escape(from) + '"][data-port-side="' + side + '"]');
						if (sourceHandle) sourceHandle.classList.add('automation-connect-handle--selected');
						svg.querySelectorAll('[data-connect-port]').forEach(function(handle) { if (handle.dataset.connectPort !== from) handle.classList.add('automation-connect-handle--eligible'); });
					}
					function removeConnectionListeners() {
					window.removeEventListener('pointermove', moveConnection);
					window.removeEventListener('pointerup', finishConnection);
					window.removeEventListener('pointercancel', cancelConnection);
				}
				function clearActiveConnection() {
					activeConnection = null; keyboardSource = null; preview.setAttribute('hidden', ''); clearConnectionHandles(); removeConnectionListeners();
				}
				function moveConnection(event) {
					if (!activeConnection || event.pointerId !== activeConnection.pointerId) return;
					var point = graphPoint(event); preview.setAttribute('x2', point.x); preview.setAttribute('y2', point.y);
				}
					function finishConnection(event) {
						if (!activeConnection || event.pointerId !== activeConnection.pointerId) return;
						var target = event.target instanceof Element ? event.target.closest('[data-connect-port]') : null;
						if (!target && document.elementFromPoint) { var underPointer = document.elementFromPoint(event.clientX, event.clientY); target = underPointer && underPointer.closest('[data-connect-port]'); }
						var connection = activeConnection; clearActiveConnection();
						if (target) {
							if (connection.reconnectKey) reconnectEdge(connection.reconnectKey, connection.endpoint, target.dataset.connectPort, target.dataset.portSide);
							else addConnection(connection.from, target.dataset.connectPort, connection.fromSide, target.dataset.portSide);
						} else if (connectStatus) connectStatus.textContent = 'Connection cancelled. Drop on either dot of another node.';
					}
					function cancelConnection(event) { if (activeConnection && event.pointerId === activeConnection.pointerId) clearActiveConnection(); }
					function beginConnection(handle, event) {
						if (event.button !== 0) return; event.preventDefault(); event.stopPropagation(); clearActiveConnection();
						var start = nodePortPoint(handle.dataset.connectPort, handle.dataset.portSide); if (!start) return;
						activeConnection = {from: handle.dataset.connectPort, fromSide: handle.dataset.portSide, pointerId: event.pointerId};
						preview.setAttribute('x1', start.x); preview.setAttribute('y1', start.y); preview.setAttribute('x2', start.x); preview.setAttribute('y2', start.y); preview.removeAttribute('hidden');
						showConnectionTargets(activeConnection.from, activeConnection.fromSide); window.addEventListener('pointermove', moveConnection); window.addEventListener('pointerup', finishConnection); window.addEventListener('pointercancel', cancelConnection);
					}
					svg.querySelectorAll('.automation-draft-edge').forEach(bindEdgeGroup);
					if (disconnectEdge) disconnectEdge.addEventListener('click', function() { if (selectedEdgeKey) removeEdge(selectedEdgeKey); });
					svg.querySelectorAll('[data-connect-port]').forEach(function(handle) {
						handle.addEventListener('pointerdown', function(event) { beginConnection(handle, event); });
						handle.addEventListener('click', function(event) { event.preventDefault(); event.stopPropagation(); });
						handle.addEventListener('keydown', function(event) {
							event.stopPropagation(); if (event.key !== 'Enter' && event.key !== ' ') return; event.preventDefault();
							if (!keyboardSource) { keyboardSource = {key: handle.dataset.connectPort, side: handle.dataset.portSide}; showConnectionTargets(keyboardSource.key, keyboardSource.side); if (connectStatus) connectStatus.textContent = 'Connection start selected. Focus either side of another node and press Enter.'; return; }
							var start = keyboardSource; keyboardSource = null; clearConnectionHandles(); addConnection(start.key, handle.dataset.connectPort, start.side, handle.dataset.portSide);
						});
					});
					svg.querySelectorAll('.automation-draft-node').forEach(function(group) {
						var remove = group.querySelector('[data-delete-node]');
						function deleteCurrent(event) { event.preventDefault(); event.stopPropagation(); removeNode(group.dataset.nodeKey); }
						remove.addEventListener('pointerdown', function(event) { event.stopPropagation(); }); remove.addEventListener('click', deleteCurrent);
						remove.addEventListener('keydown', function(event) { if (event.key === 'Enter' || event.key === ' ') deleteCurrent(event); });
						group.addEventListener('pointerdown', function(event) {
							if (event.button !== 0 || event.target.closest('[data-connect-port], [data-delete-node]')) return;
							event.preventDefault(); event.stopPropagation(); group.setPointerCapture(event.pointerId);
						var start = graphPoint(event), originX = Number(group.dataset.nodeX), originY = Number(group.dataset.nodeY);
						function move(moveEvent) {
							var point = graphPoint(moveEvent);
							renderNode(group, Math.round(originX + point.x - start.x), Math.round(originY + point.y - start.y)); renderEdges(); syncCandidate();
						}
						function done() { group.removeEventListener('pointermove', move); group.removeEventListener('pointerup', done); group.removeEventListener('pointercancel', done); }
						group.addEventListener('pointermove', move); group.addEventListener('pointerup', done); group.addEventListener('pointercancel', done);
					});
						group.addEventListener('keydown', function(event) {
							if (event.key === 'Delete' || event.key === 'Backspace') { event.preventDefault(); removeNode(group.dataset.nodeKey); return; }
							var dx = 0, dy = 0;
							if (event.key === 'ArrowLeft') dx = -10; if (event.key === 'ArrowRight') dx = 10;
						if (event.key === 'ArrowUp') dy = -10; if (event.key === 'ArrowDown') dy = 10;
						if (!dx && !dy) return;
						event.preventDefault(); renderNode(group, Number(group.dataset.nodeX) + dx, Number(group.dataset.nodeY) + dy); renderEdges(); syncCandidate();
					});
				});
				var pan = null;
				svg.addEventListener('pointerdown', function(event) {
					if (event.target !== svg || event.button !== 0) return;
					var point = graphPoint(event); pan = {x: point.x, y: point.y, view: viewBox.slice()}; svg.setPointerCapture(event.pointerId);
				});
				svg.addEventListener('pointermove', function(event) {
					if (!pan) return;
					var point = graphPoint(event); viewBox[0] = pan.view[0] + pan.x - point.x; viewBox[1] = pan.view[1] + pan.y - point.y; applyViewBox();
				});
				svg.addEventListener('pointerup', function() { pan = null; });
				svg.addEventListener('pointercancel', function() { pan = null; });
				function zoom(factor) {
					var cx = viewBox[0] + viewBox[2] / 2, cy = viewBox[1] + viewBox[3] / 2;
					viewBox[2] = Math.max(240, Math.min(3000, viewBox[2] * factor)); viewBox[3] = Math.max(160, Math.min(2000, viewBox[3] * factor));
					viewBox[0] = cx - viewBox[2] / 2; viewBox[1] = cy - viewBox[3] / 2; applyViewBox();
				}
				svg.addEventListener('wheel', function(event) {
					if (!event.ctrlKey && !event.metaKey) return;
					event.preventDefault(); zoom(event.deltaY > 0 ? 1.12 : 0.88);
				}, {passive: false});
				root.querySelector('[data-automation-zoom-in]').addEventListener('click', function() { zoom(0.82); });
				root.querySelector('[data-automation-zoom-out]').addEventListener('click', function() { zoom(1.22); });
				root.querySelector('[data-automation-fit]').addEventListener('click', function() {
					var groups = Array.from(svg.querySelectorAll('.automation-draft-node'));
					if (!groups.length) { viewBox = initialViewBox.slice(); applyViewBox(); return; }
					var xs = groups.map(function(group) { return Number(group.dataset.nodeX); });
					var ys = groups.map(function(group) { return Number(group.dataset.nodeY); });
					var minX = Math.min.apply(null, xs) - 60, minY = Math.min.apply(null, ys) - 60;
					var maxX = Math.max.apply(null, xs) + 250, maxY = Math.max.apply(null, ys) + 164;
					viewBox = [minX, minY, Math.max(360, maxX - minX), Math.max(240, maxY - minY)]; applyViewBox();
				});
				root.querySelector('[data-automation-reset]').addEventListener('click', function() {
					svg.querySelectorAll('.automation-draft-node').forEach(function(group) { renderNode(group, Number(group.dataset.defaultX), Number(group.dataset.defaultY)); });
					renderEdges(); syncCandidate(); viewBox = initialViewBox.slice(); applyViewBox();
				});
					builder.addEventListener('htmx:beforeCleanupElement', function(event) {
						if (event.target === builder) clearActiveConnection();
					});
					var automationName = builder.querySelector('[data-automation-name]');
					if (automationName) automationName.addEventListener('input', syncCandidate);
					builder.addEventListener('submit', syncCandidate);
					renderEdges(); syncCandidate();
				})();
		</script>
		if page.Plan != nil {
			<section class="mt-5 rounded-box border border-primary/30 bg-base-100 p-5"><h3 class="text-lg font-semibold">Review changes</h3><p class="mt-1 text-sm text-base-content/65">Review every effect before applying this design. Nothing has changed in the runtime yet.</p><div class="mt-4 space-y-2">
				for _, effect := range page.Plan.Effects {
					<div class="flex flex-wrap items-center justify-between gap-3 rounded-lg bg-base-200/60 px-3 py-2"><span class="text-sm">{ effect.Name }</span><span class="badge badge-outline">{ effect.Operation } { effect.ResourceType }</span></div>
				}
			</div>
				if len(page.Plan.Validation) > 0 {
					<div class="mt-4 rounded-box border border-base-300 bg-base-200/40 px-3 py-2 text-sm">Resolve the setup items above before applying changes.</div>
				} else {
					<form method="post" action={ templ.SafeURL(fmt.Sprintf("/automations/%s/drafts/%s/publish?project_id=%s", page.Result.Definition.Automation.ID, page.Result.Definition.Version.ID, currentProjectID)) } hx-post={ fmt.Sprintf("/automations/%s/drafts/%s/publish?project_id=%s", page.Result.Definition.Automation.ID, page.Result.Definition.Version.ID, currentProjectID) } class="mt-4"><input type="hidden" name="project_id" value={ currentProjectID }/><input type="hidden" name="plan_revision" value={ page.Plan.PlanRevision }/><input type="hidden" name="confirmation_token" value={ page.ConfirmationToken }/><button class="btn btn-primary" type="submit">Apply changes</button></form>
				}
			</section>
		}
	</div>
}

const (
	automationGraphNodeWidth  = 170.0
	automationGraphNodeHeight = 104.0
	automationGraphPadding    = 60.0
)

func automationDraftCandidateJSON(candidate models.AutomationDraftCandidate) string { value, _ := json.Marshal(candidate); return string(value) }
func automationDraftEdgesJSON(edges []models.AutomationDraftEdge) string { value, _ := json.Marshal(edges); return string(value) }
func automationValidationMessages(issues []models.AutomationValidationIssue, palette []models.AutomationDraftNode) []string {
	missingNodes := []string{}
	missingEdges := 0
	messages := []string{}
	seen := map[string]bool{}
	for _, issue := range issues {
		switch issue.Code {
		case "missing_node":
			missingNodes = append(missingNodes, automationDraftNodeName(palette, issue.NodeKey))
		case "missing_edge":
			missingEdges++
		default:
			if !seen[issue.Message] { messages = append(messages, issue.Message); seen[issue.Message] = true }
		}
	}
	if len(missingNodes) > 0 { messages = append([]string{fmt.Sprintf("%d required nodes remain: %s.", len(missingNodes), strings.Join(missingNodes, ", "))}, messages...) }
	if missingEdges > 0 { messages = append([]string{fmt.Sprintf("%d required connections remain.", missingEdges)}, messages...) }
	return messages
}
func automationDraftHasConfig(node models.AutomationDraftNode, key string) bool { _, ok := node.Config[key]; return ok }
func automationDraftStringConfig(node models.AutomationDraftNode, key string) string { value, _ := node.Config[key].(string); return value }
func automationDraftStringSliceContains(node models.AutomationDraftNode, key, expected string) bool { switch values := node.Config[key].(type) { case []string: for _, value := range values { if value == expected { return true } }; case []any: for _, value := range values { if text, ok := value.(string); ok && text == expected { return true } } }; return false }
func automationDraftIntConfig(node models.AutomationDraftNode, key string) int { switch value := node.Config[key].(type) { case int: return value; case float64: return int(value); case json.Number: parsed, _ := value.Int64(); return int(parsed) }; return 0 }
func automationDraftBoolConfig(node models.AutomationDraftNode, key string) bool { value, _ := node.Config[key].(bool); return value }
func automationDraftHasNode(nodes []models.AutomationDraftNode, key string) bool { for _, node := range nodes { if node.Key == key { return true } }; return false }
func automationDraftNodeName(nodes []models.AutomationDraftNode, key string) string { for _, node := range nodes { if node.Key == key { return node.Name } }; return key }
func automationDraftDefaultX(nodes []models.AutomationDraftNode, key string) float64 { for _, node := range nodes { if node.Key == key && node.Position != nil { return node.Position.X } }; return 0 }
func automationDraftDefaultY(nodes []models.AutomationDraftNode, key string) float64 { for _, node := range nodes { if node.Key == key && node.Position != nil { return node.Position.Y } }; return 0 }
func automationDraftGraphViewBox(nodes []models.AutomationDraftNode) string { var first *models.AutomationDraftPoint; for _, node := range nodes { if node.Position != nil { first = node.Position; break } }; if first == nil { return "-60 -60 900 540" }; minX, minY, maxX, maxY := first.X, first.Y, first.X+automationGraphNodeWidth, first.Y+automationGraphNodeHeight; for _, node := range nodes { if node.Position == nil { continue }; if node.Position.X < minX { minX = node.Position.X }; if node.Position.Y < minY { minY = node.Position.Y }; if node.Position.X+automationGraphNodeWidth > maxX { maxX = node.Position.X+automationGraphNodeWidth }; if node.Position.Y+automationGraphNodeHeight > maxY { maxY = node.Position.Y+automationGraphNodeHeight } }; return fmt.Sprintf("%.0f %.0f %.0f %.0f", minX-automationGraphPadding, minY-automationGraphPadding, maxX-minX+2*automationGraphPadding, maxY-minY+2*automationGraphPadding) }
func automationDraftEdgeNodes(nodes []models.AutomationDraftNode, edge models.AutomationDraftEdge) (models.AutomationDraftNode, models.AutomationDraftNode, bool) { var source, target models.AutomationDraftNode; var sourceOK, targetOK bool; for _, node := range nodes { if node.Key == edge.From { source, sourceOK = node, node.Position != nil }; if node.Key == edge.To { target, targetOK = node, node.Position != nil } }; return source, target, sourceOK && targetOK }
func automationNodeTypeLabel(nodeType models.AutomationNodeType) string { return strings.Title(strings.ReplaceAll(string(nodeType), "_", " ")) }
func automationAdapterLabel(adapterKey string) string { return strings.Title(strings.ReplaceAll(adapterKey, "_", " ")) }

func automationMetricsJSON(metrics models.AutomationMetrics) string { value, _ := json.Marshal(metrics); return string(value) }
func automationReplayJSON(frames []models.AutomationReplayFrame) string { value, _ := json.Marshal(frames); return string(value) }
func automationHealthBadgeClass(state models.AutomationHealthState) string { switch state { case models.AutomationHealthHealthy: return "badge badge-success badge-outline"; case models.AutomationHealthDegraded: return "badge badge-warning badge-outline"; case models.AutomationHealthUnhealthy: return "badge badge-error badge-outline" }; return "badge badge-ghost" }
func automationInvocationHistoryTime(invocation models.AutomationInvocation) time.Time { if invocation.ScheduledFor != nil { return *invocation.ScheduledFor }; if invocation.StartedAt != nil { return *invocation.StartedAt }; return invocation.CreatedAt }
func automationInvocationLabel(invocation models.AutomationInvocation) string { if invocation.ScheduledFor != nil { return "Scheduled occurrence" }; return "Invocation " + automationShortID(invocation.ID) }
func automationWorkItemLabel(item models.AutomationWorkItem) string { if strings.TrimSpace(item.Title) != "" { return item.Title }; return item.Kind + " " + automationShortID(item.ID) }
func automationShortID(value string) string { if len(value) <= 8 { return value }; return value[:8] }
func automationNodeName(nodes []models.AutomationNode, nodeID string) string { for _, node := range nodes { if node.ID == nodeID { return node.Name } }; return "Unknown node" }
func automationInvocationNodeClass(history models.AutomationInvocationHistory, nodeID string) string { for _, touchedNodeID := range history.TouchedNodeIDs { if touchedNodeID == nodeID { return "automation-graph-node automation-graph-node--running" } }; return "automation-graph-node automation-graph-node--idle" }

func automationCardURL(card models.AutomationCard, currentProjectID string) string {
	if card.Automation.PublishedVersionID == nil && card.Version.ID != "" {
		return fmt.Sprintf("/automations/%s/drafts/%s?project_id=%s", card.Automation.ID, card.Version.ID, currentProjectID)
	}
	return fmt.Sprintf("/automations/%s?project_id=%s", card.Automation.ID, currentProjectID)
}
func automationCardSearchText(card models.AutomationCard) string { return strings.Join([]string{card.Automation.Name, card.Automation.Description, card.Version.AdapterKey, string(card.Automation.LifecycleState), string(card.Automation.HealthState)}, " ") }
func automationTime(value *time.Time, empty string) string { if value == nil { return empty }; return value.Local().Format("Jan 2, 3:04 PM") }
func automationGraphViewBox(nodes []models.AutomationNode) string { if len(nodes) == 0 { return "-60 -60 900 540" }; minX, minY := automationGraphLayoutX(nodes[0].PositionX), automationGraphLayoutY(nodes[0].PositionY); maxX, maxY := minX+automationGraphNodeWidth, minY+automationGraphNodeHeight; for _, node := range nodes { x, y := automationGraphLayoutX(node.PositionX), automationGraphLayoutY(node.PositionY); if x < minX { minX = x }; if y < minY { minY = y }; if x+automationGraphNodeWidth > maxX { maxX = x+automationGraphNodeWidth }; if y+automationGraphNodeHeight > maxY { maxY = y+automationGraphNodeHeight } }; return fmt.Sprintf("%.0f %.0f %.0f %.0f", minX-automationGraphPadding, minY-automationGraphPadding, maxX-minX+2*automationGraphPadding, maxY-minY+2*automationGraphPadding) }
func automationEdgeNodes(nodes []models.AutomationNode, edge models.AutomationEdge) (models.AutomationNode, models.AutomationNode, bool) { var source, target models.AutomationNode; var foundSource, foundTarget bool; for _, n := range nodes { if n.ID == edge.SourceNodeID { source, foundSource = n, true }; if n.ID == edge.TargetNodeID { target, foundTarget = n, true } }; return source, target, foundSource && foundTarget }
func automationNodeLabel(value string, limit int) string { r := []rune(value); if len(r) <= limit { return value }; return string(r[:limit-1]) + "…" }
func resourcesForAutomationNode(resources []models.AutomationResourceSummary, nodeID string) []models.AutomationResourceSummary { var out []models.AutomationResourceSummary; for _, resource := range resources { if resource.NodeID == nodeID { out = append(out, resource) } }; return out }

templ automationGraphThemeStyles() {
	<style>
		.automation-graph-edge { fill: none; stroke: oklch(var(--bc) / 0.35); vector-effect: non-scaling-stroke; }
			.automation-graph-edge--highlighted { stroke: oklch(var(--p)); }
			.automation-graph-edge--preview { stroke: oklch(var(--p)); stroke-width: 4; stroke-linecap: round; vector-effect: non-scaling-stroke; pointer-events: none; }
			.automation-graph-arrow { fill: oklch(var(--bc) / 0.45); }
			.automation-graph-preview-arrow { fill: oklch(var(--p)); }
		.automation-graph-node { fill: oklch(var(--b2)); stroke: oklch(var(--bc) / 0.3); vector-effect: non-scaling-stroke; }
		.automation-graph-node--failed { fill: oklch(var(--er) / 0.15); stroke: oklch(var(--er)); }
		.automation-graph-node--blocked { fill: oklch(var(--wa) / 0.15); stroke: oklch(var(--wa)); }
		.automation-graph-node--waiting { fill: oklch(var(--in) / 0.15); stroke: oklch(var(--in)); }
			.automation-graph-node--running { fill: oklch(var(--p) / 0.15); stroke: oklch(var(--p)); animation: automation-running-pulse 1.8s ease-in-out infinite; transform-box: fill-box; transform-origin: center; }
			@keyframes automation-running-pulse { 0%, 100% { stroke-opacity: 0.72; } 50% { stroke-opacity: 1; stroke-width: 5; } }
			@media (prefers-reduced-motion: reduce) { .automation-graph-node--running { animation: none; } }		.automation-graph-node--completed { fill: oklch(var(--su) / 0.15); stroke: oklch(var(--su)); }
		.automation-graph-label { fill: oklch(var(--bc)); pointer-events: none; }
		.automation-graph-label--primary { fill: oklch(var(--bc)); }
		.automation-graph-label--secondary { fill: oklch(var(--bc) / 0.7); }
		.automation-graph-label--muted { fill: oklch(var(--bc) / 0.6); }
		.automation-node-content { box-sizing: border-box; display: flex; height: 100%; width: 100%; flex-direction: column; align-items: center; justify-content: center; gap: 4px; padding: 10px 12px; color: oklch(var(--bc)); text-align: center; line-height: 1.15; overflow: hidden; }
		.automation-node-content strong { display: -webkit-box; max-width: 100%; overflow: hidden; overflow-wrap: anywhere; -webkit-box-orient: vertical; -webkit-line-clamp: 2; font-size: 13px; }
		.automation-node-content span { font-size: 10px; font-weight: 650; }
		.automation-node-content small { display: block; max-width: 100%; overflow: hidden; text-overflow: ellipsis; white-space: nowrap; color: oklch(var(--bc) / 0.65); font-size: 9px; }
		.automation-state-dot { display: inline-block; width: 0.65rem; height: 0.65rem; border-radius: 9999px; border: 2px solid oklch(var(--bc) / 0.4); }
		.automation-state-dot--failed { border-color: oklch(var(--er)); background: oklch(var(--er) / 0.35); }
		.automation-state-dot--blocked { border-color: oklch(var(--wa)); background: oklch(var(--wa) / 0.35); }
		.automation-state-dot--waiting { border-color: oklch(var(--in)); background: oklch(var(--in) / 0.35); }
		.automation-state-dot--running { border-color: oklch(var(--p)); background: oklch(var(--p) / 0.35); }
		.automation-state-dot--recently_completed { border-color: oklch(var(--su)); background: oklch(var(--su) / 0.35); }
		.automation-node-state--failed { color: oklch(var(--er)); }
		.automation-node-state--blocked { color: oklch(var(--wa)); }
		.automation-node-state--waiting { color: oklch(var(--in)); }
		.automation-node-state--running { color: oklch(var(--p)); }
		.automation-node-state--recently_completed { color: oklch(var(--su)); }
		.automation-canvas-shell svg { cursor: grab; }
		.automation-canvas-shell svg:active { cursor: grabbing; }
		.automation-canvas-shell .automation-draft-node { cursor: grab; }
			.automation-canvas-shell .automation-draft-node:active { cursor: grabbing; }
			.automation-connect-handle { fill: oklch(var(--p) / 0.7); stroke: oklch(var(--p)); stroke-width: 2; vector-effect: non-scaling-stroke; cursor: crosshair; }
			.automation-connect-handle--selected { fill: oklch(var(--p)); stroke-width: 4; }
			.automation-connect-handle--eligible { fill: oklch(var(--su)); stroke: oklch(var(--su)); opacity: 1; stroke-width: 4; }
			.automation-connect-handle:focus-visible { outline: none; stroke: oklch(var(--p)); stroke-width: 5; }
			.automation-edge-hit { fill: none; stroke: transparent; stroke-width: 16; vector-effect: non-scaling-stroke; cursor: pointer; }
			.automation-draft-edge:focus { outline: none; }
			.automation-draft-edge [data-edge-line] { pointer-events: none; }
			.automation-edge-endpoint, .automation-edge-delete { opacity: 0; pointer-events: none; }
			.automation-draft-edge--selected .automation-graph-edge { stroke: oklch(var(--p)); stroke-width: 3; }			.automation-draft-edge--selected .automation-edge-endpoint, .automation-draft-edge--selected .automation-edge-delete, .automation-draft-edge:focus-within .automation-edge-endpoint, .automation-draft-edge:focus-within .automation-edge-delete { opacity: 1; pointer-events: auto; }
			.automation-edge-endpoint { fill: oklch(var(--p)); stroke: oklch(var(--b1)); stroke-width: 2; vector-effect: non-scaling-stroke; cursor: crosshair; }
			.automation-edge-delete circle, .automation-node-delete circle { fill: oklch(var(--er)); stroke: oklch(var(--b1)); stroke-width: 2; vector-effect: non-scaling-stroke; }
			.automation-edge-delete text, .automation-node-delete text { fill: oklch(var(--b1)); font-size: 15px; font-weight: 700; pointer-events: none; }
			.automation-edge-delete, .automation-node-delete { cursor: pointer; }
			.automation-edge-delete:focus-visible, .automation-node-delete:focus-visible { outline: none; }
			.automation-edge-delete:focus-visible circle, .automation-node-delete:focus-visible circle { stroke: oklch(var(--bc)); stroke-width: 4; }
			.automation-graph-link:focus-visible .automation-graph-node,
		.automation-graph-focus:focus-visible .automation-graph-node { stroke-width: 4; }
	</style>
}

templ automationViewTabs(automationID string, currentProjectID string, active string) {
	<nav class="tabs tabs-boxed mb-5 w-fit max-w-full overflow-x-auto bg-base-200/70 p-1" role="tablist" aria-label="Automation views">
		<a role="tab" class={ "tab min-h-11 px-5", templ.KV("tab-active", active == "live") } aria-selected={ fmt.Sprintf("%t", active == "live") } data-automation-view="live" href={ templ.URL(fmt.Sprintf("/automations/%s?project_id=%s", automationID, currentProjectID)) } hx-get={ fmt.Sprintf("/automations/%s?project_id=%s", automationID, currentProjectID) } hx-target="#main-content" hx-push-url="true" onclick="event.preventDefault(); event.stopImmediatePropagation(); window.openVibelyNavigate(this.getAttribute('href')); return false;">Live</a>
		<a role="tab" class={ "tab min-h-11 px-5", templ.KV("tab-active", active == "history") } aria-selected={ fmt.Sprintf("%t", active == "history") } data-automation-view="history" href={ templ.URL(fmt.Sprintf("/automations/%s/history?project_id=%s", automationID, currentProjectID)) } hx-get={ fmt.Sprintf("/automations/%s/history?project_id=%s", automationID, currentProjectID) } hx-target="#main-content" hx-push-url="true" onclick="event.preventDefault(); event.stopImmediatePropagation(); window.openVibelyNavigate(this.getAttribute('href')); return false;">History</a>
		<a role="tab" class={ "tab min-h-11 px-5", templ.KV("tab-active", active == "definition") } aria-selected={ fmt.Sprintf("%t", active == "definition") } data-automation-view="definition" href={ templ.URL(fmt.Sprintf("/automations/%s/definition?project_id=%s", automationID, currentProjectID)) } hx-get={ fmt.Sprintf("/automations/%s/definition?project_id=%s", automationID, currentProjectID) } hx-target="#main-content" hx-push-url="true" onclick="event.preventDefault(); event.stopImmediatePropagation(); window.openVibelyNavigate(this.getAttribute('href')); return false;">Definition</a>
	</nav>
}
