package pages

import (
 "fmt"
 templateui "github.com/openvibely/openvibely/web/templates"
 "github.com/openvibely/openvibely/internal/models"
 "github.com/openvibely/openvibely/internal/persistence"
 "github.com/openvibely/openvibely/web/templates/components"
)

func detailPointerValue(value *string) string { if value == nil { return "" }; return *value }

templ taskTagCreateRow() {
 <div data-options="tag" class="ov-menu-create-row" hidden>
  <button type="button" data-custom-tag data-value="" class={ templateui.SearchableSelectorOptionClass } hidden>
   @templateui.SearchableSelectorCreateIcon()
   <span class="truncate"></span>
  </button>
 </div>
}

templ TaskPropertyRow(label, field, value, text string) {
 <button type="button" class="task-property-row inspector-property-row" data-detail-property={ field } data-value={ value } aria-haspopup="dialog">
  if field == "tag" && value != "" {
  <span class="opacity-60">{ label + ":" }</span>
  <span data-property-label class={ "badge badge-sm", components.TagBadgeClass(models.TaskTag(value)) }>{ text }</span><span aria-hidden="true">›</span>
 } else {
  @components.InspectorPropertyContent(label, text)
 }
 </button>
}

templ TaskAutoMergeSwitches(task *models.Task) {
 <div class="form-control mt-2">
  for _, option := range []struct{ Name, Label string; Checked bool }{
   {"auto_merge", "Auto-merge on successful completion", task.AutoMerge},
   {"auto_merge_on_goal_achieved", "Auto-merge when goal is achieved", task.AutoMergeOnGoalAchieved},
  } {
   <label class="label cursor-pointer justify-start gap-2">
    <input type="checkbox" name={ option.Name } class="toggle toggle-sm toggle-primary shrink-0" checked?={ option.Checked } data-auto-merge-toggle/>
    <span class="label-text">{ option.Label }</span>
   </label>
  }
 </div>
}

templ TaskAutoMergePanel(task *models.Task) {
 <section id="task-auto-merge-panel" class="mb-4">
  <h3 class="text-sm font-semibold">Auto-merge</h3>
  @TaskAutoMergeSwitches(task)
  <p data-auto-merge-error role="alert" class="text-error text-sm"></p>
 </section>
}

templ TaskDetailEditors(task *models.Task, agents []models.LLMConfig, definitions []persistence.AgentTaskUIOption) {
 @components.InspectorPicker("task-property-picker", taskTagCreateRow()) {
   if task.ID == "" {
    <div data-options="destination_project">
     for _, project := range templateui.ProjectOptions(ctx) {
      <button type="button" data-value={ project.ID } class="ov-menu-option w-full">{ project.Name }</button>
     }
    </div>
   }
   <div data-options="agent_id">
    <button type="button" data-value="default" class="ov-menu-option w-full">Default</button>
    <button type="button" data-value="" class="ov-menu-option w-full">Auto</button>
    for _, model := range agents {
     <button type="button" data-value={ model.ID } class="ov-menu-option w-full">{ model.Name }</button>
    }
   </div>
   <div data-options="agent_definition_id">
    <button type="button" data-value="" class="ov-menu-option w-full">No agent</button>
    for _, agent := range definitions {
     if agent.Enabled && agent.SelectableAsPrimary && agent.GeneratedStatus != models.AgentStatusArchived && agent.ArchivedAt == nil {
      <button type="button" data-value={ agent.ID } data-agent-scope={ string(agent.Scope) } data-agent-project={ agent.ProjectID } class="ov-menu-option w-full">{ agent.Name }</button>
     }
    }
   </div>
   <div data-options="category">
    for _, category := range models.SelectableCategories {
     <button type="button" data-value={ string(category) } class="ov-menu-option w-full">{ string(category) }</button>
    }
   </div>
   <div data-options="priority">
    for i, label := range []string{"Low", "Normal", "High", "Urgent"} {
     <button type="button" data-value={ fmt.Sprint(i+1) } class="ov-menu-option w-full">{ label }</button>
    }
   </div>
   <p data-tag-loading role="status" class="px-3 py-2 text-sm opacity-60" hidden>Loading tags…</p>
   <div data-options="tag" data-prefer-exact-value data-default-badge={ components.TagBadgeClass(models.TagFeature) }>
    <button type="button" data-clear-tag data-value="" class="ov-menu-option w-full">Clear tag</button>
    for _, option := range []struct{ Value, Label string }{{"feature", "Feature"}, {"bug", "Bug"}} {
     <button type="button" data-value={ option.Value } data-badge={ components.TagBadgeClass(models.TaskTag(option.Value)) } class="ov-menu-option w-full">{ option.Label }</button>
    }

   </div>
 }
 @components.InspectorDialog("task-detail-text-editor", "") {
   <form method="post">
    <textarea aria-label="Value" class="textarea textarea-bordered w-full h-48" required></textarea>
    <p data-editor-error role="alert" class="text-error text-sm"></p>
    <div class="modal-action"><button type="button" class="btn btn-ghost" data-goal-action="pause" hidden>Pause</button><button type="button" class="btn btn-ghost" data-goal-action="resume" hidden>Resume</button><button type="button" class="btn btn-outline btn-error" data-goal-action="clear" hidden>Clear goal</button><button type="button" class="btn btn-ghost" data-editor-cancel>Cancel</button><button type="submit" class="btn btn-primary">Save</button></div>
   </form>
 }
 <script>
 (function() {
  var root = document.getElementById('task-detail-content');
  var picker = root.querySelector('#task-property-picker'), dialog = root.querySelector('#task-detail-text-editor');
  var current = null, field = '', busy = false, revision = 0;
  var search = picker.querySelector('.ov-menu-search input');
  var createTag = picker.querySelector('[data-custom-tag]');
  var tags = picker.querySelector('.ov-menu-list [data-options="tag"]');
  function customTagOption(value) {
   var option = document.createElement('button');
   option.type = 'button';
   option.className = 'ov-menu-option w-full';
   option.dataset.customOption = '';
   option.dataset.value = value;
   option.textContent = value;
   return option;
  }
  var tagLoading = picker.querySelector('[data-tag-loading]');
  var tagRequest = 0, tagsLoaded = false;
  async function refreshTags(row) {
   var request = ++tagRequest;
   var scope = destination?.value || projectID;
   try {
    var response = await fetch('/api/tasks/tags?project_id=' + encodeURIComponent(scope));
    if (!response.ok) throw new Error();
    var values = await response.json();
    if (request !== tagRequest || !root.isConnected || !pickerOpen() || current !== row) return;
    var currentValue = pickerUI.searchPattern(row.dataset.value, true);
    var options = document.createDocumentFragment();
    for (var value of values) {
     if (!currentValue.test(value)) options.appendChild(customTagOption(value));
    }
    tags.appendChild(options);
    tagsLoaded = true;
    tagLoading.hidden = true;
    tags.hidden = false;
    search.dispatchEvent(new Event('input'));
   } catch (_) {
    if (request !== tagRequest || current !== row || !pickerOpen()) return;
    tagLoading.hidden = true;
    tags.hidden = false;
    search.dispatchEvent(new Event('input'));
    picker.querySelector('[data-property-error]').textContent = 'Could not refresh project tags.';
   }
  }
  function updateTagAction() {
   var query = search.value.trim();
   createTag.dataset.value = query;
   createTag.querySelector('span').textContent = 'Add tag “' + query + '”';
  }
  search.addEventListener('input', updateTagAction);
  var pickerUI = window.createInspectorPicker(root, picker, function() { return busy; }, available);
  search.addEventListener('keydown', function(event) {
   if (event.key !== 'Enter' || event.isComposing || event.keyCode === 229 || field !== 'tag' || tagsLoaded) return;
   var query = search.value.trim();
   var highlighted = tags.querySelector('[data-active]');
   if (query && (!highlighted || !pickerUI.searchPattern(query, true).test(highlighted.dataset.value))) {
    event.preventDefault();
   }
  });
  var pickerOpen = pickerUI.isOpen, hidePicker = pickerUI.close, returnToRow = pickerUI.returnFocus;
  root.addEventListener('htmx:beforeRequest', function(event) { if (event.detail.elt.id === 'task-detail-metrics') event.detail.xhr.detailRevision = revision; });
  var taskID = root.dataset.taskId, projectID = root.dataset.projectId;
  var destination = root.querySelector('#new-task-project');
  function available(option) {
   if (option.hasAttribute('data-clear-tag')) return !search.value.trim();
   if (option === createTag) {
    var query = search.value.trim();
    if (field !== 'tag' || !tagsLoaded || !query) return false;
    var exact = pickerUI.searchPattern(query, true);
    return !Array.from(tags.children).some(tag => exact.test(tag.dataset.value));
   }
   return !destination || option.dataset.agentScope !== 'project' || (!!destination.value && option.dataset.agentProject === destination.value);
  }
  if (destination) destination.addEventListener('change', function() {
   hidePicker();
   var input = root.querySelector('[data-draft-property="agent_definition_id"]');
   var selectedOption = Array.from(picker.querySelectorAll('[data-options="agent_definition_id"] button')).find(function(option) { return option.dataset.value === input.value; });
   if (input.value && (!selectedOption || !available(selectedOption))) {
    input.value = '';
    var row = root.querySelector('[data-detail-property="agent_definition_id"]');
    row.dataset.value = '';
    row.querySelector('[data-property-label]').textContent = 'No agent';
   }

  });
  function composerModel(value, label) {
   var input = root.querySelector('#task-thread-form-agent-id'), button = root.querySelector('#task-thread-form-agent-select');
   if (input) input.value = value || 'auto';
   if (button) { button.dataset.currentValue = value || 'auto'; var text = button.querySelector('.chat-custom-select-label'); if (text) text.textContent = label; }
  }
  async function save(name, value, action) {
   revision++;
   var path = name === 'goal' ? '/goal' + (action ? '/' + action : '') : '/details/property';
   var body = new URLSearchParams(name === 'goal' ? {goal:value} : {field:name,value:value});
   var response = await fetch('/tasks/' + encodeURIComponent(taskID) + path + '?project_id=' + encodeURIComponent(projectID), {method:name === 'goal' ? 'POST' : 'PATCH',headers:{'Content-Type':'application/x-www-form-urlencoded'},body:body});
   if (await window.openVibelyPermissionErrors?.fetch(response)) { var denied = new Error('Permission denied'); denied.toastOnly = true; throw denied; }
   if (!response.ok) { var error = await response.text(); try { error = JSON.parse(error).message || error; } catch (_) {} throw new Error(error); }
   var html = await response.text();
   var editInput = root.querySelector('#task-detail-edit [name="' + name + '"]');
   if (editInput) editInput.value = value;
   var target = root.querySelector(name === 'goal' ? '#task-goal-panel' : name === 'prompt' ? '#task-prompt-panel' : name.startsWith('auto_merge') ? '#task-auto-merge-panel' : '#task-detail-metrics');
   if (target && root.isConnected) { var fragment = document.createElement('template'); fragment.innerHTML = html; var replacement = fragment.content.firstElementChild; target.replaceWith(replacement); if (window.htmx) htmx.process(replacement); }
  }
  root.addEventListener('change', async function(event) {
   var input = event.target.closest('[data-auto-merge-toggle]');
   if (!input || !taskID) return;
   if (busy) { input.checked = !input.checked; return; }
   var panel = input.closest('#task-auto-merge-panel');
   busy = true;
   panel.querySelector('[data-auto-merge-error]').textContent = '';
   panel.querySelectorAll('input').forEach(function(control) { control.disabled = true; });
   try { await save(input.name, String(input.checked)); }
   catch (error) { input.checked = !input.checked; if (!error.toastOnly) panel.querySelector('[data-auto-merge-error]').textContent = error.message; }
   finally { busy = false; panel.querySelectorAll('input').forEach(function(control) { control.disabled = false; }); }
  });
  root.addEventListener('click', function(event) {
   if (busy && event.target.closest('[data-detail-property], [data-detail-editor]')) { event.preventDefault(); return; }
   var row = event.target.closest('[data-detail-property]');
   if (row) {
    current = row; field = row.dataset.detailProperty;
    picker.querySelectorAll('[data-options]').forEach(function(group) { group.hidden = group.dataset.options !== field; });
    tagLoading.hidden = field !== 'tag';
    if (field === 'tag') {
     tags.hidden = true;
     tagsLoaded = false;
     tags.querySelectorAll('[data-custom-option]').forEach(option => option.remove());
     var value = row.dataset.value;
     var exact = pickerUI.searchPattern(value, true);
     if (value && !Array.from(tags.children).some(option => exact.test(option.dataset.value))) {
      tags.appendChild(customTagOption(value));
     }
    }
    search.placeholder = field === 'tag' ? 'Search tags' : 'Search…';
    search.setAttribute('aria-label', field === 'tag' ? 'Search tags' : 'Search options');
    pickerUI.open(row);
    if (field === 'tag' && pickerOpen()) refreshTags(row);
    return;
   }
   var editor = event.target.closest('[data-detail-editor]');
   if (!editor) return;
   current = editor; field = editor.dataset.detailEditor;
   dialog.querySelector('[data-editor-title]').textContent = field === 'goal' ? 'Goal' : 'Prompt';
   dialog.querySelector('textarea').value = editor.dataset.value || '';
   dialog.querySelector('textarea').required = field !== 'goal';
   dialog.querySelectorAll('[data-goal-action]').forEach(function(button) {
    var status = editor.dataset.goalStatus;
    button.hidden = field !== 'goal' || !taskID || !editor.dataset.value || (button.dataset.goalAction === 'pause' && status !== 'active') || (button.dataset.goalAction === 'resume' && status !== 'blocked' && !String(status).toLowerCase().startsWith('paused'));
   });
   dialog.querySelector('[data-editor-error]').textContent = '';
   dialog.showModal(); dialog.querySelector('textarea').focus();
  });
  picker.addEventListener('click', async function(event) {
   var option = event.target.closest('button[data-value], button[data-custom-tag]'); if (!option || busy) return;
   var name = field, value = option.dataset.value;
   var label = option === createTag ? value : option.textContent;
   busy = true; picker.querySelectorAll('button').forEach(function(button) { button.disabled = true; });
   try {
    if (taskID) await save(name, value);
    else {
     var input = root.querySelector('[data-draft-property="' + name + '"]'); if (input) { input.value = value; if (name === 'destination_project') input.dispatchEvent(new Event('change', {bubbles:true})); }
     current.dataset.value = value;
     var propertyLabel = current.querySelector('[data-property-label]');
     propertyLabel.textContent = option.hasAttribute('data-clear-tag') ? 'No tag' : label;
     if (name === 'tag') propertyLabel.className = value ? 'badge badge-sm ' + (option.dataset.badge || tags.dataset.defaultBadge) : '';
    }
    if (name === 'agent_id') composerModel(value, label);
    hidePicker(); var row = root.querySelector('[data-detail-property="' + name + '"]'); returnToRow(row);
   } catch (error) { if (!error.toastOnly) picker.querySelector('[data-property-error]').textContent = error.message; }
   finally { busy = false; picker.querySelectorAll('button').forEach(function(button) { button.disabled = false; }); }
  });
  dialog.querySelectorAll('[data-goal-action]').forEach(function(button) {
   button.onclick = async function() {
    if (busy) return;
    busy = true;
    dialog.querySelectorAll('button').forEach(function(control) { control.disabled = true; });
    try { await save('goal', '', button.dataset.goalAction); dialog.close(); }
    catch (error) { if (!error.toastOnly) dialog.querySelector('[data-editor-error]').textContent = error.message; }
    finally { busy = false; dialog.querySelectorAll('button').forEach(function(control) { control.disabled = false; }); }
   };
  });
  dialog.querySelector('[data-editor-cancel]').onclick = function() { dialog.close(); };
  dialog.querySelector('form').addEventListener('submit', async function(event) {
   event.preventDefault(); if (busy) return; busy = true;
   var button = dialog.querySelector('[type="submit"]'); button.disabled = true;
   try {
    var value = dialog.querySelector('textarea').value;
    if (taskID) await save(field, value, field === 'goal' && !value.trim() ? 'clear' : '');
    else { root.querySelector('[data-draft-property="goal"]').value = value; current.dataset.value = value; current.textContent = value ? 'Edit' : '+'; }
    dialog.close();
    var trigger = root.querySelector('[data-detail-editor="' + field + '"]'); if (trigger) trigger.focus({preventScroll:true});
   } catch (error) { if (!error.toastOnly) dialog.querySelector('[data-editor-error]').textContent = error.message; }
   finally { busy = false; button.disabled = false; }
  });
  // Do not replace rows underneath an open picker; the following poll reconciles them.
  root.addEventListener('htmx:beforeSwap', function(event) { if (event.detail.target.id === 'task-detail-metrics' && (pickerOpen() || busy || event.detail.xhr.detailRevision !== revision)) event.preventDefault(); });
  root.addEventListener('chat-select-change', function(event) {
   if (!taskID && event.target.id === 'task-thread-form-agent-select') {
    var row = root.querySelector('[data-detail-property="agent_id"]'), value = event.detail.value;
    var option = Array.from(picker.querySelectorAll('[data-options="agent_id"] button')).find(function(item) { return item.dataset.value === value; });
    row.dataset.value = option ? value : ''; row.querySelector('[data-property-label]').textContent = option ? option.textContent : 'Auto';
   }
  });
 })();
 </script>
}
