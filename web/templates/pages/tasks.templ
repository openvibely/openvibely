package pages

import (
	"fmt"
	"github.com/openvibely/openvibely/internal/models"
	"github.com/openvibely/openvibely/internal/repository"
	"github.com/openvibely/openvibely/web/templates/layout"
	"github.com/openvibely/openvibely/web/templates/components"
)

func getProjectID(project *models.Project, projects []models.Project) string {
	if project != nil {
		return project.ID
	}
	if len(projects) > 0 {
		return projects[0].ID
	}
	return ""
}

templ Tasks(projects []models.Project, project *models.Project, tasks []models.Task, agents []models.LLMConfig, agentDefs []repository.AgentTaskUIOption, backlogSort string, completedSort string, menuStates ...map[string]components.TaskCardMergeMenuState) {
	@layout.Base("Tasks", projects, getProjectID(project, projects)) {
		@TasksContent(project, tasks, agents, agentDefs, backlogSort, completedSort, menuStates...)
	}
}

templ TasksContent(project *models.Project, tasks []models.Task, agents []models.LLMConfig, agentDefs []repository.AgentTaskUIOption, backlogSort string, completedSort string, menuStates ...map[string]components.TaskCardMergeMenuState) {
	<div class="flex flex-col h-full min-h-0 overflow-x-hidden overflow-y-hidden">
		@layout.PageTitle("Tasks")
		<div data-page-header class="flex items-center justify-between mb-6 flex-shrink-0">
			<h2 class="text-2xl font-bold">Tasks</h2>
			<div class="flex items-center gap-2">
				if project != nil {
					@kanbanSearch()
				}
				<a class="btn btn-primary btn-sm" href={ templ.URL("/tasks/new?project_id=" + getProjectID(project, nil)) } hx-get={ "/tasks/new?project_id=" + getProjectID(project, nil) } hx-target="#main-content" hx-push-url="true">
					+ Add Task
				</a>
			</div>
		</div>

		if project != nil {
			<div id="tasks-page" data-project-id={ project.ID } class="flex-1 min-h-0 overflow-x-hidden overflow-y-auto lg:overflow-y-hidden">
			<!-- Kanban Board -->
			@components.KanbanBoard(tasks, project.ID, backlogSort, completedSort, agents, agentDefs, menuStates...)
			</div>
		}
	</div>

	<!-- Delete All Tasks Dialog -->
	if project != nil {
		@DestructiveConfirmDialog("delete_all_tasks_confirm_modal", "Close delete all tasks confirmation", "Delete Tasks", "Are you sure you want to delete ", "delete_all_tasks_confirm_name", "", "? This action cannot be undone.", templ.ComponentScript{Call: "delete_all_tasks_confirm_modal.close()"}, templ.ComponentScript{Call: "confirmDeleteAllTasks()"}) {
			The selected tasks will be permanently deleted.
		}


	}

	<!-- Task card merge, rebase, and pull request actions execute directly. -->
	if project != nil {
		<script>
			function setTaskCardActionBusy(taskID, busy) {
				var card = document.getElementById('task-' + taskID);
				if (!card) return;
				if (busy) card.setAttribute('aria-busy', 'true');
				else card.removeAttribute('aria-busy');
			}

			function taskCardActionResponseHasToast(xhr) {
				if (!xhr || !xhr.getResponseHeader) return false;
				return ['HX-Trigger', 'HX-Trigger-After-Swap', 'HX-Trigger-After-Settle'].some(function(header) {
					var value = xhr.getResponseHeader(header);
					if (!value) return false;
					try {
						var payload = JSON.parse(value);
						return !!(payload && Object.prototype.hasOwnProperty.call(payload, 'openvibelyToast'));
					} catch (_) {
						return value.split(',').some(function(eventName) { return eventName.trim() === 'openvibelyToast'; });
					}
				});
			}

			function showTaskCardActionFallbackFailure(request, xhr) {
				var status = xhr && xhr.status || 0;
				if (status >= 200 && status < 300) return;
				if (taskCardActionResponseHasToast(xhr) || !window.showToast) return;
				var label = request.label || 'Task action';
				window.showToast(label + ' could not be completed. Review the latest task state and try again.', 'failed', '', {
					toastKey: 'task-card-action-failure-' + request.taskID + '-' + request.path
				});
			}

			function restoreTaskCardActionFocus(taskID) {
				var card = document.getElementById('task-' + taskID);
				var trigger = card && card.querySelector('[data-task-card-menu-trigger]');
				var dropdown = trigger && trigger.closest('[data-kanban-menu-key]');
				if (window.closeKanbanMenu) window.closeKanbanMenu(dropdown, !!trigger);
			}

			function runTaskCardAction(button) {
				if (!button || !window.htmx || window._taskCardActionRequest || window.kanbanBatchRunning) return;
				if (!button.hasAttribute('data-task-card-merge-action') && !button.hasAttribute('data-task-card-pr-action')) return;
				var taskID = button.dataset.taskId || '';
				var projectID = button.dataset.projectId || '';
				var mode = button.dataset.mergeType || '';
				var endpoint = button.dataset.mergeEndpoint || '';
				if (!taskID || !projectID || !mode || !endpoint) return;
				var path = '/tasks/' + encodeURIComponent(taskID) + '/worktree/' + endpoint;
				var dropdown = window.kanbanDropdownForTarget ? window.kanbanDropdownForTarget(button) : button.closest('[data-kanban-menu-key]');
				window._taskCardActionRequest = {path: path, taskID: taskID, label: button.dataset.mergeLabel || 'Task action'};
				setTaskCardActionBusy(taskID, true);
				if (window.closeKanbanMenu) window.closeKanbanMenu(dropdown, false);
				var target = button.hasAttribute('data-task-card-merge-action') ? '#task-' + CSS.escape(taskID) : '#kanban-board';
				htmx.ajax('POST', path, {
					target: target,
					swap: 'outerHTML',
					values: {merge_type: mode, merge_source: 'task_card', project_id: projectID}
				});
			}

			if (!window._taskCardActionHandlerAttached) {
				window._taskCardActionHandlerAttached = true;
				document.body.addEventListener('click', function(event) {
					var button = event.target && event.target.closest ? event.target.closest('[data-task-card-merge-action], [data-task-card-pr-action]') : null;
					if (!button || button.disabled) return;
					event.preventDefault();
					runTaskCardAction(button);
				}, true);
				document.body.addEventListener('htmx:afterRequest', function(event) {
					var request = window._taskCardActionRequest;
					var config = event.detail && event.detail.requestConfig;
					if (!request || !config || config.path !== request.path) return;
					window._taskCardActionRequest = null;
					setTaskCardActionBusy(request.taskID, false);
					showTaskCardActionFallbackFailure(request, event.detail && event.detail.xhr);
					window.dispatchEvent(new CustomEvent('kanban-refresh-unblocked'));
					restoreTaskCardActionFocus(request.taskID);
				});
			}
		</script>
	}

	<!-- New Task Dialog -->
	if project != nil {
			<dialog id="new_task_modal" class="modal">
				<div class="modal-box">
					@ModalCloseButton("new_task_modal", "Close new task dialog")
					<h3 class="font-bold text-lg mb-4 pr-10">New Task</h3>
					<form
						data-new-task-form
						method="post"
						hx-post={ fmt.Sprintf("/tasks?project_id=%s", project.ID) }
						hx-target="#kanban-board"
						hx-swap="outerHTML"
						hx-encoding="multipart/form-data"
					>
						<div class="form-control mb-3">
							<label class="label"><span class="label-text">Title</span></label>
							<input type="text" name="title" id="task-title-input" class="input input-bordered" required placeholder="Task title"/>
							<div id="title-error" class="hidden mt-2 flex items-center gap-2 text-error text-sm">
								<svg xmlns="http://www.w3.org/2000/svg" class="h-5 w-5 flex-shrink-0" fill="none" viewBox="0 0 24 24" stroke="currentColor">
									<path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 9v2m0 4h.01m-6.938 4h13.856c1.54 0 2.502-1.667 1.732-3L13.732 4c-.77-1.333-2.694-1.333-3.464 0L3.34 16c-.77 1.333.192 3 1.732 3z"></path>
								</svg>
								<span id="title-error-message"></span>
							</div>
						</div>
							<div class="form-control mb-3">
								<label class="label"><span class="label-text">Prompt</span></label>
								<textarea name="prompt" class="textarea textarea-bordered h-32" required placeholder="The prompt/instruction for the model to execute"></textarea>
							</div>
							@NewTaskOptions(agents, agentDefs)
						<!-- Attachment field -->
								<div class="form-control mt-3">
							<label class="label">
								<span class="label-text">Attachments (optional)</span>
								<span class="label-text-alt text-xs opacity-60">Max 10MB per file</span>
							</label>
							<input type="file" id="create-task-file-input" multiple class="file-input file-input-bordered file-input-sm"/>
							<input type="file" name="files" multiple class="hidden" id="create-task-files-hidden"/>
							<div id="create-task-file-list" class="mt-2 space-y-1"></div>
						</div>
						<div class="modal-action">
							<button type="button" class="btn" onclick="new_task_modal.close()">Cancel</button>
							<button type="submit" class="btn btn-primary">Create Task</button>
						</div>
					</form>
				</div>
				<form method="dialog" class="modal-backdrop">
					<button>close</button>
				</form>
			</dialog>

			

			<script type="text/javascript">
				// Auto-load task dialog if task_id is in URL (e.g., from alert navigation)
				(function() {
					const urlParams = new URLSearchParams(window.location.search);
					const taskId = urlParams.get('task_id');
					if (taskId) {
						// Navigate to the task detail page
						window.openVibelyNavigate('/tasks/' + taskId);
					}
				})();

				// File accumulator for create task dialog
				(function() {
					const fileInput = document.getElementById('create-task-file-input');
					const hiddenInput = document.getElementById('create-task-files-hidden');
					const fileListDiv = document.getElementById('create-task-file-list');
					if (!fileInput || !hiddenInput || !fileListDiv) return;

					let accumulatedFiles = [];

					function formatSize(bytes) {
						if (bytes < 1024) return bytes + ' B';
						if (bytes < 1024 * 1024) return (bytes / 1024).toFixed(1) + ' KB';
						return (bytes / (1024 * 1024)).toFixed(1) + ' MB';
					}

					function syncHiddenInput() {
						const dt = new DataTransfer();
						accumulatedFiles.forEach(function(f) { dt.items.add(f); });
						hiddenInput.files = dt.files;
					}

					function renderFileList() {
						fileListDiv.innerHTML = '';
						accumulatedFiles.forEach(function(file, idx) {
							var div = document.createElement('div');
							div.className = 'flex items-center justify-between p-1.5 bg-base-200 rounded text-sm';
							div.innerHTML = '<span class="truncate mr-2">' + file.name + ' <span class="opacity-60">(' + formatSize(file.size) + ')</span></span>';
							var btn = document.createElement('button');
							btn.type = 'button';
							btn.className = 'btn btn-ghost btn-xs text-error';
							btn.textContent = '\u2715';
							btn.onclick = function() {
								accumulatedFiles.splice(idx, 1);
								syncHiddenInput();
								renderFileList();
							};
							div.appendChild(btn);
							fileListDiv.appendChild(div);
						});
					}

					fileInput.addEventListener('change', function() {
						for (var i = 0; i < this.files.length; i++) {
							// Skip duplicates by name+size
							var f = this.files[i];
							var isDupe = accumulatedFiles.some(function(af) {
								return af.name === f.name && af.size === f.size;
							});
							if (!isDupe) {
								accumulatedFiles.push(f);
							}
						}
						syncHiddenInput();
						renderFileList();
						this.value = '';
					});

					// Reset accumulated files when modal closes
					var modal = document.getElementById('new_task_modal');
					if (modal) {
						modal.addEventListener('close', function() {
							accumulatedFiles = [];
							syncHiddenInput();
							renderFileList();
						});
					}
				})();

					// Show swarm sub-options only when swarm mode is enabled.
					(function() {
						var toggle = document.getElementById('create-task-swarm-mode-toggle');
						var options = document.getElementById('create-task-swarm-options');
						if (!toggle || !options) return;

						function syncSwarmOptionsVisibility() {
							options.classList.toggle('hidden', !toggle.checked);
						}

						toggle.addEventListener('change', syncSwarmOptionsVisibility);
						toggle.form?.addEventListener('reset', function() {
							setTimeout(syncSwarmOptionsVisibility, 0);
						});
						syncSwarmOptionsVisibility();
					})();

					// Track unsaved changes in the new task modal
					(function() {
						const modal = document.getElementById('new_task_modal');
						if (!modal) return;
					let hasChanges = false;
					const form = modal.querySelector('form');

					if (form) {
						form.addEventListener('input', function() {
							hasChanges = true;
						});

						modal.addEventListener('close', function() {
							hasChanges = false;
						});
					}

					// Warn before navigating away with unsaved changes
					window.addEventListener('beforeunload', function(event) {
						if (modal.open && hasChanges) {
							const message = 'You have unsaved changes in the task form. Are you sure you want to leave?';
							event.preventDefault();
							event.returnValue = message;
							return message;
						}
					});
				})();

				// Listen to real-time task events from sidebar's shared SSE connection.
				// This avoids creating a duplicate EventSource (the sidebar already has one).
				(function() {
					const tasksPage = document.getElementById('tasks-page');
					if (!tasksPage) return;

					const projectID = tasksPage.getAttribute('data-project-id');
					const backgroundRefreshPath = '/tasks?project_id=' + encodeURIComponent(projectID) + '&refresh_source=sse';
					let refreshTimeout = null;
					let backgroundRefreshXHR = null;
					let foregroundBoardRequests = 0;
					// Deferred-refresh flag: when a refresh would interrupt the user
					// (modal, menu, action, drag, or hidden tab) we retain one
					// invalidation and retry after the blocker clears. The same gate
					// runs before the final swap so a request started before an
					// interaction cannot replace the board during that interaction.
					let pendingRefresh = false;

						function isRefreshBlocked() {
							if (window.kanbanBatchRunning) return 'batch';
							if (window.isDragging) return 'drag';
							if (window.hasPendingKanbanMoves && window.hasPendingKanbanMoves()) return 'task move';
							if (foregroundBoardRequests > 0) return 'board request';
							if (document.hidden) return 'hidden';						if (window._taskCardActionRequest) return 'task action';
						const board = document.getElementById('kanban-board');
						if (board && board.getAttribute('data-open-kanban-menu-key')) return 'task menu';
						const openModals = document.querySelectorAll('dialog[open]');
						if (openModals.length > 0) return 'modal';
						return '';
					}

					function isBackgroundRefreshEvent(event) {
						const requestConfig = event && event.detail && event.detail.requestConfig;
						return !!requestConfig && requestConfig.path === backgroundRefreshPath;
					}

					function isBoardRequestEvent(event) {
						const target = event && event.detail && event.detail.target;
						return !!target && target.id === 'kanban-board';
					}

					function handleBackgroundRefreshBeforeRequest(event) {
						if (isBackgroundRefreshEvent(event)) {
							backgroundRefreshXHR = event.detail.xhr;
							return;
						}
						if (!isBoardRequestEvent(event)) return;
						foregroundBoardRequests++;
						let interruptedRefresh = false;
						if (refreshTimeout) {
							clearTimeout(refreshTimeout);
							refreshTimeout = null;
							interruptedRefresh = true;
						}
						if (backgroundRefreshXHR) {
							const xhr = backgroundRefreshXHR;
							backgroundRefreshXHR = null;
							xhr.abort();
							interruptedRefresh = true;
						}
						if (interruptedRefresh) pendingRefresh = true;
					}

					function handleBackgroundRefreshAfterRequest(event) {
						if (isBackgroundRefreshEvent(event)) {
							if (event.detail.xhr === backgroundRefreshXHR) backgroundRefreshXHR = null;
							return;
						}
						if (!isBoardRequestEvent(event)) return;
						foregroundBoardRequests = Math.max(0, foregroundBoardRequests - 1);
						flushPendingRefresh();
					}

						function handleKanbanMoveStarted() {
							if (!backgroundRefreshXHR) return;
							pendingRefresh = true;
							const xhr = backgroundRefreshXHR;
							backgroundRefreshXHR = null;
							xhr.abort();
						}

						function handleKanbanMenuOpened() {
							if (!backgroundRefreshXHR) return;						pendingRefresh = true;
						const xhr = backgroundRefreshXHR;
						backgroundRefreshXHR = null;
						xhr.abort();
					}

					function handleBackgroundRefreshBeforeSwap(event) {
						const detail = event && event.detail;
						const target = detail && detail.target;
						const requestConfig = detail && detail.requestConfig;
						if (!target || target.id !== 'kanban-board' || !requestConfig || requestConfig.path !== backgroundRefreshPath) return;
						const blocker = isRefreshBlocked();
						if (!blocker) return;
						console.log('[SSE] Refresh response blocked by ' + blocker + ', deferring swap');
						detail.shouldSwap = false;
						pendingRefresh = true;
					}

					function scheduleRefresh(delay) {
						if (refreshTimeout) clearTimeout(refreshTimeout);
						refreshTimeout = setTimeout(function() {
							refreshTimeout = null;
							const blocker = isRefreshBlocked();
							if (blocker) {
								console.log('[SSE] Refresh blocked by ' + blocker + ', deferring');
								pendingRefresh = true;
								return;
							}
							pendingRefresh = false;
							htmx.ajax('GET', backgroundRefreshPath, {
								target: '#kanban-board',
								swap: 'outerHTML'
							});
						}, delay);
					}

					function flushPendingRefresh() {
						if (!pendingRefresh) return;
						if (isRefreshBlocked()) return;
						console.log('[SSE] Flushing deferred refresh');
						scheduleRefresh(50);
					}

						function handleTaskEvent(event) {
							const data = event.detail;
							console.log('[SSE] Received event:', data);

							if (data.type === 'task_thread_execution_started' || data.type === 'task_thread_input_applied') return;

							// Only refresh if the event is for a task in the current project
							if (data.project_id !== projectID) return;

						const blocker = isRefreshBlocked();
						if (blocker) {
							console.log('[SSE] Refresh blocked by ' + blocker + ', will retry on unblock');
							pendingRefresh = true;
							return;
						}

						// Debounce: clear any pending refresh and schedule a new one
						scheduleRefresh(500);
					}

					function handleSSEReconnected(event) {
						// On reconnect we may have missed events while disconnected.
						// Force a refresh so the kanban board re-syncs with server state.
						const detail = event && event.detail;
						if (detail && detail.reconnected === false) {
							// Initial connect — server state already matches the
							// page that was just rendered, no refresh needed.
							return;
						}
						console.log('[SSE] Live connection (re)established, resyncing kanban');
						if (isRefreshBlocked()) {
							pendingRefresh = true;
							return;
						}
						scheduleRefresh(100);
					}

					function handleVisibilityChange() {
						if (!document.hidden) flushPendingRefresh();
					}

					function handleDragEnd() {
						flushPendingRefresh();
					}

					function handleDialogClose(event) {
						if (event.target && event.target.tagName === 'DIALOG') {
							// Defer to next tick so the close finishes before we check open modals.
							setTimeout(flushPendingRefresh, 0);
						}
					}

					// Listen to events dispatched by the sidebar's shared SSE connection
					window.addEventListener('sse-task-event', handleTaskEvent);
					window.addEventListener('sse-live-connected', handleSSEReconnected);
						window.addEventListener('kanban-menu-opened', handleKanbanMenuOpened);
						window.addEventListener('kanban-move-started', handleKanbanMoveStarted);
						window.addEventListener('kanban-refresh-unblocked', flushPendingRefresh);
						document.body.addEventListener('htmx:beforeRequest', handleBackgroundRefreshBeforeRequest);					document.body.addEventListener('htmx:afterRequest', handleBackgroundRefreshAfterRequest);
					document.body.addEventListener('htmx:beforeSwap', handleBackgroundRefreshBeforeSwap);
					document.addEventListener('visibilitychange', handleVisibilityChange);
						document.addEventListener('dragend', handleDragEnd, true);
						document.addEventListener('drop', handleDragEnd, true);
						document.addEventListener('task-pointer-dragend', handleDragEnd);					// 'close' does not bubble; capture phase picks it up from <dialog>.
					document.addEventListener('close', handleDialogClose, true);

					// Clean up listeners when navigating away via HTMX
					document.body.addEventListener('htmx:beforeSwap', function(event) {
						if (event.detail.target && event.detail.target.id === 'main-content') {
							window.removeEventListener('sse-task-event', handleTaskEvent);
							window.removeEventListener('sse-live-connected', handleSSEReconnected);
								window.removeEventListener('kanban-menu-opened', handleKanbanMenuOpened);
								window.removeEventListener('kanban-move-started', handleKanbanMoveStarted);
								window.removeEventListener('kanban-refresh-unblocked', flushPendingRefresh);
								document.body.removeEventListener('htmx:beforeRequest', handleBackgroundRefreshBeforeRequest);							document.body.removeEventListener('htmx:afterRequest', handleBackgroundRefreshAfterRequest);
							document.body.removeEventListener('htmx:beforeSwap', handleBackgroundRefreshBeforeSwap);
							document.removeEventListener('visibilitychange', handleVisibilityChange);
							document.removeEventListener('dragend', handleDragEnd, true);
							document.removeEventListener('drop', handleDragEnd, true);
							document.removeEventListener('task-pointer-dragend', handleDragEnd);
							document.removeEventListener('close', handleDialogClose, true);
							if (refreshTimeout) clearTimeout(refreshTimeout);
						}
					});
				})();

				// Reset and open the new task modal
				function openNewTaskModal() {
					const modal = document.getElementById('new_task_modal');
					const form = modal.querySelector('form');
					const titleInput = document.getElementById('task-title-input');
					const titleError = document.getElementById('title-error');

						// Reset the form
						form.reset();
						setTimeout(function() {
							const swarmToggle = document.getElementById('create-task-swarm-mode-toggle');
							const swarmOptions = document.getElementById('create-task-swarm-options');
							if (swarmToggle && swarmOptions) {
								swarmOptions.classList.toggle('hidden', !swarmToggle.checked);
							}
						}, 0);

						// Clear any previous errors
						if (titleError) {
							titleError.classList.add('hidden');
						}
						if (titleInput) {
							titleInput.classList.remove('input-error');
						}
					// Open the modal
					modal.showModal();
				}


					// Handle HTMX response errors for duplicate task titles.
					document.body.addEventListener('htmx:responseError', function(event) {
						var source = event.detail && event.detail.elt;
						if (!source || !source.closest('form[data-new-task-form]')) return;
						const xhr = event.detail.xhr;

						// Check for 409 Conflict (duplicate task)
						if (xhr.status === 409) {
							event.preventDefault(); // Prevent default HTMX error handling

							const titleInput = document.getElementById('task-title-input');
							const titleError = document.getElementById('title-error');
							const titleErrorMessage = document.getElementById('title-error-message');

							if (titleInput && titleError && titleErrorMessage) {
								// Add error styling to input
								titleInput.classList.add('input-error');

								// Show error message
								titleErrorMessage.textContent = xhr.responseText || 'A task with this name already exists in this project';
								titleError.classList.remove('hidden');

								// Don't close the modal - keep it open so user can fix the error
								const modal = document.getElementById('new_task_modal');
								if (modal && !modal.open) {
									modal.showModal();
								}
							}
						}
					});

				// Clear error when user starts typing in the title field
				document.getElementById('task-title-input')?.addEventListener('input', function() {
					const titleError = document.getElementById('title-error');
					if (titleError && !titleError.classList.contains('hidden')) {
						titleError.classList.add('hidden');
						this.classList.remove('input-error');
					}
				});

				// Guard against duplicate handler registration from repeated HTMX navigation
				if (!window._tasksDialogHandlersAttached) {
					window._tasksDialogHandlersAttached = true;

					// Close modal on successful task creation
					document.body.addEventListener('htmx:afterSwap', function(event) {
						// Check if this was a successful task creation (kanban board updated)
						if (event.detail.target && event.detail.target.id === 'kanban-board') {
							const modal = document.getElementById('new_task_modal');
							if (modal && modal.open) {
								modal.close();
							}
						}
					});

					}
			</script>
		}
}

templ kanbanSearch() {
	<style>
		.kanban-search { display:flex; align-items:center; height:2rem; width:2rem; border-radius:9999px; overflow:hidden; transition:width .25s ease, background-color .25s ease, box-shadow .25s ease; }
		.kanban-search[data-open="true"] { width:min(16rem, 45vw); background:oklch(var(--b1)); box-shadow:0 1px 3px oklch(var(--bc) / .15), 0 0 0 1px oklch(var(--bc) / .12); }
		.kanban-search-toggle { flex:0 0 2rem; height:2rem; display:inline-flex; align-items:center; justify-content:center; border-radius:9999px; opacity:.7; transition:opacity .15s ease, background-color .15s ease, color .15s ease; }
		.kanban-search-toggle:hover { opacity:1; background:oklch(var(--bc) / .08); }
		.kanban-search-toggle:focus-visible { outline:none; opacity:1; box-shadow:inset 0 0 0 2px oklch(var(--p)); }
		.kanban-search[data-open="true"] .kanban-search-toggle:hover { background:transparent; }
		.kanban-search-input { flex:1 1 auto; min-width:0; height:100%; padding-right:.75rem; background:transparent; border:0; outline:none; font-size:.875rem; opacity:0; transition:opacity .2s ease; }
		.kanban-search[data-open="true"] .kanban-search-input { opacity:1; }
		.kanban-search-input::-webkit-search-cancel-button { -webkit-appearance:none; appearance:none; }
		.kanban-search-clear { flex:0 0 1.75rem; height:1.75rem; margin-right:.125rem; display:inline-flex; align-items:center; justify-content:center; border-radius:9999px; opacity:.6; transition:opacity .15s ease, background-color .15s ease; }
		.kanban-search-clear:hover { opacity:1; background:oklch(var(--bc) / .08); }
		.kanban-search-clear:focus-visible { outline:none; opacity:1; box-shadow:inset 0 0 0 2px oklch(var(--p)); }
		.kanban-search[data-open="false"] .kanban-search-clear, .kanban-search-input:placeholder-shown + .kanban-search-clear { display:none; }
		.kanban-search-input:not(:placeholder-shown) { padding-right:0; }
		@media (prefers-reduced-motion: reduce) { .kanban-search, .kanban-search-input { transition:none; } }
	</style>
	<div data-kanban-search data-open="false" class="kanban-search">
		<button type="button" data-kanban-search-toggle class="kanban-search-toggle" aria-label="Search tasks" aria-expanded="false" aria-controls="kanban-search-input">
			<svg xmlns="http://www.w3.org/2000/svg" class="h-4 w-4" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2" aria-hidden="true">
				<path stroke-linecap="round" stroke-linejoin="round" d="M21 21l-4.35-4.35M17 11a6 6 0 11-12 0 6 6 0 0112 0z"></path>
			</svg>
		</button>
		<input id="kanban-search-input" type="search" data-kanban-search-input class="kanban-search-input" placeholder="Search tasks" aria-label="Search tasks" autocomplete="off" tabindex="-1"/>
		<button type="button" data-kanban-search-clear class="kanban-search-clear" aria-label="Clear search">
			<svg xmlns="http://www.w3.org/2000/svg" class="h-3.5 w-3.5" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2" aria-hidden="true">
				<path stroke-linecap="round" stroke-linejoin="round" d="M6 18L18 6M6 6l12 12"></path>
			</svg>
		</button>
		<span data-kanban-search-status class="sr-only" role="status" aria-live="polite"></span>
	</div>
}
