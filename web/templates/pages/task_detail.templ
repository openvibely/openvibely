package pages

import (
	"fmt"
	"strings"

	"github.com/openvibely/openvibely/internal/models"
	"github.com/openvibely/openvibely/web/templates/components"
	"github.com/openvibely/openvibely/web/templates/layout"
)

// TaskChangesContent renders just the changes tab content (for HTMX partial updates)
templ TaskChangesContent(diffOutput string, taskID string, reviewComments []models.ReviewComment) {
	@TaskChangesContentWithView(diffOutput, taskID, reviewComments, "inline")
}

templ TaskChangesContentWithView(diffOutput string, taskID string, reviewComments []models.ReviewComment, diffView string) {
	<div class="card bg-base-100 shadow-sm border border-base-300">
		<div class="card-body">
			<h4 class="text-lg font-bold mb-3">File Changes</h4>
			<div id="diff-viewer-container">
				@components.DiffViewerWithReviewView(diffOutput, taskID, reviewComments, diffView)
			</div>
		</div>
	</div>
}

templ TaskDetailPage(projects []models.Project, task *models.Task, goal *models.TaskGoal, executions []models.Execution, schedules []models.Schedule, agents []models.LLMConfig, agentDefs []models.Agent, attachments []models.Attachment, defaultTab string, reviewComments []models.ReviewComment) {
	@layout.Base(task.Title, projects, task.ProjectID) {
		@TaskDetailContent(task, goal, executions, schedules, agents, agentDefs, attachments, defaultTab, reviewComments)
	}
}

script removeEditAttachment(attID string) {
	var el = document.getElementById('edit-att-' + attID);
	if (el) el.remove();
	var input = document.getElementById('remove-attachments-input');
	if (input) {
		var ids = input.value ? input.value.split(',') : [];
		ids.push(attID);
		input.value = ids.join(',');
	}
}

templ TaskDetailContent(task *models.Task, goal *models.TaskGoal, executions []models.Execution, schedules []models.Schedule, agents []models.LLMConfig, agentDefs []models.Agent, attachments []models.Attachment, defaultTab string, reviewComments []models.ReviewComment) {
	<div id="task-detail-content" class="h-full flex flex-col">
		@layout.PageTitle(task.Title)
		<!-- Breadcrumb navigation -->
		<div class="flex items-center gap-2 mb-6 flex-shrink-0 min-w-0">
			<a
				id="task-automations-back-btn"
				href={ templ.SafeURL(fmt.Sprintf("/automations?project_id=%s", task.ProjectID)) }
				hx-get={ fmt.Sprintf("/automations?project_id=%s", task.ProjectID) }
				hx-target="#main-content"
				hx-swap="innerHTML"
				hx-push-url="true"
				class="text-2xl text-base-content/50 hover:text-base-content/80 transition-colors flex-shrink-0"
				data-automations-url={ fmt.Sprintf("/automations?project_id=%s", task.ProjectID) }
				hidden
			>
				Automations
			</a>
			<span id="task-automations-separator" class="text-2xl text-base-content/30 flex-shrink-0" hidden>/</span>
			<a
				id="task-back-btn"
				href={ templ.SafeURL(fmt.Sprintf("/tasks?project_id=%s", task.ProjectID)) }
				hx-get={ fmt.Sprintf("/tasks?project_id=%s", task.ProjectID) }
				hx-target="#main-content"
				hx-swap="innerHTML"
				hx-push-url="true"
				class="text-2xl text-base-content/50 hover:text-base-content/80 transition-colors flex-shrink-0"
				data-tasks-url={ fmt.Sprintf("/tasks?project_id=%s", task.ProjectID) }
				data-schedule-url={ fmt.Sprintf("/schedule?project_id=%s", task.ProjectID) }
				data-chat-url={ fmt.Sprintf("/chat?project_id=%s", task.ProjectID) }
				data-alerts-url={ fmt.Sprintf("/alerts?project_id=%s", task.ProjectID) }
				data-project-id={ task.ProjectID }
				data-automation-url-base="/automations/"
			>
				Tasks
			</a>
			<span class="text-2xl text-base-content/30 flex-shrink-0">/</span>
			<h2 class="text-2xl font-bold truncate">{ task.Title }</h2>
			<script>
				(function() {
					var params = new URLSearchParams(window.location.search);
					var from = params.get('from');
					var btn = document.getElementById('task-back-btn');
					var automationsBtn = document.getElementById('task-automations-back-btn');
					var automationsSeparator = document.getElementById('task-automations-separator');
					if (btn) {
						var url = null;
						var text = 'Tasks';
						if (from === 'schedule') {
							url = btn.dataset.scheduleUrl;
							text = 'Schedule';
						} else if (from === 'chat') {
							url = btn.dataset.chatUrl;
							text = 'Chat';
						} else if (from === 'alerts') {
							url = btn.dataset.alertsUrl;
							text = 'Alerts';
						} else if (from === 'automation') {
							var automationID = params.get('automation_id');
							var automationName = params.get('automation_name');
							if (automationID) {
								url = btn.dataset.automationUrlBase + encodeURIComponent(automationID) + '?project_id=' + encodeURIComponent(btn.dataset.projectId);
								text = automationName || 'Automation';
								if (automationsBtn && automationsSeparator) {
									automationsBtn.hidden = false;
									automationsSeparator.hidden = false;
								}
							}
						}
						if (url) {
							btn.setAttribute('href', url);
							btn.setAttribute('hx-get', url);
							btn.textContent = text;
							if (typeof htmx !== 'undefined') {
								htmx.process(btn);
							}
						}
					}
				})();
			</script>
		</div>
		<!-- Tabs Navigation -->
		<div role="tablist" class="tabs tabs-bordered tabs-sm mb-6 flex-shrink-0 w-full overflow-x-auto flex-nowrap">
			<a role="tab" class={ "tab", templ.KV("tab-active", defaultTab == "details") } data-tab="details" onclick="switchTaskTab('details')">Details</a>
			<a role="tab" class={ "tab", templ.KV("tab-active", defaultTab == "chat") } data-tab="chat" onclick="switchTaskTab('chat')">Thread</a>
			<a role="tab" class={ "tab", templ.KV("tab-active", defaultTab == "changes") } data-tab="changes" onclick="switchTaskTab('changes')">Changes</a>
			<a role="tab" class={ "tab", templ.KV("tab-active", defaultTab == "schedules") } data-tab="schedules" onclick="switchTaskTab('schedules')">Schedules</a>
			<a role="tab" class={ "tab", templ.KV("tab-active", defaultTab == "chaining") } data-tab="chaining" onclick="switchTaskTab('chaining')">Chaining</a>
			<a role="tab" class={ "tab", templ.KV("tab-active", defaultTab == "attachments") } data-tab="attachments" onclick="switchTaskTab('attachments')">Attachments</a>
			<a role="tab" class={ "tab", templ.KV("tab-active", defaultTab == "lifecycle") } data-tab="lifecycle" onclick="switchTaskTab('lifecycle')">Lifecycle</a>
		</div>
		<!-- Tab: Details -->
		<div id="tab-details" class={ "task-tab-panel flex-1 flex flex-col min-h-0", templ.KV("hidden", defaultTab != "details") }>
			<div class="card bg-base-100 shadow-sm border border-base-300 flex-1 flex flex-col min-h-0 overflow-hidden">
				<div class="card-body flex-1 flex flex-col min-h-0">
					<!-- View Mode -->
						<div id="task-detail-view" class="flex-1 overflow-y-auto min-h-0 pr-1">
								@TaskDetailMetrics(task, taskExecutionMetricsFromExecutions(executions), agents, agentDefs)
							@SwarmContextPanel(task)
							@TaskPromptPanel(task)
						@TaskGoalPanel(task.ID, goal)
						// Worktree info panel (shown when task has worktree or is in a git project)
						if task.WorktreeBranch != "" || task.WorktreePath != "" {
							<div
								id="worktree-info-wrapper"
								hx-get={ fmt.Sprintf("/tasks/%s/worktree", task.ID) }
								hx-trigger="load"
								hx-target="#worktree-info-wrapper"
								hx-swap="innerHTML"
							>
								@WorktreeInfoPanel(task, nil)
							</div>
						}
						@TaskDetailActions(task)
						<!-- Delete Confirmation Modal -->
						<dialog id="delete-task-modal" class="modal">
							<div class="modal-box">
								@ModalCloseButton("document.getElementById('delete-task-modal')", "Close delete task confirmation")
								<h3 class="font-bold text-lg pr-10">Delete Task</h3>
								<p class="py-4">Are you sure you want to delete this task? This will also remove all executions, chat messages, schedules, and attachments. This action cannot be undone.</p>
								<div class="modal-action">
									<form method="dialog">
										<button class="btn btn-ghost btn-sm">Cancel</button>
									</form>
									<button
										id="delete-task-confirm-button"
										class="btn btn-error btn-sm"
										hx-delete={ fmt.Sprintf("/tasks/%s?redirect=list", task.ID) }
										hx-swap="none"
										data-delete-url={ fmt.Sprintf("/tasks/%s?redirect=list", task.ID) }
										data-schedule-delete-url={ fmt.Sprintf("/tasks/%s?redirect=list&return_to=schedule", task.ID) }
									>
										Delete
									</button>
								</div>
								</div>
								<form method="dialog" class="modal-backdrop">
									<button>close</button>
								</form>
							</dialog>
							<script>
								(function() {
									var params = new URLSearchParams(window.location.search);
									if (params.get('from') !== 'schedule') return;
									var deleteBtn = document.getElementById('delete-task-confirm-button');
									if (deleteBtn && deleteBtn.dataset.scheduleDeleteUrl) {
										deleteBtn.setAttribute('hx-delete', deleteBtn.dataset.scheduleDeleteUrl);
										if (typeof htmx !== 'undefined') {
											htmx.process(deleteBtn);
										}
									}
								})();
							</script>
						</div>
					<!-- Edit Form -->
					<div id="task-detail-edit" class="hidden flex-1 overflow-y-auto min-h-0">
						<form
							method="post"
							id={ fmt.Sprintf("edit-task-form-%s", task.ID) }
							hx-put={ fmt.Sprintf("/tasks/%s", task.ID) }
							hx-target="#task-detail-content"
							hx-swap="outerHTML"
							hx-encoding="multipart/form-data"
						>
							<div class="form-control mb-4">
								<label class="label">
									<span class="label-text">Title</span>
								</label>
								<input
									type="text"
									id={ fmt.Sprintf("edit-task-title-%s", task.ID) }
									name="title"
									value={ task.Title }
									class="input input-bordered"
									required
								/>
								<div id={ fmt.Sprintf("edit-title-error-%s", task.ID) } class="hidden mt-2 flex items-center gap-2 text-error text-sm">
									<svg xmlns="http://www.w3.org/2000/svg" class="h-5 w-5 flex-shrink-0" fill="none" viewBox="0 0 24 24" stroke="currentColor">
										<path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 9v2m0 4h.01m-6.938 4h13.856c1.54 0 2.502-1.667 1.732-3L13.732 4c-.77-1.333-2.694-1.333-3.464 0L3.34 16c-.77 1.333.192 3 1.732 3z"></path>
									</svg>
									<span id={ fmt.Sprintf("edit-title-error-message-%s", task.ID) }></span>
								</div>
							</div>
							<div class="grid grid-cols-2 gap-4 mb-4">
								<div class="form-control">
									<label class="label">
										<span class="label-text">Category</span>
									</label>
									<select name="category" class="select select-bordered">
										for _, cat := range models.AllCategoriesIncludingScheduled {
											<option
												value={ string(cat) }
												if cat == task.Category {
													selected
												}
											>
												{ string(cat) }
											</option>
										}
									</select>
								</div>
								<div class="form-control">
									<label class="label">
										<span class="label-text">Priority</span>
									</label>
									<select name="priority" class="select select-bordered">
										<option
											value="1"
											if task.Priority == 1 {
												selected
											}
										>Low</option>
										<option
											value="2"
											if task.Priority == 2 {
												selected
											}
										>Normal</option>
										<option
											value="3"
											if task.Priority == 3 {
												selected
											}
										>High</option>
										<option
											value="4"
											if task.Priority == 4 {
												selected
											}
										>Urgent</option>
									</select>
								</div>
							</div>
							<div class="form-control mb-4">
								<label class="label">
									<span class="label-text">Tag</span>
								</label>
								<select name="tag" class="select select-bordered">
									for _, tag := range models.AllTags {
										<option
											value={ string(tag) }
											if tag == task.Tag {
												selected
											}
										>
											if tag == "" {
												None
											} else {
												{ components.TagLabel(tag) }
											}
										</option>
									}
								</select>
							</div>
							<div class="form-control mb-4">
								<label class="label">
									<span class="label-text">Prompt</span>
								</label>
								<textarea
									name="prompt"
									class="textarea textarea-bordered font-mono"
									rows="8"
								>{ task.Prompt }</textarea>
							</div>
							<div class="form-control mb-4">
								<label class="label">
									<span class="label-text">Goal</span>
								</label>
								<input type="hidden" name="goal_present" value="1"/>
								<textarea
									name="goal"
									class="textarea textarea-bordered textarea-sm w-full"
									rows="3"
									placeholder="Add goal"
								>{ goalValue(goal) }</textarea>
								<label class="label">
									<span class="label-text-alt text-base-content/50">Leave empty to clear the goal.</span>
								</label>
								if goal != nil && goal.Status != models.TaskGoalStatusCleared {
									<input type="hidden" name="goal_status_present" value="1"/>
									<label class="label cursor-pointer justify-start gap-2 pt-0">
										<input
											type="checkbox"
											name="goal_active"
											class="toggle toggle-sm toggle-primary"
											if goal.Status == models.TaskGoalStatusActive {
												checked
											}
										/>
										<span class="label-text">Goal active</span>
									</label>
								}
							</div>
							<div class="form-control mb-4">
								<label class="label">
									<span class="label-text">Model</span>
								</label>
								<select name="agent_id" class="select select-bordered">
									<option
										value=""
										if task.AgentID == nil {
											selected
										}
									>Use Default Model</option>
									for _, agent := range agents {
										<option
											value={ agent.ID }
											if task.AgentID != nil && *task.AgentID == agent.ID {
												selected
											}
										>
											{ agent.Name }
											if agent.IsDefault {
												(Default)
											}
										</option>
									}
								</select>
							</div>
							if len(agentDefs) > 0 {
								<div class="form-control mb-4">
									<label class="label">
										<span class="label-text">Agent</span>
									</label>
									<select name="agent_definition_id" class="select select-bordered">
										<option
											value=""
											if task.AgentDefinitionID == nil {
												selected
											}
										>No Agent</option>
										for _, ad := range agentDefs {
											<option
												value={ ad.ID }
												if task.AgentDefinitionID != nil && *task.AgentDefinitionID == ad.ID {
													selected
												}
											>
												{ ad.Name }
												if ad.Model != "inherit" {
													({ ad.Model })
												}
											</option>
										}
									</select>
								</div>
							}
							<!-- Git Worktree: Auto-merge -->
							<div class="form-control mb-4">
								<label class="label cursor-pointer justify-start gap-2">
									<input type="hidden" name="auto_merge_present" value="1"/>
									<input
										type="checkbox"
										name="auto_merge"
										class="toggle toggle-sm toggle-primary"
										if task.AutoMerge {
											checked
										}
									/>
									<span class="label-text">Auto-merge to target branch on completion</span>
								</label>
							</div>
							<!-- Attachments Section -->
							<div class="form-control mb-4">
								<label class="label">
									<span class="label-text">Attachments</span>
								</label>
								if len(attachments) > 0 {
									<div id="edit-existing-attachments" class="mb-2 space-y-1">
										for _, att := range attachments {
											<div class="flex items-center gap-2 text-sm bg-base-200 rounded px-2 py-1" id={ fmt.Sprintf("edit-att-%s", att.ID) }>
												<svg xmlns="http://www.w3.org/2000/svg" class="h-4 w-4 flex-shrink-0 text-base-content/60" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
													<path stroke-linecap="round" stroke-linejoin="round" d="M15.172 7l-6.586 6.586a2 2 0 102.828 2.828l6.414-6.586a4 4 0 00-5.656-5.656l-6.415 6.585a6 6 0 108.486 8.486L20.5 13"></path>
												</svg>
												<span class="flex-1 truncate">{ att.FileName }</span>
												<span class="text-base-content/50">{ components.FormatFileSize(att.FileSize) }</span>
												<button
													type="button"
													class="btn btn-ghost btn-xs text-error"
													onclick={ removeEditAttachment(att.ID) }
												>
													<svg xmlns="http://www.w3.org/2000/svg" class="h-3 w-3" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
														<path stroke-linecap="round" stroke-linejoin="round" d="M6 18L18 6M6 6l12 12"></path>
													</svg>
												</button>
											</div>
										}
									</div>
								}
								<input type="hidden" name="remove_attachments" id="remove-attachments-input" value=""/>
								<input
									type="file"
									name="files"
									multiple
									class="file-input file-input-bordered file-input-sm w-full"
								/>
								<label class="label">
									<span class="label-text-alt text-base-content/50">Max 10MB per file. Add new files to attach.</span>
								</label>
							</div>
							<div class="flex gap-2">
								<button type="submit" class="btn btn-primary btn-sm">
									Save Changes
								</button>
								<button
									type="button"
									class="btn btn-ghost btn-sm"
									onclick="document.getElementById('task-detail-edit').classList.add('hidden'); document.getElementById('task-detail-view').classList.remove('hidden')"
								>
									Cancel
								</button>
							</div>
						</form>
						<script>
							// Handle edit form duplicate errors
							(function() {
								var formEl = document.currentScript.closest('#task-detail-edit').querySelector('form');
								var taskId = formEl.id.replace('edit-task-form-', '');
								document.body.addEventListener('htmx:responseError', function(event) {
									var formId = 'edit-task-form-' + taskId;
									if (event.detail.elt && event.detail.elt.id === formId) {
										var xhr = event.detail.xhr;
										if (xhr.status === 409) {
											event.preventDefault();
											var titleInput = document.getElementById('edit-task-title-' + taskId);
											var titleError = document.getElementById('edit-title-error-' + taskId);
											var titleErrorMessage = document.getElementById('edit-title-error-message-' + taskId);
											if (titleInput && titleError && titleErrorMessage) {
												titleInput.classList.add('input-error');
												titleErrorMessage.textContent = xhr.responseText || 'A task with this name already exists in this project';
												titleError.classList.remove('hidden');
											}
										}
									}
								});
							})();
						</script>
					</div>
				</div>
			</div>
		</div>
		<!-- End Tab: Details -->
		<!-- Tab: Schedules -->
		<div id="tab-schedules" class={ "task-tab-panel flex-shrink-0", templ.KV("hidden", defaultTab != "schedules") }>
			<div class="card bg-base-100 shadow-sm border border-base-300">
				<div class="card-body">
					<div class="flex items-center justify-between mb-4">
						<h4 class="text-lg font-bold">Schedules</h4>
						<button
							id="add-schedule-btn"
							class="btn btn-sm btn-primary"
							onclick="document.getElementById('schedule-form-container').classList.remove('hidden'); document.getElementById('add-schedule-btn').classList.add('hidden')"
						>
							+ Add Schedule
						</button>
					</div>
					<!-- Add Schedule Form (hidden by default) -->
					<div id="schedule-form-container" class="hidden mb-4 card bg-base-200 shadow-sm border border-base-300">
						<div class="card-body p-4">
							<form
								method="post"
								action={ fmt.Sprintf("/tasks/%s/schedule?project_id=%s", task.ID, task.ProjectID) }
								hx-post={ fmt.Sprintf("/tasks/%s/schedule?project_id=%s", task.ID, task.ProjectID) }
								hx-target="#task-detail-content"
								hx-swap="outerHTML"
							>
								<div class="grid grid-cols-1 gap-4 mb-4 sm:grid-cols-2">
									<div class="form-control">
										<label class="label">
											<span class="label-text">Run At</span>
										</label>
										<div class="relative" data-run-at-picker-container onclick="openScheduleRunAtPicker(this, event)">
											<input
												type="datetime-local"
												name="run_at"
												class="input input-bordered input-sm cursor-pointer"
												data-run-at-picker
												required
											/>
										</div>
									</div>
									<div class="form-control">
										<label class="label">
											<span class="label-text">Repeat</span>
										</label>
										<select name="repeat_type" class="select select-bordered select-sm" id="repeat-type-select">
											<option value="once">Once</option>
											<option value="seconds">Every N Seconds</option>
											<option value="minutes">Every N Minutes</option>
											<option value="hours">Every N Hours</option>
											<option value="daily">Daily</option>
											<option value="weekly">Weekly</option>
											<option value="monthly">Monthly</option>
										</select>
									</div>
								</div>
								if schedulePrimaryAgentSelectionEditable(task.AgentDefinitionID, agentDefs) {
									<div class="form-control mb-4 min-w-0">
										<label class="label">
											<span class="label-text">Primary Agent</span>
										</label>
										@SchedulePrimaryAgentSelector(task.AgentDefinitionID, agentDefs, "select select-bordered select-sm w-full max-w-full")
										<label class="label"><span class="label-text-alt opacity-60">Agent definition used for scheduled runs; model configuration is unchanged</span></label>
									</div>
								}
								<div class="form-control mb-4" id="repeat-interval-container">
									<label class="label">
										<span class="label-text">Repeat Every</span>
									</label>
									<div class="flex items-center gap-2">
										<input
											type="number"
											id="repeat-interval-input"
											name="repeat_interval"
											value="1"
											min="1"
											max="365"
											step="1"
											class="input input-bordered input-sm w-20"
										/>
										<span class="text-sm opacity-60" id="repeat-interval-label">day(s)</span>
									</div>
								</div>
									<div class="form-control mb-4">
										<input type="hidden" name="clear_context_on_start" value="false"/>
										<label class="label cursor-pointer justify-start gap-3">
											<input type="checkbox" name="clear_context_on_start" value="true" class="checkbox checkbox-sm" checked/>
											<span class="label-text">Clear context on start</span>
										</label>
										<label class="label"><span class="label-text-alt opacity-60">Start each scheduled run without prior model conversation context</span></label>
									</div>
									<div class="flex gap-2">
										<button type="submit" class="btn btn-primary btn-sm">
											Add Schedule
										</button>
										<button
											type="button"
											class="btn btn-ghost btn-sm"
											onclick="document.getElementById('schedule-form-container').classList.add('hidden'); document.getElementById('add-schedule-btn').classList.remove('hidden')"
										>
											Cancel
										</button>
									</div>
							</form>
							<script>
									(function() {
										var repeatTypeSelect = document.getElementById('repeat-type-select');
										var repeatIntervalContainer = document.getElementById('repeat-interval-container');
										var repeatIntervalInput = document.getElementById('repeat-interval-input');
										var repeatIntervalLabel = document.getElementById('repeat-interval-label');
										if (!repeatTypeSelect || !repeatIntervalContainer || !repeatIntervalInput || !repeatIntervalLabel) return;

										function applyIntervalValidity(enabled) {
											if (!enabled) {
												repeatIntervalInput.value = '1';
												repeatIntervalInput.disabled = true;
												repeatIntervalInput.required = false;
												repeatIntervalInput.setCustomValidity('');
												return;
											}
											repeatIntervalInput.disabled = false;
											repeatIntervalInput.required = true;
											var raw = (repeatIntervalInput.value || '').trim();
											if (raw === '' || !/^\d+$/.test(raw) || Number(raw) < 1 || Number(raw) > 365) {
												repeatIntervalInput.setCustomValidity('Repeat interval must be a whole number between 1 and 365');
											} else {
												repeatIntervalInput.setCustomValidity('');
											}
										}

										function updateRepeatInterval() {
											var repeatType = repeatTypeSelect.value;
											if (repeatType === 'once') {
												repeatIntervalContainer.style.display = 'none';
												applyIntervalValidity(false);
												return;
											}
											repeatIntervalContainer.style.display = 'block';
											switch(repeatType) {
												case 'seconds': repeatIntervalLabel.textContent = 'second(s)'; break;
												case 'minutes': repeatIntervalLabel.textContent = 'minute(s)'; break;
												case 'hours': repeatIntervalLabel.textContent = 'hour(s)'; break;
												case 'daily': repeatIntervalLabel.textContent = 'day(s)'; break;
												case 'weekly': repeatIntervalLabel.textContent = 'week(s)'; break;
												case 'monthly': repeatIntervalLabel.textContent = 'month(s)'; break;
												default: repeatIntervalLabel.textContent = 'time(s)'; break;
											}
											applyIntervalValidity(true);
										}

										repeatTypeSelect.addEventListener('change', updateRepeatInterval);
										repeatIntervalInput.addEventListener('input', function() {
											applyIntervalValidity(repeatTypeSelect.value !== 'once');
										});
											updateRepeatInterval();
									})();
								</script>
						</div>
					</div>
					<!-- Existing Schedules List -->
					if len(schedules) > 0 {
						for _, s := range schedules {
							<div class="card bg-base-100 shadow-sm border border-base-300 mb-2" id={ fmt.Sprintf("schedule-card-%s", s.ID) }>
								<div class="card-body p-3">
									<!-- Schedule View -->
									<div id={ fmt.Sprintf("schedule-view-%s", s.ID) }>
										<div class="flex items-center justify-between">
											<div>
												if s.RepeatType.IsSubDaily() {
													<span class="text-sm font-medium">{ components.ScheduleRepeatLabel(s) }</span>
												} else {
													<span class="text-sm font-medium">{ string(s.RepeatType) }</span>
													if s.RepeatType != models.RepeatOnce && s.RepeatInterval > 1 {
														<span class="text-sm opacity-60">(every { fmt.Sprintf("%d", s.RepeatInterval) })</span>
													}
												}
												if !s.Enabled {
													<span class="badge badge-warning badge-xs ml-2">Disabled</span>
												}
												if s.NextRun != nil {
													<span class={ "text-sm ml-2", templ.KV("opacity-60", s.Enabled), templ.KV("opacity-30 line-through", !s.Enabled) }>
														Next: { s.NextRun.Local().Format("2006-01-02 3:04 PM") }
													</span>
												}
											</div>
											<div class="flex gap-1">
												if s.Enabled {
													<button
														class="btn btn-xs btn-ghost"
														hx-post={ fmt.Sprintf("/schedules/%s/toggle", s.ID) }
														hx-target="#task-detail-content"
														hx-swap="outerHTML"
													>
														Pause
													</button>
												} else {
													<button
														class="btn btn-xs btn-outline btn-warning"
														hx-post={ fmt.Sprintf("/schedules/%s/toggle", s.ID) }
														hx-target="#task-detail-content"
														hx-swap="outerHTML"
													>
														Resume
													</button>
												}
												<button
													class="btn btn-xs btn-ghost"
													onclick={ templ.ComponentScript{Call: fmt.Sprintf("document.getElementById('schedule-view-%s').classList.add('hidden'); document.getElementById('schedule-edit-%s').classList.remove('hidden')", s.ID, s.ID)} }
												>
													Edit
												</button>
												<button
													class="btn btn-xs btn-ghost text-error"
													data-schedule-id={ s.ID }
													data-schedule-title={ task.Title }
													data-schedule-target="closest .card"
													data-schedule-swap="outerHTML swap:1s"
													onclick="openDeleteScheduleConfirm(this)"
												>
													Remove
												</button>
											</div>
										</div>
									</div>
									<!-- Schedule Edit Form -->
									<div id={ fmt.Sprintf("schedule-edit-%s", s.ID) } class="hidden" data-schedule-id={ s.ID }>
									<form
										method="post"
										action={ fmt.Sprintf("/schedules/%s?project_id=%s", s.ID, task.ProjectID) }
										hx-put={ fmt.Sprintf("/schedules/%s?project_id=%s", s.ID, task.ProjectID) }
										hx-target="#task-detail-content"
										hx-swap="outerHTML"
									>
										<input type="hidden" name="_method" value="PUT"/>											<div class="grid grid-cols-1 gap-4 mb-4 sm:grid-cols-2">
												<div class="form-control">
													<label class="label">
														<span class="label-text">Run At</span>
													</label>
													<div class="relative" data-run-at-picker-container onclick="openScheduleRunAtPicker(this, event)">
														<input
															type="datetime-local"
															name="run_at"
															value={ components.GetScheduleEditTime(s) }
															class="input input-bordered input-sm cursor-pointer"
															data-run-at-picker
															required
														/>
													</div>
												</div>
												<div class="form-control">
													<label class="label">
														<span class="label-text">Repeat</span>
													</label>
													<select name="repeat_type" class="select select-bordered select-sm" id={ fmt.Sprintf("edit-repeat-type-%s", s.ID) }>
														<option
															value="once"
															if s.RepeatType == models.RepeatOnce {
																selected
															}
														>Once</option>
														<option
															value="seconds"
															if s.RepeatType == models.RepeatSeconds {
																selected
															}
														>Every N Seconds</option>
														<option
															value="minutes"
															if s.RepeatType == models.RepeatMinutes {
																selected
															}
														>Every N Minutes</option>
														<option
															value="hours"
															if s.RepeatType == models.RepeatHours {
																selected
															}
														>Every N Hours</option>
														<option
															value="daily"
															if s.RepeatType == models.RepeatDaily {
																selected
															}
														>Daily</option>
														<option
															value="weekly"
															if s.RepeatType == models.RepeatWeekly {
																selected
															}
														>Weekly</option>
														<option
															value="monthly"
															if s.RepeatType == models.RepeatMonthly {
																selected
															}
														>Monthly</option>
													</select>
												</div>
											</div>
											if schedulePrimaryAgentSelectionEditable(task.AgentDefinitionID, agentDefs) {
												<div class="form-control mb-4 min-w-0">
													<label class="label">
														<span class="label-text">Primary Agent</span>
													</label>
													@SchedulePrimaryAgentSelector(task.AgentDefinitionID, agentDefs, "select select-bordered select-sm w-full max-w-full")
													<label class="label"><span class="label-text-alt opacity-60">Agent definition used for scheduled runs; model configuration is unchanged</span></label>
												</div>
											}
											<div class="form-control mb-4" id={ fmt.Sprintf("edit-repeat-interval-%s", s.ID) }>
												<label class="label">
													<span class="label-text">Repeat Every</span>
												</label>
												<div class="flex items-center gap-2">
													<input
														type="number"
														id={ fmt.Sprintf("edit-repeat-interval-input-%s", s.ID) }
														name="repeat_interval"
														value={ fmt.Sprintf("%d", s.RepeatInterval) }
														min="1"
														max="365"
														step="1"
														class="input input-bordered input-sm w-20"
													/>
													<span class="text-sm opacity-60" id={ fmt.Sprintf("edit-repeat-label-%s", s.ID) }>day(s)</span>
												</div>
											</div>
										<div class="form-control mb-4">
											<input type="hidden" name="clear_context_on_start" value="false"/>
											<label class="label cursor-pointer justify-start gap-3">
												<input type="checkbox" name="clear_context_on_start" value="true" class="checkbox checkbox-sm" checked?={ s.ClearContextOnStart }/>
												<span class="label-text">Clear context on start</span>
											</label>
											<label class="label"><span class="label-text-alt opacity-60">Start each scheduled run without prior model conversation context</span></label>
										</div>
										<div class="flex gap-2">
											<button type="submit" class="btn btn-primary btn-sm">
												Save Changes
											</button>
											<button
												type="button"
												class="btn btn-ghost btn-sm"
												onclick={ templ.ComponentScript{Call: fmt.Sprintf("document.getElementById('schedule-edit-%s').classList.add('hidden'); document.getElementById('schedule-view-%s').classList.remove('hidden')", s.ID, s.ID)} }
											>
												Cancel
											</button>
											</div>
										</form>
										<script>
													(function() {
														var container = document.currentScript.closest('[data-schedule-id]');
														if (!container) return;
														var scheduleId = container.dataset.scheduleId;
														var repeatTypeSelect = document.getElementById('edit-repeat-type-' + scheduleId);
														var repeatIntervalContainer = document.getElementById('edit-repeat-interval-' + scheduleId);
														var repeatIntervalInput = document.getElementById('edit-repeat-interval-input-' + scheduleId);
														var repeatIntervalLabel = document.getElementById('edit-repeat-label-' + scheduleId);

														if (!repeatTypeSelect || !repeatIntervalContainer || !repeatIntervalInput || !repeatIntervalLabel) return;

														function applyIntervalValidity(enabled) {
															if (!enabled) {
																repeatIntervalInput.value = '1';
																repeatIntervalInput.disabled = true;
																repeatIntervalInput.required = false;
																repeatIntervalInput.setCustomValidity('');
																return;
															}
															repeatIntervalInput.disabled = false;
															repeatIntervalInput.required = true;
															var raw = (repeatIntervalInput.value || '').trim();
															if (raw === '' || !/^\d+$/.test(raw) || Number(raw) < 1 || Number(raw) > 365) {
																repeatIntervalInput.setCustomValidity('Repeat interval must be a whole number between 1 and 365');
															} else {
																repeatIntervalInput.setCustomValidity('');
															}
														}

														function updateRepeatInterval() {
															var repeatType = repeatTypeSelect.value;
															if (repeatType === 'once') {
																repeatIntervalContainer.style.display = 'none';
																applyIntervalValidity(false);
																return;
															}
															repeatIntervalContainer.style.display = 'block';
															switch(repeatType) {
																case 'seconds': repeatIntervalLabel.textContent = 'second(s)'; break;
																case 'minutes': repeatIntervalLabel.textContent = 'minute(s)'; break;
																case 'hours': repeatIntervalLabel.textContent = 'hour(s)'; break;
																case 'daily': repeatIntervalLabel.textContent = 'day(s)'; break;
																case 'weekly': repeatIntervalLabel.textContent = 'week(s)'; break;
																case 'monthly': repeatIntervalLabel.textContent = 'month(s)'; break;
																default: repeatIntervalLabel.textContent = 'time(s)'; break;
															}
															applyIntervalValidity(true);
														}

														repeatTypeSelect.addEventListener('change', updateRepeatInterval);
														repeatIntervalInput.addEventListener('input', function() {
															applyIntervalValidity(repeatTypeSelect.value !== 'once');
														});
															updateRepeatInterval();
														})();
													</script>
									</div>
								</div>
							</div>
						}
					} else {
						<p class="text-sm opacity-50">No schedules configured</p>
					}
				</div>
			</div>
		</div>
		<!-- End Tab: Schedules -->
		<!-- Tab: Chaining -->
		<div id="tab-chaining" class={ "task-tab-panel flex-shrink-0", templ.KV("hidden", defaultTab != "chaining") }>
			<div class="card bg-base-100 shadow-sm border border-base-300">
				<div class="card-body">
					<h4 class="text-lg font-bold mb-3">Task Chaining</h4>
					<p class="text-sm opacity-60 mb-4">Configure this task to automatically create a child task when it completes. For example, an Opus planning task can spawn a Sonnet implementation task.</p>
					@components.TaskChainConfigPage(task, agents)
				</div>
			</div>
		</div>
		<!-- End Tab: Chaining -->
		<!-- Tab: Attachments -->
		<div id="tab-attachments" class={ "task-tab-panel flex-shrink-0", templ.KV("hidden", defaultTab != "attachments") }>
			<div class="card bg-base-100 shadow-sm border border-base-300">
				<div class="card-body">
					<h4 class="text-lg font-bold mb-3">Attachments</h4>
					@components.AttachmentList(attachments, task.ProjectID, task.ID)
				</div>
			</div>
		</div>
		<!-- End Tab: Attachments -->
		<!-- Tab: Lifecycle (runbook §Rollout step 17) -->
		<div id="tab-lifecycle" class={ "task-tab-panel flex-shrink-0", templ.KV("hidden", defaultTab != "lifecycle") }>
			<div class="card bg-base-100 shadow-sm border border-base-300">
				<div class="card-body">
					<div class="flex items-center justify-between mb-3">
						<h4 class="text-lg font-bold">Lifecycle Activity</h4>
						<button type="button" class="btn btn-ghost btn-xs" onclick={ templ.ComponentScript{Call: "refreshLifecycleActivity('" + task.ID + "')"} }>Refresh</button>
					</div>
					<p class="text-sm opacity-70 mb-3">Lifecycle hook invocations recorded for this task. Includes routing, before-run preparation, and after-complete learning.</p>
					<div id="lifecycle-activity-list" data-task-id={ task.ID } class="space-y-2">
						<p class="text-sm opacity-50">Loading lifecycle activity...</p>
					</div>
				</div>
			</div>
			<script>
				(function() {
					function statusBadge(status) {
						var map = { completed: 'badge-success', failed: 'badge-error', skipped: 'badge-ghost', queued: 'badge-info', running: 'badge-warning' };
						var cls = map[status] || 'badge-ghost';
						return '<span class="badge ' + cls + ' badge-sm">' + status + '</span>';
					}
						function escapeText(value) {
							return String(value == null ? '' : value)
								.replace(/&/g, '&amp;')
								.replace(/</g, '&lt;')
								.replace(/>/g, '&gt;');
						}
						function renderBadgeRow(label, values) {
							if (!Array.isArray(values) || values.length === 0) return '';
							var seen = Object.create(null);
							var badges = [];
							values.forEach(function(value) {
								if (!value || seen[value]) return;
								seen[value] = true;
								badges.push('<span class="font-mono text-xs badge badge-outline">' + escapeText(value) + '</span>');
							});
							if (badges.length === 0) return '';
							return '<p class="text-sm mt-1 flex items-center gap-2 flex-wrap">' +
								'<span>' + escapeText(label) + ':</span> ' + badges.join(' ') +
							'</p>';
						}
						function memoryLabels(memories) {
							if (!Array.isArray(memories)) return [];
							return memories.map(function(m) { return m.file || m.topic || ''; });
						}
						window.refreshLifecycleActivity = async function(taskID) {
							var container = document.getElementById('lifecycle-activity-list');
							if (!container) return;
							try {
								var response = await fetch('/api/tasks/' + encodeURIComponent(taskID) + '/lifecycle-executions', { headers: { 'Accept': 'application/json' } });
								if (!response.ok) throw new Error('failed to load lifecycle executions');
								var rows = await response.json();
								if (!Array.isArray(rows) || rows.length === 0) {
									container.innerHTML = '<p class="text-sm opacity-50">No lifecycle activity recorded yet.</p>';
									return;
								}
									container.innerHTML = rows.map(function(r) {
										var selectedSkills = renderBadgeRow('Selected skills', r.selected_skills);
										var selectedMemories = renderBadgeRow('Selected memories', memoryLabels(r.selected_memories));
										var hasStructuredRoute = selectedSkills || selectedMemories;
										var summary = r.summary && !hasStructuredRoute ? '<p class="text-sm mt-1">' + escapeText(r.summary) + '</p>' : '';
										var error = r.error ? '<p class="text-xs text-error mt-1">' + escapeText(r.error) + '</p>' : '';
										var when = r.completed_at ? new Date(r.completed_at).toLocaleString() : new Date(r.started_at).toLocaleString();
										return '<div class="border border-base-300 rounded-lg p-3">' +
											'<div class="flex items-center justify-between flex-wrap gap-2">' +
												'<div class="flex items-center gap-2 flex-wrap">' +
													'<span class="font-mono text-xs opacity-70">' + escapeText(r.when || '') + '</span>' +
													'<span class="text-sm font-medium">' + escapeText(r.skill_key || '') + '</span>' +
													statusBadge(r.status || '') +
												'</div>' +
												'<span class="text-xs opacity-60">' + escapeText(when) + '</span>' +
											'</div>' +
											summary + selectedSkills + selectedMemories + error +
										'</div>';
									}).join('');
							} catch (err) {
							container.innerHTML = '<p class="text-sm text-error">' + escapeText(err.message || err) + '</p>';
						}
					};
					if (document.querySelector('[data-tab="lifecycle"].tab-active')) {
						var el = document.getElementById('lifecycle-activity-list');
						if (el) window.refreshLifecycleActivity(el.dataset.taskId);
					}
					document.addEventListener('click', function(ev) {
						var tab = ev.target.closest && ev.target.closest('[data-tab="lifecycle"]');
						if (!tab) return;
						var el = document.getElementById('lifecycle-activity-list');
						if (el) window.refreshLifecycleActivity(el.dataset.taskId);
					});
				})();
			</script>
		</div>
		<!-- End Tab: Lifecycle -->
		<!-- Tab: Changes -->
		<div id="tab-changes" class={ "task-tab-panel flex-shrink-0", templ.KV("hidden", defaultTab != "changes") }>
			<div
				id="changes-content"
				hx-get={ fmt.Sprintf("/tasks/%s/changes", task.ID) }
				hx-trigger="refreshChanges from:body"
				hx-swap="innerHTML"
				data-task-id={ task.ID }
			>
				if defaultTab == "changes" {
					<div class="card bg-base-100 shadow-sm border border-base-300" hx-get={ fmt.Sprintf("/tasks/%s/changes", task.ID) } hx-trigger="load" hx-swap="outerHTML">
						<div class="card-body">
							<h4 class="text-lg font-bold mb-3">File Changes</h4>
							<p class="text-sm opacity-60">Loading changes...</p>
						</div>
					</div>
				} else {
					<div class="card bg-base-100 shadow-sm border border-base-300">
						<div class="card-body">
							<h4 class="text-lg font-bold mb-3">File Changes</h4>
							<p class="text-sm opacity-60">
								Changes load on demand when you open this tab.
							</p>
						</div>
					</div>
				}
			</div>
		</div>
		<!-- End Tab: Changes -->
		<!-- Tab: Thread -->
		<div id="tab-chat" class={ "task-tab-panel flex-1 flex flex-col min-h-0", templ.KV("hidden", defaultTab != "chat") }>
			<div
				id="thread-content"
				hx-get={ fmt.Sprintf("/tasks/%s/thread", task.ID) }
				hx-trigger="none"
				hx-swap="innerHTML"
				data-task-id={ task.ID }
				data-loaded="false"
				data-loading="false"
				class="flex-1 flex flex-col min-h-0"
			>
				<div class="card bg-base-100 shadow-sm border border-base-300 flex-1 flex flex-col min-h-0 overflow-hidden">
					<div class="card-body flex-1 flex flex-col min-h-0">
						<h4 class="text-lg font-bold mb-3">Thread</h4>
						if defaultTab == "chat" {
							<p class="text-sm opacity-60">Thread is loading...</p>
						} else {
							<p class="text-sm opacity-60">Thread loads on demand when you open this tab.</p>
						}
					</div>
				</div>
			</div>
		</div>
		<!-- End Tab: Thread -->
		<dialog id="delete_schedule_confirm_modal" class="modal">
			<div class="modal-box">
				@ModalCloseButton("delete_schedule_confirm_modal", "Close delete schedule confirmation")
				<h3 class="font-bold text-lg text-error pr-10">Delete Schedule</h3>
				<p class="py-4">Are you sure you want to delete the schedule for <strong id="delete_schedule_confirm_name"></strong>? This action cannot be undone.</p>
				<div class="text-sm text-base-content/70 bg-base-200 rounded-lg p-3 mb-4">The task will remain, but it will no longer run on this schedule.</div>
				<div class="modal-action">
					<button type="button" class="btn" onclick="delete_schedule_confirm_modal.close()">Cancel</button>
					<button type="button" class="btn btn-error" onclick="confirmDeleteSchedule()">Delete Permanently</button>
				</div>
			</div>
			<form method="dialog" class="modal-backdrop"><button>close</button></form>
		</dialog>
		<script>
							var deleteScheduleID = '';
							var deleteScheduleTarget = '#task-detail-content';
							var deleteScheduleTargetElement = null;
							var deleteScheduleSwap = 'outerHTML';

							function openDeleteScheduleConfirm(button) {
								if (!button) return;
								deleteScheduleID = button.dataset.scheduleId || '';
								if (!deleteScheduleID) return;
								deleteScheduleTarget = button.dataset.scheduleTarget || '#task-detail-content';
								deleteScheduleTargetElement = deleteScheduleTarget.indexOf('closest ') === 0 ? button.closest(deleteScheduleTarget.replace(/^closest\s+/, '')) : null;
								deleteScheduleSwap = button.dataset.scheduleSwap || 'outerHTML';
								var nameEl = document.getElementById('delete_schedule_confirm_name');
								if (nameEl) nameEl.textContent = button.dataset.scheduleTitle || 'this task';
								var modal = document.getElementById('delete_schedule_confirm_modal');
								if (modal) modal.showModal();
							}

							function confirmDeleteSchedule() {
								if (!deleteScheduleID) return;
								var modal = document.getElementById('delete_schedule_confirm_modal');
								if (modal) modal.close();
								var target = deleteScheduleTargetElement || deleteScheduleTarget;
								htmx.ajax('DELETE', '/schedules/' + deleteScheduleID, {
									target: target,
									swap: deleteScheduleSwap
								});
							}

							function openScheduleRunAtPicker(container, event) {							if (!container) return;
							var pickerInput = container.querySelector('input[data-run-at-picker]');
							if (!pickerInput) return;
							if (event && event.target && !event.target.closest('input[data-run-at-picker]')) return;
							pickerInput.focus();
							if (typeof pickerInput.showPicker === 'function') {
								pickerInput.showPicker();
							}
						}

						var _threadContentLoading = false;
					function _currentTaskIdFromPath() {
						var taskIdMatch = window.location.pathname.match(/\/tasks\/([^\/]+)/);
						return taskIdMatch && taskIdMatch[1] ? taskIdMatch[1] : '';
					}

					function _isChatTabActive() {
						var chatTab = document.querySelector('[data-tab="chat"]');
						if (!chatTab || !chatTab.classList.contains('tab-active')) return false;
						var chatPanel = document.getElementById('tab-chat');
						return !!chatPanel && !chatPanel.classList.contains('hidden');
					}

					function _taskThreadScrollStateKey(taskId) {
						return taskId ? 'task-thread-scroll-' + taskId : '';
					}

					function _getTaskThreadScrollState(taskId) {
						window._taskThreadScrollStates = window._taskThreadScrollStates || {};
						var key = _taskThreadScrollStateKey(taskId || _currentTaskIdFromPath());
						return key ? window._taskThreadScrollStates[key] : null;
					}

					function _saveTaskThreadScrollState(taskId) {
						taskId = taskId || _currentTaskIdFromPath();
						var key = _taskThreadScrollStateKey(taskId);
						var chatMessages = document.getElementById('task-thread-messages');
						if (!key || !chatMessages || !window.chatAutoScroll) return;
						var tracker = window._taskThreadPageTracker;
						var userScrolledUp = tracker
							? !!tracker.userScrolledUp
							: !!window._taskThreadUserScrolledUp;
						var snapshot = tracker && typeof tracker.snapshot === 'function'
							? tracker.snapshot()
							: { scrollTop: chatMessages.scrollTop || 0, userScrolledUp: userScrolledUp, pinned: !userScrolledUp };
						window._taskThreadScrollStates = window._taskThreadScrollStates || {};
						window._taskThreadScrollStates[key] = snapshot;
						window._taskThreadUserScrolledUp = !!snapshot.userScrolledUp;
					}

					function _restoreThreadScrollOrBottom(taskId, forceBottom) {
						requestAnimationFrame(function() {
							var chatMessages = document.getElementById('task-thread-messages');
							if (!chatMessages || !window.chatAutoScroll) return;

							var state = _getTaskThreadScrollState(taskId);
							if (!forceBottom && state) {
								chatMessages.scrollTop = state.userScrolledUp ? (state.scrollTop || 0) : chatMessages.scrollHeight;
								if (window._taskThreadPageTracker) window._taskThreadPageTracker.userScrolledUp = !!state.userScrolledUp;
								window._taskThreadUserScrolledUp = !!state.userScrolledUp;
								return;
							}

							if (!forceBottom) {
								var tracker = window._taskThreadPageTracker;
								var userScrolledUp = false;
								if (tracker && typeof tracker.userScrolledUp === 'boolean') {
									userScrolledUp = tracker.userScrolledUp;
								} else if (typeof window._taskThreadUserScrolledUp === 'boolean') {
									userScrolledUp = window._taskThreadUserScrolledUp;
								}
								if (userScrolledUp) return;
							}

							window.chatAutoScroll.scrollToBottom(chatMessages, !!forceBottom);
							_saveTaskThreadScrollState(taskId);
						});
					}

						function _closeTaskThreadEventSourcesForRefresh() {
							if (!window._threadEventSources) return;
							window._threadEventSources.forEach(function(es) {
								try { es.close(); } catch(e) {}
							});
							window._threadEventSources = [];
							window._taskThreadStreamingActive = false;
						}

						function _threadHasExecution(execId) {
							return !!(execId && document.querySelector('[data-exec-id="' + execId.replace(/"/g, '\\"') + '"]'));
						}

						function _loadThreadContent(taskId, forceReload, expectedExecId) {
							var threadContent = document.getElementById('thread-content');
							if (!threadContent || !taskId || threadContent.dataset.taskId !== taskId) return Promise.resolve(false);
							if (!forceReload && threadContent.dataset.loaded === 'true' && (!expectedExecId || _threadHasExecution(expectedExecId))) return Promise.resolve(true);
							if (_threadContentLoading) return Promise.resolve(false);
							if (typeof htmx === 'undefined') return Promise.resolve(false);

							if (forceReload) _closeTaskThreadEventSourcesForRefresh();
							_threadContentLoading = true;
							threadContent.dataset.loading = 'true';
							return htmx.ajax('GET', '/tasks/' + taskId + '/thread', {
								target: '#thread-content[data-task-id="' + taskId.replace(/"/g, '\\"') + '"]',
								swap: 'innerHTML'
							}).then(function() {
								var updated = document.getElementById('thread-content');
								if (!updated || updated.dataset.taskId !== taskId) return false;
								updated.dataset.loaded = 'true';
								updated.dataset.loading = 'false';
								if (window.htmx && typeof htmx.process === 'function') htmx.process(updated);
								if (expectedExecId && !_threadHasExecution(expectedExecId)) return false;
								return true;
							}).catch(function(err) {
								console.error('Failed to load thread content:', err);
								var updated = document.getElementById('thread-content');
								if (updated) updated.dataset.loading = 'false';
								return false;
							}).finally(function() {
								_threadContentLoading = false;
							});
						}

						function _refreshActiveThreadContent(taskId, forceReload, expectedExecId, attempt) {
							var threadContent = document.getElementById('thread-content');
							if (!taskId || !_isChatTabActive() || !threadContent || threadContent.dataset.taskId !== taskId) return;
							attempt = attempt || 0;
							_loadThreadContent(taskId, forceReload, expectedExecId).then(function(loaded) {
								var currentThreadContent = document.getElementById('thread-content');
								if (!currentThreadContent || currentThreadContent.dataset.taskId !== taskId) return;
								if (!loaded && forceReload && attempt < 8) {
									setTimeout(function() { _refreshActiveThreadContent(taskId, true, expectedExecId, attempt + 1); }, 150 * (attempt + 1));
									return;
								}
								_restoreThreadScrollOrBottom(taskId, false);
								if (window._initThreadStreaming) window._initThreadStreaming();
							});
						}

							window._openTaskThreadAfterRun = function(taskId) {
								taskId = taskId || _currentTaskIdFromPath();
								if (!taskId) return;
								switchTaskTab('chat');
								var nextURL = '/tasks/' + taskId + '?tab=chat';
								if (window.location.pathname !== '/tasks/' + taskId || window.location.search !== '?tab=chat') {
									window.openVibelyNavigate(nextURL).catch(function(err) {
										console.error('[task-thread] Failed to open task thread:', err);
									});
									return;
								}
								_refreshActiveThreadContent(taskId, true, '', 0);
							};
					function switchTaskTab(tabName) {
					var container = document.getElementById('task-detail-content');
					if (!container) return;

					if (_isChatTabActive()) {
						_saveTaskThreadScrollState();
					}

				container.querySelectorAll('.task-tab-panel').forEach(function(panel) {
					panel.classList.add('hidden');
				});

				container.querySelectorAll('[data-tab]').forEach(function(tab) {
					tab.classList.remove('tab-active');
				});

				var panel = container.querySelector('#tab-' + tabName);
				if (panel) panel.classList.remove('hidden');

					var tab = container.querySelector('[data-tab="' + tabName + '"]');
					if (tab) tab.classList.add('tab-active');

					// Auto-scroll thread to bottom when switching to thread tab
						if (tabName === 'chat') {
							var threadContent = document.getElementById('thread-content');
							var taskId = (threadContent && threadContent.dataset.taskId) || _currentTaskIdFromPath();
							if (taskId) {
								_loadThreadContent(taskId).then(function() {
										_restoreThreadScrollOrBottom(taskId, false);
									});
								} else {
									_restoreThreadScrollOrBottom(taskId, false);
								}					}

				// Reload changes content and start SSE when switching to changes tab
				if (tabName === 'changes') {
					var taskIdMatch = window.location.pathname.match(/\/tasks\/([^\/]+)/);
					if (taskIdMatch && taskIdMatch[1]) {
						var taskId = taskIdMatch[1];
						if (typeof htmx !== 'undefined') {
							htmx.ajax('GET', '/tasks/' + taskId + '/changes', {
								target: '#changes-content',
								swap: 'innerHTML'
							}).then(function() {
								// Seed fingerprint so the first SSE update can detect no-ops.
								var cc = document.getElementById('changes-content');
								if (cc) _lastDiffFingerprint = _computeDiffFingerprint(cc);
							}).catch(function() {});
						}
						// Start SSE for real-time file changes
						_startFileChangesSSE(taskId);
					}
				} else {
					// Stop SSE when switching away from changes tab
					_stopFileChangesSSE();
				}
				}

				// File changes are consumed from the shared sidebar live stream.
				// Keep per-task filtering in-page to avoid creating another EventSource.
				var _fileChangesListening = false;
				var _fileChangesUpdatePending = false;
				var _fileChangesTaskId = null;

				function _isChangesTabActive() {
					var changesTab = document.querySelector('[data-tab="changes"]');
					if (!changesTab || !changesTab.classList.contains('tab-active')) return false;
					var changesPanel = document.getElementById('tab-changes');
					return !!changesPanel && !changesPanel.classList.contains('hidden');
				}

			function _handleSharedFileChangeEvent(event) {
				if (!_fileChangesListening || !_fileChangesTaskId) return;
				var data = event.detail || {};
				if (!data.task_id || data.task_id !== _fileChangesTaskId) return;

				if (data.type === 'diff_snapshot') {
					_updateDiffViewer();
					return;
				}
				if (data.type === 'file_modified') {
					console.log('File modified:', data.file_path, 'via', data.tool_name);
				}
			}

			function _startFileChangesSSE(taskId) {
				if (!taskId) return;
				if (_fileChangesListening && _fileChangesTaskId === taskId) return;
				_fileChangesTaskId = taskId;
				_fileChangesListening = true;
				console.log('File changes live listener active for task:', taskId);
			}

			function _stopFileChangesSSE() {
				_fileChangesListening = false;
				console.log('File changes live listener paused');
			}

				// Track the last diff fingerprint to skip no-op DOM replacements.
				var _lastDiffFingerprint = '';

				function _computeDiffFingerprint(container) {
					var viewer = container && container.querySelector('#diff-viewer');
					if (!viewer) return '';
					// Use a simple hash of the full diff viewer HTML for accurate
					// change detection. The previous badge+row-count approach missed
					// content changes within existing lines.
					var raw = viewer.innerHTML;
					var h = 0;
					for (var i = 0; i < raw.length; i++) {
						h = ((h << 5) - h + raw.charCodeAt(i)) | 0;
					}
					return String(h);
				}

				function _getDiffViewMode() {
					var splitBtn = document.getElementById('diff-btn-split');
					return (splitBtn && splitBtn.classList.contains('btn-active')) ? 'split' : 'inline';
				}

				function _updateDiffViewer(diffOutput) {
					var changesContent = document.getElementById('changes-content');
					if (!changesContent) return;
					if (!_isChangesTabActive()) return;

					// Debounce: skip if an update is already in flight
					if (_fileChangesUpdatePending) return;
					_fileChangesUpdatePending = true;

				var taskId = changesContent.dataset.taskId;
				if (taskId) {
					// Fetch new HTML in the background WITHOUT touching the live DOM.
					// Only swap if content actually changed — this prevents the viewport
					// jumps caused by the old htmx.ajax() path which replaced innerHTML
					// before the fingerprint check could run.
					fetch('/tasks/' + taskId + '/changes', {
						headers: { 'HX-Request': 'true' }
					}).then(function(resp) {
						if (!resp.ok) throw new Error('HTTP ' + resp.status);
						return resp.text();
					}).then(function(html) {
						_fileChangesUpdatePending = false;

						// Parse the response in a detached element to compute fingerprint
						// without touching the live DOM at all.
						var offscreen = document.createElement('div');
						offscreen.innerHTML = html;

						var newFp = _computeDiffFingerprint(offscreen);
						if (newFp && newFp === _lastDiffFingerprint) {
							// Diff unchanged — no DOM mutation, no scroll disruption.
							return;
						}
						_lastDiffFingerprint = newFp;

						// Content changed — apply the swap with UI state preservation.
						var scrollX = window.scrollX || window.pageXOffset || 0;
						var scrollY = window.scrollY || window.pageYOffset || 0;
						var viewMode = _getDiffViewMode();

							changesContent.innerHTML = html;
							if (typeof htmx !== 'undefined' && typeof htmx.process === 'function') {
								htmx.process(changesContent);
							}

							// Let the browser settle the new DOM, then restore UI state.
							requestAnimationFrame(function() {
								// Restore diff view mode (inline/split) without saving during refresh restore.
								if ((viewMode === 'inline' || viewMode === 'split') && typeof switchDiffView === 'function') {
									switchDiffView(viewMode, false);
								}
								// Restore scroll position so the user stays where they were.
								window.scrollTo(scrollX, scrollY);
							});
					}).catch(function() {
						_fileChangesUpdatePending = false;
					});
				} else {
					_fileChangesUpdatePending = false;
				}
			}

				// Start SSE if changes tab is active on page load and task is running/queued
				(function() {
					setTimeout(function() {
						if (_isChatTabActive()) {
							var threadContent = document.getElementById('thread-content');
							var taskId = (threadContent && threadContent.dataset.taskId) || _currentTaskIdFromPath();
							if (taskId) {
								_loadThreadContent(taskId).then(function() {
										_restoreThreadScrollOrBottom(taskId, false);
									});							}
						}
						if (_isChangesTabActive()) {
							var changesContent = document.getElementById('changes-content');
							if (changesContent) {
								var taskId = changesContent.dataset.taskId;
								if (taskId) {
									_startFileChangesSSE(taskId);
									// Seed fingerprint from initial server render.
									_lastDiffFingerprint = _computeDiffFingerprint(changesContent);
							}
						}
					}
				}, 100);
				})();

				// Refresh the action buttons (Run Now / Edit / Delete) via the lightweight
				// /tasks/:id/detail-actions fragment endpoint.  Called both from the polling
				// afterSettle handler (up to 3s after completion) and from the SSE task-event
				// listener below (fires immediately on task_status_changed events).
				function _refreshTaskDetailActions() {
					var actions = document.getElementById('task-detail-actions');
					if (!actions) return;
					var taskIdMatch = window.location.pathname.match(/\/tasks\/([^\/]+)/);
					if (!taskIdMatch || !taskIdMatch[1]) return;
					if (typeof htmx === 'undefined') return;
					htmx.ajax('GET', '/tasks/' + taskIdMatch[1] + '/detail-actions', {
						target: '#task-detail-actions',
						swap: 'outerHTML'
					});
				}

				var _prevTaskStatus = null;
					if (window._taskDetailFileChangesHandlers) {
						if (window._taskDetailFileChangesHandlers.beforeUnload) {
							window.removeEventListener('beforeunload', window._taskDetailFileChangesHandlers.beforeUnload);
						}
						if (window._taskDetailFileChangesHandlers.liveConnected) {
							window.removeEventListener('sse-live-connected', window._taskDetailFileChangesHandlers.liveConnected);
						}
					if (window._taskDetailFileChangesHandlers.afterSettle) {
						document.removeEventListener('htmx:afterSettle', window._taskDetailFileChangesHandlers.afterSettle);
					}
					if (window._taskDetailFileChangesHandlers.beforeSwap) {
						document.body.removeEventListener('htmx:beforeSwap', window._taskDetailFileChangesHandlers.beforeSwap);
					}
					if (window._taskDetailFileChangesHandlers.beforeRequest) {
						document.body.removeEventListener('htmx:beforeRequest', window._taskDetailFileChangesHandlers.beforeRequest);
					}
					if (window._taskDetailFileChangesHandlers.fileChangeEvent) {
						window.removeEventListener('sse-file-change-event', window._taskDetailFileChangesHandlers.fileChangeEvent);
					}
					if (window._taskDetailFileChangesHandlers.taskEvent) {
						window.removeEventListener('sse-task-event', window._taskDetailFileChangesHandlers.taskEvent);
					}
				}

				var _taskDetailFileChangeEventHandler = _handleSharedFileChangeEvent;

				// Listen for SSE task_status_changed events so action buttons refresh immediately
				// on task completion — without waiting up to 3s for the next metrics poll cycle.
					var _taskDetailTaskEventHandler = function(event) {
						var data = event.detail || {};
						// Only react to this task's events
						var taskIdMatch = window.location.pathname.match(/\/tasks\/([^\/]+)/);
						if (!taskIdMatch || !taskIdMatch[1] || data.task_id !== taskIdMatch[1]) return;
						if (data.type === 'task_thread_execution_started' || data.type === 'task_thread_input_applied') {
							// TaskThreadLiveEventsScript owns these events. It appends the
							// authoritative execution fragment and attaches /events/chat/:exec_id
							// without replacing #thread-content or closing the fresh stream.
							return;
						}
						if (data.type === 'task_status_changed') {
							var activeStatuses = { pending: true, queued: true, running: true };
							if (activeStatuses[data.status]) {
								// Skip the full thread reload if the composer has a pending attachment
								// upload session to avoid destroying unsent attachment state while a
								// parallel task activation event arrives.
								var sessionInputSC = document.getElementById('task-thread-form-session-id');
								if (!sessionInputSC || !sessionInputSC.value) {
									if (window.reconcileTaskThreadState) window.reconcileTaskThreadState(data.task_id);
									else _refreshActiveThreadContent(data.task_id, true, data.exec_id || '', 0);
								}
							}
							var terminalStatuses = { completed: true, failed: true, cancelled: true };
							if (terminalStatuses[data.status]) {
								_refreshTaskDetailActions();
							}
						}
					};

					var _taskDetailLiveConnectedHandler = function(event) {
						var detail = event.detail || {};
						// Only react to actual SSE reconnects (e.g. after tab blur/refocus).
						// The initial SSE connection is handled by the page-load init below.
						if (!detail.reconnected) return;
						var taskId = _currentTaskIdFromPath();
						if (!taskId || !_isChatTabActive()) return;
						var threadContent = document.getElementById('thread-content');
						if (!threadContent || threadContent.dataset.taskId !== taskId) return;
						// Never replace the composer while it owns a pending upload session.
						var sessionInput = document.getElementById('task-thread-form-session-id');
						if (sessionInput && sessionInput.value) return;
						if (threadContent.dataset.loaded !== 'true') {
							_loadThreadContent(taskId, false);
							return;
						}
						// The scoped thread script compares authoritative snapshot revisions and
						// suppresses unchanged morphs before streams or DOM state are touched.
						if (window.reconcileTaskThreadState) window.reconcileTaskThreadState(taskId);
					};

					var _taskDetailBeforeUnloadHandler = function() {
						_stopFileChangesSSE();
					};

				var _taskDetailBeforeSwapHandler = function(evt) {
					var target = evt.detail && evt.detail.target;
					if (!target) return;
						if (target.id === 'main-content' || target.id === 'task-detail-content') {
							_stopFileChangesSSE();
							window.removeEventListener('sse-file-change-event', _taskDetailFileChangeEventHandler);
							window.removeEventListener('sse-task-event', _taskDetailTaskEventHandler);
							window.removeEventListener('sse-live-connected', _taskDetailLiveConnectedHandler);
						}
				};

				// Block event-triggered changes refreshes while Changes tab is not active.
				var _taskDetailBeforeRequestHandler = function(evt) {
					var triggerEl = evt.detail && evt.detail.elt;
					if (!triggerEl) return;
					if (triggerEl.id === 'changes-content' && !_isChangesTabActive()) {
						evt.preventDefault();
					}
				};

				// Watch for task status changes to stop SSE and do final refresh.
				var _taskDetailAfterSettleHandler = function(evt) {
					var metrics = document.getElementById('task-detail-metrics');
					if (!metrics) return;
					var status = metrics.dataset.taskStatus;
					if (!status) return;
					if (_prevTaskStatus === null) {
					_prevTaskStatus = status;
					return;
				}
				if (_prevTaskStatus !== status) {
					var wasActive = (_prevTaskStatus === 'running' || _prevTaskStatus === 'queued');
					var nowActive = (status === 'running' || status === 'queued');
						var nowDone = (status === 'completed' || status === 'failed' || status === 'cancelled');
						_prevTaskStatus = status;
						if (wasActive && nowDone) {
							// Task just finished — stop SSE, do final changes refresh, and update action buttons
							_stopFileChangesSSE();
							_updateDiffViewer('final');
							_refreshTaskDetailActions();
						}
						if (!wasActive && nowActive && _fileChangesTaskId && _isChangesTabActive()) {
							// Task reactivated (e.g., follow-up on completed task) while changes tab is open.
							// Restart SSE so realtime diff snapshots resume for this execution.
							_startFileChangesSSE(_fileChangesTaskId);
						}
					}
				};

					window._taskDetailFileChangesHandlers = {
						beforeUnload: _taskDetailBeforeUnloadHandler,
						beforeSwap: _taskDetailBeforeSwapHandler,
						beforeRequest: _taskDetailBeforeRequestHandler,
						afterSettle: _taskDetailAfterSettleHandler,
						fileChangeEvent: _taskDetailFileChangeEventHandler,
						taskEvent: _taskDetailTaskEventHandler,
						liveConnected: _taskDetailLiveConnectedHandler
					};

					window.addEventListener('beforeunload', _taskDetailBeforeUnloadHandler);
					document.body.addEventListener('htmx:beforeSwap', _taskDetailBeforeSwapHandler);
					document.body.addEventListener('htmx:beforeRequest', _taskDetailBeforeRequestHandler);
					document.addEventListener('htmx:afterSettle', _taskDetailAfterSettleHandler);
					window.addEventListener('sse-file-change-event', _taskDetailFileChangeEventHandler);
					window.addEventListener('sse-task-event', _taskDetailTaskEventHandler);
					window.addEventListener('sse-live-connected', _taskDetailLiveConnectedHandler);

			function copyToClipboard(elementId, button) {
				var element = document.getElementById(elementId);
				if (!element) return;

				var text = element.textContent;
				navigator.clipboard.writeText(text).then(function() {
					var originalHTML = button.innerHTML;
					button.innerHTML = '<svg xmlns="http://www.w3.org/2000/svg" class="h-4 w-4" fill="none" viewBox="0 0 24 24" stroke="currentColor"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M5 13l4 4L19 7"></path></svg>';
					button.classList.add('btn-success');

					setTimeout(function() {
						button.innerHTML = originalHTML;
						button.classList.remove('btn-success');
					}, 2000);
				}).catch(function(err) {
					console.error('Failed to copy text: ', err);
				});
			}

			// Listen for showToast events from HTMX responses
			// Guard against multiple listener registrations
			if (!window._showToastListenerRegistered) {
				window._showToastListenerRegistered = true;
				
				// Deduplication: track recent toasts by message+type key
				window._recentToasts = window._recentToasts || new Map();
				
				document.body.addEventListener('showToast', function(event) {
					if (event.detail && event.detail.message) {
						const container = document.getElementById('toast-container');
						if (!container) return;

						// Create deduplication key from message + type + taskId (if present)
						const dedupKey = event.detail.message + '|' + (event.detail.type || 'info') + '|' + (event.detail.taskId || '');
						const now = Date.now();
						
						// Check if this exact toast was shown recently (within 1 second)
						if (window._recentToasts.has(dedupKey)) {
							const lastShown = window._recentToasts.get(dedupKey);
							if (now - lastShown < 1000) {
								// Duplicate toast within 1 second - skip
								return;
							}
						}
						
						// Record this toast
						window._recentToasts.set(dedupKey, now);
						
						// Clean up old entries (older than 5 seconds)
						for (const [key, timestamp] of window._recentToasts.entries()) {
							if (now - timestamp > 5000) {
								window._recentToasts.delete(key);
							}
						}

						const alertClass = event.detail.type === 'success' ? 'alert-success' : 
						                   event.detail.type === 'error' ? 'alert-error' : 
						                   event.detail.type === 'warning' ? 'alert-warning' : 'alert-info';
						
						const icon = event.detail.type === 'success' ? 
							'<svg xmlns="http://www.w3.org/2000/svg" class="h-5 w-5 shrink-0" fill="none" viewBox="0 0 24 24" stroke="currentColor"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 12l2 2 4-4m6 2a9 9 0 11-18 0 9 9 0 0118 0z" /></svg>' :
							'<svg xmlns="http://www.w3.org/2000/svg" class="h-5 w-5 shrink-0" fill="none" viewBox="0 0 24 24" stroke="currentColor"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M13 16h-1v-4h-1m1-4h.01M21 12a9 9 0 11-18 0 9 9 0 0118 0z" /></svg>';

						const toast = document.createElement('div');
						toast.className = 'toast-notification alert ' + alertClass + ' shadow-lg';
						toast.innerHTML = icon + '<span>' + event.detail.message + '</span>';
						
						container.appendChild(toast);

						// Auto-dismiss after 4 seconds
						setTimeout(function() {
							toast.classList.add('toast-dismiss');
							setTimeout(function() { toast.remove(); }, 300);
						}, 4000);
					}
				});
			}
		</script>
	</div>
}

// TaskDetailActions renders the action buttons (Run Now / Edit / Delete) for the details tab.
// This fragment is independently refreshable via GET /tasks/:taskId/detail-actions so that
// action button state (disabled Run Now, hidden Edit) updates in real time when a task finishes.
templ TaskDetailActions(task *models.Task) {
	<div id="task-detail-actions" class="flex gap-2">
		if task.Status == models.StatusRunning || task.Status == models.StatusQueued {
			<button
				class="btn btn-primary btn-sm"
				disabled
				title="Task is already running or queued"
			>
				Run Now
			</button>
		} else {
			<button
				class="btn btn-primary btn-sm"
				hx-post={ fmt.Sprintf("/tasks/%s/run", task.ID) }
				hx-swap="none"
				hx-on::after-request={ templ.ComponentScript{Call: fmt.Sprintf("if(event.detail.successful) { window._openTaskThreadAfterRun && window._openTaskThreadAfterRun('%s'); }", task.ID)} }
			>
				Run Now
			</button>
		}
		if task.Status != models.StatusRunning {
			<button
				class="btn btn-secondary btn-sm"
				onclick="document.getElementById('task-detail-view').classList.add('hidden'); document.getElementById('task-detail-edit').classList.remove('hidden')"
			>
				Edit
			</button>
		}
		<button
			class="btn btn-sm btn-error btn-outline"
			onclick="document.getElementById('delete-task-modal').showModal()"
		>
			Delete
		</button>
	</div>
}

func taskExecutionMetricsFromExecutions(executions []models.Execution) models.TaskExecutionMetrics {
	var metrics models.TaskExecutionMetrics
	if len(executions) > 0 {
		started := executions[len(executions)-1].StartedAt
		metrics.LatestStartedAt = &started
	}
	for i := len(executions) - 1; i >= 0; i-- {
		if executions[i].DurationMs > 0 {
			metrics.LatestDurationMs = executions[i].DurationMs
			break
		}
	}
	return metrics
}

// TaskDetailMetrics renders the status/category/tag/priority/model/agent metrics grid with polling.
// Polls every 3s to keep status badges up to date when task state changes (e.g., via chat interaction).
templ TaskDetailMetrics(task *models.Task, metrics models.TaskExecutionMetrics, agents []models.LLMConfig, agentDefs []models.Agent) {
	<div
		id="task-detail-metrics"
		class="grid grid-cols-2 md:grid-cols-4 gap-4 mb-6"
		hx-get={ fmt.Sprintf("/tasks/%s/detail-status", task.ID) }
		hx-trigger="every 3s"
		hx-target="#task-detail-metrics"
		hx-swap="morph:outerHTML"
		data-task-status={ string(task.Status) }
	>
		<div>
			<span class="text-sm opacity-60">Category:</span>
			<span class="ml-2 badge badge-sm badge-outline">{ string(task.Category) }</span>
		</div>
		// Only show status badge if it provides meaningful information beyond category
		// For backlog/scheduled tasks with pending status, the category badge is sufficient
		if !(task.Status == models.StatusPending && (task.Category == models.CategoryBacklog || task.Category == models.CategoryScheduled)) {
			<div>
				<span class="text-sm opacity-60">Status:</span>
				<span class={ "ml-2 badge badge-sm", components.StatusBadgeClass(task.Status) }>{ components.StatusLabelForTask(task.Status, task.Category) }</span>
			</div>
		}
		<div>
			<span class="text-sm opacity-60">Tag:</span>
			if task.Tag != "" {
				<span class="ml-2 badge badge-sm badge-outline inline-flex items-center">{ components.TagLabel(task.Tag) }</span>
			} else {
				<span class="ml-2 badge badge-sm badge-outline opacity-70">None</span>
			}
		</div>
		if components.PriorityLabel(task.Priority) != "" {
			<div>
				<span class="text-sm opacity-60">Priority:</span>
				<span class="ml-2 badge badge-sm badge-outline">{ components.PriorityLabel(task.Priority) }</span>
			</div>
		}
		<div>
			<span class="text-sm opacity-60">Model:</span>
			<span class="ml-2 badge badge-sm badge-outline">{ taskModelLabel(task, agents) }</span>
		</div>
		<div>
			<span class="text-sm opacity-60">Agent:</span>
			<span class="ml-2 badge badge-sm badge-outline">{ taskAgentLabel(task, agentDefs) }</span>
		</div>
		if task.Status == models.StatusRunning && metrics.LatestStartedAt != nil {
			<div>
				<span class="text-sm opacity-60">Elapsed:</span>
				<span class="ml-2 badge badge-warning">{ components.FormatElapsedTime(*metrics.LatestStartedAt) }</span>
			</div>
		}
		if (task.Status == models.StatusCompleted || task.Status == models.StatusFailed) && metrics.LatestDurationMs > 0 {
			if dur := components.FormatDuration(metrics.LatestDurationMs); dur != "" {
				<div>
					<span class="text-sm opacity-60">Duration:</span>
					<span class="ml-2 badge badge-sm badge-outline">{ dur }</span>
				</div>
			}
		}
	</div>
}

templ SwarmContextPanel(task *models.Task) {
	if task.SwarmRole == models.SwarmRoleParent {
		<div class="card bg-base-200/50 border border-base-300 mb-4">
			<div class="card-body p-4">
				<h3 class="font-semibold mb-2">Swarm Overview</h3>
					<div class="grid grid-cols-1 gap-2 text-sm sm:grid-cols-2">
						<div><span class="opacity-60">Status:</span> { components.SwarmStatusDisplayName(task.SwarmStatus) }</div>
						<div><span class="opacity-60">Children:</span> { fmt.Sprintf("%d", len(task.SwarmChildren)) }</div>
						if task.WorktreeBranch != "" {
							<div class="sm:col-span-2 min-w-0"><span class="opacity-60">Merge worktree:</span> <span class="break-all">{ task.WorktreeBranch }</span></div>
						}
					</div>
				if len(task.SwarmChildren) > 0 {
					<div class="mt-3 space-y-1">
						for _, child := range task.SwarmChildren {
							<div class="flex flex-wrap items-center gap-2 text-sm">
								<span class={ "badge badge-sm", components.StatusBadgeClass(child.Status) }>{ components.StatusLabelForTask(child.Status, child.Category) }</span>
								<a class="link link-primary" href={ templ.SafeURL(fmt.Sprintf("/tasks/%s", child.ID)) } hx-get={ fmt.Sprintf("/tasks/%s", child.ID) } hx-target="#main-content" hx-swap="innerHTML" hx-push-url="true">{ child.Title }</a>
									<span class="opacity-60">{ components.SwarmRoleDisplayName(child.SwarmRole) }</span>
								if child.WorktreeBranch != "" {
									<a class="link" href={ templ.SafeURL(fmt.Sprintf("/tasks/%s?tab=changes", child.ID)) } hx-get={ fmt.Sprintf("/tasks/%s?tab=changes", child.ID) } hx-target="#main-content" hx-swap="innerHTML" hx-push-url="true">diff</a>
								}
							</div>
						}
					</div>
				}
			</div>
		</div>
	} else if models.IsSwarmChildRole(task.SwarmRole) {
		<div class="card bg-base-200/50 border border-base-300 mb-4">
			<div class="card-body p-4">
				<h3 class="font-semibold mb-2">Swarm Context</h3>
				<div class="space-y-1 text-sm">
					if task.ParentTaskID != nil {
						<div>Part of swarm: <a class="link link-primary" href={ templ.SafeURL(fmt.Sprintf("/tasks/%s", *task.ParentTaskID)) } hx-get={ fmt.Sprintf("/tasks/%s", *task.ParentTaskID) } hx-target="#main-content" hx-swap="innerHTML" hx-push-url="true">{ *task.ParentTaskID }</a></div>
					}
					<div>Role: { components.SwarmRoleDisplayName(task.SwarmRole) }</div>
					if task.WorktreeBranch != "" {
						<div class="break-all">Worktree: { task.WorktreeBranch }</div>
					}
				</div>
			</div>
		</div>
	}
}

templ TaskPromptPanel(task *models.Task) {
	<div id="task-prompt-panel" class="card bg-base-200/50 border border-base-300 mb-4">
		<div class="card-body p-4 gap-3">
			<div class="text-sm font-semibold">Prompt</div>
			if task.Prompt != "" {
				<div class="textarea textarea-bordered textarea-sm w-full min-h-32 h-auto cursor-default whitespace-pre-wrap overflow-x-auto font-sans text-sm leading-relaxed">{ task.Prompt }</div>
			} else {
				<p class="text-sm opacity-60">No prompt set</p>
			}
		</div>
	</div>
}

templ TaskGoalPanel(taskID string, goal *models.TaskGoal) {
	<div id="task-goal-panel" class="card bg-base-200/50 border border-base-300 mb-4" data-task-id={ taskID }>
		<div class="card-body p-4 gap-3">
			<div class="flex items-center justify-between gap-3">
				<div>
					<div class="text-sm font-semibold">Goal</div>
					if goal == nil || goal.Status == models.TaskGoalStatusCleared {
						<div class="text-sm opacity-60">No goal set</div>
					}
				</div>
				if goal != nil && goal.Status != models.TaskGoalStatusCleared {
					<span class="badge badge-outline">{ goalStatusLabel(goal) }</span>
				}
			</div>
			if goal != nil && goal.Status != models.TaskGoalStatusCleared {
				<div class="textarea textarea-bordered textarea-sm w-full min-h-20 h-auto cursor-default whitespace-pre-wrap overflow-x-auto font-sans text-sm leading-relaxed">{ goal.Objective }</div>
				if goal.Reason != "" {
					<p class="text-xs opacity-60">Reason: { goal.Reason }</p>
				}
				if goal.LastCheckedAt != nil {
					<p class="text-xs opacity-60">Last checked: { goal.LastCheckedAt.Local().Format("Jan 2, 2006 3:04 PM") }</p>
				} else {
					<p class="text-xs opacity-60">Last checked: not yet</p>
				}
			}
		</div>
	</div>
}

func goalValue(goal *models.TaskGoal) string {
	if goal == nil || goal.Status == models.TaskGoalStatusCleared {
		return ""
	}
	return goal.Objective
}

func goalStatusLabel(goal *models.TaskGoal) string {
	if goal == nil {
		return ""
	}
	if goal.Status == models.TaskGoalStatusPaused && strings.EqualFold(strings.TrimSpace(goal.Reason), "stopped by user") {
		return "Paused (stopped by user)"
	}
	return string(goal.Status)
}

func taskModelLabel(task *models.Task, agents []models.LLMConfig) string {
	if task == nil || task.AgentID == nil || *task.AgentID == "" {
		return "Default model"
	}
	for _, agent := range agents {
		if agent.ID == *task.AgentID {
			if agent.Name != "" {
				return agent.Name
			}
			if agent.Model != "" {
				return agent.Model
			}
			break
		}
	}
	return "Unknown model"
}

func taskAgentLabel(task *models.Task, agentDefs []models.Agent) string {
	if task == nil || task.AgentDefinitionID == nil || *task.AgentDefinitionID == "" {
		return "No agent"
	}
	for _, agent := range agentDefs {
		if agent.ID == *task.AgentDefinitionID {
			if agent.Name != "" {
				return agent.Name
			}
			break
		}
	}
	return "Unknown agent"
}
