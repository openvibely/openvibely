								return Promise.resolve();
							}
							var version = state.requestVersion;
							var requestID = ++state.requestSerial;
							state.olderRequestID = requestID;
							state.olderLoading = true;
							state.olderError = '';
							renderState(state, container, true);
							return fetchPage(taskID, projectID, 'older', cursor).then(function(page) {
								if (!requestIsCurrent(state, container, version, requestID, 'older')) return;
								mergeRows(state, page.items);
								state.loadedOlder = true;
								state.olderCursor = page.nextCursor || '';
								state.olderHasMore = page.hasMore && page.items.length > 0;
								state.olderLoading = false;
								state.olderError = '';
