								schedulePendingRefresh(state, taskID, projectID);
								schedulePendingNewer(state, taskID, projectID);
							});
						}
						function scheduleLiveRefresh(taskID, projectID, mode) {
							var state = getState(taskID, projectID);
							if (mode === 'newer') {
								if (state.refreshPending || state.refreshLiveTimer || state.refreshRetryTimer) return;
								if (hasActiveLifecycleRequest(state)) {
									state.newerPending = true;
									return;
								}
								if (state.newerLiveTimer) return;
								state.newerLiveTimer = setTimeout(function() {
									state.newerLiveTimer = null;
