							return requestIsCurrent(state, container, version, requestID, 'gap') && gap.requestID === requestID && findLifecycleGap(state, gap.id) === gap;
						}

						function loadLifecycleGap(taskID, projectID, gapID) {
							var container = lifecycleContainer(taskID, projectID);
							if (!container) return Promise.resolve();
							projectID = projectID || container.dataset.projectId || '';
							var state = getState(taskID, projectID);
