						function normalizePage(payload) {
							if (Array.isArray(payload)) return { items: payload, hasMore: false, nextCursor: '' };
							if (!payload || !Array.isArray(payload.items)) throw new Error('invalid lifecycle page response');
							return {
								items: payload.items,
								hasMore: payload.has_more === true && !!payload.next_cursor,
								nextCursor: String(payload.next_cursor || '')
							};
						}

						function fetchPage(taskID, projectID, direction, cursor) {
							var params = ['project_id=' + encodeURIComponent(projectID || ''), 'limit=' + pageSize];
							if (cursor) params.push((direction === 'older' ? 'before=' : 'after=') + encodeURIComponent(cursor));
							return fetch('/api/tasks/' + encodeURIComponent(taskID) + '/lifecycle-executions?' + params.join('&'), { headers: { 'Accept': 'application/json' } }).then(function(response) {
								if (!response.ok) throw new Error('failed to load lifecycle executions');
								return response.json();
							}).then(normalizePage);
						}

						function fetchExecution(taskID, projectID, executionID) {
							var url = '/api/tasks/' + encodeURIComponent(taskID) + '/lifecycle-executions/' + encodeURIComponent(executionID) + '?project_id=' + encodeURIComponent(projectID || '');
							return fetch(url, { headers: { 'Accept': 'application/json' } }).then(function(response) {
								if (!response.ok) throw new Error('failed to refresh lifecycle execution');
								return response.json();
							}).then(function(row) {
								if (!row || String(row.id || '') !== String(executionID)) throw new Error('invalid lifecycle execution response');
								return row;
							});
						}

						function markExecutionForRefresh(state, executionID) {
							executionID = String(executionID || '');
							if (executionID && state.records[executionID]) state.refreshExecutionIDs[executionID] = true;
						}

						function markRetainedNonterminalExecutions(state) {
							state.order.forEach(function(executionID) {
								var row = state.records[executionID] || {};
								if (row.status === 'pending' || row.status === 'queued' || row.status === 'running') state.refreshExecutionIDs[executionID] = true;
							});
						}

						function addLifecycleGap(state, cursor, boundaryID) {
							cursor = String(cursor || '');
							boundaryID = String(boundaryID || '');
							if (!cursor || !boundaryID) return;
							var duplicate = state.gaps.some(function(gap) { return gap.cursor === cursor || gap.boundaryID === boundaryID; });
							if (duplicate) return;
							state.gaps.push({
								id: String(++state.gapSerial),
								cursor: cursor,
								boundaryID: boundaryID,
								loading: false,
								error: '',
								requestID: 0
							});
						}

						function removeLifecycleGap(state, gap) {
							state.gaps = state.gaps.filter(function(candidate) { return candidate !== gap; });
						}

						function findLifecycleGap(state, gapID) {
							for (var i = 0; i < state.gaps.length; i++) {
								if (state.gaps[i].id === String(gapID || '')) return state.gaps[i];
							}
