package pages

import (
	"fmt"
	"strings"

	"github.com/openvibely/openvibely/internal/models"
	"github.com/openvibely/openvibely/web/templates/components"
	"github.com/openvibely/openvibely/web/templates/layout"
)

// TaskChangesContent renders just the changes tab content (for HTMX partial updates)
templ TaskChangesContent(diffOutput string, taskID string, reviewComments []models.ReviewComment) {
	@TaskChangesContentWithView(diffOutput, taskID, reviewComments, "inline")
}

templ TaskChangesContentWithView(diffOutput string, taskID string, reviewComments []models.ReviewComment, diffView string) {
	<div class="card bg-base-100 shadow-sm border border-base-300">
		<div class="card-body">
			<h4 class="text-lg font-bold mb-3">File Changes</h4>
			<div id="diff-viewer-container">
				@components.DiffViewerWithReviewView(diffOutput, taskID, reviewComments, diffView)
			</div>
		</div>
	</div>
}

templ TaskDetailPage(projects []models.Project, task *models.Task, goal *models.TaskGoal, metrics *models.TaskExecutionMetrics, schedules []models.Schedule, agents []models.LLMConfig, agentDefs []models.Agent, attachments []models.Attachment, defaultTab string, reviewComments []models.ReviewComment) {
	@layout.Base(task.Title, projects, task.ProjectID) {
		@TaskDetailContent(task, goal, metrics, schedules, agents, agentDefs, attachments, defaultTab, reviewComments)
	}
}

script removeEditAttachment(attID string) {
	var el = document.getElementById('edit-att-' + attID);
	if (el) el.remove();
	var input = document.getElementById('remove-attachments-input');
	if (input) {
		var ids = input.value ? input.value.split(',') : [];
		ids.push(attID);
		input.value = ids.join(',');
	}
}

templ TaskDetailContent(task *models.Task, goal *models.TaskGoal, metrics *models.TaskExecutionMetrics, schedules []models.Schedule, agents []models.LLMConfig, agentDefs []models.Agent, attachments []models.Attachment, defaultTab string, reviewComments []models.ReviewComment) {
	<div id="task-detail-content" class="h-full flex flex-col">
		@layout.PageTitle(task.Title)
		<!-- Breadcrumb navigation -->
		<div class="flex items-center gap-2 mb-6 flex-shrink-0 min-w-0">
			<a
				id="task-automations-back-btn"
				href={ templ.SafeURL(fmt.Sprintf("/automations?project_id=%s", task.ProjectID)) }
				hx-get={ fmt.Sprintf("/automations?project_id=%s", task.ProjectID) }
				hx-target="#main-content"
				hx-swap="innerHTML"
				hx-push-url="true"
				class="text-2xl text-base-content/50 hover:text-base-content/80 transition-colors flex-shrink-0"
				data-automations-url={ fmt.Sprintf("/automations?project_id=%s", task.ProjectID) }
				hidden
			>
				Automations
			</a>
			<span id="task-automations-separator" class="text-2xl text-base-content/30 flex-shrink-0" hidden>/</span>
			<a
				id="task-back-btn"
				href={ templ.SafeURL(fmt.Sprintf("/tasks?project_id=%s", task.ProjectID)) }
				hx-get={ fmt.Sprintf("/tasks?project_id=%s", task.ProjectID) }
				hx-target="#main-content"
				hx-swap="innerHTML"
				hx-push-url="true"
				class="text-2xl text-base-content/50 hover:text-base-content/80 transition-colors flex-shrink-0"
				data-tasks-url={ fmt.Sprintf("/tasks?project_id=%s", task.ProjectID) }
				data-schedule-url={ fmt.Sprintf("/schedule?project_id=%s", task.ProjectID) }
				data-chat-url={ fmt.Sprintf("/chat?project_id=%s", task.ProjectID) }
				data-alerts-url={ fmt.Sprintf("/alerts?project_id=%s", task.ProjectID) }
				data-project-id={ task.ProjectID }
				data-automation-url-base="/automations/"
			>
				Tasks
			</a>
			<span class="text-2xl text-base-content/30 flex-shrink-0">/</span>
			<div class="min-w-0 flex-1">
				@components.BreadcrumbSelector(models.BreadcrumbSelector{
					ID: "task-resource-selector", Kind: "Task", CurrentID: task.ID, CurrentName: task.Title,
					SearchURL: fmt.Sprintf("/breadcrumb-selectors/tasks?project_id=%s&current_id=%s&tab=%s", task.ProjectID, task.ID, defaultTab),
				})
			</div>
			<script>
				(function() {
					var params = new URLSearchParams(window.location.search);
					var from = params.get('from');
					var btn = document.getElementById('task-back-btn');
					var automationsBtn = document.getElementById('task-automations-back-btn');
					var automationsSeparator = document.getElementById('task-automations-separator');
					if (btn) {
						var url = null;
						var text = 'Tasks';
						if (from === 'schedule') {
							url = btn.dataset.scheduleUrl;
							text = 'Schedule';
						} else if (from === 'chat') {
							url = btn.dataset.chatUrl;
							text = 'Chat';
						} else if (from === 'alerts') {
							url = btn.dataset.alertsUrl;
							text = 'Alerts';
						} else if (from === 'automation') {
							var automationID = params.get('automation_id');
							var automationName = params.get('automation_name');
							if (automationID) {
								url = btn.dataset.automationUrlBase + encodeURIComponent(automationID) + '?project_id=' + encodeURIComponent(btn.dataset.projectId);
								text = automationName || 'Automation';
								if (automationsBtn && automationsSeparator) {
									automationsBtn.hidden = false;
									automationsSeparator.hidden = false;
								}
							}
						}
						if (url) {
							btn.setAttribute('href', url);
							btn.setAttribute('hx-get', url);
							btn.textContent = text;
							if (typeof htmx !== 'undefined') {
								htmx.process(btn);
							}
						}
					}
				})();
			</script>
		</div>
		<!-- Tabs Navigation -->
		<div role="tablist" class="tabs tabs-bordered tabs-sm mb-6 flex-shrink-0 w-full overflow-x-auto flex-nowrap">
			<a role="tab" class={ "tab", templ.KV("tab-active", defaultTab == "details") } data-tab="details" onclick="switchTaskTab('details')">Details</a>
			<a role="tab" class={ "tab", templ.KV("tab-active", defaultTab == "chat") } data-tab="chat" onclick="switchTaskTab('chat')">Thread</a>
			<a role="tab" class={ "tab", templ.KV("tab-active", defaultTab == "changes") } data-tab="changes" onclick="switchTaskTab('changes')">Changes</a>
			<a role="tab" class={ "tab", templ.KV("tab-active", defaultTab == "schedules") } data-tab="schedules" onclick="switchTaskTab('schedules')">Schedules</a>
			<a role="tab" class={ "tab", templ.KV("tab-active", defaultTab == "chaining") } data-tab="chaining" onclick="switchTaskTab('chaining')">Chaining</a>
			<a role="tab" class={ "tab", templ.KV("tab-active", defaultTab == "attachments") } data-tab="attachments" onclick="switchTaskTab('attachments')">Attachments</a>
			<a role="tab" class={ "tab", templ.KV("tab-active", defaultTab == "lifecycle") } data-tab="lifecycle" onclick="switchTaskTab('lifecycle')">Lifecycle</a>
		</div>
		<!-- Tab: Details -->
		<div id="tab-details" class={ "task-tab-panel flex-1 flex flex-col min-h-0", templ.KV("hidden", defaultTab != "details") }>
			<div class="card bg-base-100 shadow-sm border border-base-300 flex-1 flex flex-col min-h-0 overflow-hidden">
				<div class="card-body flex-1 flex flex-col min-h-0">
					<!-- View Mode -->
						<div id="task-detail-view" class="flex-1 overflow-y-auto min-h-0 pr-1">
								@TaskDetailMetrics(task, taskExecutionMetricsValue(metrics), agents, taskAgentLabelFromDefinitions(task, agentDefs))
							@SwarmContextPanel(task)
							@TaskPromptPanel(task)
						@TaskGoalPanel(task.ID, goal)
						// Worktree info panel (shown when task has worktree or is in a git project)
						if task.WorktreeBranch != "" || task.WorktreePath != "" {
							<div
								id="worktree-info-wrapper"
								hx-get={ fmt.Sprintf("/tasks/%s/worktree", task.ID) }
								hx-trigger="load"
								hx-target="#worktree-info-wrapper"
								hx-swap="innerHTML"
							>
								@WorktreeInfoPanel(task, nil)
							</div>
						}
						@TaskDetailActions(task)
						<!-- Delete Confirmation Modal -->
						<dialog id="delete-task-modal" class="modal">
							<div class="modal-box">
								@ModalCloseButton("document.getElementById('delete-task-modal')", "Close delete task confirmation")
								<h3 class="font-bold text-lg pr-10">Delete Task</h3>
								<p class="py-4">Are you sure you want to delete this task? This will also remove all executions, chat messages, schedules, and attachments. This action cannot be undone.</p>
								<div class="modal-action">
									<form method="dialog">
										<button class="btn btn-ghost btn-sm">Cancel</button>
									</form>
									<button
										id="delete-task-confirm-button"
										class="btn btn-error btn-sm"
										hx-delete={ fmt.Sprintf("/tasks/%s?redirect=list", task.ID) }
										hx-swap="none"
										data-delete-url={ fmt.Sprintf("/tasks/%s?redirect=list", task.ID) }
										data-schedule-delete-url={ fmt.Sprintf("/tasks/%s?redirect=list&return_to=schedule", task.ID) }
									>
										Delete
									</button>
								</div>
								</div>
								<form method="dialog" class="modal-backdrop">
									<button>close</button>
								</form>
							</dialog>
							<script>
								(function() {
									var params = new URLSearchParams(window.location.search);
									if (params.get('from') !== 'schedule') return;
									var deleteBtn = document.getElementById('delete-task-confirm-button');
									if (deleteBtn && deleteBtn.dataset.scheduleDeleteUrl) {
										deleteBtn.setAttribute('hx-delete', deleteBtn.dataset.scheduleDeleteUrl);
										if (typeof htmx !== 'undefined') {
											htmx.process(deleteBtn);
										}
									}
								})();
							</script>
						</div>
					<!-- Edit Form -->
					<div id="task-detail-edit" class="hidden flex-1 overflow-y-auto min-h-0">
						<form
							method="post"
							id={ fmt.Sprintf("edit-task-form-%s", task.ID) }
							hx-put={ fmt.Sprintf("/tasks/%s", task.ID) }
							hx-target="#task-detail-content"
							hx-swap="outerHTML"
							hx-encoding="multipart/form-data"
						>
							<div class="form-control mb-4">
								<label class="label">
									<span class="label-text">Title</span>
								</label>
								<input
									type="text"
									id={ fmt.Sprintf("edit-task-title-%s", task.ID) }
									name="title"
									value={ task.Title }
									class="input input-bordered"
									required
								/>
								<div id={ fmt.Sprintf("edit-title-error-%s", task.ID) } class="hidden mt-2 flex items-center gap-2 text-error text-sm">
									<svg xmlns="http://www.w3.org/2000/svg" class="h-5 w-5 flex-shrink-0" fill="none" viewBox="0 0 24 24" stroke="currentColor">
										<path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 9v2m0 4h.01m-6.938 4h13.856c1.54 0 2.502-1.667 1.732-3L13.732 4c-.77-1.333-2.694-1.333-3.464 0L3.34 16c-.77 1.333.192 3 1.732 3z"></path>
									</svg>
									<span id={ fmt.Sprintf("edit-title-error-message-%s", task.ID) }></span>
								</div>
							</div>
							<div class="grid grid-cols-2 gap-4 mb-4">
								<div class="form-control">
									<label class="label">
										<span class="label-text">Category</span>
									</label>
									<select name="category" class="select select-bordered">
										for _, cat := range models.AllCategoriesIncludingScheduled {
											<option
												value={ string(cat) }
												if cat == task.Category {
													selected
												}
											>
												{ string(cat) }
											</option>
										}
									</select>
								</div>
								<div class="form-control">
									<label class="label">
										<span class="label-text">Priority</span>
									</label>
									<select name="priority" class="select select-bordered">
										<option
											value="1"
											if task.Priority == 1 {
												selected
											}
										>Low</option>
										<option
											value="2"
											if task.Priority == 2 {
												selected
											}
										>Normal</option>
										<option
											value="3"
											if task.Priority == 3 {
												selected
											}
										>High</option>
										<option
											value="4"
											if task.Priority == 4 {
												selected
											}
										>Urgent</option>
									</select>
								</div>
							</div>
							<div class="form-control mb-4">
								<label class="label">
									<span class="label-text">Tag</span>
								</label>
								<select name="tag" class="select select-bordered">
									for _, tag := range models.AllTags {
										<option
											value={ string(tag) }
											if tag == task.Tag {
												selected
											}
										>
											if tag == "" {
												None
											} else {
												{ components.TagLabel(tag) }
											}
										</option>
									}
								</select>
							</div>
							<div class="form-control mb-4">
								<label class="label">
									<span class="label-text">Prompt</span>
								</label>
								<textarea
									name="prompt"
									class="textarea textarea-bordered font-mono"
									rows="8"
								>{ task.Prompt }</textarea>
							</div>
							<div class="form-control mb-4">
								<label class="label">
									<span class="label-text">Goal</span>
								</label>
								<input type="hidden" name="goal_present" value="1"/>
								<textarea
									name="goal"
									class="textarea textarea-bordered textarea-sm w-full"
									rows="3"
									placeholder="Add goal"
								>{ goalValue(goal) }</textarea>
								<label class="label">
									<span class="label-text-alt text-base-content/50">Leave empty to clear the goal.</span>
								</label>
								if goal != nil && goal.Status != models.TaskGoalStatusCleared {
									<input type="hidden" name="goal_status_present" value="1"/>
									<label class="label cursor-pointer justify-start gap-2 pt-0">
										<input
											type="checkbox"
											name="goal_active"
											class="toggle toggle-sm toggle-primary"
											if goal.Status == models.TaskGoalStatusActive {
												checked
											}
										/>
										<span class="label-text">Goal active</span>
									</label>
								}
							</div>
							<div class="form-control mb-4">
								<label class="label">
									<span class="label-text">Model</span>
								</label>
								<select name="agent_id" class="select select-bordered">
									<option
										value=""
										if task.AgentID == nil {
											selected
										}
									>Use Default Model</option>
									for _, agent := range agents {
										<option
											value={ agent.ID }
											if task.AgentID != nil && *task.AgentID == agent.ID {
												selected
											}
										>
											{ agent.Name }
											if agent.IsDefault {
												(Default)
											}
										</option>
									}
								</select>
							</div>
							if len(agentDefs) > 0 {
								<div class="form-control mb-4">
									<label class="label">
										<span class="label-text">Agent</span>
									</label>
									<select name="agent_definition_id" class="select select-bordered">
										<option
											value=""
											if task.AgentDefinitionID == nil {
												selected
											}
										>No Agent</option>
										for _, ad := range agentDefs {
											<option
												value={ ad.ID }
												if task.AgentDefinitionID != nil && *task.AgentDefinitionID == ad.ID {
													selected
												}
											>
												{ ad.Name }
												if ad.Model != "inherit" {
													({ ad.Model })
												}
											</option>
										}
									</select>
								</div>
							}
							<!-- Git Worktree: Auto-merge -->
							<div class="form-control mb-4">
								<label class="label cursor-pointer justify-start gap-2">
									<input type="hidden" name="auto_merge_present" value="1"/>
									<input
										type="checkbox"
										name="auto_merge"
										class="toggle toggle-sm toggle-primary"
										if task.AutoMerge {
											checked
										}
									/>
									<span class="label-text">Auto-merge to target branch on completion</span>
								</label>
							</div>
							<!-- Attachments Section -->
							<div class="form-control mb-4">
								<label class="label">
									<span class="label-text">Attachments</span>
								</label>
								if len(attachments) > 0 {
									<div id="edit-existing-attachments" class="mb-2 space-y-1">
										for _, att := range attachments {
											<div class="flex items-center gap-2 text-sm bg-base-200 rounded px-2 py-1" id={ fmt.Sprintf("edit-att-%s", att.ID) }>
												<svg xmlns="http://www.w3.org/2000/svg" class="h-4 w-4 flex-shrink-0 text-base-content/60" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
													<path stroke-linecap="round" stroke-linejoin="round" d="M15.172 7l-6.586 6.586a2 2 0 102.828 2.828l6.414-6.586a4 4 0 00-5.656-5.656l-6.415 6.585a6 6 0 108.486 8.486L20.5 13"></path>
												</svg>
												<span class="flex-1 truncate">{ att.FileName }</span>
												<span class="text-base-content/50">{ components.FormatFileSize(att.FileSize) }</span>
												<button
													type="button"
													class="btn btn-ghost btn-xs text-error"
													onclick={ removeEditAttachment(att.ID) }
												>
													<svg xmlns="http://www.w3.org/2000/svg" class="h-3 w-3" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
														<path stroke-linecap="round" stroke-linejoin="round" d="M6 18L18 6M6 6l12 12"></path>
													</svg>
												</button>
											</div>
										}
									</div>
								}
								<input type="hidden" name="remove_attachments" id="remove-attachments-input" value=""/>
								<input
									type="file"
									name="files"
									multiple
									class="file-input file-input-bordered file-input-sm w-full"
								/>
								<label class="label">
									<span class="label-text-alt text-base-content/50">Max 10MB per file. Add new files to attach.</span>
								</label>
							</div>
							<div class="flex gap-2">
								<button type="submit" class="btn btn-primary btn-sm">
									Save Changes
								</button>
								<button
									type="button"
									class="btn btn-ghost btn-sm"
									onclick="document.getElementById('task-detail-edit').classList.add('hidden'); document.getElementById('task-detail-view').classList.remove('hidden')"
								>
									Cancel
								</button>
							</div>
						</form>
						<script>
							// Handle edit form duplicate errors
							(function() {
								var formEl = document.currentScript.closest('#task-detail-edit').querySelector('form');
								var taskId = formEl.id.replace('edit-task-form-', '');
								document.body.addEventListener('htmx:responseError', function(event) {
									var formId = 'edit-task-form-' + taskId;
									if (event.detail.elt && event.detail.elt.id === formId) {
										var xhr = event.detail.xhr;
										if (xhr.status === 409) {
											event.preventDefault();
											var titleInput = document.getElementById('edit-task-title-' + taskId);
											var titleError = document.getElementById('edit-title-error-' + taskId);
											var titleErrorMessage = document.getElementById('edit-title-error-message-' + taskId);
											if (titleInput && titleError && titleErrorMessage) {
												titleInput.classList.add('input-error');
												titleErrorMessage.textContent = xhr.responseText || 'A task with this name already exists in this project';
												titleError.classList.remove('hidden');
											}
										}
									}
								});
							})();
						</script>
					</div>
				</div>
			</div>
		</div>
		<!-- End Tab: Details -->
		<!-- Tab: Schedules -->
		<div id="tab-schedules" class={ "task-tab-panel flex-shrink-0", templ.KV("hidden", defaultTab != "schedules") }>
			<div class="card bg-base-100 shadow-sm border border-base-300">
				<div class="card-body">
					<div class="flex items-center justify-between mb-4">
						<h4 class="text-lg font-bold">Schedules</h4>
						<button
							id="add-schedule-btn"
							class="btn btn-sm btn-primary"
							onclick="document.getElementById('schedule-form-container').classList.remove('hidden'); document.getElementById('add-schedule-btn').classList.add('hidden')"
						>
							+ Add Schedule
						</button>
					</div>
					<!-- Add Schedule Form (hidden by default) -->
					<div id="schedule-form-container" class="hidden mb-4 card bg-base-200 shadow-sm border border-base-300">
						<div class="card-body p-4">
							<form
								method="post"
								action={ fmt.Sprintf("/tasks/%s/schedule?project_id=%s", task.ID, task.ProjectID) }
								hx-post={ fmt.Sprintf("/tasks/%s/schedule?project_id=%s", task.ID, task.ProjectID) }
								hx-target="#task-detail-content"
								hx-swap="outerHTML"
							>
								<div class="grid grid-cols-1 gap-4 mb-4 sm:grid-cols-2">
									<div class="form-control">
										<label class="label">
											<span class="label-text">Run At</span>
										</label>
										<div class="relative" data-run-at-picker-container onclick="openScheduleRunAtPicker(this, event)">
											<input
												type="datetime-local"
												name="run_at"
												class="input input-bordered input-sm cursor-pointer"
												data-run-at-picker
												required
											/>
										</div>
									</div>
									<div class="form-control">
										<label class="label">
											<span class="label-text">Repeat</span>
										</label>
										<select name="repeat_type" class="select select-bordered select-sm" id="repeat-type-select">
											<option value="once">Once</option>
											<option value="seconds">Every N Seconds</option>
											<option value="minutes">Every N Minutes</option>
											<option value="hours">Every N Hours</option>
											<option value="daily">Daily</option>
											<option value="weekly">Weekly</option>
											<option value="monthly">Monthly</option>
										</select>
									</div>
								</div>
								if schedulePrimaryAgentSelectionEditable(task.AgentDefinitionID, agentDefs) {
									<div class="form-control mb-4 min-w-0">
										<label class="label">
											<span class="label-text">Primary Agent</span>
										</label>
										@SchedulePrimaryAgentSelector(task.AgentDefinitionID, agentDefs, "select select-bordered select-sm w-full max-w-full")
										<label class="label"><span class="label-text-alt opacity-60">Agent definition used for scheduled runs; model configuration is unchanged</span></label>
									</div>
								}
								<div class="form-control mb-4" id="repeat-interval-container">
									<label class="label">
										<span class="label-text">Repeat Every</span>
									</label>
									<div class="flex items-center gap-2">
										<input
											type="number"
											id="repeat-interval-input"
											name="repeat_interval"
											value="1"
											min="1"
											max="365"
											step="1"
											class="input input-bordered input-sm w-20"
										/>
										<span class="text-sm opacity-60" id="repeat-interval-label">day(s)</span>
									</div>
								</div>
									<div class="form-control mb-4">
										<input type="hidden" name="clear_context_on_start" value="false"/>
										<label class="label cursor-pointer justify-start gap-3">
											<input type="checkbox" name="clear_context_on_start" value="true" class="checkbox checkbox-sm" checked/>
											<span class="label-text">Clear context on start</span>
										</label>
										<label class="label"><span class="label-text-alt opacity-60">Start each scheduled run without prior model conversation context</span></label>
									</div>
									<div class="flex gap-2">
										<button type="submit" class="btn btn-primary btn-sm">
											Add Schedule
										</button>
										<button
											type="button"
											class="btn btn-ghost btn-sm"
											onclick="document.getElementById('schedule-form-container').classList.add('hidden'); document.getElementById('add-schedule-btn').classList.remove('hidden')"
										>
											Cancel
										</button>
									</div>
							</form>
							<script>
									(function() {
										var repeatTypeSelect = document.getElementById('repeat-type-select');
										var repeatIntervalContainer = document.getElementById('repeat-interval-container');
										var repeatIntervalInput = document.getElementById('repeat-interval-input');
										var repeatIntervalLabel = document.getElementById('repeat-interval-label');
										if (!repeatTypeSelect || !repeatIntervalContainer || !repeatIntervalInput || !repeatIntervalLabel) return;

										function applyIntervalValidity(enabled) {
											if (!enabled) {
												repeatIntervalInput.value = '1';
												repeatIntervalInput.disabled = true;
												repeatIntervalInput.required = false;
												repeatIntervalInput.setCustomValidity('');
												return;
											}
											repeatIntervalInput.disabled = false;
											repeatIntervalInput.required = true;
											var raw = (repeatIntervalInput.value || '').trim();
											if (raw === '' || !/^\d+$/.test(raw) || Number(raw) < 1 || Number(raw) > 365) {
												repeatIntervalInput.setCustomValidity('Repeat interval must be a whole number between 1 and 365');
											} else {
												repeatIntervalInput.setCustomValidity('');
											}
										}

										function updateRepeatInterval() {
											var repeatType = repeatTypeSelect.value;
											if (repeatType === 'once') {
												repeatIntervalContainer.style.display = 'none';
												applyIntervalValidity(false);
												return;
											}
											repeatIntervalContainer.style.display = 'block';
											switch(repeatType) {
												case 'seconds': repeatIntervalLabel.textContent = 'second(s)'; break;
												case 'minutes': repeatIntervalLabel.textContent = 'minute(s)'; break;
												case 'hours': repeatIntervalLabel.textContent = 'hour(s)'; break;
												case 'daily': repeatIntervalLabel.textContent = 'day(s)'; break;
												case 'weekly': repeatIntervalLabel.textContent = 'week(s)'; break;
												case 'monthly': repeatIntervalLabel.textContent = 'month(s)'; break;
												default: repeatIntervalLabel.textContent = 'time(s)'; break;
											}
											applyIntervalValidity(true);
										}

										repeatTypeSelect.addEventListener('change', updateRepeatInterval);
										repeatIntervalInput.addEventListener('input', function() {
											applyIntervalValidity(repeatTypeSelect.value !== 'once');
										});
											updateRepeatInterval();
									})();
								</script>
						</div>
					</div>
					<!-- Existing Schedules List -->
					if len(schedules) > 0 {
						for _, s := range schedules {
							<div class="card bg-base-100 shadow-sm border border-base-300 mb-2" id={ fmt.Sprintf("schedule-card-%s", s.ID) }>
								<div class="card-body p-3">
									<!-- Schedule View -->
									<div id={ fmt.Sprintf("schedule-view-%s", s.ID) }>
										<div class="flex items-center justify-between">
											<div>
												if s.RepeatType.IsSubDaily() {
													<span class="text-sm font-medium">{ components.ScheduleRepeatLabel(s) }</span>
												} else {
													<span class="text-sm font-medium">{ string(s.RepeatType) }</span>
													if s.RepeatType != models.RepeatOnce && s.RepeatInterval > 1 {
														<span class="text-sm opacity-60">(every { fmt.Sprintf("%d", s.RepeatInterval) })</span>
													}
												}
												if !s.Enabled {
													<span class="badge badge-warning badge-xs ml-2">Disabled</span>
												}
												if s.NextRun != nil {
													<span class={ "text-sm ml-2", templ.KV("opacity-60", s.Enabled), templ.KV("opacity-30 line-through", !s.Enabled) }>
														Next: { s.NextRun.Local().Format("2006-01-02 3:04 PM") }
													</span>
												}
											</div>
											<div class="flex gap-1">
												<form
													method="post"
													action={ fmt.Sprintf("/schedules/%s/toggle?project_id=%s", s.ID, task.ProjectID) }
													hx-post={ fmt.Sprintf("/schedules/%s/toggle?project_id=%s", s.ID, task.ProjectID) }
													hx-target="#task-detail-content"
													hx-swap="outerHTML"
												>
													if s.Enabled {
														<button type="submit" class="btn btn-xs btn-ghost" aria-label="Pause schedule">
															Pause
														</button>
													} else {
														<button type="submit" class="btn btn-xs btn-outline btn-warning" aria-label="Resume schedule">
															Resume
														</button>
													}
												</form>
												<button
													class="btn btn-xs btn-ghost"
													onclick={ templ.ComponentScript{Call: fmt.Sprintf("document.getElementById('schedule-view-%s').classList.add('hidden'); document.getElementById('schedule-edit-%s').classList.remove('hidden')", s.ID, s.ID)} }
												>
													Edit
												</button>
												<button
													class="btn btn-xs btn-ghost text-error"
													data-schedule-id={ s.ID }
													data-schedule-title={ task.Title }
													data-schedule-target="closest .card"
													data-schedule-swap="outerHTML swap:1s"
													onclick="openDeleteScheduleConfirm(this)"
												>
													Remove
												</button>
											</div>
										</div>
									</div>
									<!-- Schedule Edit Form -->
									<div id={ fmt.Sprintf("schedule-edit-%s", s.ID) } class="hidden" data-schedule-id={ s.ID }>
									<form
										method="post"
										action={ fmt.Sprintf("/schedules/%s?project_id=%s", s.ID, task.ProjectID) }
										hx-put={ fmt.Sprintf("/schedules/%s?project_id=%s", s.ID, task.ProjectID) }
										hx-target="#task-detail-content"
										hx-swap="outerHTML"
									>
										<input type="hidden" name="_method" value="PUT"/>											<div class="grid grid-cols-1 gap-4 mb-4 sm:grid-cols-2">
												<div class="form-control">
													<label class="label">
														<span class="label-text">Run At</span>
													</label>
													<div class="relative" data-run-at-picker-container onclick="openScheduleRunAtPicker(this, event)">
														<input
															type="datetime-local"
															name="run_at"
															value={ components.GetScheduleEditTime(s) }
															class="input input-bordered input-sm cursor-pointer"
															data-run-at-picker
															required
														/>
													</div>
												</div>
												<div class="form-control">
													<label class="label">
														<span class="label-text">Repeat</span>
													</label>
													<select name="repeat_type" class="select select-bordered select-sm" id={ fmt.Sprintf("edit-repeat-type-%s", s.ID) }>
														<option
															value="once"
															if s.RepeatType == models.RepeatOnce {
																selected
															}
														>Once</option>
														<option
															value="seconds"
															if s.RepeatType == models.RepeatSeconds {
																selected
															}
														>Every N Seconds</option>
														<option
															value="minutes"
															if s.RepeatType == models.RepeatMinutes {
																selected
															}
														>Every N Minutes</option>
														<option
															value="hours"
															if s.RepeatType == models.RepeatHours {
																selected
															}
														>Every N Hours</option>
														<option
															value="daily"
															if s.RepeatType == models.RepeatDaily {
																selected
															}
														>Daily</option>
														<option
															value="weekly"
															if s.RepeatType == models.RepeatWeekly {
																selected
															}
														>Weekly</option>
														<option
															value="monthly"
															if s.RepeatType == models.RepeatMonthly {
																selected
															}
														>Monthly</option>
													</select>
												</div>
											</div>
											if schedulePrimaryAgentSelectionEditable(task.AgentDefinitionID, agentDefs) {
												<div class="form-control mb-4 min-w-0">
													<label class="label">
														<span class="label-text">Primary Agent</span>
													</label>
													@SchedulePrimaryAgentSelector(task.AgentDefinitionID, agentDefs, "select select-bordered select-sm w-full max-w-full")
													<label class="label"><span class="label-text-alt opacity-60">Agent definition used for scheduled runs; model configuration is unchanged</span></label>
												</div>
											}
											<div class="form-control mb-4" id={ fmt.Sprintf("edit-repeat-interval-%s", s.ID) }>
												<label class="label">
													<span class="label-text">Repeat Every</span>
												</label>
												<div class="flex items-center gap-2">
													<input
														type="number"
														id={ fmt.Sprintf("edit-repeat-interval-input-%s", s.ID) }
														name="repeat_interval"
														value={ fmt.Sprintf("%d", s.RepeatInterval) }
														min="1"
														max="365"
														step="1"
														class="input input-bordered input-sm w-20"
													/>
													<span class="text-sm opacity-60" id={ fmt.Sprintf("edit-repeat-label-%s", s.ID) }>day(s)</span>
												</div>
											</div>
										<div class="form-control mb-4">
											<input type="hidden" name="clear_context_on_start" value="false"/>
											<label class="label cursor-pointer justify-start gap-3">
												<input type="checkbox" name="clear_context_on_start" value="true" class="checkbox checkbox-sm" checked?={ s.ClearContextOnStart }/>
												<span class="label-text">Clear context on start</span>
											</label>
											<label class="label"><span class="label-text-alt opacity-60">Start each scheduled run without prior model conversation context</span></label>
										</div>
										<div class="flex gap-2">
											<button type="submit" class="btn btn-primary btn-sm">
												Save Changes
											</button>
											<button
												type="button"
												class="btn btn-ghost btn-sm"
												onclick={ templ.ComponentScript{Call: fmt.Sprintf("document.getElementById('schedule-edit-%s').classList.add('hidden'); document.getElementById('schedule-view-%s').classList.remove('hidden')", s.ID, s.ID)} }
											>
												Cancel
											</button>
											</div>
										</form>
										<script>
													(function() {
														var container = document.currentScript.closest('[data-schedule-id]');
														if (!container) return;
														var scheduleId = container.dataset.scheduleId;
														var repeatTypeSelect = document.getElementById('edit-repeat-type-' + scheduleId);
														var repeatIntervalContainer = document.getElementById('edit-repeat-interval-' + scheduleId);
														var repeatIntervalInput = document.getElementById('edit-repeat-interval-input-' + scheduleId);
														var repeatIntervalLabel = document.getElementById('edit-repeat-label-' + scheduleId);

														if (!repeatTypeSelect || !repeatIntervalContainer || !repeatIntervalInput || !repeatIntervalLabel) return;

														function applyIntervalValidity(enabled) {
															if (!enabled) {
																repeatIntervalInput.value = '1';
																repeatIntervalInput.disabled = true;
																repeatIntervalInput.required = false;
																repeatIntervalInput.setCustomValidity('');
																return;
															}
															repeatIntervalInput.disabled = false;
															repeatIntervalInput.required = true;
															var raw = (repeatIntervalInput.value || '').trim();
															if (raw === '' || !/^\d+$/.test(raw) || Number(raw) < 1 || Number(raw) > 365) {
																repeatIntervalInput.setCustomValidity('Repeat interval must be a whole number between 1 and 365');
															} else {
																repeatIntervalInput.setCustomValidity('');
															}
														}

														function updateRepeatInterval() {
															var repeatType = repeatTypeSelect.value;
															if (repeatType === 'once') {
																repeatIntervalContainer.style.display = 'none';
																applyIntervalValidity(false);
																return;
															}
															repeatIntervalContainer.style.display = 'block';
															switch(repeatType) {
																case 'seconds': repeatIntervalLabel.textContent = 'second(s)'; break;
																case 'minutes': repeatIntervalLabel.textContent = 'minute(s)'; break;
																case 'hours': repeatIntervalLabel.textContent = 'hour(s)'; break;
																case 'daily': repeatIntervalLabel.textContent = 'day(s)'; break;
																case 'weekly': repeatIntervalLabel.textContent = 'week(s)'; break;
																case 'monthly': repeatIntervalLabel.textContent = 'month(s)'; break;
																default: repeatIntervalLabel.textContent = 'time(s)'; break;
															}
															applyIntervalValidity(true);
														}

														repeatTypeSelect.addEventListener('change', updateRepeatInterval);
														repeatIntervalInput.addEventListener('input', function() {
															applyIntervalValidity(repeatTypeSelect.value !== 'once');
														});
															updateRepeatInterval();
														})();
													</script>
									</div>
								</div>
							</div>
						}
					} else {
						<p class="text-sm opacity-50">No schedules configured</p>
					}
				</div>
			</div>
		</div>
		<!-- End Tab: Schedules -->
		<!-- Tab: Chaining -->
		<div id="tab-chaining" class={ "task-tab-panel flex-shrink-0", templ.KV("hidden", defaultTab != "chaining") }>
			<div class="card bg-base-100 shadow-sm border border-base-300">
				<div class="card-body">
					<h4 class="text-lg font-bold mb-3">Task Chaining</h4>
					<p class="text-sm opacity-60 mb-4">Configure this task to automatically create a child task when it completes. For example, an Opus planning task can spawn a Sonnet implementation task.</p>
					@components.TaskChainConfigPage(task, agents)
				</div>
			</div>
		</div>
		<!-- End Tab: Chaining -->
		<!-- Tab: Attachments -->
		<div id="tab-attachments" class={ "task-tab-panel flex-shrink-0", templ.KV("hidden", defaultTab != "attachments") }>
			<div class="card bg-base-100 shadow-sm border border-base-300">
				<div class="card-body">
					<h4 class="text-lg font-bold mb-3">Attachments</h4>
					@components.AttachmentList(attachments, task.ProjectID, task.ID)
				</div>
			</div>
		</div>
		<!-- End Tab: Attachments -->
			<!-- Tab: Lifecycle (runbook §Rollout step 17) -->
			<div id="tab-lifecycle" class={ "task-tab-panel flex-1 flex flex-col min-h-0", templ.KV("hidden", defaultTab != "lifecycle") }>
				<div class="card bg-base-100 shadow-sm border border-base-300 flex-1 min-h-0">
					<div class="card-body flex flex-col min-h-0">
						<div class="flex items-center justify-between mb-3 flex-shrink-0">
							<h4 class="text-lg font-bold">Lifecycle Activity</h4>
							<button type="button" class="btn btn-ghost btn-xs" onclick={ templ.ComponentScript{Call: "refreshLifecycleActivity('" + task.ID + "', '" + task.ProjectID + "')"} }>Refresh</button>
						</div>
						<div data-lifecycle-description class="text-sm opacity-70 mb-3 flex-shrink-0">Lifecycle hook invocations recorded for this task. Includes routing, before-run preparation, and after-complete learning.</div>
						<div id="lifecycle-activity-scroll" data-task-id={ task.ID } data-project-id={ task.ProjectID } data-lifecycle-scrollport="true" tabindex="0" aria-label="Lifecycle activity" class="flex-1 min-h-0 overflow-y-auto pr-1">
							<div id="lifecycle-activity-list" data-task-id={ task.ID } data-project-id={ task.ProjectID } class="space-y-2">
								<p class="text-sm opacity-50">Loading lifecycle activity...</p>
							</div>
						</div>
					</div>
				</div>
				<script>
					(function() {
						var pageSize = 20;
						var states = window._taskLifecycleActivityStates = window._taskLifecycleActivityStates || {};
						var previousHandlers = window._taskLifecycleActivityHandlers;
						if (previousHandlers && previousHandlers.cleanup) previousHandlers.cleanup();

						function stateKey(taskID, projectID) {
							return String(projectID || '') + ':' + String(taskID || '');
						}

						function getState(taskID, projectID) {
							var key = stateKey(taskID, projectID);
							var state = states[key];
							if (!state) {
								state = {
									taskID: taskID,
									projectID: projectID,
									records: Object.create(null),
									order: [],
									initialized: false,
									olderCursor: '',
									olderHasMore: false,
									loadedOlder: false,
									olderLoading: false,
										olderError: '',
										newerLoading: false,
										newerPending: false,
										newerRetryTimer: null,
										newerError: '',
										refreshPending: false,
										refreshRetryTimer: null,
										refreshLoading: false,
										refreshError: '',
										refreshExecutionIDs: Object.create(null),
										gaps: [],
										gapSerial: 0,
										gapScrollIntent: false,
										initialLoading: false,
										requestVersion: 0,
										requestSerial: 0,
										refreshRequestID: 0,
										olderRequestID: 0,
										newerRequestID: 0,
										container: null,
										scrollTop: 0,
										anchorID: '',
										anchorOffset: 0,
										savedScrollTop: null,
										savedAnchorID: '',
										savedAnchorOffset: 0,
										restoreSerial: 0,
										newerLiveTimer: null,
										refreshLiveTimer: null
								};
								states[key] = state;
							}
							state.taskID = taskID;
							state.projectID = projectID;
							if (!state.refreshExecutionIDs) state.refreshExecutionIDs = Object.create(null);
							if (!Array.isArray(state.gaps)) state.gaps = [];
							if (!state.gapSerial) state.gapSerial = 0;
							return state;
						}

						function lifecycleContainer(taskID, projectID) {
							var container = document.getElementById('lifecycle-activity-list');
							if (!container) return null;
							if (taskID && container.dataset.taskId !== taskID) return null;
							if (projectID && container.dataset.projectId !== projectID) return null;
							return container;
						}

						function scrollport(container) {
							var current = container;
							while (current) {
								if (current.hasAttribute && current.hasAttribute('data-lifecycle-scrollport')) return current;
								current = current.parentElement;
							}
							return container;
						}

						function captureScroll(state, container) {
							var port = scrollport(container);
							if (!port) return;
							state.scrollTop = port.scrollTop || 0;
							var bounds = port.getBoundingClientRect();
							var rows = container.querySelectorAll('[data-lifecycle-execution-id]');
							state.anchorID = '';
							state.anchorOffset = 0;
							for (var i = 0; i < rows.length; i++) {
								var rect = rows[i].getBoundingClientRect();
								if (rect.bottom > bounds.top + 1 && rect.top < bounds.bottom + 1) {
									state.anchorID = rows[i].getAttribute('data-lifecycle-execution-id') || '';
									state.anchorOffset = rect.top - bounds.top;
									break;
								}
							}
						}

						function rememberAllScroll() {
							Object.keys(states).forEach(function(key) {
								var state = states[key];
								if (!state.container || !document.documentElement || !document.documentElement.contains(state.container)) return;
								captureScroll(state, state.container);
								state.savedScrollTop = state.scrollTop;
								state.savedAnchorID = state.anchorID;
								state.savedAnchorOffset = state.anchorOffset;
							});
						}

						function escapeText(value) {
							return String(value == null ? '' : value)
								.replace(/&/g, '&amp;')
								.replace(/</g, '&lt;')
								.replace(/>/g, '&gt;');
						}

						function escapeAttribute(value) {
							return escapeText(value).replace(/"/g, '&quot;').replace(/'/g, '&#39;');
						}

						function statusBadge(status) {
							var map = { completed: 'badge-success', failed: 'badge-error', skipped: 'badge-ghost', queued: 'badge-info', running: 'badge-warning', pending: 'badge-info' };
							var cls = map[status] || 'badge-ghost';
							return '<span class="badge ' + cls + ' badge-sm">' + escapeText(status) + '</span>';
						}

						function renderBadgeRow(label, values) {
							if (!Array.isArray(values) || values.length === 0) return '';
							var seen = Object.create(null);
							var badges = [];
							values.forEach(function(value) {
								if (!value || seen[value]) return;
								seen[value] = true;
								badges.push('<span class="font-mono text-xs badge badge-outline">' + escapeText(value) + '</span>');
							});
							if (badges.length === 0) return '';
							return '<p class="text-sm mt-1 flex items-center gap-2 flex-wrap"><span>' + escapeText(label) + ':</span> ' + badges.join(' ') + '</p>';
						}

						function memoryLabels(memories) {
							if (!Array.isArray(memories)) return [];
							return memories.map(function(memory) { return memory && (memory.file || memory.topic) || ''; });
						}

						function displayTime(value) {
							var date = new Date(value);
							return isNaN(date.getTime()) ? String(value || '') : date.toLocaleString();
						}

						function timestamp(value) {
							var parsed = Date.parse(value || '');
							return isNaN(parsed) ? 0 : parsed;
						}

						function sortRecords(state) {
							state.order = Object.keys(state.records).sort(function(leftID, rightID) {
								var left = state.records[leftID] || {};
								var right = state.records[rightID] || {};
								var timeDifference = timestamp(right.started_at) - timestamp(left.started_at);
								if (timeDifference !== 0) return timeDifference;
								if (String(right.id || '') === String(left.id || '')) return 0;
								return String(left.id || '') < String(right.id || '') ? 1 : -1;
							});
						}

						function mergeRows(state, rows) {
							if (!Array.isArray(rows)) return;
							rows.forEach(function(row) {
								if (!row || !row.id) return;
								state.records[String(row.id)] = row;
							});
						sortRecords(state);
						}

						function rowMarkup(row) {
							var selectedSkills = renderBadgeRow('Selected skills', row.selected_skills);
							var selectedMemories = renderBadgeRow('Selected memories', memoryLabels(row.selected_memories));
							var hasStructuredRoute = selectedSkills || selectedMemories;
							var summary = row.summary && !hasStructuredRoute ? '<p class="text-sm mt-1">' + escapeText(row.summary) + '</p>' : '';
							var error = row.error ? '<p class="text-xs text-error mt-1">' + escapeText(row.error) + '</p>' : '';
							var when = row.completed_at ? displayTime(row.completed_at) : displayTime(row.started_at);
							return '<div data-lifecycle-execution-id="' + escapeAttribute(row.id) + '" class="border border-base-300 rounded-lg p-3">' +
								'<div class="flex items-center justify-between flex-wrap gap-2">' +
								'<div class="flex items-center gap-2 flex-wrap">' +
								'<span class="font-mono text-xs opacity-70">' + escapeText(row.when || '') + '</span>' +
								'<span class="text-sm font-medium">' + escapeText(row.skill_key || '') + '</span>' +
								statusBadge(row.status || '') +
								'</div><span class="text-xs opacity-60">' + escapeText(when) + '</span></div>' +
								summary + selectedSkills + selectedMemories + error + '</div>';
						}

						function gapMarkup(gap) {
							var content = '<button type="button" data-lifecycle-load-gap="' + escapeAttribute(gap.id) + '" class="btn btn-ghost btn-sm">Load missed lifecycle activity</button>';
							if (gap.loading) content = '<span class="text-xs opacity-50">Loading missed lifecycle activity...</span>';
							if (gap.error) content = '<span class="text-xs text-error">' + escapeText(gap.error) + ' <button type="button" data-lifecycle-retry-gap="' + escapeAttribute(gap.id) + '" class="btn btn-ghost btn-xs">Retry</button></span>';
							return '<div data-lifecycle-gap="' + escapeAttribute(gap.id) + '" class="text-center py-2">' + content + '</div>';
						}

						function renderState(state, container, preservePosition) {
							var previousContainer = state.container;
							if (preservePosition && previousContainer === container) captureScroll(state, container);
							var anchorID = state.anchorID;
							var anchorOffset = state.anchorOffset;
							var savedScrollTop = state.scrollTop;
							if (preservePosition && previousContainer !== container && state.savedAnchorID) {
								anchorID = state.savedAnchorID;
								anchorOffset = state.savedAnchorOffset;
								savedScrollTop = state.savedScrollTop == null ? 0 : state.savedScrollTop;
							}
							state.container = container;
							var html = '';
							if (state.order.length === 0) {
								if (state.initialLoading) {
									html = '<p data-lifecycle-loading class="text-sm opacity-50">Loading lifecycle activity...</p>';
												} else if (state.refreshLoading) {
													html = '<p data-lifecycle-refresh-loading class="text-sm opacity-50">Refreshing lifecycle activity...</p>';
												} else if (state.refreshError) {									html = '<p data-lifecycle-error class="text-sm text-error">' + escapeText(state.refreshError) + ' <button type="button" data-lifecycle-retry="refresh" class="btn btn-ghost btn-xs">Retry</button></p>';
								} else if (state.initialized) {
									html = '<p data-lifecycle-empty class="text-sm opacity-50">No lifecycle activity recorded yet.</p>';
								}
								} else {
									state.order.forEach(function(id) {
										state.gaps.forEach(function(gap) {
											if (gap.boundaryID === id) html += gapMarkup(gap);
										});
										html += rowMarkup(state.records[id]);
									});
									if (state.olderLoading) {
										html += '<p data-lifecycle-loading-older class="text-xs opacity-50 text-center py-2">Loading older lifecycle activity...</p>';
									} else if (state.olderError) {
									html += '<p data-lifecycle-older-error class="text-xs text-error text-center py-2">' + escapeText(state.olderError) + ' <button type="button" data-lifecycle-retry="older" class="btn btn-ghost btn-xs">Retry</button></p>';
								} else if (state.olderHasMore) {
									html += '<p class="text-center py-2"><button type="button" data-lifecycle-load-older class="btn btn-ghost btn-sm">Load older lifecycle activity</button></p>';
									} else {
										html += '<p data-lifecycle-no-more class="text-xs opacity-40 text-center py-2">No more lifecycle activity.</p>';
									}
									if (state.refreshLoading) html += '<p data-lifecycle-refresh-loading class="text-xs opacity-50">Refreshing lifecycle activity...</p>';
									if (state.refreshError) html += '<p data-lifecycle-refresh-error class="text-xs text-error">' + escapeText(state.refreshError) + ' <button type="button" data-lifecycle-retry="refresh" class="btn btn-ghost btn-xs">Retry</button></p>';
									if (state.newerLoading) html += '<p data-lifecycle-loading-newer class="text-xs opacity-50 text-center py-2">Checking for new lifecycle activity...</p>';								if (state.newerError) html += '<p data-lifecycle-newer-error class="text-xs text-error text-center py-2">' + escapeText(state.newerError) + ' <button type="button" data-lifecycle-retry="newer" class="btn btn-ghost btn-xs">Retry</button></p>';
							}
							container.innerHTML = html;
							var renderID = ++state.restoreSerial;
							if (!preservePosition) return;
							var apply = function() {
								if (state.container !== container || state.restoreSerial !== renderID) return;
								var port = scrollport(container);
								var row = anchorID && container.querySelector('[data-lifecycle-execution-id="' + escapeAttribute(anchorID) + '"]');
								state.restoring = true;
								if (row) {
									var portRect = port.getBoundingClientRect();
									var rowRect = row.getBoundingClientRect();
									port.scrollTop += (rowRect.top - portRect.top) - anchorOffset;
								} else {
									port.scrollTop = savedScrollTop || 0;
								}
								setTimeout(function() {
									if (state.container === container && state.restoreSerial === renderID) state.restoring = false;
								}, 0);
							};
							apply();
							if (window.requestAnimationFrame) window.requestAnimationFrame(apply); else setTimeout(apply, 0);
							if (previousContainer !== container) {
