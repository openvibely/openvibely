							}

							state.refreshPending = true;
							if (state.newerLiveTimer) {
								clearTimeout(state.newerLiveTimer);
								state.newerLiveTimer = null;
							}
							if (state.newerRetryTimer) {
								clearTimeout(state.newerRetryTimer);
								state.newerRetryTimer = null;
							}
							state.newerPending = false;
							if (hasActiveLifecycleRequest(state) || state.refreshLiveTimer || state.refreshRetryTimer) return;
							state.refreshLiveTimer = setTimeout(function() {
								state.refreshLiveTimer = null;
								if (hasActiveLifecycleRequest(state)) {
									state.refreshPending = true;
									return;
								}
								refreshLifecycleActivity(taskID, projectID, true);
							}, 150);
						}

						function handleGapScrollIntent(event) {
							var port = document.getElementById('lifecycle-activity-scroll');
							if (!port || !(event.target === port || port.contains(event.target))) return;
							if (event.type === 'keydown') {
								var key = event.key || '';
								if (key !== 'ArrowDown' && key !== 'PageDown' && key !== 'End' && key !== ' ') return;
							}
							var container = document.getElementById('lifecycle-activity-list');
							if (!container) return;
							getState(container.dataset.taskId, container.dataset.projectId || '').gapScrollIntent = true;
						}

						function handleScroll() {
							var container = document.getElementById('lifecycle-activity-list');
							var panel = document.getElementById('tab-lifecycle');
							if (!container || (panel && panel.classList.contains('hidden'))) return;
							var state = getState(container.dataset.taskId, container.dataset.projectId || '');
							if (!state.initialized || state.restoring || state.olderLoading || (state.gaps.length === 0 && !state.olderHasMore)) return;
							captureScroll(state, container);
							var port = scrollport(container);
							if (state.gaps.length > 0 && state.gapScrollIntent) {
								var bounds = port.getBoundingClientRect();
								var markers = container.querySelectorAll('[data-lifecycle-gap]');
								for (var i = 0; i < markers.length; i++) {
									var markerRect = markers[i].getBoundingClientRect();
									if (markerRect.top < bounds.bottom + 180 && markerRect.bottom > bounds.top - 180) {
										state.gapScrollIntent = false;
										loadLifecycleGap(state.taskID, state.projectID, markers[i].getAttribute('data-lifecycle-gap'));
										return;
									}
								}
							}
							var nearBottom = port !== container ? port.scrollHeight - port.scrollTop - port.clientHeight < 180 : container.getBoundingClientRect().bottom - window.innerHeight < 180;
							if (nearBottom && state.olderHasMore) loadOlder(state.taskID, state.projectID);
						}

						function handleClick(event) {
							var target = event.target;
							var gapButton = target && target.closest && target.closest('[data-lifecycle-load-gap], [data-lifecycle-retry-gap]');
							if (gapButton) {
								event.preventDefault();
								var gapContainer = document.getElementById('lifecycle-activity-list');
								if (gapContainer) {
									var gapID = gapButton.getAttribute('data-lifecycle-load-gap') || gapButton.getAttribute('data-lifecycle-retry-gap');
									loadLifecycleGap(gapContainer.dataset.taskId, gapContainer.dataset.projectId || '', gapID);
								}
								return;
							}
							var olderButton = target && target.closest && target.closest('[data-lifecycle-load-older]');
							if (olderButton) {
								event.preventDefault();
								var olderContainer = document.getElementById('lifecycle-activity-list');
								if (olderContainer) loadOlder(olderContainer.dataset.taskId, olderContainer.dataset.projectId || '');
								return;
							}
							var retry = target && target.closest && target.closest('[data-lifecycle-retry]');
							if (retry) {
								event.preventDefault();
								var retryContainer = document.getElementById('lifecycle-activity-list');
								if (retryContainer) {
									if (retry.getAttribute('data-lifecycle-retry') === 'older') loadOlder(retryContainer.dataset.taskId, retryContainer.dataset.projectId || '');
									else if (retry.getAttribute('data-lifecycle-retry') === 'newer') loadNewer(retryContainer.dataset.taskId, retryContainer.dataset.projectId || '', 0);
									else refreshLifecycleActivity(retryContainer.dataset.taskId, retryContainer.dataset.projectId || '');
								}
								return;
							}
							var tab = target && target.closest && target.closest('[data-tab="lifecycle"]');
							if (!tab) return;
							var tabContainer = document.getElementById('lifecycle-activity-list');
							if (tabContainer) refreshLifecycleActivity(tabContainer.dataset.taskId, tabContainer.dataset.projectId || '');
						}

						function handleLiveConnected(event) {
							var detail = event && event.detail || {};
							if (!detail.reconnected) return;
							var container = document.getElementById('lifecycle-activity-list');
							if (!container) return;
							var state = getState(container.dataset.taskId, container.dataset.projectId || '');
							markRetainedNonterminalExecutions(state);
							scheduleLiveRefresh(container.dataset.taskId, container.dataset.projectId || '', 'refresh');
						}

						function handleTaskEvent(event) {
							var data = event && event.detail || {};
							if (typeof data === 'string') {
								try { data = JSON.parse(data); } catch (error) { return; }
							}
							var container = document.getElementById('lifecycle-activity-list');
							if (!container || !data || data.task_id !== container.dataset.taskId) return;
							if (data.project_id && data.project_id !== container.dataset.projectId) return;
							var relevant = {
								task_status_changed: true,
								task_category_changed: true,
								task_thread_execution_started: true,
								task_lifecycle_execution_changed: true,
								task_thread_input_applied: true,
								task_thread_input_queued: true,
								task_thread_input_steered: true
							};
							if (data.type === 'task_lifecycle_execution_changed' && data.exec_id) {
								var state = getState(container.dataset.taskId, container.dataset.projectId || '');
								markExecutionForRefresh(state, data.exec_id);
							}
							if (relevant[data.type]) scheduleLiveRefresh(container.dataset.taskId, container.dataset.projectId || '', data.type === 'task_thread_execution_started' || data.type === 'task_thread_input_applied' ? 'newer' : 'refresh');
						}

						function handleBeforeSwap(event) {
							var target = event && event.detail && event.detail.target;
							if (!target) return;
							if (target.id === 'main-content' || target.id === 'task-detail-content' || (target.querySelector && target.querySelector('#lifecycle-activity-list'))) {
								rememberAllScroll();
								cleanup();
							}
						}

						function cleanup() {
							rememberAllScroll();
							document.removeEventListener('click', handleClick);
							document.removeEventListener('scroll', handleScroll, true);
							document.removeEventListener('wheel', handleGapScrollIntent, true);
							document.removeEventListener('touchmove', handleGapScrollIntent, true);
							document.removeEventListener('pointerdown', handleGapScrollIntent, true);
							document.removeEventListener('keydown', handleGapScrollIntent, true);
							window.removeEventListener('scroll', handleScroll, true);
							window.removeEventListener('sse-task-event', handleTaskEvent);
							window.removeEventListener('sse-live-connected', handleLiveConnected);
							document.body && document.body.removeEventListener('htmx:beforeSwap', handleBeforeSwap);
							Object.keys(states).forEach(function(key) {
								var state = states[key];
								if (state.liveTimer) {
									clearTimeout(state.liveTimer);
									state.liveTimer = null;
								}
								if (state.newerLiveTimer) {
									clearTimeout(state.newerLiveTimer);
									state.newerLiveTimer = null;
								}
								if (state.refreshLiveTimer) {
									clearTimeout(state.refreshLiveTimer);
									state.refreshLiveTimer = null;
								}
								if (state.newerRetryTimer) {
									clearTimeout(state.newerRetryTimer);
									state.newerRetryTimer = null;
								}
								if (state.refreshRetryTimer) {
									clearTimeout(state.refreshRetryTimer);
									state.refreshRetryTimer = null;
								}
									state.newerPending = false;
									state.gapScrollIntent = false;
									state.refreshPending = false;								state.refreshLoading = false;
								state.olderLoading = false;
								state.newerLoading = false;
								state.initialLoading = false;
								state.refreshRequestID = 0;
								state.olderRequestID = 0;
									state.newerRequestID = 0;
									state.gaps.forEach(function(gap) {
										gap.loading = false;
										gap.requestID = 0;
									});
									state.requestVersion++;							});
						}

						window.refreshLifecycleActivity = refreshLifecycleActivity;
						window._taskLifecycleActivityHandlers = { cleanup: cleanup };
						document.addEventListener('click', handleClick);
							document.addEventListener('scroll', handleScroll, true);
							document.addEventListener('wheel', handleGapScrollIntent, true);
							document.addEventListener('touchmove', handleGapScrollIntent, true);
							document.addEventListener('pointerdown', handleGapScrollIntent, true);
							document.addEventListener('keydown', handleGapScrollIntent, true);
							window.addEventListener('scroll', handleScroll, true);						window.addEventListener('sse-task-event', handleTaskEvent);
						window.addEventListener('sse-live-connected', handleLiveConnected);
						if (document.body) document.body.addEventListener('htmx:beforeSwap', handleBeforeSwap);

					if (document.querySelector('[data-tab="lifecycle"].tab-active')) {
						var initial = document.getElementById('lifecycle-activity-list');
						if (initial) refreshLifecycleActivity(initial.dataset.taskId, initial.dataset.projectId || '');
					}
				})();
				</script>
			</div>
			<!-- End Tab: Lifecycle -->
			<!-- Tab: Changes -->
		<div id="tab-changes" class={ "task-tab-panel flex-shrink-0", templ.KV("hidden", defaultTab != "changes") }>
			<div
				id="changes-content"
				hx-get={ fmt.Sprintf("/tasks/%s/changes", task.ID) }
				hx-trigger="refreshChanges from:body"
				hx-swap="innerHTML"
				data-task-id={ task.ID }
			>
				if defaultTab == "changes" {
					<div class="card bg-base-100 shadow-sm border border-base-300" hx-get={ fmt.Sprintf("/tasks/%s/changes", task.ID) } hx-trigger="load" hx-swap="outerHTML">
						<div class="card-body">
							<h4 class="text-lg font-bold mb-3">File Changes</h4>
							<p class="text-sm opacity-60">Loading changes...</p>
						</div>
					</div>
				} else {
					<div class="card bg-base-100 shadow-sm border border-base-300">
						<div class="card-body">
							<h4 class="text-lg font-bold mb-3">File Changes</h4>
							<p class="text-sm opacity-60">
								Changes load on demand when you open this tab.
							</p>
						</div>
					</div>
				}
			</div>
		</div>
		<!-- End Tab: Changes -->
		<!-- Tab: Thread -->
		<div id="tab-chat" class={ "task-tab-panel flex-1 flex flex-col min-h-0", templ.KV("hidden", defaultTab != "chat") }>
			<div
				id="thread-content"
				hx-get={ fmt.Sprintf("/tasks/%s/thread", task.ID) }
				hx-trigger="none"
				hx-swap="innerHTML"
				data-task-id={ task.ID }
				data-loaded="false"
				data-loading="false"
				class="flex-1 flex flex-col min-h-0"
			>
				<div class="card bg-base-100 shadow-sm border border-base-300 flex-1 flex flex-col min-h-0 overflow-hidden">
					<div class="card-body flex-1 flex flex-col min-h-0">
						<h4 class="text-lg font-bold mb-3">Thread</h4>
						if defaultTab == "chat" {
							<p class="text-sm opacity-60">Thread is loading...</p>
						} else {
							<p class="text-sm opacity-60">Thread loads on demand when you open this tab.</p>
						}
					</div>
				</div>
			</div>
		</div>
		<!-- End Tab: Thread -->
		@DestructiveConfirmDialog("delete_schedule_confirm_modal", "Close delete schedule confirmation", "Delete Schedule", "Are you sure you want to delete the schedule for ", "delete_schedule_confirm_name", "", "? This action cannot be undone.", templ.ComponentScript{Call: "delete_schedule_confirm_modal.close()"}, templ.ComponentScript{Call: "confirmDeleteSchedule()"}) {
			The task will remain, but it will no longer run on this schedule.
		}
		<script>
							var deleteScheduleID = '';
							var deleteScheduleTarget = '#task-detail-content';
							var deleteScheduleTargetElement = null;
							var deleteScheduleSwap = 'outerHTML';

							function openDeleteScheduleConfirm(button) {
								if (!button) return;
								deleteScheduleID = button.dataset.scheduleId || '';
								if (!deleteScheduleID) return;
								deleteScheduleTarget = button.dataset.scheduleTarget || '#task-detail-content';
								deleteScheduleTargetElement = deleteScheduleTarget.indexOf('closest ') === 0 ? button.closest(deleteScheduleTarget.replace(/^closest\s+/, '')) : null;
								deleteScheduleSwap = button.dataset.scheduleSwap || 'outerHTML';
								window.openDestructiveConfirmDialog('delete_schedule_confirm_modal', 'delete_schedule_confirm_name', button.dataset.scheduleTitle || 'this task');
							}

							function confirmDeleteSchedule() {
								if (!deleteScheduleID) return;
								var modal = document.getElementById('delete_schedule_confirm_modal');
								if (modal) modal.close();
								var target = deleteScheduleTargetElement || deleteScheduleTarget;
								htmx.ajax('DELETE', '/schedules/' + deleteScheduleID, {
									target: target,
									swap: deleteScheduleSwap
								});
							}

							function openScheduleRunAtPicker(container, event) {							if (!container) return;
							var pickerInput = container.querySelector('input[data-run-at-picker]');
							if (!pickerInput) return;
							if (event && event.target && !event.target.closest('input[data-run-at-picker]')) return;
							pickerInput.focus();
							if (typeof pickerInput.showPicker === 'function') {
								pickerInput.showPicker();
							}
						}

						var _threadContentLoading = false;
					function _currentTaskIdFromPath() {
						var taskIdMatch = window.location.pathname.match(/\/tasks\/([^\/]+)/);
						return taskIdMatch && taskIdMatch[1] ? taskIdMatch[1] : '';
					}

					function _isChatTabActive() {
						var chatTab = document.querySelector('[data-tab="chat"]');
						if (!chatTab || !chatTab.classList.contains('tab-active')) return false;
						var chatPanel = document.getElementById('tab-chat');
						return !!chatPanel && !chatPanel.classList.contains('hidden');
					}

					function _taskThreadScrollStateKey(taskId) {
						return taskId ? 'task-thread-scroll-' + taskId : '';
					}

					function _getTaskThreadScrollState(taskId) {
						window._taskThreadScrollStates = window._taskThreadScrollStates || {};
						var key = _taskThreadScrollStateKey(taskId || _currentTaskIdFromPath());
						return key ? window._taskThreadScrollStates[key] : null;
					}

					function _saveTaskThreadScrollState(taskId) {
						taskId = taskId || _currentTaskIdFromPath();
						var key = _taskThreadScrollStateKey(taskId);
						var chatMessages = document.getElementById('task-thread-messages');
						if (!key || !chatMessages || !window.chatAutoScroll) return;
						var tracker = window._taskThreadPageTracker;
						var userScrolledUp = tracker
							? !!tracker.userScrolledUp
							: !!window._taskThreadUserScrolledUp;
						var snapshot = tracker && typeof tracker.snapshot === 'function'
							? tracker.snapshot()
							: { scrollTop: chatMessages.scrollTop || 0, userScrolledUp: userScrolledUp, pinned: !userScrolledUp };
						window._taskThreadScrollStates = window._taskThreadScrollStates || {};
						window._taskThreadScrollStates[key] = snapshot;
						window._taskThreadUserScrolledUp = !!snapshot.userScrolledUp;
					}

					function _restoreThreadScrollOrBottom(taskId, forceBottom) {
						requestAnimationFrame(function() {
							var chatMessages = document.getElementById('task-thread-messages');
							if (!chatMessages || !window.chatAutoScroll) return;

							var state = _getTaskThreadScrollState(taskId);
							if (!forceBottom && state) {
								chatMessages.scrollTop = state.userScrolledUp ? (state.scrollTop || 0) : chatMessages.scrollHeight;
								if (window._taskThreadPageTracker) window._taskThreadPageTracker.userScrolledUp = !!state.userScrolledUp;
								window._taskThreadUserScrolledUp = !!state.userScrolledUp;
								return;
							}

							if (!forceBottom) {
								var tracker = window._taskThreadPageTracker;
								var userScrolledUp = false;
								if (tracker && typeof tracker.userScrolledUp === 'boolean') {
									userScrolledUp = tracker.userScrolledUp;
								} else if (typeof window._taskThreadUserScrolledUp === 'boolean') {
									userScrolledUp = window._taskThreadUserScrolledUp;
								}
								if (userScrolledUp) return;
							}

							window.chatAutoScroll.scrollToBottom(chatMessages, !!forceBottom);
							_saveTaskThreadScrollState(taskId);
						});
					}

						function _closeTaskThreadEventSourcesForRefresh() {
							if (!window._threadEventSources) return;
							window._threadEventSources.forEach(function(es) {
								try { es.close(); } catch(e) {}
							});
							window._threadEventSources = [];
							window._taskThreadStreamingActive = false;
						}

						function _threadHasExecution(execId) {
							return !!(execId && document.querySelector('[data-exec-id="' + execId.replace(/"/g, '\\"') + '"]'));
						}

						function _loadThreadContent(taskId, forceReload, expectedExecId) {
							var threadContent = document.getElementById('thread-content');
							if (!threadContent || !taskId || threadContent.dataset.taskId !== taskId) return Promise.resolve(false);
							if (!forceReload && threadContent.dataset.loaded === 'true' && (!expectedExecId || _threadHasExecution(expectedExecId))) return Promise.resolve(true);
							if (_threadContentLoading) return Promise.resolve(false);
							if (typeof htmx === 'undefined') return Promise.resolve(false);

							if (forceReload) _closeTaskThreadEventSourcesForRefresh();
							_threadContentLoading = true;
							threadContent.dataset.loading = 'true';
							return htmx.ajax('GET', '/tasks/' + taskId + '/thread', {
								target: '#thread-content[data-task-id="' + taskId.replace(/"/g, '\\"') + '"]',
								swap: 'innerHTML'
							}).then(function() {
								var updated = document.getElementById('thread-content');
								if (!updated || updated.dataset.taskId !== taskId) return false;
								updated.dataset.loaded = 'true';
								updated.dataset.loading = 'false';
								if (window.htmx && typeof htmx.process === 'function') htmx.process(updated);
								if (expectedExecId && !_threadHasExecution(expectedExecId)) return false;
								return true;
							}).catch(function(err) {
								console.error('Failed to load thread content:', err);
								var updated = document.getElementById('thread-content');
								if (updated) updated.dataset.loading = 'false';
								return false;
							}).finally(function() {
								_threadContentLoading = false;
							});
						}

						function _refreshActiveThreadContent(taskId, forceReload, expectedExecId, attempt) {
							var threadContent = document.getElementById('thread-content');
							if (!taskId || !_isChatTabActive() || !threadContent || threadContent.dataset.taskId !== taskId) return;
							attempt = attempt || 0;
							_loadThreadContent(taskId, forceReload, expectedExecId).then(function(loaded) {
								var currentThreadContent = document.getElementById('thread-content');
								if (!currentThreadContent || currentThreadContent.dataset.taskId !== taskId) return;
								if (!loaded && forceReload && attempt < 8) {
									setTimeout(function() { _refreshActiveThreadContent(taskId, true, expectedExecId, attempt + 1); }, 150 * (attempt + 1));
									return;
								}
								_restoreThreadScrollOrBottom(taskId, false);
								if (window._initThreadStreaming) window._initThreadStreaming();
							});
						}

							window._openTaskThreadAfterRun = function(taskId) {
								taskId = taskId || _currentTaskIdFromPath();
								if (!taskId) return;
								switchTaskTab('chat');
								var nextURL = '/tasks/' + taskId + '?tab=chat';
								if (window.location.pathname !== '/tasks/' + taskId || window.location.search !== '?tab=chat') {
									window.openVibelyNavigate(nextURL).catch(function(err) {
										console.error('[task-thread] Failed to open task thread:', err);
									});
									return;
								}
								_refreshActiveThreadContent(taskId, true, '', 0);
							};
					function switchTaskTab(tabName) {
					var container = document.getElementById('task-detail-content');
					if (!container) return;

					if (_isChatTabActive()) {
						_saveTaskThreadScrollState();
					}

				container.querySelectorAll('.task-tab-panel').forEach(function(panel) {
					panel.classList.add('hidden');
				});

				container.querySelectorAll('[data-tab]').forEach(function(tab) {
					tab.classList.remove('tab-active');
				});

				var panel = container.querySelector('#tab-' + tabName);
				if (panel) panel.classList.remove('hidden');

					var tab = container.querySelector('[data-tab="' + tabName + '"]');
					if (tab) tab.classList.add('tab-active');

					// Auto-scroll thread to bottom when switching to thread tab
						if (tabName === 'chat') {
							var threadContent = document.getElementById('thread-content');
							var taskId = (threadContent && threadContent.dataset.taskId) || _currentTaskIdFromPath();
							if (taskId) {
								_loadThreadContent(taskId).then(function() {
										_restoreThreadScrollOrBottom(taskId, false);
									});
								} else {
									_restoreThreadScrollOrBottom(taskId, false);
								}					}

				// Reload changes content and start SSE when switching to changes tab
				if (tabName === 'changes') {
					var taskIdMatch = window.location.pathname.match(/\/tasks\/([^\/]+)/);
					if (taskIdMatch && taskIdMatch[1]) {
						var taskId = taskIdMatch[1];
						if (typeof htmx !== 'undefined') {
							htmx.ajax('GET', '/tasks/' + taskId + '/changes', {
								target: '#changes-content',
								swap: 'innerHTML'
							}).then(function() {
								// Seed fingerprint so the first SSE update can detect no-ops.
								var cc = document.getElementById('changes-content');
								if (cc) _lastDiffFingerprint = _computeDiffFingerprint(cc);
							}).catch(function() {});
						}
						// Start SSE for real-time file changes
						_startFileChangesSSE(taskId);
					}
				} else {
					// Stop SSE when switching away from changes tab
					_stopFileChangesSSE();
				}
				}

				// File changes are consumed from the shared sidebar live stream.
				// Keep per-task filtering in-page to avoid creating another EventSource.
				var _fileChangesListening = false;
				var _fileChangesUpdatePending = false;
				var _fileChangesTaskId = null;

				function _isChangesTabActive() {
					var changesTab = document.querySelector('[data-tab="changes"]');
					if (!changesTab || !changesTab.classList.contains('tab-active')) return false;
					var changesPanel = document.getElementById('tab-changes');
					return !!changesPanel && !changesPanel.classList.contains('hidden');
				}

			function _handleSharedFileChangeEvent(event) {
				if (!_fileChangesListening || !_fileChangesTaskId) return;
				var data = event.detail || {};
				if (!data.task_id || data.task_id !== _fileChangesTaskId) return;

				if (data.type === 'diff_snapshot') {
					_updateDiffViewer();
					return;
				}
				if (data.type === 'file_modified') {
					console.log('File modified:', data.file_path, 'via', data.tool_name);
				}
			}

			function _startFileChangesSSE(taskId) {
				if (!taskId) return;
				if (_fileChangesListening && _fileChangesTaskId === taskId) return;
				_fileChangesTaskId = taskId;
				_fileChangesListening = true;
				console.log('File changes live listener active for task:', taskId);
			}

			function _stopFileChangesSSE() {
				_fileChangesListening = false;
				console.log('File changes live listener paused');
			}

				// Track the last diff fingerprint to skip no-op DOM replacements.
				var _lastDiffFingerprint = '';

				function _computeDiffFingerprint(container) {
					var viewer = container && container.querySelector('#diff-viewer');
					if (!viewer) return '';
					// Use a simple hash of the full diff viewer HTML for accurate
					// change detection. The previous badge+row-count approach missed
					// content changes within existing lines.
					var raw = viewer.innerHTML;
					var h = 0;
					for (var i = 0; i < raw.length; i++) {
						h = ((h << 5) - h + raw.charCodeAt(i)) | 0;
					}
					return String(h);
				}

				function _getDiffViewMode() {
					var splitBtn = document.getElementById('diff-btn-split');
					return (splitBtn && splitBtn.classList.contains('btn-active')) ? 'split' : 'inline';
				}

				function _updateDiffViewer(diffOutput) {
					var changesContent = document.getElementById('changes-content');
					if (!changesContent) return;
					if (!_isChangesTabActive()) return;

					// Debounce: skip if an update is already in flight
					if (_fileChangesUpdatePending) return;
					_fileChangesUpdatePending = true;

				var taskId = changesContent.dataset.taskId;
				if (taskId) {
					// Fetch new HTML in the background WITHOUT touching the live DOM.
					// Only swap if content actually changed — this prevents the viewport
					// jumps caused by the old htmx.ajax() path which replaced innerHTML
					// before the fingerprint check could run.
					fetch('/tasks/' + taskId + '/changes', {
						headers: { 'HX-Request': 'true' }
					}).then(function(resp) {
						if (!resp.ok) throw new Error('HTTP ' + resp.status);
						return resp.text();
					}).then(function(html) {
						_fileChangesUpdatePending = false;

						// Parse the response in a detached element to compute fingerprint
						// without touching the live DOM at all.
						var offscreen = document.createElement('div');
						offscreen.innerHTML = html;

						var newFp = _computeDiffFingerprint(offscreen);
						if (newFp && newFp === _lastDiffFingerprint) {
							// Diff unchanged — no DOM mutation, no scroll disruption.
							return;
						}
						_lastDiffFingerprint = newFp;

						// Content changed — apply the swap with UI state preservation.
						var scrollX = window.scrollX || window.pageXOffset || 0;
						var scrollY = window.scrollY || window.pageYOffset || 0;
						var viewMode = _getDiffViewMode();

							changesContent.innerHTML = html;
							if (typeof htmx !== 'undefined' && typeof htmx.process === 'function') {
								htmx.process(changesContent);
							}

							// Let the browser settle the new DOM, then restore UI state.
							requestAnimationFrame(function() {
								// Restore diff view mode (inline/split) without saving during refresh restore.
								if ((viewMode === 'inline' || viewMode === 'split') && typeof switchDiffView === 'function') {
									switchDiffView(viewMode, false);
								}
								// Restore scroll position so the user stays where they were.
								window.scrollTo(scrollX, scrollY);
							});
					}).catch(function() {
						_fileChangesUpdatePending = false;
					});
				} else {
					_fileChangesUpdatePending = false;
				}
			}

				// Start SSE if changes tab is active on page load and task is running/queued
				(function() {
					setTimeout(function() {
						if (_isChatTabActive()) {
							var threadContent = document.getElementById('thread-content');
							var taskId = (threadContent && threadContent.dataset.taskId) || _currentTaskIdFromPath();
							if (taskId) {
								_loadThreadContent(taskId).then(function() {
										_restoreThreadScrollOrBottom(taskId, false);
									});							}
						}
						if (_isChangesTabActive()) {
							var changesContent = document.getElementById('changes-content');
							if (changesContent) {
								var taskId = changesContent.dataset.taskId;
								if (taskId) {
									_startFileChangesSSE(taskId);
									// Seed fingerprint from initial server render.
									_lastDiffFingerprint = _computeDiffFingerprint(changesContent);
							}
						}
					}
				}, 100);
				})();

				// Refresh the action buttons (Run Now / Edit / Delete) via the lightweight
				// /tasks/:id/detail-actions fragment endpoint.  Called both from the polling
				// afterSettle handler (up to 3s after completion) and from the SSE task-event
				// listener below (fires immediately on task_status_changed events).
				function _refreshTaskDetailActions() {
					var actions = document.getElementById('task-detail-actions');
					if (!actions) return;
					var taskIdMatch = window.location.pathname.match(/\/tasks\/([^\/]+)/);
					if (!taskIdMatch || !taskIdMatch[1]) return;
					if (typeof htmx === 'undefined') return;
					htmx.ajax('GET', '/tasks/' + taskIdMatch[1] + '/detail-actions', {
						target: '#task-detail-actions',
						swap: 'outerHTML'
					});
				}

				var _prevTaskStatus = null;
					if (window._taskDetailFileChangesHandlers) {
						if (window._taskDetailFileChangesHandlers.beforeUnload) {
							window.removeEventListener('beforeunload', window._taskDetailFileChangesHandlers.beforeUnload);
						}
						if (window._taskDetailFileChangesHandlers.liveConnected) {
							window.removeEventListener('sse-live-connected', window._taskDetailFileChangesHandlers.liveConnected);
						}
					if (window._taskDetailFileChangesHandlers.afterSettle) {
						document.removeEventListener('htmx:afterSettle', window._taskDetailFileChangesHandlers.afterSettle);
					}
					if (window._taskDetailFileChangesHandlers.beforeSwap) {
						document.body.removeEventListener('htmx:beforeSwap', window._taskDetailFileChangesHandlers.beforeSwap);
					}
					if (window._taskDetailFileChangesHandlers.beforeRequest) {
						document.body.removeEventListener('htmx:beforeRequest', window._taskDetailFileChangesHandlers.beforeRequest);
					}
					if (window._taskDetailFileChangesHandlers.fileChangeEvent) {
						window.removeEventListener('sse-file-change-event', window._taskDetailFileChangesHandlers.fileChangeEvent);
					}
					if (window._taskDetailFileChangesHandlers.taskEvent) {
						window.removeEventListener('sse-task-event', window._taskDetailFileChangesHandlers.taskEvent);
					}
				}

				var _taskDetailFileChangeEventHandler = _handleSharedFileChangeEvent;

				// Listen for SSE task_status_changed events so action buttons refresh immediately
				// on task completion — without waiting up to 3s for the next metrics poll cycle.
					var _taskDetailTaskEventHandler = function(event) {
						var data = event.detail || {};
						// Only react to this task's events
						var taskIdMatch = window.location.pathname.match(/\/tasks\/([^\/]+)/);
						if (!taskIdMatch || !taskIdMatch[1] || data.task_id !== taskIdMatch[1]) return;
						if (data.type === 'task_thread_execution_started' || data.type === 'task_thread_input_applied') {
							// TaskThreadLiveEventsScript owns these events. It appends the
							// authoritative execution fragment and attaches /events/chat/:exec_id
							// without replacing #thread-content or closing the fresh stream.
							return;
						}
						if (data.type === 'task_status_changed') {
							var activeStatuses = { pending: true, queued: true, running: true };
							if (activeStatuses[data.status]) {
								// Skip the full thread reload if the composer has a pending attachment
								// upload session to avoid destroying unsent attachment state while a
								// parallel task activation event arrives.
								var sessionInputSC = document.getElementById('task-thread-form-session-id');
								if (!sessionInputSC || !sessionInputSC.value) {
									if (window.reconcileTaskThreadState) window.reconcileTaskThreadState(data.task_id);
									else _refreshActiveThreadContent(data.task_id, true, data.exec_id || '', 0);
								}
							}
							var terminalStatuses = { completed: true, failed: true, cancelled: true };
							if (terminalStatuses[data.status]) {
								_refreshTaskDetailActions();
							}
						}
					};

					var _taskDetailLiveConnectedHandler = function(event) {
						var detail = event.detail || {};
						// Only react to actual SSE reconnects (e.g. after tab blur/refocus).
						// The initial SSE connection is handled by the page-load init below.
						if (!detail.reconnected) return;
						var taskId = _currentTaskIdFromPath();
						if (!taskId || !_isChatTabActive()) return;
						var threadContent = document.getElementById('thread-content');
						if (!threadContent || threadContent.dataset.taskId !== taskId) return;
						// Never replace the composer while it owns a pending upload session.
						var sessionInput = document.getElementById('task-thread-form-session-id');
						if (sessionInput && sessionInput.value) return;
						if (threadContent.dataset.loaded !== 'true') {
							_loadThreadContent(taskId, false);
							return;
						}
						// The scoped thread script compares authoritative snapshot revisions and
						// suppresses unchanged morphs before streams or DOM state are touched.
						if (window.reconcileTaskThreadState) window.reconcileTaskThreadState(taskId);
					};

					var _taskDetailBeforeUnloadHandler = function() {
						_stopFileChangesSSE();
					};

				var _taskDetailBeforeSwapHandler = function(evt) {
					var target = evt.detail && evt.detail.target;
					if (!target) return;
						if (target.id === 'main-content' || target.id === 'task-detail-content') {
							_stopFileChangesSSE();
							window.removeEventListener('sse-file-change-event', _taskDetailFileChangeEventHandler);
							window.removeEventListener('sse-task-event', _taskDetailTaskEventHandler);
							window.removeEventListener('sse-live-connected', _taskDetailLiveConnectedHandler);
						}
				};

				// Block event-triggered changes refreshes while Changes tab is not active.
				var _taskDetailBeforeRequestHandler = function(evt) {
					var triggerEl = evt.detail && evt.detail.elt;
					if (!triggerEl) return;
					if (triggerEl.id === 'changes-content' && !_isChangesTabActive()) {
						evt.preventDefault();
					}
				};

				// Watch for task status changes to stop SSE and do final refresh.
				var _taskDetailAfterSettleHandler = function(evt) {
					var metrics = document.getElementById('task-detail-metrics');
					if (!metrics) return;
					var status = metrics.dataset.taskStatus;
					if (!status) return;
					if (_prevTaskStatus === null) {
					_prevTaskStatus = status;
					return;
				}
				if (_prevTaskStatus !== status) {
					var wasActive = (_prevTaskStatus === 'running' || _prevTaskStatus === 'queued');
					var nowActive = (status === 'running' || status === 'queued');
						var nowDone = (status === 'completed' || status === 'failed' || status === 'cancelled');
						_prevTaskStatus = status;
						if (wasActive && nowDone) {
							// Task just finished — stop SSE, do final changes refresh, and update action buttons
							_stopFileChangesSSE();
							_updateDiffViewer('final');
							_refreshTaskDetailActions();
						}
						if (!wasActive && nowActive && _fileChangesTaskId && _isChangesTabActive()) {
							// Task reactivated (e.g., follow-up on completed task) while changes tab is open.
							// Restart SSE so realtime diff snapshots resume for this execution.
							_startFileChangesSSE(_fileChangesTaskId);
						}
					}
				};

					window._taskDetailFileChangesHandlers = {
						beforeUnload: _taskDetailBeforeUnloadHandler,
						beforeSwap: _taskDetailBeforeSwapHandler,
						beforeRequest: _taskDetailBeforeRequestHandler,
						afterSettle: _taskDetailAfterSettleHandler,
						fileChangeEvent: _taskDetailFileChangeEventHandler,
						taskEvent: _taskDetailTaskEventHandler,
						liveConnected: _taskDetailLiveConnectedHandler
					};

					window.addEventListener('beforeunload', _taskDetailBeforeUnloadHandler);
					document.body.addEventListener('htmx:beforeSwap', _taskDetailBeforeSwapHandler);
					document.body.addEventListener('htmx:beforeRequest', _taskDetailBeforeRequestHandler);
					document.addEventListener('htmx:afterSettle', _taskDetailAfterSettleHandler);
					window.addEventListener('sse-file-change-event', _taskDetailFileChangeEventHandler);
					window.addEventListener('sse-task-event', _taskDetailTaskEventHandler);
					window.addEventListener('sse-live-connected', _taskDetailLiveConnectedHandler);

			function copyToClipboard(elementId, button) {
				var element = document.getElementById(elementId);
				if (!element) return;

				var text = element.textContent;
				navigator.clipboard.writeText(text).then(function() {
					var originalHTML = button.innerHTML;
					button.innerHTML = '<svg xmlns="http://www.w3.org/2000/svg" class="h-4 w-4" fill="none" viewBox="0 0 24 24" stroke="currentColor"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M5 13l4 4L19 7"></path></svg>';
					button.classList.add('btn-success');

					setTimeout(function() {
						button.innerHTML = originalHTML;
						button.classList.remove('btn-success');
					}, 2000);
				}).catch(function(err) {
					console.error('Failed to copy text: ', err);
				});
			}
		</script>
	</div>
}

// TaskDetailActions renders the action buttons (Run Now / Edit / Delete) for the details tab.
// This fragment is independently refreshable via GET /tasks/:taskId/detail-actions so that
// action button state (disabled Run Now, hidden Edit) updates in real time when a task finishes.
templ TaskDetailActions(task *models.Task) {
	<div id="task-detail-actions" class="flex gap-2">
		if task.Status == models.StatusRunning || task.Status == models.StatusQueued {
			<button
				class="btn btn-primary btn-sm"
				disabled
				title="Task is already running or queued"
			>
				Run Now
			</button>
		} else {
			<button
				class="btn btn-primary btn-sm"
				hx-post={ fmt.Sprintf("/tasks/%s/run", task.ID) }
				hx-swap="none"
				hx-on::after-request={ templ.ComponentScript{Call: fmt.Sprintf("if(event.detail.successful) { window._openTaskThreadAfterRun && window._openTaskThreadAfterRun('%s'); }", task.ID)} }
			>
				Run Now
			</button>
		}
		if task.Status != models.StatusRunning {
			<button
				class="btn btn-secondary btn-sm"
				onclick="document.getElementById('task-detail-view').classList.add('hidden'); document.getElementById('task-detail-edit').classList.remove('hidden')"
			>
				Edit
			</button>
		}
		<button
			class="btn btn-sm btn-error btn-outline"
			onclick="document.getElementById('delete-task-modal').showModal()"
		>
			Delete
		</button>
	</div>
}

func taskExecutionMetricsValue(metrics *models.TaskExecutionMetrics) models.TaskExecutionMetrics {
	if metrics == nil {
		return models.TaskExecutionMetrics{}
	}
	return *metrics
}

// TaskDetailMetrics renders the status/category/tag/priority/model/agent metrics grid with polling.
// Polls every 3s to keep status badges up to date when task state changes (e.g., via chat interaction).
templ TaskDetailMetrics(task *models.Task, metrics models.TaskExecutionMetrics, agents []models.LLMConfig, agentLabel string) {
	<div
		id="task-detail-metrics"
		class="grid grid-cols-2 md:grid-cols-4 gap-4 mb-6"
		hx-get={ fmt.Sprintf("/tasks/%s/detail-status", task.ID) }
		hx-trigger="every 3s"
		hx-target="#task-detail-metrics"
		hx-swap="morph:outerHTML"
		data-task-status={ string(task.Status) }
	>
		<div>
			<span class="text-sm opacity-60">Category:</span>
			<span class="ml-2 badge badge-sm badge-outline">{ string(task.Category) }</span>
		</div>
		// Only show status badge if it provides meaningful information beyond category
		// For backlog/scheduled tasks with pending status, the category badge is sufficient
		if !(task.Status == models.StatusPending && (task.Category == models.CategoryBacklog || task.Category == models.CategoryScheduled)) {
			<div>
				<span class="text-sm opacity-60">Status:</span>
				<span class={ "ml-2 badge badge-sm", components.StatusBadgeClass(task.Status) }>{ components.StatusLabelForTask(task.Status, task.Category) }</span>
			</div>
		}
		<div>
			<span class="text-sm opacity-60">Tag:</span>
			if task.Tag != "" {
				<span class="ml-2 badge badge-sm badge-outline inline-flex items-center">{ components.TagLabel(task.Tag) }</span>
			} else {
				<span class="ml-2 badge badge-sm badge-outline opacity-70">None</span>
			}
		</div>
		if components.PriorityLabel(task.Priority) != "" {
			<div>
				<span class="text-sm opacity-60">Priority:</span>
				<span class="ml-2 badge badge-sm badge-outline">{ components.PriorityLabel(task.Priority) }</span>
			</div>
		}
		<div>
			<span class="text-sm opacity-60">Model:</span>
			<span class="ml-2 badge badge-sm badge-outline">{ taskModelLabel(task, agents) }</span>
		</div>
		<div>
			<span class="text-sm opacity-60">Agent:</span>
			<span class="ml-2 badge badge-sm badge-outline">{ taskAgentLabel(task, agentLabel) }</span>
		</div>
		if task.Status == models.StatusRunning && metrics.LatestStartedAt != nil {
			<div>
				<span class="text-sm opacity-60">Elapsed:</span>
				<span class="ml-2 badge badge-warning">{ components.FormatElapsedTime(*metrics.LatestStartedAt) }</span>
			</div>
		}
		if (task.Status == models.StatusCompleted || task.Status == models.StatusFailed) && metrics.LatestDurationMs > 0 {
			if dur := components.FormatDuration(metrics.LatestDurationMs); dur != "" {
				<div>
					<span class="text-sm opacity-60">Duration:</span>
					<span class="ml-2 badge badge-sm badge-outline">{ dur }</span>
				</div>
			}
		}
	</div>
}

templ SwarmContextPanel(task *models.Task) {
	if task.SwarmRole == models.SwarmRoleParent {
		<div class="card bg-base-200/50 border border-base-300 mb-4">
			<div class="card-body p-4">
				<h3 class="font-semibold mb-2">Swarm Overview</h3>
					<div class="grid grid-cols-1 gap-2 text-sm sm:grid-cols-2">
						<div><span class="opacity-60">Status:</span> { components.SwarmStatusDisplayName(task.SwarmStatus) }</div>
						<div><span class="opacity-60">Children:</span> { fmt.Sprintf("%d", len(task.SwarmChildren)) }</div>
						if task.WorktreeBranch != "" {
							<div class="sm:col-span-2 min-w-0"><span class="opacity-60">Merge worktree:</span> <span class="break-all">{ task.WorktreeBranch }</span></div>
						}
					</div>
				if len(task.SwarmChildren) > 0 {
					<div class="mt-3 space-y-1">
						for _, child := range task.SwarmChildren {
							<div class="flex flex-wrap items-center gap-2 text-sm">
								<span class={ "badge badge-sm", components.StatusBadgeClass(child.Status) }>{ components.StatusLabelForTask(child.Status, child.Category) }</span>
								<a class="link link-primary" href={ templ.SafeURL(fmt.Sprintf("/tasks/%s", child.ID)) } hx-get={ fmt.Sprintf("/tasks/%s", child.ID) } hx-target="#main-content" hx-swap="innerHTML" hx-push-url="true">{ child.Title }</a>
									<span class="opacity-60">{ components.SwarmRoleDisplayName(child.SwarmRole) }</span>
								if child.WorktreeBranch != "" {
									<a class="link" href={ templ.SafeURL(fmt.Sprintf("/tasks/%s?tab=changes", child.ID)) } hx-get={ fmt.Sprintf("/tasks/%s?tab=changes", child.ID) } hx-target="#main-content" hx-swap="innerHTML" hx-push-url="true">diff</a>
								}
							</div>
						}
					</div>
				}
			</div>
		</div>
	} else if models.IsSwarmChildRole(task.SwarmRole) {
		<div class="card bg-base-200/50 border border-base-300 mb-4">
			<div class="card-body p-4">
				<h3 class="font-semibold mb-2">Swarm Context</h3>
				<div class="space-y-1 text-sm">
					if task.ParentTaskID != nil {
						<div>Part of swarm: <a class="link link-primary" href={ templ.SafeURL(fmt.Sprintf("/tasks/%s", *task.ParentTaskID)) } hx-get={ fmt.Sprintf("/tasks/%s", *task.ParentTaskID) } hx-target="#main-content" hx-swap="innerHTML" hx-push-url="true">{ *task.ParentTaskID }</a></div>
					}
					<div>Role: { components.SwarmRoleDisplayName(task.SwarmRole) }</div>
					if task.WorktreeBranch != "" {
						<div class="break-all">Worktree: { task.WorktreeBranch }</div>
					}
				</div>
			</div>
		</div>
	}
}

templ TaskPromptPanel(task *models.Task) {
	<div id="task-prompt-panel" class="card bg-base-200/50 border border-base-300 mb-4">
		<div class="card-body p-4 gap-3">
			<div class="text-sm font-semibold">Prompt</div>
			if task.Prompt != "" {
				<div class="textarea textarea-bordered textarea-sm w-full min-h-32 h-auto cursor-default whitespace-pre-wrap overflow-x-auto font-sans text-sm leading-relaxed">{ task.Prompt }</div>
			} else {
				<p class="text-sm opacity-60">No prompt set</p>
			}
		</div>
	</div>
}

templ TaskGoalPanel(taskID string, goal *models.TaskGoal) {
	<div id="task-goal-panel" class="card bg-base-200/50 border border-base-300 mb-4" data-task-id={ taskID }>
		<div class="card-body p-4 gap-3">
			<div class="flex items-center justify-between gap-3">
				<div>
					<div class="text-sm font-semibold">Goal</div>
					if goal == nil || goal.Status == models.TaskGoalStatusCleared {
						<div class="text-sm opacity-60">No goal set</div>
					}
				</div>
				if goal != nil && goal.Status != models.TaskGoalStatusCleared {
					<span class="badge badge-outline">{ goalStatusLabel(goal) }</span>
				}
			</div>
			if goal != nil && goal.Status != models.TaskGoalStatusCleared {
				<div class="textarea textarea-bordered textarea-sm w-full min-h-20 h-auto cursor-default whitespace-pre-wrap overflow-x-auto font-sans text-sm leading-relaxed">{ goal.Objective }</div>
				if goal.Reason != "" {
					<p class="text-xs opacity-60">Reason: { goal.Reason }</p>
				}
				if goal.LastCheckedAt != nil {
					<p class="text-xs opacity-60">Last checked: { goal.LastCheckedAt.Local().Format("Jan 2, 2006 3:04 PM") }</p>
				} else {
					<p class="text-xs opacity-60">Last checked: not yet</p>
				}
			}
		</div>
	</div>
}

func goalValue(goal *models.TaskGoal) string {
	if goal == nil || goal.Status == models.TaskGoalStatusCleared {
		return ""
	}
	return goal.Objective
}

func goalStatusLabel(goal *models.TaskGoal) string {
	if goal == nil {
		return ""
	}
	if goal.Status == models.TaskGoalStatusPaused && strings.EqualFold(strings.TrimSpace(goal.Reason), "stopped by user") {
		return "Paused (stopped by user)"
	}
	return string(goal.Status)
}

func taskModelLabel(task *models.Task, agents []models.LLMConfig) string {
	if task == nil || task.AgentID == nil || *task.AgentID == "" {
		return "Default model"
	}
	for _, agent := range agents {
		if agent.ID == *task.AgentID {
			if agent.Name != "" {
				return agent.Name
			}
			if agent.Model != "" {
				return agent.Model
			}
			break
		}
	}
	return "Unknown model"
}

func taskAgentLabel(task *models.Task, agentName string) string {
	if task == nil || task.AgentDefinitionID == nil || *task.AgentDefinitionID == "" {
		return "No agent"
	}
	if agentName != "" {
		return agentName
	}
	return "Unknown agent"
}

func taskAgentLabelFromDefinitions(task *models.Task, agentDefs []models.Agent) string {
	if task == nil || task.AgentDefinitionID == nil || *task.AgentDefinitionID == "" {
		return ""
	}
	for _, agent := range agentDefs {
		if agent.ID == *task.AgentDefinitionID {
			return agent.Name
		}
	}
	return ""
}
