								state.olderLoading = false;
								state.olderError = error && error.message || 'Unable to load older lifecycle activity';
								renderState(state, container, true);
								schedulePendingRefresh(state, taskID, projectID);
								schedulePendingNewer(state, taskID, projectID);
							});
						}

						function loadNewer(taskID, projectID, catchupCount, fromPending) {
							var container = lifecycleContainer(taskID, projectID);
							if (!container) return Promise.resolve();
							projectID = projectID || container.dataset.projectId || '';
							var state = getState(taskID, projectID);
							if (state.newerLoading) {
								state.newerPending = true;
								return Promise.resolve();
							}
							if (state.gaps.some(function(gap) { return gap.loading; })) {
