package pages

import (
	"fmt"
	"net/url"
	"strconv"
	"strings"

	"github.com/openvibely/openvibely/internal/models"
	"github.com/openvibely/openvibely/web/templates/layout"
)

type AllProjectsData struct {
	Projects      []models.Project
	Section       string
	FilterProject string
	Search        string
	Range         string
	Tasks         []models.Task
	Automations   []models.AutomationCard
	AnalyticsProject *models.Project
 AnalyticsFilters url.Values
	Offset        int
	PageSize      int
	HasMore       bool
}

func allProjectsURL(section string) string {
	return "/" + section + "?project_id=" + models.AllProjectsID
}
func allProjectName(projects []models.Project, id string) string {
	for _, project := range projects {
		if project.ID == id {
			return project.Name
		}
	}
	return id
}
func allProjectTasks(tasks []models.Task, category models.TaskCategory) []models.Task {
	var out []models.Task
	for _, task := range tasks {
		if task.Category == category {
			out = append(out, task)
		}
	}
	return out
}
func (d AllProjectsData) URL(offset int) string {
	q := url.Values{"project_id": {models.AllProjectsID}}
	if d.FilterProject != "" {
		q.Set("filter_project", d.FilterProject)
	}
	if d.Search != "" {
		q.Set("search", d.Search)
	}
	if d.Range != "" {
		q.Set("range", d.Range)
	}
	if offset > 0 || (d.Section == "automations" && d.PageSize > 0) {
		q.Set("card_page", "1")
		q.Set("offset", strconv.Itoa(offset))
		q.Set("page_size", strconv.Itoa(d.PageSize))
	}
	return "/" + d.Section + "?" + q.Encode()
}
templ AllProjects(data AllProjectsData) {
	@layout.Base("All projects", data.Projects, models.AllProjectsID) {
		@AllProjectsContent(data)
	}
}

templ allProjectsHeading(section string) {
	@layout.PageTitle("All projects")
	<div data-page-header class="flex flex-wrap items-center justify-between gap-4 mb-6">
		<div><h2 class="text-2xl font-bold">All projects</h2><p class="text-sm opacity-60 mt-1">{ strings.ToUpper(section[:1]) + section[1:] } across your projects</p></div>
		<nav class="flex gap-2" aria-label="All projects views">
			for _, item := range []string{"tasks", "analytics", "automations"} {
				<a class={ "btn btn-sm", templ.KV("btn-primary", section == item), templ.KV("btn-ghost", section != item) } href={ templ.URL(allProjectsURL(item)) } hx-get={ allProjectsURL(item) } hx-target="#main-content" hx-swap="innerHTML" hx-push-url="true">{ strings.ToUpper(item[:1]) + item[1:] }</a>
			}
		</nav>
	</div>
}

templ AllProjectsContent(data AllProjectsData) {
	<div id="all-projects-page" data-all-projects-view={ data.Section } class="h-full min-h-0 overflow-y-auto">
		@allProjectsHeading(data.Section)
		<form data-analytics-project-filter?={ data.Section == "analytics" } class="flex flex-wrap items-end gap-3 mb-6" method="get" action={ templ.URL("/" + data.Section) } hx-get={ "/" + data.Section } hx-target="#main-content" hx-swap="innerHTML" hx-push-url="true">
			<input type="hidden" name="project_id" value={ models.AllProjectsID }/>
            for key, values := range data.AnalyticsFilters {
                if key != "project_id" && key != "filter_project" && key != "search" {
                    for _, value := range values {
                        <input type="hidden" name={ key } value={ value }/>
                    }
                }
            }

			<label class="form-control">
				<span class="label-text mb-1">Project</span>
				<select name="filter_project" class="select select-bordered select-sm" aria-label="Filter by project">
					<option value="">All projects</option>
					for _, project := range data.Projects {
						<option value={ project.ID } selected?={ data.FilterProject == project.ID }>{ project.Name }</option>
					}
				</select>
			</label>
                if data.Section != "analytics" {
                    <label class="form-control flex-1"><span class="label-text mb-1">Search</span><input name="search" value={ data.Search } type="search" class="input input-bordered input-sm" placeholder={ "Search " + data.Section }/></label>
                }
			<button class="btn btn-sm" type="submit">Apply</button>
			if data.Section != "analytics" {
			<a class="btn btn-sm btn-ghost" href={ templ.URL(data.URL(data.Offset)) } hx-get={ data.URL(data.Offset) } hx-target="#main-content" aria-label="Refresh all projects">Refresh</a>
			}
			if data.Section == "tasks" {
				<a class="btn btn-sm btn-primary" href={ templ.URL("/tasks/new?project_id=" + models.AllProjectsID) } hx-get={ "/tasks/new?project_id=" + models.AllProjectsID } hx-target="#main-content" hx-swap="innerHTML" hx-push-url="true">New task</a>
			}
			if data.Section == "automations" {
				<a class="btn btn-sm btn-primary" href={ templ.URL("/automations/new?project_id=" + models.AllProjectsID) } hx-get={ "/automations/new?project_id=" + models.AllProjectsID } hx-target="#main-content" hx-swap="innerHTML" hx-push-url="true">New automation</a>
			}
		</form>
		if data.Section == "tasks" {
			@AllProjectsTaskResults(data)
		}
		if data.Section == "automations" {
			@AllProjectsAutomationResults(data)
		}
		if data.Section == "analytics" {
			@AnalyticsContent(data.AnalyticsProject)
		}
	</div>
}

templ AllProjectsTaskResults(data AllProjectsData) {
	<div id="all-projects-results" hx-get={ data.URL(0) } hx-trigger="allProjectsRefresh" hx-target="this" hx-swap="outerHTML">
		<p class="text-sm opacity-60 mb-3">{ strconv.Itoa(len(data.Tasks)) } tasks · Open a task to view its thread</p>
		<div class="grid gap-4" style="grid-template-columns: repeat(auto-fit, minmax(min(100%, 260px), 1fr));">
			for _, category := range []models.TaskCategory{models.CategoryBacklog, models.CategoryActive, models.CategoryScheduled, models.CategoryCompleted} {
				<section class="bg-base-200 rounded-lg p-3 min-w-0" data-all-projects-category={ string(category) }>
					<h3 class="font-semibold mb-3">{ strings.ToUpper(string(category)[:1])+string(category)[1:] } <span class="badge badge-sm badge-ghost">{ strconv.Itoa(len(allProjectTasks(data.Tasks, category))) }</span></h3>
					for _, task := range allProjectTasks(data.Tasks, category) {
						<a class="block bg-base-100 border border-base-300 rounded-lg p-3 mb-2 hover:border-primary" data-all-projects-task={ task.ID } data-owner-project={ task.ProjectID } data-task-category={ string(task.Category) } draggable="false" style="touch-action: none;" href={ templ.URL("/tasks/" + url.PathEscape(task.ID) + "?project_id=" + url.QueryEscape(models.AllProjectsID)) } hx-get={ "/tasks/" + url.PathEscape(task.ID) + "?project_id=" + url.QueryEscape(models.AllProjectsID) } hx-target="#main-content" hx-swap="innerHTML" hx-push-url="true">
							<span class="badge badge-sm badge-outline mb-2">{ allProjectName(data.Projects, task.ProjectID) }</span>
							<h4 class="font-semibold break-words">{ task.Title }</h4>
							<div class="flex flex-wrap gap-2 text-xs opacity-60 mt-2"><span>{ string(task.Status) }</span><span>{ fmt.Sprintf("Priority %d", task.Priority) }</span></div>
						</a>
					}
					if len(allProjectTasks(data.Tasks, category)) == 0 {
						<p class="text-sm opacity-50 py-6 text-center">No tasks</p>
					}
				</section>
			}
		</div>
	</div>
}

templ AllProjectsAutomationResults(data AllProjectsData) {
	<div id="all-projects-results" hx-get={ data.URL(data.Offset) } hx-trigger="allProjectsRefresh" hx-target="this" hx-swap="outerHTML">
		<div class="grid gap-4" style="grid-template-columns: repeat(auto-fit, minmax(min(100%, 320px), 1fr));">
			for _, card := range data.Automations {
				<a class="block bg-base-100 border border-base-300 rounded-lg p-4 hover:border-primary" data-all-projects-automation={ card.Automation.ID } data-owner-project={ card.Automation.ProjectID } href={ templ.URL("/automations/" + url.PathEscape(card.Automation.ID) + "?project_id=" + url.QueryEscape(models.AllProjectsID)) } hx-get={ "/automations/" + url.PathEscape(card.Automation.ID) + "?project_id=" + url.QueryEscape(models.AllProjectsID) } hx-target="#main-content" hx-swap="innerHTML" hx-push-url="true">
					<span class="badge badge-sm badge-outline mb-2">{ allProjectName(data.Projects, card.Automation.ProjectID) }</span>
					<h3 class="font-semibold break-words">{ card.Automation.Name }</h3>
					<p class="text-sm opacity-60 mt-2">{ card.Automation.Description }</p>
					<p class="text-xs mt-3">{ string(card.Automation.LifecycleState) } · { string(card.Automation.HealthState) }</p>
				</a>
			}
		</div>
		if len(data.Automations) == 0 {
			<p class="p-8 text-center opacity-60">No automations match these filters.</p>
		}
		<nav class="flex justify-between items-center mt-6" aria-label="Automation pages">
			if data.Offset > 0 {
				<a class="btn btn-sm" href={ templ.URL(data.URL(max(0, data.Offset-data.PageSize))) } hx-get={ data.URL(max(0, data.Offset-data.PageSize)) } hx-target="#main-content" hx-swap="innerHTML" hx-push-url="true">Previous</a>
			}
			<span class="text-sm opacity-60">{ fmt.Sprintf("Showing %d automations", len(data.Automations)) }</span>
			if data.HasMore {
				<a class="btn btn-sm" href={ templ.URL(data.URL(data.Offset + data.PageSize)) } hx-get={ data.URL(data.Offset + data.PageSize) } hx-target="#main-content" hx-swap="innerHTML" hx-push-url="true">Next</a>
			}
		</nav>
	</div>
}

templ AllProjectsChoose(projects []models.Project, path string) {
	@layout.Base("Choose a project", projects, models.AllProjectsID) {
		@AllProjectsChooseContent(projects, path)
	}
}

templ AllProjectsChooseContent(projects []models.Project, path string) {
	<div id="all-projects-choose" class="h-full overflow-y-auto">
		@layout.PageTitle("Choose a project")
		@allProjectsHeading("tasks")
		<h3 class="text-xl font-semibold mb-2">Choose a project</h3>
		<p class="text-sm opacity-60 mb-6">Select the project to use for this page or new item.</p>
		<div class="grid gap-3" style="grid-template-columns: repeat(auto-fit, minmax(min(100%, 280px), 1fr));">
			for _, project := range projects {
				{{ destination := path
if destination == "/tasks/new" || destination == "/automations/new" {
 destination += "?project_id=" + models.AllProjectsID + "&destination_project=" + url.QueryEscape(project.ID)
} else {
 destination += "?project_id=" + url.QueryEscape(project.ID)
} }}
				<a class="block border border-base-300 rounded-lg p-4 hover:border-primary" href={ templ.URL(destination) } hx-get={ destination } hx-target="#main-content" hx-swap="innerHTML" hx-push-url="true">{ project.Name }</a>
			}
		</div>
		if len(projects) == 0 {
			<p>No projects yet. Use the project selector to create one.</p>
		}
	</div>
}
