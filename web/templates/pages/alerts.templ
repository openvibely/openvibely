package pages

import (
	"encoding/base64"
	"encoding/json"
	"fmt"
	"strings"

	"github.com/openvibely/openvibely/internal/models"
	"github.com/openvibely/openvibely/web/templates/layout"
)

func alertCardListState(projectID string, decisionState models.AlertDecisionState, processingState models.AlertProcessingState, search string) CardListState {
	state := CardListState{ProjectID: projectID, Search: search, Filters: map[string]string{"decision_state": string(decisionState)}}
	if processingState != "" {
		state.Preserved = []CardListQueryValue{{Key: "processing_state", Value: string(processingState)}}
	}
	return state
}

templ Alerts(projects []models.Project, currentProjectID string, alerts []models.AlertSummary, unreadCount int) {
	@layout.Base("Alerts", projects, currentProjectID) {
		@alertsContent(alerts, currentProjectID, unreadCount, false, "", "", "", alertCardListState(currentProjectID, "", "", ""))
	}
}

// AlertsPage renders the initial bounded alert page with its page boundary.
templ AlertsPage(projects []models.Project, currentProjectID string, alerts []models.AlertSummary, unreadCount int, hasMore bool) {
	@AlertsPageWithFilters(projects, currentProjectID, alerts, unreadCount, hasMore, "", "")
}

// AlertsPageWithFilters renders the initial alert page with its active workflow filters.
templ AlertsPageWithFilters(projects []models.Project, currentProjectID string, alerts []models.AlertSummary, unreadCount int, hasMore bool, decisionState models.AlertDecisionState, processingState models.AlertProcessingState) {
	@AlertsPageWithFiltersAndSearch(projects, currentProjectID, alerts, unreadCount, hasMore, decisionState, processingState, "")
}

// AlertsPageWithFiltersAndSearch renders the initial alert page with active workflow filters and search.
templ AlertsPageWithFiltersAndSearch(projects []models.Project, currentProjectID string, alerts []models.AlertSummary, unreadCount int, hasMore bool, decisionState models.AlertDecisionState, processingState models.AlertProcessingState, search string) {
	@layout.Base("Alerts", projects, currentProjectID) {
		@alertsContent(alerts, currentProjectID, unreadCount, hasMore, decisionState, processingState, search, alertCardListState(currentProjectID, decisionState, processingState, search))
	}
}

templ AlertsContent(alerts []models.AlertSummary, currentProjectID string, unreadCount int) {
	@alertsContent(alerts, currentProjectID, unreadCount, false, "", "", "", alertCardListState(currentProjectID, "", "", ""))
}

// AlertsContentPage renders a bounded alert page with its page boundary.
templ AlertsContentPage(alerts []models.AlertSummary, currentProjectID string, unreadCount int, hasMore bool) {
	@AlertsContentPageWithFilters(alerts, currentProjectID, unreadCount, hasMore, "", "")
}

// AlertsContentPageWithFilters renders a bounded alert page with its active workflow filters.
templ AlertsContentPageWithFilters(alerts []models.AlertSummary, currentProjectID string, unreadCount int, hasMore bool, decisionState models.AlertDecisionState, processingState models.AlertProcessingState) {
	@AlertsContentPageWithFiltersAndSearch(alerts, currentProjectID, unreadCount, hasMore, decisionState, processingState, "")
}

// AlertsContentPageWithFiltersAndSearch renders a bounded alert page with active workflow filters and search.
templ AlertsContentPageWithFiltersAndSearch(alerts []models.AlertSummary, currentProjectID string, unreadCount int, hasMore bool, decisionState models.AlertDecisionState, processingState models.AlertProcessingState, search string) {
	@alertsContent(alerts, currentProjectID, unreadCount, hasMore, decisionState, processingState, search, alertCardListState(currentProjectID, decisionState, processingState, search))
}

templ AlertsPageWithState(projects []models.Project, currentProjectID string, alerts []models.AlertSummary, unreadCount int, hasMore bool, decisionState models.AlertDecisionState, processingState models.AlertProcessingState, state CardListState) {
	@layout.Base("Alerts", projects, currentProjectID) {
		@alertsContent(alerts, currentProjectID, unreadCount, hasMore, decisionState, processingState, state.Search, state)
	}
}

templ AlertsContentPageWithState(alerts []models.AlertSummary, currentProjectID string, unreadCount int, hasMore bool, decisionState models.AlertDecisionState, processingState models.AlertProcessingState, state CardListState) {
	@alertsContent(alerts, currentProjectID, unreadCount, hasMore, decisionState, processingState, state.Search, state)
}

templ alertsContent(alerts []models.AlertSummary, currentProjectID string, unreadCount int, hasMore bool, decisionState models.AlertDecisionState, processingState models.AlertProcessingState, search string, state CardListState) {
		<div id="alerts-container" class="h-full overflow-y-auto overflow-x-hidden max-w-full min-w-0" data-search-container data-card-pagination-root data-card-pagination-replacement-managed="true" data-card-pagination-url={ CardListURL("alerts", state) } data-card-pagination-preserve-params="read,severity,decision_state,processing_state,type,source,sort,search" data-card-pagination-list="#alerts-card-list" data-card-pagination-card-selector="[data-alert-id]" data-card-pagination-key="data-alert-id" data-card-pagination-page-size="20" data-card-pagination-has-more={ cardPaginationHasMoreAttribute(hasMore) }>
		<div id="alerts-content"
			hx-get={ CardListURL("alerts", state) }
			hx-trigger="alertUpdate from:body"
			hx-target="this"
			hx-select="#alerts-content"
			hx-swap="outerHTML show:none"
		>
		@layout.PageTitle("Alerts")
		<div class="flex items-center justify-between mb-6">
			<h2 class="text-2xl font-bold">
				Alerts
				if unreadCount > 0 {
					<span class="badge badge-error badge-sm ml-2">{ fmt.Sprintf("%d", unreadCount) } unread</span>
				}
			</h2>
			<div class="flex items-center gap-2">
				if len(alerts) > 0 || unreadCount > 0 {
					<!-- Kebab menu -->
					<div class="dropdown dropdown-end">
						<label tabindex="0" class="btn btn-ghost btn-sm" onclick="handleDropdownToggle(event)">
							<svg xmlns="http://www.w3.org/2000/svg" class="h-5 w-5" fill="none" viewBox="0 0 24 24" stroke="currentColor">
								<path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 5v.01M12 12v.01M12 19v.01M12 6a1 1 0 110-2 1 1 0 010 2zm0 7a1 1 0 110-2 1 1 0 010 2zm0 7a1 1 0 110-2 1 1 0 010 2z"></path>
							</svg>
						</label>
						<ul tabindex="0" class="dropdown-content z-[100] menu p-2 shadow bg-base-100 rounded-box w-52 border border-base-300">
							if unreadCount > 0 {
								<li>
									<a
										hx-post={ CardListActionURL("alerts", "/alerts/read-all", state) }
										hx-target="#alerts-content"
										hx-select="#alerts-content"
										hx-swap="outerHTML show:none"
									>
										Mark all as read
									</a>
								</li>
							}
							if len(alerts) > 0 {
								<li>
									<a
										class="text-error"
										href="#"
										data-delete-url={ CardListActionURL("alerts", "/alerts", state) }
										onclick="return deleteAlertsFromDataset(this)"
									>
										Delete All Alerts
									</a>
								</li>
							}
						</ul>
					</div>
				}
			</div>
			</div>
			<div id="system-update-card" hx-preserve class="card bg-base-200 border border-base-300 mb-4 hidden">
				<div class="card-body gap-3">
					<div class="flex items-start justify-between gap-4">
						<div><h3 class="card-title text-lg">OpenVibely update</h3><p id="system-update-summary" class="text-sm opacity-80"></p></div>
						<span id="system-update-state" class="badge badge-outline"></span>
					</div>
					<p id="system-update-owner" class="text-sm"></p>
						<p id="system-update-acceptance" class="text-sm">The replacement is downloaded and verified before approval. After you accept, OpenVibely waits for active work to finish, restarts, validates the new version, and rolls back automatically if needed.</p>
					<p id="system-update-work" class="text-sm"></p>
					<p id="system-update-digest" class="text-xs font-mono break-all hidden"></p>
					<a id="system-update-notes" class="link link-primary text-sm hidden" target="_blank" rel="noopener noreferrer">Release notes</a>
					<p id="system-update-error" class="text-error text-sm hidden"></p>
					<div class="card-actions justify-end">
						<button id="system-update-accept" class="btn btn-sm btn-primary" onclick="systemUpdateAction('apply')">Update OpenVibely</button>
						<button id="system-update-cancel" class="btn btn-sm btn-ghost" onclick="systemUpdateAction('cancel')">Cancel</button>
					</div>
				</div>
			</div>
			<div class="mb-4 rounded-box bg-base-200/60 px-4 py-3 text-sm text-base-content/70">			Showing notifications for the selected project only. Approval permits creation of an implementation task; it does not authorize merge, release, or deployment.
		</div>
			@CardListToolbar(collectionToolbarConfigWithState("alerts", state))
			<div id="alerts-card-list" data-card-pagination-list>
				if len(alerts) == 0 {
					<div class="text-center py-12" data-search-empty-state>
						<svg xmlns="http://www.w3.org/2000/svg" class="h-16 w-16 mx-auto opacity-30 mb-4" fill="none" viewBox="0 0 24 24" stroke="currentColor">
							<path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M15 17h5l-1.405-1.405A2.032 2.032 0 0118 14.158V11a6.002 6.002 0 00-4-5.659V5a2 2 0 10-4 0v.341C7.67 6.165 6 8.388 6 11v3.159c0 .538-.214 1.055-.595 1.436L4 17h5m6 0v1a3 3 0 11-6 0v-1m6 0H9"></path>
						</svg>
						if decisionState != "" || processingState != "" || strings.TrimSpace(search) != "" {
							<p class="opacity-50">No alerts match the selected filters.</p>
						} else {
							<p class="opacity-50">No alerts. You're all clear!</p>
						}
					</div>
				} else {
					<div class="grid grid-cols-1 gap-4 max-w-full min-w-0">
						for _, alert := range alerts {
							@alertRow(alert, currentProjectID, state)
						}
					</div>
				}
			</div>
			@CardPaginationStatusWithBoundary(hasMore)
		</div>
		<!-- Task Detail Dialog Container -->	<script>
		function renderSystemUpdateCard(data) {
				var card = document.getElementById('system-update-card');
				if (!card || !window.openVibelyNormalizeSystemUpdateSnapshot) return;
				if (!data) {
					card.classList.add('hidden');
					return;
				}
				var view = window.openVibelyNormalizeSystemUpdateSnapshot(data);
				if (view.hidden) { card.classList.add('hidden'); return; }
				card.classList.remove('hidden');
				document.getElementById('system-update-summary').textContent = 'Current ' + view.currentVersion + (view.available ? ' · Available ' + view.available : ' · No update available') + ' · ' + view.distribution + ' · ' + view.channel;
				document.getElementById('system-update-state').textContent = view.state;
				document.getElementById('system-update-owner').textContent = view.ownerText;
				document.getElementById('system-update-work').textContent = view.workText;
				var digest = document.getElementById('system-update-digest');
				digest.textContent = view.imageRef ? 'Verified image: ' + view.imageRef : ''; digest.classList.toggle('hidden', !view.imageRef);
				var notes = document.getElementById('system-update-notes');
				if (view.notesURL) { notes.href = view.notesURL; notes.classList.remove('hidden'); } else { notes.classList.add('hidden'); }
				var error = document.getElementById('system-update-error'); error.textContent = view.errorText; error.classList.toggle('hidden', !view.errorText);
				var accept = document.getElementById('system-update-accept');
				accept.textContent = view.acceptText;
				accept.classList.toggle('hidden', !view.actionable);
				document.getElementById('system-update-acceptance').classList.toggle('hidden', !view.showAcceptance);
				document.getElementById('system-update-cancel').classList.toggle('hidden', !view.showCancel);
			}
		async function refreshSystemUpdateCard() {
				var card = document.getElementById('system-update-card');
				if (!card || !window.openVibelyNormalizeSystemUpdateSnapshot) return;
				try {
					var response = await fetch('/api/system/update', {headers: {'Accept': 'application/json'}});
					if (response.status === 204) {
						if (window.openVibelyHandleSystemUpdateSnapshot) window.openVibelyHandleSystemUpdateSnapshot(null);
						else renderSystemUpdateCard(null);
						return;
					}
					if (!response.ok) return;
					var data = await response.json();
					if (window.openVibelyHandleSystemUpdateSnapshot) window.openVibelyHandleSystemUpdateSnapshot(data);
					else renderSystemUpdateCard(data);
				} catch (_) {}
			}
			async function systemUpdateAction(action) {
				var response = await fetch('/api/system/update/' + action, {method: 'POST', headers: {'Accept': 'application/json'}});
				if (action === 'cancel' && response.ok && window.openVibelyClearSystemUpdatePendingSuccess) window.openVibelyClearSystemUpdatePendingSuccess();
				await refreshSystemUpdateCard();
			}
			window.openVibelyRenderSystemUpdateCard = renderSystemUpdateCard;
			if (typeof window.refreshGlobalSystemUpdateIndicators === 'function') window.refreshGlobalSystemUpdateIndicators();
			else refreshSystemUpdateCard();

			function hydrateAlertMarkdown(container) {
				if (!container) return;
				var markdown = container.querySelector('[data-alert-markdown][data-raw-content]');
				if (!markdown) return;
				var raw = markdown.getAttribute('data-raw-content') || '';
				if (!raw) return;
				if (typeof window.renderChatMarkdown !== 'function') {
					markdown.textContent = raw;
					return;
				}
				markdown.classList.add('chat-markdown');
				markdown.innerHTML = window.renderChatMarkdown(raw);
				if (window.addCodeCopyButtons) window.addCodeCopyButtons(markdown);
			}

			function loadAlertDetail(details) {
				if (!details || !details.open) return;
				var container = details.querySelector('[data-alert-detail-container]');
				if (!container || container.dataset.alertDetailState === 'loaded' || container.dataset.alertDetailState === 'loading') return;
				var url = details.dataset.alertDetailUrl || '';
				if (!url) return;
				container.dataset.alertDetailState = 'loading';
				fetch(url, {headers: {'Accept': 'text/html'}}).then(function(response) {
					if (!response.ok) throw new Error('detail request failed');
					return response.text();
				}).then(function(html) {
					container.innerHTML = html;
					hydrateAlertMarkdown(container);
					container.dataset.alertDetailState = 'loaded';
				}).catch(function() {
					container.dataset.alertDetailState = '';
					container.innerHTML = '<p class="text-sm text-error">Could not load detail. Close and reopen to retry.</p>';
				});
			}
			function decodeAlertCopyText(copyText) {
				if (!copyText) return '';
				var encoded = copyText.getAttribute('data-alert-copy-base64') || '';
				if (!encoded) return copyText.textContent || '';
				try {
					var binary = window.atob(encoded);
					var bytes = new Uint8Array(binary.length);
					for (var i = 0; i < binary.length; i++) bytes[i] = binary.charCodeAt(i);
					return new TextDecoder('utf-8', {fatal: true}).decode(bytes);
				} catch (_) {
					return '';
				}
			}
			function copyAlertDetails(button) {
				if (!button) return;
				var scope = button.closest('[data-alert-detail-loaded]') || button.closest('details') || button.parentElement;
				var copyText = scope && scope.querySelector('[data-alert-copy-text]');
				var text = decodeAlertCopyText(copyText);
				var defaultLabel = button.dataset.defaultLabel || 'Copy body';
				var feedback = button.querySelector('[data-alert-copy-feedback]');
				var copyIcon = button.querySelector('[data-alert-copy-icon]');
				var successIcon = button.querySelector('[data-alert-copy-success-icon]');
				var errorIcon = button.querySelector('[data-alert-copy-error-icon]');
				var setFeedback = function(label, failed) {
					if (feedback) feedback.textContent = label;
					if (copyIcon) copyIcon.classList.add('hidden');
					if (successIcon) successIcon.classList.toggle('hidden', failed);
					if (errorIcon) errorIcon.classList.toggle('hidden', !failed);
					button.title = label;
					button.classList.toggle('btn-error', failed);
					button.classList.toggle('btn-success', !failed);
					window.setTimeout(function() {
						if (!button.isConnected) return;
						if (feedback) feedback.textContent = defaultLabel;
						if (copyIcon) copyIcon.classList.remove('hidden');
						if (successIcon) successIcon.classList.add('hidden');
						if (errorIcon) errorIcon.classList.add('hidden');
						button.title = defaultLabel;
						button.classList.remove('btn-error', 'btn-success');
					}, 2000);
				};
				if (!text || !navigator.clipboard || typeof navigator.clipboard.writeText !== 'function') {
					setFeedback('Copy failed', true);
					return;
				}
				navigator.clipboard.writeText(text).then(function() {
					setFeedback('Copied', false);
				}).catch(function() {
					setFeedback('Copy failed', true);
				});
			}
			function openAlertTaskDialog(taskId) {
			window.openVibelyNavigate(
				'/tasks/' + taskId + '?tab=history&from=alerts',
				'/tasks/' + taskId + '?from=alerts'
			);
		}

		function deleteAlerts(url, target) {
			if (!url) return false;
			htmx.ajax('DELETE', url, {
				target: target || '#alerts-content',
				select: '#alerts-content',
				swap: 'outerHTML show:none'
			});
			return false;
		}

		function deleteAlertsFromDataset(el) {
			if (!el || !el.dataset) return false;
			var url = el.dataset.deleteUrl || '';
			var row = el.closest('[data-alert-scroll-anchor]');
			if (row && window.openVibelyAlertsViewport) {
				window.openVibelyAlertsViewport.pendingFocusID = row.dataset.alertId || '';
			}
			return deleteAlerts(url, '#alerts-content');
		}

		(function installAlertsViewportPreservation() {
			var state = window.openVibelyAlertsViewport || (window.openVibelyAlertsViewport = {});
			if (state.installed) return;
			state.installed = true;

			function alertRows(root) {
				return Array.prototype.slice.call(root.querySelectorAll('[data-alert-scroll-anchor]'));
			}

			function visibleAlertRows(rows) {
				return rows.filter(function(row) {
					return row.getClientRects().length > 0;
				});
			}

			function focusCandidates(rows, activeID) {
				var ids = visibleAlertRows(rows).map(function(row) { return row.dataset.alertId || ''; });
				var index = ids.indexOf(activeID);
				if (index < 0) return [];
				var candidates = [activeID];
				for (var distance = 1; distance < ids.length; distance++) {
					if (index + distance < ids.length) candidates.push(ids[index + distance]);
					if (index - distance >= 0) candidates.push(ids[index - distance]);
				}
				return candidates;
			}

			document.body.addEventListener('htmx:beforeSwap', function(event) {
				var target = event.detail && event.detail.target;
				var root = document.getElementById('alerts-container');
				if (!target || target.id !== 'alerts-content' || !root) return;

				var rows = alertRows(root);
				var rootRect = root.getBoundingClientRect();
				var viewportTop = Math.max(rootRect.top, 0);
				var viewportBottom = Math.min(rootRect.bottom, window.innerHeight);
				var renderedRows = visibleAlertRows(rows);
				var viewportRows = renderedRows.filter(function(row) {
					var rect = row.getBoundingClientRect();
					return rect.bottom > viewportTop && rect.top < viewportBottom;
				});
					var anchors = (viewportRows.length ? viewportRows : renderedRows).map(function(row) {
						return {id: row.dataset.alertId || '', top: row.getBoundingClientRect().top};
					}).sort(function(a, b) {
						return Math.abs(a.top - viewportTop) - Math.abs(b.top - viewportTop);
					});
					var activeDelete = document.activeElement && document.activeElement.closest && document.activeElement.closest('[data-alert-delete]');
					var activeRow = activeDelete && activeDelete.closest('[data-alert-scroll-anchor]');
					var focusID = state.pendingFocusID || (activeRow && activeRow.dataset.alertId) || '';
					var focusedVisibleIndex = renderedRows.findIndex(function(row) { return (row.dataset.alertId || '') === focusID; });
					var activeSearch = ((root.querySelector('[data-card-search]') || {}).value || '').trim();
					if (activeSearch && state.pendingFocusID && focusedVisibleIndex > 0) {
						var previous = renderedRows[focusedVisibleIndex - 1];
						var previousID = previous.dataset.alertId || '';
						anchors = [{id: previousID, top: previous.getBoundingClientRect().top}].concat(anchors.filter(function(anchor) { return anchor.id !== previousID; }));
					}
					state.swap = {
						anchors: anchors,
						rootScrollTop: root.scrollTop,
						windowScrollY: window.scrollY,
						search: (root.querySelector('[data-card-search]') || {}).value || '',
						focusIDs: focusCandidates(rows, focusID)
					};				state.pendingFocusID = '';
			});

			document.body.addEventListener('htmx:afterSwap', function(event) {
				var swappedTarget = event.detail && event.detail.target;
				var root = document.getElementById('alerts-container');
				var saved = state.swap;
				if (!swappedTarget || swappedTarget.id !== 'alerts-content' || !root || !saved) return;
				state.swap = null;
				swappedTarget.openVibelyAlertsViewportSwap = saved;

					var replacementSearch = root.querySelector('[data-card-search]');
					if (replacementSearch) {
						replacementSearch.value = saved.search || '';
						replacementSearch.setAttribute('data-card-search-initial', saved.search || '');
					}
					if (typeof window.refreshCardSearches === 'function') {
						window.refreshCardSearches(root);
					}				root.scrollTop = saved.rootScrollTop;
				var anchor = null;
				var savedAnchor = null;
				for (var i = 0; i < saved.anchors.length; i++) {
					anchor = root.querySelector('[data-alert-scroll-anchor="' + CSS.escape(saved.anchors[i].id) + '"]');
					if (anchor) {
						savedAnchor = saved.anchors[i];
						break;
					}
				}
				if (anchor && savedAnchor) {
					var delta = anchor.getBoundingClientRect().top - savedAnchor.top;
						if (saved.search || root.scrollHeight > root.clientHeight) root.scrollTop += delta;
						else window.scrollBy(0, delta);				} else if (Math.abs(window.scrollY - saved.windowScrollY) > 1) {
					window.scrollTo(0, saved.windowScrollY);
				}
			});

			document.body.addEventListener('htmx:afterSettle', function(event) {
				var settledTarget = event.detail && event.detail.target;
				var root = document.getElementById('alerts-container');
				var saved = settledTarget && settledTarget.openVibelyAlertsViewportSwap;
				if (!settledTarget || settledTarget.id !== 'alerts-content' || !root || !saved) return;
					delete settledTarget.openVibelyAlertsViewportSwap;

					var focusTarget = null;				for (var j = 0; j < saved.focusIDs.length; j++) {
					focusTarget = root.querySelector('[data-alert-scroll-anchor="' + CSS.escape(saved.focusIDs[j]) + '"] [data-alert-delete]');
					if (focusTarget) break;
				}
				if (!focusTarget && saved.focusIDs.length) focusTarget = root.querySelector('[data-card-search]');
				if (focusTarget) focusTarget.focus({preventScroll: true});
			});
		})();
		</script>
	</div>
}

// alertSearchInput keeps the Alerts search control's established max-w-xs sizing while
// allowing a direct search query to seed the visible input and session state.
templ alertSearchInput(search string) {
	<div class="mb-4 max-w-xs">
		<div class="card bg-base-100 shadow-sm border border-base-300">
			<input
				type="text"
				name="search"
				value={ search }
				data-card-search="alerts"
				if search != "" {
					data-card-search-initial={ search }
				}
				class="w-full bg-transparent px-4 py-2 text-sm border-0 focus:outline-none focus:ring-0"
				placeholder="Search alerts..."
			/>
		</div>
	</div>
	<div data-search-no-results class="text-center py-8" style="display:none">
		<p class="opacity-50">No results match your search.</p>
	</div>
}

// alertSearchText intentionally excludes the full body and metadata so the
// list DOM stays bounded. Full body/metadata search would require an explicit
// server-side detail search path.
func alertSearchText(alert models.AlertSummary) string {
	return alert.Title + " " + alert.Message + " " + string(alert.Severity) + " " + string(alert.DecisionState) + " " + string(alert.ProcessingState) + " " + alert.Source + " " + alert.CreatedAt.Local().Format("Jan 2, 2006 3:04 PM")
}

func alertBodyBase64(body string) string {
	return base64.StdEncoding.EncodeToString([]byte(body))
}

func alertMetadataJSON(alert models.Alert) string {
	if len(alert.Metadata) == 0 {
		return ""
	}
	data, _ := json.MarshalIndent(alert.Metadata, "", "  ")
	return string(data)
}

func alertSummaryInspectLabel(alert models.AlertSummary) string {
	if alert.DecisionState == models.AlertDecisionNotRequired {
		return "alert"
	}
	return "notification"
}

func alertDetailInspectLabel(alert models.Alert) string {
	if alert.DecisionState == models.AlertDecisionNotRequired {
		return "alert"
	}
	return "notification"
}

// AlertDetail is the lazily loaded inspect fragment for a single notification.
// It is the only alerts surface that renders the full body and structured
// metadata, and it is fetched per-alert when a user opens the inspect panel.
templ AlertDetail(alert models.Alert) {
	@alertDetailBody(alert)
}

templ alertDetailBody(alert models.Alert) {
	if alert.Body == "" && alertMetadataJSON(alert) == "" {
		<p class="text-sm opacity-60">No additional detail.</p>
	} else {
		<div class={ "relative min-w-0 max-w-full", templ.KV("min-h-6 pr-8", alert.Body != "") } data-alert-detail-loaded>
			if alert.Body != "" {
				<div class="chat-markdown" data-alert-markdown data-raw-content={ alert.Body }></div>
			}
			if alertMetadataJSON(alert) != "" {
				<pre class={ "max-w-full overflow-x-auto whitespace-pre-wrap break-all rounded bg-base-300 p-2 text-xs", templ.KV("mt-3", alert.Body != "") }>{ alertMetadataJSON(alert) }</pre>
			}
			if alert.Body != "" {
				<pre class="hidden" data-alert-copy-text data-alert-copy-base64={ alertBodyBase64(alert.Body) } aria-hidden="true"></pre>
				<button
					type="button"
					class="btn btn-xs btn-ghost btn-square absolute right-0 top-0"
					data-alert-copy
					data-default-label="Copy body"
					title="Copy body"
					aria-label={ "Copy inspected " + alertDetailInspectLabel(alert) + " body" }
					onclick="copyAlertDetails(this)"
				>
					<svg data-alert-copy-icon xmlns="http://www.w3.org/2000/svg" class="h-4 w-4" fill="none" viewBox="0 0 24 24" stroke="currentColor" aria-hidden="true">
						<path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M8 16H6a2 2 0 01-2-2V6a2 2 0 012-2h8a2 2 0 012 2v2m-6 12h8a2 2 0 002-2v-8a2 2 0 00-2-2h-8a2 2 0 00-2 2v8a2 2 0 002 2z"></path>
					</svg>
					<svg data-alert-copy-success-icon xmlns="http://www.w3.org/2000/svg" class="hidden h-4 w-4" fill="none" viewBox="0 0 24 24" stroke="currentColor" aria-hidden="true">
						<path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M5 13l4 4L19 7"></path>
					</svg>
					<svg data-alert-copy-error-icon xmlns="http://www.w3.org/2000/svg" class="hidden h-4 w-4" fill="none" viewBox="0 0 24 24" stroke="currentColor" aria-hidden="true">
						<path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M6 18L18 6M6 6l12 12"></path>
					</svg>
					<span data-alert-copy-feedback class="sr-only" aria-live="polite">Copy body</span>
				</button>
			}
		</div>
	}
}

templ alertRow(alert models.AlertSummary, currentProjectID string, state CardListState) {
	<div
		id={ "alert-" + alert.ID }
		data-alert-id={ alert.ID }
		data-alert-scroll-anchor={ alert.ID }
		class={ "card bg-base-100 shadow-sm border border-base-300 hover:border-primary/40 hover:shadow-md transition-all w-full min-w-0 max-w-full", templ.KV("opacity-60", alert.IsRead), templ.KV("cursor-pointer", alert.TaskID != nil) }
		data-card-select-id={ alert.ID }
		data-card-select-eligible="true"
		data-search-card
		data-search-text={ alertSearchText(alert) }
		if alert.TaskID != nil {
			data-task-id={ *alert.TaskID }
			onclick="openAlertTaskDialog(this.dataset.taskId)"
		}
	>
		<div class="card-body max-w-full min-w-0 p-4 sm:p-6">
			<div class="flex items-start gap-3 max-w-full min-w-0">
				<div class="mt-0.5 flex-shrink-0">
					if alert.Severity == models.SeverityError {
						<svg xmlns="http://www.w3.org/2000/svg" class="h-5 w-5 text-error" fill="none" viewBox="0 0 24 24" stroke="currentColor">
							<path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 8v4m0 4h.01M21 12a9 9 0 11-18 0 9 9 0 0118 0z"></path>
						</svg>
					} else if alert.Severity == models.SeverityWarning {
						<svg xmlns="http://www.w3.org/2000/svg" class="h-5 w-5 text-warning" fill="none" viewBox="0 0 24 24" stroke="currentColor">
							<path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 9v2m0 4h.01m-6.938 4h13.856c1.54 0 2.502-1.667 1.732-2.5L13.732 4c-.77-.833-1.964-.833-2.732 0L4.082 16.5c-.77.833.192 2.5 1.732 2.5z"></path>
						</svg>
					} else {
						<svg xmlns="http://www.w3.org/2000/svg" class="h-5 w-5 text-info" fill="none" viewBox="0 0 24 24" stroke="currentColor">
							<path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M13 16h-1v-4h-1m1-4h.01M21 12a9 9 0 11-18 0 9 9 0 0118 0z"></path>
						</svg>
					}
				</div>
				<div class="flex-1 min-w-0 max-w-full">
					<p class={ "font-semibold break-words [overflow-wrap:anywhere]", templ.KV("font-bold", !alert.IsRead) }>
						{ alert.Title }
					</p>
					<div class="mt-2 flex min-w-0 flex-wrap gap-2">
						<span class="badge badge-outline badge-sm">Project scoped</span>
						<span class="badge badge-ghost badge-sm">{ string(alert.Type) }</span>
						if alert.DecisionState != models.AlertDecisionNotRequired {
							<span class={ "badge badge-sm", templ.KV("badge-warning", alert.DecisionState == models.AlertDecisionPending), templ.KV("badge-success", alert.DecisionState == models.AlertDecisionApproved), templ.KV("badge-error", alert.DecisionState == models.AlertDecisionRejected || alert.DecisionState == models.AlertDecisionDismissed) }>{ string(alert.DecisionState) }</span>
						} else {
							<span class="badge badge-neutral badge-sm">Operational</span>
						}
						if alert.ProcessingState != models.AlertProcessingNotApplicable {
							<span class="badge badge-outline badge-sm">{ string(alert.ProcessingState) }</span>
						}
					</div>
					if alert.Message != "" {
						<p class="text-sm opacity-60 mt-1 break-words [overflow-wrap:anywhere]">{ alert.Message }</p>
					}
					<details
						class="mt-3 rounded-box bg-base-200/50 p-3"
						onclick="event.stopPropagation()"
						ontoggle="loadAlertDetail(this)"
						data-alert-detail-url={ fmt.Sprintf("/alerts/%s/details?project_id=%s", alert.ID, currentProjectID) }
					>
						<summary class="cursor-pointer text-sm font-medium">Inspect { alertSummaryInspectLabel(alert) }</summary>
						<div class="mt-3 min-w-0 max-w-full" data-alert-detail-container>
							<p class="text-sm opacity-60" data-alert-detail-placeholder>Loading detail…</p>
						</div>
					</details>
					<div class="mt-2 text-xs opacity-60 break-words">
						<span>Source: { alert.Source }</span>
						<span class="mx-1">·</span>
						<span>{ alert.CreatedAt.Local().Format("Jan 2, 2006 3:04 PM") }</span>
						if alert.Claimant != "" {
							<span class="mx-1">·</span><span>Claimed by { alert.Claimant }</span>
						}
					</div>
					if alert.ProcessingError != "" {
						<p class="mt-2 text-sm text-error break-words">{ alert.ProcessingError }</p>
					}
					if alert.ImplementationTaskID != nil {
						<button class="btn btn-link btn-xs mt-2 px-0" data-task-id={ *alert.ImplementationTaskID } onclick="event.stopPropagation(); openAlertTaskDialog(this.dataset.taskId)">View implementation task</button>
					}
					if alert.DecisionState == models.AlertDecisionPending {
						<div class="mt-4 flex flex-wrap gap-2" onclick="event.stopPropagation()">
							<button class="btn btn-success btn-sm" hx-post={ CardListActionURL("alerts", fmt.Sprintf("/alerts/%s/approve", alert.ID), state) } hx-target="#alerts-content" hx-select="#alerts-content" hx-swap="outerHTML show:none">Approve</button>
							<button class="btn btn-error btn-outline btn-sm" hx-post={ CardListActionURL("alerts", fmt.Sprintf("/alerts/%s/reject", alert.ID), state) } hx-target="#alerts-content" hx-select="#alerts-content" hx-swap="outerHTML show:none">Reject</button>
						</div>
					}
				</div>
				<div class="flex flex-shrink-0 items-center gap-1 self-start" onclick="event.stopPropagation()">
					if !alert.IsRead {
						<button
							class="btn btn-ghost btn-xs"
							hx-post={ CardListActionURL("alerts", fmt.Sprintf("/alerts/%s/read", alert.ID), state) }
							hx-target="#alerts-content"
							hx-select="#alerts-content"
							hx-swap="outerHTML show:none"
							title="Mark as read"
						>
							<svg xmlns="http://www.w3.org/2000/svg" class="h-4 w-4" fill="none" viewBox="0 0 24 24" stroke="currentColor">
								<path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M5 13l4 4L19 7"></path>
							</svg>
						</button>
					}
					<button
						class="btn btn-ghost btn-xs text-error"
						data-alert-delete
						aria-label={ "Delete alert " + alert.Title }
						data-delete-url={ CardListActionURL("alerts", fmt.Sprintf("/alerts/%s", alert.ID), state) }
						onclick="event.preventDefault(); event.stopPropagation(); return deleteAlertsFromDataset(this)"
					>
						<svg xmlns="http://www.w3.org/2000/svg" class="h-4 w-4" fill="none" viewBox="0 0 24 24" stroke="currentColor">
							<path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M19 7l-.867 12.142A2 2 0 0116.138 21H7.862a2 2 0 01-1.995-1.858L5 7m5 4v6m4-6v6m1-10V4a1 1 0 00-1-1h-4a1 1 0 00-1 1v3M4 7h16"></path>
						</svg>
					</button>
				</div>
			</div>
		</div>
	</div>
}

templ AlertBadge(count int) {
	if count > 0 {
		<span class="badge badge-error badge-sm inline-flex items-center">{ fmt.Sprintf("%d", count) }</span>
	}
}
