package pages

import (
 "encoding/json"
 "time"
 "github.com/openvibely/openvibely/internal/models"
)

func scheduleCardInterval(occurrence TaskOccurrence) models.ScheduleSkip {
 start := occurrence.OccurrenceTime
 end := start.Add(time.Second)
 if occurrence.Task.Schedule != nil && occurrence.Task.Schedule.RepeatType.IsSubDaily() {
  start = time.Date(start.Year(), start.Month(), start.Day(), start.Hour(), 0, 0, 0, start.Location())
  end = start.Add(time.Hour)
 }
 return models.ScheduleSkip{ScheduleID: getScheduleID(occurrence.Task), StartAt: start.Unix(), EndAt: end.Unix()}
}

func scheduleCalendarJSON(states []models.ScheduleCalendarState) string {
 state := models.ScheduleCalendarState{}
 if len(states) > 0 { state = states[0] }
 data, _ := json.Marshal(state)
 return string(data)
}

templ ScheduleCalendarControls(states []models.ScheduleCalendarState) {
 <style>
 #schedule-content { position: relative; }
 #schedule-selection-toolbar { position: absolute; bottom: 1.75rem; left: .5rem; right: .5rem; z-index: 40; padding: .5rem; border-radius: .5rem; background: var(--ov-menu-surface); box-shadow: 0 2px 12px rgba(0,0,0,.2); }
 .drag-cursor-active #schedule-selection-toolbar { visibility: hidden; pointer-events: none; }
 #schedule-content [data-calendar-day] { cursor: pointer; user-select: none; touch-action: pan-y; }
 #schedule-content .schedule-day-selected { background: rgba(116,128,255,.16) !important; }
 #schedule-content [data-calendar-day].schedule-day-selected { box-shadow: inset 0 -2px var(--ov-link-color); }
 #schedule-content [data-calendar-day][data-skipped="true"]::after { content: 'Runs skipped'; display: block; font-size: 10px; opacity: .65; }
 #schedule-content [data-schedule-card][data-calendar-muted="true"] { background: oklch(var(--b3)) !important; border-color: oklch(var(--bc) / .2) !important; opacity: .5; }
 #schedule-content [data-schedule-card][data-calendar-muted="true"] > :first-child { text-decoration: line-through; }
 .schedule-selection-box { position: fixed; pointer-events: none; z-index: 90; border: 1px solid var(--ov-link-color); background: rgba(116,128,255,.15); }
 #schedule-content[data-calendar-busy="true"] #schedule-timeline-container { pointer-events: none; }
 </style>
 <div id="schedule-calendar-controls" data-state={ scheduleCalendarJSON(states) } class="flex-shrink-0 text-xs">
  <div id="schedule-pause-banner" class="hidden bg-base-200 rounded p-2 mb-2" role="status">
   All project schedules are paused.
   <button type="button" class="btn btn-xs" data-calendar-action="resume_all">Resume all</button>
  </div>
  <div id="schedule-selection-toolbar" class="hidden flex flex-wrap items-center gap-2 mb-2" role="toolbar" aria-label="Selected schedules or dates">
   <span data-selection-count aria-live="polite"></span>
   <button type="button" class="btn btn-xs" data-calendar-action="skip">Skip selected runs</button>
   <button type="button" class="btn btn-xs" data-calendar-action="restore">Restore selected runs</button>
   <button type="button" class="btn btn-xs" data-calendar-action="pause">Pause schedules until resumed</button>
   <button type="button" class="btn btn-xs" data-calendar-action="resume">Resume schedules</button>
   <button type="button" class="btn btn-xs btn-ghost" data-calendar-action="clear">Clear</button>
   <span data-selection-hint class="opacity-60">Dragging adjusts the recurring schedules.</span>
  </div>
  <div id="schedule-calendar-feedback" class="hidden mb-2" role="status">
   <span data-calendar-message></span>
   <button type="button" class="btn btn-xs btn-ghost" data-calendar-action="undo">Undo</button>
  </div>
 </div>
 <div id="schedule-day-menu" class="ov-menu fixed z-[100] hidden" role="menu" aria-label="Selected date actions">
  <ul class="ov-menu-actions menu">
   <li><button type="button" role="menuitem" data-calendar-action="skip">Skip runs on selected dates</button></li>
   <li><button type="button" role="menuitem" data-calendar-action="restore">Restore runs on selected dates</button></li>
   <li><button type="button" role="menuitem" data-calendar-action="pause">Pause schedules until resumed</button></li>
   <li><button type="button" role="menuitem" data-calendar-action="resume">Resume schedules</button></li>
  </ul>
 </div>
}

templ ScheduleCalendarScript() {
 <script>
 (function() {
  if (window._scheduleCalendarAbort) window._scheduleCalendarAbort.abort();
  var controller = new AbortController();
  window._scheduleCalendarAbort = controller;
  var signal = controller.signal;
  var root = document.getElementById('schedule-content');
  if (!root) return;
  var controls = root.querySelector('#schedule-calendar-controls');
  var state = JSON.parse(controls.dataset.state);
  var skips = state.skips || [];
  var days = Array.from(root.querySelectorAll('[data-calendar-day]'));
  var dates = new Set();
  var anchor = null;
  var busy = false;
  var gesture = null;
  var toolbar = root.querySelector('#schedule-selection-toolbar');
  var dayMenu = root.querySelector('#schedule-day-menu');
  var project = root.dataset.projectId;
  var undo = window._scheduleCalendarUndo;
  if (undo && undo.project !== project) undo = null;
  function cards() { return Array.from(root.querySelectorAll('[data-schedule-card][data-has-schedule="true"]')); }
  function selectedCards() {
   return dates.size ? cards().filter(function(card) { return dates.has(card.closest('.drop-zone').dataset.date); }) : Array.from(selectedScheduleCards).filter(function(card) { return root.contains(card); });
  }
  function selectedIDs() { return Array.from(new Set(selectedCards().map(function(card) { return card.dataset.scheduleId; }))); }
  function interval(card) { return {schedule_id: card.dataset.scheduleId, start_at: Number(card.dataset.occurrenceStart), end_at: Number(card.dataset.occurrenceEnd)}; }
  function selectedIntervals() {
   if (dates.size) return days.filter(function(day) { return dates.has(day.dataset.calendarDay); }).map(function(day) { return {schedule_id: '', start_at: Number(day.dataset.start), end_at: Number(day.dataset.end)}; });
   return selectedCards().map(interval);
  }
  function intersects(a, b) { return a.start_at < b.end_at && b.start_at < a.end_at; }
  function skipped(card) {
   var run = interval(card);
   if (skips.some(function(skip) { return skip.restored && skip.schedule_id === run.schedule_id && skip.start_at <= run.start_at && skip.end_at >= run.end_at; })) return false;
   return skips.some(function(skip) { return !skip.restored && (!skip.schedule_id || skip.schedule_id === run.schedule_id) && intersects(skip, run); });
  }
  cards().forEach(function(card) {
   var paused = state.paused || card.dataset.scheduleEnabled === 'false';
   var excluded = skipped(card);
   card.dataset.calendarMuted = String(paused || excluded);
   card.dataset.skipped = String(excluded);
   if (paused || excluded) {
    card.lastElementChild.textContent = paused ? 'Paused' : 'Skipped';
    card.title = card.dataset.scheduleTitle + (paused ? ' (paused)' : ' (skipped)') + (paused && excluded ? ' · This run is also skipped' : '');
    card.setAttribute('aria-label', card.title);
   }
  });
  days.forEach(function(day) { day.dataset.skipped = String(skips.some(function(skip) { return !skip.restored && !skip.schedule_id && skip.start_at <= Number(day.dataset.start) && skip.end_at >= Number(day.dataset.end); })); });
  root.querySelector('#schedule-pause-banner').classList.toggle('hidden', !state.paused);
  root.querySelector('[data-calendar-action="pause_all"]').classList.toggle('hidden', !!state.paused);
  function feedback(message, inverse) {
   var box = root.querySelector('#schedule-calendar-feedback');
   box.classList.remove('hidden');
   box.querySelector('[data-calendar-message]').textContent = message;
   box.querySelector('[data-calendar-action="undo"]').classList.toggle('hidden', !inverse);
  }
  if (undo) feedback(undo.message, undo.action);
  function paintDates() {
   days.forEach(function(day) { var active = dates.has(day.dataset.calendarDay); day.classList.toggle('schedule-day-selected', active); day.setAttribute('aria-pressed', String(active)); });
   root.querySelectorAll('.drop-zone').forEach(function(zone) { zone.classList.toggle('schedule-day-selected', dates.has(zone.dataset.date)); });
  }
  window.clearScheduleDates = function() { dates.clear(); paintDates(); };
  window.updateScheduleSelection = function() {
   var selected = selectedCards();
   var count = selectedIDs().length;
   var any = dates.size || selected.length;
   toolbar.classList.toggle('hidden', !any);
   var grouped = selected.some(function(card) { return Number(card.dataset.occurrenceEnd) - Number(card.dataset.occurrenceStart) > 1; });
   toolbar.querySelector('[data-selection-count]').textContent = dates.size ? dates.size + ' dates selected · ' + days.filter(function(day) { return dates.has(day.dataset.calendarDay); }).map(function(day) { return day.dataset.calendarDay; }).join(', ') : selected.length + (grouped ? ' run blocks selected' : ' runs selected');
   toolbar.querySelector('[data-selection-hint]').classList.toggle('hidden', !!dates.size);
   root.querySelectorAll('[data-calendar-action="skip"]').forEach(function(button) { button.textContent = dates.size ? 'Skip runs on selected dates' : grouped ? 'Skip runs in selected hour blocks' : 'Skip ' + selected.length + ' selected runs'; button.disabled = busy || !any; });
   root.querySelectorAll('[data-calendar-action="restore"]').forEach(function(button) { button.textContent = dates.size ? 'Restore runs on selected dates' : 'Restore selected runs'; button.disabled = busy || !any; });
   ['pause', 'resume'].forEach(function(action) {
    root.querySelectorAll('[data-calendar-action="' + action + '"]').forEach(function(button) { button.textContent = (action === 'pause' ? 'Pause ' : 'Resume ') + count + (count === 1 ? ' schedule' : ' schedules') + (action === 'pause' ? ' until resumed' : ''); button.disabled = busy || !count; });
   });
   var menu = root.querySelector('#schedule-context-menu');
   if (menu) menu.querySelectorAll('[data-schedule-context-action]').forEach(function(button) { button.hidden = selected.length > 1; });
  };
  window.selectScheduleContextCard = function(card) {
   window.clearScheduleDates();
   if (!selectedScheduleCards.has(card)) { clearScheduleSelection(); selectedScheduleCards.add(card); card.classList.add('schedule-selected'); }
   window.updateScheduleSelection();
  };
  function range(first, last) {
   var a = days.indexOf(first), b = days.indexOf(last);
   dates.clear();
   days.slice(Math.min(a,b), Math.max(a,b)+1).forEach(function(day) { dates.add(day.dataset.calendarDay); });
   paintDates(); window.updateScheduleSelection();
  }
  function selectDay(day, event) {
   clearScheduleSelection();
   if (event.shiftKey && anchor) range(anchor, day);
   else {
    if (!event.metaKey && !event.ctrlKey) dates.clear();
    var key = day.dataset.calendarDay;
    if (dates.has(key)) dates.delete(key); else dates.add(key);
    anchor = day;
    paintDates(); window.updateScheduleSelection();
   }
  }
  function closeMenus() { dayMenu.classList.add('hidden'); root.querySelector('#schedule-context-menu').classList.add('hidden'); }
  async function apply(request, isUndo) {
   if (busy) return;
   busy = true; root.dataset.calendarBusy = 'true'; closeMenus();
   root.querySelectorAll('[data-calendar-action]').forEach(function(button) { button.disabled = true; });
   try {
    var response = await fetch('/schedule/calendar-action?project_id=' + encodeURIComponent(project), {method: 'POST', headers: {'Content-Type':'application/json'}, body: JSON.stringify(request)});
    if (!response.ok) { var error = await response.json().catch(function() { return {}; }); throw new Error(error.message || 'Could not update schedules'); }
    var result = await response.json();
    var inverse = result.undo;
    if (!inverse || !inverse.action || (inverse.action === 'undo_skips' && !(inverse.changes || []).length) || (['skip','restore'].includes(inverse.action) && !(inverse.skips || []).length) || (['pause','resume'].includes(inverse.action) && !(inverse.schedule_ids || []).length)) inverse = null;
    var messages = {skip: 'Selected runs skipped.', restore: 'Selected runs restored. Paused schedules stay paused.', pause: 'Selected schedules paused until resumed.', resume: 'Selected schedules resumed.', pause_all: 'All project schedules paused.', resume_all: 'Project pause removed. Individually paused schedules stay paused.'};
    var message = isUndo ? 'Change undone.' : messages[request.action];
    window._scheduleCalendarUndo = {project: project, action: isUndo ? null : inverse, message: message};
    if (!root.isConnected) return;
    _schedDragDropJustCompleted = true;
    var url = new URL('/schedule', window.location.origin);
    url.searchParams.set('project_id', project);
    url.searchParams.set('week', new URLSearchParams(window.location.search).get('week') || '0');
    await htmx.ajax('GET', url.pathname + url.search, {target: '#schedule-content', swap: 'outerHTML show:none'});
   } catch (error) {
    if (root.isConnected) feedback(error.message, null);
   } finally {
    busy = false; root.dataset.calendarBusy = 'false';
    root.querySelectorAll('[data-calendar-action]').forEach(function(button) { button.disabled = false; });
    if (root.isConnected) window.updateScheduleSelection();
   }
  }
  root.addEventListener('click', function(event) {
   var button = event.target.closest('[data-calendar-action]');
   if (!button || busy) return;
   var action = button.dataset.calendarAction;
   if (action === 'clear') { window.clearScheduleDates(); clearScheduleSelection(); return; }
   if (action === 'undo') { if (undo && undo.action) apply(undo.action, true); return; }
   var request = {action: action};
   if (action === 'pause' || action === 'resume') request.schedule_ids = selectedIDs();
   if (action === 'skip' || action === 'restore') request.skips = selectedIntervals();
   apply(request, false);
  }, {signal: signal});
  root.addEventListener('contextmenu', function(event) {
   var day = event.target.closest('[data-calendar-day]');
   if (!day || busy) return;
   event.preventDefault(); event.stopPropagation();
   if (!dates.has(day.dataset.calendarDay)) selectDay(day, {});
   dayMenu.classList.remove('hidden');
   var rect = dayMenu.getBoundingClientRect();
   dayMenu.style.left = Math.max(8, Math.min(event.clientX, innerWidth-rect.width-8)) + 'px';
   dayMenu.style.top = Math.max(8, Math.min(event.clientY, innerHeight-rect.height-8)) + 'px';
   dayMenu.querySelector('button').focus();
  }, {signal: signal});
  root.addEventListener('keydown', function(event) {
   var day = event.target.closest('[data-calendar-day]');
   if (day && (event.key === ' ' || event.key === 'Enter')) { event.preventDefault(); selectDay(day,event); }
  }, {signal: signal});
  document.addEventListener('keydown', function(event) {
   if (event.key === 'Escape') { cancelGesture(); closeMenus(); window.clearScheduleDates(); clearScheduleSelection(); }
  }, {signal: signal});
  document.addEventListener('pointerdown', function(event) { if (!dayMenu.contains(event.target)) dayMenu.classList.add('hidden'); }, {signal: signal});
  root.addEventListener('pointerdown', function(event) {
   if (busy || event.button !== 0 || event.target.closest('[data-schedule-card]')) return;
   var day = event.target.closest('[data-calendar-day]');
   if (day) {
    selectDay(day, event);
    gesture = {day: day, pointer: event.pointerId};
   } else if (event.pointerType !== 'touch' && event.target.closest('.drop-zone')) {
    window.clearScheduleDates();
    if (!event.metaKey && !event.ctrlKey) clearScheduleSelection();
    gesture = {x: event.clientX, y: event.clientY, pointer: event.pointerId, previous: new Set(selectedScheduleCards)};
   } else return;
   event.preventDefault();
  }, {signal: signal});
  window.addEventListener('pointermove', function(event) {
   if (!gesture || gesture.pointer !== event.pointerId) return;
   if (gesture.day) {
    var hit = document.elementFromPoint(event.clientX,event.clientY);
    var day = hit && hit.closest('[data-calendar-day]');
    if (day && (gesture.moved || day !== gesture.day)) { gesture.moved = true; range(gesture.day,day); }
    return;
   }
   if (!gesture.box && Math.hypot(event.clientX-gesture.x,event.clientY-gesture.y) < 4) return;
   event.preventDefault();
   if (!gesture.box) { gesture.box = document.createElement('div'); gesture.box.className = 'schedule-selection-box'; document.body.appendChild(gesture.box); }
   var left = Math.min(gesture.x,event.clientX), top = Math.min(gesture.y,event.clientY), right = Math.max(gesture.x,event.clientX), bottom = Math.max(gesture.y,event.clientY);
   Object.assign(gesture.box.style,{left:left+'px',top:top+'px',width:(right-left)+'px',height:(bottom-top)+'px'});
   cards().forEach(function(card) {
    var rect = card.getBoundingClientRect();
    var selected = gesture.previous.has(card) || (rect.left < right && rect.right > left && rect.top < bottom && rect.bottom > top);
    if (selected) selectedScheduleCards.add(card); else selectedScheduleCards.delete(card);
    card.classList.toggle('schedule-selected',selected);
   });
   window.updateScheduleSelection();
  }, {signal:signal,passive:false});
  function cancelGesture() { if (gesture && gesture.box) gesture.box.remove(); gesture = null; }
  window.addEventListener('pointerup',cancelGesture,{signal:signal});
  window.addEventListener('pointercancel',cancelGesture,{signal:signal});
  signal.addEventListener('abort',cancelGesture);
  document.body.addEventListener('htmx:beforeCleanupElement', function(event) { if (event.detail && event.detail.elt === root) controller.abort(); }, {signal:signal});
  window.updateScheduleSelection();
 })();
 </script>
}
