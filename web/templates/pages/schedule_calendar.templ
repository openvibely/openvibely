package pages

import (
 "encoding/json"
 "time"
 "github.com/openvibely/openvibely/internal/models"
)

func scheduleCardInterval(occurrence TaskOccurrence) models.ScheduleSkip {
 start := occurrence.OccurrenceTime
 end := start.Add(time.Second)
 if occurrence.Task.Schedule != nil && occurrence.Task.Schedule.RepeatType.IsSubDaily() {
  sameHour := func(t time.Time) bool { return t.Format("2006-01-02-15") == occurrence.OccurrenceTime.Format("2006-01-02-15") }
  start = start.Add(-time.Duration(start.Second())*time.Second - time.Duration(start.Nanosecond()))
  for sameHour(start.Add(-time.Minute)) { start = start.Add(-time.Minute) }
  end = start.Add(time.Minute)
  for sameHour(end) { end = end.Add(time.Minute) }
 }
 return models.ScheduleSkip{ScheduleID: getScheduleID(occurrence.Task), StartAt: start.Unix(), EndAt: end.Unix()}
}

func scheduleOccurrenceStep(occurrence TaskOccurrence) int64 {
 if occurrence.Task.Schedule == nil { return 0 }
 s := occurrence.Task.Schedule
 switch s.RepeatType {
 case models.RepeatSeconds: return int64(s.RepeatInterval)
 case models.RepeatMinutes: return int64(s.RepeatInterval)*60
 case models.RepeatHours: return int64(s.RepeatInterval)*3600
 }
 return 0
}

func scheduleCalendarJSON(states []models.ScheduleCalendarState) string {
 state := models.ScheduleCalendarState{}
 if len(states) > 0 { state = states[0] }
 data, _ := json.Marshal(state)
 return string(data)
}

templ ScheduleCalendarControls(states []models.ScheduleCalendarState) {
 <style>
 #schedule-content { position: relative; }
 #schedule-calendar-viewport { position: relative; display: flex; flex: 1; flex-direction: column; min-height: 0; min-width: 0; }
 #schedule-selection-slot { display: flex; flex: 1; min-width: 0; justify-content: center; align-items: center; }
 #schedule-selection-toolbar { min-width: 0; max-width: 100%; padding: 3px .75rem; border: 1px solid var(--ov-schedule-grid-border); border-radius: .75rem; background: var(--ov-menu-surface); box-shadow: 0 2px 8px rgba(0,0,0,.12); white-space: nowrap; overflow-x: auto; }
 #schedule-selection-toolbar > * { flex-shrink: 0; }
 /* Keep the compact toolbar height stable on systems with non-overlay scrollbars. */
 #schedule-selection-toolbar { scrollbar-width: none; }
 #schedule-selection-toolbar::-webkit-scrollbar { display: none; }
 #schedule-content [data-page-header] #schedule-selection-toolbar button { min-height: 24px; height: 24px; }
 #schedule-selection-toolbar button { border: 1px solid var(--ov-schedule-grid-border); }
 #schedule-selection-toolbar [data-calendar-action="clear"] { border: 0; }
 #schedule-selection-toolbar[aria-hidden="true"] { display: none; }
 #schedule-calendar-feedback { position: absolute; bottom: 2rem; right: 1rem; z-index: 45; padding: .75rem; border-radius: .5rem; background: var(--ov-menu-surface); box-shadow: 0 2px 12px rgba(0,0,0,.2); }
 #schedule-content [hidden] { display: none !important; }
 #schedule-project-menu { position: relative; flex-shrink: 0; }
 /* Avoid font-dependent inline baseline space below the menu button. */
 #schedule-project-menu > summary { display: flex; }
 #schedule-content [data-page-header] { gap: 2rem; align-items: flex-start; }
 #schedule-content [data-page-header] > h2, #schedule-header-actions { flex-shrink: 0; }
 #schedule-header-actions { display: flex; align-items: center; gap: .5rem; margin-left: auto; }
 @media (max-width: 767px) {
  #schedule-content [data-page-header] { gap: .5rem; }
 }
 #schedule-project-menu > .ov-menu { position: absolute; right: 0; z-index: 50; min-width: 12rem; }
 #schedule-content [data-calendar-day] { cursor: pointer; user-select: none; touch-action: pan-y; }
 #schedule-content .schedule-day-selected { background: rgba(116,128,255,.16) !important; }
 #schedule-content [data-calendar-day].schedule-day-selected { box-shadow: inset 0 -2px var(--ov-link-color); }
 #schedule-content [data-calendar-day][data-skipped="true"]::after { content: 'Runs skipped'; display: block; font-size: 10px; opacity: .65; }
 #schedule-content [data-schedule-card][data-calendar-muted="true"] { background: oklch(var(--b3)) !important; border-color: oklch(var(--bc) / .2) !important; opacity: .5; }
 #schedule-content [data-schedule-card][data-calendar-muted="true"] > :first-child { text-decoration: line-through; }
 .schedule-selection-box { position: fixed; pointer-events: none; z-index: 90; border: 1px solid var(--ov-link-color); background: rgba(116,128,255,.15); }
 #schedule-content[data-calendar-busy="true"] #schedule-timeline-container { pointer-events: none; }
 </style>
 <div id="schedule-calendar-controls" data-state={ scheduleCalendarJSON(states) } class="flex-shrink-0 text-xs">
  <div id="schedule-calendar-feedback" class="hidden mb-2" role="status">
   <span data-calendar-message></span>
   <button type="button" class="btn btn-xs btn-ghost" data-calendar-action="undo">Undo</button>
  </div>
 </div>

}

templ ScheduleCalendarScript() {
 <script>
 (function() {
  if (window._scheduleCalendarAbort) window._scheduleCalendarAbort.abort();
  var controller = new AbortController();
  window._scheduleCalendarAbort = controller;
  var signal = controller.signal;
  var root = document.getElementById('schedule-content');
  if (!root) return;
  var controls = root.querySelector('#schedule-calendar-controls');
  var state = JSON.parse(controls.dataset.state);
  var skips = state.skips || [];
  var days = Array.from(root.querySelectorAll('[data-calendar-day]'));
  var dates = new Set();
  var busy = false;
  var gesture = null;
  var toolbar = root.querySelector('#schedule-selection-toolbar');
  var project = root.dataset.projectId;
  var undo = window._scheduleCalendarUndo;
  if (undo && (undo.project !== project || undo.expires <= Date.now())) undo = null;
  function cards() { return Array.from(root.querySelectorAll('[data-schedule-card][data-has-schedule="true"]')); }
  function selectedCards() {
   return dates.size ? cards().filter(function(card) { return dates.has(card.closest('.drop-zone').dataset.date); }) : Array.from(selectedScheduleCards).filter(function(card) { return root.contains(card); });
  }
  function interval(card) { return {schedule_id: card.dataset.scheduleId, start_at: Number(card.dataset.occurrenceStart), end_at: Number(card.dataset.occurrenceEnd)}; }
  function selectedIntervals() {
   if (dates.size) return days.filter(function(day) { return dates.has(day.dataset.calendarDay); }).map(function(day) { return {schedule_id: '', start_at: Number(day.dataset.start), end_at: Number(day.dataset.end)}; });
   return selectedCards().map(interval);
  }
  function intersects(a, b) { return a.start_at < b.end_at && b.start_at < a.end_at; }
  function skipStatus(card) {
   var run = interval(card);
   var relevant = skips.filter(function(skip) { return (!skip.schedule_id || skip.schedule_id === run.schedule_id) && intersects(skip, run); });
   if (!relevant.length) return 'none';
   var first = Number(card.dataset.occurrenceFirst), step = Number(card.dataset.occurrenceStep);
   var excluded = 0, total = 0;
   for (var at = first; at < run.end_at; at += step) {
    total++;
    var restored = relevant.some(function(skip) { return skip.restored && skip.schedule_id === run.schedule_id && skip.start_at <= at && skip.end_at > at; });
    if (!restored && relevant.some(function(skip) { return !skip.restored && skip.start_at <= at && skip.end_at > at; })) excluded++;
    if (!(step > 0)) break;
   }
   return excluded === 0 ? 'none' : excluded === total ? 'full' : 'partial';
  }
  var selectionModifier = /Mac|iPhone|iPad|iPod/.test(navigator.platform) ? 'Command' : 'Ctrl';
  cards().forEach(function(card) {
   var paused = state.paused || card.dataset.scheduleEnabled === 'false';
   var status = skipStatus(card);
   var excluded = status === 'full';
   card.dataset.calendarMuted = String(paused || excluded);
   card.dataset.skipped = String(excluded);
   card.dataset.skipStatus = status;
   if (paused || status !== 'none') {
    var label = paused ? 'Paused' : excluded ? 'Skipped' : 'Partially skipped';
    card.lastElementChild.textContent = label;
    card.title = card.dataset.scheduleTitle + ' (' + label.toLowerCase() + ')' + (paused && status !== 'none' ? ' · This run is also ' + (excluded ? 'skipped' : 'partially skipped') : '');
    card.setAttribute('aria-label', card.title);
   }
   var hint = selectionModifier + '+click to select schedule(s)\nRight-click for actions';
   card.title = hint;
   card.setAttribute('aria-description', hint);
  });
  days.forEach(function(day) { day.title = 'Click to select or deselect a day\n' + selectionModifier + '+click to select day(s)\nClick and drag across header to select days'; });
  days.forEach(function(day) { day.dataset.skipped = String(skips.some(function(skip) { return !skip.restored && !skip.schedule_id && skip.start_at <= Number(day.dataset.start) && skip.end_at >= Number(day.dataset.end); })); });
  root.querySelector('[data-calendar-action="pause_all"]').hidden = !!state.paused;
  root.querySelector('[data-calendar-action="resume_all"]').hidden = !state.paused;
  var feedbackTimer;
  signal.addEventListener('abort', function() { clearTimeout(feedbackTimer); });
  function feedback(message, inverse, expires) {
   var box = root.querySelector('#schedule-calendar-feedback');
   box.classList.remove('hidden');
   box.querySelector('[data-calendar-message]').textContent = message;
   box.querySelector('[data-calendar-action="undo"]').classList.toggle('hidden', !inverse);
   clearTimeout(feedbackTimer);
   feedbackTimer = setTimeout(function() { box.classList.add('hidden'); }, expires === undefined ? 6000 : Math.max(0, expires-Date.now()));
  }
  if (undo) feedback(undo.message, undo.action, undo.expires);
  function paintDates() {
   days.forEach(function(day) { var active = dates.has(day.dataset.calendarDay); day.classList.toggle('schedule-day-selected', active); day.setAttribute('aria-pressed', String(active)); });
   root.querySelectorAll('.drop-zone').forEach(function(zone) { zone.classList.toggle('schedule-day-selected', dates.has(zone.dataset.date)); });
  }
  window.clearScheduleDates = function() { dates.clear(); paintDates(); };
  function eligibleCards(action) {
   return selectedCards().filter(function(card) {
    var paused = card.dataset.scheduleEnabled === 'false';
    if (action === 'pause') return !state.paused && !paused;
    if (action === 'resume') return !state.paused && paused;
    if (action === 'skip') return !state.paused && !paused && card.dataset.skipStatus !== 'full';
    return !state.paused && !paused && card.dataset.skipStatus !== 'none';
   });
  }
  function dateIntervalEligible(run, action) {
   if (action === 'restore') return days.some(function(day) { return Number(day.dataset.start) === run.start_at && day.dataset.skipped === 'true'; }) || selectedCards().some(function(card) { return intersects(interval(card), run) && card.dataset.skipStatus !== 'none'; });
   return !days.some(function(day) { return Number(day.dataset.start) === run.start_at && day.dataset.skipped === 'true'; }) || selectedCards().some(function(card) { return intersects(interval(card), run) && card.dataset.skipStatus !== 'full'; });
  }
  window.updateScheduleSelection = function() {
   var selected = selectedCards();
   var any = dates.size || selected.length;
   var contextMenu = root.querySelector('#schedule-context-menu');
   var showToolbar = any && (!contextMenu || contextMenu.classList.contains('hidden'));
   toolbar.setAttribute('aria-hidden', String(!showToolbar));
   toolbar.inert = !showToolbar;
   toolbar.querySelector('[data-selection-count]').textContent = any + ' selected';
   ['skip','restore','pause','resume'].forEach(function(action) {
    var applicable = dates.size ? (action === 'skip' || action === 'restore') && !state.paused && selectedIntervals().some(function(run) { return dateIntervalEligible(run, action); }) : eligibleCards(action).length > 0;
    var label = {skip:'Skip',restore:'Unskip',pause:'Pause',resume:'Resume'}[action];
    var noun = dates.size ? 'day(s)' : (action === 'skip' || action === 'restore') ? 'run(s)' : 'schedule(s)';
    root.querySelectorAll('[data-calendar-action="' + action + '"]').forEach(function(button) {
     var mixedDates = dates.size && selectedIntervals().some(function(run) { return dateIntervalEligible(run, 'skip'); }) && selectedIntervals().some(function(run) { return dateIntervalEligible(run, 'restore'); });
     button.textContent = mixedDates && action === 'skip' ? 'Skip remaining run(s)' : mixedDates && action === 'restore' ? 'Unskip skipped run(s)' : label + ' ' + noun;
     button.hidden = !applicable;
     if (button.parentElement.tagName === 'LI') button.parentElement.hidden = !applicable;
     button.disabled = busy || !applicable;
    });
   });
   var menu = root.querySelector('#schedule-context-menu');
   if (menu) menu.querySelectorAll('[data-schedule-context-action]').forEach(function(button) { button.hidden = selected.length > 1; button.parentElement.hidden = button.hidden; });
  };
  window.selectScheduleContextCard = function(card) {
   window.clearScheduleDates();
   if (!selectedScheduleCards.has(card)) { clearScheduleSelection(); selectedScheduleCards.add(card); card.classList.add('schedule-selected'); }
   window.updateScheduleSelection();
  };
  function range(first, last) {
   var a = days.indexOf(first), b = days.indexOf(last);
   dates.clear();
   days.slice(Math.min(a,b), Math.max(a,b)+1).forEach(function(day) { dates.add(day.dataset.calendarDay); });
   paintDates(); window.updateScheduleSelection();
  }
  function selectDay(day, event) {
   clearScheduleSelection();
   var key = day.dataset.calendarDay;
   var wasSelected = dates.has(key);
   if (!event.metaKey && !event.ctrlKey) dates.clear();
   if (wasSelected) dates.delete(key); else dates.add(key);
   paintDates(); window.updateScheduleSelection();
  }
  function closeMenus() { root.querySelector('#schedule-project-menu').open = false; root.querySelector('#schedule-context-menu').classList.add('hidden'); }
  async function apply(request, isUndo) {
   if (busy) return;
   busy = true; root.dataset.calendarBusy = 'true'; closeMenus();
   root.querySelectorAll('[data-calendar-action]').forEach(function(button) { button.disabled = true; });
   try {
    var response = await fetch('/schedule/calendar-action?project_id=' + encodeURIComponent(project), {method: 'POST', headers: {'Content-Type':'application/json'}, body: JSON.stringify(request)});
    if (!response.ok) { var error = await response.json().catch(function() { return {}; }); throw new Error(error.message || 'Could not update schedules'); }
    var result = await response.json();
    var inverse = result.undo;
    if (!inverse || !inverse.action || (inverse.action === 'undo_skips' && !(inverse.changes || []).length) || (['skip','restore'].includes(inverse.action) && !(inverse.skips || []).length) || (['pause','resume'].includes(inverse.action) && !(inverse.schedule_ids || []).length)) inverse = null;
    var size = (request.schedule_ids || request.skips || []).length;
    var noun = request.schedule_ids ? 'schedule(s)' : request.skips && request.skips.every(function(skip) { return !skip.schedule_id; }) ? 'day(s)' : 'run(s)';
    var verbs = {skip:'skipped',restore:'unskipped',pause:'paused',resume:'resumed'};
    var message = isUndo ? 'Change undone.' : verbs[request.action] ? size + ' ' + noun + ' ' + verbs[request.action] + '.' : request.action === 'pause_all' ? 'Schedules paused.' : 'Schedules resumed.';
    undo = window._scheduleCalendarUndo = {project: project, action: isUndo ? null : inverse, message: message, expires: Date.now()+6000};
    if (!root.isConnected) return;
    var timeline = root.querySelector('#schedule-timeline-container');
    window._scheduleCalendarScroll = {project: project, week: new URLSearchParams(location.search).get('week') || '0', top: timeline.scrollTop, left: timeline.scrollLeft};
    var url = new URL('/schedule', window.location.origin);
    url.searchParams.set('project_id', project);
    url.searchParams.set('week', new URLSearchParams(window.location.search).get('week') || '0');
    await htmx.ajax('GET', url.pathname + url.search, {target: '#schedule-content', swap: 'outerHTML show:none'});
   } catch (error) {
    if (root.isConnected) feedback(error.message, null);
   } finally {
    if (root.isConnected) delete window._scheduleCalendarScroll;
   busy = false; root.dataset.calendarBusy = 'false';
    root.querySelectorAll('[data-calendar-action]').forEach(function(button) { button.disabled = false; });
    if (root.isConnected) window.updateScheduleSelection();
   }
  }
  root.addEventListener('click', function(event) {
   var button = event.target.closest('[data-calendar-action]');
   if (!button || busy || button.hidden || button.disabled) return;
   var action = button.dataset.calendarAction;
   if (action === 'clear') { window.clearScheduleDates(); clearScheduleSelection(); return; }
   if (action === 'undo') { if (undo && undo.action) apply(undo.action, true); return; }
   var request = {action: action};
   if (action === 'pause' || action === 'resume') request.schedule_ids = Array.from(new Set(eligibleCards(action).map(function(card) { return card.dataset.scheduleId; })));
   if (action === 'skip' || action === 'restore') request.skips = dates.size ? selectedIntervals().filter(function(run) { return dateIntervalEligible(run, action); }) : eligibleCards(action).map(interval);
   apply(request, false);
  }, {signal: signal});
  root.addEventListener('keydown', function(event) {
   var day = event.target.closest('[data-calendar-day]');
   if (day && (event.key === ' ' || event.key === 'Enter')) { event.preventDefault(); selectDay(day,event); }
  }, {signal: signal});
  document.addEventListener('keydown', function(event) {
   if (event.key === 'Escape') { cancelGesture(); closeMenus(); window.clearScheduleDates(); clearScheduleSelection(); }
  }, {signal: signal});
  document.addEventListener('pointerdown', function(event) { var projectMenu = root.querySelector('#schedule-project-menu'); if (!projectMenu.contains(event.target)) projectMenu.open = false; }, {signal: signal});
  root.addEventListener('pointerdown', function(event) {
   if (busy || event.button !== 0 || event.target.closest('[data-schedule-card]')) return;
   var day = event.target.closest('[data-calendar-day]');
   if (day) {
    selectDay(day, event);
    gesture = {day: day, pointer: event.pointerId};
   } else if (event.pointerType !== 'touch' && event.target.closest('.drop-zone')) {
    window.clearScheduleDates();
    if (!event.metaKey && !event.ctrlKey) clearScheduleSelection();
    gesture = {x: event.clientX, y: event.clientY, pointer: event.pointerId, previous: new Set(selectedScheduleCards)};
   } else return;
   event.preventDefault();
  }, {signal: signal});
  window.addEventListener('pointermove', function(event) {
   if (!gesture || gesture.pointer !== event.pointerId) return;
   if (gesture.day) {
    var hit = document.elementFromPoint(event.clientX,event.clientY);
    var day = hit && hit.closest('[data-calendar-day]');
    if (day && (gesture.moved || day !== gesture.day)) { gesture.moved = true; range(gesture.day,day); }
    return;
   }
   if (!gesture.box && Math.hypot(event.clientX-gesture.x,event.clientY-gesture.y) < 4) return;
   event.preventDefault();
   if (!gesture.box) { gesture.box = document.createElement('div'); gesture.box.className = 'schedule-selection-box'; document.body.appendChild(gesture.box); }
   var timeline = root.querySelector('#schedule-timeline-container');
   var bounds = timeline.getBoundingClientRect();
   var header = days[0].parentElement.getBoundingClientRect();
   var firstZone = root.querySelector('.drop-zone').getBoundingClientRect();
   var minX = Math.max(bounds.left+1, firstZone.left), maxX = bounds.right-1;
   var minY = Math.max(bounds.top+1, header.bottom), maxY = bounds.bottom-1;
   var x = Math.max(minX, Math.min(maxX, event.clientX)), y = Math.max(minY, Math.min(maxY, event.clientY));
   var startX = Math.max(minX, Math.min(maxX, gesture.x)), startY = Math.max(minY, Math.min(maxY, gesture.y));
   var left = Math.min(startX,x), top = Math.min(startY,y), right = Math.max(startX,x), bottom = Math.max(startY,y);
   Object.assign(gesture.box.style,{left:left+'px',top:top+'px',width:(right-left)+'px',height:(bottom-top)+'px'});
   cards().forEach(function(card) {
    var rect = card.getBoundingClientRect();
    var selected = gesture.previous.has(card) || (rect.left < right && rect.right > left && rect.top < bottom && rect.bottom > top);
    if (selected) selectedScheduleCards.add(card); else selectedScheduleCards.delete(card);
    card.classList.toggle('schedule-selected',selected);
   });
   window.updateScheduleSelection();
  }, {signal:signal,passive:false});
  function cancelGesture() { if (gesture && gesture.box) gesture.box.remove(); gesture = null; }
  window.addEventListener('pointerup',cancelGesture,{signal:signal});
  window.addEventListener('pointercancel',cancelGesture,{signal:signal});
  signal.addEventListener('abort',cancelGesture);
  document.body.addEventListener('htmx:beforeCleanupElement', function(event) { if (event.detail && event.detail.elt === root) controller.abort(); }, {signal:signal});
  window.updateScheduleSelection();
 })();
 </script>
}

 templ ScheduleSelectionToolbar() {
  <div id="schedule-selection-toolbar" class="flex items-center gap-2 text-xs" aria-hidden="true" role="toolbar" aria-label="Selected schedules or dates">
   <span data-selection-count aria-live="polite"></span>
   <button type="button" class="btn btn-xs" data-calendar-action="skip">Skip run(s)</button>
   <button type="button" class="btn btn-xs" data-calendar-action="restore">Unskip run(s)</button>
   <button type="button" class="btn btn-xs" data-calendar-action="pause">Pause schedule(s)</button>
   <button type="button" class="btn btn-xs" data-calendar-action="resume">Resume schedule(s)</button>
   <button type="button" class="btn btn-xs btn-ghost" data-calendar-action="clear" aria-label="Clear selection" title="Clear selection (Esc)" aria-keyshortcuts="Escape">×</button>
  </div>
}
