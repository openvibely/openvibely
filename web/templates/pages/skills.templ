package pages

import (
	"strings"

	"github.com/openvibely/openvibely/internal/models"
	"github.com/openvibely/openvibely/web/templates/layout"
)

type SkillCard struct {
	Handle    string
	Name      string
	Description string
	Scope     string
	Source    string
	Content   string
	Files     []string
	Archived  bool
	Enabled   bool
	AlwaysUse bool
}

templ Skills(projects []models.Project, currentProjectID string, skills []SkillCard, canManage bool) {
	@layout.Base("Skills", projects, currentProjectID) {
		@skillsContent(skills, canManage, currentProjectID, false, CardListState{ProjectID: currentProjectID})
	}
}

templ SkillsPage(projects []models.Project, currentProjectID string, skills []SkillCard, canManage bool, hasMore bool) {
	@layout.Base("Skills", projects, currentProjectID) {
		@skillsContent(skills, canManage, currentProjectID, hasMore, CardListState{ProjectID: currentProjectID})
	}
}

templ SkillsContent(skills []SkillCard, canManage bool) {
	@skillsContent(skills, canManage, "", false, CardListState{})
}

templ SkillsContentForProject(skills []SkillCard, canManage bool, currentProjectID string) {
	@skillsContent(skills, canManage, currentProjectID, false, CardListState{ProjectID: currentProjectID})
}

templ SkillsContentForProjectPage(skills []SkillCard, canManage bool, currentProjectID string, hasMore bool) {
	@skillsContent(skills, canManage, currentProjectID, hasMore, CardListState{ProjectID: currentProjectID})
}

templ SkillsPageWithState(projects []models.Project, currentProjectID string, skills []SkillCard, canManage bool, hasMore bool, state CardListState) {
	@layout.Base("Skills", projects, currentProjectID) {
		@skillsContent(skills, canManage, currentProjectID, hasMore, state)
	}
}

templ SkillsContentForProjectPageWithState(skills []SkillCard, canManage bool, currentProjectID string, hasMore bool, state CardListState) {
	@skillsContent(skills, canManage, currentProjectID, hasMore, state)
}

func skillSearchText(skill SkillCard) string {
	status := "active"
	if skill.Archived {
		status = "archived"
	}
	enabledStatus := "enabled"
	if !skill.Enabled {
		enabledStatus = "disabled"
	}
	alwaysUseStatus := ""
	if skill.AlwaysUse {
		alwaysUseStatus = "always use"
	}
	return strings.TrimSpace(skill.Handle + " " + skill.Name + " " + skill.Description + " " + skill.Scope + " " + skill.Source + " " + status + " " + enabledStatus + " " + alwaysUseStatus)
}

func defaultSkillBodyTemplate() string {
	return "---\n" +
		"kind: openvibely.agent_skill\n" +
		"version: 1\n" +
		"skill:\n" +
		"    key: openvibely_database_migration_workflow\n" +
		"    name: OpenVibely Database Migration Workflow\n" +
		"    scope: project\n" +
		"    description: Manage OpenVibely goose schema migrations, consolidation, and validation safely.\n" +
		"---\n\nDescribe when to use this skill and the workflow the agent should follow.\n"
}

templ skillsContent(skills []SkillCard, canManage bool, currentProjectID string, hasMore bool, state CardListState) {
		<div id="skills-container" data-search-container data-card-pagination-root data-card-pagination-replacement-managed="true" data-card-pagination-url={ CardListURL("skills", state) } data-card-pagination-list="#skills-card-list" data-card-pagination-card-selector="[data-skill-handle]" data-card-pagination-key="data-skill-handle" data-card-pagination-page-size="20" data-card-pagination-has-more={ cardPaginationHasMoreAttribute(hasMore) }>		@layout.PageTitle("Skills")
		<div class="flex items-center justify-between mb-6">
			<h2 class="text-2xl font-bold">Skills</h2>
			<div class="dropdown dropdown-end">
				<label
					tabindex="0"
					class="btn btn-primary btn-sm"
					onclick="handleDropdownToggle(event)"
					if !canManage {
						disabled
					}
				>
					+ Add Skill
				</label>
				<ul tabindex="0" class="dropdown-content z-[100] menu p-2 shadow bg-base-100 rounded-box w-56 border border-base-300">
					<li>
						<button type="button" onclick="openNewSkillModal()">Create Skill</button>
					</li>
					<li>
						<button type="button" onclick="openImportSkillModal()">Import Skill Package</button>
					</li>
				</ul>
			</div>
		</div>
		@CardListToolbar(collectionToolbarConfigWithSelectionState("skills", state, canManage))
			<div id="skills-card-list" data-card-pagination-list>
			if len(skills) == 0 {
				<div class="text-center py-12" data-search-empty-state>
				<p class="opacity-50 mb-4">No standalone skills found yet.</p>
				<button
					class="btn btn-primary"
					onclick="openNewSkillModal()"
					if !canManage {
						disabled
					}
				>
					Create Skill
				</button>
			</div>
		} else {
			<div class="grid gap-4">
				for _, skill := range skills {
					<div
						class="card bg-base-100 shadow-sm border border-base-300 cursor-pointer hover:border-primary/40 hover:shadow-md transition-all"
						data-skill-handle={ skill.Handle }
						data-skill-name={ skill.Name }
							data-skill-description={ skill.Description }
							data-skill-scope={ skill.Scope }
							data-skill-source={ skill.Source }
							data-skill-enabled={ func() string { if skill.Enabled { return "true" } else { return "false" } }() }
							data-skill-always-use={ func() string { if skill.AlwaysUse { return "true" } else { return "false" } }() }
							data-search-card
							data-skill-scroll-anchor={ skill.Handle }
						data-search-text={ skillSearchText(skill) }
						tabindex="-1"
						if canManage {
							data-card-select-id={ skill.Scope + ":" + skill.Handle }
							data-card-select-ref={ `{"handle":"` + skill.Handle + `","scope":"` + skill.Scope + `"}` }
							data-card-select-eligible="true"
						}
						onclick="editSkillFromData(this)"					>
						<div class="card-body relative">
							<div class="absolute top-4 right-4" onclick="event.stopPropagation()">
								<div class="dropdown dropdown-end">
									<label tabindex="0" class="btn btn-ghost btn-sm" onclick="handleDropdownToggle(event)">
										<svg xmlns="http://www.w3.org/2000/svg" class="h-4 w-4" fill="none" viewBox="0 0 24 24" stroke="currentColor">
											<path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 5v.01M12 12v.01M12 19v.01M12 6a1 1 0 110-2 1 1 0 010 2zm0 7a1 1 0 110-2 1 1 0 010 2zm0 7a1 1 0 110-2 1 1 0 010 2z"></path>
										</svg>
									</label>
									<ul tabindex="0" class="dropdown-content z-[100] menu p-2 shadow bg-base-100 rounded-box w-56 border border-base-300">
										<li>
											<button onclick="editSkillFromData(this.closest('[data-skill-handle]'))">Edit</button>
										</li>
										if skill.Enabled {
											<li>
												<button data-skill-handle={ skill.Handle } data-skill-scope={ skill.Scope } onclick="setSkillEnabled(this, false)">Disable</button>
											</li>
										} else {
											<li>
												<button data-skill-handle={ skill.Handle } data-skill-scope={ skill.Scope } onclick="setSkillEnabled(this, true)">Enable</button>
											</li>
										}
										if skill.AlwaysUse {
											<li>
												<button data-skill-handle={ skill.Handle } data-skill-scope={ skill.Scope } onclick="setSkillAlwaysUse(this, false)">Remove always use</button>
											</li>
										} else {
											<li>
												<button data-skill-handle={ skill.Handle } data-skill-scope={ skill.Scope } onclick="setSkillAlwaysUse(this, true)">Set always use</button>
											</li>
										}
										<li>
											<button class="text-error" data-skill-handle={ skill.Handle } data-skill-name={ firstSkillNonEmpty(skill.Name, skill.Handle) } data-skill-scope={ skill.Scope } onclick="deleteSkill(this)">Delete</button>
										</li>
									</ul>
								</div>
							</div>
							<div class="pr-12">
								<h3 class="font-bold">
									{ firstSkillNonEmpty(skill.Name, skill.Handle) }
								</h3>
								if skill.Description != "" {
									<p class="text-sm opacity-60 mt-1 line-clamp-2">{ skill.Description }</p>
								}
								<div class="flex flex-wrap gap-2 mt-2">
									<span class="badge badge-outline badge-sm">{ skill.Scope }</span>
									if skill.AlwaysUse {
										<span class="badge badge-primary badge-sm">Always use</span>
									}
									if !skill.Enabled {
										<span class="badge badge-warning badge-sm">Disabled</span>
									}
									if skill.Archived {
										<span class="badge badge-outline badge-sm">Archived</span>
									}
								</div>
							</div>
						</div>
					</div>
				}
			</div>
		}
		</div>
			@CardPaginationStatusWithBoundary(hasMore)		@DestructiveConfirmDialog("delete_skill_confirm_modal", "Close delete skill confirmation", "Delete Skill", "Are you sure you want to delete ", "delete_skill_confirm_name", "", "? This action cannot be undone.", templ.ComponentScript{Call: "delete_skill_confirm_modal.close()"}, templ.ComponentScript{Call: "confirmDeleteSkill()"}) {
					The skill package and its indexed registration will be removed from the selected scope.
				}

			<dialog id="skill_modal" class="modal" onclose="if (typeof syncToastContainerHost === 'function') syncToastContainerHost()">			<div class="modal-box">
				@ModalCloseButton("skill_modal", "Close skill dialog")
				<h3 id="skill_modal_title" class="font-bold text-lg mb-4 pr-10">New Skill</h3>
				<form id="skill_form" onsubmit="submitSkillForm(event)">
					<div class="grid grid-cols-1 md:grid-cols-2 gap-3">
						<label class="form-control">
							<span class="label-text mb-1">Skill key</span>
							<input id="skill_handle" class="input input-bordered" required placeholder="review_migrations" oninput="syncNewSkillTemplate()"/>
						</label>
						<label class="form-control">
							<span class="label-text mb-1">Scope</span>
							<select id="skill_scope" class="select select-bordered" onchange="syncNewSkillTemplate()">
								<option value="project">Project</option>
								<option value="global">Global</option>
							</select>
						</label>
					</div>
					<label class="form-control mt-3">
						<span class="label-text mb-1">Name</span>
						<input id="skill_name" class="input input-bordered" placeholder="Review Migrations" oninput="syncNewSkillTemplate()"/>
					</label>
					<label class="form-control mt-3">
						<span class="label-text mb-1">Description</span>
						<input id="skill_description" class="input input-bordered" placeholder="When to use this skill" oninput="syncNewSkillTemplate()"/>
					</label>
						<div class="form-control mt-3">
							<label class="label cursor-pointer justify-start gap-3">
								<input id="skill_enabled" type="checkbox" class="toggle toggle-primary toggle-sm" checked/>
								<span class="label-text">Enabled</span>
							</label>
						</div>
						<div class="form-control mt-1">
							<label class="label cursor-pointer justify-start gap-3">
								<input id="skill_always_use" type="checkbox" class="toggle toggle-secondary toggle-sm"/>
								<span class="label-text">Always use</span>
							</label>
						</div>
						<label class="form-control mt-3">
							<span class="label-text mb-1">Skill body</span>						<textarea id="skill_body" class="textarea textarea-bordered font-mono text-sm min-h-72" required placeholder="Instructions for this skill..." oninput="markSkillTemplateEdited()">{ defaultSkillBodyTemplate() }</textarea>
					</label>
					<div id="skill_files_section" class="hidden mt-3">
						<div class="text-sm font-medium mb-2">Package files</div>
						<div id="skill_files" class="border border-base-300 rounded-lg p-3 bg-base-200/30 text-xs font-mono space-y-1"></div>
					</div>
					<p id="skill_error" class="hidden text-error text-sm mt-3"></p>
					<div class="modal-action">
						<button type="button" class="btn" onclick="skill_modal.close()">Cancel</button>
						<button id="skill_submit_btn" type="submit" class="btn btn-primary">Save</button>
					</div>
				</form>
			</div>
			<form method="dialog" class="modal-backdrop">
				<button>close</button>
			</form>
		</dialog>
		<dialog id="skill_import_modal" class="modal" onclose="if (typeof syncToastContainerHost === 'function') syncToastContainerHost()">
			<div class="modal-box">
				@ModalCloseButton("skill_import_modal", "Close import skill dialog")
				<h3 class="font-bold text-lg mb-4 pr-10">Import Skill Package</h3>
				<form id="skill_import_form" onsubmit="submitSkillImportForm(event)">
					<label class="form-control">
						<span class="label-text mb-1">Scope</span>
						<select id="skill_import_scope" name="scope" class="select select-bordered">
							<option value="project">Project</option>
							<option value="global">Global</option>
						</select>
					</label>
					<label class="form-control mt-3">
						<span class="label-text mb-1">Skill package files</span>
						<input id="skill_import_files" name="files" type="file" class="file-input file-input-bordered" multiple webkitdirectory required/>
						<span class="label-text-alt mt-1 opacity-70">Select a skill package folder containing SKILL.md. Support files under references, templates, scripts, and assets will be imported.</span>
					</label>
					<p id="skill_import_error" class="hidden text-error text-sm mt-3"></p>
					<div class="modal-action">
						<button type="button" class="btn" onclick="skill_import_modal.close()">Cancel</button>
						<button id="skill_import_submit_btn" type="submit" class="btn btn-primary">Import</button>
					</div>
				</form>
			</div>
			<form method="dialog" class="modal-backdrop">
				<button>close</button>
			</form>
		</dialog>
			<script>
					var deleteSkillHandle = '';
					var deleteSkillScope = 'project';
					var skillDetailRequestGeneration = 0;
				function defaultSkillTemplate(handle, name, scope, description) {				handle = (handle || 'openvibely_database_migration_workflow').trim();
				name = (name || 'OpenVibely Database Migration Workflow').trim();
				scope = (scope || 'project').trim();
				description = (description || 'Manage OpenVibely goose schema migrations, consolidation, and validation safely.').trim();
				return '---\n' +
					'kind: openvibely.agent_skill\n' +
					'version: 1\n' +
					'skill:\n' +
					'    key: ' + handle + '\n' +
					'    name: ' + name + '\n' +
					'    scope: ' + scope + '\n' +
					'    description: ' + description + '\n' +
					'---\n\nDescribe when to use this skill and the workflow the agent should follow.\n';
			}

				function currentSkillsProjectQuery() {
					var selector = document.getElementById('project-selector');
					var projectID = selector && selector.value ? selector.value : new URLSearchParams(window.location.search).get('project_id');
					return projectID ? '?project_id=' + encodeURIComponent(projectID) : '';
				}

				function skillsRefreshURL(url) {
					if (typeof window.cardCollectionActionURL === 'function') {
						return window.cardCollectionActionURL(document.getElementById('skills-container'), url);
					}
					if (typeof window.cardPaginationRefreshURL !== 'function') return url;
					return window.cardPaginationRefreshURL(document.getElementById('skills-container'), url);
				}

				function refreshSkillsContainerSearch() {
					if (typeof window.refreshCardSearches === 'function') {
						window.refreshCardSearches(document.getElementById('skills-container'));
					}
				}

				function skillAnchorSelector(handle) {
					var escaped = (window.CSS && CSS.escape) ? CSS.escape(handle) : String(handle || '').split('\\').join('\\\\').split('"').join('\\"');
					return '[data-skill-scroll-anchor="' + escaped + '"]';
				}

				function visibleSkillCards(root) {
					if (!root) return [];
					return Array.prototype.slice.call(root.querySelectorAll('[data-skill-scroll-anchor]')).filter(function(card) {
						return card.getClientRects().length > 0;
					});
				}

				function skillFocusCandidates(cards, activeHandle) {
					var handles = cards.map(function(card) { return card.dataset.skillHandle || ''; }).filter(Boolean);
					var index = handles.indexOf(activeHandle || '');
					if (index < 0) return handles.slice(0, 1);
					var candidates = [activeHandle];
					for (var distance = 1; distance < handles.length; distance++) {
						if (index + distance < handles.length) candidates.push(handles[index + distance]);
						if (index - distance >= 0) candidates.push(handles[index - distance]);
					}
					return candidates;
				}

				function captureSkillsViewportState(root, activeHandle) {
					root = root || document.getElementById('skills-container');
					if (!root) return null;
					var cards = visibleSkillCards(root);
					var viewportTop = 0;
					var viewportBottom = window.innerHeight || document.documentElement.clientHeight || 0;
					var viewportCards = cards.filter(function(card) {
						var rect = card.getBoundingClientRect();
						return rect.bottom > viewportTop && rect.top < viewportBottom;
					});
					var anchors = (viewportCards.length ? viewportCards : cards).map(function(card) {
						return {id: card.dataset.skillHandle || '', top: card.getBoundingClientRect().top};
					}).filter(function(anchor) {
						return anchor.id;
					}).sort(function(a, b) {
						return Math.abs(a.top - viewportTop) - Math.abs(b.top - viewportTop);
					});
					var focusIDs = skillFocusCandidates(cards, activeHandle || '');
					if (activeHandle && focusIDs.length > 1) {
						var prioritized = [];
						for (var j = 1; j < focusIDs.length; j++) {
							var candidate = root.querySelector(skillAnchorSelector(focusIDs[j]));
							if (candidate && candidate.getClientRects().length > 0) {
								prioritized.push({id: focusIDs[j], top: candidate.getBoundingClientRect().top});
							}
						}
						anchors = prioritized.concat(anchors.filter(function(anchor) {
							return focusIDs.indexOf(anchor.id) < 1;
						}));
					}
					return {
						anchors: anchors,
						windowScrollY: window.scrollY || window.pageYOffset || 0,
						focusIDs: focusIDs
					};
				}

				function restoreSkillsViewportState(root, saved) {
					root = root || document.getElementById('skills-container');
					if (!root || !saved) return;
					refreshSkillsContainerSearch();
					var anchor = null;
					var savedAnchor = null;
					for (var i = 0; i < (saved.anchors || []).length; i++) {
						anchor = root.querySelector(skillAnchorSelector(saved.anchors[i].id));
						if (anchor && anchor.getClientRects().length > 0) {
							savedAnchor = saved.anchors[i];
							break;
						}
					}
					if (anchor && savedAnchor) {
						var delta = anchor.getBoundingClientRect().top - savedAnchor.top;
						if (Math.abs(delta) > 1) window.scrollBy(0, delta);
					} else if (Math.abs((window.scrollY || window.pageYOffset || 0) - saved.windowScrollY) > 1) {
						window.scrollTo(0, saved.windowScrollY || 0);
					}
				}

				function focusAfterSkillsSwap(root, saved) {
					if (!root || !saved) return;
					var focusTarget = null;
					for (var i = 0; i < (saved.focusIDs || []).length; i++) {
						var card = root.querySelector(skillAnchorSelector(saved.focusIDs[i]));
						if (card && card.getClientRects().length > 0) {
							focusTarget = card;
							break;
						}
					}
					if (!focusTarget) focusTarget = root.querySelector('[data-card-search]');
					if (focusTarget) focusTarget.focus({preventScroll: true});
				}

				function replaceSkillsContainer(html, options) {
					var container = document.getElementById('skills-container');
					var saved = options && options.preserveScroll === false ? null : captureSkillsViewportState(container, options && options.focusHandle);
					var nextContainer = null;
					if (typeof window.replaceSearchableCardContainer === 'function') {
						nextContainer = window.replaceSearchableCardContainer('#skills-container', html);
					} else if (container) {
						container.outerHTML = html;
						nextContainer = document.getElementById('skills-container');
						if (window.htmx) htmx.process(nextContainer);
						refreshSkillsContainerSearch();
					}
					if (nextContainer && saved) {
						restoreSkillsViewportState(nextContainer, saved);
						focusAfterSkillsSwap(nextContainer, saved);
					}
				}

				(function installSkillsViewportPreservation() {
					var state = window.openVibelySkillsViewport || (window.openVibelySkillsViewport = {});
					if (state.installed) return;
					state.installed = true;

					document.body.addEventListener('htmx:beforeSwap', function(event) {
						var target = event.detail && event.detail.target;
						var root = document.getElementById('skills-container');
						if (!target || target.id !== 'skills-container' || !root) return;
						state.swap = state.preparedSwap || captureSkillsViewportState(root, state.pendingFocusHandle || '');
						state.preparedSwap = null;
						state.pendingFocusHandle = '';
					});

					document.body.addEventListener('htmx:afterSwap', function(event) {
						var target = event.detail && event.detail.target;
						var root = document.getElementById('skills-container');
						var saved = state.swap;
						if (!target || target.id !== 'skills-container' || !root || !saved) return;
						state.swap = null;
						root.openVibelySkillsViewportSwap = saved;
						restoreSkillsViewportState(root, saved);
					});

					document.body.addEventListener('htmx:afterSettle', function(event) {
						var target = event.detail && event.detail.target;
						var root = document.getElementById('skills-container');
						var saved = root && root.openVibelySkillsViewportSwap;
						if (!target || target.id !== 'skills-container' || !root || !saved) return;
						delete root.openVibelySkillsViewportSwap;
						focusAfterSkillsSwap(root, saved);
					});
				})();

				function setSkillModalError(message) {
					var el = document.getElementById('skill_error');
					if (!el) return;
					el.textContent = message || '';
					el.classList.toggle('hidden', !message);
				}

			function setSkillImportError(message) {
				var el = document.getElementById('skill_import_error');
				if (!el) return;
				el.textContent = message || '';
				el.classList.toggle('hidden', !message);
			}

			function renderSkillPackageFiles(filesText) {
				var section = document.getElementById('skill_files_section');
				var list = document.getElementById('skill_files');
				if (!section || !list) return;
				var files = String(filesText || '').split('\n').map(function(file) { return file.trim(); }).filter(Boolean);
				section.classList.toggle('hidden', files.length === 0);
				list.innerHTML = files.length ? files.map(function(file) { return '<div>' + escapeSkillHTML(file) + '</div>'; }).join('') : '';
			}

			function escapeSkillHTML(value) {
				return String(value || '').replace(/[&<>"']/g, function(ch) {
					return {'&':'&amp;','<':'&lt;','>':'&gt;','"':'&quot;',"'":'&#39;'}[ch];
				});
			}

			function markSkillTemplateEdited() {
				var form = document.getElementById('skill_form');
				if (form && form.dataset.mode === 'create') form.dataset.templateEdited = 'true';
			}

			function syncNewSkillTemplate() {
				var form = document.getElementById('skill_form');
				var body = document.getElementById('skill_body');
				if (!form || !body || form.dataset.mode !== 'create' || form.dataset.templateEdited === 'true') return;
				body.value = defaultSkillTemplate(
					document.getElementById('skill_handle').value,
					document.getElementById('skill_name').value,
					document.getElementById('skill_scope').value,
					document.getElementById('skill_description').value
				);
			}

			function openNewSkillModal() {
				skillDetailRequestGeneration++;
				var form = document.getElementById('skill_form');
				form.dataset.mode = 'create';
				form.dataset.originalHandle = '';
				form.dataset.templateEdited = '';
				form.dataset.originalAlwaysUse = 'false';
				document.getElementById('skill_modal_title').textContent = 'New Skill';
				document.getElementById('skill_handle').value = 'openvibely_database_migration_workflow';
				document.getElementById('skill_handle').disabled = false;
				document.getElementById('skill_scope').disabled = false;
				document.getElementById('skill_scope').value = 'project';
				document.getElementById('skill_name').value = 'OpenVibely Database Migration Workflow';
				document.getElementById('skill_description').value = 'Manage OpenVibely goose schema migrations, consolidation, and validation safely.';
				document.getElementById('skill_body').disabled = false;
				document.getElementById('skill_body').value = defaultSkillTemplate('', '', '', '');
				document.getElementById('skill_enabled').checked = true;
				document.getElementById('skill_always_use').checked = false;
				document.getElementById('skill_submit_btn').disabled = false;
				renderSkillPackageFiles('');
				setSkillModalError('');
				skill_modal.showModal();
			}

			function openImportSkillModal() {
				var form = document.getElementById('skill_import_form');
				if (form) form.reset();
				document.getElementById('skill_import_scope').value = 'project';
				setSkillImportError('');
				skill_import_modal.showModal();
			}

			function editSkillFromData(card) {
				if (!card) return;
				var form = document.getElementById('skill_form');
				var handle = card.dataset.skillHandle || '';
				var scope = card.dataset.skillScope || 'project';
				var requestGeneration = ++skillDetailRequestGeneration;
				form.dataset.mode = 'edit';
				form.dataset.originalHandle = handle;
				form.dataset.templateEdited = 'true';
				var alwaysUse = card.dataset.skillAlwaysUse === 'true';
				form.dataset.originalAlwaysUse = alwaysUse ? 'true' : 'false';
				document.getElementById('skill_modal_title').textContent = 'Edit Skill';
				document.getElementById('skill_handle').value = handle;
				document.getElementById('skill_handle').disabled = true;
				document.getElementById('skill_scope').value = scope;
				document.getElementById('skill_scope').disabled = true;
				document.getElementById('skill_name').value = card.dataset.skillName || '';
				document.getElementById('skill_description').value = card.dataset.skillDescription || '';
				document.getElementById('skill_body').disabled = true;
				document.getElementById('skill_body').value = 'Loading skill body...';
				document.getElementById('skill_enabled').checked = card.dataset.skillEnabled !== 'false';
				document.getElementById('skill_always_use').checked = alwaysUse;
				document.getElementById('skill_submit_btn').disabled = true;
				renderSkillPackageFiles('');
				setSkillModalError('');
				skill_modal.showModal();
				fetch('/skills/' + encodeURIComponent(handle) + '/details?scope=' + encodeURIComponent(scope) + currentSkillsProjectQuery().replace(/^\?/, '&'), {
					method: 'GET',
					headers: {'Accept': 'application/json'}
				}).then(function(resp) {
					if (!resp.ok) {
						return resp.text().then(function(text) { throw new Error(text || 'Failed to load skill details.'); });
					}
					return resp.json();
				}).then(function(detail) {
					if (requestGeneration !== skillDetailRequestGeneration || form.dataset.mode !== 'edit' || form.dataset.originalHandle !== handle || document.getElementById('skill_scope').value !== scope) return;
					document.getElementById('skill_handle').value = detail.handle || handle;
					document.getElementById('skill_name').value = detail.name || '';
					document.getElementById('skill_description').value = detail.description || '';
					document.getElementById('skill_body').value = detail.content || '';
					document.getElementById('skill_body').disabled = false;
					document.getElementById('skill_enabled').checked = detail.enabled !== false;
					document.getElementById('skill_always_use').checked = detail.always_use === true;
					form.dataset.originalAlwaysUse = detail.always_use === true ? 'true' : 'false';
					renderSkillPackageFiles((detail.files || []).join('\n'));
					document.getElementById('skill_submit_btn').disabled = false;
				}).catch(function(err) {
					if (requestGeneration !== skillDetailRequestGeneration || form.dataset.mode !== 'edit' || form.dataset.originalHandle !== handle) return;
					document.getElementById('skill_body').value = '';
					setSkillModalError(err.message || 'Failed to load skill details.');
				});
			}

				function deleteSkill(button) {
					deleteSkillHandle = button.dataset.skillHandle || '';
					deleteSkillScope = button.dataset.skillScope || 'project';
					if (!deleteSkillHandle) return;
						window.openDestructiveConfirmDialog('delete_skill_confirm_modal', 'delete_skill_confirm_name', button.dataset.skillName || deleteSkillHandle);
				}

				function confirmDeleteSkill() {
					if (!deleteSkillHandle) return;
					var state = window.openVibelySkillsViewport || (window.openVibelySkillsViewport = {});
					state.pendingFocusHandle = deleteSkillHandle;
					state.preparedSwap = captureSkillsViewportState(document.getElementById('skills-container'), deleteSkillHandle);
					var modal = document.getElementById('delete_skill_confirm_modal');
					if (modal) {
						if (document.activeElement && modal.contains(document.activeElement)) document.activeElement.blur();
						modal.close();
					}
					htmx.ajax('DELETE', skillsRefreshURL('/skills/' + encodeURIComponent(deleteSkillHandle) + '?target_scope=' + encodeURIComponent(deleteSkillScope) + currentSkillsProjectQuery().replace(/^\?/, '&')), {
						target: '#skills-container',
						swap: 'outerHTML show:none'
					}).catch(function(xhr) {
						state.preparedSwap = null;
						state.pendingFocusHandle = '';
						alert((xhr && xhr.responseText) || 'Failed to delete skill.');
					});
				}

			function setSkillEnabled(button, enable) {
				var handle = button.dataset.skillHandle || '';
				var scope = button.dataset.skillScope || 'project';
				if (!handle) return;
				var action = enable ? 'Enable' : 'Disable';
				if (!confirm(action + ' skill "' + handle + '"?')) return;
				fetch(skillsRefreshURL('/skills/' + encodeURIComponent(handle) + '/enabled' + currentSkillsProjectQuery()), {
					method: 'POST',
					headers: {'Content-Type': 'application/json', 'HX-Request': 'true'},
					body: JSON.stringify({enabled: enable, scope: scope})
				}).then(function(resp) {
					if (!resp.ok) {
						return resp.text().then(function(text) { throw new Error(text || 'Failed to ' + action.toLowerCase() + ' skill.'); });
					}
					return resp.text();
				}).then(function(html) {
					replaceSkillsContainer(html);
				}).catch(function(err) {
					alert(err.message || 'Failed to ' + action.toLowerCase() + ' skill.');
				});
			}

			function setSkillAlwaysUse(button, alwaysUse) {
				var handle = button.dataset.skillHandle || '';
				var scope = button.dataset.skillScope || 'project';
				if (!handle) return;
				var action = alwaysUse ? 'Set always use for' : 'Remove always use from';
				if (!confirm(action + ' skill "' + handle + '"?')) return;
				fetch(skillsRefreshURL('/skills/' + encodeURIComponent(handle) + '/always_use' + currentSkillsProjectQuery()), {
					method: 'POST',
					headers: {'Content-Type': 'application/json', 'HX-Request': 'true'},
					body: JSON.stringify({always_use: alwaysUse, scope: scope})
				}).then(function(resp) {
					if (!resp.ok) {
						return resp.text().then(function(text) { throw new Error(text || 'Failed to update always use setting.'); });
					}
					return resp.text();
				}).then(function(html) {
					replaceSkillsContainer(html);
				}).catch(function(err) {
					alert(err.message || 'Failed to update always use setting.');
				});
			}

			function submitSkillImportForm(event) {
				event.preventDefault();
				var submit = document.getElementById('skill_import_submit_btn');
				var input = document.getElementById('skill_import_files');
				var data = new FormData();
				data.append('scope', document.getElementById('skill_import_scope').value || 'project');
				Array.from((input && input.files) || []).forEach(function(file) {
					data.append('files', file, file.name);
					data.append('paths', file.webkitRelativePath || file.name);
				});
				submit.disabled = true;
				submit.textContent = 'Importing...';
				setSkillImportError('');
				fetch(skillsRefreshURL('/skills/import' + currentSkillsProjectQuery()), {
					method: 'POST',
					headers: {'HX-Request': 'true'},
					body: data
				}).then(function(resp) {
					if (!resp.ok) {
						return resp.text().then(function(text) { throw new Error(text || 'Failed to import skill package.'); });
					}
					return resp.text();
				}).then(function(html) {
					replaceSkillsContainer(html);
					var modal = document.getElementById('skill_import_modal');
					if (modal && modal.open) modal.close();
				}).catch(function(err) {
					setSkillImportError(err.message || 'Failed to import skill package.');
				}).finally(function() {
					var nextSubmit = document.getElementById('skill_import_submit_btn');
					if (nextSubmit) {
						nextSubmit.disabled = false;
						nextSubmit.textContent = 'Import';
					}
				});
			}

			function submitSkillForm(event) {
				event.preventDefault();
				var form = document.getElementById('skill_form');
				var handle = document.getElementById('skill_handle').value.trim();
				var payload = {
					handle: handle,
					scope: document.getElementById('skill_scope').value,
					name: document.getElementById('skill_name').value.trim(),
					description: document.getElementById('skill_description').value.trim(),
					body: document.getElementById('skill_body').value,
					enabled: document.getElementById('skill_enabled').checked
				};
				var mode = form.dataset.mode || 'create';
				var originalHandle = form.dataset.originalHandle || handle;
				var url = '/skills';
				var method = 'POST';
				if (mode === 'edit') {
					url = '/skills/' + encodeURIComponent(originalHandle);
					method = 'PUT';
				}
				var submit = document.getElementById('skill_submit_btn');
				submit.disabled = true;
				submit.textContent = 'Saving...';
				setSkillModalError('');
				fetch(skillsRefreshURL(url + currentSkillsProjectQuery()), {
					method: method,
					headers: {'Content-Type': 'application/json', 'HX-Request': 'true'},
					body: JSON.stringify(payload)
				}).then(function(resp) {
					if (!resp.ok) {
						return resp.text().then(function(text) { throw new Error(text || 'Failed to save skill.'); });
					}
					return resp.text();
				}).then(function(html) {
					var alwaysUse = document.getElementById('skill_always_use').checked;
					var originalAlwaysUse = form.dataset.originalAlwaysUse === 'true';
					if (alwaysUse === originalAlwaysUse) return html;
					var auHandle = form.dataset.originalHandle || handle;
					var auScope = document.getElementById('skill_scope').value;
					return fetch(skillsRefreshURL('/skills/' + encodeURIComponent(auHandle) + '/always_use' + currentSkillsProjectQuery()), {
						method: 'POST',
						headers: {'Content-Type': 'application/json', 'HX-Request': 'true'},
						body: JSON.stringify({always_use: alwaysUse, scope: auScope})
					}).then(function(resp2) {
						if (!resp2.ok) {
							return resp2.text().then(function(t) { throw new Error(t || 'Saved but failed to update always use setting.'); });
						}
						return resp2.text();
					});
				}).then(function(html) {
					replaceSkillsContainer(html);
					var modal = document.getElementById('skill_modal');
					if (modal && modal.open) modal.close();
				}).catch(function(err) {
					setSkillModalError(err.message || 'Failed to save skill.');
				}).finally(function() {
					var nextSubmit = document.getElementById('skill_submit_btn');
					if (nextSubmit) {
						nextSubmit.disabled = false;
						nextSubmit.textContent = 'Save';
					}
				});
			}
		</script>
	</div>
}

func firstSkillNonEmpty(values ...string) string {
	for _, value := range values {
		if strings.TrimSpace(value) != "" {
			return strings.TrimSpace(value)
		}
	}
	return ""
}
