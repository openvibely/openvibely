package pages

import (
	"sort"
	"strings"

	"github.com/openvibely/openvibely/internal/models"
	"github.com/openvibely/openvibely/internal/service"
	"github.com/openvibely/openvibely/web/templates/layout"
)

templ AppSettingsPage(personality string, projects []models.Project, currentProjectID string, customPersonalities []models.CustomPersonality) {
	@layout.Base("Personality", projects, currentProjectID) {
		@appSettingsContent(personality, currentProjectID, customPersonalities, false, PersonalityListState{})
	}
}

// AppSettingsPageWithPagination renders the initial Personality page with the
// server's custom-card boundary.
templ AppSettingsPageWithPagination(personality string, projects []models.Project, currentProjectID string, customPersonalities []models.CustomPersonality, hasMore bool) {
	@layout.Base("Personality", projects, currentProjectID) {
		@appSettingsContent(personality, currentProjectID, customPersonalities, hasMore, PersonalityListState{})
	}
}

templ AppSettingsPageWithPaginationState(personality string, projects []models.Project, currentProjectID string, cards []PersonalityListCard, hasMore bool, state PersonalityListState) {
	@layout.Base("Personality", projects, currentProjectID) {
		@appSettingsCardsContent(personality, currentProjectID, cards, hasMore, state)
	}
}

// AppSettingsContent renders just the settings content for HTMX requests
templ AppSettingsContent(personality string, currentProjectID string, customPersonalities []models.CustomPersonality) {
	@appSettingsContent(personality, currentProjectID, customPersonalities, false, PersonalityListState{})
}

// AppSettingsContentWithPagination renders bounded Personality content with its
// server-provided custom-card boundary.
templ AppSettingsContentWithPagination(personality string, currentProjectID string, customPersonalities []models.CustomPersonality, hasMore bool) {
	@appSettingsContent(personality, currentProjectID, customPersonalities, hasMore, PersonalityListState{})
}

templ AppSettingsContentWithPaginationState(personality string, currentProjectID string, cards []PersonalityListCard, hasMore bool, state PersonalityListState) {
	@appSettingsCardsContent(personality, currentProjectID, cards, hasMore, state)
}

templ appSettingsContent(personality string, currentProjectID string, customPersonalities []models.CustomPersonality, hasMore bool, state PersonalityListState) {
	@appSettingsCardsContent(personality, currentProjectID, BuildPersonalityListCards(personality, customPersonalities, state), hasMore, state)
}

templ appSettingsCardsContent(personality string, currentProjectID string, cards []PersonalityListCard, hasMore bool, state PersonalityListState) {
	<div id="personality-container">
		@layout.PageTitle("Personality")
		@personalitySection(personality, cards, hasMore, state)
	</div>
}

func presetByKey(key string) (service.PersonalityInfo, bool) {
	for _, p := range service.AllPersonalities() {
		if p.Key == key {
			return p, true
		}
	}
	return service.PersonalityInfo{}, false
}

func customByKey(customPersonalities []models.CustomPersonality, key string) (models.CustomPersonality, bool) {
	for _, cp := range customPersonalities {
		if cp.Key == key {
			return cp, true
		}
	}
	return models.CustomPersonality{}, false
}

func nonPresetCustoms(customPersonalities []models.CustomPersonality) []models.CustomPersonality {
	filtered := make([]models.CustomPersonality, 0, len(customPersonalities))
	for _, cp := range customPersonalities {
		if !service.IsPresetPersonality(cp.Key) {
			filtered = append(filtered, cp)
		}
	}
	return filtered
}

func personalityHasCustomEntry(key string, customPersonalities []models.CustomPersonality) bool {
	_, ok := customByKey(customPersonalities, key)
	return ok
}

type PersonalityListState struct {
	ProjectID string
	Search    string
	Kind   string
	Active string
	Sort   string
}

type PersonalityListCard struct {
	Key         string
	Name        string
	Description string
	Preview     string
	Kind        string
	Preset      *service.PersonalityInfo
	Custom      *models.CustomPersonality
	Base        bool
	HasCustom   bool
	IsActive    bool
}

func BuildPersonalityListCards(personality string, customPersonalities []models.CustomPersonality, state PersonalityListState) []PersonalityListCard {
	cards := []PersonalityListCard{{Key: "", Name: "Base", Description: "No personality prompt applied", Kind: "base", Base: true, IsActive: personality == ""}}
	for _, value := range service.AllPersonalities() {
		if value.Key == "" {
			continue
		}
		preset := value
		custom, hasCustom := customByKey(customPersonalities, preset.Key)
		kind := "built_in"
		name, description, preview := preset.Name, preset.Description, truncatePrompt(service.GetPersonalityPrompt(preset.Key), 150)
		if hasCustom {
			kind, name, description, preview = "override", custom.Name, custom.Description, custom.SystemPromptPreview
		}
		cards = append(cards, PersonalityListCard{Key: preset.Key, Name: name, Description: description, Preview: preview, Kind: kind, Preset: &preset, Custom: func() *models.CustomPersonality { if hasCustom { return &custom }; return nil }(), HasCustom: hasCustom, IsActive: personality == preset.Key})
	}
	for i := range customPersonalities {
		if service.IsPresetPersonality(customPersonalities[i].Key) {
			continue
		}
		custom := customPersonalities[i]
		cards = append(cards, PersonalityListCard{Key: custom.Key, Name: custom.Name, Description: custom.Description, Preview: custom.SystemPromptPreview, Kind: "custom", Custom: &custom, IsActive: personality == custom.Key})
	}
	search := strings.ToLower(strings.TrimSpace(state.Search))
	filtered := cards[:0]
	for _, card := range cards {
		if state.Kind != "" && state.Kind != card.Kind {
			continue
		}
		if state.Active == "true" && !card.IsActive || state.Active == "false" && card.IsActive {
			continue
		}
		if search != "" && !strings.Contains(strings.ToLower(card.Name+" "+card.Description+" "+card.Preview), search) {
			continue
		}
		filtered = append(filtered, card)
	}
	sort.SliceStable(filtered, func(i, j int) bool {
		if state.Sort == "name_asc" || state.Sort == "name_desc" {
			left, right := strings.ToLower(filtered[i].Name), strings.ToLower(filtered[j].Name)
			if left == right {
				left, right = filtered[i].Key, filtered[j].Key
			}
			if state.Sort == "name_desc" {
				return left > right
			}
			return left < right
		}
		rank := func(card PersonalityListCard) int {
			if card.IsActive {
				return 0
			}
			if card.Base {
				return 1
			}
			if card.Preset != nil {
				return 2
			}
			return 3
		}
		left, right := rank(filtered[i]), rank(filtered[j])
		if left != right {
			return left < right
		}
		return filtered[i].Key < filtered[j].Key
	})
	return filtered
}

func personalityToolbarConfig(state PersonalityListState) CardListToolbarConfig {
	config := collectionToolbarConfigWithState("personality", CardListState{
		ProjectID: state.ProjectID,
		Search: state.Search,
		Sort: state.Sort,
		Filters: map[string]string{"kind": state.Kind, "active": state.Active},
	})
	if config.Sort == "" { config.Sort = "curated" }
	return config
}

func personalityNameForKey(key string, customPersonalities []models.CustomPersonality) string {
	if cp, ok := customByKey(customPersonalities, key); ok {
		return cp.Name
	}
	if preset, ok := presetByKey(key); ok {
		return preset.Name
	}
	if key == "" {
		return "Base"
	}
	return key
}

func personalityDescriptionForKey(key string, customPersonalities []models.CustomPersonality) string {
	if cp, ok := customByKey(customPersonalities, key); ok {
		return cp.Description
	}
	if preset, ok := presetByKey(key); ok {
		return preset.Description
	}
	return ""
}

func personalityPromptPreviewForKey(key string, customPersonalities []models.CustomPersonality) string {
	if cp, ok := customByKey(customPersonalities, key); ok {
		return cp.SystemPromptPreview
	}
	return truncatePrompt(service.GetPersonalityPrompt(key), 150)
}

func boolString(v bool) string {
	if v {
		return "true"
	}
	return "false"
}

templ builtInPersonalityCard(card PersonalityListCard, personality string) {
	<div
		class="card bg-base-100 shadow-sm border border-base-300 cursor-pointer hover:border-primary/40 hover:shadow-md transition-all"
		data-personality-key={ card.Key }
		data-personality-name={ card.Name }
		data-personality-description={ card.Description }
		data-personality-preview={ card.Preview }
		data-personality-is-preset="true"
		data-personality-pagination-card="true"
		data-personality-has-custom={ boolString(card.HasCustom) }
		data-search-card
		data-search-text={ card.Name + " " + card.Description + " " + card.Preview }
		onclick="editPersonalityFromData(this)"
	>
		<div class="card-body relative">
			<div class="absolute top-4 right-4" onclick="event.stopPropagation()">
				<div class="dropdown dropdown-end">
					<label tabindex="0" class="btn btn-ghost btn-sm" onclick="handleDropdownToggle(event)">
						<svg xmlns="http://www.w3.org/2000/svg" class="h-4 w-4" fill="none" viewBox="0 0 24 24" stroke="currentColor">
							<path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 5v.01M12 12v.01M12 19v.01M12 6a1 1 0 110-2 1 1 0 010 2zm0 7a1 1 0 110-2 1 1 0 010 2zm0 7a1 1 0 110-2 1 1 0 010 2z"></path>
						</svg>
					</label>
					<ul tabindex="0" class="dropdown-content z-[100] menu p-2 shadow bg-base-100 rounded-box w-48 border border-base-300">
						<li>
							<button onclick="editPersonalityFromData(this.closest('[data-personality-key]'))">Edit</button>
						</li>
						if personality != card.Key {
							<li>
								<button
									hx-post={ "/personality/save?personality=" + card.Key }
									hx-target="#personality-section"
									hx-swap="outerHTML"
								>
									Set as Default
								</button>
							</li>
						}
					</ul>
				</div>
			</div>
			<div class="pr-12">
				<h3 class="font-bold">
					{ card.Name }
					if personality == card.Key {
						<span class="badge badge-sm ml-2 ov-badge-default">Active</span>
					}
					if card.HasCustom {
						<span class="badge badge-warning badge-sm ml-1">Override</span>
					}
				</h3>
				<p class="text-sm opacity-60 mt-1">{ card.Description }</p>
				<p class="text-sm opacity-40 mt-1 line-clamp-2">{ card.Preview }</p>
			</div>
		</div>
	</div>
}

func personalitySelectionDisabledReason(cp models.CustomPersonality, personality string) string {
	if personality == cp.Key {
		return "The active personality cannot be deleted"
	}
	if service.IsPresetPersonality(cp.Key) {
		return "Built-in personality overrides cannot be bulk deleted"
	}
	return ""
}

templ customPersonalityCard(cp models.CustomPersonality, personality string, paginationCard bool) {
	<div
		class="card bg-base-100 shadow-sm border border-base-300 cursor-pointer hover:border-primary/40 hover:shadow-md transition-all"
		data-personality-key={ cp.Key }
		data-personality-name={ cp.Name }
		data-personality-description={ cp.Description }
		data-personality-preview={ cp.SystemPromptPreview }
		data-personality-is-preset="false"
		data-personality-pagination-card={ cardPaginationHasMoreAttribute(paginationCard) }
		data-personality-has-custom="true"
		data-card-select-id={ cp.Key }
		data-card-select-eligible={ boolString(personality != cp.Key && !service.IsPresetPersonality(cp.Key)) }
		data-card-select-disabled-reason={ personalitySelectionDisabledReason(cp, personality) }
		data-search-card
		data-search-text={ cp.Name + " " + cp.Description + " " + cp.SystemPromptPreview }
		onclick="editPersonalityFromData(this)"
	>
		<div class="card-body relative">
			<div class="absolute top-4 right-4" onclick="event.stopPropagation()">
				<div class="dropdown dropdown-end">
					<label tabindex="0" class="btn btn-ghost btn-sm" onclick="handleDropdownToggle(event)">
						<svg xmlns="http://www.w3.org/2000/svg" class="h-4 w-4" fill="none" viewBox="0 0 24 24" stroke="currentColor">
							<path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 5v.01M12 12v.01M12 19v.01M12 6a1 1 0 110-2 1 1 0 010 2zm0 7a1 1 0 110-2 1 1 0 010 2zm0 7a1 1 0 110-2 1 1 0 010 2z"></path>
						</svg>
					</label>
					<ul tabindex="0" class="dropdown-content z-[100] menu p-2 shadow bg-base-100 rounded-box w-48 border border-base-300">
						<li>
							<button onclick="editPersonalityFromData(this.closest('[data-personality-key]'))">Edit</button>
						</li>
						if personality != cp.Key {
							<li>
								<button
									hx-post={ "/personality/save?personality=" + cp.Key }
									hx-target="#personality-section"
									hx-swap="outerHTML"
								>
									Set as Default
								</button>
							</li>
						}
						<li>
							<button
								class="text-error"
								hx-delete={ "/personality/custom/" + cp.Key }
								hx-target="#personality-section"
								hx-swap="outerHTML"
								hx-confirm="Delete this custom personality?"
							>
								Delete
							</button>
						</li>
					</ul>
				</div>
			</div>
			<div class="pr-12">
				<h3 class="font-bold">
					{ cp.Name }
					if personality == cp.Key {
						<span class="badge badge-sm ml-2 ov-badge-default">Active</span>
					}
					<span class="badge badge-ghost badge-sm ml-1">Custom</span>
				</h3>
				if cp.Description != "" {
					<p class="text-sm opacity-60 mt-1">{ cp.Description }</p>
				}
				<p class="text-sm opacity-40 mt-1 line-clamp-2">{ cp.SystemPromptPreview }</p>
			</div>
		</div>
	</div>
}

// PersonalitySection renders the personality card list with create/edit modal.
templ PersonalitySection(personality string, customPersonalities []models.CustomPersonality) {
	@personalitySection(personality, BuildPersonalityListCards(personality, customPersonalities, PersonalityListState{}), false, PersonalityListState{})
}

// PersonalitySectionPage renders a paged Personality fragment while retaining the existing card contract.
templ PersonalitySectionPage(personality string, customPersonalities []models.CustomPersonality) {
	@personalitySection(personality, BuildPersonalityListCards(personality, customPersonalities, PersonalityListState{}), false, PersonalityListState{})
}

// PersonalitySectionWithPagination includes the authoritative custom-card page
// boundary for full pages and live HTMX replacements.
templ PersonalitySectionWithPagination(personality string, customPersonalities []models.CustomPersonality, hasMore bool) {
	@personalitySection(personality, BuildPersonalityListCards(personality, customPersonalities, PersonalityListState{}), hasMore, PersonalityListState{})
}

// PersonalitySectionPageWithPagination renders a bounded Personality fragment
// with its server-provided custom-card boundary.
templ PersonalitySectionPageWithPagination(personality string, customPersonalities []models.CustomPersonality, hasMore bool) {
	@personalitySection(personality, BuildPersonalityListCards(personality, customPersonalities, PersonalityListState{}), hasMore, PersonalityListState{})
}

// PersonalitySectionPageWithPaginationState renders an already filtered, sorted, and paged Personality collection.
templ PersonalitySectionPageWithPaginationState(personality string, cards []PersonalityListCard, hasMore bool, state PersonalityListState) {
	@personalitySection(personality, cards, hasMore, state)
}

templ personalitySection(personality string, cards []PersonalityListCard, hasMore bool, state PersonalityListState) {
		<div id="personality-section" data-selected-personality={ personality } data-search-container data-card-pagination-root data-card-pagination-url={ CardListURL("personality", CardListState{ProjectID: state.ProjectID, Search: state.Search, Sort: state.Sort, Filters: map[string]string{"kind": state.Kind, "active": state.Active}}) } data-card-pagination-list="#personality-card-list" data-card-pagination-card-selector="[data-personality-pagination-card='true']" data-card-pagination-replacement-card-selector="[data-personality-key]" data-card-pagination-key="data-personality-key" data-card-pagination-page-size="20" data-card-pagination-has-more={ cardPaginationHasMoreAttribute(hasMore) }>		<div class="flex items-center justify-between mb-6">
			<h2 class="text-2xl font-bold">Personality</h2>
			<button class="btn btn-primary btn-sm" onclick="openNewPersonalityModal()">
				+ Add Personality
			</button>
		</div>
			@CardListToolbar(personalityToolbarConfig(state))
			<div id="personality-card-list" data-card-pagination-list>
			<div class="grid gap-4">
				for _, card := range cards {
					if card.Preset != nil {
						@builtInPersonalityCard(card, personality)
					} else if card.Custom != nil {
						@customPersonalityCard(*card.Custom, personality, true)
					} else {
						<!-- Base (No Personality) card — non-clickable -->			<div
				class="card bg-base-100 shadow-sm border border-base-300"
				data-personality-key=""
				data-personality-name="Base"
				data-personality-description=""
				data-personality-is-preset="true"
				data-personality-pagination-card="true"
				data-personality-has-custom="false"
				data-personality-is-default-card="true"
				data-search-card
				data-search-text="Base No personality prompt applied"
			>
				<div class="card-body relative">
					if personality != "" {
						<div class="absolute top-4 right-4" onclick="event.stopPropagation()">
							<div class="dropdown dropdown-end">
								<label tabindex="0" class="btn btn-ghost btn-sm" onclick="handleDropdownToggle(event)">
									<svg xmlns="http://www.w3.org/2000/svg" class="h-4 w-4" fill="none" viewBox="0 0 24 24" stroke="currentColor">
										<path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 5v.01M12 12v.01M12 19v.01M12 6a1 1 0 110-2 1 1 0 010 2zm0 7a1 1 0 110-2 1 1 0 010 2zm0 7a1 1 0 110-2 1 1 0 010 2z"></path>
									</svg>
								</label>
								<ul tabindex="0" class="dropdown-content z-[100] menu p-2 shadow bg-base-100 rounded-box w-48 border border-base-300">
									<li>
										<button
											hx-post="/personality/save?personality="
											hx-target="#personality-section"
											hx-swap="outerHTML"
										>
											Set as Default
										</button>
									</li>
								</ul>
							</div>
						</div>
					}
					<div class="pr-12">
						<h3 class="font-bold">
							Base
							if personality == "" {
								<span class="badge badge-sm ml-2 ov-badge-default">Default</span>
							}
						</h3>
						<p class="text-sm opacity-50 mt-1 italic">No personality prompt applied.</p>
					</div>
				</div>
						</div>
					}
				}
			</div>		</div>
		@CardPaginationStatusWithBoundary(hasMore)
		<!-- Create/Edit Personality Modal -->
		<dialog id="personality_modal" class="modal" onclose="if (typeof syncToastContainerHost === 'function') syncToastContainerHost()">
			<div class="modal-box">
				<button type="button" class="btn btn-circle btn-ghost btn-xs ov-modal-close" onclick="closePersonalityModal()" aria-label="Close personality dialog" title="Close personality dialog">
					<svg xmlns="http://www.w3.org/2000/svg" class="h-4 w-4" fill="none" viewBox="0 0 24 24" stroke="currentColor" aria-hidden="true"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M6 18L18 6M6 6l12 12"></path></svg>
				</button>
				<h3 id="personality_modal_title" class="font-bold text-lg mb-4 pr-10">New Custom Personality</h3>
				<form id="personality_form" method="post">
					<div class="form-control mb-3">
						<label class="label"><span class="label-text">Name *</span></label>
						<input type="text" id="personality_name" name="name" class="input input-bordered" required placeholder="My Custom Personality"/>
					</div>
					<div class="form-control mb-3">
						<label class="label"><span class="label-text">Description</span></label>
						<input type="text" id="personality_description" name="description" class="input input-bordered" placeholder="Short description of this personality"/>
					</div>
					<div class="form-control mb-3">
						<label class="label"><span class="label-text">System Prompt * (min 20 chars)</span></label>
						<textarea id="personality_prompt" name="system_prompt" class="textarea textarea-bordered w-full h-32" required minlength="20" placeholder="Describe how the AI should behave..."></textarea>
					</div>
					<div class="modal-action">
						<div class="flex gap-2 w-full justify-between">
							<div id="personality_modal_extra_actions" class="flex gap-2"></div>
							<div class="flex gap-2">
								<button type="button" class="btn" onclick="closePersonalityModal()">Cancel</button>
								<button type="submit" id="personality_submit_btn" class="btn btn-primary">Create</button>
							</div>
						</div>
					</div>
				</form>
			</div>
			<form method="dialog" class="modal-backdrop">
				<button>close</button>
			</form>
		</dialog>
		<script type="text/javascript">
			window.openVibelyPersonalityEditGeneration = window.openVibelyPersonalityEditGeneration || 0;

			function openNewPersonalityModal() {
				window.openVibelyPersonalityEditGeneration++;
				var form = document.getElementById('personality_form');
				document.getElementById('personality_modal_title').textContent = 'New Custom Personality';
				form.removeAttribute('hx-put');
				form.setAttribute('hx-post', '/personality/custom');
				form.setAttribute('hx-target', '#personality-section');
				form.setAttribute('hx-swap', 'outerHTML');
				if (window.htmx) htmx.process(form);
				document.getElementById('personality_name').value = '';
				document.getElementById('personality_description').value = '';
				document.getElementById('personality_prompt').value = '';
				document.getElementById('personality_submit_btn').textContent = 'Create';
				document.getElementById('personality_submit_btn').disabled = false;
				document.getElementById('personality_modal_extra_actions').innerHTML = '';
				personality_modal.showModal();
			}

			function editPersonalityFromData(card) {
				if (!card) return;
				var key = card.dataset.personalityKey || '';
				var name = card.dataset.personalityName || '';
				var description = card.dataset.personalityDescription || '';
				var isPreset = card.dataset.personalityIsPreset === 'true';
				var hasCustom = card.dataset.personalityHasCustom === 'true';
				var requestGeneration = ++window.openVibelyPersonalityEditGeneration;

				var form = document.getElementById('personality_form');
				document.getElementById('personality_modal_title').textContent = 'Edit: ' + name;
				form.removeAttribute('hx-post');
				form.setAttribute('hx-put', '/personality/custom/' + encodeURIComponent(key));
				form.setAttribute('hx-target', '#personality-section');
				form.setAttribute('hx-swap', 'outerHTML');
				if (window.htmx) htmx.process(form);

				document.getElementById('personality_name').value = name;
				document.getElementById('personality_description').value = description;
				document.getElementById('personality_prompt').value = '';
				document.getElementById('personality_prompt').placeholder = 'Loading full prompt...';

				var submitBtn = document.getElementById('personality_submit_btn');
				if (isPreset && hasCustom) {
					submitBtn.textContent = 'Save Changes';
				} else if (isPreset && !hasCustom) {
					submitBtn.textContent = 'Save Override';
				} else {
					submitBtn.textContent = 'Save Changes';
				}
				submitBtn.disabled = true;

				// Extra actions: Reset to Default (for preset overrides) or Delete (for custom)
				var extras = document.getElementById('personality_modal_extra_actions');
				extras.innerHTML = '';

				if (isPreset && hasCustom) {
					var resetBtn = document.createElement('button');
					resetBtn.type = 'button';
					resetBtn.className = 'btn btn-outline btn-warning btn-sm';
					resetBtn.textContent = 'Reset to Default';
					resetBtn.setAttribute('hx-delete', '/personality/custom/' + encodeURIComponent(key));
					resetBtn.setAttribute('hx-target', '#personality-section');
					resetBtn.setAttribute('hx-swap', 'outerHTML');
					resetBtn.setAttribute('hx-confirm', 'Reset this personality to its built-in default?');
					if (window.htmx) {
						extras.appendChild(resetBtn);
						htmx.process(resetBtn);
					}
				} else if (!isPreset) {
					var delBtn = document.createElement('button');
					delBtn.type = 'button';
					delBtn.className = 'btn btn-outline btn-error btn-sm';
					delBtn.textContent = 'Delete';
					delBtn.setAttribute('hx-delete', '/personality/custom/' + encodeURIComponent(key));
					delBtn.setAttribute('hx-target', '#personality-section');
					delBtn.setAttribute('hx-swap', 'outerHTML');
					delBtn.setAttribute('hx-confirm', 'Delete this custom personality?');
					if (window.htmx) {
						extras.appendChild(delBtn);
						htmx.process(delBtn);
					}
				}

				// Add "Set as Default" button when editing a non-default personality
				var section = document.getElementById('personality-section');
				var selectedPersonality = section ? (section.dataset.selectedPersonality || '') : '';
				if (key !== selectedPersonality) {
					var setDefaultBtn = document.createElement('button');
					setDefaultBtn.type = 'button';
					setDefaultBtn.className = 'btn btn-outline btn-primary btn-sm';
					setDefaultBtn.textContent = 'Set as Default';
					setDefaultBtn.setAttribute('hx-post', '/personality/save?personality=' + encodeURIComponent(key));
					setDefaultBtn.setAttribute('hx-target', '#personality-section');
					setDefaultBtn.setAttribute('hx-swap', 'outerHTML');
					if (window.htmx) {
						extras.appendChild(setDefaultBtn);
						htmx.process(setDefaultBtn);
					}
				}

				personality_modal.showModal();

				fetch('/personality/custom/' + encodeURIComponent(key), { headers: { 'Accept': 'application/json' } })
					.then(function(response) {
						if (!response.ok) throw new Error('Failed to load personality');
						return response.json();
					})
					.then(function(detail) {
						if (requestGeneration !== window.openVibelyPersonalityEditGeneration) return;
						document.getElementById('personality_modal_title').textContent = 'Edit: ' + (detail.name || name);
						document.getElementById('personality_name').value = detail.name || name;
						document.getElementById('personality_description').value = detail.description || '';
						document.getElementById('personality_prompt').value = detail.system_prompt || '';
						document.getElementById('personality_prompt').placeholder = 'Describe how the AI should behave...';
						submitBtn.disabled = false;
					})
					.catch(function() {
						if (requestGeneration !== window.openVibelyPersonalityEditGeneration) return;
						document.getElementById('personality_prompt').placeholder = 'Unable to load prompt. Close and try again.';
					});
			}

			function closePersonalityModal() {
				personality_modal.close();
			}

			// Close modal after successful HTMX swap
			document.body.addEventListener('htmx:afterSwap', function(event) {
				if (event.detail.target && event.detail.target.id === 'personality-section') {
					var modal = document.getElementById('personality_modal');
					if (modal && modal.open) {
						modal.close();
					}
				}
			});
		</script>
	</div>
}
