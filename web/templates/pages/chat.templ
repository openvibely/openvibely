								thinking.classList.add('hidden');
								dots.classList.add('hidden');
								contentDiv.classList.remove('hidden');
								var failedPair = bubble.closest('[data-execution-pair="true"]');
								if (window.applyChatExecutionTerminalStatus) window.applyChatExecutionTerminalStatus(failedPair, 'failed');
								else if (failedPair) {
									failedPair.setAttribute('data-exec-status', 'failed');
									failedPair.setAttribute('hx-preserve', 'true');
								}
							function revealTerminalError() {
								if (event.data && window.showChatTerminalError) window.showChatTerminalError(contentDiv, event.data);
								function shouldScrollTerminalNow() {
									if (!tracker) return true;
									if ((tracker.intentRevision || 0) !== terminalIntentRevision) return tracker.shouldAutoScroll();
									return shouldScrollTerminalError;
								}
								if (shouldScrollTerminalNow() && chatMessages) {
									chatMessages.scrollTop = chatMessages.scrollHeight;
									requestAnimationFrame(function() {
										if (shouldScrollTerminalNow() && chatMessages && chatMessages.isConnected) {
											chatMessages.scrollTop = chatMessages.scrollHeight;
										}
									});
								}
								window.syncChatTranscriptRevision(execId);
								if (window.evaluatePlanCompletionPrompt) window.evaluatePlanCompletionPrompt();
							}
								if (failedRender && typeof failedRender.then === 'function') failedRender.then(revealTerminalError, revealTerminalError);
								else revealTerminalError();
								// Clear streaming state and refresh the composer immediately; the
								// terminal alert and authoritative transcript sync wait for the
								// final Markdown render to settle.
								window._chatStreamInProgress = false;
								if (window.refreshChatComposerAction) window.refreshChatComposerAction();
							});

							eventSource.onerror = function() {
								eventSource.close();
								if (window.unregisterChatStreamEventSource) {
									window.unregisterChatStreamEventSource(execId, eventSource);
								}
								if (textBuffer === '' && streamRetryCount < 5) {
									streamRetryCount++;
									setTimeout(connectChatExecutionStream, 150 * streamRetryCount);
									return;
								}
								if (window.hideMixtureProgress) window.hideMixtureProgress(execId);
								thinking.classList.add('hidden');
						dots.classList.add('hidden');
						contentDiv.classList.remove('hidden');
						window._chatStreamInProgress = false;
						if (window.evaluatePlanCompletionPrompt) window.evaluatePlanCompletionPrompt();
					};
					}
					connectChatExecutionStream();

					return bubble;
				}

				if (window._chatLiveEventHandlers) {
					if (window._chatLiveEventHandlers.chatEvent) {
						window.removeEventListener('sse-chat-live-event', window._chatLiveEventHandlers.chatEvent);
					}
					if (window._chatLiveEventHandlers.connected) {
						window.removeEventListener('sse-live-connected', window._chatLiveEventHandlers.connected);
					}
					if (window._chatLiveEventHandlers.afterSwap) {
						document.body.removeEventListener('htmx:afterSwap', window._chatLiveEventHandlers.afterSwap);
					}
					if (window._chatLiveEventHandlers.beforeSwap) {
						document.body.removeEventListener('htmx:beforeSwap', window._chatLiveEventHandlers.beforeSwap);
					}
				}

					var cleanupEmptyPendingInputs = function() {
						var pendingContainer = document.getElementById('pending-thread-inputs');
						if (pendingContainer) {
							// CSS handles bottom padding while pending rows exist.
						}
					};

					var ensureComposerPendingContainer = function() {
						var pendingContainer = document.getElementById('pending-thread-inputs');
						if (pendingContainer) return pendingContainer;
						var form = document.getElementById('chat-form');
						var textarea = document.getElementById('message-input');
						if (!form || !textarea) return null;
						pendingContainer = document.createElement('div');
						pendingContainer.id = 'pending-thread-inputs';
						pendingContainer.className = 'space-y-1.5';
						var textareaWrap = textarea.parentElement;
						form.insertBefore(pendingContainer, textareaWrap || textarea);
						return pendingContainer;
					};

					var createPendingAttachmentBadge = function(label, title) {
						var badge = document.createElement('div');
						badge.className = 'badge badge-ghost badge-sm shrink-0 gap-1 text-xs';
						badge.title = title;
						badge.setAttribute('aria-label', title);
						badge.innerHTML = '<svg xmlns="http://www.w3.org/2000/svg" class="h-3 w-3" fill="none" viewBox="0 0 24 24" stroke="currentColor"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M15.172 7l-6.586 6.586a2 2 0 102.828 2.828l6.586-6.586a4 4 0 00-5.657-5.657L5.757 10.757a6 6 0 108.486 8.486L21 12.486"></path></svg><span>' + label + '</span>';
						return badge;
					};

					window.syncChatTranscriptRevision = function(expectedExecID) {
						var root = document.getElementById('chat-page-root');
						if (!root || typeof fetch === 'undefined') return Promise.resolve(false);
						var pid = root.getAttribute('data-project-id') || '';
						if (!pid) return Promise.resolve(false);
						window._chatRevisionSyncGeneration = (window._chatRevisionSyncGeneration || 0) + 1;
						var generation = window._chatRevisionSyncGeneration;
						return fetch('/chat?project_id=' + encodeURIComponent(pid), {headers: {'HX-Request': 'true'}}).then(function(response) {
							if (!response.ok) throw new Error('HTTP ' + response.status);
							return response.text();
						}).then(function(html) {
							if (generation !== window._chatRevisionSyncGeneration) return false;
							var currentRoot = document.getElementById('chat-page-root');
							if (!currentRoot || currentRoot.getAttribute('data-project-id') !== pid) return false;
							var detached = document.createElement('template');
							detached.innerHTML = html;
							var nextRoot = detached.content.querySelector('#chat-page-root');
							if (!nextRoot || !window.chatTranscriptSnapshotMatches || !window.chatTranscriptSnapshotMatches(currentRoot, nextRoot, 'chat-messages', expectedExecID || '')) return false;
							window.applyChatTranscriptSnapshotRevision(currentRoot, nextRoot, 'chat-messages', 'data-chat-revision');
							if (window._chatReconnectCatchupTimer) {
								clearTimeout(window._chatReconnectCatchupTimer);
								window._chatReconnectCatchupTimer = null;
							}
							return true;
						}).catch(function(err) {
							console.error('[chat] transcript revision sync failed:', err);
							return false;
						});
					};

						var handleSharedLiveConnected = function(event) {
							var detail = event.detail || {};
							if (!detail.reconnected) return;
							var chatContainer = document.getElementById('chat-page-root');
							if (!chatContainer) return;
							var pid = chatContainer.getAttribute('data-project-id');
							refreshChatInputRequests();
							// Pending rows have their own authoritative compact fragment and never
							// require remounting transcript bubbles or the composer.
							if (pid && document.getElementById('pending-thread-inputs') && typeof htmx !== 'undefined') {
								htmx.ajax('GET', '/chat/pending-inputs?project_id=' + encodeURIComponent(pid), {target: '#pending-thread-inputs', swap: 'outerHTML'});
							}
							// Known active executions catch up through their offset-aware stream.
							if (window._chatStreamInProgress && hasActiveChatStream()) {
								if (window.evaluatePlanCompletionPrompt) window.evaluatePlanCompletionPrompt();
								if (!window._chatReconnectCatchupTimer) {
									window._chatReconnectCatchupTimer = setTimeout(function waitForChatCatchup() {
										var currentRoot = document.getElementById('chat-page-root');
										if (!currentRoot || currentRoot.getAttribute('data-project-id') !== pid) {
											window._chatReconnectCatchupTimer = null;
											return;
										}
										if (window._chatStreamInProgress && hasActiveChatStream()) {
											window._chatReconnectCatchupTimer = setTimeout(waitForChatCatchup, 500);
											return;
										}
										window._chatReconnectCatchupTimer = null;
										handleSharedLiveConnected({detail: {reconnected: true}});
									}, 500);
								}
								return;
							}
							if (!pid || typeof fetch === 'undefined' || typeof htmx === 'undefined') return;
							var url = '/chat?project_id=' + encodeURIComponent(pid);
							var currentRevision = chatContainer.getAttribute('data-chat-revision') || '';
							fetch(url, {headers: {'HX-Request': 'true'}}).then(function(response) {
								if (!response.ok) throw new Error('HTTP ' + response.status);
								return response.text();
							}).then(function(html) {
								var detached = document.createElement('template');
								detached.innerHTML = html;
								var nextRoot = detached.content.querySelector('#chat-page-root');
								var nextRevision = nextRoot ? (nextRoot.getAttribute('data-chat-revision') || '') : '';
								if (!nextRevision || nextRevision === currentRevision) return;
								// Refresh only the authoritative transcript. The existing composer,
								// draft, attachment session, and controls remain mounted.
								if (window.closeAllChatStreamEventSources) window.closeAllChatStreamEventSources();
								return htmx.ajax('GET', url, {
									target: '#chat-messages',
									select: '#chat-messages',
									swap: 'morph:outerHTML'
								}).then(function() {
									if (window._initThreadStreaming) window._initThreadStreaming();
									if (window.refreshChatComposerAction) window.refreshChatComposerAction();
									var currentRoot = document.getElementById('chat-page-root');
									if (currentRoot && currentRoot.getAttribute('data-project-id') === pid) currentRoot.setAttribute('data-chat-revision', nextRevision);
									if (window.evaluatePlanCompletionPrompt) window.evaluatePlanCompletionPrompt();
								});
							}).catch(function(err) {
								console.error('[chat] reconnect reconciliation failed:', err);
							});
						};

						function renderChatInputRequest(data) {
							var request = data.input_request || {};
							var requestId = request.id || '';
							if (!requestId) return;
							var existing = document.getElementById('chat-input-request-' + requestId);
							if (existing) {
								if (request.completed) completeChatInputRequest(existing, request);
								return;
							}
							var questions = Array.isArray(request.questions) ? request.questions : [];
							if (!questions.length) return;
							var chatMessages = document.getElementById('chat-messages');
							if (!chatMessages) return;
							var emptyState = chatMessages.querySelector('.flex.flex-col.items-center.justify-center');
							if (emptyState) emptyState.remove();
							var card = document.createElement('section');
							card.id = 'chat-input-request-' + requestId;
							card.className = 'chat-input-request-card card bg-base-100 shadow-lg border border-base-300/70';
							card.setAttribute('data-chat-input-request-id', requestId);
							card.setAttribute('aria-labelledby', 'chat-input-request-title-' + requestId);
							var body = document.createElement('div');
							body.className = 'card-body gap-4 p-4';
							var title = document.createElement('h3');
							title.id = 'chat-input-request-title-' + requestId;
							title.className = 'card-title text-base';
							title.textContent = 'Input requested';
							var hint = document.createElement('p');
							hint.className = 'text-sm opacity-70';
							hint.textContent = 'Answer each question, then submit to continue this assistant response.';
							var status = document.createElement('div');
							status.className = 'text-sm font-medium hidden';
							status.setAttribute('role', 'status');
							status.setAttribute('aria-live', 'polite');
							body.appendChild(title);
							body.appendChild(hint);
							questions.forEach(function(question, index) {
								var qid = question && question.id ? String(question.id) : '';
								if (!qid) return;
								var fieldset = document.createElement('fieldset');
								fieldset.className = index === 0 ? 'space-y-2' : 'space-y-2 hidden';
								fieldset.setAttribute('data-chat-input-question-id', qid);
								fieldset.setAttribute('data-chat-input-question-index', String(index));
								var legend = document.createElement('legend');
								legend.className = 'font-semibold text-sm';
								legend.textContent = question.question || ('Question ' + (index + 1));
								fieldset.appendChild(legend);
								var options = Array.isArray(question.options) ? question.options : [];
								options.forEach(function(option, optionIndex) {
									var label = option && option.label ? String(option.label) : '';
									if (!label) return;
									var button = document.createElement('button');
									button.type = 'button';
									button.className = 'btn ' + (optionIndex === 0 ? 'btn-primary' : 'btn-outline') + ' justify-start h-auto min-h-0 w-full px-3 py-2 text-left normal-case';
									button.setAttribute('data-chat-input-option', 'true');
									button.setAttribute('data-question-id', qid);
									button.setAttribute('data-option-label', label);
									button.setAttribute('aria-pressed', optionIndex === 0 ? 'true' : 'false');
									if (optionIndex === 0) {
										fieldset.setAttribute('data-selected-kind', 'option');
										fieldset.setAttribute('data-selected-label', label);
									}
									var wrap = document.createElement('span');
									wrap.className = 'flex min-w-0 flex-col items-start';
									var labelSpan = document.createElement('span');
									labelSpan.className = 'font-medium';
									labelSpan.textContent = label;
									var descSpan = document.createElement('span');
									descSpan.className = 'text-xs opacity-70 whitespace-normal';
									descSpan.textContent = option.description || '';
									wrap.appendChild(labelSpan);
									wrap.appendChild(descSpan);
									button.appendChild(wrap);
									fieldset.appendChild(button);
								});
								var customButton = document.createElement('button');
								customButton.type = 'button';
								customButton.className = 'btn btn-outline justify-start h-auto min-h-0 w-full px-3 py-2 text-left normal-case';
								customButton.setAttribute('data-chat-input-option', 'true');
								customButton.setAttribute('data-chat-input-custom-option', 'true');
								customButton.setAttribute('data-question-id', qid);
								customButton.setAttribute('aria-pressed', 'false');
								customButton.textContent = 'Something else';
								var customWrap = document.createElement('div');
								customWrap.className = 'hidden space-y-2 rounded-lg border border-base-300/70 p-3';
								customWrap.setAttribute('data-chat-input-custom-wrap', 'true');
								var customInput = document.createElement('textarea');
								customInput.className = 'textarea textarea-bordered min-h-20 w-full';
								customInput.maxLength = 2000;
								customInput.placeholder = 'Type your answer';
								customInput.setAttribute('data-chat-input-custom-answer', 'true');
								customInput.setAttribute('aria-label', 'Custom answer');
								customWrap.appendChild(customInput);
								fieldset.appendChild(customButton);
								fieldset.appendChild(customWrap);
								body.appendChild(fieldset);
							});
							var navigation = document.createElement('div');
							navigation.className = 'flex items-center justify-between gap-3 text-sm text-base-content/60';
							navigation.setAttribute('data-chat-input-navigation', 'true');
							var previous = document.createElement('button');
							previous.type = 'button';
							previous.className = 'btn btn-ghost btn-sm';
							previous.setAttribute('data-chat-input-nav', 'previous');
							previous.setAttribute('aria-label', 'Previous question');
							previous.textContent = 'Previous';
							var position = document.createElement('span');
							position.setAttribute('data-chat-input-position', 'true');
							var next = document.createElement('button');
							next.type = 'button';
							next.className = 'btn btn-primary btn-sm';
							next.setAttribute('data-chat-input-nav', 'next');
							next.setAttribute('aria-label', 'Next question');
							navigation.appendChild(previous);
							navigation.appendChild(position);
							navigation.appendChild(next);
							body.appendChild(navigation);
							body.appendChild(status);
							card.appendChild(body);
							var execId = data.exec_id || request.exec_id || '';
							var executionPair = execId ? document.getElementById('chat-execution-' + execId) : null;
							(executionPair || chatMessages).appendChild(card);
							showChatInputQuestion(card, 0);
							if (request.completed) completeChatInputRequest(card, request);
							var tracker = window._chatPageTracker;
							if (window.chatAutoScroll && (!tracker || tracker.shouldAutoScroll())) window.chatAutoScroll.scrollToBottom(chatMessages, true);
						}

						function showChatInputQuestion(card, index) {
							if (!card) return;
							var groups = Array.prototype.slice.call(card.querySelectorAll('[data-chat-input-question-index]'));
							if (!groups.length) return;
							var nextIndex = Math.max(0, Math.min(Number(index) || 0, groups.length - 1));
							groups.forEach(function(group, groupIndex) {
								group.classList.toggle('hidden', groupIndex !== nextIndex);
							});
							card.setAttribute('data-current-question-index', String(nextIndex));
							var position = card.querySelector('[data-chat-input-position]');
							if (position) position.textContent = (nextIndex + 1) + ' of ' + groups.length;
							var previous = card.querySelector('[data-chat-input-nav="previous"]');
							var next = card.querySelector('[data-chat-input-nav="next"], [data-chat-input-nav="submit"]');
							if (previous) {
								previous.disabled = nextIndex === 0;
								previous.classList.toggle('invisible', groups.length === 1);
							}
							if (next) {
								var isLast = nextIndex === groups.length - 1;
								next.textContent = isLast ? 'Submit' : 'Next';
								next.setAttribute('data-chat-input-nav', isLast ? 'submit' : 'next');
								next.setAttribute('aria-label', isLast ? 'Submit answers' : 'Next question');
									next.disabled = isLast ? !chatInputRequestIsComplete(card) : false;
							}
							var legend = groups[nextIndex].querySelector('legend');
							if (legend) legend.focus && legend.focus();
						}

						function navigateChatInputRequest(button) {
							var card = button ? button.closest('[data-chat-input-request-id]') : null;
							if (!card || card.getAttribute('data-completed') === 'true') return;
							var action = button.getAttribute('data-chat-input-nav') || '';
							if (action === 'submit') {
								submitChatInputRequest(button);
								return;
							}
							var current = Number(card.getAttribute('data-current-question-index') || 0);
							showChatInputQuestion(card, current + (action === 'previous' ? -1 : 1));
						}

						function chatInputQuestionAnswer(group) {
							if (!group) return null;
							var questionID = group.getAttribute('data-chat-input-question-id') || '';
							if (!questionID) return null;
							if (group.getAttribute('data-selected-kind') === 'custom') {
								var input = group.querySelector('[data-chat-input-custom-answer]');
								var customAnswer = input ? String(input.value || '').trim() : '';
								return customAnswer ? {question_id: questionID, custom_answer: customAnswer} : null;
							}
							var label = group.getAttribute('data-selected-label') || '';
							return label ? {question_id: questionID, label: label} : null;
						}

						function chatInputRequestAnswers(card) {
							var answers = [];
							card.querySelectorAll('[data-chat-input-question-id]').forEach(function(group) {
								var answer = chatInputQuestionAnswer(group);
								if (answer) answers.push(answer);
							});
							return answers;
						}

						function chatInputRequestIsComplete(card) {
							return chatInputRequestAnswers(card).length === card.querySelectorAll('[data-chat-input-question-id]').length;
						}

						function selectChatInputOption(button) {
							if (!button || button.disabled) return;
							var card = button.closest('[data-chat-input-request-id]');
							var fieldset = button.closest('[data-chat-input-question-id]');
							if (!card || !fieldset || card.getAttribute('data-completed') === 'true') return;
							var isCustom = button.hasAttribute('data-chat-input-custom-option');
							fieldset.setAttribute('data-selected-kind', isCustom ? 'custom' : 'option');
							fieldset.setAttribute('data-selected-label', isCustom ? '' : (button.getAttribute('data-option-label') || ''));
							fieldset.querySelectorAll('button[data-chat-input-option]').forEach(function(btn) {
								var selected = btn === button;
								btn.classList.toggle('btn-outline', !selected);
								btn.classList.toggle('btn-primary', selected);
								btn.setAttribute('aria-pressed', selected ? 'true' : 'false');
							});
							var customWrap = fieldset.querySelector('[data-chat-input-custom-wrap]');
							if (customWrap) customWrap.classList.toggle('hidden', !isCustom);
							var status = card.querySelector('[role="status"]');
							if (status) status.classList.add('hidden');
							showChatInputQuestion(card, Number(card.getAttribute('data-current-question-index') || 0));
							if (isCustom) {
								var customInput = fieldset.querySelector('[data-chat-input-custom-answer]');
								if (customInput) customInput.focus();
							} else {
								var currentIndex = Number(card.getAttribute('data-current-question-index') || 0);
								var questionCount = card.querySelectorAll('[data-chat-input-question-index]').length;
								if (currentIndex < questionCount - 1) {
									window.setTimeout(function() {
										if (card.getAttribute('data-current-question-index') === String(currentIndex)) showChatInputQuestion(card, currentIndex + 1);
									}, 300);
								}
							}
						}

						function completeChatInputRequest(card, request) {
							if (!card || card.getAttribute('data-completed') === 'true') return;
							var questions = Array.isArray(request.questions) ? request.questions : [];
							var answers = Array.isArray(request.answers) ? request.answers : [];
							var answerByQuestion = {};
							answers.forEach(function(answer) {
								if (answer && answer.question_id) answerByQuestion[String(answer.question_id)] = String(answer.label || answer.custom_answer || '');
							});
							var details = document.createElement('details');
							details.className = 'rounded-lg border border-base-300/70 bg-base-100 px-3 py-2 text-sm';
							var summary = document.createElement('summary');
							summary.className = 'cursor-pointer select-none text-base-content/70';
							summary.textContent = 'Asked ' + questions.length + (questions.length === 1 ? ' question' : ' questions');
							details.appendChild(summary);
							var answerList = document.createElement('div');
							answerList.className = 'mt-3 space-y-3';
							questions.forEach(function(question) {
								var item = document.createElement('div');
								item.className = 'space-y-1';
								var questionText = document.createElement('div');
								questionText.className = 'font-medium whitespace-pre-wrap';
								questionText.textContent = question.question || '';
								var answerText = document.createElement('div');
								answerText.className = 'text-base-content/60 whitespace-pre-wrap';
								answerText.textContent = answerByQuestion[String(question.id || '')] || 'No answer provided';
								item.appendChild(questionText);
								item.appendChild(answerText);
								answerList.appendChild(item);
							});
							details.appendChild(answerList);
							card.className = 'chat-input-request-card';
							card.setAttribute('data-completed', 'true');
							card.removeAttribute('data-submitted');
							card.removeAttribute('aria-labelledby');
							card.replaceChildren(details);
						}

						function refreshChatInputRequests() {
							var root = document.getElementById('chat-page-root');
							var pid = root ? root.getAttribute('data-project-id') : projectId;
							if (!pid || typeof fetch === 'undefined') return Promise.resolve();
							return fetch('/chat/input-requests?project_id=' + encodeURIComponent(pid), {headers: {'Accept': 'application/json'}}).then(function(resp) {
								if (!resp.ok) throw new Error('HTTP ' + resp.status);
								return resp.json();
							}).then(function(payload) {
								var requests = Array.isArray(payload.input_requests) ? payload.input_requests : [];
								var activeRequestIDs = {};
								requests.forEach(function(request) {
									if (request && request.id) activeRequestIDs[String(request.id)] = true;
									renderChatInputRequest({input_request: request});
								});
								document.querySelectorAll('[data-chat-input-request-id]').forEach(function(card) {
									var id = card.getAttribute('data-chat-input-request-id') || '';
									if (card.getAttribute('data-completed') !== 'true' && !activeRequestIDs[id]) card.remove();
								});
							}).catch(function(err) {
								console.error('[chat] input request reconciliation failed:', err);
							});
						}
						window.refreshChatInputRequests = refreshChatInputRequests;

						function submitChatInputRequest(button) {
							if (!button || button.disabled) return;
							var card = button.closest('[data-chat-input-request-id]');
							if (!card || card.getAttribute('data-submitted') === 'true') return;
							var status = card.querySelector('[role="status"]');
							var answers = chatInputRequestAnswers(card);
							if (!chatInputRequestIsComplete(card)) {
								if (status) {
									status.classList.remove('hidden', 'text-error');
									status.textContent = 'Answer every question before submitting.';
								}
								var groups = Array.prototype.slice.call(card.querySelectorAll('[data-chat-input-question-index]'));
								var nextUnanswered = groups.findIndex(function(group) { return !chatInputQuestionAnswer(group); });
								if (nextUnanswered >= 0) showChatInputQuestion(card, nextUnanswered);
								return;
							}
							var requestId = card.getAttribute('data-chat-input-request-id') || '';
							var root = document.getElementById('chat-page-root');
							var projectID = root ? root.getAttribute('data-project-id') : projectId;
							card.setAttribute('data-submitted', 'true');
							card.querySelectorAll('button, textarea').forEach(function(control) { control.disabled = true; });
							if (status) {
								status.classList.remove('hidden', 'text-error');
								status.textContent = 'Submitting answers…';
							}
							fetch('/chat/input-requests/' + encodeURIComponent(requestId) + '/answer', {
								method: 'POST',
								headers: {'Content-Type': 'application/json'},
								body: JSON.stringify({project_id: projectID || '', answers: answers})
							}).then(function(resp) {
								if (!resp.ok) throw new Error('Unable to submit answer');
								completeChatInputRequest(card, {questions: Array.prototype.slice.call(card.querySelectorAll('[data-chat-input-question-id]')).map(function(group) {
									return {id: group.getAttribute('data-chat-input-question-id') || '', question: (group.querySelector('legend') || {}).textContent || ''};
								}), answers: answers});
							}).catch(function(err) {
								card.removeAttribute('data-submitted');
								card.querySelectorAll('button, textarea').forEach(function(control) { control.disabled = false; });
								showChatInputQuestion(card, Number(card.getAttribute('data-current-question-index') || 0));
								if (status) {
									status.classList.remove('hidden');
									status.classList.add('text-error');
									status.textContent = err && err.message ? err.message : 'Unable to submit answer';
								}
							});
						}

					var handleSharedChatLiveEvent = function(event) {						var data = event.detail || {};
						var eventType = data.type || '';
						if (data.project_id && data.project_id !== projectId) {
							return;
						}

									if (eventType === 'mixture_progress') {
										if (window.applyMixtureProgress) window.applyMixtureProgress(data);
										return;
									}

									if (eventType === 'chat_user_input_requested') {
										renderChatInputRequest(data);
										return;
									}

									if (eventType === 'chat_user_input_resolved') {
										renderChatInputRequest(data);
										return;
									}

										if (eventType === 'chat_turn_steered') {								var existingSteeringRow = document.querySelector('[data-thread-input-id="' + data.exec_id + '"]');
								if (existingSteeringRow && existingSteeringRow.getAttribute('data-input-mode') === 'steering') return;
								if (window._chatQueuedSteerInFlight && window._chatQueuedSteerInFlight[data.exec_id]) return;
									if (data.source === 'web' && window._chatDirectSteerInFlight) return;
									if (!existingSteeringRow && data.source === 'web' && window._chatWebSendInProgress) return;
									if (window.hidePlanCompletionPrompt) window.hidePlanCompletionPrompt();
								var pendingContainer = ensureComposerPendingContainer();
								if (!pendingContainer) return;
								if (existingSteeringRow) existingSteeringRow.remove();
								var steeringRow = document.createElement('div');							steeringRow.id = 'thread-input-' + data.exec_id;
							steeringRow.className = 'steering-input-row flex min-h-8 items-center gap-3 rounded-lg bg-base-300/45 px-3 py-1.5 text-sm text-base-content/80';
							steeringRow.setAttribute('data-thread-input-id', data.exec_id);
							steeringRow.setAttribute('data-input-mode', 'steering');
							steeringRow.title = 'Steering instruction will be applied before the active run\'s next model step';
							var content = document.createElement('div');
							content.className = 'min-w-0 flex-1';
							content.innerHTML = '<div class="text-xs font-semibold opacity-70">Steering pending</div>';
							var preview = document.createElement('div');
							preview.className = 'truncate';
							preview.textContent = data.message || '';
							content.appendChild(preview);
							var hint = document.createElement('div');
							hint.className = 'text-xs opacity-60';
							hint.textContent = 'Will be applied before the active run\'s next model step.';
							content.appendChild(hint);
							var actionWrap = document.createElement('div');
							actionWrap.className = 'ml-auto flex shrink-0 items-center gap-2';
							var cancelSteeringBtn = document.createElement('button');
							cancelSteeringBtn.type = 'button';
							cancelSteeringBtn.className = 'btn btn-ghost btn-xs h-6 min-h-0 rounded-md px-2 text-xs text-error';
							cancelSteeringBtn.setAttribute('hx-post', '/thread-inputs/' + data.exec_id + '/cancel');
							cancelSteeringBtn.setAttribute('hx-target', '#thread-input-' + data.exec_id);
							cancelSteeringBtn.setAttribute('hx-swap', 'outerHTML');
							cancelSteeringBtn.title = 'Cancel pending steering';
							cancelSteeringBtn.setAttribute('aria-label', 'Cancel pending steering');
							cancelSteeringBtn.innerHTML = '<svg xmlns="http://www.w3.org/2000/svg" class="h-4 w-4" fill="none" viewBox="0 0 24 24" stroke="currentColor"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M19 7l-.867 12.142A2 2 0 0116.138 21H7.862a2 2 0 01-1.995-1.858L5 7m5 4v6m4-6v6m1-10V4a1 1 0 00-1-1h-4a1 1 0 00-1 1v3M4 7h16"></path></svg>';
							actionWrap.appendChild(cancelSteeringBtn);
								steeringRow.appendChild(content);
								if (data.has_attachments) steeringRow.appendChild(createPendingAttachmentBadge('Attachments included', 'Attachments included with this steering instruction'));
								steeringRow.appendChild(actionWrap);							pendingContainer.appendChild(steeringRow);
							// CSS handles bottom padding while pending rows exist.
							if (window.htmx) htmx.process(steeringRow);
							return;
						}

								if (eventType === 'chat_thread_input_applied' || eventType === 'chat_thread_input_cancelled') {
									if (data.pending_input_id) {
										var appliedRow = document.getElementById('thread-input-' + data.pending_input_id);
										if (appliedRow) {
											appliedRow.remove();
											cleanupEmptyPendingInputs();
										}
									}
									return;
								}
									if (eventType === 'chat_new_message') {
									if (data.has_attachments && !data.queued) {
										var chatContainer = document.getElementById('chat-page-root');
										var pid = chatContainer ? chatContainer.getAttribute('data-project-id') : projectId;
										if (chatContainer && pid && typeof htmx !== 'undefined') {
											if (window.closeAllChatStreamEventSources) window.closeAllChatStreamEventSources();
										var attachmentRefresh = htmx.ajax('GET', '/chat?project_id=' + encodeURIComponent(pid), {target: '#chat-messages', select: '#chat-messages', swap: 'morph:outerHTML'});
										if (attachmentRefresh && typeof attachmentRefresh.then === 'function') attachmentRefresh.then(function() { window.syncChatTranscriptRevision(data.exec_id || ''); });
										var attachmentAction = document.getElementById('chat-form-primary-action');
										if (attachmentAction) htmx.ajax('GET', '/chat/composer-action?project_id=' + encodeURIComponent(pid), {target: '#chat-form-primary-action', swap: 'outerHTML'});
										}
										return;
									}
									// Queued events use durable pending-input IDs, not execution IDs.
								// Dedupe them by composer DOM row so recovered queued rows can reappear
								// after a queued-to-steer provider failure.
								if (data.queued) {
									if (document.querySelector('[data-thread-input-id="' + data.exec_id + '"]')) return;
									if (data.source === 'web' && window._chatWebSendInProgress) return;
								} else {
									// Skip duplicates: map guard + DOM guard for timing races
									// between HTMX send swap and live SSE delivery.
									if (window._chatKnownExecIds[data.exec_id]) return;
									if (document.querySelector('[data-exec-id="' + data.exec_id + '"]')) {
										window._chatKnownExecIds[data.exec_id] = true;
										return;
									}
									if (data.source === 'web' && window._chatWebSendInProgress) return;
									window._chatKnownExecIds[data.exec_id] = true;
								}

								// Mark stream in progress so plan prompt stays hidden mid-stream.
								window._chatStreamInProgress = !data.queued;
								if (window.hidePlanCompletionPrompt) window.hidePlanCompletionPrompt();

								var chatMessages = document.getElementById('chat-messages');
								if (!chatMessages) return;
								if (!data.queued && data.pending_input_id) {
										var pendingRow = document.getElementById('thread-input-' + data.pending_input_id);
										if (pendingRow) {
											pendingRow.remove();
											cleanupEmptyPendingInputs();
										}
								}

							// Remove empty state if present
							var emptyState = chatMessages.querySelector('.flex.flex-col.items-center.justify-center');
							if (emptyState) emptyState.remove();

									if (data.queued) {
										if (document.querySelector('[data-thread-input-id="' + data.exec_id + '"]')) return;
										var pendingContainer = ensureComposerPendingContainer();
										if (!pendingContainer) return;
										var queuedRow = document.createElement('div');
										queuedRow.id = 'thread-input-' + data.exec_id;
										queuedRow.className = 'queued-input-row flex min-h-8 items-center gap-3 rounded-lg bg-base-300/45 px-3 py-1.5 text-sm text-base-content/80';
										queuedRow.setAttribute('data-thread-input-id', data.exec_id);
										queuedRow.setAttribute('data-input-mode', 'queued');
										queuedRow.title = 'Queued follow-up will run after the active response finishes';
										var queuedPreview = document.createElement('div');
										queuedPreview.className = 'min-w-0 flex-1 truncate';
										queuedPreview.textContent = data.message || '';
										var actionWrap = document.createElement('div');
										actionWrap.className = 'ml-auto flex shrink-0 items-center gap-2';
										var steerBtn = document.createElement('button');
										steerBtn.type = 'button';
										steerBtn.className = 'btn btn-ghost btn-xs h-6 min-h-0 rounded-md px-2 text-xs font-medium';
										steerBtn.setAttribute('hx-post', '/chat/queued/' + data.exec_id + '/steer');
										steerBtn.setAttribute('hx-target', '#thread-input-' + data.exec_id);
										steerBtn.setAttribute('hx-swap', 'outerHTML');
										steerBtn.title = 'Convert queued follow-up to steering';
										steerBtn.textContent = 'Steer';
										var cancelBtn = document.createElement('button');
										cancelBtn.type = 'button';
										cancelBtn.className = 'btn btn-ghost btn-xs h-6 min-h-0 rounded-md px-2 text-xs text-error';
										cancelBtn.setAttribute('hx-post', '/thread-inputs/' + data.exec_id + '/cancel');
										cancelBtn.setAttribute('hx-target', '#thread-input-' + data.exec_id);
										cancelBtn.setAttribute('hx-swap', 'outerHTML');
										cancelBtn.title = 'Cancel queued follow-up';
											cancelBtn.setAttribute('aria-label', 'Cancel queued follow-up');
											cancelBtn.innerHTML = '<svg xmlns="http://www.w3.org/2000/svg" class="h-4 w-4" fill="none" viewBox="0 0 24 24" stroke="currentColor"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M19 7l-.867 12.142A2 2 0 0116.138 21H7.862a2 2 0 01-1.995-1.858L5 7m5 4v6m4-6v6m1-10V4a1 1 0 00-1-1h-4a1 1 0 00-1 1v3M4 7h16"></path></svg>';										actionWrap.appendChild(steerBtn);
										actionWrap.appendChild(cancelBtn);
										queuedRow.appendChild(queuedPreview);
										if (data.has_attachments) queuedRow.appendChild(createPendingAttachmentBadge('Attachments queued', 'Attachments queued with this follow-up'));
										queuedRow.appendChild(actionWrap);
										pendingContainer.appendChild(queuedRow);
										// CSS handles bottom padding while pending rows exist.
										if (window.htmx) htmx.process(queuedRow);
									} else {								// Append user bubble and streaming assistant for a real running turn.
									var pair = document.createElement('div');
									pair.id = 'chat-execution-' + data.exec_id;
									pair.className = 'chat-execution-pair space-y-6';
									pair.setAttribute('data-execution-pair', 'true');
									pair.setAttribute('data-exec-id', data.exec_id);
									pair.setAttribute('data-exec-status', 'running');
									pair.appendChild(createUserBubble(data.message, data.source));
									pair.appendChild(createStreamingBubble(data.exec_id));
									chatMessages.appendChild(pair);
									if (window.refreshChatComposerAction) window.refreshChatComposerAction();
									window.syncChatTranscriptRevision(data.exec_id);
									if (window.pruneChatExecutionWindow) window.pruneChatExecutionWindow(chatMessages);
								}
							// Scroll to bottom (respect user scroll position)
							var tracker = window._chatPageTracker;
							if (window.chatAutoScroll && (!tracker || tracker.shouldAutoScroll())) {
								window.chatAutoScroll.scrollToBottom(chatMessages, true);
							}
							return;
						}

					if (eventType === 'chat_response_done') {
						if (data.is_task_followup) return;
						// Guard: only act if we're still on the chat page.
						if (!document.getElementById('chat-messages')) return;

						// Safety net: if we missed the chat_new_message event (e.g., channel
						// buffer was full), the completed message won't be displayed. Detect
						// this by checking if the exec_id is unknown and refresh if so.
						if (data.exec_id && !window._chatKnownExecIds[data.exec_id]) {
							var chatContainer = document.getElementById('chat-page-root');
							if (chatContainer) {
								var pid = chatContainer.getAttribute('data-project-id');
									if (pid) {
										if (window.closeAllChatStreamEventSources) window.closeAllChatStreamEventSources();
											var missedRefresh = htmx.ajax('GET', '/chat?project_id=' + encodeURIComponent(pid), {target: '#chat-messages', select: '#chat-messages', swap: 'morph:outerHTML'});
											if (missedRefresh && typeof missedRefresh.then === 'function') missedRefresh.then(function() { window.syncChatTranscriptRevision(data.exec_id || ''); });
											var missedAction = document.getElementById('chat-form-primary-action');
											if (missedAction) htmx.ajax('GET', '/chat/composer-action?project_id=' + encodeURIComponent(pid), {target: '#chat-form-primary-action', swap: 'outerHTML'});
									}
							}
							return;
						}

							// chat_response_done may arrive before the last per-exec delta is rendered
							// in the active bubble (especially after blur/focus reconnect timing).
							// Reconcile output and authoritative terminal status so visible UI matches persisted state.
							if (data.exec_id) {
								try {
									syncCompletedOutputToBubble(data.exec_id, data.completed_output, data.status || '');
								} catch (err) {
									console.error('[chat] completed-output reconciliation failed:', err);
								}
							}
							var completedPair = data.exec_id ? document.getElementById('chat-execution-' + data.exec_id) : null;
							if (window.applyChatExecutionTerminalStatus) window.applyChatExecutionTerminalStatus(completedPair, data.status || '');
							else if (completedPair) {
								var completedStatus = completedPair.getAttribute('data-exec-status') || '';
								var eventStatus = data.status === 'failed' || data.status === 'cancelled' || data.status === 'completed' ? data.status : '';
								if (eventStatus) completedPair.setAttribute('data-exec-status', eventStatus);
								else if (!completedStatus || completedStatus === 'running' || completedStatus === 'pending' || completedStatus === 'queued') completedPair.setAttribute('data-exec-status', 'completed');
								completedPair.setAttribute('hx-preserve', 'true');
							}
							window.syncChatTranscriptRevision(data.exec_id || '');

							window._chatStreamInProgress = false;
							if (window.evaluatePlanCompletionPrompt) {
								window.evaluatePlanCompletionPrompt(data.completed_output);
							}
							var actionTarget = document.getElementById('chat-form-primary-action');
							var chatContainer = document.getElementById('chat-page-root');
							var pid = chatContainer ? chatContainer.getAttribute('data-project-id') : projectId;
							if (actionTarget && pid && typeof htmx !== 'undefined') {
								htmx.ajax('GET', '/chat/composer-action?project_id=' + encodeURIComponent(pid), {target: '#chat-form-primary-action', swap: 'outerHTML'});
							}
						}				};

				// Also mark exec IDs from HTMX swaps to avoid duplicates after page updates.
				var handleChatAfterSwap = function(event) {
					var swapTarget = event.detail.target;
					if (swapTarget && swapTarget.id === 'chat-messages') {
						if (window.initChatEarlierLoader) window.initChatEarlierLoader(swapTarget);
						if (window.pruneChatExecutionWindow) window.pruneChatExecutionWindow(swapTarget);
						swapTarget.querySelectorAll('[data-exec-id]').forEach(function(el) {
							window._chatKnownExecIds[el.getAttribute('data-exec-id')] = true;
						});
						refreshChatInputRequests();
					}
					if (swapTarget && swapTarget.id === 'main-content' && !swapTarget.querySelector('#chat-page-root')) {
						window.removeEventListener('sse-chat-live-event', handleSharedChatLiveEvent);
						window.removeEventListener('sse-live-connected', handleSharedLiveConnected);
						document.body.removeEventListener('htmx:afterSwap', handleChatAfterSwap);
						document.body.removeEventListener('htmx:beforeSwap', handleChatBeforeSwap);
						if (window.closeAllChatStreamEventSources) window.closeAllChatStreamEventSources();
					}
				};
					var handleChatBeforeSwap = function(event) {
						var swapTarget = event.detail.target;
						if (!swapTarget) return;
						var currentChatRoot = document.getElementById('chat-page-root');
						var chatMessages = document.getElementById('chat-messages');
						if (currentChatRoot && chatMessages && (swapTarget.id === 'chat-messages' || swapTarget.id === 'chat-page-root' || swapTarget.id === 'main-content')) {
							var projectId = currentChatRoot.getAttribute('data-project-id') || '';
							var chatScrollStateKey = 'chat-scroll-' + projectId;
							if (window.saveChatTranscriptScrollState) window.saveChatTranscriptScrollState(chatScrollStateKey, chatMessages, window._chatPageTracker);
							if (window.saveChatDraftState) window.saveChatDraftState(currentChatRoot);
							var chatForm = document.getElementById('chat-form');
							if (chatForm && window.saveChatPendingAttachmentState) window.saveChatPendingAttachmentState(chatForm);
						}
						if (swapTarget.id === 'chat-page-root') {
						if (window.closeAllChatStreamEventSources) window.closeAllChatStreamEventSources();
						return;
					}
					if (swapTarget.id === 'main-content' && !swapTarget.querySelector('#chat-page-root')) {
						if (window.closeAllChatStreamEventSources) window.closeAllChatStreamEventSources();
					}
				};

						if (!window._chatInputRequestClickBound) {
							window._chatInputRequestClickBound = true;
								document.body.addEventListener('click', function(event) {
									var navigationButton = event.target && event.target.closest ? event.target.closest('button[data-chat-input-nav]') : null;
									if (navigationButton) {
										event.preventDefault();
										navigateChatInputRequest(navigationButton);
										return;
									}
									var button = event.target && event.target.closest ? event.target.closest('button[data-chat-input-option]') : null;
									if (!button) return;
									event.preventDefault();
									selectChatInputOption(button);
							});
							document.body.addEventListener('input', function(event) {
								var input = event.target && event.target.closest ? event.target.closest('[data-chat-input-custom-answer]') : null;
								if (!input) return;
								var card = input.closest('[data-chat-input-request-id]');
								if (card) showChatInputQuestion(card, Number(card.getAttribute('data-current-question-index') || 0));
							});
						}

						window.addEventListener('sse-chat-live-event', handleSharedChatLiveEvent);
						window.addEventListener('sse-live-connected', handleSharedLiveConnected);				document.body.addEventListener('htmx:afterSwap', handleChatAfterSwap);
				document.body.addEventListener('htmx:beforeSwap', handleChatBeforeSwap);
					window._chatLiveEventHandlers = {
					chatEvent: handleSharedChatLiveEvent,
					connected: handleSharedLiveConnected,
					afterSwap: handleChatAfterSwap,
					beforeSwap: handleChatBeforeSwap
					};
					refreshChatInputRequests();
				window.restoreChatLiveEventHandlers = function() {
					var handlers = window._chatLiveEventHandlers;
					if (!handlers) return;
					if (handlers.chatEvent) window.addEventListener('sse-chat-live-event', handlers.chatEvent);
					if (handlers.connected) window.addEventListener('sse-live-connected', handlers.connected);
					if (handlers.afterSwap) document.body.addEventListener('htmx:afterSwap', handlers.afterSwap);
					if (handlers.beforeSwap) document.body.addEventListener('htmx:beforeSwap', handlers.beforeSwap);
				};
			})();
		</script>
	</div>
}

// ChatModelInfo renders a small info badge showing which agent was auto-selected
templ ChatModelInfo(info string) {
	if info != "" {
		<div class="text-xs opacity-50 text-center my-1">
			{ info }
		</div>
	}
}
