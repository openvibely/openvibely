package pages

import (
	"fmt"
	"time"

	"github.com/openvibely/openvibely/internal/models"
	"github.com/openvibely/openvibely/web/templates/components"
	"github.com/openvibely/openvibely/web/templates/layout"
)

func planCompleteDataAttr(b bool) string {
	if b {
		return "true"
	}
	return "false"
}

func chatHasActiveTurn(history []models.Execution) bool {
	return chatActiveTurnID(history) != ""
}

func chatActiveTurnID(history []models.Execution) string {
	for _, exec := range history {
		if exec.Status == models.ExecRunning {
			return exec.ID
		}
	}
	return ""
}

func chatQueuedSteerEndpoint(input models.ThreadInput) string {
	return "/chat/queued/" + input.ID + "/steer"
}

// Chat renders the full chat page with sidebar
templ Chat(projects []models.Project, currentProjectID string, agents []models.LLMConfig, chatHistory []models.Execution, chatAttachments map[string][]models.ChatAttachment, pendingInputs []models.ThreadInput, latestPlanComplete bool, hasEarlier bool, windowLimit int) {
	@layout.Base("Chat", projects, currentProjectID) {
		@ChatContent(agents, chatHistory, currentProjectID, chatAttachments, pendingInputs, latestPlanComplete, hasEarlier, windowLimit)
	}
}

templ ChatEarlierMessages(chatHistory []models.Execution, chatAttachments map[string][]models.ChatAttachment, currentProjectID string, hasEarlier bool, windowLimit int) {
	if hasEarlier && len(chatHistory) > 0 {
		@components.ChatEarlierMessagesLoader("chat-messages", "/chat?project_id="+currentProjectID+"&before="+chatHistory[0].ID+"&limit="+fmt.Sprintf("%d", windowLimit), windowLimit)
	}
	for _, exec := range chatHistory {
		<div id={ "chat-execution-" + exec.ID } class="chat-execution-pair space-y-6" data-execution-pair="true" data-exec-id={ exec.ID } data-exec-status={ string(exec.Status) } data-execution-revision={ components.ChatExecutionRevision(exec) } data-started-at={ exec.StartedAt.Format(time.RFC3339Nano) }>
			if attachments, hasAttachments := chatAttachments[exec.ID]; hasAttachments {
				@components.ChatBubbleWithAttachments("User", exec.PromptSent, attachments, currentProjectID)
			} else {
				@components.ChatBubble("User", exec.PromptSent)
			}
			if exec.Status == models.ExecCompleted {
				@components.ChatBubble("Assistant", exec.Output)
			} else if exec.Status == models.ExecFailed {
				@components.ChatBubbleError("Assistant", exec.ErrorMessage, exec.Output)
			} else if exec.Status == models.ExecCancelled {
				@components.ChatBubbleError("Assistant", "Cancelled", exec.Output)
			} else if exec.Status == models.ExecRunning {
				@components.ChatBubbleStreamingResume("Assistant", exec.Output, exec.ID, "chat-messages", "")
			}
		</div>
	}
}

// ChatContent renders just the chat content (for HTMX)
templ ChatContent(agents []models.LLMConfig, chatHistory []models.Execution, currentProjectID string, chatAttachments map[string][]models.ChatAttachment, pendingInputs []models.ThreadInput, latestPlanComplete bool, hasEarlier bool, windowLimit int) {
	<div id="chat-page-root" class="h-full flex flex-col min-w-0 max-w-full" data-project-id={ currentProjectID } data-chat-revision={ components.ChatTranscriptRevision(chatHistory, nil, currentProjectID) }>
		@layout.PageTitle("Chat")
		<div class="mb-4 flex items-center justify-between">
			<div>
				<h2 class="text-2xl font-bold">Chat</h2>
				<p class="text-sm opacity-60 mt-1">Coordinate and orchestrate AI tasks across your project</p>
			</div>
			<div class="dropdown dropdown-end" data-chat-actions-dropdown>
				<button type="button" class="btn btn-xs btn-ghost" title="More actions" aria-label="More actions" aria-haspopup="menu" aria-expanded="false" aria-controls="chat-actions-menu" onclick="toggleChatActionsDropdown(event)">
					<svg xmlns="http://www.w3.org/2000/svg" class="h-5 w-5" fill="none" viewBox="0 0 24 24" stroke="currentColor">
						<path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 5v.01M12 12v.01M12 19v.01M12 6a1 1 0 110-2 1 1 0 010 2zm0 7a1 1 0 110-2 1 1 0 010 2zm0 7a1 1 0 110-2 1 1 0 010 2z"></path>
					</svg>
				</button>
				<ul id="chat-actions-menu" tabindex="0" role="menu" class="dropdown-content menu p-2 shadow bg-base-100 rounded-box w-56 z-[100]">
					<li>
						<button
							type="button"
							hx-delete={ "/chat/history?project_id=" + currentProjectID }
							hx-target="closest #chat-page-root"
							hx-swap="outerHTML"
							hx-confirm="Clear all chat history? This cannot be undone."
							class="text-error"
							role="menuitem"
						>
							<svg xmlns="http://www.w3.org/2000/svg" class="h-4 w-4" fill="none" viewBox="0 0 24 24" stroke="currentColor">
								<path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M19 7l-.867 12.142A2 2 0 0116.138 21H7.862a2 2 0 01-1.995-1.858L5 7m5 4v6m4-6v6m1-10V4a1 1 0 00-1-1h-4a1 1 0 00-1 1v3M4 7h16"></path>
							</svg>
							Clear Chat
						</button>
					</li>
				</ul>
			</div>
		</div>
		<!-- Chat Messages Container -->
		<div class="relative flex-1 min-h-0 min-w-0">
			<div id="chat-messages" class="h-full min-h-0 overflow-y-auto pt-4 pb-4 -mb-3 space-y-6" style="visibility: hidden;" data-transcript-hydrating="true" data-window-limit={ fmt.Sprintf("%d", windowLimit) } data-earlier-url-base={ "/chat?project_id=" + currentProjectID + "&limit=" + fmt.Sprintf("%d", windowLimit) } data-scroll-intent-scope={ currentProjectID }>
				if hasEarlier && len(chatHistory) > 0 {
					@components.ChatEarlierMessagesLoader("chat-messages", "/chat?project_id="+currentProjectID+"&before="+chatHistory[0].ID+"&limit="+fmt.Sprintf("%d", windowLimit), windowLimit)
				}
				if len(chatHistory) == 0 && len(pendingInputs) == 0 {
					@components.ChatEmptyState("Start a conversation by typing a message below")
				} else {
					for _, exec := range chatHistory {
						<div
							id={ "chat-execution-" + exec.ID }
							class="chat-execution-pair space-y-6"
							data-execution-pair="true"
							data-exec-id={ exec.ID }
							data-exec-status={ string(exec.Status) }
							data-execution-revision={ components.ChatExecutionRevision(exec) }
							data-started-at={ exec.StartedAt.Format(time.RFC3339Nano) }
							if exec.Status == models.ExecCompleted || exec.Status == models.ExecFailed || exec.Status == models.ExecCancelled {
								hx-preserve="true"
							}
						>
							if attachments, hasAttachments := chatAttachments[exec.ID]; hasAttachments {
								@components.ChatBubbleWithAttachments("User", exec.PromptSent, attachments, currentProjectID)
							} else {
								@components.ChatBubble("User", exec.PromptSent)
							}
							if exec.Status == models.ExecCompleted {
								@components.ChatBubble("Assistant", exec.Output)
							} else if exec.Status == models.ExecFailed {
								@components.ChatBubbleError("Assistant", exec.ErrorMessage, exec.Output)
							} else if exec.Status == models.ExecCancelled {
								@components.ChatBubbleError("Assistant", "Cancelled", exec.Output)
							} else if exec.Status == models.ExecRunning {
								@components.ChatBubbleStreamingResume("Assistant", exec.Output, exec.ID, "chat-messages", "")
							}
						</div>
					}
					@components.PendingThreadInputRows(pendingInputs, chatQueuedSteerEndpoint)
				}
			</div>
			@components.ChatLatestMessageButton("chat-messages", "scrollTracker_chat-messages")
		</div>
		<div id="chat-plan-complete-prompt" class="hidden mb-3 alert bg-base-200/60 border border-base-content/10" data-has-plan-completion={ planCompleteDataAttr(latestPlanComplete) }>
			<div class="w-full flex flex-wrap items-center justify-between gap-3">				<div>
					<div class="font-medium text-sm">Plan complete.</div>
					<div class="text-xs opacity-70">Switch to Orchestrate mode to implement this plan?</div>
				</div>
				<div class="flex items-center gap-2">
					<button id="chat-plan-stay-btn" type="button" class="btn btn-ghost btn-xs">Stay in Plan</button>
					<button id="chat-plan-switch-btn" type="button" class="btn btn-primary btn-xs">Switch to Orchestrate</button>
				</div>
			</div>
		</div>
		<!-- Message Input Form (shared component) -->
		@components.ChatInputForm(components.ChatInputFormConfig{
			FormID:                 "chat-form",
			InputID:                "message-input",
			PostEndpoint:           "/chat/send?project_id=" + currentProjectID,
			TargetID:               "chat-messages",
			Agents:                 agents,
			ShowModelSelector:      true,
			ShowModeSelector:       true,
			ChatMode:               models.ChatModeOrchestrate,
			ProjectID:              currentProjectID,
			IsRunning:              chatHasActiveTurn(chatHistory),
			ActiveTurnID:           chatActiveTurnID(chatHistory),
			StopEndpoint:           "/chat/stop?project_id=" + currentProjectID,
			SteerEndpoint:          "/chat/steer?project_id=" + currentProjectID,
			PendingInputs:          pendingInputs,
			QueuedSteerEndpointFor: chatQueuedSteerEndpoint,
		})
		<!-- Shared auto-scroll and transcript rendering/cleaning utilities -->
		@components.ChatAutoScrollScript()
		@components.ChatStreamingResumeInitScript()
		<!-- Chat-specific: draft persistence, plan handling, and HTMX swap behavior -->
		<script>
			(function() {
				var setChatActionsOpen = function(dropdown, open) {
					if (!dropdown) return;
					if (open) dropdown.setAttribute('data-chat-actions-open', 'true');
					else dropdown.removeAttribute('data-chat-actions-open');
					var trigger = dropdown.querySelector('[aria-controls="chat-actions-menu"]');
					if (trigger) trigger.setAttribute('aria-expanded', open ? 'true' : 'false');
				};
				var chatActionsTrigger = function(dropdown) {
					return dropdown ? dropdown.querySelector('[aria-controls="chat-actions-menu"]') : null;
				};
				var restoreChatActionsFocus = function(dropdown) {
					var trigger = chatActionsTrigger(dropdown);
					if (!trigger || typeof trigger.focus !== 'function') return;
					try {
						trigger.focus({preventScroll: true});
					} catch (_) {
						trigger.focus();
					}
				};
				var closeChatActions = function(dropdown, restoreFocus) {
					setChatActionsOpen(dropdown, false);
					if (restoreFocus) restoreChatActionsFocus(dropdown);
				};
				var resetChatActionsDropdown = function() {
					closeChatActions(document.querySelector('[data-chat-actions-dropdown]'), false);
				};
				window.toggleChatActionsDropdown = function(event) {
					if (!event) return;
					event.stopPropagation();
					var trigger = event.currentTarget;
					var dropdown = trigger && trigger.closest ? trigger.closest('[data-chat-actions-dropdown]') : null;
					if (!dropdown) return;
					var isOpen = dropdown.getAttribute('data-chat-actions-open') === 'true';
					if (isOpen) {
						event.preventDefault();
						closeChatActions(dropdown, true);
						return;
					}
					setChatActionsOpen(dropdown, true);
					requestAnimationFrame(function() {
						if (typeof positionDropdownForViewport === 'function') positionDropdownForViewport(trigger);
					});
				};

				var dropdown = document.querySelector('[data-chat-actions-dropdown]');
				if (dropdown) {
					// A Wails WebView may focus the first focusable control during startup.
					// Explicit state keeps that focus accessible without opening the menu.
					setChatActionsOpen(dropdown, false);
					var trigger = chatActionsTrigger(dropdown);
					if (trigger) trigger.addEventListener('keydown', function(event) {
						if (event.key !== 'Enter' && event.key !== ' ' && event.key !== 'Spacebar') return;
						event.preventDefault();
						window.toggleChatActionsDropdown(event);
					});
					dropdown.addEventListener('focusout', function(event) {
						if (!event.relatedTarget || !dropdown.contains(event.relatedTarget)) closeChatActions(dropdown, false);
					});
					dropdown.addEventListener('keydown', function(event) {
						if (event.key !== 'Escape') return;
						event.preventDefault();
						event.stopPropagation();
						closeChatActions(dropdown, true);
					});
				}

				if (!window._chatActionsPointerCloseBound) {
					window._chatActionsPointerCloseBound = true;
					document.addEventListener('pointerdown', function(event) {
						var currentDropdown = document.querySelector('[data-chat-actions-dropdown]');
						if (currentDropdown && !currentDropdown.contains(event.target)) closeChatActions(currentDropdown, false);
					}, true);
				}
				if (!window._chatActionsHistoryRestoreBound) {
					window._chatActionsHistoryRestoreBound = true;
					document.body.addEventListener('htmx:historyRestore', function() {
						setTimeout(resetChatActionsDropdown, 0);
					});
				}
			})();

					window.initializeChatTranscriptScroll = function() {
						var chatRoot = document.getElementById('chat-page-root');
						var chatMessages = document.getElementById('chat-messages');
						if (!chatRoot || !chatMessages || !window.ChatScrollTracker) return Promise.resolve(false);
						var projectId = chatRoot.getAttribute('data-project-id') || '';
						var chatScrollStateKey = 'chat-scroll-' + projectId;
						var chatForm = document.getElementById('chat-form');
						if (chatForm && window.restoreChatPendingAttachmentState) window.restoreChatPendingAttachmentState(chatForm);
						var savedState = window.getChatTranscriptScrollState ? window.getChatTranscriptScrollState(chatScrollStateKey) : null;
						var sentByUser = window.consumeChatSendScrollIntent ? window.consumeChatSendScrollIntent('chat-messages') : false;
						if (sentByUser) savedState = { scrollTop: 0, userScrolledUp: false, pinned: true };
						if (!window._chatPageTracker || window._chatPageTracker.element !== chatMessages) {
							window._chatPageTracker = window.resolveScrollTracker('scrollTracker_chat-messages', chatMessages);
						}
							if (sentByUser && window._chatPageTracker.resetOnUserSend) window._chatPageTracker.resetOnUserSend();
							else window._chatPageTracker.userScrolledUp = savedState ? !!savedState.userScrolledUp : false;
						var renderPromise = window.applyChatBubbleTransforms ? window.applyChatBubbleTransforms(chatMessages) : Promise.resolve([]);
						if (window._initThreadStreaming) window._initThreadStreaming();
						if (window.initChatEarlierLoader) window.initChatEarlierLoader(chatMessages);
						if (window.bindAttachmentImageSmartScroll) window.bindAttachmentImageSmartScroll(chatMessages, 'scrollTracker_chat-messages', window._chatPageTracker);
						if (window.maybeShowPlanCompletionPromptFromHistory) window.maybeShowPlanCompletionPromptFromHistory();
						if (!window.restoreChatTranscriptScroll) return Promise.resolve(renderPromise);
						return window.restoreChatTranscriptScroll({
							messages: chatMessages,
							tracker: window._chatPageTracker,
							getTracker: function() { return window._chatPageTracker; },
							stateKey: chatScrollStateKey,
							state: savedState,
							defaultPinned: true,
							renderPromise: renderPromise
						});
					};
					setTimeout(function() { window.initializeChatTranscriptScroll(); }, 0);
					if (!window._chatTranscriptHistoryRestoreBound) {
						window._chatTranscriptHistoryRestoreBound = true;
						document.body.addEventListener('htmx:historyRestore', function() {
							setTimeout(function() {
								if (document.getElementById('chat-page-root') && window.initializeChatTranscriptScroll) window.initializeChatTranscriptScroll();
								if (document.getElementById('chat-page-root') && window.restoreChatLiveEventHandlers) window.restoreChatLiveEventHandlers();
							}, 0);
						});
					}

					// Draft message persistence (scoped per project)
				(function() {
				var chatRoot = document.getElementById('chat-page-root');
				if (!chatRoot) return;
				var projectId = chatRoot.getAttribute('data-project-id');

				// Track /events/chat/:exec_id EventSources so reconnect swaps/navigation
				// cannot leak stale streams and consume browser connection slots.
				window._chatEventSources = window._chatEventSources || [];
				window._chatEventSourceByExec = window._chatEventSourceByExec || {};
				window.registerChatStreamEventSource = function(execId, eventSource) {
					if (!execId || !eventSource) return;
					var existing = window._chatEventSourceByExec[execId];
					if (existing && existing !== eventSource) {
						try { existing.close(); } catch (e) {}
						var oldIdx = window._chatEventSources.indexOf(existing);
						if (oldIdx >= 0) window._chatEventSources.splice(oldIdx, 1);
					}
					window._chatEventSourceByExec[execId] = eventSource;
					if (window._chatEventSources.indexOf(eventSource) === -1) {
						window._chatEventSources.push(eventSource);
					}
				};
				window.unregisterChatStreamEventSource = function(execId, eventSource) {
					if (eventSource) {
						var idx = window._chatEventSources.indexOf(eventSource);
						if (idx >= 0) window._chatEventSources.splice(idx, 1);
					}
					if (execId && window._chatEventSourceByExec[execId] === eventSource) {
						delete window._chatEventSourceByExec[execId];
					}
				};
				window.closeAllChatStreamEventSources = function() {
					if (!window._chatEventSources) return;
					window._chatEventSources.forEach(function(es) {
						try { es.close(); } catch (e) {}
					});
					window._chatEventSources = [];
					window._chatEventSourceByExec = {};
				};
				window.refreshChatComposerAction = function() {
					var root = document.getElementById('chat-page-root');
					var target = document.getElementById('chat-form-primary-action');
					var pid = root ? (root.getAttribute('data-project-id') || '') : '';
					if (!pid || !target || typeof htmx === 'undefined') return Promise.resolve(false);
					return htmx.ajax('GET', '/chat/composer-action?project_id=' + encodeURIComponent(pid), {
						target: '#chat-form-primary-action',
						swap: 'outerHTML'
					});
				};
					window._chatDraftSaveTimers = window._chatDraftSaveTimers || {};
					window.chatDraftStorageKey = function(root) {
						root = root || document.getElementById('chat-page-root');
						var pid = root ? (root.getAttribute('data-project-id') || '') : '';
						return pid ? 'chat-draft-' + pid : '';
					};
					window.saveChatDraftState = function(root) {
						root = root || document.getElementById('chat-page-root');
						var key = window.chatDraftStorageKey(root);
						var input = root ? root.querySelector('#message-input') : null;
						if (!key || !input) return false;
						if (window._chatDraftSaveTimers[key]) {
							clearTimeout(window._chatDraftSaveTimers[key]);
							delete window._chatDraftSaveTimers[key];
						}
						input.defaultValue = input.value;
						if (input.value.trim() !== '') localStorage.setItem(key, input.value);
						else localStorage.removeItem(key);
						return true;
					};
					window.restoreChatDraftState = function(root) {
						root = root || document.getElementById('chat-page-root');
						var key = window.chatDraftStorageKey(root);
						var input = root ? root.querySelector('#message-input') : null;
						if (!key || !input) return false;
						var saved = localStorage.getItem(key) || '';
						if (saved.trim() !== '') {
							input.value = saved;
							input.defaultValue = saved;
						}
						return true;
					};
					window.clearChatDraftState = function(root) {
						root = root || document.getElementById('chat-page-root');
						var key = window.chatDraftStorageKey(root);
						var input = root ? root.querySelector('#message-input') : null;
						if (!key) return false;
						if (window._chatDraftSaveTimers[key]) {
							clearTimeout(window._chatDraftSaveTimers[key]);
							delete window._chatDraftSaveTimers[key];
						}
						localStorage.removeItem(key);
						if (input) {
							input.value = '';
							input.defaultValue = '';
						}
						return true;
					};

					var draftKey = window.chatDraftStorageKey(chatRoot);
					var messageInput = document.getElementById('message-input');
					var chatForm = document.getElementById('chat-form');
					if (!messageInput || !chatForm) return;

					window.restoreChatDraftState(chatRoot);

					messageInput.addEventListener('input', function() {
						if (window._chatDraftSaveTimers[draftKey]) clearTimeout(window._chatDraftSaveTimers[draftKey]);
						window._chatDraftSaveTimers[draftKey] = setTimeout(function() {
							window.saveChatDraftState(chatRoot);
						}, 500);
					});

					if (!window._chatDraftHistoryBound) {
						window._chatDraftHistoryBound = true;
						document.body.addEventListener('htmx:beforeHistorySave', function() {
							if (window.saveChatDraftState) window.saveChatDraftState();
						});
						document.body.addEventListener('htmx:historyRestore', function() {
							setTimeout(function() {
								if (window.restoreChatDraftState) window.restoreChatDraftState();
							}, 0);
						});
					}

					chatForm.addEventListener('htmx:afterRequest', function(event) {
						if (!event.detail || event.detail.elt !== chatForm) return;
						if (!event.detail.successful) return;
						var xhr = event.detail.xhr;
						var responseText = xhr ? (xhr.responseText || '') : '';
						if (responseText.trim() !== '') window.clearChatDraftState(chatRoot);
					});			})();
			// Detect <proposed_plan> marker in raw assistant content.
			// Checks raw XML tags only; does not match HTML-escaped variants
			// (&lt;proposed_plan&gt;) since raw content is stored unescaped in
			// data-raw-content attributes and streamed as plain text.
			window.planModeHasProposedPlan = function(rawText) {
				if (!rawText) return false;
				return /<\s*proposed_plan\s*>[\s\S]*<\s*\/\s*proposed_plan\s*>/i.test(rawText) || /<\s*proposed_plan\s*>/i.test(rawText);
			};

			// Get current chat mode. Prefer visible selector state (user-facing)
			// over hidden input to avoid stale mode mismatches after programmatic
			// mode changes that update one but not the other.
			// During HTMX reconnect swaps there is a brief hydration window where the
			// newly-swapped select still has its default value before localStorage restore.
			// In that window, fallback to persisted mode so CTA visibility doesn't flicker.
			window.currentChatModeValue = function() {
				var form = document.getElementById('chat-form');
				if (!form) return '';
				// Support both native <select> (legacy) and custom select button
				var modeSelect = form.querySelector('[id$="-mode-select"]');
				var modeInput = form.querySelector('input[name="chat_mode"]');

				var persistedMode = '';
				var chatRoot = document.getElementById('chat-page-root');
				if (chatRoot) {
					var pid = chatRoot.getAttribute('data-project-id');
					if (pid) persistedMode = localStorage.getItem('chat-mode-' + pid) || '';
				}

				// Read value from native select or custom select button
				var modeValue = '';
				if (modeSelect) {
					modeValue = modeSelect.tagName === 'SELECT' ? modeSelect.value : (modeSelect.dataset.currentValue || '');
				}
				if (modeValue) {
					var selectHydrated = modeSelect.dataset && modeSelect.dataset.hydrated === 'true';
					if (selectHydrated || !persistedMode) return modeValue;
					return persistedMode;
				}

				if (modeInput && modeInput.value) return modeInput.value;
				return persistedMode;
			};

				window.hidePlanCompletionPrompt = function() {
					var prompt = document.getElementById('chat-plan-complete-prompt');
					if (!prompt) return;
					prompt.classList.add('hidden');
					prompt.removeAttribute('data-has-plan-completion');
				};

				window.showPlanCompletionPrompt = function() {
					var prompt = document.getElementById('chat-plan-complete-prompt');
					if (!prompt) return;
					prompt.classList.remove('hidden');
				};

				window.applyChatBubbleTransforms = function(chatMessages) {
					if (!chatMessages) return Promise.resolve([]);
					// Re-hydrate assistant bubbles from raw content first (tool/thinking cards).
					// This keeps hard-refresh behavior consistent with task-thread rendering
					// and prevents transcript-control cleanup from stripping tool controls before
					// tool-card rendering runs. Post-render transforms run after the shared
					// hydration barrier so task metadata inside newly rendered DOM is handled once.
					var renderPromise = window.cleanAssistantMessages ? window.cleanAssistantMessages(chatMessages) : Promise.resolve([]);
					return Promise.resolve(renderPromise).then(function() {
						chatMessages.querySelectorAll('.chat-bubble-user-msg, .chat-bubble-assistant-msg').forEach(function(bubble) {
							if (window.convertTaskLinksInMessage) window.convertTaskLinksInMessage(bubble);
							if (window.convertTaskEditLinksInMessage) window.convertTaskEditLinksInMessage(bubble);
							if (window.cleanBubbleContent) window.cleanBubbleContent(bubble);
						});
						return true;
					});
				};

			// Explicit refresh helper: force assistant bubble hydration from raw content.
			window.rehydrateChatAssistantBubbles = function() {
				var chatMessages = document.getElementById('chat-messages');
				if (!chatMessages) return;
				if (window.cleanAssistantMessages) window.cleanAssistantMessages(chatMessages);
			};
			window.switchChatMode = function(mode) {
				var form = document.getElementById('chat-form');
				if (!form) return;
				var modeInput = form.querySelector('input[name="chat_mode"]');
				// Support both native <select> (legacy) and custom select button
				var modeSelect = form.querySelector('[id$="-mode-select"]');
				if (modeInput) modeInput.value = mode;
				if (modeSelect) {
					if (modeSelect.tagName === 'SELECT') {
						modeSelect.value = mode;
					} else if (window._setChatCustomSelectValue) {
						window._setChatCustomSelectValue(modeSelect, mode);
					}
				}

				var chatRoot = document.getElementById('chat-page-root');
				if (chatRoot) {
					var pid = chatRoot.getAttribute('data-project-id');
					if (pid) {
						localStorage.setItem('chat-mode-' + pid, mode);
					}
				}
			};

			// --- Centralized plan-completion prompt evaluator ---
			// One function that decides show/hide for all completion paths:
			//   1. per-exec stream done event
			//   2. chat_response_done live SSE fallback
			//   3. initial page load / HTMX swap hydration
			//
			// Rules:
			//   - Never show mid-stream (_chatStreamInProgress === true)
			//   - Only show when mode === 'plan'
			//   - Only show when latest completed assistant response has <proposed_plan>
			//   - If latest completed response has no plan marker, hide prompt
			//
			// The optional completedText param is the raw text of the just-completed
			// response. When provided it is used directly (per-exec done path).
			// When omitted the function scans the DOM for the latest completed
			// assistant bubble (hydration / chat_response_done fallback path).
			window.evaluatePlanCompletionPrompt = function(completedText) {
				// Guard: never show mid-stream
				if (window._chatStreamInProgress) {
					window.hidePlanCompletionPrompt();
					return;
				}

				// Guard: only in plan mode
				if (window.currentChatModeValue() !== 'plan') {
					window.hidePlanCompletionPrompt();
					return;
				}

				// Resolve text to evaluate
				var fromCompletedEvent = (typeof completedText === 'string');
				var text = completedText;
				if (!fromCompletedEvent) {
					// Scan DOM for latest completed assistant bubble
					text = window._getLatestCompletedAssistantText();
				}

				if (text && window.planModeHasProposedPlan(text)) {
					window.showPlanCompletionPrompt();
					return;
				}

				// Server-side plan completion: check the server-rendered attribute on the
				// CTA element. When the latest completed execution contains a proposed_plan
				// block, the server sets this attribute. Survives refresh and navigation.
				if (!fromCompletedEvent) {
					var prompt = document.getElementById('chat-plan-complete-prompt');
					if (prompt && prompt.getAttribute('data-has-plan-completion') === 'true') {
						window.showPlanCompletionPrompt();
						return;
					}
				}


				window.hidePlanCompletionPrompt();
			};

			// Extract raw content from the latest completed (non-streaming)
			// assistant bubble. Returns the text or '' if none found.
			// "Completed" means: has data-raw-content (persisted history) or is a
			// streaming bubble whose loading dots are hidden (stream finished).
			// Bubbles with visible loading indicators are considered still streaming.
			window._getLatestCompletedAssistantText = function() {
				var chatMessages = document.getElementById('chat-messages');
				if (!chatMessages) return '';
				var assistantBubbles = chatMessages.querySelectorAll('.chat-bubble-assistant-msg');
				if (!assistantBubbles || assistantBubbles.length === 0) return '';

				// Walk newest -> oldest. Return text from the FIRST (newest)
				// completed bubble with non-empty content. Do NOT continue to
				// older bubbles — only the latest completed response matters.
				for (var i = assistantBubbles.length - 1; i >= 0; i--) {
					var bubble = assistantBubbles[i];

					// Skip bubbles that are still streaming (thinking dots visible)
					var thinkingDots = bubble.querySelector('.ov-loading-dots');
					if (thinkingDots && !thinkingDots.closest('.hidden')) {
						// This bubble is actively streaming — skip it and
						// don't fall through to older bubbles either
						return '';
					}

					// Check for streaming-in-progress dots in both DOM patterns:
					//  - web live bubble: .loading-dots
					//  - shared ChatBubbleStreaming: #streaming-dots-<execId> with ov-loading-dots child
					var loadingDots = bubble.querySelector('.loading-dots');
					if (loadingDots && !loadingDots.closest('.hidden')) {
						return '';
					}
					var streamDotsContainer = bubble.querySelector('[id^="streaming-dots-"]');
					if (streamDotsContainer && !streamDotsContainer.classList.contains('hidden')) {
						if (streamDotsContainer.querySelector('.ov-loading-dots')) {
							return '';
						}
					}

					// Try data-raw-content first (persisted or rendered history).
					// Includes live SSE bubbles which use a plain div with data-exec-id/data-raw-content
					// (no .chat-stream-content class).
					var rawNode = bubble.querySelector('[data-raw-content][data-exec-id], .chat-stream-content[data-raw-content], [data-streaming-resume][data-raw-content], [data-raw-content]');
					var raw = rawNode ? (rawNode.getAttribute('data-raw-content') || '') : '';
					if (!raw.trim()) {
						raw = bubble.textContent || '';
					}
					if (!raw.trim()) continue;

					// This is the latest completed assistant response — return it
					// regardless of whether it has a plan marker or not
					return raw;
				}
				return '';
			};

			// Legacy compat wrapper — called from per-exec stream done handler
			window.handlePlanModeCompletion = function(rawText) {
				window._chatStreamInProgress = false;
				window.evaluatePlanCompletionPrompt(rawText);
			};

			// Called on page load and HTMX swaps to re-evaluate from DOM
			window.maybeShowPlanCompletionPromptFromHistory = function() {
				window.evaluatePlanCompletionPrompt();
			};

			// Page-level scroll tracker for HTMX swap decisions
			// Persists across swaps so we know if user manually scrolled up
			(function() {
				var chatMessages = document.getElementById('chat-messages');
				if (chatMessages && window.ChatScrollTracker) {
					window._chatPageTracker = window.resolveScrollTracker('scrollTracker_chat-messages', chatMessages);
				}
			})();

			// Convert task-result metadata and clean transcript controls on HTMX swaps
			if (!window._chatSwapHandlerAttached) {
				window._chatSwapHandlerAttached = true;

					// Track request-local Chat streaming state without changing scroll intent
					// until the shared composer confirms that the send was accepted.
					window._chatQueuedSteerInFlight = window._chatQueuedSteerInFlight || {};
					window._chatQueuedSteerClearTimers = window._chatQueuedSteerClearTimers || {};
					window._chatDirectSteerInFlight = false;
					window._chatDirectSteerClearTimer = null;
					function chatQueuedSteerInputID(triggerEl) {
						if (!triggerEl || !triggerEl.getAttribute) return '';
						var hxPost = triggerEl.getAttribute('hx-post') || '';
						var match = hxPost.match(/^\/chat\/queued\/([^\/]+)\/steer$/);
						return match ? match[1] : '';
					}
					document.body.addEventListener('htmx:beforeRequest', function(event) {
						var triggerEl = event.detail.elt;
						if (triggerEl && triggerEl.id === 'chat-form') {
							// Hide prompt immediately on new send — will re-evaluate
							// only after the new response completes and passes plan detection
							window._chatStreamInProgress = true;
							if (window.hidePlanCompletionPrompt) window.hidePlanCompletionPrompt();
							// Flag that a web send is in progress (prevents live SSE duplication)
							window._chatWebSendInProgress = true;
							if (triggerEl.getAttribute('data-submit-intent') === 'steer') {
								window._chatDirectSteerInFlight = true;
								if (window._chatDirectSteerClearTimer) clearTimeout(window._chatDirectSteerClearTimer);
							}
						}
						var queuedSteerID = chatQueuedSteerInputID(triggerEl);
						if (queuedSteerID) {
							window._chatQueuedSteerInFlight[queuedSteerID] = true;
							if (window._chatQueuedSteerClearTimers[queuedSteerID]) clearTimeout(window._chatQueuedSteerClearTimers[queuedSteerID]);
						}
					});

					document.body.addEventListener('htmx:afterRequest', function(event) {
						var triggerEl = event.detail.elt;
						if (triggerEl && triggerEl.id === 'chat-form') {
							// Queued sends can return only out-of-band composer updates, so do
							// not rely on a chat-messages swap to clear web-send suppression.
							window._chatWebSendInProgress = false;
							if (window._chatDirectSteerInFlight) {
								window._chatDirectSteerClearTimer = setTimeout(function() {
									window._chatDirectSteerInFlight = false;
									window._chatDirectSteerClearTimer = null;
								}, 1000);
							}
						}
						var queuedSteerID = chatQueuedSteerInputID(triggerEl);
						if (queuedSteerID) {
							window._chatQueuedSteerClearTimers[queuedSteerID] = setTimeout(function() {
								delete window._chatQueuedSteerInFlight[queuedSteerID];
								delete window._chatQueuedSteerClearTimers[queuedSteerID];
							}, 1000);
						}
					});				document.body.addEventListener('htmx:afterSwap', function(event) {
					var swapTarget = event.detail.target;
					var isChatMessagesSwap = !!(swapTarget && swapTarget.id === 'chat-messages');
					var isChatRootSwap = !!(swapTarget && swapTarget.id === 'chat-page-root');
					if (isChatMessagesSwap || isChatRootSwap) {
						var chatMessages = isChatMessagesSwap ? swapTarget : (swapTarget ? swapTarget.querySelector('#chat-messages') : null);
						if (!chatMessages) return;
						// Clear web send dedupe flag and mark new exec IDs as known
						window._chatWebSendInProgress = false;
						chatMessages.querySelectorAll('[data-exec-id]').forEach(function(el) {
							if (window._chatKnownExecIds) window._chatKnownExecIds[el.getAttribute('data-exec-id')] = true;
						});
							if (window.initializeChatTranscriptScroll) window.initializeChatTranscriptScroll();
							// During an active stream, this swap can carry partial persisted output.
							if (!window._chatStreamInProgress && window.maybeShowPlanCompletionPromptFromHistory) {
								window.maybeShowPlanCompletionPromptFromHistory();
							}
					}
				});
			}

			// Plan completion prompt buttons (delegated so handlers survive outerHTML swaps)
			if (!window._chatPlanPromptClickHandlerAttached) {
				window._chatPlanPromptClickHandlerAttached = true;
				document.body.addEventListener('click', function(event) {
					var stayBtn = event.target && event.target.closest ? event.target.closest('#chat-plan-stay-btn') : null;
					if (stayBtn) {
						if (window.hidePlanCompletionPrompt) window.hidePlanCompletionPrompt();
						return;
					}

					var switchBtn = event.target && event.target.closest ? event.target.closest('#chat-plan-switch-btn') : null;
					if (!switchBtn) return;
					event.preventDefault();

					var messageInput = document.getElementById('message-input');
					var chatForm = document.getElementById('chat-form');
					var planHandoffMessage = 'Create one active task for the whole proposed plan above. Do not execute or start any other existing tasks. Report progress.';

					if (window.switchChatMode) window.switchChatMode('orchestrate');
					if (window.hidePlanCompletionPrompt) window.hidePlanCompletionPrompt();
					if (messageInput) messageInput.value = planHandoffMessage;
					if (chatForm) {
						chatForm.requestSubmit();
						return;
					}
					if (messageInput) {
						messageInput.focus();
						messageInput.selectionStart = messageInput.value.length;
						messageInput.selectionEnd = messageInput.value.length;
					}
				});
			}
		</script>
		<!-- Real-time chat updates via SSE (receives messages from Telegram, API, other tabs) -->
		<script>
			(function() {
				var chatRoot = document.getElementById('chat-page-root');
				if (!chatRoot) return;
				var projectId = chatRoot.getAttribute('data-project-id');

				// Track exec IDs already displayed to avoid duplicates
				window._chatKnownExecIds = window._chatKnownExecIds || {};

				// Mark already-rendered executions as known
				document.querySelectorAll('[data-exec-id]').forEach(function(el) {
					window._chatKnownExecIds[el.getAttribute('data-exec-id')] = true;
				});

				// Helper: create a user message bubble
				function createUserBubble(message, source) {
					var bubble = document.createElement('div');
					bubble.className = 'chat-bubble-user-msg rounded-xl p-4';
					var roleDiv = document.createElement('div');
					roleDiv.className = 'text-xs font-semibold opacity-50 mb-2';
					roleDiv.textContent = 'User';
					if (source && source !== 'web') {
						var badge = document.createElement('span');
						badge.className = 'badge badge-xs badge-ghost ml-2';
						badge.textContent = source;
						roleDiv.appendChild(badge);
					}
					var innerDiv = document.createElement('div');
					innerDiv.className = 'chat-bubble-inner';
					var textDiv = document.createElement('div');
					textDiv.className = 'whitespace-pre-wrap leading-relaxed text-sm';
					textDiv.style.wordWrap = 'break-word';
					textDiv.textContent = message;
					innerDiv.appendChild(textDiv);
					bubble.appendChild(roleDiv);
					bubble.appendChild(innerDiv);
					return bubble;
				}

					function syncCompletedOutputToBubble(execId, completedOutput, status) {
						if (!execId) return;
						var streamContainer = document.getElementById('streaming-message-' + execId);
						if (!streamContainer) return;
						var completedPair = streamContainer.closest('[data-execution-pair="true"]');
						if (window.applyChatExecutionTerminalStatus) window.applyChatExecutionTerminalStatus(completedPair, status || '');
						else if (completedPair) completedPair.setAttribute('hx-preserve', 'true');
						if (typeof completedOutput === 'string') {
							if (window.setChatRawContent) window.setChatRawContent(streamContainer, completedOutput);
							else streamContainer.setAttribute('data-raw-content', completedOutput);
							streamContainer._authoritativeTerminalContent = completedOutput;
							streamContainer.setAttribute('data-authoritative-terminal-content', 'true');
						}
						if (typeof completedOutput === 'string' && completedOutput !== '') {
							if (window.renderStreamingContent) {
								var liveRenderer = window.renderLiveChatContent || window.renderStreamingContent;
								var renderPromise = liveRenderer(streamContainer, completedOutput);
								if (renderPromise && typeof renderPromise.catch === 'function') {
									renderPromise.catch(function() { streamContainer.textContent = completedOutput; });
								}
							} else {
								streamContainer.textContent = completedOutput;
							}
						}
						streamContainer.classList.remove('hidden');
						var bubble = streamContainer.closest('.chat-bubble-assistant-msg');
						if (bubble) {
							var thinking = bubble.querySelector('.ov-loading-dots');
							if (thinking && !thinking.closest('.hidden')) {
								var thinkingWrap = thinking.closest('.flex.flex-col.items-start.gap-1');
								if (thinkingWrap) thinkingWrap.classList.add('hidden');
							}
							var streamDots = bubble.querySelector('.loading-dots');
							if (streamDots) {
								var streamDotsWrap = streamDots.closest('div');
								if (streamDotsWrap) streamDotsWrap.classList.add('hidden');
							}
							if (window.convertTaskLinksInMessage) window.convertTaskLinksInMessage(bubble);
							if (window.convertTaskEditLinksInMessage) window.convertTaskEditLinksInMessage(bubble);
							if (window.cleanBubbleContent) window.cleanBubbleContent(bubble);
						}
					}
					function hasActiveChatStream() {
						var chatMessages = document.getElementById('chat-messages');
						if (!chatMessages) return false;
						var active = chatMessages.querySelector('.chat-bubble-assistant-msg .ov-loading-dots:not(.hidden), .chat-bubble-assistant-msg .loading-dots:not(.hidden), .chat-bubble-assistant-msg [id^="streaming-dots-"]:not(.hidden)');
						return !!active;
					}

				// Helper: create a streaming assistant bubble and connect to SSE
					function createStreamingBubble(execId) {
					var bubble = document.createElement('div');
					bubble.className = 'chat-bubble-assistant-msg rounded-xl p-4';

					var roleDiv = document.createElement('div');
					roleDiv.className = 'text-xs font-semibold opacity-50 mb-2';
					roleDiv.textContent = 'Assistant';

					var innerDiv = document.createElement('div');
					innerDiv.className = 'chat-bubble-inner';

						var thinking = document.createElement('div');
						thinking.id = 'streaming-thinking-resume-' + execId;
						thinking.className = 'flex flex-col items-start gap-1';
						thinking.innerHTML = '<span class="block h-5" aria-hidden="true"></span><span class="ov-loading-dots ov-loading-dots-sm" aria-hidden="true"><span class="ov-loading-dot"></span><span class="ov-loading-dot"></span><span class="ov-loading-dot"></span></span>';

						var progressDiv = document.createElement('div');
						progressDiv.id = 'mixture-progress-' + execId;
						progressDiv.className = 'mixture-progress hidden mb-2 text-xs opacity-70';
						progressDiv.setAttribute('data-exec-id', execId);
						progressDiv.setAttribute('role', 'status');
						progressDiv.setAttribute('aria-live', 'polite');

						var contentDiv = document.createElement('div');
						contentDiv.id = 'streaming-message-' + execId;
						contentDiv.className = 'whitespace-pre-wrap leading-relaxed text-sm hidden';
						contentDiv.style.wordWrap = 'break-word';
						contentDiv.setAttribute('data-exec-id', execId);
						contentDiv.setAttribute('data-streaming-resume', 'true');
						contentDiv.setAttribute('data-initial-byte-length', '0');
						contentDiv.setAttribute('data-messages-container', 'chat-messages');
						contentDiv.setAttribute('data-raw-content', '');
						var dots = document.createElement('div');
						dots.id = 'streaming-dots-resume-' + execId;
						dots.className = 'hidden flex items-center gap-1 mt-2 opacity-40';
					dots.innerHTML = '<span class="loading loading-dots loading-xs"></span>';

						innerDiv.appendChild(thinking);
						innerDiv.appendChild(progressDiv);
						innerDiv.appendChild(contentDiv);
						innerDiv.appendChild(dots);
					bubble.appendChild(roleDiv);
					bubble.appendChild(innerDiv);

						var textBuffer = '';
						var streamTextEncoder = window.TextEncoder ? new TextEncoder() : null;
						function utf8ByteLength(value) { return streamTextEncoder ? streamTextEncoder.encode(value || '').length : unescape(encodeURIComponent(value || '')).length; }
						function persistLiveStreamState(active) {
							contentDiv.setAttribute('data-raw-content', textBuffer);
							contentDiv.setAttribute('data-initial-byte-length', String(utf8ByteLength(textBuffer)));
							if (active) contentDiv.setAttribute('data-streaming-resume', 'true');
							else {
								contentDiv.removeAttribute('data-streaming-resume');
								delete contentDiv._sseConnected;
							}
						}
						var renderScheduled = false;
						var renderFrame = null;
						var renderGeneration = 0;
						var lastRenderedLength = 0;
						function renderBufferedOutput(force) {
						if (!window.renderStreamingContent) {
							contentDiv.textContent = textBuffer;
							return Promise.resolve(true);
						}
							if (!force && renderScheduled) return;
							var runRender = function() {
								renderFrame = null;
								var sourceLength = textBuffer.length;
								var renderText = textBuffer;
								if (!force && sourceLength === lastRenderedLength) {
									renderScheduled = false;
									return Promise.resolve(false);
								}
								var generation = ++renderGeneration;
								renderScheduled = true;
								var shouldScroll = !tracker || tracker.shouldAutoScroll();
								var renderIntentRevision = tracker ? (tracker.intentRevision || 0) : 0;
								var liveRenderer = window.renderLiveChatContent || window.renderStreamingContent;
								function finishRender(committed) {
									if (generation !== renderGeneration) return;
									renderScheduled = false;
									if (committed !== false) {
										lastRenderedLength = sourceLength;
										var renderIntentUnchanged = !tracker || (tracker.intentRevision || 0) === renderIntentRevision;
										var shouldScrollAfterRender = renderIntentUnchanged ? shouldScroll : (!tracker || tracker.shouldAutoScroll());
										if (shouldScrollAfterRender) {
											requestAnimationFrame(function() {
												var frameIntentUnchanged = !tracker || (tracker.intentRevision || 0) === renderIntentRevision;
												if (frameIntentUnchanged ? shouldScroll : (!tracker || tracker.shouldAutoScroll())) {
													if (chatMessages && window.chatAutoScroll) window.chatAutoScroll.scrollToBottom(chatMessages, false);
												}
											});
										}
									}
									if (textBuffer.length !== sourceLength) renderBufferedOutput(false);
								}
								var renderPromise = liveRenderer(contentDiv, renderText);
								if (renderPromise && typeof renderPromise.then === 'function') {
									return renderPromise.then(function(committed) {
										finishRender(committed);
										return committed;
									}).catch(function() {
										if (generation !== renderGeneration) return false;
										contentDiv.textContent = renderText;
										finishRender(true);
										return true;
									});
								}
								finishRender(true);
								return Promise.resolve(true);
							};
							if (force) {
								if (renderFrame !== null) cancelAnimationFrame(renderFrame);
								return runRender();
							}
							renderScheduled = true;
							renderFrame = requestAnimationFrame(runRender);
					}
					var chatMessages = document.getElementById('chat-messages');
					var tracker = window._chatPageTracker;

					var streamRetryCount = 0;
					var eventSource = null;
						function connectChatExecutionStream() {
							var streamOffset = utf8ByteLength(textBuffer);
							contentDiv._sseConnected = true;
							contentDiv.setAttribute('data-initial-byte-length', String(streamOffset));
							eventSource = new EventSource('/events/chat/' + execId + '?offset=' + encodeURIComponent(streamOffset));
							if (window.registerChatStreamEventSource) {
								window.registerChatStreamEventSource(execId, eventSource);
							}

						eventSource.onmessage = function(event) {
							if (window.hideMixtureProgress) window.hideMixtureProgress(execId);
							if (!thinking.classList.contains('hidden')) {
							thinking.classList.add('hidden');
							contentDiv.classList.remove('hidden');
							dots.classList.remove('hidden');
						}
							textBuffer += event.data;
							// Persist raw stream content and its UTF-8 offset in serializable DOM
							// attributes so HTMX history restoration can resume this live-created bubble.
							persistLiveStreamState(true);
							renderBufferedOutput(false);
					};

							eventSource.addEventListener('done', function(event) {
								if (window.hideMixtureProgress) window.hideMixtureProgress(execId);
								if (Object.prototype.hasOwnProperty.call(contentDiv, '_authoritativeTerminalContent')) {
									textBuffer = String(contentDiv._authoritativeTerminalContent || '');
								}
								persistLiveStreamState(false);
								var completedPair = bubble.closest('[data-execution-pair="true"]');
								if (window.applyChatExecutionTerminalStatus) window.applyChatExecutionTerminalStatus(completedPair, event && event.data ? event.data : 'completed');
									else if (completedPair) {
										completedPair.setAttribute('data-exec-status', event && event.data ? event.data : 'completed');
										completedPair.setAttribute('hx-preserve', 'true');
									}
									renderBufferedOutput(true);
						dots.classList.add('hidden');
						eventSource.close();
						if (window.unregisterChatStreamEventSource) {
							window.unregisterChatStreamEventSource(execId, eventSource);
						}
						// Always evaluate plan-completion first so prompt visibility updates
