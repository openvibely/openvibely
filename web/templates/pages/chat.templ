									setTimeout(connectChatExecutionStream, 150 * streamRetryCount);
									return;
								}
								var shouldScrollTerminalError = (!tracker || tracker.shouldAutoScroll()) || (chatMessages && window.chatAutoScroll && window.chatAutoScroll.isNearBottom(chatMessages));
								var terminalIntentRevision = tracker ? (tracker.intentRevision || 0) : 0;
								if (Object.prototype.hasOwnProperty.call(contentDiv, '_authoritativeTerminalContent')) {
