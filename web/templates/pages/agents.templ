package pages

import (
	"encoding/json"
	"fmt"
	"github.com/openvibely/openvibely/internal/models"
	"github.com/openvibely/openvibely/web/templates/layout"
)

templ Agents(projects []models.Project, currentProjectID string, agents []models.Agent, modelOptions []models.AgentModelOption) {
	@layout.Base("Agents", projects, currentProjectID) {
		@agentsContent(agents, modelOptions, false, CardListState{ProjectID: currentProjectID})
	}
}

templ AgentsPage(projects []models.Project, currentProjectID string, agents []models.Agent, modelOptions []models.AgentModelOption, hasMore bool) {
	@layout.Base("Agents", projects, currentProjectID) {
		@agentsContent(agents, modelOptions, hasMore, CardListState{ProjectID: currentProjectID})
	}
}

templ AgentsContent(agents []models.Agent, modelOptions []models.AgentModelOption) {
	@agentsContent(agents, modelOptions, false, CardListState{})
}

templ AgentsContentPage(agents []models.Agent, modelOptions []models.AgentModelOption, hasMore bool) {
	@agentsContent(agents, modelOptions, hasMore, CardListState{})
}

templ AgentsPageWithState(projects []models.Project, currentProjectID string, agents []models.Agent, modelOptions []models.AgentModelOption, hasMore bool, state CardListState) {
	@layout.Base("Agents", projects, currentProjectID) {
		@agentsContent(agents, modelOptions, hasMore, state)
	}
}

templ AgentsContentPageWithState(agents []models.Agent, modelOptions []models.AgentModelOption, hasMore bool, state CardListState) {
	@agentsContent(agents, modelOptions, hasMore, state)
}

func agentToolsJSON(tools []string) string {
	b, _ := json.Marshal(tools)
	return string(b)
}

func agentPluginsJSON(plugins []string) string {
	b, _ := json.Marshal(plugins)
	return string(b)
}

func agentToolConfigJSON(config models.AgentToolConfig) string {
	b, _ := json.Marshal(config)
	return string(b)
}

func agentSkillsJSON(skills []models.SkillConfig) string {
	b, _ := json.Marshal(skills)
	return string(b)
}

func agentMCPJSON(mcpServers []models.MCPServerConfig) string {
	b, _ := json.Marshal(mcpServers)
	return string(b)
}

func agentPermissionDefaultsJSON(perms models.AgentPermissionDefaults) string {
	b, _ := json.Marshal(perms)
	return string(b)
}

templ agentsContent(agents []models.Agent, modelOptions []models.AgentModelOption, hasMore bool, state CardListState) {
		<div id="agents-container" class="overflow-x-hidden max-w-full min-w-0" data-search-container data-card-pagination-root data-card-pagination-url={ CardListURL("agents", state) } data-card-pagination-list="#agents-card-list" data-card-pagination-card-selector="[data-agent-id]" data-card-pagination-key="data-agent-id" data-card-pagination-page-size="20" data-card-pagination-has-more={ cardPaginationHasMoreAttribute(hasMore) }>		@layout.PageTitle("Agents")
		<div class="flex items-center justify-between mb-6">
			<h2 class="text-2xl font-bold">Agents</h2>
			<button class="btn btn-primary btn-sm" onclick="openNewAgentModal()">
				+ Add Agent
			</button>
		</div>
		@CardListToolbar(collectionToolbarConfigWithState("agents", state))

			<div id="agents-card-list" data-card-pagination-list>
			if len(agents) == 0 {
				<div class="text-center py-12" data-search-empty-state>
				<p class="opacity-50 mb-4">No agents configured yet. Create one and attach plugins from marketplace resources.</p>
				<button class="btn btn-primary" onclick="openNewAgentModal()">
					Create Agent
				</button>
			</div>
		} else {
			<div class="grid grid-cols-1 gap-4 max-w-full min-w-0">
				for _, agent := range agents {
					<div
						class="card bg-base-100 shadow-sm border border-base-300 cursor-pointer hover:border-primary/40 hover:shadow-md transition-all w-full min-w-0 max-w-full"
						data-agent-id={ agent.ID }
						data-agent-name={ agent.Name }
						data-agent-description={ agent.Description }
						data-agent-system-prompt={ agent.SystemPrompt }
						data-agent-model={ agent.Model }
							data-agent-tools={ agentToolsJSON(agent.Tools) }
							data-agent-tool-config={ agentToolConfigJSON(agent.ToolConfig) }
							data-agent-plugins={ agentPluginsJSON(agent.Plugins) }
						data-agent-skills={ agentSkillsJSON(agent.Skills) }
						data-agent-mcp-servers={ agentMCPJSON(agent.MCPServers) }
						data-agent-key={ agent.Key }
						data-agent-scope={ string(agent.Scope) }
						data-agent-selectable-as-primary={ fmt.Sprintf("%t", agent.SelectableAsPrimary) }
						data-agent-enabled={ fmt.Sprintf("%t", agent.Enabled) }
						data-agent-permission-defaults={ agentPermissionDefaultsJSON(agent.PermissionDefaults) }
						data-agent-source-refs={ agentPluginsJSON(agent.SourceRefs) }
						data-agent-generated-status={ string(agent.GeneratedStatus) }
						data-search-card
						data-search-text={ agent.Name + " " + agent.Description + " " + agent.Model + " " + agent.SystemPrompt }
						data-card-select-id={ agent.ID }
						data-card-select-eligible={ boolString(agent.GeneratedStatus != models.AgentStatusProtected) }
						if agent.GeneratedStatus == models.AgentStatusProtected {
							data-card-select-disabled-reason="Protected agents cannot be deleted"
						}
						onclick="editAgentFromData(this)"
					>
						<div class="card-body relative">
							<div class="absolute top-4 right-4" onclick="event.stopPropagation()">
								<div class="dropdown dropdown-end">
									<label tabindex="0" class="btn btn-ghost btn-sm" onclick="handleDropdownToggle(event)">
										<svg xmlns="http://www.w3.org/2000/svg" class="h-4 w-4" fill="none" viewBox="0 0 24 24" stroke="currentColor">
											<path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 5v.01M12 12v.01M12 19v.01M12 6a1 1 0 110-2 1 1 0 010 2zm0 7a1 1 0 110-2 1 1 0 010 2zm0 7a1 1 0 110-2 1 1 0 010 2z"></path>
										</svg>
									</label>
									<ul tabindex="0" class="dropdown-content z-[100] menu p-2 shadow bg-base-100 rounded-box w-48 border border-base-300">
										<li>
											<button onclick="editAgentFromData(this.closest('[data-agent-id]'))">Edit</button>
										</li>
										if agent.GeneratedStatus == models.AgentStatusProtected {
											<li>
												<button class="opacity-40 cursor-not-allowed" disabled title="Protected system agents cannot be deleted">Delete (protected)</button>
											</li>
										} else {
											<li>
												<button
													class="text-error"
													data-agent-id={ agent.ID }
													data-agent-name={ agent.Name }
													onclick="openDeleteAgentConfirm(this)"
												>
													Delete
												</button>
											</li>
										}
									</ul>
								</div>
							</div>
							<div class="pr-12 min-w-0 max-w-full">
								<h3 class="font-bold">
									{ agent.Name }
								</h3>
								if agent.Description != "" {
									<p class="text-sm opacity-60 mt-1 line-clamp-2">{ agent.Description }</p>
								}
								<div class="flex flex-wrap gap-2 mt-2 max-w-full overflow-x-hidden">
									if agent.Model != "inherit" {
										<span class="badge badge-outline badge-sm max-w-full truncate">model: { agent.Model }</span>
									}
									if len(agent.Tools) > 0 {
										<span class="badge badge-outline badge-sm">{ fmt.Sprintf("%d tools", len(agent.Tools)) }</span>
									}
									if len(agent.Plugins) > 0 {
										<span class="badge badge-outline badge-sm">{ fmt.Sprintf("%d plugins", len(agent.Plugins)) }</span>
									}
									if len(agent.Skills) > 0 {
										<span class="badge badge-outline badge-sm">{ fmt.Sprintf("%d skills", len(agent.Skills)) }</span>
									}
									if len(agent.MCPServers) > 0 {
										<span class="badge badge-outline badge-sm">{ fmt.Sprintf("%d MCP servers", len(agent.MCPServers)) }</span>
									}
								</div>
								if agent.SystemPrompt != "" {
									<p class="text-xs opacity-40 mt-2 line-clamp-1">{ agent.SystemPrompt }</p>
								}
							</div>
						</div>
					</div>
				}
			</div>
		}
		</div>
			@CardPaginationStatusWithBoundary(hasMore)		@DestructiveConfirmDialog("delete_agent_confirm_modal", "Close delete agent confirmation", "Delete Agent", "Are you sure you want to delete ", "delete_agent_confirm_name", "", "? This action cannot be undone.", templ.ComponentScript{Call: "delete_agent_confirm_modal.close()"}, templ.ComponentScript{Call: "confirmDeleteAgent()"}) {
					Tasks using this agent will be unlinked.
				}

			<dialog id="agent_modal" class="modal" onclose="if (typeof syncToastContainerHost === 'function') syncToastContainerHost()">			<div class="modal-box max-w-4xl p-0 overflow-hidden">
				@ModalCloseButton("agent_modal", "Close agent dialog")
				<div class="px-6 pt-6 pb-2 pr-14">
					<h3 id="agent_modal_title" class="font-bold text-lg">New Agent</h3>
				</div>
				<form id="agent_form" method="post" action="/agents" class="flex flex-col h-[78vh]">
					<div class="px-6 pb-3 border-b border-base-300">
						<div role="tablist" class="tabs tabs-bordered tabs-sm w-full overflow-x-auto flex-nowrap">
							<button type="button" role="tab" class="tab tab-active" data-agent-section-tab="details" aria-selected="true" onclick="setAgentSection('details')">Agent Details</button>
							<button type="button" role="tab" class="tab" data-agent-section-tab="plugins" aria-selected="false" onclick="setAgentSection('plugins')">Plugins</button>
							<button type="button" role="tab" class="tab" data-agent-section-tab="marketplace" aria-selected="false" onclick="setAgentSection('marketplace')">Marketplace</button>
								<button type="button" role="tab" class="tab" data-agent-section-tab="skills" aria-selected="false" onclick="setAgentSection('skills')">Skills</button>
								<button type="button" role="tab" class="tab" data-agent-section-tab="lifecycle" aria-selected="false" onclick="setAgentSection('lifecycle')">Lifecycle Hooks</button>
								<button type="button" role="tab" class="tab" data-agent-section-tab="advanced" aria-selected="false" onclick="setAgentSection('advanced')">Advanced</button>
						</div>
					</div>

					<div class="flex-1 min-h-0 px-6 py-3">
						<div data-agent-section-panel="details" class="h-full overflow-y-auto pr-1">
							<div class="form-control mb-3">
								<label class="label"><span class="label-text">Name</span></label>
								<input type="text" id="agent_name" name="name" class="input input-bordered" required placeholder="my-agent"/>
							</div>
							<div class="form-control mb-3">
								<label class="label"><span class="label-text">Description</span></label>
								<p class="text-xs opacity-60 mb-2">Generation uses selected plugins when helpful. If none are selected, it generates from this description only.</p>
								<div class="flex gap-2">
									<input type="text" id="agent_description" name="description" class="input input-bordered flex-1" placeholder="e.g., Review UI components with Playwright and suggest accessibility fixes"/>
									<button type="button" id="agent_generate_btn" class="btn btn-outline" onclick="generateAgentFromPrompt()">Generate</button>
								</div>
								<p id="agent_generated_summary" class="text-xs opacity-70 mt-2"></p>
							</div>
							<div class="form-control mb-3">
								<label class="label"><span class="label-text">System Prompt</span></label>
								<textarea id="agent_system_prompt" name="system_prompt" class="textarea textarea-bordered h-32" placeholder="You are a specialized agent that..."></textarea>
							</div>

							<div class="grid grid-cols-1 gap-3 mb-3">
								<div class="form-control">
									<label class="label"><span class="label-text">Model</span></label>
									<select id="agent_model" name="model" class="select select-bordered">
										<option value="inherit">Inherit (from task)</option>
										for _, option := range modelOptions {
											<option value={ option.Value }>{ option.Label }</option>
										}
									</select>
								</div>
							</div>
							<div class="divider text-sm opacity-50">Allowed Tools</div>
								<div class="flex flex-wrap gap-2 mb-3" id="agent_tools_checkboxes">
									for _, tool := range models.AllAgentTools {
										<label class="label cursor-pointer gap-1 px-2 py-1 border border-base-300 rounded-lg">
											<input type="checkbox" class="checkbox checkbox-sm agent-tool-checkbox" value={ tool } onchange="updateScopedFilesControlsVisibility()"/>
											<span class="label-text text-sm">{ tool }</span>
										</label>
									}
								</div>
								<div id="scoped_files_config" class="hidden border border-base-300 rounded-lg p-3 mb-3 bg-base-200/30">
									<p class="text-sm font-medium mb-1">Scoped Files</p>
									<p class="text-xs opacity-60 mb-3">Restrict file tools to a project-relative directory.</p>
									<div class="form-control mb-3">
										<label class="label"><span class="label-text text-sm">Directory</span></label>
										<input type="text" id="scoped_files_directory" class="input input-bordered input-sm" placeholder=".openvibely/memories" value=".openvibely/memories" aria-describedby="scoped_files_directory_error" oninput="validateScopedFilesDirectoryInput()" onblur="validateScopedFilesDirectoryInput()"/>
										<p id="scoped_files_directory_error" class="hidden text-xs text-error mt-1"></p>
									</div>
									<div class="grid grid-cols-1 md:grid-cols-3 gap-2 mb-3">
										<label class="label cursor-pointer gap-2 justify-start border border-base-300 rounded-lg px-2 py-1">
											<input type="checkbox" id="scoped_files_perm_read" class="checkbox checkbox-sm" checked/>
											<span class="label-text text-sm">Read</span>
										</label>
										<label class="label cursor-pointer gap-2 justify-start border border-base-300 rounded-lg px-2 py-1">
											<input type="checkbox" id="scoped_files_perm_write" class="checkbox checkbox-sm" checked/>
											<span class="label-text text-sm">Write</span>
										</label>
										<label class="label cursor-pointer gap-2 justify-start border border-base-300 rounded-lg px-2 py-1">
											<input type="checkbox" id="scoped_files_perm_delete" class="checkbox checkbox-sm"/>
											<span class="label-text text-sm">Delete</span>
										</label>
									</div>
										<label class="label cursor-pointer gap-2 justify-start">
											<input type="checkbox" id="scoped_files_skip_default_tools" class="checkbox checkbox-sm"/>
											<span class="label-text text-sm">Disable default repo tools for this agent</span>
										</label>
										<label class="label cursor-pointer gap-2 justify-start">
											<input type="checkbox" id="scoped_files_use_runtime_worktree" class="checkbox checkbox-sm" checked/>
											<span class="label-text text-sm">Use runtime task worktrees</span>
										</label>
								</div>
						</div>

						<div data-agent-section-panel="plugins" class="h-full overflow-y-auto pr-1 hidden">
							<div class="space-y-3">
								<div class="border border-base-300 rounded-lg p-3">
									<div class="flex items-center justify-between mb-2">
										<p class="text-sm font-medium">Plugins</p>
										<p id="plugin_selected_count" class="text-xs opacity-60">No plugins selected</p>
									</div>
									<div class="mb-2">
										<input
											type="text"
											id="plugin_search_input"
											class="input input-bordered input-sm w-full"
											placeholder="Search plugins by name"
											oninput="debouncedRenderPluginCatalog()"
										/>
									</div>
									<div id="plugin_catalog_loading" class="hidden mb-2 text-xs opacity-70 flex items-center gap-2">
										<span class="loading loading-spinner loading-xs"></span>
										<span>Loading marketplace data...</span>
									</div>
									<div id="plugin_catalog" class="space-y-2 max-h-[500px] overflow-auto"></div>
								</div>
							</div>
						</div>

						<div data-agent-section-panel="marketplace" class="h-full overflow-y-auto pr-1 hidden">
							<div class="space-y-3">
								<div class="border border-base-300 rounded-lg p-3">
									<p class="text-sm font-medium mb-2">Plugin Marketplace</p>
									<div class="flex flex-wrap gap-2 mb-3">
										<input id="plugin_marketplace_source" class="input input-bordered input-sm flex-1 min-w-[16rem]" placeholder="GitHub repo, URL, or local path"/>
										<button id="plugin_marketplace_add_btn" type="button" class="btn btn-outline btn-sm" onclick="addPluginMarketplace()">Add</button>
										<button id="plugin_marketplace_restore_btn" type="button" class="btn btn-ghost btn-sm" onclick="resetDefaultPluginMarketplaces()">Restore Defaults</button>
									</div>
									<p id="plugin_marketplace_action_status" class="hidden text-xs mb-2"></p>
									<div id="plugin_marketplace_list" class="space-y-2"></div>
								</div>
							</div>
						</div>

							<div data-agent-section-panel="skills" class="h-full overflow-y-auto pr-1 hidden">
								<div class="space-y-3">
									<div class="alert alert-info text-sm">
										Assigned-agent tasks route from this agent's indexed skills. Standalone skills are routed only for tasks with no assigned agent.
									</div>
									<div id="agent_skills_system_notice" class="hidden alert alert-warning text-sm">This is a protected built-in/system agent. Routed skills are read-only here.</div>
									<div class="border border-base-300 rounded-lg p-3 bg-base-200/30">
										<p class="text-sm font-medium mb-1">Router Preview</p>
										<p id="agent_skills_router_summary" class="text-xs opacity-70">Save this agent to preview routed skills.</p>
										<pre id="agent_skills_router_index" class="text-xs whitespace-pre-wrap mt-2 max-h-36 overflow-auto hidden"></pre>
									</div>
									<div class="border border-base-300 rounded-lg p-3">
										<div class="flex items-center justify-between gap-2 mb-2">
											<p class="text-sm font-medium">Skills</p>
											<button type="button" id="agent_skill_new_btn" class="btn btn-outline btn-xs" onclick="startNewAgentOwnedSkill()">+ New Skill</button>
										</div>
										<div id="agent_skills_list" class="space-y-2"></div>
									</div>
									<div id="agent_skill_editor" class="hidden border border-base-300 rounded-lg p-3 bg-base-100">
										<div class="grid grid-cols-1 md:grid-cols-3 gap-2 mb-2">
											<label class="form-control"><span class="label-text text-xs">Skill key</span><input id="agent_skill_handle" class="input input-bordered input-sm" placeholder="review_migrations"/></label>
											<label class="form-control"><span class="label-text text-xs">Name</span><input id="agent_skill_name" class="input input-bordered input-sm" placeholder="Review migrations"/></label>
											<label class="form-control"><span class="label-text text-xs">Scope</span><select id="agent_skill_scope" class="select select-bordered select-sm"><option value="project">Project</option><option value="global">Global</option></select></label>
										</div>
										<label class="form-control mb-2"><span class="label-text text-xs">Description</span><input id="agent_skill_description" class="input input-bordered input-sm" placeholder="When this skill should be selected"/></label>
										<label class="form-control"><span class="label-text text-xs">SKILL.md body or full SKILL.md</span><textarea id="agent_skill_body" class="textarea textarea-bordered h-40 font-mono text-xs" placeholder="Instructions for this skill..."></textarea></label>
										<div class="flex justify-end gap-2 mt-3">
										<button type="button" class="btn btn-ghost btn-sm" onclick="cancelAgentOwnedSkillEdit()">Cancel</button>
										<button type="button" id="agent_skill_save_btn" class="btn btn-primary btn-sm" onclick="saveAgentOwnedSkill()">Save Skill</button>
									</div>
									</div>
									<p id="agent_skills_status" class="hidden text-xs mt-2"></p>
								</div>
							</div>

								<div data-agent-section-panel="lifecycle" class="h-full overflow-y-auto pr-1 hidden">							<div class="space-y-3">
										<p class="text-sm opacity-70">Lifecycle hooks are implementation hooks, usually for system/lifecycle agents. Normal assigned agents usually need skills, not custom hooks.</p>
										<div class="alert alert-info text-sm">Task execution is separate from hooks: route_task selects skills, before_run can add context, after_complete observes and learns. task_mode is internal and is not configurable here.</div>
									<div id="lifecycle_hooks_protected_banner" class="hidden alert alert-warning text-sm">
										This agent is protected. Lifecycle hooks are shown read-only.
									</div>
									<div id="lifecycle_hooks_list" class="space-y-2"></div>
									<button type="button" class="btn btn-outline btn-sm" id="lifecycle_hooks_add_btn" onclick="addLifecycleHookRow()">+ Add Hook</button>
									<p id="lifecycle_hooks_status" class="hidden text-xs mt-2"></p>
									<div class="divider text-sm opacity-50">Lifecycle Policy Defaults</div>
									<p class="text-sm opacity-70">Defaults applied to this agent's lifecycle hooks unless an individual hook overrides them. These do not grant callable tools; use Allowed Tools on Agent Details for concrete tool access.</p>
									<div class="alert alert-info text-sm">Tool scope: skill_view reads selected skills for the current task scope; skills_list lists standalone skills; skill_manage writes standalone skills; agent_skill_manage is an after-complete learning tool scoped to the task's assigned agent.</div>
									<div class="grid grid-cols-1 md:grid-cols-2 gap-2">
									<label class="label cursor-pointer gap-2 justify-start border border-base-300 rounded-lg px-3 py-2">
										<input type="checkbox" id="perm_read_task_prompt" class="checkbox checkbox-sm"/>
										<span class="label-text text-sm">Read task prompt</span>
									</label>
									<label class="label cursor-pointer gap-2 justify-start border border-base-300 rounded-lg px-3 py-2">
										<input type="checkbox" id="perm_read_task_execution" class="checkbox checkbox-sm"/>
										<span class="label-text text-sm">Read task execution output</span>
									</label>
									<label class="label cursor-pointer gap-2 justify-start border border-base-300 rounded-lg px-3 py-2">
										<input type="checkbox" id="perm_read_project_memory" class="checkbox checkbox-sm"/>
										<span class="label-text text-sm">Read project memory</span>
									</label>
									<label class="label cursor-pointer gap-2 justify-start border border-base-300 rounded-lg px-3 py-2">
										<input type="checkbox" id="perm_write_project_memory" class="checkbox checkbox-sm"/>
										<span class="label-text text-sm">Write project memory</span>
									</label>
									<label class="label cursor-pointer gap-2 justify-start border border-base-300 rounded-lg px-3 py-2">
										<input type="checkbox" id="perm_read_agents" class="checkbox checkbox-sm"/>
										<span class="label-text text-sm">Read agents</span>
									</label>
									<label class="label cursor-pointer gap-2 justify-start border border-base-300 rounded-lg px-3 py-2">
										<input type="checkbox" id="perm_write_agents" class="checkbox checkbox-sm"/>
										<span class="label-text text-sm">Write agents</span>
									</label>
									<label class="label cursor-pointer gap-2 justify-start border border-base-300 rounded-lg px-3 py-2">
										<input type="checkbox" id="perm_read_skills" class="checkbox checkbox-sm"/>
										<span class="label-text text-sm">Read skills</span>
									</label>
									<label class="label cursor-pointer gap-2 justify-start border border-base-300 rounded-lg px-3 py-2">
										<input type="checkbox" id="perm_write_skills" class="checkbox checkbox-sm"/>
										<span class="label-text text-sm">Write skills</span>
									</label>
									<label class="label cursor-pointer gap-2 justify-start border border-base-300 rounded-lg px-3 py-2">
										<input type="checkbox" id="perm_read_repository_files" class="checkbox checkbox-sm"/>
										<span class="label-text text-sm">Read repository files</span>
									</label>
									<label class="label cursor-pointer gap-2 justify-start border border-base-300 rounded-lg px-3 py-2">
										<input type="checkbox" id="perm_write_repository_files" class="checkbox checkbox-sm"/>
										<span class="label-text text-sm">Write repository files</span>
									</label>
									<label class="label cursor-pointer gap-2 justify-start border border-base-300 rounded-lg px-3 py-2">
										<input type="checkbox" id="perm_use_shell_or_tools" class="checkbox checkbox-sm"/>
										<span class="label-text text-sm">Use shell / external tools</span>
									</label>
									</div>
								</div>
							</div>

								<div data-agent-section-panel="advanced" class="h-full overflow-y-auto pr-1 hidden">
								<div class="space-y-3">
								<p class="text-sm opacity-70">Identity and scope. Most agents do not need to change these.</p>
								<div class="grid grid-cols-1 md:grid-cols-2 gap-2">
									<div class="form-control">
										<label class="label"><span class="label-text">Agent key (slug)</span></label>
										<input type="text" id="advanced_key" class="input input-bordered input-sm" placeholder="my-agent"/>
										<p class="text-xs opacity-60 mt-1">Lowercase letters, digits, _ -. Used as a stable identifier.</p>
									</div>
									<div class="form-control">
										<label class="label"><span class="label-text">Scope</span></label>
										<select id="advanced_scope" class="select select-bordered select-sm">
											<option value="global">Global (app data)</option>
											<option value="project">Project-scoped</option>
										</select>
									</div>
								</div>
								<div class="grid grid-cols-1 md:grid-cols-3 gap-2">
									<label class="label cursor-pointer gap-2 justify-start border border-base-300 rounded-lg px-3 py-2">
										<input type="checkbox" id="advanced_selectable_as_primary" class="checkbox checkbox-sm"/>
										<span class="label-text text-sm">Selectable as primary agent</span>
									</label>
									<label class="label cursor-pointer gap-2 justify-start border border-base-300 rounded-lg px-3 py-2">
										<input type="checkbox" id="advanced_enabled" class="checkbox checkbox-sm" checked/>
										<span class="label-text text-sm">Enabled</span>
									</label>
								</div>
								<div class="form-control">
									<label class="label"><span class="label-text">Source evidence URLs (one per line)</span></label>
									<textarea id="advanced_source_refs" class="textarea textarea-bordered h-16" placeholder="e.g. https://example.com/runbook"></textarea>
								</div>
								<p id="advanced_protected_notice" class="hidden alert alert-info text-sm">This is a built-in protected agent. Identity and scope fields are read-only.</p>
							</div>
						</div>
					</div>
						<input type="hidden" id="agent_tools_json" name="tools_json"/>
						<input type="hidden" id="agent_tool_config_json" name="tool_config_json"/>
						<input type="hidden" id="agent_plugins_json" name="plugins_json"/>
					<input type="hidden" id="agent_skills_json" name="skills_json"/>
					<input type="hidden" id="agent_mcp_servers_json" name="mcp_servers_json"/>
					<input type="hidden" id="agent_permission_defaults_json" name="permission_defaults_json"/>
					<input type="hidden" id="agent_lifecycle_hooks_json" name="lifecycle_hooks_json"/>
					<input type="hidden" id="agent_source_refs_json" name="source_refs_json"/>
					<input type="hidden" id="agent_key_field" name="key"/>
					<input type="hidden" id="agent_scope_field" name="scope"/>
					<input type="hidden" id="agent_selectable_as_primary_field" name="selectable_as_primary"/>
					<input type="hidden" id="agent_enabled_field" name="enabled"/>

					<div class="modal-action mt-0 sticky bottom-0 z-10 border-t border-base-300 bg-base-100 px-6 py-3">
						<button type="button" class="btn" onclick="agent_modal.close()">Cancel</button>
						<button type="submit" class="btn btn-primary" onclick="serializeAgentFormData()">Save</button>
					</div>
				</form>
			</div>
			<form method="dialog" class="modal-backdrop"><button>close</button></form>
		</dialog>

		<script>
			// Returns "?project_id=<id>" when the current page URL has a
			// project_id param, or "" for global-scope views.
			function currentProjectQueryString() {
				const params = new URLSearchParams(window.location.search || '');
				const projectID = (params.get('project_id') || '').trim();
				return projectID ? ('?project_id=' + encodeURIComponent(projectID)) : '';
			}

			// Appends the current project_id query string to a URL that has no
			// existing query string of its own.
			function withCurrentProject(url) {
				return url + currentProjectQueryString();
			}

			function withCurrentAgentListState(url) {
				var scoped = withCurrentProject(url);
				if (window.cardCollectionActionURL) return window.cardCollectionActionURL(document.getElementById('agents-container'), scoped);
				return scoped;
			}

			let agentPluginState = { marketplaces: [], installed: [], available: [], runtime: [] };
			let selectedPluginIDs = [];
			let generatedSkillsState = [];
					let generatedMCPServersState = [];
					let agentOwnedSkillsState = { routed_skills: [], can_manage: false, protected: false };
				let editingAgentSkillOriginalHandle = '';
				let activeAgentSection = 'details';
					let activeAgentID = '';
					var deleteAgentID = '';
		let installingPluginIDs = new Set();
		let uninstallingPluginIDs = new Set();
		let pendingUninstalledPluginIDs = new Set();
		let addingMarketplace = false;
		let removingMarketplaceNames = new Set();
		let syncingMarketplaceNames = new Set();
		let restoringDefaultMarketplaces = false;

				function openDeleteAgentConfirm(button) {
					if (!button) return;
					deleteAgentID = button.dataset.agentId || '';
					if (!deleteAgentID) return;
						window.openDestructiveConfirmDialog('delete_agent_confirm_modal', 'delete_agent_confirm_name', button.dataset.agentName || 'this agent');
				}

				async function confirmDeleteAgent() {
					if (!deleteAgentID) return;
					var id = deleteAgentID;
					var modal = document.getElementById('delete_agent_confirm_modal');
					if (modal) modal.close();
					var container = document.getElementById('agents-container');
					var deleteURL = withCurrentAgentListState('/agents/' + encodeURIComponent(id));
					if (window.cardPaginationRefreshURL) deleteURL = window.cardPaginationRefreshURL(container, deleteURL);
					try {
						const response = await fetch(deleteURL, {
							method: 'DELETE',
							headers: { 'HX-Request': 'true' }
						});
						if (!response.ok) {
							throw new Error(await response.text() || 'Delete failed');
						}
						const html = await response.text();
						if (container && typeof window.replaceSearchableCardContainer === 'function') {
							window.replaceSearchableCardContainer('#agents-container', html);
						} else if (container) {
							if (typeof window.destroyCardPagination === 'function') window.destroyCardPagination(container, true);
							container.outerHTML = html;
							const refreshedContainer = document.getElementById('agents-container');
							if (window.htmx) htmx.process(refreshedContainer);
							if (window.refreshCardSearches) window.refreshCardSearches(refreshedContainer);
							if (window.refreshCardPagination) window.refreshCardPagination(refreshedContainer);
						}
						deleteAgentID = '';
						if (window.showToast) window.showToast('Agent deleted', 'completed');
					} catch (err) {
						console.error('confirmDeleteAgent', err);
						if (window.showToast) window.showToast(String(err.message || 'Could not delete agent'), 'failed');
					}
				}

				function setAgentSection(sectionName) {
					const sectionNameMap = {
						details: 'details',
								plugins: 'plugins',
								marketplace: 'marketplace',
								skills: 'skills',
								lifecycle: 'lifecycle',
								advanced: 'advanced',
					};
					const nextSection = sectionNameMap[sectionName] || 'details';
					activeAgentSection = nextSection;
					document.querySelectorAll('[data-agent-section-tab]').forEach(tab => {
					const isActive = tab.dataset.agentSectionTab === nextSection;
					tab.classList.toggle('tab-active', isActive);
					tab.setAttribute('aria-selected', isActive ? 'true' : 'false');
				});
				document.querySelectorAll('[data-agent-section-panel]').forEach(panel => {
					panel.classList.toggle('hidden', panel.dataset.agentSectionPanel !== nextSection);
				});
			}

			let pluginSearchTerm = '';
			let pluginRenderTimer = null;
			let pluginCatalogLoading = false;
			let pluginStateRequestToken = 0;
			let pluginStateLoadInFlight = 0;

		function debouncedRenderPluginCatalog() {
			if (pluginRenderTimer) {
				clearTimeout(pluginRenderTimer);
			}
			pluginRenderTimer = setTimeout(() => {
				pluginRenderTimer = null;
				renderPluginCatalog();
			}, 150);
		}

		function resetGeneratedState() {
			generatedSkillsState = [];
			generatedMCPServersState = [];
			document.getElementById('agent_generated_summary').textContent = '';
		}

		function updateGeneratedSummary() {
			const skillCount = Array.isArray(generatedSkillsState) ? generatedSkillsState.length : 0;
			const mcpCount = Array.isArray(generatedMCPServersState) ? generatedMCPServersState.length : 0;
			const summary = document.getElementById('agent_generated_summary');
			if (skillCount === 0 && mcpCount === 0) {
				summary.textContent = '';
				return;
			}
			summary.textContent = `Generated extras: ${skillCount} skills, ${mcpCount} MCP servers`;
		}

		function escapeHtml(value) {
			return String(value || '')
				.replaceAll('&', '&amp;')
				.replaceAll('<', '&lt;')
				.replaceAll('>', '&gt;')
				.replaceAll('"', '&quot;')
				.replaceAll("'", '&#39;');
		}

		function normalizePluginID(item) {
			if (!item || typeof item !== 'object') return '';
			if (typeof item.pluginId === 'string' && item.pluginId.trim()) return item.pluginId.trim();
			if (typeof item.id === 'string' && item.id.trim()) return item.id.trim();
			return '';
		}

		function setAgentModelSelection(value) {
			const select = document.getElementById('agent_model');
			if (!select) return;
			const requested = String(value || '').trim() || 'inherit';
			const hasOption = Array.from(select.options).some(opt => opt.value === requested);
			select.value = hasOption ? requested : 'inherit';
		}

			function setAgentTools(tools) {
				const allowed = Array.isArray(tools) ? tools : [];
				document.querySelectorAll('.agent-tool-checkbox').forEach(cb => {
					cb.checked = allowed.includes(cb.value);
				});
				updateScopedFilesControlsVisibility();
			}

			function scopedFilesSelected() {
				const cb = Array.from(document.querySelectorAll('.agent-tool-checkbox')).find(item => item.value === 'ScopedFiles');
				return Boolean(cb && cb.checked);
			}

				function updateScopedFilesControlsVisibility() {
					const panel = document.getElementById('scoped_files_config');
					if (!panel) return;
					const selected = scopedFilesSelected();
					panel.classList.toggle('hidden', !selected);
					if (selected) {
						validateScopedFilesDirectoryInput();
					} else {
						setScopedFilesDirectoryError('');
					}
				}

				function getScopedFilesDirectoryError(value) {
					const raw = String(value || '').trim();
					if (!raw) return '';
					if (raw.startsWith('/') || raw.startsWith('\\\\') || raw.startsWith('~')) {
						return 'Use a project-relative directory, for example .openvibely/memories or docs.';
					}
					const normalized = raw.replaceAll('\\\\', '/');
					const parts = normalized.split('/').filter(part => part && part !== '.');
					let depth = 0;
					for (const part of parts) {
						if (part === '..') {
							if (depth === 0) {
								return 'Directory must stay inside the project, for example .openvibely/memories or docs.';
							}
							depth -= 1;
						} else {
							depth += 1;
						}
					}
					return '';
				}

				function setScopedFilesDirectoryError(message) {
					const input = document.getElementById('scoped_files_directory');
					const error = document.getElementById('scoped_files_directory_error');
					if (!input || !error) return;
					const text = String(message || '').trim();
					input.classList.toggle('input-error', Boolean(text));
					input.setAttribute('aria-invalid', text ? 'true' : 'false');
					error.textContent = text;
					error.classList.toggle('hidden', !text);
				}

				function validateScopedFilesDirectoryInput() {
					const input = document.getElementById('scoped_files_directory');
					if (!input || !scopedFilesSelected()) {
						setScopedFilesDirectoryError('');
						return true;
					}
					const message = getScopedFilesDirectoryError(input.value);
					setScopedFilesDirectoryError(message);
					return !message;
				}

				function setAgentToolConfig(config) {
					const normalized = config && typeof config === 'object' ? config : {};
					const scoped = Array.isArray(normalized.scoped_files) && normalized.scoped_files.length > 0 ? normalized.scoped_files[0] : {};
					const permissions = Array.isArray(scoped.permissions) ? scoped.permissions : [];
					document.getElementById('scoped_files_directory').value = scoped.directory || '.openvibely/memories';
					validateScopedFilesDirectoryInput();
					document.getElementById('scoped_files_perm_read').checked = permissions.length === 0 || permissions.includes('read');
					document.getElementById('scoped_files_perm_write').checked = permissions.length === 0 || permissions.includes('write');
					document.getElementById('scoped_files_perm_delete').checked = permissions.includes('delete');
					document.getElementById('scoped_files_skip_default_tools').checked = Boolean(normalized.skip_default_tools);
					document.getElementById('scoped_files_use_runtime_worktree').checked = !Boolean(normalized.disable_runtime_worktree);
				}

				function buildAgentToolConfig() {
					if (!scopedFilesSelected()) return {};
					const permissions = [];
					if (document.getElementById('scoped_files_perm_read').checked) permissions.push('read');
					if (document.getElementById('scoped_files_perm_write').checked) permissions.push('write');
					if (document.getElementById('scoped_files_perm_delete').checked) permissions.push('delete');
					return {
						scoped_files: [{
							directory: document.getElementById('scoped_files_directory').value || '.openvibely/memories',
							permissions: permissions.length > 0 ? permissions : ['read'],
						}],
						skip_default_tools: document.getElementById('scoped_files_skip_default_tools').checked,
						disable_runtime_worktree: !document.getElementById('scoped_files_use_runtime_worktree').checked,
					};
				}

		function refreshSelectedPluginsFromDOM() {
			const ids = [];
			document.querySelectorAll('.agent-plugin-checkbox:checked').forEach(cb => {
				const id = String(cb.value || '').trim();
				if (id) ids.push(id);
			});
			selectedPluginIDs = Array.from(new Set(ids)).sort();
			renderSelectedPluginCount();
		}

		function renderSelectedPluginCount() {
			const el = document.getElementById('plugin_selected_count');
			if (!el) return;
			el.textContent = selectedPluginIDs.length > 0
				? `${selectedPluginIDs.length} selected`
				: 'No plugins selected';
		}

		function setPluginCatalogLoading(isLoading) {
			pluginCatalogLoading = Boolean(isLoading);
			const loadingEl = document.getElementById('plugin_catalog_loading');
			if (loadingEl) {
				loadingEl.classList.toggle('hidden', !pluginCatalogLoading);
			}
			const catalogEl = document.getElementById('plugin_catalog');
			if (catalogEl) {
				catalogEl.setAttribute('aria-busy', pluginCatalogLoading ? 'true' : 'false');
			}
			renderPluginCatalog();
		}

		function setPluginInstallInProgress(pluginID, inProgress) {
			const id = String(pluginID || '').trim();
			if (!id) return;
			if (inProgress) {
				installingPluginIDs.add(id);
			} else {
				installingPluginIDs.delete(id);
			}
			renderPluginCatalog();
		}

		function setPluginUninstallInProgress(pluginID, inProgress) {
			const id = String(pluginID || '').trim();
			if (!id) return;
			if (inProgress) {
				uninstallingPluginIDs.add(id);
			} else {
				uninstallingPluginIDs.delete(id);
			}
			renderPluginCatalog();
		}

		function setMarketplaceActionStatus(message, type) {
			const statusEl = document.getElementById('plugin_marketplace_action_status');
			if (!statusEl) return;
			const text = String(message || '').trim();
			if (!text) {
				statusEl.textContent = '';
				statusEl.classList.add('hidden');
				statusEl.classList.remove('text-error', 'text-success', 'opacity-70');
				return;
			}
			statusEl.textContent = text;
			statusEl.classList.remove('hidden', 'text-error', 'text-success', 'opacity-70');
			if (type === 'error') {
				statusEl.classList.add('text-error');
			} else if (type === 'success') {
				statusEl.classList.add('text-success');
			} else {
				statusEl.classList.add('opacity-70');
			}
		}

		function hasActiveMarketplaceAction() {
			return addingMarketplace || restoringDefaultMarketplaces || syncingMarketplaceNames.size > 0 || removingMarketplaceNames.size > 0;
		}

		function hasActivePluginMutation() {
			return installingPluginIDs.size > 0 || uninstallingPluginIDs.size > 0;
		}

		function renderPluginMarketplaces() {
			const root = document.getElementById('plugin_marketplace_list');
			if (!root) return;
			const addBtn = document.getElementById('plugin_marketplace_add_btn');
			const sourceInput = document.getElementById('plugin_marketplace_source');
			const restoreBtn = document.getElementById('plugin_marketplace_restore_btn');
			const anyMarketplaceAction = hasActiveMarketplaceAction();
			if (addBtn) {
				addBtn.disabled = anyMarketplaceAction;
				addBtn.setAttribute('aria-busy', addingMarketplace ? 'true' : 'false');
				addBtn.innerHTML = addingMarketplace
					? '<span class="loading loading-spinner loading-xs"></span> Adding...'
					: 'Add';
			}
			if (sourceInput) {
				sourceInput.disabled = anyMarketplaceAction;
				sourceInput.setAttribute('aria-busy', addingMarketplace ? 'true' : 'false');
			}
			if (restoreBtn) {
				restoreBtn.disabled = anyMarketplaceAction;
				restoreBtn.setAttribute('aria-busy', restoringDefaultMarketplaces ? 'true' : 'false');
				restoreBtn.innerHTML = restoringDefaultMarketplaces
					? '<span class="loading loading-spinner loading-xs"></span> Restoring...'
					: 'Restore Defaults';
			}
			const marketplaces = Array.isArray(agentPluginState.marketplaces) ? agentPluginState.marketplaces : [];
			if (marketplaces.length === 0) {
				root.innerHTML = '<p class="text-xs opacity-60">No marketplaces configured.</p>';
				return;
			}
			root.innerHTML = marketplaces.map(mp => {
				const source = mp.url || mp.source || mp.repo || '';
				const name = String(mp.name || source || 'marketplace');
				const safeName = escapeHtml(name);
				const isSyncing = syncingMarketplaceNames.has(name);
				const isRemoving = removingMarketplaceNames.has(name);
				const disableSync = anyMarketplaceAction;
				const disableRemove = anyMarketplaceAction;
				const syncLabel = isSyncing ? 'Syncing marketplace "' + safeName + '"' : 'Sync marketplace "' + safeName + '"';
				const removeLabel = isRemoving ? 'Removing marketplace "' + safeName + '"' : 'Remove marketplace "' + safeName + '"';
				return `
					<div class="border border-base-300 rounded-lg p-2 flex items-start justify-between gap-2">
						<div class="min-w-0">
							<div class="font-medium text-sm truncate">${safeName}</div>
							<div class="text-xs opacity-60 break-all">${escapeHtml(source)}</div>
						</div>
						<div class="flex items-center gap-1.5">
							<button
								type="button"
								class="btn btn-ghost btn-xs btn-square"
								data-sync-marketplace-name="${safeName}"
								title="${syncLabel}"
								aria-label="${syncLabel}"
								${disableSync ? 'disabled' : ''}
								${isSyncing ? 'aria-busy="true"' : ''}
								onclick="updatePluginMarketplace('${safeName}')"
							>
								${isSyncing
									? '<span class="loading loading-spinner loading-xs"></span>'
									: '<svg xmlns="http://www.w3.org/2000/svg" class="h-4 w-4" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M21.5 2v6h-6M2.5 22v-6h6M2 11.5a10 10 0 0 1 18.8-4.3M22 12.5a10 10 0 0 1-18.8 4.2"/></svg>'}
							</button>
							<button
								type="button"
								class="btn btn-ghost btn-xs btn-square text-error"
								data-remove-marketplace-name="${safeName}"
								title="${removeLabel}"
								aria-label="${removeLabel}"
								${disableRemove ? 'disabled' : ''}
								${isRemoving ? 'aria-busy="true"' : ''}
								onclick="deletePluginMarketplace('${safeName}')"
							>
								${isRemoving
									? '<span class="loading loading-spinner loading-xs"></span>'
									: '<svg xmlns="http://www.w3.org/2000/svg" class="h-4 w-4" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path stroke-linecap="round" stroke-linejoin="round" d="M3 6h18"></path><path stroke-linecap="round" stroke-linejoin="round" d="M8 6V4a1 1 0 011-1h6a1 1 0 011 1v2"></path><path stroke-linecap="round" stroke-linejoin="round" d="M19 6l-1 14a2 2 0 01-2 2H8a2 2 0 01-2-2L5 6"></path><path stroke-linecap="round" stroke-linejoin="round" d="M10 11v6"></path><path stroke-linecap="round" stroke-linejoin="round" d="M14 11v6"></path></svg>'}
							</button>
						</div>
					</div>`;
			}).join('');
		}

		function buildPluginCatalogItems() {
			const items = new Map();
			const installed = Array.isArray(agentPluginState.installed) ? agentPluginState.installed : [];
			const available = Array.isArray(agentPluginState.available) ? agentPluginState.available : [];

			installed.forEach(p => {
				const id = normalizePluginID(p);
				if (!id) return;
				items.set(id, {
					id,
					name: p.name || id.split('@')[0],
					description: p.description || '',
					marketplaceName: (id.split('@')[1] || ''),
					installed: true,
					errors: Array.isArray(p.errors) ? p.errors : []
				});
			});

			available.forEach(p => {
				const id = normalizePluginID(p);
				if (!id) return;
				const existing = items.get(id);
				items.set(id, {
					id,
					name: p.name || (existing && existing.name) || id.split('@')[0],
					description: p.description || (existing && existing.description) || '',
					marketplaceName: p.marketplaceName || (existing && existing.marketplaceName) || (id.split('@')[1] || ''),
					installed: existing ? true : false,
					errors: existing ? existing.errors : []
				});
			});

			return Array.from(items.values()).sort((a, b) => a.id.localeCompare(b.id));
		}

		function buildRuntimeStatusLookup() {
			const runtime = Array.isArray(agentPluginState.runtime) ? agentPluginState.runtime : [];
			const lookup = new Map();
			runtime.forEach(item => {
				const entry = {
					status: String(item.status || '').trim().toLowerCase(),
					error: String(item.error || '').trim(),
				};
				const runtimeName = String((item && item.name) || '').trim().toLowerCase();
				if (runtimeName) lookup.set(runtimeName, entry);
				// Also index by plugin ID so plugins whose MCP server name
				// differs from the plugin name prefix can be matched.
				const pluginID = String((item && item.plugin_id) || '').trim().toLowerCase();
				if (pluginID) lookup.set(pluginID, entry);
			});
			return lookup;
		}

		function renderPluginCatalog() {
			const root = document.getElementById('plugin_catalog');
			if (!root) return;
			const searchInput = document.getElementById('plugin_search_input');
			if (searchInput) {
				pluginSearchTerm = String(searchInput.value || '');
			} else {
				pluginSearchTerm = '';
			}
			const normalizedSearch = pluginSearchTerm.trim().toLowerCase();
			if (searchInput && searchInput.value !== pluginSearchTerm) {
				searchInput.value = pluginSearchTerm;
			}
			const items = buildPluginCatalogItems();
			if (items.length === 0) {
				root.innerHTML = '<p class="text-xs opacity-60">No plugins discovered yet. Add/sync a marketplace first.</p>';
				renderSelectedPluginCount();
				return;
			}
			const filteredItems = normalizedSearch
				? items.filter(item => {
					const name = String(item.name || '').toLowerCase();
					const id = String(item.id || '').toLowerCase();
					const marketplace = String(item.marketplaceName || '').toLowerCase();
					return name.includes(normalizedSearch) || id.includes(normalizedSearch) || marketplace.includes(normalizedSearch);
				})
				: items;
			if (filteredItems.length === 0) {
				root.innerHTML = '<p class="text-xs opacity-60">No plugins match your search.</p>';
				renderSelectedPluginCount();
				return;
			}

			// Separate installed and available plugins
			const installedItems = filteredItems.filter(item => item.installed);
			const availableItems = filteredItems.filter(item => !item.installed);
			const runtimeStatusLookup = buildRuntimeStatusLookup();
			const pluginMutationInFlight = hasActivePluginMutation();

			let html = '';

			// Render installed section
			if (installedItems.length > 0) {
				html += '<div class="mb-4"><h4 class="text-xs font-semibold uppercase tracking-wide opacity-50 mb-2">INSTALLED</h4>';
				html += installedItems.map(item => {
					const checked = selectedPluginIDs.includes(item.id) ? 'checked' : '';
					const isUninstalling = uninstallingPluginIDs.has(item.id);
					const isInstalling = installingPluginIDs.has(item.id);
					const controlsDisabled = isUninstalling || isInstalling || pluginCatalogLoading || pluginMutationInFlight;
					const itemLabelClass = controlsDisabled ? 'opacity-60' : '';
					const marketplaceLine = item.marketplaceName
						? '<span class="text-[11px] opacity-60 truncate">' + escapeHtml(item.marketplaceName) + '</span>'
						: '';
					const errText = item.errors && item.errors.length > 0
						? '<p class="text-[11px] text-error mt-1">' + escapeHtml(item.errors.join('; ')) + '</p>'
						: '';
					const runtimePluginKey = String(item.id || '').trim().toLowerCase();
					const runtimeNameKey = runtimePluginKey.split('@')[0];
					const runtimeInfo = runtimeStatusLookup.get(runtimePluginKey) || runtimeStatusLookup.get(runtimeNameKey);
					const runtimeStatus = runtimeInfo ? runtimeInfo.status : '';
					const runtimeError = runtimeInfo ? runtimeInfo.error : '';
					let runtimeDotClass = 'bg-base-300';
					if (runtimeStatus === 'running') runtimeDotClass = 'bg-success/80';
					if (runtimeStatus === 'failed') runtimeDotClass = 'bg-error/90';
					let runtimeTitle = 'Runtime status unavailable';
					if (runtimeStatus === 'running') runtimeTitle = 'Runtime healthy';
					if (runtimeStatus === 'failed') runtimeTitle = runtimeError ? ('Runtime failed: ' + runtimeError) : 'Runtime failed';
					if (runtimeStatus && runtimeStatus !== 'running' && runtimeStatus !== 'failed') runtimeTitle = 'Runtime ' + runtimeStatus;
					let runtimeStatusIndicator = '<span class="inline-flex h-2.5 w-2.5 rounded-full ' + runtimeDotClass + ' shrink-0" title="' + escapeHtml(runtimeTitle) + '"></span>';
					// For failed runtime, show error message below the plugin name
					const runtimeErrText = runtimeStatus === 'failed' && runtimeError
						? '<p class="text-[11px] text-error mt-1">Runtime: ' + escapeHtml(runtimeError) + '</p>'
						: '';
					return `
						<div class="border border-base-300 rounded-lg px-3 py-2 mb-2">
							<div class="flex items-center justify-between gap-3">
									<div class="flex items-center gap-2 min-w-0 flex-1 ${itemLabelClass}">
										${runtimeStatusIndicator}
										<span class="font-medium text-sm truncate" title="${escapeHtml(item.id)}">${escapeHtml(item.id)}</span>
										${marketplaceLine}
									</div>
									<div class="flex items-center gap-2 shrink-0">
										<input
											type="checkbox"
											class="toggle toggle-sm toggle-primary agent-plugin-checkbox"
											value="${escapeHtml(item.id)}"
											aria-label="Enable ${escapeHtml(item.id)}"
											${checked}
											${controlsDisabled ? 'disabled aria-disabled="true"' : ''}
											onchange="refreshSelectedPluginsFromDOM()"
										/>
										<button
											type="button"
											class="btn btn-ghost btn-xs text-error px-1.5"
											data-uninstall-plugin-id="${escapeHtml(item.id)}"
											aria-label="Uninstall ${escapeHtml(item.id)}"
											${controlsDisabled ? 'disabled aria-busy="true"' : ''}
											onclick="uninstallPlugin('${escapeHtml(item.id)}')"
										>
											${isUninstalling ? '<span class="loading loading-spinner loading-xs"></span>' : isInstalling ? '<span class="loading loading-spinner loading-xs"></span>' : '<svg xmlns="http://www.w3.org/2000/svg" class="h-4 w-4" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path stroke-linecap="round" stroke-linejoin="round" d="M3 6h18"></path><path stroke-linecap="round" stroke-linejoin="round" d="M8 6V4a1 1 0 011-1h6a1 1 0 011 1v2"></path><path stroke-linecap="round" stroke-linejoin="round" d="M19 6l-1 14a2 2 0 01-2 2H8a2 2 0 01-2-2L5 6"></path><path stroke-linecap="round" stroke-linejoin="round" d="M10 11v6"></path><path stroke-linecap="round" stroke-linejoin="round" d="M14 11v6"></path></svg>'}
										</button>
									</div>
							</div>
							${errText}
							${runtimeErrText}
						</div>`;
				}).join('');
				html += '</div>';
			}

			// Render available section
			if (availableItems.length > 0) {
				html += '<div class="mb-4"><h4 class="text-xs font-semibold uppercase tracking-wide opacity-50 mb-2">AVAILABLE</h4>';
				html += availableItems.map(item => {
					const descriptionLine = item.description
						? '<p class="text-xs opacity-80 mt-1">' + escapeHtml(item.description) + '</p>'
						: '';
					const marketplaceLine = item.marketplaceName
						? '<p class="text-[11px] opacity-60 mt-1">marketplace: ' + escapeHtml(item.marketplaceName) + '</p>'
						: '';
					const isInstalling = installingPluginIDs.has(item.id);
					const installDisabled = isInstalling || pluginCatalogLoading || pluginMutationInFlight;
					return `
						<div class="block border border-base-300 rounded-lg p-2 mb-2">
							<div class="flex items-start justify-between gap-2">
								<div class="min-w-0 flex-1">
									<div class="flex items-center gap-2">
										<span class="font-medium text-sm truncate">${escapeHtml(item.name)}</span>
										
									</div>
									<p class="text-xs opacity-70 break-all">${escapeHtml(item.id)}</p>
									${descriptionLine}
									${marketplaceLine}
									<p class="text-[11px] opacity-60 mt-1">Install and enable for this agent in one click.</p>
								</div>
								<button type="button" class="btn btn-outline btn-sm self-start min-w-20" data-install-plugin-id="${escapeHtml(item.id)}" ${installDisabled ? 'disabled aria-busy="true"' : ''} onclick="installPlugin('${escapeHtml(item.id)}')">${isInstalling ? '<span class="loading loading-spinner loading-xs"></span> Installing...' : 'Install'}</button>
							</div>
						</div>`;
				}).join('');
				html += '</div>';
			}

			root.innerHTML = html;
			renderSelectedPluginCount();
		}

		async function readErrorMessage(response, fallback) {
			try {
				const data = await response.json();
				if (data && typeof data.error === 'string' && data.error.trim()) {
					return data.error.trim();
				}
			} catch (e) {
				// no-op
			}
			return fallback;
		}

		async function loadPluginState(showToasts, options) {
			const shouldThrow = options && options.throwOnError === true;
			const suppressDiscoveryWarningToast = options && options.suppressDiscoveryWarningToast === true;
			const requestToken = ++pluginStateRequestToken;
			pluginStateLoadInFlight += 1;
			setPluginCatalogLoading(true);
			try {
				const response = await fetch('/agents/plugins/state');
				if (!response.ok) throw new Error('Failed to load plugin state');
				const payload = await response.json();
				if (requestToken !== pluginStateRequestToken) {
					return;
				}
				agentPluginState = payload;
				if (pendingUninstalledPluginIDs.size > 0) {
					agentPluginState.installed = Array.isArray(agentPluginState.installed)
						? agentPluginState.installed.filter(p => !pendingUninstalledPluginIDs.has(normalizePluginID(p)))
						: [];
				}
				renderPluginMarketplaces();
				renderPluginCatalog();
				if (showToasts && !suppressDiscoveryWarningToast && agentPluginState.error && window.showToast) {
					window.showToast('Plugin discovery warning: ' + String(agentPluginState.error), 'failed');
				}
			} catch (err) {
				if (requestToken !== pluginStateRequestToken) {
					return;
				}
				console.error('loadPluginState', err);
				agentPluginState = { marketplaces: [], installed: [], available: [], runtime: [] };
				renderPluginMarketplaces();
				renderPluginCatalog();
				if (showToasts && window.showToast) {
					window.showToast('Could not load plugin state', 'failed');
				}
				setMarketplaceActionStatus('Could not refresh marketplace/plugin state', 'error');
				if (shouldThrow) throw err;
			} finally {
				pluginStateLoadInFlight = Math.max(0, pluginStateLoadInFlight - 1);
				if (pluginStateLoadInFlight === 0) {
					setPluginCatalogLoading(false);
				}
			}
		}

		async function addPluginMarketplace() {
			if (hasActiveMarketplaceAction()) return;
			const input = document.getElementById('plugin_marketplace_source');
			if (!input) return;
			const source = String(input.value || '').trim();
			if (!source) return;
			addingMarketplace = true;
			setMarketplaceActionStatus('Adding marketplace...', 'info');
			renderPluginMarketplaces();
			try {
				const response = await fetch('/agents/plugins/marketplaces', {
					method: 'POST',
					headers: { 'Content-Type': 'application/json' },
					body: JSON.stringify({ source: source, scope: 'user' })
				});
				if (!response.ok) {
					const msg = await readErrorMessage(response, 'add marketplace failed');
					throw new Error(msg);
				}
				input.value = '';
				await loadPluginState(true, { throwOnError: true });
				setMarketplaceActionStatus('Marketplace added', 'success');
				if (window.showToast) window.showToast('Marketplace added', 'completed');
			} catch (err) {
				console.error('addPluginMarketplace', err);
				const message = String(err.message || 'Could not add marketplace');
				setMarketplaceActionStatus(message, 'error');
				if (window.showToast) window.showToast(message, 'failed');
			} finally {
				addingMarketplace = false;
				renderPluginMarketplaces();
			}
		}

		async function resetDefaultPluginMarketplaces() {
			if (hasActiveMarketplaceAction()) return;
			restoringDefaultMarketplaces = true;
			setMarketplaceActionStatus('Restoring default marketplaces...', 'info');
			renderPluginMarketplaces();
			try {
				const response = await fetch('/agents/plugins/marketplaces/reset-defaults', { method: 'POST' });
				if (!response.ok) {
					const msg = await readErrorMessage(response, 'reset default marketplaces failed');
					throw new Error(msg);
				}
				await loadPluginState(true, { throwOnError: true });
				setMarketplaceActionStatus('Default marketplaces restored', 'success');
				if (window.showToast) window.showToast('Default marketplaces restored', 'completed');
			} catch (err) {
				console.error('resetDefaultPluginMarketplaces', err);
				const message = String(err.message || 'Could not reset default marketplaces');
				setMarketplaceActionStatus(message, 'error');
				if (window.showToast) window.showToast(message, 'failed');
			} finally {
				restoringDefaultMarketplaces = false;
				renderPluginMarketplaces();
			}
		}

		async function updatePluginMarketplace(name) {
			const safeName = String(name || '').trim();
			if (!safeName) return;
			if (hasActiveMarketplaceAction()) return;
			syncingMarketplaceNames.add(safeName);
			setMarketplaceActionStatus('Syncing marketplace "' + safeName + '"...', 'info');
			renderPluginMarketplaces();
			try {
				const response = await fetch('/agents/plugins/marketplaces/' + encodeURIComponent(safeName) + '/update', { method: 'POST' });
				if (!response.ok) {
					const msg = await readErrorMessage(response, 'update marketplace failed');
					throw new Error(msg);
				}
				await loadPluginState(true, { throwOnError: true });
				setMarketplaceActionStatus('Marketplace synced', 'success');
				if (window.showToast) window.showToast('Marketplace synced', 'completed');
			} catch (err) {
				console.error('updatePluginMarketplace', err);
				const message = String(err.message || 'Could not sync marketplace');
				setMarketplaceActionStatus(message, 'error');
				if (window.showToast) window.showToast(message, 'failed');
			} finally {
				syncingMarketplaceNames.delete(safeName);
				renderPluginMarketplaces();
			}
		}

		async function deletePluginMarketplace(name) {
			const safeName = String(name || '').trim();
			if (!safeName) return;
			if (hasActiveMarketplaceAction()) return;
			if (!window.confirm('Remove marketplace "' + safeName + '"?')) return;
			removingMarketplaceNames.add(safeName);
			setMarketplaceActionStatus('Removing marketplace "' + safeName + '"...', 'info');
			renderPluginMarketplaces();
			try {
				const response = await fetch('/agents/plugins/marketplaces/' + encodeURIComponent(safeName), { method: 'DELETE' });
				if (!response.ok) {
					const msg = await readErrorMessage(response, 'remove marketplace failed');
					throw new Error(msg);
				}
				await loadPluginState(true, { throwOnError: true });
				setMarketplaceActionStatus('Marketplace removed', 'success');
				if (window.showToast) window.showToast('Marketplace removed', 'completed');
			} catch (err) {
				console.error('deletePluginMarketplace', err);
				const message = String(err.message || 'Could not remove marketplace');
				setMarketplaceActionStatus(message, 'error');
				if (window.showToast) window.showToast(message, 'failed');
			} finally {
				removingMarketplaceNames.delete(safeName);
				renderPluginMarketplaces();
			}
		}

		async function installPlugin(pluginID) {
			const id = String(pluginID || '').trim();
			if (!id) return;
			if (installingPluginIDs.has(id) || uninstallingPluginIDs.has(id) || pluginCatalogLoading || hasActivePluginMutation()) return;
			setPluginInstallInProgress(id, true);
			try {
				const body = { plugin_id: id, scope: 'user' };
				const currentAgentID = String(activeAgentID || '').trim();
				if (currentAgentID) {
					body.agent_id = currentAgentID;
				}
				const response = await fetch('/agents/plugins/install', {
					method: 'POST',
					headers: { 'Content-Type': 'application/json' },
					body: JSON.stringify(body)
				});
				if (!response.ok) {
					const msg = await readErrorMessage(response, 'install plugin failed');
					throw new Error(msg);
				}
				const payload = await response.json().catch(() => ({}));
				const enabledForAgent = payload && payload.enabled_for_agent === true;
				const hasEnableError = payload && typeof payload.enable_error === 'string' && payload.enable_error.trim();
				agentPluginState.installed = Array.isArray(agentPluginState.installed)
					? agentPluginState.installed.filter(p => normalizePluginID(p) !== id)
					: [];
				agentPluginState.available = Array.isArray(agentPluginState.available)
					? agentPluginState.available.filter(p => normalizePluginID(p) !== id)
					: [];
				agentPluginState.installed = agentPluginState.installed.concat([{ id: id, pluginId: id, name: id.split('@')[0], enabled: true }]);
				if (!currentAgentID || enabledForAgent) {
					selectedPluginIDs = Array.from(new Set(selectedPluginIDs.concat([id]))).sort();
				}
				renderPluginCatalog();
				await loadPluginState(true, { throwOnError: true, suppressDiscoveryWarningToast: true });
				if (window.showToast) {
					if (currentAgentID) {
						if (enabledForAgent) {
							window.showToast('Plugin installed and enabled for this agent', 'completed');
						} else if (hasEnableError) {
							window.showToast('Plugin installed but could not be enabled for this agent', 'failed');
							window.showToast(String(payload.enable_error), 'failed');
						} else {
							window.showToast('Plugin installed', 'completed');
						}
					} else {
						window.showToast('Plugin installed and selected for this new agent', 'completed');
					}
					if (payload && payload.warning) {
						window.showToast(String(payload.warning), 'failed');
					}
				}
				if (hasEnableError) {
					setMarketplaceActionStatus('Plugin installed, but enabling for this agent failed. Retry install to try enabling again.', 'error');
				}
			} catch (err) {
				console.error('installPlugin', err);
				if (window.showToast) window.showToast(String(err.message || 'Could not install plugin'), 'failed');
			} finally {
				setPluginInstallInProgress(id, false);
			}
		}

		async function uninstallPlugin(pluginID) {
			const id = String(pluginID || '').trim();
			if (!id) return;
			if (uninstallingPluginIDs.has(id) || installingPluginIDs.has(id) || pluginCatalogLoading || hasActivePluginMutation()) return;
			if (!window.confirm('Uninstall plugin "' + id + '"? This removes local plugin files.')) return;
			setPluginUninstallInProgress(id, true);
			pendingUninstalledPluginIDs.add(id);
			setMarketplaceActionStatus('Removing plugin "' + id + '"...', 'info');
			try {
				const response = await fetch('/agents/plugins/uninstall', {
					method: 'POST',
					headers: { 'Content-Type': 'application/json' },
					body: JSON.stringify({ plugin_id: id })
				});
				if (!response.ok) {
					const msg = await readErrorMessage(response, 'uninstall plugin failed');
					throw new Error(msg);
				}
				await response.json().catch(() => ({}));
				selectedPluginIDs = selectedPluginIDs.filter(x => x !== id);
				agentPluginState.installed = Array.isArray(agentPluginState.installed)
					? agentPluginState.installed.filter(p => normalizePluginID(p) !== id)
					: [];
				agentPluginState.available = Array.isArray(agentPluginState.available)
					? agentPluginState.available
					: [];
				renderPluginCatalog();
				await loadPluginState(false, { throwOnError: true });
				pendingUninstalledPluginIDs.delete(id);
				setMarketplaceActionStatus('Plugin removed', 'success');
				if (window.showToast) {
					window.showToast('Plugin uninstalled', 'completed');
				}
			} catch (err) {
				pendingUninstalledPluginIDs.delete(id);
				console.error('uninstallPlugin', err);
				const message = String(err.message || 'Could not uninstall plugin');
				setMarketplaceActionStatus(message, 'error');
				if (window.showToast) window.showToast(message, 'failed');
			} finally {
				setPluginUninstallInProgress(id, false);
			}
		}


		function openNewAgentModal() {
			activeAgentID = '';
			document.getElementById('agent_modal_title').textContent = 'New Agent';
			const form = document.getElementById('agent_form');
			form.action = withCurrentAgentListState('/agents');
			form.method = 'post';
			form.setAttribute('hx-post', withCurrentAgentListState('/agents'));
			form.setAttribute('hx-target', '#agents-container');
			form.setAttribute('hx-swap', 'outerHTML');
			form.removeAttribute('hx-put');
			htmx.process(form);

			document.getElementById('agent_name').value = '';
			document.getElementById('agent_description').value = '';
			document.getElementById('agent_system_prompt').value = '';
				setAgentModelSelection('inherit');
				setAgentToolConfig({});
				setAgentTools([]);
				selectedPluginIDs = [];
			resetGeneratedState();
			resetLifecycleFormFields();
			populateLifecycleFormFromAgent({ enabled: true });
				setAgentSection('details');
				loadAgentSkillsForAgent(activeAgentID);
				loadPluginState(false);
				document.getElementById('agent_modal').showModal();		}

		function editAgentFromData(el) {
			const id = el.dataset.agentId;
			activeAgentID = String(id || '').trim();
			document.getElementById('agent_modal_title').textContent = 'Edit Agent';
			const form = document.getElementById('agent_form');
			form.action = withCurrentAgentListState('/agents/' + id);
			form.removeAttribute('hx-post');
			form.setAttribute('hx-put', withCurrentAgentListState('/agents/' + id));
			form.setAttribute('hx-target', '#agents-container');
			form.setAttribute('hx-swap', 'outerHTML');
			htmx.process(form);

			document.getElementById('agent_name').value = el.dataset.agentName || '';
			document.getElementById('agent_description').value = el.dataset.agentDescription || '';
			document.getElementById('agent_system_prompt').value = el.dataset.agentSystemPrompt || '';
				setAgentModelSelection(el.dataset.agentModel || 'inherit');
				setAgentToolConfig(JSON.parse(el.dataset.agentToolConfig || '{}'));
				setAgentTools(JSON.parse(el.dataset.agentTools || '[]'));

				selectedPluginIDs = JSON.parse(el.dataset.agentPlugins || '[]');
			generatedSkillsState = JSON.parse(el.dataset.agentSkills || '[]');
			generatedMCPServersState = JSON.parse(el.dataset.agentMcpServers || '[]');
			updateGeneratedSummary();

			resetLifecycleFormFields();
			populateLifecycleFormFromCardData(el);
			loadAgentLifecycleFromServer(activeAgentID);

				setAgentSection('details');
				loadAgentSkillsForAgent(activeAgentID);
				loadPluginState(false);
				document.getElementById('agent_modal').showModal();		}

		async function loadAgentLifecycleFromServer(agentID) {
			if (!agentID) return;
			try {
				const response = await fetch(withCurrentProject('/agents/' + encodeURIComponent(agentID) + '/json'), { headers: { 'Accept': 'application/json' }});
				if (response.ok) {
					const data = await response.json();
					populateLifecycleFormFromAgent(data);
				}
			} catch (err) {
				console.error('loadAgentLifecycleFromServer', err);
			}
			loadLifecycleHooksForAgent(agentID);
		}

		function fillAgentFormFromGenerated(data) {
			if (!data || typeof data !== 'object') return;
			document.getElementById('agent_name').value = data.name || '';
			document.getElementById('agent_description').value = data.description || '';
			document.getElementById('agent_system_prompt').value = data.system_prompt || '';
				setAgentModelSelection(data.model || 'inherit');
				setAgentToolConfig(data.tool_config || {});
				setAgentTools(data.tools || []);
			if (Array.isArray(data.plugins) && data.plugins.length > 0) {
				selectedPluginIDs = Array.from(new Set(data.plugins.map(x => String(x).trim()).filter(Boolean))).sort();
				renderPluginCatalog();
			}
			generatedSkillsState = Array.isArray(data.skills) ? data.skills : [];
			generatedMCPServersState = Array.isArray(data.mcp_servers) ? data.mcp_servers : [];
			updateGeneratedSummary();
		}

		async function generateAgentFromPrompt() {
			const promptInput = document.getElementById('agent_description');
			const button = document.getElementById('agent_generate_btn');
			const description = (promptInput.value || '').trim();
			if (!description) {
				if (window.showToast) window.showToast('Enter a description first', 'failed');
				return;
			}

			const oldLabel = button.textContent;
			button.disabled = true;
			button.textContent = 'Generating...';
			try {
				refreshSelectedPluginsFromDOM();
				const body = new URLSearchParams();
				body.set('description', description);
				body.set('plugins_json', JSON.stringify(selectedPluginIDs));
				const response = await fetch('/agents/generate', {
					method: 'POST',
					headers: { 'Content-Type': 'application/x-www-form-urlencoded' },
					body: body.toString()
				});
				if (!response.ok) throw new Error('generation failed');
				const data = await response.json();
				fillAgentFormFromGenerated(data);
				if (window.showToast) {
					if (data.generation_mode === 'fallback') {
						const reason = data.generation_error ? (' (' + String(data.generation_error).slice(0, 160) + ')') : '';
						window.showToast('Generated using local template draft' + reason, 'cancelled');
					} else {
						window.showToast('Agent draft generated', 'completed');
					}
				}
			} catch (err) {
				console.error('generateAgentFromPrompt', err);
				if (window.showToast) window.showToast('Could not generate agent draft', 'failed');
			} finally {
				button.disabled = false;
				button.textContent = oldLabel;
			}
		}

			function serializeAgentFormData() {
				validateScopedFilesDirectoryInput();
				const tools = [];
				document.querySelectorAll('.agent-tool-checkbox:checked').forEach(cb => tools.push(cb.value));
				document.getElementById('agent_tools_json').value = JSON.stringify(tools);
				document.getElementById('agent_tool_config_json').value = JSON.stringify(buildAgentToolConfig());

				refreshSelectedPluginsFromDOM();
				document.getElementById('agent_plugins_json').value = JSON.stringify(selectedPluginIDs);
				document.getElementById('agent_skills_json').value = JSON.stringify(generatedSkillsState || []);
				document.getElementById('agent_mcp_servers_json').value = JSON.stringify(generatedMCPServersState || []);

					// Lifecycle dialog: permissions, hooks, identity/scope.
					document.getElementById('agent_permission_defaults_json').value = JSON.stringify(collectPermissionDefaults());
					document.getElementById('agent_lifecycle_hooks_json').value = JSON.stringify(collectLifecycleHooksFromDOM());
				document.getElementById('agent_source_refs_json').value = JSON.stringify(splitLines(document.getElementById('advanced_source_refs').value));
				document.getElementById('agent_key_field').value = (document.getElementById('advanced_key').value || '').trim();
				document.getElementById('agent_scope_field').value = (document.getElementById('advanced_scope').value || '').trim();
				document.getElementById('agent_selectable_as_primary_field').value = document.getElementById('advanced_selectable_as_primary').checked ? 'true' : 'false';
				document.getElementById('agent_enabled_field').value = document.getElementById('advanced_enabled').checked ? 'true' : 'false';
			}

			function splitLines(value) {
				return String(value || '')
					.split(/\r?\n/)
					.map(line => line.trim())
					.filter(line => line.length > 0);
			}

			function collectPermissionDefaults() {
				return {
					read_task_prompt:       document.getElementById('perm_read_task_prompt').checked,
					read_task_execution:    document.getElementById('perm_read_task_execution').checked,
					read_project_memory:    document.getElementById('perm_read_project_memory').checked,
					write_project_memory:   document.getElementById('perm_write_project_memory').checked,
					read_agents:            document.getElementById('perm_read_agents').checked,
					write_agents:           document.getElementById('perm_write_agents').checked,
					read_skills:            document.getElementById('perm_read_skills').checked,
					write_skills:           document.getElementById('perm_write_skills').checked,
					read_repository_files:  document.getElementById('perm_read_repository_files').checked,
					write_repository_files: document.getElementById('perm_write_repository_files').checked,
					use_shell_or_tools:     document.getElementById('perm_use_shell_or_tools').checked,
				};
			}

			function resetLifecycleFormFields() {
				['perm_read_task_prompt','perm_read_task_execution','perm_read_project_memory','perm_write_project_memory','perm_read_agents','perm_write_agents','perm_read_skills','perm_write_skills','perm_read_repository_files','perm_write_repository_files','perm_use_shell_or_tools'].forEach(id => {
					const el = document.getElementById(id); if (el) el.checked = false;
				});
						['advanced_key','advanced_source_refs'].forEach(id => {					const el = document.getElementById(id); if (el) el.value = '';
					});
					const scopeEl = document.getElementById('advanced_scope');
					if (scopeEl) scopeEl.value = 'global';
						['advanced_selectable_as_primary'].forEach(id => {
							const el = document.getElementById(id); if (el) el.checked = true;
						});				const enabledEl = document.getElementById('advanced_enabled');
				if (enabledEl) enabledEl.checked = true;
				const protectedNotice = document.getElementById('advanced_protected_notice');
				if (protectedNotice) protectedNotice.classList.add('hidden');
				const banner = document.getElementById('lifecycle_hooks_protected_banner');
				if (banner) banner.classList.add('hidden');
				const list = document.getElementById('lifecycle_hooks_list');
				if (list) list.innerHTML = '';
				lifecycleHooksState = [];
			}

				function parseAgentCardJSON(el, name, fallback) {
					if (!el || !el.dataset) return fallback;
					try {
						const raw = el.dataset[name];
						return raw ? JSON.parse(raw) : fallback;
					} catch (err) {
						console.error('parseAgentCardJSON', name, err);
						return fallback;
					}
				}

				function populateLifecycleFormFromCardData(el) {
					if (!el || !el.dataset) {
						populateLifecycleFormFromAgent({ enabled: true, selectable_as_primary: true });
						return;
					}
					populateLifecycleFormFromAgent({
						key: el.dataset.agentKey || '',
						scope: el.dataset.agentScope || 'global',
						selectable_as_primary: el.dataset.agentSelectableAsPrimary !== 'false',
						enabled: el.dataset.agentEnabled !== 'false',
						permission_defaults: parseAgentCardJSON(el, 'agentPermissionDefaults', {}),
						source_refs: parseAgentCardJSON(el, 'agentSourceRefs', []),
						generated_status: el.dataset.agentGeneratedStatus || '',
					});
				}

			function populateLifecycleFormFromAgent(data) {
				const perms = (data && data.permission_defaults) || {};
				const setCheck = (id, val) => { const el = document.getElementById(id); if (el) el.checked = !!val; };
				const setVal = (id, val) => { const el = document.getElementById(id); if (el) el.value = (val == null ? '' : String(val)); };
				setCheck('perm_read_task_prompt', perms.read_task_prompt);
				setCheck('perm_read_task_execution', perms.read_task_execution);
				setCheck('perm_read_project_memory', perms.read_project_memory);
				setCheck('perm_write_project_memory', perms.write_project_memory);
				setCheck('perm_read_agents', perms.read_agents);
				setCheck('perm_write_agents', perms.write_agents);
				setCheck('perm_read_skills', perms.read_skills);
				setCheck('perm_write_skills', perms.write_skills);
				setCheck('perm_read_repository_files', perms.read_repository_files);
				setCheck('perm_write_repository_files', perms.write_repository_files);
				setCheck('perm_use_shell_or_tools', perms.use_shell_or_tools);

				setVal('advanced_key', data ? data.key : '');
							setVal('advanced_scope', data && data.scope === 'project' ? 'project' : 'global');
					setCheck('advanced_selectable_as_primary', data ? data.selectable_as_primary !== false : true);				setCheck('advanced_enabled', data ? data.enabled : true);
				setVal('advanced_source_refs', data && Array.isArray(data.source_refs) ? data.source_refs.join('\n') : '');

				const protectedNotice = document.getElementById('advanced_protected_notice');
				const banner = document.getElementById('lifecycle_hooks_protected_banner');
				const isProtected = data && data.generated_status === 'protected';
				if (protectedNotice) protectedNotice.classList.toggle('hidden', !isProtected);
				if (banner) banner.classList.toggle('hidden', !isProtected);
				lifecycleProtectedAgent = !!isProtected;
			}

			let lifecycleHooksState = [];
			let lifecycleProtectedAgent = false;

			async function loadLifecycleHooksForAgent(agentID) {
				lifecycleHooksState = [];
				document.getElementById('lifecycle_hooks_list').innerHTML = '';
				if (!agentID) return;
				try {
					const response = await fetch(withCurrentProject('/agents/' + encodeURIComponent(agentID) + '/lifecycle-hooks'), { headers: { 'Accept': 'application/json' }});
					if (!response.ok) {
						throw new Error('failed to load hooks: ' + response.status);
					}
					const hooks = await response.json();
					lifecycleHooksState = Array.isArray(hooks) ? hooks : [];
					renderLifecycleHooks();
				} catch (err) {
					console.error('loadLifecycleHooksForAgent', err);
					const status = document.getElementById('lifecycle_hooks_status');
					if (status) { status.textContent = String(err.message || err); status.classList.remove('hidden'); status.classList.add('text-error'); }
				}
			}

			function renderLifecycleHooks() {
				const list = document.getElementById('lifecycle_hooks_list');
				if (!list) return;
				list.innerHTML = '';
				const addBtn = document.getElementById('lifecycle_hooks_add_btn');
				if (addBtn) addBtn.disabled = lifecycleProtectedAgent;
						lifecycleHooksState.forEach((hook, idx) => {
							list.appendChild(buildLifecycleHookRow(hook, idx));
						});
					}
				function lifecycleWhenOptions(selected) {
					const allowed = ['route_task','before_run','after_complete'];
					if (selected === 'task_mode') {
						return '<option value="task_mode" selected disabled>task_mode (internal, not configurable)</option>' + allowed.map(w => '<option value="' + w + '">' + w + '</option>').join('');
					}
					return allowed.map(w => '<option value="' + w + '"' + (selected === w ? ' selected' : '') + '>' + w + '</option>').join('');
				}

				function buildLifecycleHookRow(hook, idx) {
					const wrap = document.createElement('div');
				wrap.className = 'border border-base-300 rounded-lg p-3 bg-base-200/30';
				wrap.dataset.hookIdx = String(idx);
				const disabled = lifecycleProtectedAgent ? 'disabled' : '';
				wrap.innerHTML =
					'<div class="grid grid-cols-1 md:grid-cols-2 gap-2">' +
						'<label class="form-control"><span class="label-text text-xs">When</span>' +
								'<select class="select select-bordered select-sm" data-hook-field="when" ' + disabled + '>' +
									lifecycleWhenOptions(hook.when || '') +
								'</select></label>' +
						'<label class="form-control"><span class="label-text text-xs">Skill key</span>' +
							'<input type="text" class="input input-bordered input-sm" data-hook-field="skill_key" value="' + escapeHtml(hook.skill_key || '') + '" placeholder="load_project_context" ' + disabled + '/></label>' +
						'<label class="form-control"><span class="label-text text-xs">Output contract</span>' +
							'<select class="select select-bordered select-sm" data-hook-field="output_contract" ' + disabled + '>' +
								['','selected_skills','context_block','activity_summary','learning_summary','library_update_summary'].map(c => '<option value="' + c + '"' + ((hook.output_contract || '') === c ? ' selected' : '') + '>' + (c || '(none)') + '</option>').join('') +
							'</select></label>' +
						'<div class="flex items-end gap-3">' +
							'<label class="label cursor-pointer gap-2 justify-start"><input type="checkbox" class="checkbox checkbox-sm" data-hook-field="blocking"' + (hook.blocking ? ' checked' : '') + ' ' + disabled + '/><span class="label-text text-sm">Blocking</span></label>' +
							'<label class="label cursor-pointer gap-2 justify-start"><input type="checkbox" class="checkbox checkbox-sm" data-hook-field="enabled"' + ((hook.enabled !== false) ? ' checked' : '') + ' ' + disabled + '/><span class="label-text text-sm">Enabled</span></label>' +
							(lifecycleProtectedAgent ? '' : '<button type="button" class="btn btn-ghost btn-xs ml-auto text-error" onclick="removeLifecycleHookRow(' + idx + ')">Remove</button>') +
						'</div>' +
					'</div>' +
					'<label class="form-control mt-2"><span class="label-text text-xs">Prompt override (optional)</span>' +
						'<textarea class="textarea textarea-bordered textarea-xs" data-hook-field="prompt_override" rows="2" placeholder="" ' + disabled + '>' + escapeHtml(hook.prompt_override || '') + '</textarea></label>';
				return wrap;
			}

					function agentSkillAPIURL(path) {
						const url = new URL(path, window.location.origin);
						const projectID = new URLSearchParams(window.location.search).get('project_id');
						if (projectID) url.searchParams.set('project_id', projectID);
						return url.pathname + url.search;
					}

					async function loadAgentSkillsForAgent(agentID) {
					const list = document.getElementById('agent_skills_list');
						if (!list) return;
							agentOwnedSkillsState = { routed_skills: [], can_manage: false, protected: false };
						renderAgentOwnedSkills();
						if (!agentID) {
							list.innerHTML = '<p class="text-sm opacity-50">Save this agent before creating skills.</p>';
							return;
						}
						list.innerHTML = '<p class="text-sm opacity-50">Loading routed skills...</p>';
						try {
							const response = await fetch(agentSkillAPIURL('/agents/' + encodeURIComponent(agentID) + '/skills'), { headers: { 'Accept': 'application/json' } });
							if (!response.ok) throw new Error(await readErrorMessage(response, 'Could not load skills'));
							agentOwnedSkillsState = await response.json();
							renderAgentOwnedSkills();
						} catch (err) {
							list.innerHTML = '<p class="text-sm text-error">' + escapeHtml(String(err.message || err)) + '</p>';
						}
					}

					function renderAgentOwnedSkills() {
						const list = document.getElementById('agent_skills_list');
						const summary = document.getElementById('agent_skills_router_summary');
						const index = document.getElementById('agent_skills_router_index');
						const newBtn = document.getElementById('agent_skill_new_btn');
						const notice = document.getElementById('agent_skills_system_notice');
							const state = agentOwnedSkillsState || {};
							const routed = Array.isArray(state.routed_skills) ? state.routed_skills : [];
						const canManage = Boolean(state.can_manage);
							if (newBtn) newBtn.disabled = !canManage || !activeAgentID;
							const scopeSelect = document.getElementById('agent_skill_scope');
							if (scopeSelect) {
								const projectOption = Array.from(scopeSelect.options).find(option => option.value === 'project');
								if (projectOption) projectOption.disabled = !state.project_root_set;
								if (scopeSelect.value === 'project' && !state.project_root_set) scopeSelect.value = 'global';
							}
							if (notice) notice.classList.toggle('hidden', !state.protected);
						if (summary) {
							summary.textContent = activeAgentID
								? `When assigned to a task, route_task selects from ${routed.length} indexed skill(s) owned by agent ${state.agent_key || '(unknown)'}. Project skills override global skills.`
								: 'Save this agent to preview routed skills.';
						}
						if (index) {
							index.textContent = state.router_index || '';
							index.classList.toggle('hidden', !state.router_index);
						}
						if (list) {
							if (routed.length === 0) {
								list.innerHTML = '<p class="text-sm opacity-50">No indexed skills yet.</p>';
							} else {
								list.innerHTML = routed.map(skill => renderAgentOwnedSkillCard(skill, canManage)).join('');
							}
						}
					}

					function renderAgentOwnedSkillCard(skill, canManage) {
						const handle = String(skill.handle || '').trim();
						const archived = Boolean(skill.archived);
						const manageButtons = canManage ? '<div class="flex gap-1"><button type="button" class="btn btn-ghost btn-xs" onclick="editAgentOwnedSkill(\'' + escapeHtml(handle) + '\')">Edit</button><button type="button" class="btn btn-ghost btn-xs text-warning" onclick="archiveAgentOwnedSkill(\'' + escapeHtml(handle) + '\')">Archive</button></div>' : '';
						return '<div class="border border-base-300 rounded-lg p-3 bg-base-200/30">' +
							'<div class="flex items-start justify-between gap-2"><div><div class="font-medium text-sm">' + escapeHtml(skill.name || handle || '(unnamed)') + (archived ? ' <span class="badge badge-warning badge-xs">archived</span>' : '') + '</div>' +
							'<p class="text-xs opacity-60">' + escapeHtml(handle) + ' · ' + escapeHtml(skill.scope || skill.source || 'project') + '</p></div>' + manageButtons + '</div>' +
							(skill.description ? '<p class="text-xs opacity-70 mt-1">' + escapeHtml(skill.description) + '</p>' : '') +
							(skill.path ? '<p class="text-[11px] opacity-50 mt-1 break-all">' + escapeHtml(skill.path) + '</p>' : '') +
						'</div>';
					}

					function startNewAgentOwnedSkill() {
						if (!activeAgentID || !(agentOwnedSkillsState && agentOwnedSkillsState.can_manage)) return;
						editingAgentSkillOriginalHandle = '';
						document.getElementById('agent_skill_handle').value = '';
						document.getElementById('agent_skill_handle').disabled = false;
						document.getElementById('agent_skill_name').value = '';
						document.getElementById('agent_skill_description').value = '';
							const preferredScope = ((agentOwnedSkillsState || {}).agent_scope === 'global' || !(agentOwnedSkillsState || {}).project_root_set) ? 'global' : 'project';
							document.getElementById('agent_skill_scope').value = preferredScope;
						document.getElementById('agent_skill_body').value = '';
						document.getElementById('agent_skill_editor').classList.remove('hidden');
					}

					function editAgentOwnedSkill(handle) {
						const skills = Array.isArray(agentOwnedSkillsState.routed_skills) ? agentOwnedSkillsState.routed_skills : [];
						const skill = skills.find(item => item.handle === handle);
						if (!skill) return;
						editingAgentSkillOriginalHandle = handle;
						document.getElementById('agent_skill_handle').value = skill.handle || '';
						document.getElementById('agent_skill_handle').disabled = true;
						document.getElementById('agent_skill_name').value = skill.name || '';
						document.getElementById('agent_skill_description').value = skill.description || '';
						document.getElementById('agent_skill_scope').value = skill.scope === 'global' ? 'global' : 'project';
						document.getElementById('agent_skill_body').value = skill.content || '';
						document.getElementById('agent_skill_editor').classList.remove('hidden');
					}

					function cancelAgentOwnedSkillEdit() {
						editingAgentSkillOriginalHandle = '';
						document.getElementById('agent_skill_editor').classList.add('hidden');
					}

					async function saveAgentOwnedSkill() {
						if (!activeAgentID) return;
						const handle = String(document.getElementById('agent_skill_handle').value || '').trim();
						if (!handle || handle.includes('/')) {
							if (window.showToast) window.showToast('Skill key is required and must not include /', 'failed');
							return;
						}
						const payload = {
							handle: handle,
							name: document.getElementById('agent_skill_name').value || '',
							description: document.getElementById('agent_skill_description').value || '',
							scope: document.getElementById('agent_skill_scope').value || 'project',
							body: document.getElementById('agent_skill_body').value || '',
						};
						const url = agentSkillAPIURL(editingAgentSkillOriginalHandle
							? '/agents/' + encodeURIComponent(activeAgentID) + '/skills/' + encodeURIComponent(editingAgentSkillOriginalHandle)
							: '/agents/' + encodeURIComponent(activeAgentID) + '/skills');
						const method = editingAgentSkillOriginalHandle ? 'PUT' : 'POST';
						try {
							const response = await fetch(url, { method, headers: { 'Content-Type': 'application/json', 'Accept': 'application/json' }, body: JSON.stringify(payload) });
							if (!response.ok) throw new Error(await readErrorMessage(response, 'Could not save skill'));
							agentOwnedSkillsState = await response.json();
							cancelAgentOwnedSkillEdit();
							renderAgentOwnedSkills();
							if (window.showToast) window.showToast('Agent-owned skill saved', 'completed');
						} catch (err) {
							if (window.showToast) window.showToast(String(err.message || err), 'failed');
						}
					}

					async function archiveAgentOwnedSkill(handle) {
						if (!activeAgentID || !handle || !window.confirm('Archive skill "' + handle + '"?')) return;
						try {
							const skill = (Array.isArray(agentOwnedSkillsState.routed_skills) ? agentOwnedSkillsState.routed_skills : []).find(item => item.handle === handle) || {};
							const scopeParam = skill.scope ? ('?scope=' + encodeURIComponent(skill.scope)) : '';
							const response = await fetch(agentSkillAPIURL('/agents/' + encodeURIComponent(activeAgentID) + '/skills/' + encodeURIComponent(handle) + '/archive' + scopeParam), { method: 'POST', headers: { 'Content-Type': 'application/json', 'Accept': 'application/json' }, body: JSON.stringify({ reason: 'Archived from the agent dialog' }) });
							if (!response.ok) throw new Error(await readErrorMessage(response, 'Could not archive skill'));
							agentOwnedSkillsState = await response.json();
							renderAgentOwnedSkills();
							if (window.showToast) window.showToast('Agent-owned skill archived', 'completed');
						} catch (err) {
							if (window.showToast) window.showToast(String(err.message || err), 'failed');
						}
					}


						function collectLifecycleHooksFromDOM() {
						const rows = document.querySelectorAll('#lifecycle_hooks_list [data-hook-idx]');
						const out = [];				rows.forEach((row, i) => {
					const get = (name) => {
						const el = row.querySelector('[data-hook-field="' + name + '"]');
						if (!el) return '';
						if (el.type === 'checkbox') return !!el.checked;
						return String(el.value || '').trim();
					};
					const hook = lifecycleHooksState[i] || {};
					const when = get('when');
					if (when === 'task_mode') return;
					out.push({
							id: hook.id || '',
							when: when,
							skill_key: get('skill_key'),
							blocking: get('blocking'),
							enabled: get('enabled'),
							output_contract: get('output_contract'),
								prompt_override: get('prompt_override'),
							});				});
				return out;
			}

			function addLifecycleHookRow() {
				if (lifecycleProtectedAgent) return;
				lifecycleHooksState.push({ when: 'before_run', skill_key: '', blocking: true, enabled: true, output_contract: '' });
				renderLifecycleHooks();
			}

			function removeLifecycleHookRow(idx) {
				if (lifecycleProtectedAgent) return;
				lifecycleHooksState.splice(idx, 1);
				renderLifecycleHooks();
			}

			document.body.addEventListener('htmx:responseError', function(event) {
				if (!event.detail || !event.detail.target || event.detail.target.id !== 'agents-container') return;
				const xhr = event.detail.xhr;
				if (!xhr || xhr.status !== 400) return;
				const message = String(xhr.responseText || '').trim();
				if (!message.toLowerCase().includes('directory')) return;
				event.preventDefault();
				setAgentSection('details');
				setScopedFilesDirectoryError(message);
				const modal = document.getElementById('agent_modal');
				if (modal && !modal.open) modal.showModal();
				const input = document.getElementById('scoped_files_directory');
				if (input) input.focus();
			});
			setTimeout(() => {
				const form = document.getElementById('agent_form');
				if (form && !window._agentFormSubmitHooked) {
					window._agentFormSubmitHooked = true;
					form.addEventListener('submit', (event) => {
						if (!validateScopedFilesDirectoryInput()) {
							event.preventDefault();
							event.stopPropagation();
							setAgentSection('details');
							const input = document.getElementById('scoped_files_directory');
							if (input) input.focus();
							return false;
						}
						serializeAgentFormData();
					});
				}
				if (document.querySelector('[data-agent-section-tab]') && document.querySelector('[data-agent-section-panel]')) {
					setAgentSection(activeAgentSection);
				}
			}, 0);		</script>
	</div>
}
