package pages

import (
	"fmt"
	"github.com/openvibely/openvibely/internal/models"
)

func isProjectDefaultModel(project *models.Project, agentID string) bool {
	return project.DefaultAgentConfigID != nil && *project.DefaultAgentConfigID == agentID
}

func projectMaxWorkersValue(project *models.Project) string {
	if project.MaxWorkers != nil {
		return fmt.Sprintf("%d", *project.MaxWorkers)
	}
	return ""
}

func projectRepoSource(project *models.Project) string {
	if project != nil && project.RepoURL != "" {
		return "github"
	}
	return "local"
}

script deleteProjectAction(projectID string) {
	var confirmModal = document.getElementById('delete_project_confirm_modal');
	if (!confirmModal || confirmModal.dataset.deletePending === 'true') return;
	var confirmButton = confirmModal.querySelector('.modal-action .btn-error');
	var errorMessage = document.getElementById('delete_project_error');
	var requestPath = '/projects/' + projectID;
	confirmModal.dataset.deletePending = 'true';
	confirmModal.setAttribute('aria-busy', 'true');
	if (confirmButton) confirmButton.disabled = true;
	if (errorMessage) {
		errorMessage.textContent = '';
		errorMessage.classList.add('hidden');
	}
	var afterRequest = function(event) {
		var detail = event.detail || {};
		var requestConfig = detail.requestConfig || {};
		if (requestConfig.path !== requestPath) return;
		document.body.removeEventListener('htmx:afterRequest', afterRequest);
		delete confirmModal.dataset.deletePending;
		confirmModal.removeAttribute('aria-busy');
		if (detail.successful) {
			confirmModal.close();
			var editModal = document.getElementById('edit_project_modal');
			if (editModal) editModal.close();
			return;
		}
		if (confirmButton) confirmButton.disabled = false;
		if (errorMessage) {
			errorMessage.textContent = 'Could not delete this project. Its data was kept. Please retry.';
			errorMessage.classList.remove('hidden');
		}
	};
	document.body.addEventListener('htmx:afterRequest', afterRequest);
	htmx.ajax('DELETE', requestPath, {target: 'body', swap: 'none'});
}

templ projectRepoPathHealth(health models.ProjectRepoPathHealth) {
	if health.Status == models.RepoPathHealthHealthy {
		<div id="edit-project-repo-path-health" class="mb-3 rounded-lg border border-success/30 bg-success/10 px-3 py-2 text-sm" data-repo-path-health="healthy">
			<div class="font-medium text-success">Repository path status: Healthy</div>
			<p class="mt-1 text-base-content/70">{ health.Message }</p>
			<code class="mt-1 block break-all text-xs text-base-content/60">{ health.Path }</code>
		</div>
	} else if health.Status == models.RepoPathHealthMissing {
		<div id="edit-project-repo-path-health" class="mb-3 rounded-lg border border-warning/40 bg-warning/10 px-3 py-2 text-sm" data-repo-path-health="missing" role="alert">
			<div class="font-medium text-warning">Repository path status: Missing</div>
			<p class="mt-1 text-base-content/80">{ health.Message } { health.Guidance }</p>
			<code class="mt-1 block break-all text-xs text-base-content/60">{ health.Path }</code>
		</div>
	} else if health.Status == models.RepoPathHealthUnknown {
		<div id="edit-project-repo-path-health" class="mb-3 rounded-lg border border-info/30 bg-info/10 px-3 py-2 text-sm" data-repo-path-health="unknown">
			<div class="font-medium text-info">Repository path status: Unknown</div>
			<p class="mt-1 text-base-content/80">{ health.Message } { health.Guidance }</p>
			<code class="mt-1 block break-all text-xs text-base-content/60">{ health.Path }</code>
		</div>
	}
}

templ EditProjectDialog(project *models.Project, agents []models.LLMConfig, localRepoPathEnabled bool, globalMaxWorkers int, repoPathHealth models.ProjectRepoPathHealth) {
	<dialog id="edit_project_modal" class="modal" data-local-repo-path-enabled={ fmt.Sprintf("%t", localRepoPathEnabled) }>
			<div class="modal-box">
				@ModalCloseButton("edit_project_modal", "Close project settings")
				<h3 class="font-bold text-lg mb-4 pr-10">Project Settings</h3>
			<form
				method="post"
				hx-put={ fmt.Sprintf("/projects/%s", project.ID) }
				hx-swap="none"
			>
				@ProjectSettingsTabs("edit-project")
<div style="height: 60vh; overflow-y: auto;" data-project-tab-content>
				<section id="edit-project-general" role="tabpanel" aria-labelledby="edit-project-general-tab" data-project-panel="general">

				<div class="form-control mb-3">
					<label class="label"><span class="label-text">Name</span></label>
					<input type="text" name="name" class="input input-bordered input-sm" required value={ project.Name }/>
				</div>
				<div class="form-control mb-3">
					<label class="label"><span class="label-text">Description</span></label>
					<textarea name="description" class="textarea textarea-bordered textarea-sm" rows="2">{ project.Description }</textarea>
				</div>
				<div class="form-control mb-3">
					<label class="label"><span class="label-text">Repository Source</span></label>
					if localRepoPathEnabled {
						<select id="edit-project-repo-source" name="repo_source" class="select select-bordered select-sm">
							<option value="local" if projectRepoSource(project) == "local" { selected }>Local Path</option>
							<option value="github" if projectRepoSource(project) == "github" { selected }>GitHub URL</option>
						</select>
					} else if projectRepoSource(project) == "github" {
						<input type="hidden" id="edit-project-repo-source" name="repo_source" value="github"/>
						<div class="text-sm text-base-content/70 bg-base-200 rounded-lg px-3 py-2">GitHub URL</div>
					} else {
						<select id="edit-project-repo-source" name="repo_source" class="select select-bordered select-sm">
							<option value="local" selected>Local Path (existing)</option>
							<option value="github">GitHub URL</option>
						</select>
						<label class="label">
							<span class="label-text-alt opacity-70">Switch to GitHub URL to configure a remote repository, or keep the existing local path.</span>
						</label>
						}
					</div>
					@projectRepoPathHealth(repoPathHealth)
					if localRepoPathEnabled {
						<div id="edit-project-local-fields" class="form-control mb-3">
						<label class="label"><span class="label-text">Repository Path</span></label>
						<div class="flex gap-2">
							<input type="text" id="edit-project-repo-path" name="repo_path" class="input input-bordered input-sm flex-1" value={ project.RepoPath } placeholder="/path/to/repo"/>
							<button
								type="button"
								id="edit-project-browse-btn"
								class="btn btn-outline btn-sm self-center"
							>Choose Folder</button>
						</div>
						<label class="label">
							<span class="label-text-alt opacity-70">Use native folder picker when available. If unavailable, paste an absolute path manually.</span>
						</label>
						<p id="edit-project-picker-feedback" class="text-xs text-base-content/70 hidden"></p>
					</div>
					<div id="edit-project-github-fields" class="form-control mb-3">
						<label class="label"><span class="label-text">GitHub URL</span></label>
							<input type="url" id="edit-project-repo-url" name="repo_url" class="input input-bordered input-sm" value={ project.RepoURL } placeholder="https://github.com/owner/repo"/>
							<label class="label"><span class="label-text-alt opacity-60">Changing this URL re-clones the repository into managed storage.</span></label>
					</div>
				} else if projectRepoSource(project) == "github" {
					<div class="form-control mb-3">
						<label class="label"><span class="label-text">GitHub URL</span></label>
							<input type="url" id="edit-project-repo-url" name="repo_url" class="input input-bordered input-sm" value={ project.RepoURL } placeholder="https://github.com/owner/repo" required/>
							<label class="label"><span class="label-text-alt opacity-60">Changing this URL re-clones the repository into managed storage.</span></label>
					</div>
				} else {
					<input type="hidden" name="repo_path" value={ project.RepoPath }/>
					<div id="edit-project-local-fields" class="form-control mb-3">
						<label class="label"><span class="label-text">Repository Path (current local)</span></label>
						<input type="text" class="input input-bordered input-sm" value={ project.RepoPath } readonly/>
						<label class="label"><span class="label-text-alt opacity-70">This existing local path stays unchanged on save. Switch to GitHub URL above to configure a remote repository.</span></label>
					</div>
					<div id="edit-project-github-fields" class="form-control mb-3 hidden">
						<label class="label"><span class="label-text">GitHub URL</span></label>
							<input type="url" id="edit-project-repo-url" name="repo_url" class="input input-bordered input-sm" placeholder="https://github.com/owner/repo"/>
							<label class="label"><span class="label-text-alt opacity-60">The repository is cloned into managed storage.</span></label>
					</div>
				}
				@ProjectDefaultsFields("edit-project", project, agents, globalMaxWorkers)
				</section>
				@ProjectKnowledgePanel("edit-project", project.ManagedPermissions())
</div>
				<div class="modal-action">
					if !project.IsDefault {
						<button
							type="button"
							class="btn btn-error btn-outline mr-auto"
							onclick="window.openDestructiveConfirmDialog('delete_project_confirm_modal', '', '')"
						>Delete Project</button>
					}
					<button type="button" class="btn" onclick="edit_project_modal.close()">Cancel</button>
					<button type="submit" class="btn btn-primary">Save</button>
				</div>
			</form>
		</div>
		<form method="dialog" class="modal-backdrop">
			<button>close</button>
		</form>
	</dialog>
	if !project.IsDefault {
		@DestructiveConfirmDialog("delete_project_confirm_modal", "Close delete project confirmation", "Delete Project", "Are you sure you want to delete ", "", project.Name, "? This action cannot be undone.", templ.ComponentScript{Call: "delete_project_confirm_modal.close()"}, deleteProjectAction(project.ID)) {
			<p class="font-medium mb-1">The following data will be permanently deleted:</p>
			<ul class="list-disc list-inside space-y-1">
				<li>All tasks and their execution history</li>
				<li>All scheduled runs</li>
				<li>Chat history for this project</li>
				<li>Project-specific settings and configurations</li>
			</ul>
			<p id="delete_project_error" class="hidden text-error mt-3" role="alert"></p>
		}
	}
	<script>
		(function() {
			var m = document.getElementById('edit_project_modal');
			if (m) m.showModal();

			var input = document.getElementById('edit-project-repo-path');
			var githubInput = document.getElementById('edit-project-repo-url');
			var browseBtn = document.getElementById('edit-project-browse-btn');
			var pickerFeedback = document.getElementById('edit-project-picker-feedback');
			var repoSourceSelect = document.getElementById('edit-project-repo-source');
			var localFields = document.getElementById('edit-project-local-fields');
			var githubFields = document.getElementById('edit-project-github-fields');
			var localRepoPathEnabled = !!m && m.dataset.localRepoPathEnabled === 'true';

			function isAbsolutePath(pathValue) {
				return !!pathValue && (pathValue.startsWith('/') || pathValue.startsWith('~/') || pathValue.startsWith('~\\') || /^[a-zA-Z]:[\\/]/.test(pathValue) || pathValue.startsWith('\\\\'));
			}

			function applySelectedDirectoryPath(selectedPath) {
				if (!input || !isAbsolutePath(selectedPath)) return;
				input.value = selectedPath;
				input.dispatchEvent(new Event('input', { bubbles: true }));
			}

			function setPickerFeedback(message, isError) {
				if (!pickerFeedback) return;
				pickerFeedback.textContent = message || '';
				pickerFeedback.classList.remove('hidden');
				pickerFeedback.classList.toggle('text-error', !!isError);
			}

			async function chooseDirectoryNative() {
				if (!browseBtn || !localRepoPathEnabled) return;
				browseBtn.disabled = true;
				try {
					var response = await fetch('/projects/pick-folder', {
						method: 'POST',
						headers: {
							'HX-Request': 'true'
						}
					});
					var payload = {};
					try {
						payload = await response.json();
					} catch (err) {
						payload = {};
					}

					if (response.status === 501) {
						var unavailableMessage = payload && payload.error ? payload.error : 'Native folder picker is unavailable on this system. Paste an absolute path manually.';
						setPickerFeedback(unavailableMessage, true);
						return;
					}
					if (response.status === 403) {
						setPickerFeedback('Local repository path mode is disabled in this environment.', true);
						return;
					}
					if (!response.ok) {
						var message = payload && payload.message ? payload.message : 'Unable to open folder picker. Paste an absolute path manually.';
						setPickerFeedback(message, true);
						return;
					}
					if (!payload.selected) {
						setPickerFeedback('No folder selected. You can paste an absolute path manually.', false);
						return;
					}
					if (!isAbsolutePath(payload.path)) {
						setPickerFeedback('Folder picker returned a non-absolute path. Paste an absolute path manually.', true);
						return;
					}
					applySelectedDirectoryPath(payload.path);
					setPickerFeedback('Folder selected from native picker.', false);
				} catch (err) {
					setPickerFeedback('Native folder picker is unavailable. Paste an absolute path manually.', true);
				} finally {
					browseBtn.disabled = false;
				}
			}

			function updateRepoSourceFields() {
				if (!repoSourceSelect || !localFields || !githubFields) return;
				var source = repoSourceSelect.value === 'github' ? 'github' : 'local';
				localFields.classList.toggle('hidden', source !== 'local');
				githubFields.classList.toggle('hidden', source !== 'github');
				if (localRepoPathEnabled) {
					if (input) input.required = (source === 'local');
				}
				if (githubInput) githubInput.required = (source === 'github');
				if (pickerFeedback) pickerFeedback.classList.add('hidden');
			}

			if (browseBtn && localRepoPathEnabled) {
				browseBtn.addEventListener('click', function() {
					chooseDirectoryNative();
				});
			}

			if (repoSourceSelect) {
				repoSourceSelect.addEventListener('change', updateRepoSourceFields);
				updateRepoSourceFields();
			}
		})();
	</script>
}

templ NewProjectDialog(agents []models.LLMConfig, localRepoPathEnabled bool, globalMaxWorkers int) {
	<dialog id="new_project_modal" class="modal" data-local-repo-path-enabled={ fmt.Sprintf("%t", localRepoPathEnabled) }>
			<div class="modal-box">
				@ModalCloseButton("new_project_modal", "Close new project dialog")
				<h3 class="font-bold text-lg mb-4 pr-10">New Project</h3>
				<form
					id="new-project-form"
					method="post"
					action="/projects"
					hx-post="/projects"
					hx-swap="none"
					hx-indicator="#new-project-create-progress"
				>
				@ProjectSettingsTabs("new-project")
<div style="height: 60vh; overflow-y: auto;" data-project-tab-content>
<section id="new-project-general" role="tabpanel" aria-labelledby="new-project-general-tab" data-project-panel="general">
<div class="form-control mb-3">
					<label class="label"><span class="label-text">Name</span></label>
					<input type="text" id="new-project-name" name="name" class="input input-bordered input-sm" required placeholder="My Project"/>
				</div>
				<div class="form-control mb-3">
					<label class="label"><span class="label-text">Description</span></label>
					<textarea name="description" class="textarea textarea-bordered textarea-sm" rows="2" placeholder="Project description"></textarea>
				</div>
				<div class="form-control mb-3">
					<label class="label"><span class="label-text">Repository Source</span></label>
					if localRepoPathEnabled {
						<select id="new-project-repo-source" name="repo_source" class="select select-bordered select-sm">
							<option value="local" selected>Local Path</option>
							<option value="github">GitHub URL</option>
						</select>
					} else {
						<input type="hidden" id="new-project-repo-source" name="repo_source" value="github"/>
						<div class="text-sm text-base-content/70 bg-base-200 rounded-lg px-3 py-2">GitHub URL</div>
						<label class="label">
							<span class="label-text-alt opacity-70">Local repository paths are disabled in this environment.</span>
						</label>
					}
				</div>
				if localRepoPathEnabled {
					<div id="new-project-local-fields" class="form-control mb-3">
						<label class="label"><span class="label-text">Repository Path</span></label>
						<div class="flex gap-2">
							<input type="text" id="new-project-repo-path" name="repo_path" class="input input-bordered input-sm flex-1" placeholder="/path/to/repo"/>
							<button
								type="button"
								id="new-project-browse-btn"
								class="btn btn-outline btn-sm self-center"
							>Choose Folder</button>
						</div>
						<label class="label">
							<span class="label-text-alt opacity-70">Use native folder picker when available. If unavailable, paste an absolute path manually.</span>
						</label>
						<p id="new-project-picker-feedback" class="text-xs text-base-content/70 hidden"></p>
					</div>
					<div id="new-project-github-fields" class="form-control mb-3 hidden">
						<label class="label"><span class="label-text">GitHub URL</span></label>
							<input type="url" id="new-project-repo-url" name="repo_url" class="input input-bordered input-sm" placeholder="https://github.com/owner/repo"/>
							<label class="label"><span class="label-text-alt opacity-60">The repository is cloned into managed storage using configured GitHub auth or your local git credentials.</span></label>
						</div>					<div id="new-project-create-dir-wrapper" class="form-control mb-2">
						<label class="label cursor-pointer justify-start gap-3">
							<input type="checkbox" id="new-project-create-dir" name="create_directory" value="true" class="checkbox checkbox-sm checkbox-primary"/>
							<span class="label-text">Create directory if it doesn't exist</span>
						</label>
					</div>
					<div id="new-project-path-preview" class="mb-4 hidden">
						<div class="text-xs text-base-content/60 bg-base-200 rounded-lg px-3 py-2">
							<span class="font-medium">Will create:</span>
							<code id="new-project-path-preview-text" class="ml-1 break-all"></code>
						</div>
					</div>
				} else {
					<div class="form-control mb-3">
						<label class="label"><span class="label-text">GitHub URL</span></label>
							<input type="url" id="new-project-repo-url" name="repo_url" class="input input-bordered input-sm" placeholder="https://github.com/owner/repo" required/>
							<label class="label"><span class="label-text-alt opacity-60">The repository is cloned into managed storage using configured GitHub auth or your local git credentials.</span></label>
						</div>				}
				@ProjectDefaultsFields("new-project", &models.Project{}, agents, globalMaxWorkers)
				</section>
				@ProjectKnowledgePanel("new-project", models.NewProjectPermissions())
</div>
				<div id="new-project-error" class="alert alert-error mb-4 hidden">
					<svg xmlns="http://www.w3.org/2000/svg" class="stroke-current shrink-0 h-5 w-5" fill="none" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M10 14l2-2m0 0l2-2m-2 2l-2-2m2 2l2 2m7-2a9 9 0 11-18 0 9 9 0 0118 0z"></path></svg>
					<span id="new-project-error-text"></span>
				</div>
					<div class="modal-action">
						<button type="button" id="new-project-cancel-button" class="btn" onclick="new_project_modal.close()">Cancel</button>
						<button type="submit" id="new-project-create-button" class="btn btn-primary">
							<span id="new-project-create-progress" class="loading loading-spinner loading-sm htmx-indicator" aria-hidden="true"></span>
							<span class="new-project-create-label">Create</span>
							<span class="new-project-create-busy-label hidden">Cloning repository...</span>
						</button>
					</div>
			</form>
		</div>
		<form method="dialog" class="modal-backdrop">
			<button>close</button>
		</form>
	</dialog>
	<script>
		(function() {
			var modal = document.getElementById('new_project_modal');
			if (modal) modal.showModal();

			var repoPathInput = document.getElementById('new-project-repo-path');
			var repoURLInput = document.getElementById('new-project-repo-url');
			var createDirCheckbox = document.getElementById('new-project-create-dir');
			var createDirWrapper = document.getElementById('new-project-create-dir-wrapper');
			var pathPreview = document.getElementById('new-project-path-preview');
			var pathPreviewText = document.getElementById('new-project-path-preview-text');
			var errorDiv = document.getElementById('new-project-error');
			var pickerFeedback = document.getElementById('new-project-picker-feedback');
			var repoSourceSelect = document.getElementById('new-project-repo-source');
			var localFields = document.getElementById('new-project-local-fields');
			var githubFields = document.getElementById('new-project-github-fields');
				var browseBtn = document.getElementById('new-project-browse-btn');
				var form = document.getElementById('new-project-form');
				var createButton = document.getElementById('new-project-create-button');
				var cancelButton = document.getElementById('new-project-cancel-button');
				var createLabel = createButton ? createButton.querySelector('.new-project-create-label') : null;
				var createBusyLabel = createButton ? createButton.querySelector('.new-project-create-busy-label') : null;
				var localRepoPathEnabled = !!modal && modal.dataset.localRepoPathEnabled === 'true';

				function setCreateBusy(isBusy) {
					if (createButton) createButton.disabled = !!isBusy;
					if (cancelButton) cancelButton.disabled = !!isBusy;
					if (createLabel) createLabel.classList.toggle('hidden', !!isBusy);
					if (createBusyLabel) createBusyLabel.classList.toggle('hidden', !isBusy);
				}

				function updatePathPreview() {
				if (!repoPathInput || !createDirCheckbox || !repoSourceSelect || !pathPreview || !pathPreviewText) return;
				var path = repoPathInput.value.trim();
				if (repoSourceSelect.value === 'local' && createDirCheckbox.checked && path) {
					pathPreviewText.textContent = path;
					pathPreview.classList.remove('hidden');
				} else {
					pathPreview.classList.add('hidden');
				}
				if (errorDiv) {
					errorDiv.classList.add('hidden');
				}
			}

			function updateRepoSourceFields() {
				if (!repoSourceSelect || !localFields || !githubFields) return;
				var source = repoSourceSelect.value === 'github' ? 'github' : 'local';
				localFields.classList.toggle('hidden', source !== 'local');
				githubFields.classList.toggle('hidden', source !== 'github');
				if (createDirWrapper) {
					createDirWrapper.classList.toggle('hidden', source !== 'local');
				}
				if (repoPathInput) {
					repoPathInput.required = (source === 'local');
				}
				if (repoURLInput) repoURLInput.required = (source === 'github');
				if (createDirCheckbox && source !== 'local') {
					createDirCheckbox.checked = false;
				}
				updatePathPreview();
			}

			function isAbsolutePath(pathValue) {
				return !!pathValue && (pathValue.startsWith('/') || pathValue.startsWith('~/') || pathValue.startsWith('~\\') || /^[a-zA-Z]:[\\/]/.test(pathValue) || pathValue.startsWith('\\\\'));
			}

			function applySelectedDirectoryPath(selectedPath) {
				if (!repoPathInput || !isAbsolutePath(selectedPath)) return;
				repoPathInput.value = selectedPath;
				repoPathInput.dispatchEvent(new Event('input', { bubbles: true }));
			}

			function setPickerFeedback(message, isError) {
				if (!pickerFeedback) return;
				pickerFeedback.textContent = message || '';
				pickerFeedback.classList.remove('hidden');
				pickerFeedback.classList.toggle('text-error', !!isError);
			}

			async function chooseDirectoryNative() {
				if (!browseBtn || !localRepoPathEnabled) return;
				browseBtn.disabled = true;
				try {
					var response = await fetch('/projects/pick-folder', {
						method: 'POST',
						headers: {
							'HX-Request': 'true'
						}
					});
					var payload = {};
					try {
						payload = await response.json();
					} catch (err) {
						payload = {};
					}

					if (response.status === 501) {
						var unavailableMessage = payload && payload.error ? payload.error : 'Native folder picker is unavailable on this system. Paste an absolute path manually.';
						setPickerFeedback(unavailableMessage, true);
						return;
					}
					if (response.status === 403) {
						setPickerFeedback('Local repository path mode is disabled in this environment.', true);
						return;
					}
					if (!response.ok) {
						var message = payload && payload.message ? payload.message : 'Unable to open folder picker. Paste an absolute path manually.';
						setPickerFeedback(message, true);
						return;
					}
					if (!payload.selected) {
						setPickerFeedback('No folder selected. You can paste an absolute path manually.', false);
						return;
					}
					if (!isAbsolutePath(payload.path)) {
						setPickerFeedback('Folder picker returned a non-absolute path. Paste an absolute path manually.', true);
						return;
					}
					applySelectedDirectoryPath(payload.path);
					setPickerFeedback('Folder selected from native picker.', false);
				} catch (err) {
					setPickerFeedback('Native folder picker is unavailable. Paste an absolute path manually.', true);
				} finally {
					browseBtn.disabled = false;
				}
			}

			if (repoPathInput) {
				repoPathInput.addEventListener('input', updatePathPreview);
			}
			if (createDirCheckbox) {
				createDirCheckbox.addEventListener('change', updatePathPreview);
			}
			if (browseBtn && localRepoPathEnabled) {
				browseBtn.addEventListener('click', function() {
					chooseDirectoryNative();
				});
			}
				if (repoSourceSelect && localRepoPathEnabled) {
					repoSourceSelect.addEventListener('change', updateRepoSourceFields);
					updateRepoSourceFields();
				}
				if (form) {
					form.addEventListener('htmx:beforeRequest', function() {
						setCreateBusy(true);
					});
					form.addEventListener('htmx:afterRequest', function() {
						setCreateBusy(false);
					});
					form.addEventListener('htmx:sendError', function() {
						setCreateBusy(false);
					});
					form.addEventListener('htmx:abort', function() {
						setCreateBusy(false);
					});
				}

				if (modal) {
				modal.addEventListener('close', function() {
					var form = document.getElementById('new-project-form');
					if (form) form.reset();
					if (errorDiv) errorDiv.classList.add('hidden');
					if (pathPreview) pathPreview.classList.add('hidden');
					if (pickerFeedback) pickerFeedback.classList.add('hidden');
					if (repoSourceSelect && localRepoPathEnabled) {
						updateRepoSourceFields();
					}
				});
			}
		})();
	</script>
}


templ ProjectSettingsTabs(prefix string) {
 <style>
  [data-project-panel="general"] .label { padding: 0.125rem 0; }
  [data-project-panel="general"] :is(.input, .select, .textarea) { width: 100%; min-width: 0; }
  [data-project-panel="general"] .flex > .btn { flex-shrink: 0; }
  [data-project-panel="general"] .textarea { min-height: 3.5rem; }
  [data-project-panel="general"] .project-defaults-fields { display: grid; grid-template-columns: repeat(2, minmax(0, 1fr)); gap: 1rem; }
  [data-project-panel="general"] .project-defaults-fields .form-control { min-width: 0; }
  [data-project-panel="general"] .project-defaults-fields :is(.input, .select) { width: 100%; min-width: 0; }
  [data-project-panel="general"] .project-defaults-fields .label { justify-content: flex-start; gap: 0.375rem; }
  [data-project-panel="knowledge"] .table { table-layout: fixed; }
  [data-project-panel="knowledge"] .table :is(th, td) { padding: 0.75rem 0; }
  [data-project-panel="knowledge"] .table th:first-child { width: 50%; }
  @media (max-width: 640px) { [data-project-panel="general"] .project-defaults-fields { grid-template-columns: minmax(0, 1fr); } }

 </style>
 <div role="tablist" aria-label="Project settings" class="tabs tabs-bordered mb-4" onkeydown="window.projectSettingsTabKey(event)">
  <button type="button" role="tab" id={ prefix + "-general-tab" } aria-controls={ prefix + "-general" } aria-selected="true" tabindex="0" class="tab tab-active" data-project-tab="general" onclick="window.selectProjectSettingsTab(this)">General</button>
  <button type="button" role="tab" id={ prefix + "-knowledge-tab" } aria-controls={ prefix + "-knowledge" } aria-selected="false" tabindex="-1" class="tab" data-project-tab="knowledge" onclick="window.selectProjectSettingsTab(this)">Skills &amp; Memory</button>
 </div>
 <script>
 window.selectProjectSettingsTab = function(button) {
  var form = button.closest('form');
  form.querySelectorAll('[data-project-tab]').forEach(function(tab) {
   var active = tab === button;
   tab.classList.toggle('tab-active', active);
   tab.setAttribute('aria-selected', String(active));
   tab.tabIndex = active ? 0 : -1;
  });
  form.querySelectorAll('[data-project-panel]').forEach(function(panel) { panel.hidden = panel.dataset.projectPanel !== button.dataset.projectTab; });
 };
 window.projectSettingsTabKey = function(event) {
  var tabs = Array.from(event.currentTarget.querySelectorAll('[role="tab"]'));
  var index = tabs.indexOf(document.activeElement);
  if (index < 0 || !['ArrowLeft', 'ArrowRight', 'Home', 'End'].includes(event.key)) return;
  event.preventDefault();
  index = event.key === 'Home' ? 0 : event.key === 'End' ? tabs.length - 1 : (index + (event.key === 'ArrowRight' ? 1 : -1) + tabs.length) % tabs.length;
  window.selectProjectSettingsTab(tabs[index]);
  tabs[index].focus();
 };
 // Reveal the relevant tab before the browser focuses an invalid field in a hidden panel.
 (function() {
  var form = document.currentScript.closest('form');
  form.addEventListener('reset', function() {
   var global = form.querySelector('[data-global-skill-switch]');
   global.disabled = !form.elements.write_skills.defaultChecked;
   form.elements.allow_global_skill_writes.value = global.defaultChecked ? 'on' : 'off';
  });
  form.addEventListener('invalid', function(event) {
   var panel = event.target.closest('[data-project-panel]');
   if (panel && panel.hidden) window.selectProjectSettingsTab(form.querySelector('[data-project-tab="' + panel.dataset.projectPanel + '"]'));
  }, true);
  form.closest('dialog').addEventListener('close', function() { window.selectProjectSettingsTab(form.querySelector('[data-project-tab="general"]')); });
 })();
 </script>
}

templ ProjectKnowledgePanel(prefix string, permissions models.SkillMemoryPermissions) {
 <section id={ prefix + "-knowledge" } role="tabpanel" aria-labelledby={ prefix + "-knowledge-tab" } data-project-panel="knowledge" hidden>
  <input type="hidden" name="skill_memory_settings_present" value="true"/>
  <table class="table w-full text-sm">
   <thead><tr><th scope="col" class="text-sm font-medium">Resource</th><th class="text-center"><span class="inline-flex items-center gap-1 text-sm font-medium">Read @projectPermissionHelp("Read", "Chat and tasks can read. Turning reading off does not erase information already loaded into the conversation.")</span></th><th class="text-center"><span class="inline-flex items-center gap-1 text-sm font-medium">Write @projectPermissionHelp("Write", "Permitted tasks, task-thread follow-ups, and maintenance only. Ordinary chat cannot write.")</span></th></tr></thead>
   <tbody>
    <tr><th scope="row" class="text-sm font-medium">Skills</th><td class="text-center"><input type="checkbox" class="toggle toggle-sm" name="read_skills" aria-label="Read skills" checked?={ permissions.ReadSkills }/></td><td class="text-center"><input type="checkbox" class="toggle toggle-sm" name="write_skills" aria-label="Write skills" checked?={ permissions.WriteSkills } onchange="var global = this.form.querySelector('[data-global-skill-switch]'); global.disabled = !this.checked; if (!this.checked) { global.checked = false; this.form.elements.allow_global_skill_writes.value = 'off'; }"/></td></tr>
    <tr><th scope="row" class="text-sm font-medium">Memories</th><td class="text-center"><input type="checkbox" class="toggle toggle-sm" name="read_memories" aria-label="Read memories" checked?={ permissions.ReadMemories }/></td><td class="text-center"><input type="checkbox" class="toggle toggle-sm" name="write_memories" aria-label="Write memories" checked?={ permissions.WriteMemories }/></td></tr>
    <tr><th scope="row" class="text-sm font-medium"><span class="inline-flex items-center gap-1 text-sm font-medium">Allow global skill writes @projectPermissionHelp("Allow global skill writes", "Allows changes to skills shared across projects. Requires Write skills.")</span></th><td></td><td class="text-center"><input type="checkbox" class="toggle toggle-sm" data-global-skill-switch aria-label="Allow global skill writes" checked?={ permissions.WriteSkills && permissions.AllowGlobalSkillWrites } disabled?={ !permissions.WriteSkills } onchange="this.form.elements.allow_global_skill_writes.value = this.checked ? 'on' : 'off'"/></td></tr>
   </tbody>
  </table>
  <input type="hidden" name="allow_global_skill_writes" value={ projectGlobalSkillWriteValue(permissions) }/>
 </section>
}

func projectGlobalSkillWriteValue(permissions models.SkillMemoryPermissions) string {
 if permissions.WriteSkills && permissions.AllowGlobalSkillWrites { return "on" }
 return "off"
}

templ projectPermissionHelp(label, help string) {
 <button type="button" class="btn btn-ghost btn-circle btn-xs shrink-0" data-model-help={ help } aria-label={ "About " + label } aria-expanded="false">
 <svg xmlns="http://www.w3.org/2000/svg" class="h-4 w-4" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2" aria-hidden="true"><circle cx="12" cy="12" r="9"></circle><path stroke-linecap="round" d="M12 11v6"></path><path stroke-linecap="round" d="M12 7h.01"></path></svg>
 </button>
 }

templ ProjectDefaultsFields(prefix string, project *models.Project, agents []models.LLMConfig, globalMaxWorkers int) {
  <div class="project-defaults-fields">
   <div class="form-control">
    <div class="label">
     <label for={ prefix + "-default-model" } class="text-sm font-medium">Default Model</label>
     @projectPermissionHelp("Default Model", "Used when no model is specified on a task. Leave set to Global default to inherit the global model.")
    </div>
    <select id={ prefix + "-default-model" } name="default_agent_config_id" class="select select-bordered select-sm">
     <option value="">Global default</option>
     for _, agent := range agents {
      <option value={ agent.ID } selected?={ isProjectDefaultModel(project, agent.ID) }>
       { agent.Name } ({ string(agent.Provider) }/{ agent.Model })
       if agent.IsDefault {
        [global default]
       }
      </option>
     }
    </select>
   </div>
   <div class="form-control">
    <div class="label">
     <label for={ prefix + "-max-workers" } class="text-sm font-medium">Worker limit</label>
     @projectPermissionHelp("Worker limit", "Maximum concurrent workers for this project. Leave blank to inherit the global limit. Positive values cannot exceed the current global limit.")
    </div>
    <input type="number" name="max_workers" id={ prefix + "-max-workers" } value={ projectMaxWorkersValue(project) } min="0" if globalMaxWorkers > 0 { max={ fmt.Sprintf("%d", globalMaxWorkers) } } step="1" placeholder="Inherit" class="input input-bordered input-sm" data-tooltip-disabled/>
    if projectWorkerLimitExceedsGlobal(globalMaxWorkers, project.MaxWorkers) {
     <p class="text-xs text-warning mt-1">The current project limit exceeds the global limit of { fmt.Sprintf("%d", globalMaxWorkers) }. Lower it before saving.</p>
    }
   </div>
  </div>
}
