package components

import (
	"fmt"
	llmoutput "github.com/openvibely/openvibely/internal/llm/output"
	llmtranscript "github.com/openvibely/openvibely/internal/llm/transcript"
	"github.com/openvibely/openvibely/internal/models"
	"regexp"
	"strings"
	"time"
)

// chatContentRevision returns a compact fingerprint for comparing rendered
// transcript snapshots without repeatedly comparing the full response text.
func chatContentRevision(content string) string {
	const offset64 = uint64(14695981039346656037)
	const prime64 = uint64(1099511628211)
	hash := offset64
	for i := 0; i < len(content); i++ {
		hash ^= uint64(content[i])
		hash *= prime64
	}
	return fmt.Sprintf("%x-%016x", len(content), hash)
}

// ChatExecutionRevision fingerprints the server-rendered state for one execution.
// Browsers use it to prove unchanged pairs still match an authoritative snapshot
// before advancing the root transcript revision after live DOM reconciliation.
func ChatExecutionRevision(exec models.Execution) string {
	const offset64 = uint64(14695981039346656037)
	const prime64 = uint64(1099511628211)
	hash := offset64
	write := func(value string) {
		for i := 0; i < len(value); i++ {
			hash ^= uint64(value[i])
			hash *= prime64
		}
		hash ^= 0xff
		hash *= prime64
	}
	write(exec.ID)
	write(string(exec.Status))
	write(exec.PromptSent)
	write(exec.Output)
	write(exec.ErrorMessage)
	write(fmt.Sprintf("%t", exec.IsFollowup))
	return fmt.Sprintf("%016x", hash)
}

// ChatTranscriptRevision fingerprints the server-rendered transcript and pending-input
// state so polling/reconnect paths can reject authoritative no-op responses before
// touching the live DOM.
func ChatTranscriptRevision(executions []models.Execution, pendingInputs []models.ThreadInput, extra string) string {
	const offset64 = uint64(14695981039346656037)
	const prime64 = uint64(1099511628211)
	hash := offset64
	write := func(value string) {
		for i := 0; i < len(value); i++ {
			hash ^= uint64(value[i])
			hash *= prime64
		}
		hash ^= 0xff
		hash *= prime64
	}
	write(extra)
	for _, exec := range executions {
		write(ChatExecutionRevision(exec))
	}
	for _, input := range pendingInputs {
		write(input.ID)
		write(string(input.InputMode))
		write(string(input.InputStatus))
		write(input.ExpectedTurnID)
		write(input.Content)
		write(input.AttachmentSessionID)
	}
	return fmt.Sprintf("%x-%016x", len(executions)+len(pendingInputs), hash)
}

// jsStringLength returns the JavaScript string.length for a Go string.
// JS uses UTF-16 encoding, so characters outside the BMP (U+10000+) count as
// 2 code units (surrogate pair), matching how JS .length works.
func jsStringLength(s string) int {
	n := 0
	for _, r := range s {
		if r >= 0x10000 {
			n += 2 // surrogate pair
		} else {
			n += 1
		}
	}
	return n
}

// ChatInputFormConfig holds configuration for the shared chat input form.
type ChatInputFormConfig struct {
	FormID                 string
	InputID                string
	PostEndpoint           string
	TargetID               string
	Agents                 []models.LLMConfig
	ShowModelSelector      bool
	ShowModeSelector       bool
	ChatMode               models.ChatMode // default when not persisted
	TaskID                 string
	IsRunning              bool
	ActiveTurnID           string
	StopEndpoint           string // non-empty turns the send button into a stop button while IsRunning
	SteerEndpoint          string // guarded explicit steering endpoint used by the platform modifier-click shortcut
	ProjectID              string // non-empty enables model selection persistence via localStorage
	SelectedAgentID        string // initial model selection; defaults to auto when empty
	PendingInputs          []models.ThreadInput
	QueuedSteerEndpointFor func(models.ThreadInput) string
}

// chatElementIDs returns derived element IDs based on the form ID prefix.
func chatAttachmentPreviewID(formID string) string { return formID + "-attachments-preview" }
func chatAttachmentListID(formID string) string    { return formID + "-attachments-list" }
func chatSessionInputID(formID string) string      { return formID + "-session-id" }
func chatFileInputID(formID string) string         { return formID + "-file-input" }
func chatDropOverlayID(formID string) string       { return formID + "-drop-overlay" }
func chatMessageHistoryStorageKey(config ChatInputFormConfig) string {
	if config.TaskID != "" {
		return "openvibely-task-thread-message-history-" + config.TaskID
	}
	return "openvibely-chat-message-history"
}
func chatAttachmentStateKey(config ChatInputFormConfig) string {
	if config.TaskID != "" {
		return "openvibely-task-thread-attachments-" + config.TaskID
	}
	if config.ProjectID != "" {
		return "openvibely-chat-attachments-" + config.ProjectID
	}
	return "openvibely-chat-attachments-" + config.FormID
}
func selectedAgentOrAuto(agentID string) string {
	if agentID == "" {
		return "auto"
	}
	return agentID
}

func selectedAgentLabel(agentID string, agents []models.LLMConfig) string {
	value := selectedAgentOrAuto(agentID)
	switch value {
	case "auto":
		return "Auto"
	case "default":
		return "Default"
	}
	for _, agent := range agents {
		if agent.ID == value {
			return fmt.Sprintf("%s (%s)", agent.Name, agent.Model)
		}
	}
	return "Auto"
}

func chatModeOrDefault(mode models.ChatMode) string {
	if mode == "" {
		return string(models.ChatModeOrchestrate)
	}
	return string(mode)
}

func hasPendingComposerInputs(inputs []models.ThreadInput) bool {
	for _, input := range inputs {
		if input.InputMode == models.ThreadInputModeQueued || input.InputMode == models.ThreadInputModeSteering {
			return true
		}
	}
	return false
}

func pendingInputsOOBTarget(taskID string) string {
	if taskID == "" {
		return "beforeend"
	}
	return "beforeend:#pending-thread-inputs[data-task-id=\"" + taskID + "\"]"
}

templ ChatLoadingDots(size string) {
	<span
		class={
			"ov-loading-dots",
			templ.KV("ov-loading-dots-xs", size == "xs"),
			templ.KV("ov-loading-dots-sm", size != "xs"),
		}
		aria-hidden="true"
	>
		<span class="ov-loading-dot"></span>
		<span class="ov-loading-dot"></span>
		<span class="ov-loading-dot"></span>
	</span>
}

// ChatBubble renders a static chat message bubble (completed or failed text).
templ ChatBubble(role, content string) {
	<div class={ chatBubbleClass(role), "rounded-xl p-4" }>
		<div class="text-xs font-semibold opacity-50 mb-2">
			{ role }
		</div>
		<div class="chat-bubble-inner">
			if role == "User" {
				<div class="whitespace-pre-wrap leading-relaxed text-sm" style="word-wrap: break-word;">{ CleanDisplayContent(content) }</div>
			} else {
				<div class="chat-stream-content" data-raw-revision={ chatContentRevision(content) } data-raw-content={ NormalizeDisplayMarkers(content) }></div>
			}
		</div>
	</div>
}

// ChatBubbleError renders an assistant error message bubble.
templ ChatBubbleError(role, errorMsg, output string) {
	<div class={ chatBubbleClass(role), "rounded-xl p-4" }>
		<div class="text-xs font-semibold opacity-50 mb-2">
			{ role }
		</div>
		<div class="chat-bubble-inner">
			if errorMsg != "" {
				<div class="text-error/80 text-sm font-medium mb-2">{ "Error: " + errorMsg }</div>
			}
			if output != "" {
				<div class="chat-stream-content" data-raw-revision={ chatContentRevision(output) } data-raw-content={ NormalizeDisplayMarkers(output) }></div>
			}
		</div>
	</div>
}

// ChatBubbleThinking renders a loading/thinking indicator bubble.
templ ChatBubbleThinking(role string) {
	<div class={ chatBubbleClass(role), "rounded-xl p-4" }>
		<div class="text-xs font-semibold opacity-50 mb-2">
			{ role }
		</div>
		<div class="chat-bubble-inner">
			<div id="streaming-message" class="flex flex-col items-start gap-1">
				<span class="block h-5" aria-hidden="true"></span>
				@ChatLoadingDots("sm")
			</div>
		</div>
	</div>
}

// ChatBubbleRunning renders a running bubble with partial output and a loading indicator.
templ ChatBubbleRunning(role, partialOutput string) {
	<div class={ chatBubbleClass(role), "rounded-xl p-4" }>
		<div class="text-xs font-semibold opacity-50 mb-2">
			{ role }
		</div>
		<div class="chat-bubble-inner">
			if cleanedOutput := CleanDisplayContent(partialOutput); cleanedOutput == "" || strings.TrimSpace(cleanedOutput) == "" {
				<div id="streaming-message" class="flex items-center gap-2">
					@ChatLoadingDots("sm")
					<span class="text-sm opacity-60">Working...</span>
				</div>
			} else {
				<div class="whitespace-pre-wrap leading-relaxed text-sm" style="word-wrap: break-word;">{ cleanedOutput }</div>
				<div class="flex items-center gap-1 mt-2 opacity-40">
					@ChatLoadingDots("xs")
				</div>
			}
		</div>
	</div>
}

// ChatBubbleWithAttachments renders a message with inline attachment display.
templ ChatBubbleWithAttachments(role, content string, attachments []models.ChatAttachment, projectID string) {
	<div class={ chatBubbleClass(role), "rounded-xl p-4" }>
		<div class="text-xs font-semibold opacity-50 mb-2 flex items-center gap-2">
			{ role }
			if len(attachments) > 0 {
				<span class="badge badge-sm badge-neutral">
					<svg class="w-3 h-3 mr-1" fill="none" stroke="currentColor" viewBox="0 0 24 24">
						<path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M15.172 7l-6.586 6.586a2 2 0 102.828 2.828l6.414-6.586a4 4 0 00-5.656-5.656l-6.415 6.585a6 6 0 108.486 8.486L20.5 13"></path>
					</svg>
					{ fmt.Sprintf("%d", len(attachments)) }
				</span>
			}
		</div>
		<div class="chat-bubble-inner">
			<div class="whitespace-pre-wrap leading-relaxed text-sm" style="word-wrap: break-word;">{ CleanDisplayContent(content) }</div>
			if len(attachments) > 0 {
				<div class="mt-3 pt-3 border-t border-base-content/10">
					<div class="text-xs font-medium opacity-70 mb-2">Attachments</div>
					for _, att := range attachments {
						if IsImageMediaType(att.MediaType) {
							<div class="mb-3">
								<a href={ templ.SafeURL(ChatAttachmentDownloadURL(att.ID, projectID)) } target="_blank" class="block">
									<img
										src={ templ.SafeURL(ChatAttachmentDownloadURL(att.ID, projectID)) }
										alt={ att.FileName }
										class="max-w-full rounded-lg border border-base-content/10 hover:opacity-90 transition-opacity cursor-pointer"
										style="max-height: 400px; object-fit: contain;"
										loading="lazy"
										data-chat-attachment-image="true"
									/>
								</a>
								<div class="flex items-center gap-2 text-xs opacity-60 mt-1.5">
									<svg class="w-3 h-3 flex-shrink-0" fill="none" stroke="currentColor" viewBox="0 0 24 24">
										<path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M4 16l4.586-4.586a2 2 0 012.828 0L16 16m-2-2l1.586-1.586a2 2 0 012.828 0L20 14m-6-6h.01M6 20h12a2 2 0 002-2V6a2 2 0 00-2-2H6a2 2 0 00-2 2v12a2 2 0 002 2z"></path>
									</svg>
									<span class="font-medium">{ att.FileName }</span>
									<span>({ FormatFileSize(att.FileSize) })</span>
								</div>
							</div>
						} else {
							<div class="flex items-center gap-2 text-xs opacity-90 mb-1.5">
								<svg class="w-3.5 h-3.5 flex-shrink-0" fill="none" stroke="currentColor" viewBox="0 0 24 24">
									<path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M15.172 7l-6.586 6.586a2 2 0 102.828 2.828l6.414-6.586a4 4 0 00-5.656-5.656l-6.415 6.585a6 6 0 108.486 8.486L20.5 13"></path>
								</svg>
								<a href={ templ.SafeURL(ChatAttachmentDownloadURL(att.ID, projectID)) } class="hover:underline font-medium" target="_blank">
									{ att.FileName }
								</a>
								<span class="opacity-60">({ FormatFileSize(att.FileSize) })</span>
							</div>
						}
					}
				</div>
			}
		</div>
	</div>
}

// ChatBubbleStreaming renders a streaming SSE message bubble for new messages.
// messagesContainerID: the ID of the scrollable messages container (e.g. "chat-messages" or "task-thread-messages")
// pausePollingTargetID: if non-empty, pauses HTMX polling on this element during streaming (thread uses "task-thread-view")
// isThread: true uses thread behavior (refresh on done); false uses main-chat behavior (result-link conversion + transcript-control cleaning)
templ ChatBubbleStreaming(role, execID, messagesContainerID, pausePollingTargetID string, isThread bool) {
	<div class={ chatBubbleClass(role), "rounded-xl p-4" }>
		<div class="text-xs font-semibold opacity-50 mb-2">
			{ role }
		</div>
		<div class="chat-bubble-inner">
			<div id={ "streaming-thinking-" + execID } class="flex flex-col items-start gap-1">
				<span class="block h-5" aria-hidden="true"></span>
				@ChatLoadingDots("sm")
			</div>
			<div id={ "mixture-progress-" + execID } class="mixture-progress hidden mb-2 text-xs opacity-70" data-exec-id={ execID } role="status" aria-live="polite"></div>
			<div
				id={ "streaming-message-" + execID }
				class="whitespace-pre-wrap leading-relaxed text-sm hidden"
				data-exec-id={ execID }
				data-messages-container={ messagesContainerID }
				data-pause-polling-target={ pausePollingTargetID }
				data-is-thread={ boolStr(isThread) }
				style="word-wrap: break-word;"
			></div>
			<div id={ "streaming-dots-" + execID } class="hidden flex items-center gap-1 mt-2 opacity-40">
				@ChatLoadingDots("xs")
			</div>
			<script type="text/javascript">
				(function() {
					var streamingDots = document.currentScript.previousElementSibling;
					var container = streamingDots.previousElementSibling;
					var execId = container.getAttribute('data-exec-id');
					var thinkingIndicator = document.getElementById('streaming-thinking-' + execId);
					var messagesId = container.getAttribute('data-messages-container');
					var pauseTarget = container.getAttribute('data-pause-polling-target');
					var isThread = container.getAttribute('data-is-thread') === 'true';
					// Pause HTMX polling if requested (prevents morph:outerHTML from destroying the EventSource)
					if (pauseTarget) {
						window._taskThreadStreamingActive = true;
						var pollingEl = document.getElementById(pauseTarget);
							if (pollingEl) {
								if (!pollingEl.hasAttribute('data-paused-hx-trigger')) {
									pollingEl.setAttribute('data-paused-hx-trigger', pollingEl.getAttribute('hx-trigger') || '');
								}
								if (!pollingEl.hasAttribute('data-paused-hx-get')) {
									pollingEl.setAttribute('data-paused-hx-get', pollingEl.getAttribute('hx-get') || '');
								}
								pollingEl.removeAttribute('hx-trigger');
								pollingEl.removeAttribute('hx-get');
								htmx.process(pollingEl);
							}
						}

						function stopThreadPolling() {
							if (!pauseTarget) return;
							var pollingEl = document.getElementById(pauseTarget);
							if (!pollingEl) return;
							pollingEl.setAttribute('data-task-active', 'false');
							pollingEl.removeAttribute('hx-trigger');
							pollingEl.removeAttribute('hx-get');
							if (typeof htmx !== 'undefined') htmx.process(pollingEl);
						}

						function restoreThreadPollingFallback() {
							if (!pauseTarget) return;
							var pollingEl = document.getElementById(pauseTarget);
							if (!pollingEl || pollingEl.getAttribute('data-task-active') === 'false') return;
							var pausedTrigger = pollingEl.getAttribute('data-paused-hx-trigger');
							var pausedGet = pollingEl.getAttribute('data-paused-hx-get');
							if (pausedTrigger) pollingEl.setAttribute('hx-trigger', pausedTrigger);
							if (pausedGet) pollingEl.setAttribute('hx-get', pausedGet);
							if (typeof htmx !== 'undefined') htmx.process(pollingEl);
						}

						function refreshThreadComposerAction() {
							if (typeof htmx === 'undefined' || !document.getElementById('task-thread-form-primary-action')) return;
							var view = document.getElementById('task-thread-view');
							var taskId = view ? (view.getAttribute('data-task-id') || '') : '';
							if (!taskId) return;
							htmx.ajax('GET', '/tasks/' + encodeURIComponent(taskId) + '/thread/composer-action', {target: '#task-thread-form-primary-action', swap: 'outerHTML'});
						}

						function showThreadTerminalStatus(status) {
							stopThreadPolling();
							var form = document.getElementById('task-thread-form');
							if (form) {
								var textarea = document.getElementById('task-message-input');
								if (textarea && window.refreshChatComposerShortcutHint) window.refreshChatComposerShortcutHint(textarea);
								refreshThreadComposerAction();
							}
							var messages = document.getElementById(messagesId);
							if (!messages || document.getElementById('task-thread-terminal-status')) return;
						var wrap = document.createElement('div');
						wrap.id = 'task-thread-terminal-status';
						wrap.className = 'flex items-center justify-center gap-2 py-2';
							var inner = document.createElement('div');
								var statusClass = status === 'failed' ? 'text-error' : (status === 'cancelled' ? 'text-warning' : 'text-success');
								inner.className = 'flex items-center gap-2 text-sm opacity-70 ' + statusClass;
								var icon = document.createElement('span');
								icon.setAttribute('aria-hidden', 'true');
								icon.textContent = status === 'failed' ? '✕' : (status === 'cancelled' ? '■' : '✓');
								var text = document.createElement('span');
								text.textContent = 'Task ' + (status === 'failed' ? 'failed' : (status === 'cancelled' ? 'cancelled' : 'completed'));
							inner.appendChild(icon);
							inner.appendChild(text);
						wrap.appendChild(inner);
							messages.appendChild(wrap);
						}

					// Get or create page-level tracker for this chat container.
					// resolveScrollTracker handles stale/replaced elements (morph swaps),
					// which is what previously caused smart scrolling to "freeze" in
					// long-lived conversations until a full page refresh.
				var chatMessages = document.getElementById(messagesId);
				var tracker = null;
				var trackerKey = 'scrollTracker_' + messagesId;

				if (chatMessages) {
					if (window.resolveScrollTracker) {
						tracker = window.resolveScrollTracker(trackerKey, chatMessages);
					} else {
						if (!window[trackerKey]) {
							window[trackerKey] = new window.ChatScrollTracker(chatMessages);
						}
						tracker = window[trackerKey];
					}
					// The shared composer commits deliberate-send pin intent only after
					// the server accepts the message. Stream discovery alone must preserve
					// upward-reading intent from this or another browser surface.
				}
						// Buffer for accumulating streaming content
						var textBuffer = '';
						var streamTextEncoder = window.TextEncoder ? new TextEncoder() : null;
						function utf8ByteLength(value) { return streamTextEncoder ? streamTextEncoder.encode(value || '').length : unescape(encodeURIComponent(value || '')).length; }
							var renderScheduled = false;
							var renderDelayTimer = null;
							var lastRenderFinishedAt = 0;
							var lastRenderedSourceLength = 0;
							var largeStreamRenderThreshold = 100 * 1024;
							var largeStreamRenderInterval = 250;
							function renderBufferedOutput(force, yieldLarge) {
							if (!window.renderStreamingContent) {
							container.classList.remove('text-error/80', 'font-medium');
								container.textContent = window.normalizeTranscriptMarkers ? window.normalizeTranscriptMarkers(textBuffer) : textBuffer;
								return;
							}
							if (!force && renderScheduled) return;
							var runRender = function() {
							var sourceLength = textBuffer.length;
							var renderText = textBuffer;
							if (Object.prototype.hasOwnProperty.call(container, '_authoritativeTerminalContent')) {
								renderText = String(container._authoritativeTerminalContent || '');
								textBuffer = renderText;
								sourceLength = renderText.length;
							}
							if (!force && sourceLength === lastRenderedSourceLength) return;
						// Refresh tracker against the live messages element. If a morph
						// swap replaced the container mid-stream, the old tracker would
						// be holding a detached element and isNearBottom() would always
						// be true — causing endless auto-scroll until page refresh.
						var liveMessages = document.getElementById(messagesId);
						if (liveMessages && window.resolveScrollTracker) {
							tracker = window.resolveScrollTracker(trackerKey, liveMessages);
						}
						var shouldScroll = !tracker || tracker.shouldAutoScroll();
					container.classList.remove('text-error/80', 'font-medium');
							function finishScheduledRender(committed) {
								if (committed === false) {
									renderScheduled = false;
									if (textBuffer.length !== sourceLength) renderBufferedOutput(false);
									return;
								}
								renderScheduled = false;
								if (Object.prototype.hasOwnProperty.call(container, '_authoritativeTerminalContent') && String(container._authoritativeTerminalContent || '') !== renderText) {
									textBuffer = String(container._authoritativeTerminalContent || '');
									renderBufferedOutput(true, false);
									return;
								}
								lastRenderedSourceLength = sourceLength;
								lastRenderFinishedAt = Date.now();
								// Auto-scroll only if the viewport was pinned before this render grew the DOM.
								if (shouldScroll) {
							requestAnimationFrame(function() {
								var chatMessages = document.getElementById(messagesId);
								if (chatMessages) {
									window.chatAutoScroll.scrollToBottom(chatMessages, false);
								}
							});
								}
								if (textBuffer.length !== sourceLength) renderBufferedOutput(false);
							}
							var shouldYield = renderText.length >= largeStreamRenderThreshold && yieldLarge !== false;
							var liveRenderer = window.renderLiveChatContent || window.renderStreamingContent;
							var renderPromise = liveRenderer(container, renderText, shouldYield);
							if (renderPromise && typeof renderPromise.then === 'function') {
					return renderPromise.then(finishScheduledRender).catch(function(err) {
						renderScheduled = false;
						console.error('[chat] streaming render failed:', err);
						// Preserve the complete response even if the styled renderer fails.
							container.textContent = renderText;
							if (window.setChatRawContent) window.setChatRawContent(container, renderText);
							else container.setAttribute('data-raw-content', renderText);
						lastRenderedSourceLength = sourceLength;
						lastRenderFinishedAt = Date.now();
						if (textBuffer.length !== sourceLength) renderBufferedOutput(false);
						return true;
								});
							}
							finishScheduledRender(true);
							};
							if (force) {
								if (renderDelayTimer !== null) {
									clearTimeout(renderDelayTimer);
									renderDelayTimer = null;
								}
								renderScheduled = false;
								return runRender();
							}
							renderScheduled = true;
							if (textBuffer.length >= largeStreamRenderThreshold && lastRenderFinishedAt > 0) {
								var delay = Math.max(0, largeStreamRenderInterval - (Date.now() - lastRenderFinishedAt));
								renderDelayTimer = setTimeout(function() {
									renderDelayTimer = null;
									requestAnimationFrame(runRender);
								}, delay);
							} else {
								requestAnimationFrame(runRender);
							}
					}
						function flushBufferedOutput() {
							if (renderScheduled || lastRenderedSourceLength !== textBuffer.length) {
								return renderBufferedOutput(true, false);
							}
						}
						function finalizeEmptyTerminalBubble(status) {
							if (textBuffer !== '') return;
							if (thinkingIndicator) thinkingIndicator.classList.add('hidden');
						container.classList.remove('hidden');
							if (status === 'cancelled') {
								container.classList.add('text-error/80', 'font-medium');
								container.textContent = 'Error: Cancelled';
								if (window.setChatRawContent) window.setChatRawContent(container, 'Error: Cancelled');
								else container.setAttribute('data-raw-content', 'Error: Cancelled');
							}
						}

						var streamRetryCount = 0;
						var streamRetryScheduled = false;
						var streamTerminalHandled = false;
						var eventSource = null;
				function scheduleExecutionStreamRetry() {
					if (streamRetryScheduled) return true;
					if (streamRetryCount >= 5) return false;
					streamRetryScheduled = true;
					streamRetryCount++;
							setTimeout(function() {
								streamRetryScheduled = false;
						connectExecutionStream();
					}, 150 * streamRetryCount);
					return true;
						}
						function connectExecutionStream() {
							var streamOffset = utf8ByteLength(textBuffer);
							eventSource = new EventSource('/events/chat/' + execId + '?offset=' + encodeURIComponent(streamOffset));
						if (!isThread && window.registerChatStreamEventSource) {
							window.registerChatStreamEventSource(execId, eventSource);
						}
					function removeThreadEventSource(es) {
						if (!window._threadEventSources || !es) return;
						var idx = window._threadEventSources.indexOf(es);
						if (idx >= 0) window._threadEventSources.splice(idx, 1);
					}
					function removeChatEventSource(execId, es) {
						if (!window.unregisterChatStreamEventSource) return;
						window.unregisterChatStreamEventSource(execId, es);
					}
					// Track thread stream EventSource so navigation cleanup can close it.
					if (isThread) {
						if (!window._threadEventSources) window._threadEventSources = [];
						window._threadEventSources.push(eventSource);
					}

						eventSource.onmessage = function(event) {
							// Hide thinking/progress indicators and show content on first aggregator token
							if (window.hideMixtureProgress) window.hideMixtureProgress(execId);
							if (thinkingIndicator && !thinkingIndicator.classList.contains('hidden')) {
								thinkingIndicator.classList.add('hidden');
							container.classList.remove('hidden');
								streamingDots.classList.remove('hidden');
							}

							// Append to buffer and re-render
						textBuffer += event.data;
						renderBufferedOutput(false);
					};

							eventSource.addEventListener('done', function(event) {
								if (streamTerminalHandled) return;
								streamTerminalHandled = true;
								if (Object.prototype.hasOwnProperty.call(container, '_authoritativeTerminalContent')) {
									textBuffer = String(container._authoritativeTerminalContent || '');
								}
								var terminalStatus = event && event.data ? event.data : 'completed';
								if (window.hideMixtureProgress) window.hideMixtureProgress(execId);
							function finishTerminalRender() {
								finalizeEmptyTerminalBubble(terminalStatus);
									var completedPair = container.closest('[data-execution-pair="true"]');
									if (window.applyChatExecutionTerminalStatus) window.applyChatExecutionTerminalStatus(completedPair, terminalStatus);
									else if (completedPair) {
										completedPair.setAttribute('data-exec-status', terminalStatus);
										completedPair.setAttribute('hx-preserve', 'true');
									}
									// Hide streaming dots
							if (streamingDots) streamingDots.classList.add('hidden');
							eventSource.close();
						removeThreadEventSource(eventSource);
						removeChatEventSource(execId, eventSource);
						window._taskThreadStreamingActive = false;
							if (isThread) {
								showThreadTerminalStatus(terminalStatus);
									if (window.syncTaskThreadTranscriptRevision) window.syncTaskThreadTranscriptRevision(execId);
								} else {
									window._chatStreamInProgress = false;
									if (window.refreshChatComposerAction) window.refreshChatComposerAction();
									if (window.syncChatTranscriptRevision) window.syncChatTranscriptRevision(execId);
									// Always evaluate plan-completion first so prompt visibility updates
									// even if post-render transforms throw.
							if (window.handlePlanModeCompletion) {
								window.handlePlanModeCompletion(textBuffer);
							}
							// Convert task-result metadata before cleaning transcript controls
							var bubble = container.closest('.chat-bubble-assistant-msg');
							try {
								if (bubble && window.convertTaskLinksInMessage) {
									window.convertTaskLinksInMessage(bubble);
								}
								if (bubble && window.convertTaskEditLinksInMessage) {
									window.convertTaskEditLinksInMessage(bubble);
								}
								if (bubble && window.cleanBubbleContent) {
									window.cleanBubbleContent(bubble);
								}
							} catch (err) {
								console.error('[chat] post-stream transform failed:', err);
							}
							// Final scroll if tracker allows it
							if (!tracker || tracker.shouldAutoScroll()) {
								requestAnimationFrame(function() {
									var chatMessages = document.getElementById(messagesId);
									if (chatMessages) {
										window.chatAutoScroll.scrollToBottom(chatMessages, true);
									}
								});
							}
								}
								}
									var finalRender = renderBufferedOutput(true, true);
								if (finalRender && typeof finalRender.then === 'function') finalRender.then(finishTerminalRender);
								else finishTerminalRender();
					});

						eventSource.addEventListener('error', function(event) {
					var retryableEarlyError = textBuffer === '' && event.data === 'execution not found';
							if (!retryableEarlyError && window.hideMixtureProgress) window.hideMixtureProgress(execId);
						eventSource.close();
						removeThreadEventSource(eventSource);
						removeChatEventSource(execId, eventSource);
						if (retryableEarlyError && scheduleExecutionStreamRetry()) {
							return;
							}
							if (streamTerminalHandled) return;
							streamTerminalHandled = true;
							if (Object.prototype.hasOwnProperty.call(container, '_authoritativeTerminalContent')) {
								textBuffer = String(container._authoritativeTerminalContent || '');
							}
							flushBufferedOutput();
							// Hide thinking indicator and streaming dots, ensure content shows
						if (thinkingIndicator) thinkingIndicator.classList.add('hidden');
						if (streamingDots) streamingDots.classList.add('hidden');
					container.classList.remove('hidden');
						if (event.data) {
							container.appendChild(document.createTextNode('\n\nError: ' + event.data));
						}
							window._taskThreadStreamingActive = false;
							var failedPair = container.closest('[data-execution-pair="true"]');
							if (window.applyChatExecutionTerminalStatus) window.applyChatExecutionTerminalStatus(failedPair, 'failed');
							else if (failedPair) {
								failedPair.setAttribute('data-exec-status', 'failed');
								failedPair.setAttribute('hx-preserve', 'true');
							}
							if (isThread) {
								showThreadTerminalStatus('failed');
								if (window.syncTaskThreadTranscriptRevision) window.syncTaskThreadTranscriptRevision(execId);
							} else {
								// Clear streaming flag and re-evaluate plan prompt on error.
								// The evaluator scans DOM for latest completed bubble; an error
								// bubble without <proposed_plan> correctly hides the prompt.
									window._chatStreamInProgress = false;
									if (window.refreshChatComposerAction) window.refreshChatComposerAction();
									if (window.evaluatePlanCompletionPrompt) window.evaluatePlanCompletionPrompt();
									if (window.syncChatTranscriptRevision) window.syncChatTranscriptRevision(execId);
							}
						});

						eventSource.onerror = function(error) {
							console.error('EventSource failed:', error);
							eventSource.close();
							removeThreadEventSource(eventSource);
							removeChatEventSource(execId, eventSource);
				if (textBuffer === '' && scheduleExecutionStreamRetry()) {
					return;
						}
						if (streamTerminalHandled) return;
						streamTerminalHandled = true;
						flushBufferedOutput();
						if (window.hideMixtureProgress) window.hideMixtureProgress(execId);
							// Hide thinking indicator and streaming dots, ensure content shows
						if (thinkingIndicator) thinkingIndicator.classList.add('hidden');
						if (streamingDots) streamingDots.classList.add('hidden');
					container.classList.remove('hidden');
						window._taskThreadStreamingActive = false;
						if (isThread) {
							restoreThreadPollingFallback();
						} else {
							window._chatStreamInProgress = false;
							if (window.evaluatePlanCompletionPrompt) window.evaluatePlanCompletionPrompt();
						}
					};
					}
					connectExecutionStream();
				})();
			</script>
		</div>
	</div>
}

// ChatBubbleStreamingResume renders a chat message that reconnects to an in-progress SSE stream.
// The EventSource is initialized by _initThreadStreaming() after initial hydration or an
// authoritative Chat/Task Thread morph, since inline scripts do not re-execute after morph swaps.
// Content is stored in data-raw-content (not as text content) so it renders formatted
// immediately via the inline script, matching ChatBubble's pattern. This prevents
// raw/unformatted text flash on hard refresh.
templ ChatBubbleStreamingResume(role, partialContent, execID, messagesContainerID, pausePollingTargetID string) {
	<div class={ chatBubbleClass(role), "rounded-xl p-4" }>
		<div class="text-xs font-semibold opacity-50 mb-2">
			{ role }
		</div>
		<div class="chat-bubble-inner">
			if partialContent == "" {
				<div id={ "streaming-thinking-resume-" + execID } class="flex flex-col items-start gap-1">
					<span class="block h-5" aria-hidden="true"></span>
					@ChatLoadingDots("sm")
				</div>
			}
			<div id={ "mixture-progress-" + execID } class="mixture-progress hidden mb-2 text-xs opacity-70" data-exec-id={ execID } role="status" aria-live="polite"></div>
			<div id={ "streaming-message-" + execID } class={ "leading-relaxed text-sm", templ.KV("hidden", partialContent == "") } data-exec-id={ execID } data-initial-byte-length={ fmt.Sprintf("%d", len(partialContent)) } data-messages-container={ messagesContainerID } data-pause-polling-target={ pausePollingTargetID } data-streaming-resume="true" data-raw-revision={ chatContentRevision(partialContent) } data-raw-content={ NormalizeDisplayMarkers(partialContent) } style="word-wrap: break-word;"></div>
			<script>
				(function() {
					var el = document.currentScript.previousElementSibling;
					var renderStarted = false;
					function render() {
						if (renderStarted) return;
						renderStarted = true;
						var raw = el.getAttribute('data-raw-content');
						if (!raw) return;
						if (window.renderStreamingContent) {
							var liveRenderer = window.renderLiveChatContent || window.renderStreamingContent;
							var renderPromise = liveRenderer(el, raw);
							if (renderPromise && typeof renderPromise.catch === 'function') {
								renderPromise.catch(function() { el.textContent = raw; });
							}
						} else if (window.renderChatMarkdown) {
							el.className = el.className.replace('whitespace-pre-wrap', '').trim();
							var div = document.createElement('div');
							div.className = 'chat-markdown';
							div.innerHTML = window.renderChatMarkdown(raw);
							if (window.addCodeCopyButtons) window.addCodeCopyButtons(div);
							el.innerHTML = '';
							el.appendChild(div);
						} else {
							el.textContent = raw;
							el.classList.add('whitespace-pre-wrap');
						}
					}
					if (window.renderStreamingContent) { render(); }
					else {
						var poll = setInterval(function() {
							if (window.renderStreamingContent) { clearInterval(poll); render(); }
						}, 10);
						setTimeout(function() { clearInterval(poll); render(); }, 2000);
					}
				})();
			</script>
			<div id={ "streaming-dots-resume-" + execID } class={ "flex items-center gap-1 mt-2 opacity-40", templ.KV("hidden", partialContent == "") }>
				@ChatLoadingDots("xs")
			</div>
		</div>
	</div>
}

// ChatStreamingResumeInitScript installs the shared resume-stream initializer.
// It finds [data-streaming-resume] containers without an active EventSource
// and connects them to the SSE endpoint. Called on initial page load and
// after each authoritative transcript morph.
templ ChatStreamingResumeInitScript() {
	<script type="text/javascript">
		window._initThreadStreaming = function() {
			var containers = document.querySelectorAll('[data-streaming-resume="true"]');
			containers.forEach(function(container) {
				// Skip if already connected
				if (container._sseConnected) return;
				container._sseConnected = true;

					var execId = container.getAttribute('data-exec-id');
					var messagesId = container.getAttribute('data-messages-container');
					var pauseTarget = container.getAttribute('data-pause-polling-target');
					var cumulativeContent = container.getAttribute('data-raw-content') || '';
					var streamOffset = parseInt(container.getAttribute('data-initial-byte-length') || '0', 10) || 0;
					var streamTextEncoder = window.TextEncoder ? new TextEncoder() : null;
					function utf8ByteLength(value) { return streamTextEncoder ? streamTextEncoder.encode(value || '').length : unescape(encodeURIComponent(value || '')).length; }
					function persistResumeStreamState(active) {
						container.setAttribute('data-raw-content', cumulativeContent);
						container.setAttribute('data-initial-byte-length', String(streamOffset));
						if (active) container.setAttribute('data-streaming-resume', 'true');
						else {
							container.removeAttribute('data-streaming-resume');
							delete container._sseConnected;
						}
					}

				// Find streaming dots by ID (reliable across morph swaps and inline script siblings)
				var streamingDots = document.getElementById('streaming-dots-resume-' + execId);
				// Content is in data-raw-content attribute (not textContent)
				var hasContent = !!container.getAttribute('data-raw-content');
				var thinkingIndicator = !hasContent ? document.getElementById('streaming-thinking-resume-' + execId) : null;

				// Pause HTMX polling if requested
				if (pauseTarget) {
					window._taskThreadStreamingActive = true;
					var pollingEl = document.getElementById(pauseTarget);
						if (pollingEl) {
							if (!pollingEl.hasAttribute('data-paused-hx-trigger')) {
								pollingEl.setAttribute('data-paused-hx-trigger', pollingEl.getAttribute('hx-trigger') || '');
							}
							if (!pollingEl.hasAttribute('data-paused-hx-get')) {
								pollingEl.setAttribute('data-paused-hx-get', pollingEl.getAttribute('hx-get') || '');
							}
							pollingEl.removeAttribute('hx-trigger');
							pollingEl.removeAttribute('hx-get');
							if (typeof htmx !== 'undefined') htmx.process(pollingEl);
						}
					}

					function stopThreadPolling() {
						if (!pauseTarget) return;
						var pollingEl = document.getElementById(pauseTarget);
						if (!pollingEl) return;
						pollingEl.setAttribute('data-task-active', 'false');
						pollingEl.removeAttribute('hx-trigger');
						pollingEl.removeAttribute('hx-get');
						if (typeof htmx !== 'undefined') htmx.process(pollingEl);
					}

					function restoreThreadPollingFallback() {
						if (!pauseTarget) return;
						var pollingEl = document.getElementById(pauseTarget);
						if (!pollingEl || pollingEl.getAttribute('data-task-active') === 'false') return;
						var pausedTrigger = pollingEl.getAttribute('data-paused-hx-trigger');
						var pausedGet = pollingEl.getAttribute('data-paused-hx-get');
						if (pausedTrigger) pollingEl.setAttribute('hx-trigger', pausedTrigger);
						if (pausedGet) pollingEl.setAttribute('hx-get', pausedGet);
						if (typeof htmx !== 'undefined') htmx.process(pollingEl);
					}

						function refreshThreadComposerAction() {
							if (typeof htmx === 'undefined' || !document.getElementById('task-thread-form-primary-action')) return;
							var view = document.getElementById('task-thread-view');
							var taskId = view ? (view.getAttribute('data-task-id') || '') : '';
							if (!taskId) return;
							htmx.ajax('GET', '/tasks/' + encodeURIComponent(taskId) + '/thread/composer-action', {target: '#task-thread-form-primary-action', swap: 'outerHTML'});
						}

						function showThreadTerminalStatus(status) {
							stopThreadPolling();
							var form = document.getElementById('task-thread-form');
							if (form) {
								var textarea = document.getElementById('task-message-input');
								if (textarea && window.refreshChatComposerShortcutHint) window.refreshChatComposerShortcutHint(textarea);
								refreshThreadComposerAction();
							}
							var messages = document.getElementById(messagesId);
						if (!messages || document.getElementById('task-thread-terminal-status')) return;
					var wrap = document.createElement('div');
					wrap.id = 'task-thread-terminal-status';
					wrap.className = 'flex items-center justify-center gap-2 py-2';
						var inner = document.createElement('div');
								var statusClass = status === 'failed' ? 'text-error' : (status === 'cancelled' ? 'text-warning' : 'text-success');
								inner.className = 'flex items-center gap-2 text-sm opacity-70 ' + statusClass;
								var icon = document.createElement('span');
								icon.setAttribute('aria-hidden', 'true');
								icon.textContent = status === 'failed' ? '✕' : (status === 'cancelled' ? '■' : '✓');
								var text = document.createElement('span');
								text.textContent = 'Task ' + (status === 'failed' ? 'failed' : (status === 'cancelled' ? 'cancelled' : 'completed'));
						inner.appendChild(icon);
						inner.appendChild(text);
					wrap.appendChild(inner);
						messages.appendChild(wrap);
					}

					// Get or reuse page-level tracker. Use resolveScrollTracker so a
					// morph swap of #task-thread-messages mid-stream rebinds the tracker
					// instead of leaving it pointing at a detached element (which would
					// make isNearBottom always true and pull the user back down forever).
				var chatMessages = document.getElementById(messagesId);
				var tracker = null;
				var trackerKey = 'scrollTracker_' + messagesId;
				if (chatMessages) {
					if (window.resolveScrollTracker) {
						tracker = window.resolveScrollTracker(trackerKey, chatMessages);
					} else if (window.ChatScrollTracker) {
						if (!window[trackerKey]) {
							window[trackerKey] = new window.ChatScrollTracker(chatMessages);
						}
						tracker = window[trackerKey];
					}
				}

					var eventSource = null;
						var streamRetryCount = 0;
						var streamRetryScheduled = false;
					var renderScheduled = false;
					var renderDelayTimer = null;
					var lastRenderFinishedAt = Date.now();
					var lastRenderedSourceLength = cumulativeContent.length;
					var largeStreamRenderThreshold = 100 * 1024;
					var largeStreamRenderInterval = 250;
					function renderCumulativeContent(force, yieldLarge) {
					if (!window.renderStreamingContent) {
					container.classList.remove('text-error/80', 'font-medium');
						container.textContent = window.normalizeTranscriptMarkers ? window.normalizeTranscriptMarkers(cumulativeContent) : cumulativeContent;
						return;
					}
					if (!force && renderScheduled) return;
						var runRender = function() {
							var sourceLength = cumulativeContent.length;
							var renderText = cumulativeContent;
							if (Object.prototype.hasOwnProperty.call(container, '_authoritativeTerminalContent')) {
								renderText = String(container._authoritativeTerminalContent || '');
								cumulativeContent = renderText;
								sourceLength = renderText.length;
							}
							if (!force && sourceLength === lastRenderedSourceLength) return;
						// Refresh tracker against the live messages element in case a
						// morph swap replaced the container while streaming.
						var liveMessages = document.getElementById(messagesId);
						if (liveMessages && window.resolveScrollTracker) {
							tracker = window.resolveScrollTracker(trackerKey, liveMessages);
						}
						var shouldScroll = !tracker || tracker.shouldAutoScroll();
					container.classList.remove('text-error/80', 'font-medium');
						function finishScheduledRender(committed) {
							if (committed === false) {
								renderScheduled = false;
								if (cumulativeContent.length !== sourceLength) renderCumulativeContent(false);
								return;
							}
							renderScheduled = false;
							if (Object.prototype.hasOwnProperty.call(container, '_authoritativeTerminalContent') && String(container._authoritativeTerminalContent || '') !== renderText) {
								cumulativeContent = String(container._authoritativeTerminalContent || '');
								renderCumulativeContent(true, false);
								return;
							}
							lastRenderedSourceLength = sourceLength;
							lastRenderFinishedAt = Date.now();
							if (shouldScroll) {
							requestAnimationFrame(function() {
								var cm = document.getElementById(messagesId);
								if (cm && window.chatAutoScroll) window.chatAutoScroll.scrollToBottom(cm, false);
							});
							}
							if (cumulativeContent.length !== sourceLength) renderCumulativeContent(false);
						}
						var shouldYield = renderText.length >= largeStreamRenderThreshold && yieldLarge !== false;
						var liveRenderer = window.renderLiveChatContent || window.renderStreamingContent;
						var renderPromise = liveRenderer(container, renderText, shouldYield);
						if (renderPromise && typeof renderPromise.then === 'function') {
				return renderPromise.then(finishScheduledRender).catch(function(err) {
					renderScheduled = false;
					console.error('[thread] streaming render failed:', err);
						container.textContent = renderText;
						if (window.setChatRawContent) window.setChatRawContent(container, renderText);
						else container.setAttribute('data-raw-content', renderText);
					lastRenderedSourceLength = sourceLength;
					lastRenderFinishedAt = Date.now();
					if (cumulativeContent.length !== sourceLength) renderCumulativeContent(false);
					return true;
							});
						}
						finishScheduledRender(true);
					};
					if (force) {
						if (renderDelayTimer !== null) {
							clearTimeout(renderDelayTimer);
							renderDelayTimer = null;
						}
						renderScheduled = false;
						return runRender();
					}
					renderScheduled = true;
					if (cumulativeContent.length >= largeStreamRenderThreshold && lastRenderFinishedAt > 0) {
						var delay = Math.max(0, largeStreamRenderInterval - (Date.now() - lastRenderFinishedAt));
						renderDelayTimer = setTimeout(function() {
							renderDelayTimer = null;
							requestAnimationFrame(runRender);
						}, delay);
					} else {
						requestAnimationFrame(runRender);
					}
				}
					function flushCumulativeContent() {
						if (renderScheduled || lastRenderedSourceLength !== cumulativeContent.length) {
							return renderCumulativeContent(true, false);
						}
					}
					function finalizeEmptyTerminalBubble(status) {
						if (cumulativeContent !== '') return;
						if (thinkingIndicator) thinkingIndicator.classList.add('hidden');
					container.classList.remove('hidden');
						if (status === 'cancelled') {
							container.classList.add('text-error/80', 'font-medium');
							container.textContent = 'Error: Cancelled';
							if (window.setChatRawContent) window.setChatRawContent(container, 'Error: Cancelled');
							else container.setAttribute('data-raw-content', 'Error: Cancelled');
						}
					}
					function removeThreadEventSource(es) {
						if (!window._threadEventSources || !es) return;
						var idx = window._threadEventSources.indexOf(es);
						if (idx >= 0) window._threadEventSources.splice(idx, 1);
					}
					function registerResumeEventSource(es) {
						if (!es) return;
						if (pauseTarget) {
							if (!window._threadEventSources) window._threadEventSources = [];
							window._threadEventSources.push(es);
						} else {
							window._chatStreamInProgress = true;
							if (window.registerChatStreamEventSource) window.registerChatStreamEventSource(execId, es);
						}
					}
					function removeResumeEventSource(es) {
						if (pauseTarget) removeThreadEventSource(es);
						else if (window.unregisterChatStreamEventSource) window.unregisterChatStreamEventSource(execId, es);
					}
					function scheduleResumeExecutionStreamRetry() {
						if (streamRetryScheduled) return true;
						if (streamRetryCount >= 5) return false;
						streamRetryScheduled = true;
						streamRetryCount++;
						setTimeout(function() {
							streamRetryScheduled = false;
							connectResumeExecutionStream();
						}, 150 * streamRetryCount);
						return true;
					}

					var streamTerminalHandled = false;
					function connectResumeExecutionStream() {
							eventSource = new EventSource('/events/chat/' + execId + '?offset=' + encodeURIComponent(streamOffset));
							registerResumeEventSource(eventSource);

							eventSource.onmessage = function(event) {
								cumulativeContent += event.data;
								streamOffset += utf8ByteLength(event.data);
								persistResumeStreamState(true);
							if (window.hideMixtureProgress) window.hideMixtureProgress(execId);
							if (thinkingIndicator && !thinkingIndicator.classList.contains('hidden')) {
								thinkingIndicator.classList.add('hidden');
							container.classList.remove('hidden');
								if (streamingDots) streamingDots.classList.remove('hidden');
							}
							renderCumulativeContent(false);
					};

							eventSource.addEventListener('done', function(event) {
								if (streamTerminalHandled) return;
								streamTerminalHandled = true;
								if (Object.prototype.hasOwnProperty.call(container, '_authoritativeTerminalContent')) {
									cumulativeContent = String(container._authoritativeTerminalContent || '');
								}
								persistResumeStreamState(false);
								var terminalStatus = event && event.data ? event.data : 'completed';
							if (window.hideMixtureProgress) window.hideMixtureProgress(execId);
							function finishTerminalRender() {
								finalizeEmptyTerminalBubble(terminalStatus);
									var completedPair = container.closest('[data-execution-pair="true"]');
									if (window.applyChatExecutionTerminalStatus) window.applyChatExecutionTerminalStatus(completedPair, terminalStatus);
									else if (completedPair) {
										completedPair.setAttribute('data-exec-status', terminalStatus);
										completedPair.setAttribute('hx-preserve', 'true');
									}
									if (streamingDots) streamingDots.classList.add('hidden');
									eventSource.close();
									removeResumeEventSource(eventSource);
									window._taskThreadStreamingActive = false;
									if (pauseTarget) {
							showThreadTerminalStatus(terminalStatus);
									if (window.syncTaskThreadTranscriptRevision) window.syncTaskThreadTranscriptRevision(execId);
					} else {
						var bubble = container.closest('.chat-bubble-assistant-msg');
						if (bubble && window.convertTaskLinksInMessage) window.convertTaskLinksInMessage(bubble);
						if (bubble && window.convertTaskEditLinksInMessage) window.convertTaskEditLinksInMessage(bubble);
						if (bubble && window.cleanBubbleContent) window.cleanBubbleContent(bubble);
						if (window.handlePlanModeCompletion) window.handlePlanModeCompletion(cumulativeContent);
						window._chatStreamInProgress = false;
						if (window.refreshChatComposerAction) window.refreshChatComposerAction();
						if (window.syncChatTranscriptRevision) window.syncChatTranscriptRevision(execId);
						if (!tracker || tracker.shouldAutoScroll()) {
							requestAnimationFrame(function() {
								var cm = document.getElementById(messagesId);
								if (cm && window.chatAutoScroll) window.chatAutoScroll.scrollToBottom(cm, true);
							});
						}
							}
							}
								var finalRender = renderCumulativeContent(true, true);
							if (finalRender && typeof finalRender.then === 'function') finalRender.then(finishTerminalRender);
							else finishTerminalRender();
				});

					eventSource.addEventListener('error', function(event) {
					var retryableEarlyError = cumulativeContent === '' && event.data === 'execution not found';
						if (!retryableEarlyError && window.hideMixtureProgress) window.hideMixtureProgress(execId);
							eventSource.close();
							removeResumeEventSource(eventSource);
							if (retryableEarlyError && scheduleResumeExecutionStreamRetry()) {
								return;
							}
							if (streamTerminalHandled) return;
						streamTerminalHandled = true;
							if (Object.prototype.hasOwnProperty.call(container, '_authoritativeTerminalContent')) {
								cumulativeContent = String(container._authoritativeTerminalContent || '');
							}
							persistResumeStreamState(false);
							flushCumulativeContent();
						if (thinkingIndicator) thinkingIndicator.classList.add('hidden');
					if (streamingDots) streamingDots.classList.add('hidden');
				container.classList.remove('hidden');
					if (event.data) container.appendChild(document.createTextNode('\n\nError: ' + event.data));
					window._taskThreadStreamingActive = false;
					var failedPair = container.closest('[data-execution-pair="true"]');
					if (window.applyChatExecutionTerminalStatus) window.applyChatExecutionTerminalStatus(failedPair, 'failed');
					else if (failedPair) {
						failedPair.setAttribute('data-exec-status', 'failed');
						failedPair.setAttribute('hx-preserve', 'true');
					}
					if (pauseTarget) {
						showThreadTerminalStatus('failed');
						if (window.syncTaskThreadTranscriptRevision) window.syncTaskThreadTranscriptRevision(execId);
					} else {
						window._chatStreamInProgress = false;
						if (window.refreshChatComposerAction) window.refreshChatComposerAction();
						if (window.evaluatePlanCompletionPrompt) window.evaluatePlanCompletionPrompt();
						if (window.syncChatTranscriptRevision) window.syncChatTranscriptRevision(execId);
					}
				});

					eventSource.onerror = function(error) {
						console.error('EventSource failed:', error);
							eventSource.close();
							removeResumeEventSource(eventSource);
							if (cumulativeContent === '' && scheduleResumeExecutionStreamRetry()) {
								return;
							}
					if (streamTerminalHandled) return;
					streamTerminalHandled = true;
					flushCumulativeContent();
					if (window.hideMixtureProgress) window.hideMixtureProgress(execId);
						if (thinkingIndicator) thinkingIndicator.classList.add('hidden');
					if (streamingDots) streamingDots.classList.add('hidden');
				container.classList.remove('hidden');
					window._taskThreadStreamingActive = false;
					if (pauseTarget) {
						restoreThreadPollingFallback();
					}
				};
				}
				connectResumeExecutionStream();
			});
		};
	</script>
}

templ ChatQueuedInputRow(inputID, message, steerEndpoint string, hasAttachments bool) {
	@ChatQueuedInputRowForTask(inputID, message, steerEndpoint, hasAttachments, "")
}

templ pendingAttachmentBadge(label, title string) {
	<div class="badge badge-ghost badge-sm shrink-0 gap-1 text-xs" title={ title } aria-label={ title }>
		<svg xmlns="http://www.w3.org/2000/svg" class="h-3 w-3" fill="none" viewBox="0 0 24 24" stroke="currentColor">
			<path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M15.172 7l-6.586 6.586a2 2 0 102.828 2.828l6.586-6.586a4 4 0 00-5.657-5.657L5.757 10.757a6 6 0 108.486 8.486L21 12.486"></path>
		</svg>
		<span>{ label }</span>
	</div>
}

templ ChatQueuedInputRowForTask(inputID, message, steerEndpoint string, hasAttachments bool, taskID string) {
	<div id={ "thread-input-" + inputID } class="queued-input-row flex min-h-8 items-center gap-3 rounded-lg bg-base-300/45 px-3 py-1.5 text-sm text-base-content/80" data-thread-input-id={ inputID } data-task-id={ taskID } data-input-mode="queued" title="Queued follow-up will run after the active response finishes">
		<div class="min-w-0 flex-1 truncate">{ message }</div>
		if hasAttachments {
			@pendingAttachmentBadge("Attachments queued", "Attachments queued with this follow-up")
		}
		<div class="ml-auto flex shrink-0 items-center gap-2">
			<button type="button" class="btn btn-ghost btn-xs h-6 min-h-0 rounded-md px-2 text-xs font-medium" hx-post={ steerEndpoint } hx-target={ "#thread-input-" + inputID } hx-swap="outerHTML" title="Convert queued follow-up to steering">Steer</button>
			<button type="button" class="btn btn-ghost btn-xs h-6 min-h-0 rounded-md px-2 text-xs text-error" hx-post={ "/thread-inputs/" + inputID + "/cancel" } hx-target={ "#thread-input-" + inputID } hx-swap="outerHTML" title="Cancel queued follow-up" aria-label="Cancel queued follow-up">
				<svg xmlns="http://www.w3.org/2000/svg" class="h-4 w-4" fill="none" viewBox="0 0 24 24" stroke="currentColor">
					<path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M19 7l-.867 12.142A2 2 0 0116.138 21H7.862a2 2 0 01-1.995-1.858L5 7m5 4v6m4-6v6m1-10V4a1 1 0 00-1-1h-4a1 1 0 00-1 1v3M4 7h16"></path>
				</svg>
			</button>
		</div>
	</div>
}

templ ChatQueuedInputRowOOB(inputID, message, steerEndpoint string, hasAttachments bool) {
	@ChatQueuedInputRowOOBForTask(inputID, message, steerEndpoint, hasAttachments, "")
}

templ ChatQueuedInputRowOOBForTask(inputID, message, steerEndpoint string, hasAttachments bool, taskID string) {
	<div id="pending-thread-inputs" data-task-id={ taskID } hx-swap-oob={ pendingInputsOOBTarget(taskID) }>
		@ChatQueuedInputRowForTask(inputID, message, steerEndpoint, hasAttachments, taskID)
	</div>
}

templ ChatSteeringInputRow(inputID, message string, hasAttachments bool) {
	@ChatSteeringInputRowForTask(inputID, message, hasAttachments, "")
}

templ ChatSteeringInputRowForTask(inputID, message string, hasAttachments bool, taskID string) {
	<div id={ "thread-input-" + inputID } class="steering-input-row flex min-h-8 items-center gap-3 rounded-lg bg-base-300/45 px-3 py-1.5 text-sm text-base-content/80" data-thread-input-id={ inputID } data-task-id={ taskID } data-input-mode="steering" title="Steering instruction will be applied before the active run's next model step">
		<div class="min-w-0 flex-1">
			<div class="text-xs font-semibold opacity-70">Steering pending</div>
			<div class="truncate">{ message }</div>
			<div class="text-xs opacity-60">Will be applied before the active run's next model step.</div>
		</div>
		if hasAttachments {
			@pendingAttachmentBadge("Attachments included", "Attachments included with this steering instruction")
		}
		<div class="ml-auto flex shrink-0 items-center gap-2">
			<button type="button" class="btn btn-ghost btn-xs h-6 min-h-0 rounded-md px-2 text-xs text-error" hx-post={ "/thread-inputs/" + inputID + "/cancel" } hx-target={ "#thread-input-" + inputID } hx-swap="outerHTML" title="Cancel pending steering" aria-label="Cancel pending steering">
				<svg xmlns="http://www.w3.org/2000/svg" class="h-4 w-4" fill="none" viewBox="0 0 24 24" stroke="currentColor">
					<path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M19 7l-.867 12.142A2 2 0 0116.138 21H7.862a2 2 0 01-1.995-1.858L5 7m5 4v6m4-6v6m1-10V4a1 1 0 00-1-1h-4a1 1 0 00-1 1v3M4 7h16"></path>
				</svg>
			</button>
		</div>
	</div>
}

templ ChatComposerQueuedInputRows(inputs []models.ThreadInput, steerEndpointFor func(models.ThreadInput) string) {
	@ChatComposerQueuedInputRowsForTask(inputs, steerEndpointFor, "")
}

templ ChatComposerQueuedInputRowsForTask(inputs []models.ThreadInput, steerEndpointFor func(models.ThreadInput) string, taskID string) {
	<div id="pending-thread-inputs" class="space-y-1.5" data-task-id={ taskID }>
		for _, input := range inputs {
			if input.InputMode == models.ThreadInputModeQueued && steerEndpointFor != nil {
				@ChatQueuedInputRowForTask(input.ID, input.Content, steerEndpointFor(input), input.AttachmentSessionID != "", taskID)
			} else if input.InputMode == models.ThreadInputModeSteering {
				@ChatSteeringInputRowForTask(input.ID, input.Content, input.AttachmentSessionID != "", taskID)
			}
		}
	</div>
}

templ PendingThreadInputRows(inputs []models.ThreadInput, steerEndpointFor func(models.ThreadInput) string) {
}

templ ChatInputCancelledRow(inputID string) {
	<div id={ "thread-input-" + inputID } class="hidden" data-thread-input-id={ inputID }></div>
}

templ ChatEarlierMessagesLoader(containerID, url string, limit int) {
	<div
		id={ containerID + "-earlier-loader" }
		class="py-2 text-center text-xs opacity-60"
		data-earlier-loader="true"
		data-container-id={ containerID }
		data-window-limit={ fmt.Sprintf("%d", limit) }
		hx-get={ url }
		hx-trigger="ov:load-earlier"
		hx-target={ "#" + containerID + "-earlier-loader" }
		hx-swap="outerHTML show:none"
		hx-on::before-request="window.prepareChatEarlierSwap && window.prepareChatEarlierSwap(this)"
		hx-on::after-swap="window.afterChatEarlierSwap && window.afterChatEarlierSwap(this)"
		hx-on::after-request="if (event.detail && !event.detail.successful && window.finishChatEarlierRequest) window.finishChatEarlierRequest(this)"
	>
		<span data-earlier-loader-idle>Scroll up to load earlier messages</span>
		<span data-earlier-loader-busy class="hidden"><span class="loading loading-spinner loading-xs align-middle mr-2"></span>Loading earlier messages...</span>
	</div>
}

func chatExecutionIsTerminal(exec models.Execution) bool {
	return exec.Status == models.ExecCompleted || exec.Status == models.ExecFailed || exec.Status == models.ExecCancelled
}

templ chatExecutionPairContent(exec models.Execution, task *models.Task, executions []models.Execution, index int, hasEarlier bool, attachments map[string][]models.ChatAttachment, messagesContainerID, pausePollingTargetID, projectID string) {
	<!-- User message: show for followups and first non-followup only -->
	if exec.IsFollowup || (!hasEarlier && !hasEarlierNonFollowup(executions, index)) {
		if atts, hasAtts := attachments[exec.ID]; hasAtts && len(atts) > 0 {
			@ChatBubbleWithAttachments("User", chatUserContent(exec, task, executions, index), atts, projectID)
		} else {
			@ChatBubble("User", chatUserContent(exec, task, executions, index))
		}
	}
	<!-- Assistant response -->
	if exec.Status == models.ExecCompleted {
		@ChatBubble("Assistant", exec.Output)
	} else if exec.Status == models.ExecFailed {
		@ChatBubbleError("Assistant", exec.ErrorMessage, exec.Output)
	} else if exec.Status == models.ExecCancelled {
		@ChatBubbleError("Assistant", "Cancelled", exec.Output)
	} else if exec.Status == models.ExecRunning {
		@ChatBubbleStreamingResume("Assistant", exec.Output, exec.ID, messagesContainerID, pausePollingTargetID)
	}
}

templ ChatExecutionPair(exec models.Execution, task *models.Task, executions []models.Execution, index int, hasEarlier bool, attachments map[string][]models.ChatAttachment, messagesContainerID, pausePollingTargetID, projectID string) {
	if chatExecutionIsTerminal(exec) {
		<div id={ "chat-execution-" + exec.ID } class="chat-execution-pair space-y-6" data-execution-pair="true" data-exec-id={ exec.ID } data-exec-status={ string(exec.Status) } data-execution-revision={ ChatExecutionRevision(exec) } data-started-at={ exec.StartedAt.Format(time.RFC3339Nano) } hx-preserve="true">
			@chatExecutionPairContent(exec, task, executions, index, hasEarlier, attachments, messagesContainerID, pausePollingTargetID, projectID)
		</div>
	} else {
		<div id={ "chat-execution-" + exec.ID } class="chat-execution-pair space-y-6" data-execution-pair="true" data-exec-id={ exec.ID } data-exec-status={ string(exec.Status) } data-execution-revision={ ChatExecutionRevision(exec) } data-started-at={ exec.StartedAt.Format(time.RFC3339Nano) }>
			@chatExecutionPairContent(exec, task, executions, index, hasEarlier, attachments, messagesContainerID, pausePollingTargetID, projectID)
		</div>
	}
}

templ ChatExecutionPairPoll(exec models.Execution, task *models.Task, executions []models.Execution, index int, hasEarlier bool, attachments map[string][]models.ChatAttachment, messagesContainerID, pausePollingTargetID, projectID string, preservedExecIDs map[string]bool) {
	if chatExecutionIsTerminal(exec) && preservedExecIDs[exec.ID] {
		<div id={ "chat-execution-" + exec.ID } class="chat-execution-pair space-y-6" data-execution-pair="true" data-exec-id={ exec.ID } data-exec-status={ string(exec.Status) } data-execution-revision={ ChatExecutionRevision(exec) } data-started-at={ exec.StartedAt.Format(time.RFC3339Nano) } hx-preserve="true"></div>
	} else {
		@ChatExecutionPair(exec, task, executions, index, hasEarlier, attachments, messagesContainerID, pausePollingTargetID, projectID)
	}
}

// ChatFollowupResponse renders user message + streaming assistant for a follow-up.
// Used by both ChatSend (main chat) and TaskThreadSend (task thread).
templ ChatFollowupResponse(message, execID, messagesContainerID, pausePollingTargetID string, isThread bool, attachments []models.ChatAttachment, projectID string) {
	<div id={ "chat-execution-" + execID } class="chat-execution-pair space-y-6" data-execution-pair="true" data-exec-id={ execID } data-exec-status="running">
		if len(attachments) > 0 {
			@ChatBubbleWithAttachments("User", message, attachments, projectID)
		} else {
			@ChatBubble("User", message)
		}
		@ChatBubbleStreaming("Assistant", execID, messagesContainerID, pausePollingTargetID, isThread)
	</div>
}

// ChatMessages renders a list of executions as chat message bubbles.
// This is the shared message rendering loop used by both /chat and task thread.
// For task thread, deduplicates the original task prompt: only shows it for the
// first non-followup execution. Subsequent re-runs skip the user bubble.
templ ChatMessages(executions []models.Execution, task *models.Task, attachments map[string][]models.ChatAttachment, messagesContainerID, pausePollingTargetID string, hasEarlier bool, projectID string) {
	for i, exec := range executions {
		@ChatExecutionPair(exec, task, executions, i, hasEarlier, attachments, messagesContainerID, pausePollingTargetID, projectID)
	}
}

templ ChatMessagesPoll(executions []models.Execution, task *models.Task, attachments map[string][]models.ChatAttachment, messagesContainerID, pausePollingTargetID string, hasEarlier bool, projectID string, preservedExecIDs map[string]bool) {
	for i, exec := range executions {
		@ChatExecutionPairPoll(exec, task, executions, i, hasEarlier, attachments, messagesContainerID, pausePollingTargetID, projectID, preservedExecIDs)
	}
}

// ChatEmptyState renders the empty chat placeholder.
templ ChatEmptyState(message string) {
	<div class="flex flex-col items-center justify-center h-full text-center">
		<svg xmlns="http://www.w3.org/2000/svg" class="h-16 w-16 mb-4 opacity-20" fill="none" viewBox="0 0 24 24" stroke="currentColor">
			<path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M8 12h.01M12 12h.01M16 12h.01M21 12c0 4.418-4.03 8-9 8a9.863 9.863 0 01-4.255-.949L3 20l1.395-3.72C3.512 15.042 3 13.574 3 12c0-4.418 4.03-8 9-8s9 3.582 9 8z"></path>
		</svg>
		<p class="text-sm opacity-50">{ message }</p>
	</div>
}

templ ChatComposerActionButtonOOB(targetID, stopEndpoint string, isRunning bool, activeTurnID string) {
	<div
		id={ targetID }
		data-composer-running={ boolStr(isRunning) }
		data-active-turn-id={ activeTurnID }
		if isRunning && stopEndpoint != "" {
			data-composer-stop-endpoint={ stopEndpoint }
		}
		hx-swap-oob="outerHTML"
	>
		@chatComposerActionButton(stopEndpoint, isRunning)
	</div>
}

templ chatComposerActionButton(stopEndpoint string, isRunning bool) {
	if isRunning && stopEndpoint != "" {
		<button
			type="button"
			class="btn btn-primary btn-sm rounded-full min-h-0 h-8 w-8 p-0 flex-shrink-0"
			hx-post={ stopEndpoint }
			hx-swap="none"
			title="Stop response"
			aria-label="Stop response"
		>
			<svg data-composer-stop-icon="true" xmlns="http://www.w3.org/2000/svg" class="h-4 w-4" viewBox="0 0 24 24" fill="currentColor" aria-hidden="true">
				<rect x="6" y="6" width="12" height="12" rx="2"></rect>
			</svg>
			<svg data-composer-steer-icon="true" xmlns="http://www.w3.org/2000/svg" class="h-4 w-4 hidden" viewBox="0 0 24 24" fill="currentColor" aria-hidden="true">
				<path d="M2 3l20 9-20 9 5-9-5-9z"></path>
			</svg>
		</button>
	} else {
		<button type="submit" class="btn btn-primary btn-sm chat-send-button rounded-full min-h-0 h-8 w-8 p-0 flex-shrink-0" title="Send message" aria-label="Send message">
			<svg xmlns="http://www.w3.org/2000/svg" class="h-4 w-4" viewBox="0 0 24 24" fill="currentColor" aria-hidden="true">
				<path d="M2 3l20 9-20 9 5-9-5-9z"></path>
			</svg>
		</button>
	}
}

// ChatInputForm renders a shared chat input form with attachment support.
templ ChatInputForm(config ChatInputFormConfig) {
	<div class="chat-input-shadow-gutter w-full min-w-0 max-w-full mt-6">
		<form
			id={ config.FormID }
			method="post"
			hx-post={ config.PostEndpoint }
			hx-target={ "#" + config.TargetID }
			hx-swap="beforeend"
			data-input-id={ config.InputID }
			data-clear-func-name={ config.FormID + "ClearAttachments" }
			data-message-history-key={ chatMessageHistoryStorageKey(config) }
			data-attachment-state-key={ chatAttachmentStateKey(config) }
			data-steer-endpoint={ config.SteerEndpoint }
			if config.TaskID != "" {
				data-scroll-intent-scope={ config.TaskID }
				data-model-select-endpoint={ "/tasks/" + config.TaskID + "/thread/model" }
			}
			else
			if config.ProjectID != "" {
				data-scroll-intent-scope={ config.ProjectID }
			}
			class="chat-input-container rounded-xl p-4 relative min-w-0 max-w-full"
		>
			<!-- Drop zone overlay -->
			<div id={ chatDropOverlayID(config.FormID) } class="hidden absolute inset-0 z-10 rounded-xl border-2 border-dashed border-primary bg-primary/10 flex items-center justify-center pointer-events-none">
				<div class="flex flex-col items-center gap-2 text-primary">
					<svg xmlns="http://www.w3.org/2000/svg" class="h-8 w-8" fill="none" viewBox="0 0 24 24" stroke="currentColor">
						<path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M7 16a4 4 0 01-.88-7.903A5 5 0 1115.9 6L16 6a5 5 0 011 9.9M15 13l-3-3m0 0l-3 3m3-3v12"></path>
					</svg>
					<span class="text-sm font-medium">Drop files here to attach</span>
				</div>
			</div>
			if config.ShowModelSelector {
				<input type="hidden" id={ config.FormID + "-agent-id" } name="agent_id" value={ selectedAgentOrAuto(config.SelectedAgentID) }/>
			}
			if config.ShowModeSelector {
				<input type="hidden" id={ config.FormID + "-chat-mode" } name="chat_mode" value={ chatModeOrDefault(config.ChatMode) }/>
			}
			if config.ProjectID != "" {
				<input type="hidden" id={ config.FormID + "-project-id" } name="_project_id" value={ config.ProjectID }/>
			}
			<input type="hidden" id={ chatSessionInputID(config.FormID) } name="attachment_session_id" value=""/>
			if config.ActiveTurnID != "" {
				<input type="hidden" name="expected_turn_id" value={ config.ActiveTurnID }/>
			}
			<!-- File Attachments Preview -->
			<div id={ chatAttachmentPreviewID(config.FormID) } class="hidden border-b border-base-content/[0.12] -mx-4 px-4 -mt-4 pt-2.5 pb-2.5 mb-3">
				<div class="flex items-center justify-between mb-1.5">
					<span class="text-xs font-medium opacity-70">Attached Files</span>
					<button type="button" class="btn btn-ghost btn-xs text-xs" data-clear-func={ config.FormID + "ClearAttachments" }>Clear All</button>
				</div>
				<div id={ chatAttachmentListID(config.FormID) } class="space-y-1"></div>
			</div>
			@ChatComposerQueuedInputRowsForTask(config.PendingInputs, config.QueuedSteerEndpointFor, config.TaskID)
			<!-- Textarea -->
			<div>
				<textarea
					id={ config.InputID }
					name="message"
					class="w-full resize-none bg-transparent text-sm leading-relaxed focus:outline-none placeholder:opacity-40 p-0 text-left"
					placeholder="Enter sends or queues"
					title="Enter sends or queues"
					rows="3"
					enterkeyhint="send"
					required
				></textarea>
			</div>
			<!-- Bottom controls row -->
			<div class="flex items-center justify-between gap-2 pt-2 min-w-0 max-w-full overflow-hidden">
				<div class="flex items-center gap-1 min-w-0 flex-1">
					if config.ShowModelSelector {
						<!-- Custom mobile-safe model selector: replaces native <select> to avoid
						     incorrect popup positioning inside overflow:auto containers on mobile Chrome. -->
						<div class="relative inline-flex min-w-0">
							<button
								type="button"
								id={ config.FormID + "-agent-select" }
								class="chat-model-select chat-custom-select-btn btn btn-ghost btn-xs h-7 min-h-0 text-xs font-normal opacity-50 hover:opacity-100 w-auto min-w-0 max-w-[7.5rem] sm:max-w-[140px] rounded-lg flex items-center gap-1 px-2"
								data-agent-input={ config.FormID + "-agent-id" }
								data-current-value={ selectedAgentOrAuto(config.SelectedAgentID) }
								aria-haspopup="listbox"
								aria-expanded="false"
							><span class="chat-custom-select-label truncate flex-1 min-w-0 pointer-events-none">{ selectedAgentLabel(config.SelectedAgentID, config.Agents) }</span><svg class="flex-shrink-0 pointer-events-none" xmlns="http://www.w3.org/2000/svg" width="10" height="10" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round"><polyline points="6 9 12 15 18 9"></polyline></svg></button>
							<ul class="chat-custom-select-options" aria-hidden="true" style="display:none">
								<li data-value="auto">Auto</li>
								<li data-value="default">Default</li>
								for _, agent := range config.Agents {
									<li data-value={ agent.ID }>{ agent.Name } ({ agent.Model })</li>
								}
							</ul>
						</div>
					}
					if config.ShowModeSelector {
						<!-- Custom mobile-safe mode selector: replaces native <select> to avoid
						     incorrect popup positioning inside overflow:auto containers on mobile Chrome. -->
						<div class="relative inline-flex min-w-0">
							<button
								type="button"
								id={ config.FormID + "-mode-select" }
								class="chat-mode-select chat-custom-select-btn btn btn-ghost btn-xs h-7 min-h-0 text-xs font-normal opacity-50 hover:opacity-100 w-auto min-w-0 max-w-[6rem] sm:max-w-[120px] rounded-lg flex items-center gap-1 px-2"
								data-mode-input={ config.FormID + "-chat-mode" }
								data-current-value={ chatModeOrDefault(config.ChatMode) }
								aria-haspopup="listbox"
								aria-expanded="false"
							><span class="chat-custom-select-label truncate flex-1 min-w-0 pointer-events-none"></span><svg class="flex-shrink-0 pointer-events-none" xmlns="http://www.w3.org/2000/svg" width="10" height="10" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round"><polyline points="6 9 12 15 18 9"></polyline></svg></button>
							<ul class="chat-custom-select-options" aria-hidden="true" style="display:none">
								<li data-value="orchestrate">Orchestrate</li>
								<li data-value="plan">Plan</li>
							</ul>
						</div>
					}
				</div>
				<div id={ config.FormID + "-action-cluster" } class="flex items-center gap-2 flex-shrink-0">
					<!-- Attachment button -->
					<label for={ chatFileInputID(config.FormID) } class="btn btn-ghost btn-sm rounded-full min-h-0 h-8 w-8 p-0 flex-shrink-0 opacity-50 hover:opacity-100 hover:bg-base-300" title="Attach files">
						<svg xmlns="http://www.w3.org/2000/svg" class="h-4 w-4" fill="none" viewBox="0 0 24 24" stroke="currentColor">
							<path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M15.172 7l-6.586 6.586a2 2 0 102.828 2.828l6.414-6.586a4 4 0 00-5.656-5.656l-6.415 6.585a6 6 0 108.486 8.486L20.5 13"></path>
						</svg>
					</label>
					<input type="file" id={ chatFileInputID(config.FormID) } multiple class="hidden"/>
					<!-- Speech-to-text microphone button -->
					<button type="button" id={ config.FormID + "-mic-btn" } class="btn btn-ghost btn-sm rounded-full min-h-0 h-8 w-8 p-0 flex-shrink-0 opacity-50 hover:opacity-100 hover:bg-base-300 stt-btn" title="Speech to text" aria-label="Start speech to text">
						<!-- Mic icon (shown when not recording) -->
						<svg class="stt-mic-icon h-4 w-4" xmlns="http://www.w3.org/2000/svg" fill="none" viewBox="0 0 24 24" stroke="currentColor">
							<path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M19 11a7 7 0 01-7 7m0 0a7 7 0 01-7-7m7 7v4m0 0H8m4 0h4m-4-8a3 3 0 01-3-3V5a3 3 0 116 0v6a3 3 0 01-3 3z"></path>
						</svg>
						<!-- Stop icon (shown when recording) -->
						<svg class="stt-stop-icon h-4 w-4 hidden" xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" fill="currentColor">
							<rect x="6" y="6" width="12" height="12" rx="2"></rect>
						</svg>
					</button>
					<div
						id={ config.FormID + "-primary-action" }
						data-composer-running={ boolStr(config.IsRunning) }
						data-active-turn-id={ config.ActiveTurnID }
						if config.IsRunning && config.StopEndpoint != "" {
							data-composer-stop-endpoint={ config.StopEndpoint }
						}
					>
						@chatComposerActionButton(config.StopEndpoint, config.IsRunning)
					</div>
				</div>
			</div>
		</form>
	</div>
	<!-- Shared input form scripts: Enter key, file upload, drag-and-drop -->
	<script type="text/javascript">
		// Global portal-style custom select implementation.
		// Positioned with getBoundingClientRect() + position:fixed so it always
		// anchors near the trigger button regardless of scroll within overflow:auto
		// containers — fixing the mobile Chrome popup displacement bug.
		// Guard ensures this runs only once even when multiple ChatInputForms exist.
		if (!window._chatCustomSelectPanelReady) {
			window._chatCustomSelectPanelReady = true;

			var _cspanel = document.createElement('ul');
			_cspanel.id = 'chat-custom-select-panel';
			_cspanel.setAttribute('role', 'listbox');
			_cspanel.style.cssText = 'position:fixed;z-index:9999;display:none;list-style:none;margin:0;padding:4px 0;' +
				'min-width:160px;max-height:280px;overflow-y:auto;border-radius:8px;' +
				'border:1px solid oklch(var(--bc)/0.15);background:oklch(var(--b1));' +
				'box-shadow:0 4px 20px rgba(0,0,0,0.18);';
			document.body.appendChild(_cspanel);

			var _csActiveBtn = null;

			function _csClose() {
				if (_csActiveBtn) {
					_csActiveBtn.setAttribute('aria-expanded', 'false');
					_csActiveBtn = null;
				}
				_cspanel.style.display = 'none';
				_cspanel.innerHTML = '';
			}

			function _csOpen(btn) {
				_csClose();
				var optList = btn.parentElement && btn.parentElement.querySelector('.chat-custom-select-options');
				if (!optList) return;
				var currentValue = btn.dataset.currentValue || '';
				_cspanel.innerHTML = '';
				var items = optList.querySelectorAll('li[data-value]');
				items.forEach(function(li) {
					var val = li.dataset.value;
					var label = li.textContent.trim();
					var item = document.createElement('li');
					item.setAttribute('role', 'option');
					item.setAttribute('aria-selected', val === currentValue ? 'true' : 'false');
					item.dataset.value = val;
					item.style.cssText = 'display:flex;align-items:center;gap:6px;padding:6px 12px;cursor:pointer;' +
						'font-size:0.75rem;line-height:1.4;white-space:nowrap;' +
						(val === currentValue ? 'background:oklch(var(--p)/0.12);font-weight:600;' : '');
					var textSpan = document.createElement('span');
					textSpan.style.cssText = 'flex:1;min-width:0;';
					textSpan.textContent = label;
					item.appendChild(textSpan);
					if (val === currentValue) {
						var checkSvg = document.createElementNS('http://www.w3.org/2000/svg', 'svg');
						checkSvg.setAttribute('style', 'width:12px;height:12px;flex-shrink:0;');
						checkSvg.setAttribute('fill', 'none');
						checkSvg.setAttribute('viewBox', '0 0 24 24');
						checkSvg.setAttribute('stroke', 'currentColor');
						checkSvg.setAttribute('stroke-width', '2.5');
						var checkPath = document.createElementNS('http://www.w3.org/2000/svg', 'path');
						checkPath.setAttribute('stroke-linecap', 'round');
						checkPath.setAttribute('stroke-linejoin', 'round');
						checkPath.setAttribute('d', 'M5 13l4 4L19 7');
						checkSvg.appendChild(checkPath);
						item.appendChild(checkSvg);
					}
					item.addEventListener('mouseenter', function() { this.style.background = 'oklch(var(--b3)/1)'; });
					item.addEventListener('mouseleave', function() {
						this.style.background = this.dataset.value === currentValue ? 'oklch(var(--p)/0.12)' : '';
					});
					item.addEventListener('click', function(e) {
						e.preventDefault();
						e.stopPropagation();
						var prevBtn = _csActiveBtn;
						_csClose();
						if (!prevBtn) return;
						window._setChatCustomSelectValue(prevBtn, val);
						prevBtn.dispatchEvent(new CustomEvent('chat-select-change', { detail: { value: val }, bubbles: true }));
					});
					_cspanel.appendChild(item);
				});

				// Position using getBoundingClientRect() — accurate on mobile regardless of
				// scroll position within overflow:auto ancestor containers.
				var rect = btn.getBoundingClientRect();
				var panelEstH = Math.min(280, items.length * 34 + 10);
				var spaceAbove = rect.top;
				var spaceBelow = window.innerHeight - rect.bottom;
				_cspanel.style.display = 'block';
				_cspanel.style.minWidth = Math.max(rect.width, 160) + 'px';
				if (spaceAbove >= panelEstH || spaceAbove > spaceBelow) {
					// Open upward (preferred when composer is at bottom of screen)
					_cspanel.style.top = 'auto';
					_cspanel.style.bottom = (window.innerHeight - rect.top) + 'px';
				} else {
					// Open downward
					_cspanel.style.top = rect.bottom + 'px';
					_cspanel.style.bottom = 'auto';
				}
				_cspanel.style.left = rect.left + 'px';
				// Correct horizontal overflow after paint
				requestAnimationFrame(function() {
					var pr = _cspanel.getBoundingClientRect();
					if (pr.right > window.innerWidth - 4) {
						_cspanel.style.left = Math.max(4, window.innerWidth - pr.width - 4) + 'px';
					}
				});
				_csActiveBtn = btn;
				btn.setAttribute('aria-expanded', 'true');
			}

			window._openChatCustomSelectPanel = _csOpen;
			window._closeChatCustomSelectPanel = _csClose;

			// Close on outside click (capture phase to beat other handlers)
			document.addEventListener('click', function(e) {
				if (_cspanel.style.display === 'none') return;
				if (_csActiveBtn && (_csActiveBtn === e.target || _csActiveBtn.contains(e.target))) return;
				if (_cspanel === e.target || _cspanel.contains(e.target)) return;
				_csClose();
			}, true);

			// Close on Escape
			document.addEventListener('keydown', function(e) {
				if (e.key === 'Escape') _csClose();
			});

			// Reposition on resize so the panel stays near the trigger
			window.addEventListener('resize', function() {
				if (_csActiveBtn) _csOpen(_csActiveBtn);
			});
		}

		// Initialize a custom select button: sets initial label from current value and binds click.
		window._initChatCustomSelect = function(btn) {
			var currentValue = btn.dataset.currentValue;
			var optList = btn.parentElement && btn.parentElement.querySelector('.chat-custom-select-options');
			if (!optList) return;
			var matchingLi = null;
			optList.querySelectorAll('li[data-value]').forEach(function(li) {
				if (li.dataset.value === currentValue) matchingLi = li;
			});
			var firstLi = optList.querySelector('li[data-value]');
			var label = matchingLi ? matchingLi.textContent.trim() : (firstLi ? firstLi.textContent.trim() : '');
			var labelEl = btn.querySelector('.chat-custom-select-label');
			if (labelEl) labelEl.textContent = label;
			if (!btn._chatCustomSelectBound) {
				btn._chatCustomSelectBound = true;
				btn.addEventListener('click', function(e) {
					e.preventDefault();
					e.stopPropagation();
					if (btn.getAttribute('aria-expanded') === 'true') {
						if (window._closeChatCustomSelectPanel) window._closeChatCustomSelectPanel();
					} else {
						if (window._openChatCustomSelectPanel) window._openChatCustomSelectPanel(btn);
					}
				});
			}
		};

		// Update a custom select button's displayed label and stored value.
		window._setChatCustomSelectValue = function(btn, value) {
			if (!btn) return;
			var optList = btn.parentElement && btn.parentElement.querySelector('.chat-custom-select-options');
			if (!optList) return;
			var matchingLi = null;
			optList.querySelectorAll('li[data-value]').forEach(function(li) {
				if (li.dataset.value === value) matchingLi = li;
			});
			if (!matchingLi) return;
			var label = matchingLi.textContent.trim();
			var labelEl = btn.querySelector('.chat-custom-select-label');
			if (labelEl) labelEl.textContent = label;
			btn.dataset.currentValue = value;
		};

		(function() {
			// Find our form by walking up from the script tag
			var script = document.currentScript;
			var wrapper = script ? script.previousElementSibling : null;
			var form = wrapper ? wrapper.querySelector('form.chat-input-container') : null;
			if (!form || form.tagName !== 'FORM') return;
			var formId = form.id;
			var inputId = form.querySelector('textarea[name="message"]').id;
			var messageInput = document.getElementById(inputId);
			var sessionInput = form.querySelector('input[name="attachment_session_id"]');
			var fileInput = form.querySelector('input[type="file"]');
			var preview = form.querySelector('[id$="-attachments-preview"]');
			var listContainer = form.querySelector('[id$="-attachments-list"]');
			var dropOverlay = form.querySelector('[id$="-drop-overlay"]');
			var clearBtn = form.querySelector('[data-clear-func]');
			var clearFuncName = clearBtn ? clearBtn.getAttribute('data-clear-func') : (formId + 'ClearAttachments');
				var agentSelect = form.querySelector('[id$="-agent-select"]');
				var agentInput = agentSelect ? document.getElementById(agentSelect.getAttribute('data-agent-input')) : null;
					var modeSelect = form.querySelector('[id$="-mode-select"]');
					var modeInput = modeSelect ? document.getElementById(modeSelect.getAttribute('data-mode-input')) : null;
						var normalPostEndpoint = form.getAttribute('hx-post') || form.getAttribute('action') || '';
						var steerEndpoint = form.getAttribute('data-steer-endpoint') || '';
						function chatComposerUsesAppleShortcuts() {
							var platform = '';
							if (navigator.userAgentData && navigator.userAgentData.platform) platform = navigator.userAgentData.platform;
							else platform = navigator.platform || navigator.userAgent || '';
							return /Mac|iPhone|iPad|iPod|iOS/i.test(platform);
						}
							var usesAppleShortcuts = chatComposerUsesAppleShortcuts();
							var shortcutModifierHeld = false;
							var steerRequestInFlight = false;
							var steerRequestSignature = '';
							var steerFallbackPending = false;
							var queuedSteerSubmissions = [];
							function shortcutModifierPressed(event) {
							return usesAppleShortcuts ? event.metaKey : event.ctrlKey;
						}
						function shortcutHint() {
							return usesAppleShortcuts
								? '⏎ sends or queues · ⌘+⏎ steers'
								: 'Enter sends or queues · Ctrl+Enter steers';
						}
						window.refreshChatComposerShortcutHint = function(textarea) {
							if (!textarea) return;
							textarea.setAttribute('placeholder', shortcutHint());
							textarea.setAttribute('title', shortcutHint());
						};
						window.refreshChatComposerShortcutHint(messageInput);
								function currentSubmitButton() {
									return form.querySelector('button[type="submit"]');
								}
								function buildPrimaryActionButton(kind, stopEndpoint) {
									var button = document.createElement('button');
									button.className = 'btn btn-primary btn-sm' + (kind === 'stop' ? '' : ' chat-send-button') + ' rounded-full min-h-0 h-8 w-8 p-0 flex-shrink-0';
									if (kind === 'stop') {
										button.type = 'button';
										button.setAttribute('hx-post', stopEndpoint);
										button.setAttribute('hx-swap', 'none');
										button.title = 'Stop response';
										button.setAttribute('aria-label', 'Stop response');
										button.innerHTML = '<svg data-composer-stop-icon="true" xmlns="http://www.w3.org/2000/svg" class="h-4 w-4" viewBox="0 0 24 24" fill="currentColor" aria-hidden="true"><rect x="6" y="6" width="12" height="12" rx="2"></rect></svg><svg data-composer-steer-icon="true" xmlns="http://www.w3.org/2000/svg" class="h-4 w-4 hidden" viewBox="0 0 24 24" fill="currentColor" aria-hidden="true"><path d="M2 3l20 9-20 9 5-9-5-9z"></path></svg>';
										return button;
									}
									button.type = 'submit';
									button.title = 'Send message';
									button.setAttribute('aria-label', 'Send message');
									button.innerHTML = '<svg xmlns="http://www.w3.org/2000/svg" class="h-4 w-4" viewBox="0 0 24 24" fill="currentColor" aria-hidden="true"><path d="M2 3l20 9-20 9 5-9-5-9z"></path></svg>';
									return button;
								}
								function primaryActionStopEndpoint(action) {
									if (!action) return '';
									var endpoint = action.getAttribute('data-composer-stop-endpoint') || '';
									var stopButton = action.querySelector('button[aria-label="Stop response"][hx-post]');
									if (!endpoint && stopButton) endpoint = stopButton.getAttribute('hx-post') || '';
									if (endpoint) action.setAttribute('data-composer-stop-endpoint', endpoint);
									return endpoint;
								}
								function refreshPrimaryActionForInput() {
									var action = document.getElementById(formId + '-primary-action');
									if (!action) return;
									var running = action.getAttribute('data-composer-running') === 'true';
									var hasContent = !!(messageInput && messageInput.value.trim() !== '');
									var stopEndpoint = primaryActionStopEndpoint(action);
									var wantStop = running && !hasContent && !!stopEndpoint;
									var wantLabel = wantStop ? 'Stop response' : 'Send message';
									var currentButton = action.querySelector('button');
									if (currentButton && currentButton.getAttribute('aria-label') === wantLabel) {
										updatePrimaryActionModifierVisual();
										return;
									}
									action.innerHTML = '';
									action.appendChild(buildPrimaryActionButton(wantStop ? 'stop' : 'send', stopEndpoint));
									if (typeof htmx !== 'undefined') htmx.process(action);
									updatePrimaryActionModifierVisual();
								}
									function updatePrimaryActionModifierVisual() {
										var action = document.getElementById(formId + '-primary-action');
										var showSteer = shortcutModifierHeld && action && action.getAttribute('data-composer-running') === 'true';
								var stopIcon = action ? action.querySelector('[data-composer-stop-icon]') : null;
								var steerIcon = action ? action.querySelector('[data-composer-steer-icon]') : null;
								if (stopIcon) stopIcon.classList.toggle('hidden', !!showSteer);
								if (steerIcon) steerIcon.classList.toggle('hidden', !showSteer);
							}
							function consumeShortcutModifierVisual() {
								shortcutModifierHeld = false;
								updatePrimaryActionModifierVisual();
							}
							function isShortcutModifierKey(event) {
								return usesAppleShortcuts ? event.key === 'Meta' : event.key === 'Control';
							}
							document.addEventListener('keydown', function(event) {
								if (!isShortcutModifierKey(event)) return;
								shortcutModifierHeld = true;
								updatePrimaryActionModifierVisual();
							});
							document.addEventListener('keyup', function(event) {
								if (!isShortcutModifierKey(event)) return;
								consumeShortcutModifierVisual();
							});
							window.addEventListener('blur', consumeShortcutModifierVisual);
						function safeSubmit() {
							var submitBtn = currentSubmitButton();
									if (typeof form.requestSubmit === 'function') {
										form.requestSubmit(submitBtn || undefined);
										return;
									}
							var submitEvent = new Event('submit', { bubbles: true, cancelable: true });
							form.dispatchEvent(submitEvent);
						}
							function submitComposer(endpoint, intent, payload) {
								if (!endpoint) return;
								if (intent === 'steer' && typeof htmx !== 'undefined') {
									var expectedTurnInput = form.querySelector('input[name="expected_turn_id"]');
									payload = payload || {
										message: messageInput ? messageInput.value : '',
										attachmentSessionID: sessionInput ? sessionInput.value : '',
										expectedTurnID: expectedTurnInput ? expectedTurnInput.value : ''
									};
									var signature = JSON.stringify([payload.message, payload.attachmentSessionID, payload.expectedTurnID]);
									if (steerRequestInFlight) {
										if (signature === steerRequestSignature || queuedSteerSubmissions.some(function(submission) { return submission.signature === signature; })) return;
										queuedSteerSubmissions.push({signature: signature, payload: payload});
										return;
									}
									steerRequestSignature = signature;
								}
								var visibleMessageBeforePayload = messageInput ? messageInput.value : '';
								var visibleSessionBeforePayload = sessionInput ? sessionInput.value : '';
								var restorePayloadValues = !!payload;
								if (restorePayloadValues) {
									if (messageInput && typeof payload.message === 'string') messageInput.value = payload.message;
									if (sessionInput && typeof payload.attachmentSessionID === 'string') sessionInput.value = payload.attachmentSessionID;
								}
								form.setAttribute('data-submit-intent', intent || 'normal');
								form._chatNextSubmissionPayload = payload || null;
								if (intent === 'steer' && typeof htmx !== 'undefined') {
									steerRequestInFlight = true;
									steerFallbackPending = false;
									var options = {
									source: form,
									target: '#pending-thread-inputs',
									swap: form.getAttribute('hx-swap') || 'beforeend'
								};
										if (payload) {
											options.values = {
												message: payload.message,
												attachment_session_id: payload.attachmentSessionID,
												expected_turn_id: payload.expectedTurnID
											};
										}
									try {
										var steerRequest = htmx.ajax('POST', endpoint, options);
										if (steerRequest && typeof steerRequest.then === 'function') {
											steerRequest.then(finishSteerRequest, finishSteerRequest);
										}
									} catch (error) {
										finishSteerRequest();
										throw error;
									} finally {
										if (restorePayloadValues) {
											if (messageInput) messageInput.value = visibleMessageBeforePayload;
											if (sessionInput) sessionInput.value = visibleSessionBeforePayload;
										}
									}
								return;
							}
							form.setAttribute('hx-post', endpoint);
							try {
								safeSubmit();
							} finally {
								if (restorePayloadValues) {
									if (messageInput) messageInput.value = visibleMessageBeforePayload;
									if (sessionInput) sessionInput.value = visibleSessionBeforePayload;
								}
							}
							}
							function finishSteerRequest() {
								if (steerFallbackPending) return;
								steerRequestInFlight = false;
								steerRequestSignature = '';
								if (!queuedSteerSubmissions.length) return;
								var nextSubmission = queuedSteerSubmissions.shift();
								submitComposer(steerEndpoint, 'steer', nextSubmission.payload);
							}
						function composerHasActiveTurn() {
							var action = document.getElementById(formId + '-primary-action');
							return !!action && action.getAttribute('data-composer-running') === 'true';
						}
						function clearExpectedTurnIDWhenIdle() {
							if (composerHasActiveTurn()) return;
							var guard = form.querySelector('input[name="expected_turn_id"]');
							if (guard) guard.remove();
						}
						function activeTurnID() {
							var targetSelector = form.getAttribute('hx-target') || '';
							var target = targetSelector && targetSelector.charAt(0) === '#' ? document.getElementById(targetSelector.slice(1)) : null;
							var pairs = target ? target.querySelectorAll('[data-execution-pair="true"][data-exec-status="running"], [data-execution-pair="true"][data-exec-status="queued"]') : [];
								if (pairs.length) return pairs[pairs.length - 1].getAttribute('data-exec-id') || '';
								var action = document.getElementById(formId + '-primary-action');
								var actionTurnID = action ? action.getAttribute('data-active-turn-id') || '' : '';
								if (actionTurnID) return actionTurnID;
								if (!composerHasActiveTurn()) {
								clearExpectedTurnIDWhenIdle();
								return '';
							}
							var guard = form.querySelector('input[name="expected_turn_id"]');
							return guard ? guard.value : '';
						}
						function setExpectedTurnID(turnID) {
							var guard = form.querySelector('input[name="expected_turn_id"]');
							if (!guard) {
								guard = document.createElement('input');
								guard.type = 'hidden';
								guard.name = 'expected_turn_id';
								form.appendChild(guard);
							}
							guard.value = turnID;
						}
						function deferSteerWhileSendPending() {
							if (normalRequestInFlight < 1 || !steerEndpoint || !messageInput || !messageInput.value.trim()) return false;
							deferredSteer = {
								message: messageInput.value,
								attachmentSessionID: sessionInput ? sessionInput.value : ''
							};
							return true;
						}
						function flushDeferredSteer() {
							if (!deferredSteer || normalRequestInFlight > 0) return;
							var turnID = activeTurnID();
							if (!turnID) return;
							var payload = deferredSteer;
							deferredSteer = null;
							payload.expectedTurnID = turnID;
							setExpectedTurnID(turnID);
							submitComposer(steerEndpoint, 'steer', payload);
						}
									function handleComposerStateMutation() {
										clearExpectedTurnIDWhenIdle();
										refreshPrimaryActionForInput();
										flushDeferredSteer();
									}
									if (typeof MutationObserver !== 'undefined') {
										new MutationObserver(handleComposerStateMutation).observe(form, { childList: true, subtree: true });
						}
							clearExpectedTurnIDWhenIdle();
							refreshPrimaryActionForInput();

					var messageHistoryStorageKey = form.getAttribute('data-message-history-key') || '';
					var messageHistoryLimit = 50;
				var messageHistoryEntries = [];
				var messageHistoryIndex = -1;
				var messageHistoryDraft = '';
				var normalRequestInFlight = 0;
				var deferredSteer = null;
				var suppressMessageHistoryInputReset = false;

				function loadMessageHistory() {
					if (!messageHistoryStorageKey) return [];
					try {
						var raw = localStorage.getItem(messageHistoryStorageKey);
						var parsed = raw ? JSON.parse(raw) : [];
						if (!Array.isArray(parsed)) return [];
						return parsed.filter(function(entry) { return typeof entry === 'string' && entry.trim() !== ''; }).slice(-messageHistoryLimit);
					} catch (e) {
						return [];
					}
				}

				function saveMessageHistory(entries) {
					if (!messageHistoryStorageKey) return;
					try {
						localStorage.setItem(messageHistoryStorageKey, JSON.stringify(entries.slice(-messageHistoryLimit)));
					} catch (e) {
						// Ignore storage failures; keyboard navigation still works for the current page load.
					}
				}

				function rememberSubmittedMessage(message) {
					var trimmed = (message || '').trim();
					if (!trimmed) return;
					messageHistoryEntries = loadMessageHistory();
					if (messageHistoryEntries.length === 0 || messageHistoryEntries[messageHistoryEntries.length - 1] !== message) {
						messageHistoryEntries.push(message);
					}
					messageHistoryEntries = messageHistoryEntries.slice(-messageHistoryLimit);
					saveMessageHistory(messageHistoryEntries);
				}

				function resetMessageHistoryNavigation() {
					messageHistoryIndex = -1;
					messageHistoryDraft = '';
				}

				function setMessageInputFromHistory(value) {
					if (!messageInput) return;
					messageInput.value = value;
					suppressMessageHistoryInputReset = true;
					messageInput.dispatchEvent(new Event('input', { bubbles: true }));
					suppressMessageHistoryInputReset = false;
					if (typeof messageInput.setSelectionRange === 'function') {
						messageInput.setSelectionRange(0, 0);
					}
				}

				function isAtFirstLineStart(textarea) {
					if (!textarea) return false;
					var start = typeof textarea.selectionStart === 'number' ? textarea.selectionStart : 0;
					var end = typeof textarea.selectionEnd === 'number' ? textarea.selectionEnd : start;
					if (start !== end) return false;
					return start === 0;
				}

				function handleMessageHistoryKeydown(e) {
					if (!messageInput || !messageHistoryStorageKey) return false;
					if (e.key !== 'ArrowUp' && e.key !== 'ArrowDown' && e.key !== 'Escape') return false;
					if (e.key === 'Escape') {
						if (messageHistoryIndex === -1) return false;
						e.preventDefault();
						setMessageInputFromHistory(messageHistoryDraft);
						resetMessageHistoryNavigation();
						return true;
					}
					if ((e.key === 'ArrowUp' || e.key === 'ArrowDown') && messageInput.value !== '' && !isAtFirstLineStart(messageInput)) return false;
					if (e.key === 'ArrowDown' && messageHistoryIndex === -1) return false;

					messageHistoryEntries = loadMessageHistory();
					if (messageHistoryEntries.length === 0) return false;
					e.preventDefault();

					if (e.key === 'ArrowUp') {
						if (messageHistoryIndex === -1) messageHistoryDraft = messageInput.value;
						if (messageHistoryIndex < messageHistoryEntries.length - 1) messageHistoryIndex++;
						setMessageInputFromHistory(messageHistoryEntries[messageHistoryEntries.length - 1 - messageHistoryIndex]);
						return true;
					}

					if (messageHistoryIndex > 0) {
						messageHistoryIndex--;
						setMessageInputFromHistory(messageHistoryEntries[messageHistoryEntries.length - 1 - messageHistoryIndex]);
					} else {
						setMessageInputFromHistory(messageHistoryDraft);
						resetMessageHistoryNavigation();
					}
					return true;
				}

			var attachmentUploadQueue = Promise.resolve();
			var attachmentUploadGeneration = 0;
			var attachmentStateKey = form.getAttribute('data-attachment-state-key') || '';
			window._chatPendingAttachmentStates = window._chatPendingAttachmentStates || {};

			function appendPendingAttachmentRow(targetList, attachment) {
				if (!targetList || !attachment) return;
				var filename = String(attachment.filename || '');
				var size = parseInt(attachment.size || '0', 10) || 0;
				var div = document.createElement('div');
				div.className = 'flex items-center gap-2 text-sm';
				div.setAttribute('data-pending-attachment', 'true');
				div.setAttribute('data-pending-attachment-filename', filename);
				div.setAttribute('data-pending-attachment-size', String(size));
				div.innerHTML = '<svg class="w-4 h-4 text-base-content/70" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M15.172 7l-6.586 6.586a2 2 0 102.828 2.828l6.414-6.586a4 4 0 00-5.656-5.656l-6.415 6.585a6 6 0 108.486 8.486L20.5 13"></path></svg>';
				var name = document.createElement('span');
				name.className = 'font-medium';
				name.textContent = filename;
				div.appendChild(name);
				var sizeLabel = document.createElement('span');
				sizeLabel.className = 'text-xs opacity-60';
				sizeLabel.textContent = formatBytes(size);
				div.appendChild(sizeLabel);
				targetList.appendChild(div);
			}

				function readPendingAttachmentState(targetForm) {
					if (!targetForm) return null;
					var targetSession = targetForm.querySelector('input[name="attachment_session_id"]');
					var targetList = targetForm.querySelector('[id$="-attachments-list"]');
					var sessionID = targetSession ? (targetSession.value || targetSession.getAttribute('value') || '') : '';
					if (!sessionID) return null;
					var attachments = [];
					if (targetList) {
						targetList.querySelectorAll('[data-pending-attachment="true"]').forEach(function(row) {
							attachments.push({
								filename: row.getAttribute('data-pending-attachment-filename') || '',
								size: parseInt(row.getAttribute('data-pending-attachment-size') || '0', 10) || 0
							});
						});
					}
					return { sessionID: sessionID, attachments: attachments };
				}

				window.saveChatPendingAttachmentState = function(formOrID) {
					var targetForm = typeof formOrID === 'string' ? document.getElementById(formOrID) : formOrID;
					if (!targetForm) return null;
					var key = targetForm.getAttribute('data-attachment-state-key') || '';
					if (!key) return null;
					var state = readPendingAttachmentState(targetForm);
					if (!state) return null;
					var targetSession = targetForm.querySelector('input[name="attachment_session_id"]');
					if (targetSession) targetSession.setAttribute('value', state.sessionID);
					window._chatPendingAttachmentStates[key] = state;
					try { sessionStorage.setItem(key, JSON.stringify(state)); } catch (_) {}
					return state;
				};

				window.restoreChatPendingAttachmentState = function(formOrID) {
					var targetForm = typeof formOrID === 'string' ? document.getElementById(formOrID) : formOrID;
					if (!targetForm) return false;
					var key = targetForm.getAttribute('data-attachment-state-key') || '';
					if (!key) return false;
					var state = window._chatPendingAttachmentStates[key] || null;
					if (!state) {
						try {
							var stored = sessionStorage.getItem(key);
							state = stored ? JSON.parse(stored) : null;
						} catch (_) { state = null; }
					}
					if (!state || !state.sessionID) return false;
					var targetSession = targetForm.querySelector('input[name="attachment_session_id"]');
					var targetPreview = targetForm.querySelector('[id$="-attachments-preview"]');
					var targetList = targetForm.querySelector('[id$="-attachments-list"]');
					if (!targetSession || !targetList) return false;
					targetSession.value = state.sessionID;
					targetSession.setAttribute('value', state.sessionID);
					targetList.innerHTML = '';
					(state.attachments || []).forEach(function(attachment) { appendPendingAttachmentRow(targetList, attachment); });
					if (targetPreview) targetPreview.classList.toggle('hidden', (state.attachments || []).length === 0);
					window._chatPendingAttachmentStates[key] = state;
					return true;
				};

			// Clear attachments function (registered on window for onclick handlers)
				window[clearFuncName] = function() {
					attachmentUploadGeneration++;
					if (preview) preview.classList.add('hidden');
					if (listContainer) listContainer.innerHTML = '';
					if (sessionInput) {
						sessionInput.value = '';
						sessionInput.setAttribute('value', '');
					}
					if (fileInput) fileInput.value = '';
					if (attachmentStateKey) {
						delete window._chatPendingAttachmentStates[attachmentStateKey];
						try { sessionStorage.removeItem(attachmentStateKey); } catch (_) {}
					}
				};
				window.restoreChatPendingAttachmentState(form);
				if (!window._chatPendingAttachmentHistoryBound) {
					window._chatPendingAttachmentHistoryBound = true;
					document.body.addEventListener('htmx:beforeHistorySave', function() {
						document.querySelectorAll('form[data-attachment-state-key]').forEach(function(historyForm) {
							if (window.saveChatPendingAttachmentState) window.saveChatPendingAttachmentState(historyForm);
						});
					});
					document.body.addEventListener('htmx:historyRestore', function() {
						setTimeout(function() {
							document.querySelectorAll('form[data-attachment-state-key]').forEach(function(restoredForm) {
								if (window.restoreChatPendingAttachmentState) window.restoreChatPendingAttachmentState(restoredForm);
							});
						}, 0);
					});
				}
			// Wire up the Clear All button
			if (clearBtn) {
				clearBtn.onclick = function() { window[clearFuncName](); };
			}

						// Keyboard submission and message history navigation
						if (messageInput) {
						messageInput.addEventListener('keydown', function(e) {
							if (handleMessageHistoryKeydown(e)) return;
							if (e.isComposing || e.keyCode === 229) return;
							if (e.key === 'Enter' && !e.shiftKey) {
								e.preventDefault();
								if (shortcutModifierPressed(e)) {
									consumeShortcutModifierVisual();
									var turnID = activeTurnID();
									if (steerEndpoint && turnID) {
										setExpectedTurnID(turnID);
										submitComposer(steerEndpoint, 'steer');
										return;
									}
									if (deferSteerWhileSendPending()) return;
								}
								submitComposer(normalPostEndpoint, 'normal');
							}
							});
								messageInput.addEventListener('input', function() {
									refreshPrimaryActionForInput();
									if (!suppressMessageHistoryInputReset) resetMessageHistoryNavigation();
								});
							}

					// Normalize primary-action clicks to the shared submit paths, even after
					// the button is replaced out-of-band between Send and Stop. A platform
					// modifier on the primary control requests guarded steering whenever the
					// transcript already has an active turn, even if the action swap still shows Send;
					// an unavailable/stale steering request leaves the draft untouched.
					form.addEventListener('click', function(e) {
						var primaryAction = e.target && e.target.closest ? e.target.closest('[id="' + formId + '-primary-action"] button') : null;
						if (!primaryAction || !form.contains(primaryAction)) return;
						var isStopAction = primaryAction.getAttribute('aria-label') === 'Stop response';
						if (shortcutModifierPressed(e)) {
							consumeShortcutModifierVisual();
							var turnID = activeTurnID();
							if (steerEndpoint && turnID) {
								e.preventDefault();
								e.stopImmediatePropagation();
								setExpectedTurnID(turnID);
								submitComposer(steerEndpoint, 'steer');
								return;
							}
							if (deferSteerWhileSendPending()) {
								e.preventDefault();
								e.stopImmediatePropagation();
								return;
							}
							if (isStopAction) {
								e.preventDefault();
								e.stopImmediatePropagation();
								return;
							}
						}
						if (isStopAction) return;
						if (primaryAction.type !== 'submit') return;
						e.preventDefault();
						e.stopImmediatePropagation();
						submitComposer(normalPostEndpoint, 'normal');
					}, true);
			// Model selector -> hidden input sync + localStorage persistence
			var projectIdInput = form.querySelector('input[name="_project_id"]');
			var projectId = projectIdInput ? projectIdInput.value : '';
			var modelStorageKey = projectId ? 'chat-model-' + projectId : '';
			var modeStorageKey = projectId ? 'chat-mode-' + projectId : '';

			if (agentSelect && agentInput) {
				var agentOptList = agentSelect.parentElement ? agentSelect.parentElement.querySelector('.chat-custom-select-options') : null;
				// Initialize the custom select UI (set label from current value, bind click handler)
				if (window._initChatCustomSelect) window._initChatCustomSelect(agentSelect);
				// Restore persisted selection
				if (modelStorageKey) {
					var saved = localStorage.getItem(modelStorageKey);
					if (saved) {
						// Verify the saved option still exists in the list
						var optExists = false;
						if (agentOptList) {
							agentOptList.querySelectorAll('li[data-value]').forEach(function(li) {
								if (li.dataset.value === saved) optExists = true;
							});
						}
						if (optExists) {
							if (window._setChatCustomSelectValue) window._setChatCustomSelectValue(agentSelect, saved);
							agentInput.value = saved;
						} else {
							localStorage.removeItem(modelStorageKey);
						}
					}
				}
				var modelSelectEndpoint = form.getAttribute('data-model-select-endpoint');
				agentSelect.addEventListener('chat-select-change', function(e) {
					agentInput.value = e.detail.value;
					if (modelStorageKey) {
						localStorage.setItem(modelStorageKey, e.detail.value);
					}
					// Task threads have no localStorage persistence (keyed by
					// ProjectID, which task threads omit); persist the
					// selection server-side immediately so navigating away
					// and back does not silently revert to the task default.
					if (modelSelectEndpoint) {
						var body = new URLSearchParams();
						body.set('agent_id', e.detail.value);
						fetch(modelSelectEndpoint, { method: 'POST', body: body }).catch(function() {});
					}
				});
			}

			// Chat mode selector -> hidden input sync + localStorage persistence
			if (modeSelect && modeInput) {
				var modeOptList = modeSelect.parentElement ? modeSelect.parentElement.querySelector('.chat-custom-select-options') : null;
				// Initialize the custom select UI (set label from current value, bind click handler)
				if (window._initChatCustomSelect) window._initChatCustomSelect(modeSelect);
				function reevaluatePlanPrompt() {
					setTimeout(function() {
						if (window.evaluatePlanCompletionPrompt) window.evaluatePlanCompletionPrompt();
					}, 0);
				}
				// Mark selector as not hydrated until default + persisted restore is applied.
				modeSelect.dataset.hydrated = 'false';
				// Ensure UI reflects current hidden default first
				if (modeInput.value) {
					if (window._setChatCustomSelectValue) window._setChatCustomSelectValue(modeSelect, modeInput.value);
				}

				// Restore persisted selection
				if (modeStorageKey) {
					var savedMode = localStorage.getItem(modeStorageKey);
					if (savedMode) {
						var modeExists = false;
						if (modeOptList) {
							modeOptList.querySelectorAll('li[data-value]').forEach(function(li) {
								if (li.dataset.value === savedMode) modeExists = true;
							});
						}
						if (modeExists) {
							if (window._setChatCustomSelectValue) window._setChatCustomSelectValue(modeSelect, savedMode);
							modeInput.value = savedMode;
							reevaluatePlanPrompt();
						} else {
							localStorage.removeItem(modeStorageKey);
						}
					}
				}
				modeSelect.dataset.hydrated = 'true';

				modeSelect.addEventListener('chat-select-change', function(e) {
					modeInput.value = e.detail.value;
					if (modeStorageKey) {
						localStorage.setItem(modeStorageKey, e.detail.value);
					}
					modeSelect.dataset.hydrated = 'true';
					reevaluatePlanPrompt();
				});
			}

			function formatBytes(bytes) {
				if (bytes < 1024) return bytes + ' B';
				var k = 1024;
				var sizes = ['KB', 'MB', 'GB'];
				var i = Math.floor(Math.log(bytes) / Math.log(k));
				return (bytes / Math.pow(k, i)).toFixed(1) + ' ' + sizes[i - 1];
			}

				async function uploadFiles(files, uploadGeneration) {
					var existingAttachmentCount = listContainer ? listContainer.querySelectorAll('[data-pending-attachment]').length : 0;
					if (existingAttachmentCount + files.length > 3) {
						alert('Maximum 3 files allowed');
						return;
					}
					var maxSize = 10 * 1024 * 1024;
					for (var j = 0; j < files.length; j++) {
						if (files[j].size > maxSize) {
							alert('File "' + files[j].name + '" exceeds 10MB limit');
							return;
						}
					}
					var formData = new FormData();
					if (sessionInput && sessionInput.value) formData.append('attachment_session_id', sessionInput.value);
					files.forEach(function(file) { formData.append('files', file); });
					try {
						var response = await fetch('/chat/attachments', {
							method: 'POST',
							body: formData
						});
						if (!response.ok) {
							var error = await response.text();
							alert('Upload failed: ' + error);
							return;
						}
						var result = await response.json();
						if (uploadGeneration !== attachmentUploadGeneration) return;
						if (sessionInput) sessionInput.value = result.session_id;
						if (preview) preview.classList.remove('hidden');
						result.attachments.forEach(function(att) {
							appendPendingAttachmentRow(listContainer, att);
						});
						window.saveChatPendingAttachmentState(form);
						// Auto-scroll to show the attachment preview after upload
						requestAnimationFrame(function() {
							// Find the chat messages container (works for both /chat and task thread)
							var chatMessages = document.getElementById('chat-messages') || document.getElementById('task-thread-messages');
							if (chatMessages && window.chatAutoScroll) {
								window.chatAutoScroll.scrollToBottom(chatMessages, true);
							}
						});
					} catch (error) {
						console.error('Upload error:', error);
						alert('Upload failed: ' + error.message);
					}
				}

				function handleFiles(files) {
					if (files.length === 0) return;
					var filesToUpload = files.slice();
					var uploadGeneration = attachmentUploadGeneration;
					attachmentUploadQueue = attachmentUploadQueue.then(function() {
						if (uploadGeneration !== attachmentUploadGeneration) return;
						return uploadFiles(filesToUpload, uploadGeneration);
					});
				}

			// File input handler
			if (fileInput) {
				fileInput.addEventListener('change', function(e) {
					handleFiles(Array.from(e.target.files));
					e.target.value = '';
				});
			}

			// Drag-and-drop
			var dragCounter = 0;
			form.addEventListener('dragenter', function(e) {
				e.preventDefault();
				e.stopPropagation();
				dragCounter++;
				if (dropOverlay) dropOverlay.classList.remove('hidden');
			});
			form.addEventListener('dragover', function(e) {
				e.preventDefault();
				e.stopPropagation();
			});
			form.addEventListener('dragleave', function(e) {
				e.preventDefault();
				e.stopPropagation();
				dragCounter--;
				if (dragCounter <= 0) {
					dragCounter = 0;
					if (dropOverlay) dropOverlay.classList.add('hidden');
				}
			});
			form.addEventListener('drop', function(e) {
				e.preventDefault();
				e.stopPropagation();
				dragCounter = 0;
				if (dropOverlay) dropOverlay.classList.add('hidden');
				var files = Array.from(e.dataTransfer.files);
				if (files.length > 0) handleFiles(files);
			});

			// Speech-to-text via Web Speech API with audio level detection
			(function() {
				var micBtn = form.querySelector('.stt-btn');
				if (!micBtn || !messageInput) return;

				var micIcon = micBtn.querySelector('.stt-mic-icon');
				var stopIcon = micBtn.querySelector('.stt-stop-icon');
				var recognition = null;
				var isRecording = false;
				var manualStop = false;

				// Audio analysis for silence detection
				var audioContext = null;
				var audioAnalyzer = null;
				var audioStream = null;
				var silenceTimer = null;
				var silenceThreshold = 2000; // 2 seconds like Chrome plugin
				var audioLevel = 0;
				var countdownInterval = null;
				var countdownSeconds = 0;

				// Speech transcription state
				var finalTranscript = '';
				var startPos = 0;
				var existingText = '';
				var initialValue = '';
				var prefix = '';
				var suffix = '';

				// Check browser support
				var SpeechRecognition = window.SpeechRecognition || window.webkitSpeechRecognition;
				if (!SpeechRecognition) {
					micBtn.title = 'Speech-to-text not supported in this browser';
					micBtn.classList.add('opacity-20', 'cursor-not-allowed');
					micBtn.classList.remove('hover:opacity-100', 'hover:bg-base-300');
					micBtn.setAttribute('aria-label', 'Speech-to-text not supported');
					micBtn.onclick = function() {
						alert('Speech-to-text is not supported in this browser. Please use Chrome, Edge, or Safari.');
					};
					return;
				}

				function startRecording() {
					recognition = new SpeechRecognition();
					recognition.continuous = true;
					recognition.interimResults = true;
					recognition.lang = navigator.language || 'en-US';

					finalTranscript = '';
					startPos = messageInput.selectionStart || messageInput.value.length;
					existingText = messageInput.value;
					initialValue = messageInput.value;
					manualStop = false;

					// Insert at cursor position or append
					prefix = existingText.substring(0, startPos);
					suffix = existingText.substring(startPos);
					if (prefix.length > 0 && !prefix.endsWith(' ') && !prefix.endsWith('\n')) {
						prefix += ' ';
					}

					recognition.onstart = function() {
						console.log('[STT] Recognition started');
						// Start audio analysis for silence detection
						startAudioAnalysis();
					};

					recognition.onresult = function(event) {
						var interimTranscript = '';
						for (var i = event.resultIndex; i < event.results.length; i++) {
							var transcript = event.results[i][0].transcript;
							if (event.results[i].isFinal) {
								finalTranscript += transcript + ' ';
							} else {
								interimTranscript += transcript;
							}
						}
						// Show interim + final results in the textarea
						messageInput.value = prefix + finalTranscript + interimTranscript + suffix;
						// Trigger input event for draft persistence
						messageInput.dispatchEvent(new Event('input', { bubbles: true }));
					};

					recognition.onerror = function(event) {
						if (event.error === 'not-allowed') {
							alert('Microphone access was denied. Please allow microphone access in your browser settings.');
						} else if (event.error === 'no-speech') {
							// Silence detected - this is normal, don't alert
						} else if (event.error !== 'aborted') {
							console.error('Speech recognition error:', event.error);
						}
						stopListening();
					};

					recognition.onend = function() {
						console.log('[STT] Recognition ended, manualStop=' + manualStop);
						// If continuous mode, restart unless manually stopped
						if (isRecording && !manualStop) {
							try {
								recognition.start();
							} catch (e) {
								console.error('[STT] Failed to restart recognition:', e);
								stopListening();
							}
						}
					};

					try {
						recognition.start();
						isRecording = true;
						micBtn.classList.add('stt-recording');
						micBtn.classList.remove('opacity-50');
						micBtn.setAttribute('aria-label', 'Stop recording');
						micBtn.title = 'Stop recording';
						if (micIcon) micIcon.classList.add('hidden');
						if (stopIcon) stopIcon.classList.remove('hidden');
					} catch (err) {
						console.error('Failed to start speech recognition:', err);
						alert('Failed to start speech recognition. Please try again.');
					}
				}

				function startAudioAnalysis() {
					if (audioContext) return;

					navigator.mediaDevices.getUserMedia({ audio: true })
						.then(function(stream) {
							audioStream = stream;
							audioContext = new (window.AudioContext || window.webkitAudioContext)();
							audioAnalyzer = audioContext.createAnalyser();
							audioAnalyzer.fftSize = 2048;

							var source = audioContext.createMediaStreamSource(stream);
							source.connect(audioAnalyzer);

							// Start monitoring audio levels
							monitorAudioLevel();
						})
						.catch(function(err) {
							console.error('[STT] Failed to start audio analysis:', err);
							// Don't stop voice recognition if audio analysis fails
						});
				}

				function monitorAudioLevel() {
					if (!audioAnalyzer || !isRecording) return;

					var bufferLength = audioAnalyzer.frequencyBinCount;
					var dataArray = new Uint8Array(bufferLength);

					var checkLevel = function() {
						if (!isRecording || !audioAnalyzer) return;

						audioAnalyzer.getByteFrequencyData(dataArray);

						// Calculate average volume
						var sum = dataArray.reduce(function(a, b) { return a + b; }, 0);
						audioLevel = sum / bufferLength;

						// Silence threshold: if volume is below 10 (very quiet)
						var isSilent = audioLevel < 10;

						if (isSilent) {
							// Start or continue silence timer
							if (!silenceTimer) {
								startSilenceTimer();
							}
						} else {
							// Reset silence timer if user is speaking
							clearSilenceTimer();
							clearCountdown();
						}

						// Continue monitoring
						requestAnimationFrame(checkLevel);
					};

					checkLevel();
				}

				function startSilenceTimer() {
					if (silenceTimer) return;

					console.log('[STT] Silence detected, starting timer...');

					// Start countdown visual feedback
					countdownSeconds = Math.ceil(silenceThreshold / 1000);
					startCountdown();

					silenceTimer = setTimeout(function() {
						console.log('[STT] Silence threshold reached, auto-submitting...');
						autoSubmitVoiceFeedback();
					}, silenceThreshold);
				}

				function clearSilenceTimer() {
					if (silenceTimer) {
						clearTimeout(silenceTimer);
						silenceTimer = null;
					}
				}

				function startCountdown() {
					clearCountdown();

					updateCountdownDisplay();

					countdownInterval = setInterval(function() {
						countdownSeconds--;
						if (countdownSeconds <= 0) {
							clearCountdown();
						} else {
							updateCountdownDisplay();
						}
					}, 1000);
				}

				function updateCountdownDisplay() {
					if (countdownSeconds > 0) {
						micBtn.title = 'Auto-send in ' + countdownSeconds + 's...';
					} else {
						micBtn.title = 'Recording...';
					}
				}

				function clearCountdown() {
					if (countdownInterval) {
						clearInterval(countdownInterval);
						countdownInterval = null;
					}
					countdownSeconds = 0;
					if (isRecording) {
						micBtn.title = 'Recording...';
					}
				}

				function stopAudioAnalysis() {
					if (audioContext) {
						audioContext.close();
						audioContext = null;
					}
					if (audioStream) {
						audioStream.getTracks().forEach(function(track) { track.stop(); });
						audioStream = null;
					}
					audioAnalyzer = null;
					audioLevel = 0;
				}

				function autoSubmitVoiceFeedback() {
					// Stop listening first
					stopListening();

					// Wait a moment for final transcript to be processed
					setTimeout(function() {
						// Submit the feedback if there's text
							if (messageInput.value.trim()) {
								safeSubmit();
							}					}, 500);
				}

				function stopListening() {
					isRecording = false;
					clearSilenceTimer();
					clearCountdown();
					stopAudioAnalysis();

					if (recognition) {
						try { recognition.stop(); } catch (e) { /* ignore */ }
						recognition = null;
					}

					micBtn.classList.remove('stt-recording');
					micBtn.classList.add('opacity-50');
					micBtn.setAttribute('aria-label', 'Start speech to text');
					micBtn.title = 'Speech to text';
					if (micIcon) micIcon.classList.remove('hidden');
					if (stopIcon) stopIcon.classList.add('hidden');
				}

				micBtn.addEventListener('click', function(e) {
					e.preventDefault();
					if (isRecording) {
						manualStop = true;
						stopListening();
					} else {
						startRecording();
					}
				});

				// Stop recording on form submit
				form.addEventListener('submit', function() {
					if (isRecording) {
						manualStop = true;
						stopListening();
					}
				});
			})();

					// Clear only the draft and attachment session accepted by this request.
					// A user may type or attach a steering update while an earlier send is still in flight.
					form.addEventListener('htmx:beforeRequest', function(event) {
						if (!event.detail || event.detail.elt !== form) return;
						var payload = form._chatNextSubmissionPayload || null;
						form._chatNextSubmissionPayload = null;
						var request = event.detail.xhr || {};
						request._chatSubmittedIntent = form.getAttribute('data-submit-intent') || 'normal';
						request._chatSubmittedWasQueued = request._chatSubmittedIntent === 'normal' && composerHasActiveTurn();
						if (request._chatSubmittedIntent === 'normal') normalRequestInFlight++;
								request._chatSubmittedMessage = payload ? payload.message : (messageInput ? messageInput.value : '');
								request._chatSubmittedAttachmentSession = payload ? payload.attachmentSessionID : (sessionInput ? sessionInput.value : '');
								request._chatSubmittedFallbackFromSteer = !!(payload && payload.fallbackFromSteer);					});

					form.addEventListener('htmx:afterRequest', function(event) {
						if (!event.detail || event.detail.elt !== form) return;
						var request = event.detail.xhr || {};
						var completedIntent = request._chatSubmittedIntent || 'normal';
						var submittedMessage = request._chatSubmittedMessage || '';
						var submittedAttachmentSession = request._chatSubmittedAttachmentSession || '';
						var accepted = false;
						var replayAsNormal = false;
						if (event.detail.successful) {
							var responseText = request.responseText || '';
							// Keep user draft intact when the handler intentionally returns no content
							// (e.g. model-setup guard toasts) so users don't lose their message.
							if (responseText.trim() !== '') {
								accepted = true;
								if (window.markChatSendScrollIntent) window.markChatSendScrollIntent(form);
								rememberSubmittedMessage(submittedMessage);
								resetMessageHistoryNavigation();
									if (messageInput && messageInput.value === submittedMessage) {
										messageInput.value = '';
										refreshPrimaryActionForInput();
									}
									if (sessionInput && sessionInput.value === submittedAttachmentSession && window[clearFuncName]) window[clearFuncName]();
								}
						} else if (completedIntent === 'steer' && !request._chatSubmittedFallbackFromSteer && submittedMessage.trim() !== '' && request.status === 409) {
							replayAsNormal = true;
							steerFallbackPending = true;
						}
						if (completedIntent === 'normal') normalRequestInFlight = Math.max(0, normalRequestInFlight - 1);
						if (completedIntent === 'normal' && !accepted) deferredSteer = null;
						form.setAttribute('hx-post', normalPostEndpoint);
						form.removeAttribute('data-submit-intent');
						if (accepted && deferredSteer) setTimeout(flushDeferredSteer, 0);
						if (completedIntent === 'normal' && request._chatSubmittedFallbackFromSteer) {
							steerFallbackPending = false;
							setTimeout(finishSteerRequest, 0);
						}
						if (replayAsNormal) {
							setTimeout(function() {
								submitComposer(normalPostEndpoint, 'normal', {
									message: submittedMessage,
									attachmentSessionID: submittedAttachmentSession,
									fallbackFromSteer: true
								});
							}, 0);
						}
					});		})();
	</script>
}

// ChatAutoScrollScript emits shared auto-scroll and transcript rendering/cleaning JS.
// Should be included once per page that uses chat components.
templ ChatAutoScrollScript() {
	<script>
		// Shared auto-scroll utility
		window.chatAutoScroll = {
			isNearBottom: function(element) {
				if (!element) return false;
				var threshold = 100;
				return element.scrollHeight - element.scrollTop - element.clientHeight <= threshold;
			},
			scrollToBottom: function(element, smooth) {
				if (!element) return;
				element.scrollTo({
					top: element.scrollHeight,
					behavior: smooth ? 'smooth' : 'auto'
				});
			},
			autoScrollIfNearBottom: function(element) {
				if (this.isNearBottom(element)) {
					this.scrollToBottom(element, true);
				}
			}
		};
			// Alias for backward compatibility (task thread used a separate namespace)
			window.threadAutoScroll = window.chatAutoScroll;

			// Large raw tool outputs are inserted cooperatively as adjacent text nodes.
			// Join those nodes before conversion so line matching and Markdown code
			// ranges are evaluated against the complete OUT text across chunk boundaries.
			window.normalizeTaskResultToolOutputTextNodes = function(messageElement) {
				if (!messageElement || !messageElement.querySelectorAll) return;
				var selector = messageElement.matches && messageElement.matches('.stream-tool-body-content')
					? 'pre'
					: '.stream-tool-body-content pre';
				messageElement.querySelectorAll(selector).forEach(function(pre) {
					if (pre.childNodes && pre.childNodes.length > 1 && pre.normalize) pre.normalize();
				});
			};

			// Convert task-creation result metadata to clickable links
			window.convertTaskLinksInMessage = function(messageElement) {
				window.normalizeTaskResultToolOutputTextNodes(messageElement);
				var walker = document.createTreeWalker(messageElement, NodeFilter.SHOW_TEXT, null);
				var nodesToProcess = [];
				var node;
				while (node = walker.nextNode()) {
					var parent = node.parentElement;
					var inCode = !!(parent && parent.closest && parent.closest('code, pre'));
					var inToolOutput = !!(parent && parent.closest && parent.closest('.stream-tool-body-content'));
					if (inCode && !inToolOutput) continue;
					if (node.textContent.includes('[TASK_ID:')) {
						nodesToProcess.push(node);
					}
				}

				nodesToProcess.forEach(function(textNode) {
						var regex = /(?:-[ \t]*)?"([^"\r\n]+)"[ \t]*(?:\(([^)\r\n]+)\)[ \t]*)?\[TASK_ID:([^\]\r\n]+)\]/g;
						var text = textNode.textContent;
						var inToolOutput = !!(textNode.parentElement && textNode.parentElement.closest && textNode.parentElement.closest('.stream-tool-body-content'));
						var inMarkdownFallback = !!(textNode.parentElement && textNode.parentElement.closest && textNode.parentElement.closest('[data-chat-markdown-fallback="true"]'));
						var matches = [];
						var m;
						while ((m = regex.exec(text)) !== null) {
							if (!m[3] || !m[3].trim()) continue;
							if ((inToolOutput || inMarkdownFallback) && window.isInsideCode && window.isInsideCode(text, m.index, m.index + m[0].length)) continue;
							matches.push(m);
						}
						if (matches.length === 0) return;

					var fragment = document.createDocumentFragment();
					var lastIndex = 0;

					matches.forEach(function(match) {
						var fullMatch = match[0], taskTitle = match[1], category = match[2], taskId = match[3];
						var encodedTaskId = encodeURIComponent(taskId.trim());
						var matchStart = match.index;
						if (matchStart > lastIndex) {
							var beforeText = text.substring(lastIndex, matchStart);
							// Strip trailing newline before the task item since the div provides its own line break
							beforeText = beforeText.replace(/\n$/, '');
							if (beforeText) {
								fragment.appendChild(document.createTextNode(beforeText));
							}
						}
						var linkWrapper = document.createElement('div');
						linkWrapper.style.cssText = 'display: flex; align-items: center; flex-wrap: wrap; gap: 0.5rem; padding: 0.25rem 0;';
						// Only add bullet if not already inside a list item (markdown renders - as <li>)
						var insideLi = textNode.parentNode && textNode.parentNode.nodeName === 'LI';
						if (!insideLi) {
							var bullet = document.createElement('span');
							bullet.textContent = '\u2022';
							bullet.style.opacity = '0.5';
							linkWrapper.appendChild(bullet);
						}
							var link = document.createElement('a');
							link.href = '/tasks/' + encodedTaskId;
							link.className = inToolOutput
								? 'ov-task-result-link ov-task-result-link--tool cursor-pointer'
								: 'ov-task-result-link cursor-pointer';
							link.textContent = taskTitle;
						link.onclick = function(e) {
							e.preventDefault();
							e.stopPropagation();
							window.openVibelyNavigate('/tasks/' + encodedTaskId + '?from=chat').catch(function(err) { console.error('[chat] Failed to load task detail:', err); });
						};
						linkWrapper.appendChild(link);
						if (category) {
							var catBadge = document.createElement('span');
							catBadge.className = 'badge badge-sm badge-ghost';
							catBadge.textContent = category;
							linkWrapper.appendChild(catBadge);
						}
						if (category && (category === 'backlog' || category === 'pending')) {
							var startBtn = document.createElement('button');
							startBtn.className = 'btn btn-xs ov-task-result-start-btn gap-1';
							startBtn.innerHTML = '<svg xmlns="http://www.w3.org/2000/svg" class="h-3 w-3" viewBox="0 0 20 20" fill="currentColor"><polygon points="6,4 16,10 6,16"/></svg> Start Task';
							startBtn.onclick = function(e) {
								e.preventDefault();
								e.stopPropagation();
								startBtn.disabled = true;
								startBtn.classList.add('btn-disabled');
								startBtn.innerHTML = '<span class="loading loading-spinner loading-xs"></span> Starting...';
								var formData = new URLSearchParams();
								formData.set('category', 'active');
								fetch('/tasks/' + encodedTaskId + '/category', {
									method: 'PATCH',
									headers: { 'Content-Type': 'application/x-www-form-urlencoded' },
									body: formData.toString()
								}).then(function(resp) {
									if (resp.ok) {
										startBtn.innerHTML = '<svg xmlns="http://www.w3.org/2000/svg" class="h-3 w-3" viewBox="0 0 20 20" fill="currentColor"><path fill-rule="evenodd" d="M16.707 5.293a1 1 0 010 1.414l-8 8a1 1 0 01-1.414 0l-4-4a1 1 0 011.414-1.414L8 12.586l7.293-7.293a1 1 0 011.414 0z" clip-rule="evenodd"/></svg> Started';
										startBtn.classList.remove('ov-task-result-start-btn');
										startBtn.classList.add('btn-success');
									} else {
										startBtn.innerHTML = 'Failed';
										startBtn.classList.remove('ov-task-result-start-btn');
										startBtn.classList.add('btn-error');
									}
								}).catch(function() {
									startBtn.innerHTML = 'Failed';
									startBtn.disabled = false;
									startBtn.classList.remove('btn-disabled', 'ov-task-result-start-btn');
									startBtn.classList.add('btn-error');
								});
							};
							linkWrapper.appendChild(startBtn);
						}
						fragment.appendChild(linkWrapper);
						lastIndex = matchStart + fullMatch.length;
					});

					if (lastIndex < text.length) {
						var remaining = text.substring(lastIndex);
						// Style "Attachments copied to tasks:" as a muted info line
						var attMatch = remaining.match(/\n*Attachments copied to tasks:\s*(.*)/);
						if (attMatch) {
							var beforeAtt = remaining.substring(0, remaining.indexOf('Attachments copied to tasks:'));
							if (beforeAtt.trim()) {
								fragment.appendChild(document.createTextNode(beforeAtt));
							}
							var attDiv = document.createElement('div');
							attDiv.className = 'text-xs opacity-60 mt-1';
							attDiv.innerHTML = '<svg xmlns="http://www.w3.org/2000/svg" class="h-3 w-3 inline-block mr-1 -mt-0.5" fill="none" viewBox="0 0 24 24" stroke="currentColor"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M15.172 7l-6.586 6.586a2 2 0 102.828 2.828l6.414-6.586a4 4 0 00-5.656-5.656l-6.415 6.585a6 6 0 108.486 8.486L20.5 13"/></svg>';
							attDiv.appendChild(document.createTextNode('Attachments copied: ' + attMatch[1]));
							fragment.appendChild(attDiv);
						} else {
							// Strip leading newline since divs provide their own line breaks
							remaining = remaining.replace(/^\n/, '');
							if (remaining) {
								fragment.appendChild(document.createTextNode(remaining));
							}
						}
					}
					textNode.parentNode.replaceChild(fragment, textNode);
				});
			};

			// Convert task-edit result metadata to clickable links
			window.convertTaskEditLinksInMessage = function(messageElement) {
				window.normalizeTaskResultToolOutputTextNodes(messageElement);
				var walker = document.createTreeWalker(messageElement, NodeFilter.SHOW_TEXT, null);
				var nodesToProcess = [];
				var node;
				while (node = walker.nextNode()) {
					var parent = node.parentElement;
					var inCode = !!(parent && parent.closest && parent.closest('code, pre'));
					var inToolOutput = !!(parent && parent.closest && parent.closest('.stream-tool-body-content'));
					if (inCode && !inToolOutput) continue;
					if (node.textContent.includes('[TASK_EDITED:')) {
						nodesToProcess.push(node);
					}
				}

				nodesToProcess.forEach(function(textNode) {
						var regex = /(?:-[ \t]*)?"([^"\r\n]+)"[ \t]*\(updated:[ \t]*([^)\r\n]+)\)[ \t]*\[TASK_EDITED:([^\]\r\n]+)\]/g;
						var text = textNode.textContent;
						var inToolOutput = !!(textNode.parentElement && textNode.parentElement.closest && textNode.parentElement.closest('.stream-tool-body-content'));
						var inMarkdownFallback = !!(textNode.parentElement && textNode.parentElement.closest && textNode.parentElement.closest('[data-chat-markdown-fallback="true"]'));
						var matches = [];
						var m;
						while ((m = regex.exec(text)) !== null) {
							if (!m[3] || !m[3].trim()) continue;
							if ((inToolOutput || inMarkdownFallback) && window.isInsideCode && window.isInsideCode(text, m.index, m.index + m[0].length)) continue;
							matches.push(m);
						}
						if (matches.length === 0) return;

					var fragment = document.createDocumentFragment();
					var lastIndex = 0;

					matches.forEach(function(match) {
						var fullMatch = match[0], taskTitle = match[1], updatedFields = match[2], taskId = match[3];
						var encodedTaskId = encodeURIComponent(taskId.trim());
						var matchStart = match.index;
						if (matchStart > lastIndex) {
							fragment.appendChild(document.createTextNode(text.substring(lastIndex, matchStart)));
						}
						var linkWrapper = document.createElement('span');
						linkWrapper.innerHTML = '- ';
							var link = document.createElement('a');
							link.href = '/tasks/' + encodedTaskId;
							link.className = inToolOutput
								? 'ov-task-result-link ov-task-result-link--tool cursor-pointer'
								: 'ov-task-result-link cursor-pointer';
							link.textContent = '"' + taskTitle + '"';
						link.onclick = function(e) {
							e.preventDefault();
							window.openVibelyNavigate('/tasks/' + encodedTaskId + '?from=chat');
						};
						linkWrapper.appendChild(link);
						linkWrapper.appendChild(document.createTextNode(' (updated: ' + updatedFields + ')'));
						fragment.appendChild(linkWrapper);
						lastIndex = matchStart + fullMatch.length;
					});

					if (lastIndex < text.length) {
						fragment.appendChild(document.createTextNode(text.substring(lastIndex)));
					}
					textNode.parentNode.replaceChild(fragment, textNode);
				});
			};

			window.hideMixtureProgress = function(execId) {
				if (!execId) return;
				var progress = document.getElementById('mixture-progress-' + execId);
				if (progress) progress.classList.add('hidden');
			};

			window.applyMixtureProgress = function(data) {
				if (!data || !data.exec_id) return false;
				var container = document.getElementById('streaming-message-' + data.exec_id);
				if (!container) return false;
				var progress = document.getElementById('mixture-progress-' + data.exec_id);
				if (!progress) {
					progress = document.createElement('div');
					progress.id = 'mixture-progress-' + data.exec_id;
					progress.className = 'mixture-progress hidden mb-2 text-xs opacity-70';
					progress.setAttribute('data-exec-id', data.exec_id);
					progress.setAttribute('role', 'status');
					progress.setAttribute('aria-live', 'polite');
					container.parentNode.insertBefore(progress, container);
				}
				var message = data.message || '';
				if (!message) return false;
				progress.textContent = message;
				progress.classList.remove('hidden');
				return true;
			};

			// ChatScrollTracker tracks whether the user has scrolled away from the bottom
		// using REAL user-interaction signals (wheel/touchmove/keydown/pointerdown).
		// This is critical for very large conversations during streaming because:
		//   - renderStreamingContent() replaces the response DOM as streaming grows.
		//     That can change scrollHeight; the browser clamps scrollTop and
		//     fires a scroll event. A naive "userScrolledUp = !isNearBottom" handler
		//     would interpret the clamp as the user being at the bottom and clear the
		//     scrolled-up flag, undoing the user's scroll-up on every chunk.
		//   - We must only clear userScrolledUp when the user themselves scrolls back
		//     to the bottom. Programmatic / clamp scrolls must not clear the flag.
		//
		// Implementation:
		//   - Interaction signals (wheel, touchmove, keydown of nav keys) mark a
		//     short-lived _userInteracting=true window (250ms).
		//   - Pointer/scrollbar drags stay active from pointerdown until
		//     pointerup/pointercancel/window blur so long scrollbar drags in huge
		//     conversations don't expire mid-drag.
		//   - scroll handler:
		//       user interaction + away from bottom    -> userScrolledUp = true
		//       user interaction + back at bottom      -> userScrolledUp = false
		//       not interacting                        -> preserve flag (don't trust)
		//   - shouldAutoScroll() returns !userScrolledUp. Do NOT AND with
		//     isNearBottom — during innerHTML refresh that creates a clamp-driven
		//     "yes auto-scroll" pulse that yanks the user back down.
			window._chatSendIntentScopeRevisions = window._chatSendIntentScopeRevisions || {};

			function chatSendIntentScopeRevisionKey(scope) {
				return 'scope:' + (scope || '');
			}

			window.getChatSendIntentScopeRevision = function(messagesId, scope) {
				var revisions = window._chatSendIntentScopeRevisions[messagesId] || {};
				return revisions[chatSendIntentScopeRevisionKey(scope)] || 0;
			};

			window.advanceChatSendIntentScopeRevision = function(messagesEl) {
				if (!messagesEl) return 0;
				var messagesId = messagesEl.id || '';
				var scope = messagesEl.getAttribute ? (messagesEl.getAttribute('data-scroll-intent-scope') || '') : '';
				var revisions = window._chatSendIntentScopeRevisions[messagesId] || {};
				var scopeKey = chatSendIntentScopeRevisionKey(scope);
				revisions[scopeKey] = (revisions[scopeKey] || 0) + 1;
				window._chatSendIntentScopeRevisions[messagesId] = revisions;
				return revisions[scopeKey];
			};

			window.ChatScrollTracker = function(element) {
				this.element = element;
				this.userScrolledUp = false;
				this.intentRevision = 0;
				this._userInteracting = false;
				this._pointerInteracting = false;
				this._userInteractTimeout = null;
				this._handlers = {};
				this._init();
			};

		window.ChatScrollTracker.prototype = {
				_init: function() {
					var self = this;
					if (!this.element) return;

					function markInteracting() {
						self._userInteracting = true;
						if (self._userInteractTimeout) clearTimeout(self._userInteractTimeout);
						self._userInteractTimeout = setTimeout(function() {
							if (!self._pointerInteracting) self._userInteracting = false;
						}, 250);
					}

				function endPointerInteraction() {
					self._pointerInteracting = false;
					if (self._userInteractTimeout) clearTimeout(self._userInteractTimeout);
					self._userInteractTimeout = setTimeout(function() {
						self._userInteracting = false;
					}, 250);
				}

					this._handlers.wheel = function(event) { markInteracting(event); };
					this._handlers.touchmove = function(event) { markInteracting(event); };
					this._handlers.pointerdown = function(event) {
						self._pointerInteracting = true;
						markInteracting(event);
					};
				this._handlers.pointerup = endPointerInteraction;
				this._handlers.pointercancel = endPointerInteraction;
				this._handlers.blur = endPointerInteraction;
				this._handlers.keydown = function(e) {
					// Treat scroll-navigation keys as user scroll intent.
					// Only count when focus is inside the scroll container or on body
					// (avoids triggering on textarea typing — typing doesn't scroll).
					var k = e.key;
					if (k === 'PageUp' || k === 'PageDown' || k === 'Home' || k === 'End' ||
						k === 'ArrowUp' || k === 'ArrowDown' || k === ' ' || k === 'Spacebar') {
						var t = e.target;
						if (t && (t.tagName === 'INPUT' || t.tagName === 'TEXTAREA' || t.isContentEditable)) return;
						markInteracting(e);
					}
				};

					this._handlers.scroll = function() {
						if (!self.element || !self.element.isConnected) return;
						var isNear = window.chatAutoScroll.isNearBottom(self.element);
						if (self._userInteracting) {
							window._chatScrollIntentRevision = (window._chatScrollIntentRevision || 0) + 1;
							if (window.advanceChatSendIntentScopeRevision) window.advanceChatSendIntentScopeRevision(self.element);
							self.userScrolledUp = !isNear;
							self.intentRevision = window._chatScrollIntentRevision;
							if (typeof self.onIntentChange === 'function') self.onIntentChange();
						}
						// Programmatic / clamp scrolls: PRESERVE the flag. Do not clear it
					// just because the viewport happens to be near the bottom after a
					// DOM refresh — that would defeat user scroll-up during streaming.
				};

				this.element.addEventListener('wheel', this._handlers.wheel, { passive: true });
