package components

import (
	"fmt"
	"github.com/openvibely/openvibely/internal/models"
	"strings"
)

func capitalize(s string) string {
	if s == "" {
		return s
	}
	return strings.ToUpper(s[:1]) + s[1:]
}

func filterByCategory(tasks []models.Task, cat models.TaskCategory) []models.Task {
	var result []models.Task
	for _, t := range tasks {
		if models.IsSwarmChildRole(t.SwarmRole) {
			continue
		}
		if boardCategory(t) == cat {
			result = append(result, t)
		}
	}
	return result
}

// filterActiveColumn returns tasks for the active column: all active-category tasks,
// scheduled-category tasks that are currently running, and scheduled Automation tasks
// whose occurrence is queued for worker capacity.
func filterActiveColumn(tasks []models.Task) []models.Task {
	var result []models.Task
	for _, t := range tasks {
		if models.IsSwarmChildRole(t.SwarmRole) {
			continue
		}
		if boardCategory(t) == models.CategoryActive {
			result = append(result, t)
		} else if boardCategory(t) == models.CategoryScheduled &&
			isAutomationTask(t) && (t.Status == models.StatusPending || t.Status == models.StatusQueued) {
			// Scheduled Automation tasks are normally managed on the Schedule page,
			// but a capacity-queued occurrence is runnable work and belongs in the
			// board's pending dropzone while it waits for worker admission.
			result = append(result, t)
		} else if boardCategory(t) == models.CategoryScheduled && t.Status == models.StatusRunning {
			result = append(result, t)
		}
	}
	return result
}

func isAutomationTask(task models.Task) bool {
	return task.AutomationCapacityQueued
}

func hasRunnableSwarmChild(task models.Task) bool {
	if task.SwarmRole != models.SwarmRoleParent {
		return false
	}
	for _, child := range task.SwarmChildren {
		switch child.Status {
		case models.StatusRunning, models.StatusPending, models.StatusQueued:
			return true
		}
	}
	return false
}

func boardCategory(task models.Task) models.TaskCategory {
	if task.SwarmRole == models.SwarmRoleParent && task.Category == models.CategoryActive && task.Status == models.StatusBlocked && !hasRunnableSwarmChild(task) {
		return models.CategoryBacklog
	}
	return task.Category
}

func activeBoardStatus(task models.Task) models.TaskStatus {
	if models.IsTerminalStatus(task.Status) {
		return task.Status
	}
	if hasRunnableSwarmChild(task) {
		return models.StatusRunning
	}
	return task.Status
}

func filterRunningTasks(tasks []models.Task) []models.Task {
	var running []models.Task
	for _, task := range tasks {
		if activeBoardStatus(task) == models.StatusRunning {
			running = append(running, task)
		}
	}
	return running
}

func filterPendingTasks(tasks []models.Task) []models.Task {
	var pending []models.Task
	for _, task := range tasks {
		// Include only genuinely active queued/pending work. Terminal failed/cancelled
		// tasks are normalized out of Active by finalization and should not render
		// under the Queued dropzone if a stale row still has category=active.
		switch activeBoardStatus(task) {
		case models.StatusPending, models.StatusQueued, models.StatusBlocked:
			pending = append(pending, task)
		}
	}
	return pending
}

func countActiveDisplayedTasks(tasks []models.Task) int {
	count := 0
	for _, task := range tasks {
		switch activeBoardStatus(task) {
		case models.StatusRunning, models.StatusPending, models.StatusQueued, models.StatusBlocked:
			count++
		}
	}
	return count
}

func countEligibleBacklogTasks(tasks []models.Task) int {
	count := 0
	for _, t := range tasks {
		if t.Status == models.StatusPending || t.Status == models.StatusFailed || t.Status == models.StatusCancelled {
			count++
		}
	}
	return count
}

func countEligibleBacklogByPriority(tasks []models.Task, priority int) int {
	count := 0
	for _, t := range tasks {
		if t.Priority == priority && (t.Status == models.StatusPending || t.Status == models.StatusFailed || t.Status == models.StatusCancelled) {
			count++
		}
	}
	return count
}

func hasEligibleBacklogTasks(tasks []models.Task) bool {
	return countEligibleBacklogTasks(tasks) > 0
}

func isSortActive(sortBy, option string) string {
	if sortBy == option {
		return "active font-semibold"
	}
	return ""
}

templ KanbanBoard(tasks []models.Task, projectID string, backlogSort string, completedSort string, llmModels []models.LLMConfig, agentDefs []models.Agent) {
	<div id="kanban-board" class="grid grid-cols-1 gap-4 h-full overflow-x-hidden overflow-y-auto md:grid-cols-2 lg:grid-cols-3 lg:overflow-y-hidden">
		for _, cat := range models.AllCategories {
			if cat == models.CategoryActive {
				@KanbanColumn(filterActiveColumn(tasks), projectID, cat, backlogSort, completedSort, llmModels, agentDefs)
			} else {
				@KanbanColumn(filterByCategory(tasks, cat), projectID, cat, backlogSort, completedSort, llmModels, agentDefs)
			}
		}
	</div>
}

templ KanbanColumn(tasks []models.Task, projectID string, category models.TaskCategory, backlogSort string, completedSort string, llmModels []models.LLMConfig, agentDefs []models.Agent) {
	<div class="kanban-column w-full min-w-0 bg-base-300 rounded-lg p-3 flex flex-col h-[60dvh] min-h-[24rem] lg:h-full lg:min-h-0">
		<div class="flex items-center justify-between mb-3 flex-shrink-0">
			<div class="flex items-center gap-2">
				<h3 class="font-bold text-lg">{ capitalize(string(category)) }</h3>
				if category == models.CategoryActive {
					<span class="badge badge-sm badge-ghost">{ fmt.Sprintf("%d", countActiveDisplayedTasks(tasks)) }</span>
				} else {
					<span class="badge badge-sm badge-ghost">{ fmt.Sprintf("%d", len(tasks)) }</span>
				}
			</div>
			if category == models.CategoryCompleted {
				<div class="dropdown dropdown-end" data-kanban-menu-key="column-completed">
					<label tabindex="0" class="btn btn-xs btn-ghost min-h-11 h-11 w-11 p-0" title="More actions" onclick="handleDropdownToggle(event)" data-kanban-menu-trigger aria-label="More actions" aria-expanded="false">
						<svg xmlns="http://www.w3.org/2000/svg" class="h-5 w-5" fill="none" viewBox="0 0 24 24" stroke="currentColor">
							<path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 5v.01M12 12v.01M12 19v.01M12 6a1 1 0 110-2 1 1 0 010 2zm0 7a1 1 0 110-2 1 1 0 010 2zm0 7a1 1 0 110-2 1 1 0 010 2z"></path>
						</svg>
					</label>
					<ul tabindex="0" class="dropdown-content menu p-2 shadow bg-base-100 rounded-box w-56 max-w-[calc(100vw-2rem)] z-[100]" data-kanban-menu-content>
						<li class="menu-title"><span>Sort By</span></li>
						<li>
							<button type="button" tabindex="0"
								hx-post={ fmt.Sprintf("/tasks/completed/sort?project_id=%s&sort=title_asc", projectID) }
								hx-target="#kanban-board"
								hx-swap="outerHTML"
								class={ "text-sm min-h-11", isSortActive(completedSort, "title_asc") }
							>
								<svg xmlns="http://www.w3.org/2000/svg" class="h-4 w-4" fill="none" viewBox="0 0 24 24" stroke="currentColor">
									<path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M3 4h13M3 8h9m-9 4h6m4 0l4-4m0 0l4 4m-4-4v12"></path>
								</svg>
								Name (A-Z)
							</button>
						</li>
						<li>
							<button type="button" tabindex="0"
								hx-post={ fmt.Sprintf("/tasks/completed/sort?project_id=%s&sort=title_desc", projectID) }
								hx-target="#kanban-board"
								hx-swap="outerHTML"
								class={ "text-sm min-h-11", isSortActive(completedSort, "title_desc") }
							>
								<svg xmlns="http://www.w3.org/2000/svg" class="h-4 w-4" fill="none" viewBox="0 0 24 24" stroke="currentColor">
									<path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M3 4h13M3 8h9m-9 4h6m4 0l4-4m0 0l4 4m-4-4v12"></path>
								</svg>
								Name (Z-A)
							</button>
						</li>
						<li class="border-t border-base-300 mt-1 pt-1">
							<button type="button" tabindex="0"
								hx-post={ fmt.Sprintf("/tasks/completed/sort?project_id=%s&sort=completed_desc", projectID) }
								hx-target="#kanban-board"
								hx-swap="outerHTML"
								class={ "text-sm min-h-11", isSortActive(completedSort, "completed_desc") }
							>
								<svg xmlns="http://www.w3.org/2000/svg" class="h-4 w-4" fill="none" viewBox="0 0 24 24" stroke="currentColor">
									<path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M8 7V3m8 4V3m-9 8h10M5 21h14a2 2 0 002-2V7a2 2 0 00-2-2H5a2 2 0 00-2 2v12a2 2 0 002 2z"></path>
								</svg>
								Date (Newest First)
							</button>
						</li>
						<li>
							<button type="button" tabindex="0"
								hx-post={ fmt.Sprintf("/tasks/completed/sort?project_id=%s&sort=completed_asc", projectID) }
								hx-target="#kanban-board"
								hx-swap="outerHTML"
								class={ "text-sm min-h-11", isSortActive(completedSort, "completed_asc") }
							>
								<svg xmlns="http://www.w3.org/2000/svg" class="h-4 w-4" fill="none" viewBox="0 0 24 24" stroke="currentColor">
									<path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M8 7V3m8 4V3m-9 8h10M5 21h14a2 2 0 002-2V7a2 2 0 00-2-2H5a2 2 0 00-2 2v12a2 2 0 002 2z"></path>
								</svg>
								Date (Oldest First)
							</button>
						</li>
						<li class="border-t border-base-300 mt-1 pt-1">
							<button type="button" tabindex="0"
								hx-post={ fmt.Sprintf("/tasks/completed/sort?project_id=%s&sort=priority_desc", projectID) }
								hx-target="#kanban-board"
								hx-swap="outerHTML"
								class={ "text-sm min-h-11", isSortActive(completedSort, "priority_desc") }
							>
								<svg xmlns="http://www.w3.org/2000/svg" class="h-4 w-4" fill="none" viewBox="0 0 24 24" stroke="currentColor">
									<path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M5 3v4M3 5h4M6 17v4m-2-2h4m5-16l2.286 6.857L21 12l-5.714 2.143L13 21l-2.286-6.857L5 12l5.714-2.143L13 3z"></path>
								</svg>
								Priority (High to Low)
							</button>
						</li>
						<li>
							<button type="button" tabindex="0"
								hx-post={ fmt.Sprintf("/tasks/completed/sort?project_id=%s&sort=priority_asc", projectID) }
								hx-target="#kanban-board"
								hx-swap="outerHTML"
								class={ "text-sm min-h-11", isSortActive(completedSort, "priority_asc") }
							>
								<svg xmlns="http://www.w3.org/2000/svg" class="h-4 w-4" fill="none" viewBox="0 0 24 24" stroke="currentColor">
									<path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M5 3v4M3 5h4M6 17v4m-2-2h4m5-16l2.286 6.857L21 12l-5.714 2.143L13 21l-2.286-6.857L5 12l5.714-2.143L13 3z"></path>
								</svg>
								Priority (Low to High)
							</button>
						</li>
						if len(tasks) > 0 {
							<li class="menu-title mt-2"><span>Actions</span></li>
							<li>
								<button
									type="button"
									data-delete-all-tasks-category="completed"
									data-delete-all-tasks-name="completed tasks"
									data-project-id={ projectID }
									aria-label="Delete all completed tasks"
									onclick="openDeleteAllTasksConfirm(this)"
									class="text-error min-h-11"
								>
									<svg xmlns="http://www.w3.org/2000/svg" class="h-4 w-4" fill="none" viewBox="0 0 24 24" stroke="currentColor">
										<path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M19 7l-.867 12.142A2 2 0 0116.138 21H7.862a2 2 0 01-1.995-1.858L5 7m5 4v6m4-6v6m1-10V4a1 1 0 00-1-1h-4a1 1 0 00-1 1v3M4 7h16"></path>
									</svg>
									Delete All
								</button>
							</li>
						}
					</ul>
				</div>
			}
			if category == models.CategoryBacklog {
				<div class="dropdown dropdown-end" data-kanban-menu-key="column-backlog">
					<label tabindex="0" class="btn btn-xs btn-ghost min-h-11 h-11 w-11 p-0" title="More actions" onclick="handleDropdownToggle(event)" data-kanban-menu-trigger aria-label="More actions" aria-expanded="false">
						<svg xmlns="http://www.w3.org/2000/svg" class="h-5 w-5" fill="none" viewBox="0 0 24 24" stroke="currentColor">
							<path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 5v.01M12 12v.01M12 19v.01M12 6a1 1 0 110-2 1 1 0 010 2zm0 7a1 1 0 110-2 1 1 0 010 2zm0 7a1 1 0 110-2 1 1 0 010 2z"></path>
						</svg>
					</label>
					<ul tabindex="0" class="dropdown-content menu p-2 shadow bg-base-100 rounded-box w-56 max-w-[calc(100vw-2rem)] z-[100]" data-kanban-menu-content>
						<li class="menu-title"><span>Sort By</span></li>
						<li>
							<button type="button" tabindex="0"
								hx-post={ fmt.Sprintf("/tasks/backlog/sort?project_id=%s&sort=title_asc", projectID) }
								hx-target="#kanban-board"
								hx-swap="outerHTML"
								class={ "text-sm min-h-11", isSortActive(backlogSort, "title_asc") }
							>
								<svg xmlns="http://www.w3.org/2000/svg" class="h-4 w-4" fill="none" viewBox="0 0 24 24" stroke="currentColor">
									<path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M3 4h13M3 8h9m-9 4h6m4 0l4-4m0 0l4 4m-4-4v12"></path>
								</svg>
								Name (A-Z)
							</button>
						</li>
						<li>
							<button type="button" tabindex="0"
								hx-post={ fmt.Sprintf("/tasks/backlog/sort?project_id=%s&sort=title_desc", projectID) }
								hx-target="#kanban-board"
								hx-swap="outerHTML"
								class={ "text-sm min-h-11", isSortActive(backlogSort, "title_desc") }
							>
								<svg xmlns="http://www.w3.org/2000/svg" class="h-4 w-4" fill="none" viewBox="0 0 24 24" stroke="currentColor">
									<path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M3 4h13M3 8h9m-9 4h6m4 0l4-4m0 0l4 4m-4-4v12"></path>
								</svg>
								Name (Z-A)
							</button>
						</li>
						<li class="border-t border-base-300 mt-1 pt-1">
							<button type="button" tabindex="0"
								hx-post={ fmt.Sprintf("/tasks/backlog/sort?project_id=%s&sort=created_desc", projectID) }
								hx-target="#kanban-board"
								hx-swap="outerHTML"
								class={ "text-sm min-h-11", isSortActive(backlogSort, "created_desc") }
							>
								<svg xmlns="http://www.w3.org/2000/svg" class="h-4 w-4" fill="none" viewBox="0 0 24 24" stroke="currentColor">
									<path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M8 7V3m8 4V3m-9 8h10M5 21h14a2 2 0 002-2V7a2 2 0 00-2-2H5a2 2 0 00-2 2v12a2 2 0 002 2z"></path>
								</svg>
								Date (Newest First)
							</button>
						</li>
						<li>
							<button type="button" tabindex="0"
								hx-post={ fmt.Sprintf("/tasks/backlog/sort?project_id=%s&sort=created_asc", projectID) }
								hx-target="#kanban-board"
								hx-swap="outerHTML"
								class={ "text-sm min-h-11", isSortActive(backlogSort, "created_asc") }
							>
								<svg xmlns="http://www.w3.org/2000/svg" class="h-4 w-4" fill="none" viewBox="0 0 24 24" stroke="currentColor">
									<path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M8 7V3m8 4V3m-9 8h10M5 21h14a2 2 0 002-2V7a2 2 0 00-2-2H5a2 2 0 00-2 2v12a2 2 0 002 2z"></path>
								</svg>
								Date (Oldest First)
							</button>
						</li>
						<li class="border-t border-base-300 mt-1 pt-1">
							<button type="button" tabindex="0"
								hx-post={ fmt.Sprintf("/tasks/backlog/sort?project_id=%s&sort=priority_desc", projectID) }
								hx-target="#kanban-board"
								hx-swap="outerHTML"
								class={ "text-sm min-h-11", isSortActive(backlogSort, "priority_desc") }
							>
								<svg xmlns="http://www.w3.org/2000/svg" class="h-4 w-4" fill="none" viewBox="0 0 24 24" stroke="currentColor">
									<path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M5 3v4M3 5h4M6 17v4m-2-2h4m5-16l2.286 6.857L21 12l-5.714 2.143L13 21l-2.286-6.857L5 12l5.714-2.143L13 3z"></path>
								</svg>
								Priority (High to Low)
							</button>
						</li>
						<li>
							<button type="button" tabindex="0"
								hx-post={ fmt.Sprintf("/tasks/backlog/sort?project_id=%s&sort=priority_asc", projectID) }
								hx-target="#kanban-board"
								hx-swap="outerHTML"
								class={ "text-sm min-h-11", isSortActive(backlogSort, "priority_asc") }
							>
								<svg xmlns="http://www.w3.org/2000/svg" class="h-4 w-4" fill="none" viewBox="0 0 24 24" stroke="currentColor">
									<path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M5 3v4M3 5h4M6 17v4m-2-2h4m5-16l2.286 6.857L21 12l-5.714 2.143L13 21l-2.286-6.857L5 12l5.714-2.143L13 3z"></path>
								</svg>
								Priority (Low to High)
							</button>
						</li>
						if len(tasks) > 0 {
							<li class="menu-title mt-2"><span>Actions</span></li>
							if hasEligibleBacklogTasks(tasks) {
								<li>
									<button type="button" tabindex="0"
										hx-post={ fmt.Sprintf("/tasks/backlog/execute?project_id=%s", projectID) }
										hx-target="#kanban-board"
										hx-swap="outerHTML"
										class="text-sm min-h-11"
									>
										<svg xmlns="http://www.w3.org/2000/svg" class="h-4 w-4" fill="none" viewBox="0 0 24 24" stroke="currentColor">
											<path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M14.752 11.168l-3.197-2.132A1 1 0 0010 9.87v4.263a1 1 0 001.555.832l3.197-2.132a1 1 0 000-1.664z"></path>
											<path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M21 12a9 9 0 11-18 0 9 9 0 0118 0z"></path>
										</svg>
										{ fmt.Sprintf("Execute All (%d)", countEligibleBacklogTasks(tasks)) }
									</button>
								</li>
								for _, priority := range []int{4, 3, 2, 1} {
									if count := countEligibleBacklogByPriority(tasks, priority); count > 0 {
										<li>
											<button type="button" tabindex="0"
												hx-post={ fmt.Sprintf("/tasks/backlog/execute?project_id=%s&priority=%d", projectID, priority) }
												hx-target="#kanban-board"
												hx-swap="outerHTML"
												hx-confirm={ fmt.Sprintf("Execute %d %s priority backlog tasks?", count, strings.ToLower(PriorityLabel(priority))) }
												class="text-sm pl-8 min-h-11"
											>
												{ fmt.Sprintf("Execute %s (%d)", PriorityLabel(priority), count) }
											</button>
										</li>
									}
								}
							}
							<li>
								<button
									type="button"
									data-delete-all-tasks-category="backlog"
									data-delete-all-tasks-name="backlog tasks"
									data-project-id={ projectID }
									aria-label="Delete all backlog tasks"
									onclick="openDeleteAllTasksConfirm(this)"
									class="text-error min-h-11"
								>
									<svg xmlns="http://www.w3.org/2000/svg" class="h-4 w-4" fill="none" viewBox="0 0 24 24" stroke="currentColor">
										<path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M19 7l-.867 12.142A2 2 0 0116.138 21H7.862a2 2 0 01-1.995-1.858L5 7m5 4v6m4-6v6m1-10V4a1 1 0 00-1-1h-4a1 1 0 00-1 1v3M4 7h16"></path>
									</svg>
									Delete All
								</button>
							</li>
						}
					</ul>
				</div>
			}
		</div>
		if category == models.CategoryActive {
			<div class="flex-1 flex flex-col min-h-0">
				@activeColumnContent(tasks, projectID, llmModels, agentDefs)
			</div>
		} else {
			<div
				class="category-drop-zone space-y-2 flex-1 rounded-lg border-2 border-dashed border-transparent transition-colors overflow-y-auto min-h-0"
				data-drop-type="category"
				data-category={ string(category) }
				data-project-id={ projectID }
			>
				if len(tasks) > 0 {
					for _, task := range tasks {
						@TaskCard(task, projectID, "", llmModels, agentDefs)
					}
				} else {
					<div class="text-center py-8 opacity-30 text-sm">Drop tasks here</div>
				}
			</div>
		}
	</div>
}

templ activeColumnContent(tasks []models.Task, projectID string, llmModels []models.LLMConfig, agentDefs []models.Agent) {
	<!-- In Progress -->
	<div class="mb-4 flex-1 flex flex-col min-h-0">
		<h4 class="text-sm font-semibold mb-2 text-primary flex-shrink-0">In Progress</h4>
		<div
			class="task-drop-zone category-drop-zone space-y-2 flex-1 rounded-lg border-2 border-dashed border-transparent transition-colors overflow-y-auto"
			data-drop-type="status"
			data-status="running"
			data-category="active"
			data-project-id={ projectID }
		>
			if len(filterRunningTasks(tasks)) > 0 {
				for _, task := range filterRunningTasks(tasks) {
					@TaskCard(task, projectID, "active", llmModels, agentDefs)
				}
			} else {
				<div class="text-center py-4 opacity-30 text-sm">Drop tasks here</div>
			}
		</div>
	</div>
	<!-- Queued (includes pending + completed/failed tasks awaiting auto-move) -->
	<div class="flex-1 flex flex-col min-h-0">
		<h4 class="text-sm font-semibold mb-2 flex-shrink-0">Queued</h4>
		<div
			class="task-drop-zone category-drop-zone space-y-2 flex-1 rounded-lg border-2 border-dashed border-transparent transition-colors overflow-y-auto"
			data-drop-type="status"
			data-status="pending"
			data-category="active"
			data-project-id={ projectID }
		>
			if len(filterPendingTasks(tasks)) > 0 {
				for _, task := range filterPendingTasks(tasks) {
					@TaskCard(task, projectID, "active", llmModels, agentDefs)
				}
			} else {
				<div class="text-center py-4 opacity-30 text-sm">Drop tasks here</div>
			}
		</div>
	</div>
}
