package components

import (
	"fmt"
	"github.com/openvibely/openvibely/internal/models"
	"github.com/openvibely/openvibely/internal/repository"
	"strings"
)

func capitalize(s string) string {
	if s == "" {
		return s
	}
	return strings.ToUpper(s[:1]) + s[1:]
}

func filterByCategory(tasks []models.Task, cat models.TaskCategory) []models.Task {
	var result []models.Task
	for _, t := range tasks {
		if models.IsSwarmChildRole(t.SwarmRole) {
			continue
		}
		if boardCategory(t) == cat {
			result = append(result, t)
		}
	}
	return result
}

// filterActiveColumn returns tasks for the active column: all active-category tasks,
// scheduled-category tasks that are currently running, and scheduled Automation tasks
// whose occurrence is queued for worker capacity.
func filterActiveColumn(tasks []models.Task) []models.Task {
	var result []models.Task
	for _, t := range tasks {
		if models.IsSwarmChildRole(t.SwarmRole) {
			continue
		}
		if boardCategory(t) == models.CategoryActive {
			result = append(result, t)
		} else if boardCategory(t) == models.CategoryScheduled &&
			isAutomationTask(t) && (t.Status == models.StatusPending || t.Status == models.StatusQueued) {
			// Scheduled Automation tasks are normally managed on the Schedule page,
			// but a capacity-queued occurrence is runnable work and belongs in the
			// board's pending dropzone while it waits for worker admission.
			result = append(result, t)
		} else if boardCategory(t) == models.CategoryScheduled && t.Status == models.StatusRunning {
			result = append(result, t)
		}
	}
	return result
}

func isAutomationTask(task models.Task) bool {
	return task.AutomationCapacityQueued
}

func hasRunnableSwarmChild(task models.Task) bool {
	if task.SwarmRole != models.SwarmRoleParent {
		return false
	}
	for _, child := range task.SwarmChildren {
		switch child.Status {
		case models.StatusRunning, models.StatusPending, models.StatusQueued:
			return true
		}
	}
	return false
}

func boardCategory(task models.Task) models.TaskCategory {
	if task.SwarmRole == models.SwarmRoleParent && task.Category == models.CategoryActive && task.Status == models.StatusBlocked && !hasRunnableSwarmChild(task) {
		return models.CategoryBacklog
	}
	return task.Category
}

func activeBoardStatus(task models.Task) models.TaskStatus {
	if models.IsTerminalStatus(task.Status) {
		return task.Status
	}
	if task.WorkerCapacityQueued {
		return models.StatusQueued
	}
	if hasRunnableSwarmChild(task) {
		return models.StatusRunning
	}
	return task.Status
}

func filterRunningTasks(tasks []models.Task) []models.Task {
	var running []models.Task
	for _, task := range tasks {
		if activeBoardStatus(task) == models.StatusRunning {
			running = append(running, task)
		}
	}
	return running
}

func filterPendingTasks(tasks []models.Task) []models.Task {
	var pending []models.Task
	for _, task := range tasks {
		// Include only genuinely active queued/pending work. Terminal failed/cancelled
		// tasks are normalized out of Active by finalization and should not render
		// under the Queued dropzone if a stale row still has category=active.
		switch activeBoardStatus(task) {
		case models.StatusPending, models.StatusQueued, models.StatusBlocked:
			pending = append(pending, task)
		}
	}
	return pending
}

func countActiveDisplayedTasks(tasks []models.Task) int {
	count := 0
	for _, task := range tasks {
		switch activeBoardStatus(task) {
		case models.StatusRunning, models.StatusPending, models.StatusQueued, models.StatusBlocked:
			count++
		}
	}
	return count
}

func countEligibleBacklogTasks(tasks []models.Task) int {
	count := 0
	for _, t := range tasks {
		if t.Status == models.StatusPending || t.Status == models.StatusFailed || t.Status == models.StatusCancelled {
			count++
		}
	}
	return count
}

func countEligibleBacklogByPriority(tasks []models.Task, priority int) int {
	count := 0
	for _, t := range tasks {
		if t.Priority == priority && (t.Status == models.StatusPending || t.Status == models.StatusFailed || t.Status == models.StatusCancelled) {
			count++
		}
	}
	return count
}

func hasEligibleBacklogTasks(tasks []models.Task) bool {
	return countEligibleBacklogTasks(tasks) > 0
}

func isSortActive(sortBy, option string) string {
	if sortBy == option {
		return "whitespace-nowrap active font-semibold"
	}
	return "whitespace-nowrap"
}

templ KanbanBoard(tasks []models.Task, projectID string, backlogSort string, completedSort string, llmModels []models.LLMConfig, agentDefs []repository.AgentTaskUIOption, menuStates ...map[string]TaskCardMergeMenuState) {
	<div id="kanban-board" class="grid grid-cols-1 gap-4 h-full overflow-x-hidden overflow-y-auto md:grid-cols-2 lg:grid-cols-3 lg:overflow-y-hidden">
		for _, cat := range models.AllCategories {
			if cat == models.CategoryActive {
				@KanbanColumn(filterActiveColumn(tasks), projectID, cat, backlogSort, completedSort, llmModels, agentDefs, taskCardMergeMenuStateMap(menuStates))
			} else {
				@KanbanColumn(filterByCategory(tasks, cat), projectID, cat, backlogSort, completedSort, llmModels, agentDefs, taskCardMergeMenuStateMap(menuStates))
			}
		}
	</div>
}

templ KanbanColumn(tasks []models.Task, projectID string, category models.TaskCategory, backlogSort string, completedSort string, llmModels []models.LLMConfig, agentDefs []repository.AgentTaskUIOption, menuStates ...map[string]TaskCardMergeMenuState) {
	<div data-kanban-category={ string(category) } data-project-id={ projectID } class="kanban-column w-full min-w-0 bg-base-300 rounded-lg p-3 flex flex-col h-[60dvh] min-h-[24rem] lg:h-full lg:min-h-0">
		<div class="flex items-center justify-between mb-3 flex-shrink-0 h-11 min-h-11">
			<div class="flex items-center gap-2">
				<h3 class="font-bold text-lg">{ capitalize(string(category)) }</h3>
				if category == models.CategoryActive {
					<span class="badge badge-sm badge-ghost">{ fmt.Sprintf("%d", countActiveDisplayedTasks(tasks)) }</span>
				} else {
					<span data-kanban-count class="badge badge-sm badge-ghost">{ fmt.Sprintf("%d", len(tasks)) }</span>
				}
			</div>
			<div class="flex items-center gap-2">
				if category != models.CategoryActive {
					<button type="button" class="btn btn-xs btn-ghost hidden" data-kanban-clear data-kanban-filter="clear" data-column={ string(category) } onclick="kanbanSetFilter(this)"><span aria-hidden="true">×</span> Clear filters</button>
				}
				if category != models.CategoryActive || countActiveDisplayedTasks(tasks) > 0 {
					@KanbanColumnMenu(projectID, category, backlogSort, completedSort, len(tasks) > 0)
				}
			</div>

		</div>
		<div data-kanban-progress class="text-sm mb-2" aria-live="polite"></div>
		if category == models.CategoryActive {
			<div class="flex-1 flex flex-col min-h-0">
				@activeColumnContent(tasks, projectID, llmModels, agentDefs, taskCardMergeMenuStateMap(menuStates))
			</div>
		} else {
			<div
				class="category-drop-zone space-y-2 flex-1 rounded-lg border-2 border-dashed border-transparent transition-colors overflow-y-auto min-h-0"
				data-drop-type="category"
				data-category={ string(category) }
				data-project-id={ projectID }
			>
				if len(tasks) > 0 {
					for _, task := range tasks {
						@TaskCard(task, projectID, "", llmModels, agentDefs, taskCardMergeMenuStateMap(menuStates))
					}
				} else {
					<div class="text-center py-8 opacity-30 text-sm">Drop tasks here</div>
				}
			</div>
		}
	</div>
}

templ activeColumnContent(tasks []models.Task, projectID string, llmModels []models.LLMConfig, agentDefs []repository.AgentTaskUIOption, menuStates ...map[string]TaskCardMergeMenuState) {
	<style>
		.kanban-queue { flex:0 1 auto; min-height:44px; max-height:calc(50% - 8px); }
		.kanban-queue > .task-drop-zone { flex:0 1 auto; min-height:0; }
		.kanban-queue:not(:has([data-task-id])) { display:none; }
	</style>
	<!-- In Progress -->
	<div class="mb-4 flex-1 flex flex-col min-h-0">
		<h4 class="text-sm font-semibold mb-2 text-primary flex-shrink-0">In Progress</h4>
		<div
			class="task-drop-zone category-drop-zone space-y-2 flex-1 rounded-lg border-2 border-dashed border-transparent transition-colors overflow-y-auto"
			data-drop-type="status"
			data-status="running"
			data-category="active"
			data-project-id={ projectID }
		>
			if len(filterRunningTasks(tasks)) > 0 {
				for _, task := range filterRunningTasks(tasks) {
					@TaskCard(task, projectID, "active", llmModels, agentDefs, taskCardMergeMenuStateMap(menuStates))
				}
			} else {
				<div class="text-center py-4 opacity-30 text-sm">Drop tasks here</div>
			}
		</div>
	</div>
	<!-- Queued (includes pending + completed/failed tasks awaiting auto-move) -->
	<div class="kanban-queue flex flex-col">
		<h4 class="text-sm font-semibold mb-2 flex-shrink-0">Queued</h4>
		<div
			class="task-drop-zone category-drop-zone space-y-2 flex-1 rounded-lg border-2 border-dashed border-transparent transition-colors overflow-y-auto"
			data-drop-type="status"
			data-status="pending"
			data-category="active"
			data-project-id={ projectID }
		>
			if len(filterPendingTasks(tasks)) > 0 {
				for _, task := range filterPendingTasks(tasks) {
					@TaskCard(task, projectID, "active", llmModels, agentDefs, taskCardMergeMenuStateMap(menuStates))
				}
			}
		</div>
	</div>
}
