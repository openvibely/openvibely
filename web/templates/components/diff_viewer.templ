package components

import (
	"fmt"
	"path/filepath"
	"strconv"
	"strings"

	"github.com/openvibely/openvibely/internal/models"
)

// DiffFile represents a single file's diff.
//
// Status describes the high-level change kind:
//   - "added"     : file was created in this diff
//   - "deleted"   : file was removed in this diff
//   - "renamed"   : file was moved/renamed (OldPath != Path)
//   - "copied"    : file was copied
//   - "modified"  : file was modified in place (default fallback)
//
// IsBinary is true when git reported the change as a binary diff
// ("Binary files ... differ"). Such files have no textual hunks.
//
// SimilarityIndex captures the percent value from a "similarity index N%"
// header line (0 when not present). A pure rename with no content change has
// SimilarityIndex == 100 and no hunks; the UI surfaces this explicitly
// instead of rendering an empty hunk table.
type DiffFile struct {
	Path            string
	OldPath         string
	Hunks           []DiffHunk
	Status          string
	IsBinary        bool
	SimilarityIndex int
}

// DiffHunk represents a contiguous chunk of changes
type DiffHunk struct {
	Header string
	Lines  []DiffLine
}

// DiffLine represents a single line in the diff
type DiffLine struct {
	Type    string // "add", "del", "ctx" (context)
	Content string
	OldNum  int
	NewNum  int
}

const (
	// Diff rendering load limits.
	maxDiffFiles              = 300
	maxLoadableTotalDiffLines = 20000
	maxLoadableTotalDiffChars = 1 * 1024 * 1024
	maxLoadableFileDiffLines  = 20000
	maxLoadableFileDiffChars  = 500 * 1024
	autoLoadFileDiffLines     = 400
	autoLoadFileDiffChars     = 20 * 1024
)

func normalizeDiffViewMode(view string) string {
	if strings.TrimSpace(view) == "split" {
		return "split"
	}
	return "inline"
}

func diffViewButtonClass(mode string, activeView string) string {
	classes := "btn btn-sm join-item"
	if normalizeDiffViewMode(activeView) == mode {
		classes += " btn-active"
	}
	return classes
}

func diffViewContentClass(mode string, activeView string) string {
	classes := "space-y-4"
	if normalizeDiffViewMode(activeView) != mode {
		classes += " hidden"
	}
	return classes
}


// DiffFileRenderMeta controls how a file should render under diff limits.
type DiffFileRenderMeta struct {
	Index           int
	File            DiffFile
	LineCount       int
	CharCount       int
	AutoLoad        bool
	CanLoadOnDemand bool
	BlockedReason   string
}

// ParseDiffOutput parses unified diff output into structured DiffFile data.
//
// The parser recognizes Git's extended file-header lines so that moved,
// renamed, copied, added, deleted, and binary files are classified
// explicitly and surfaced to the UI even when they contain no textual
// hunks (for example a pure rename with similarity index 100%).
func ParseDiffOutput(diffOutput string) []DiffFile {
	if diffOutput == "" {
		return nil
	}

	var files []DiffFile
	lines := strings.Split(diffOutput, "\n")
	var currentFile *DiffFile
	var currentHunk *DiffHunk
	oldLine, newLine := 0, 0

	for i := 0; i < len(lines); i++ {
		line := lines[i]

		// File header: diff --git a/path b/path
		if strings.HasPrefix(line, "diff --git ") {
			if currentFile != nil {
				if currentHunk != nil {
					currentFile.Hunks = append(currentFile.Hunks, *currentHunk)
					currentHunk = nil
				}
				files = append(files, *currentFile)
			}
			oldPath, newPath := parseDiffGitHeader(line)
			currentFile = &DiffFile{
				Path:    newPath,
				OldPath: oldPath,
				Status:  "modified",
			}
			continue
		}

		// Old file path
		if strings.HasPrefix(line, "--- ") {
			if currentFile != nil {
				old := parseGitPath(strings.TrimPrefix(line, "--- "), "a/")
				if old == "/dev/null" {
					currentFile.Status = "added"
					currentFile.OldPath = ""
				} else {
					currentFile.OldPath = old
				}
			}
			continue
		}

		// New file path
		if strings.HasPrefix(line, "+++ ") {
			if currentFile != nil {
				newPath := parseGitPath(strings.TrimPrefix(line, "+++ "), "b/")
				if newPath == "/dev/null" {
					currentFile.Status = "deleted"
					// Preserve currentFile.Path (which was set from "b/path"
					// or from "rename from"/"--- a/..." parsing) so the
					// deleted file's name is still shown in the UI.
				} else {
					currentFile.Path = newPath
				}
			}
			continue
		}

		// Hunk header: @@ -old,count +new,count @@
		if strings.HasPrefix(line, "@@") {
			if currentHunk != nil && currentFile != nil {
				currentFile.Hunks = append(currentFile.Hunks, *currentHunk)
			}
			currentHunk = &DiffHunk{Header: line}
			// Parse line numbers from hunk header
			oldLine, newLine = parseHunkHeader(line)
			continue
		}

		// Extended file-header lines (no hunk content).
		if currentFile != nil && currentHunk == nil {
			switch {
			case strings.HasPrefix(line, "new file mode"):
				currentFile.Status = "added"
				continue
			case strings.HasPrefix(line, "deleted file mode"):
				currentFile.Status = "deleted"
				continue
			case strings.HasPrefix(line, "rename from "):
				currentFile.Status = "renamed"
				currentFile.OldPath = parseGitPath(strings.TrimPrefix(line, "rename from "), "")
				continue
			case strings.HasPrefix(line, "rename to "):
				currentFile.Status = "renamed"
				currentFile.Path = parseGitPath(strings.TrimPrefix(line, "rename to "), "")
				continue
			case strings.HasPrefix(line, "copy from "):
				currentFile.Status = "copied"
				currentFile.OldPath = parseGitPath(strings.TrimPrefix(line, "copy from "), "")
				continue
			case strings.HasPrefix(line, "copy to "):
				currentFile.Status = "copied"
				currentFile.Path = parseGitPath(strings.TrimPrefix(line, "copy to "), "")
				continue
			case strings.HasPrefix(line, "similarity index "):
				sim := strings.TrimPrefix(line, "similarity index ")
				sim = strings.TrimSuffix(strings.TrimSpace(sim), "%")
				var v int
				if _, err := fmt.Sscanf(sim, "%d", &v); err == nil {
					currentFile.SimilarityIndex = v
				}
				continue
			case strings.HasPrefix(line, "dissimilarity index "):
				continue
			case strings.HasPrefix(line, "Binary files"):
				currentFile.IsBinary = true
				// Refine status from "/dev/null" markers when present.
				// Examples:
				//   "Binary files /dev/null and b/x differ"   -> added
				//   "Binary files a/x and /dev/null differ"   -> deleted
				rest := strings.TrimPrefix(line, "Binary files ")
				if strings.HasPrefix(rest, "/dev/null") {
					currentFile.Status = "added"
				} else if strings.Contains(rest, "and /dev/null differ") {
					currentFile.Status = "deleted"
				}
				continue
			}
		}

		// Skip binary file notices, index lines, mode lines inside hunks too.
		if strings.HasPrefix(line, "index ") ||
			strings.HasPrefix(line, "new file") ||
			strings.HasPrefix(line, "deleted file") ||
			strings.HasPrefix(line, "old mode") ||
			strings.HasPrefix(line, "new mode") ||
			strings.HasPrefix(line, "Binary files") ||
			strings.HasPrefix(line, "# Untracked") ||
			strings.HasPrefix(line, "# + ") {
			continue
		}

		// Some fallback diff sources may omit hunk headers; synthesize one so content
		// lines still render instead of producing an empty table.
		if currentHunk == nil {
			if currentFile == nil {
				continue
			}
			if strings.HasPrefix(line, "+") || strings.HasPrefix(line, "-") || strings.HasPrefix(line, " ") {
				currentHunk = &DiffHunk{Header: "@@ (no explicit hunk header) @@"}
			} else {
				continue
			}
		}

		// Diff content lines
		if strings.HasPrefix(line, "+") {
			currentHunk.Lines = append(currentHunk.Lines, DiffLine{
				Type:    "add",
				Content: line[1:],
				OldNum:  0,
				NewNum:  newLine,
			})
			newLine++
		} else if strings.HasPrefix(line, "-") {
			currentHunk.Lines = append(currentHunk.Lines, DiffLine{
				Type:    "del",
				Content: line[1:],
				OldNum:  oldLine,
				NewNum:  0,
			})
			oldLine++
		} else if strings.HasPrefix(line, " ") || line == "" {
			content := ""
			if len(line) > 0 {
				content = line[1:]
			}
			currentHunk.Lines = append(currentHunk.Lines, DiffLine{
				Type:    "ctx",
				Content: content,
				OldNum:  oldLine,
				NewNum:  newLine,
			})
			oldLine++
			newLine++
		} else if line == `\ No newline at end of file` {
			continue
		}
	}

	// Finalize last file/hunk
	if currentFile != nil {
		if currentHunk != nil {
			currentFile.Hunks = append(currentFile.Hunks, *currentHunk)
		}
		files = append(files, *currentFile)
	}

	return files
}

// parseDiffGitHeader extracts old and new paths from a "diff --git a/X b/Y"
// header line. It also handles Git's quoted path form, e.g.
// `diff --git "a/old\tname" "b/new\tname"`.
func parseDiffGitHeader(line string) (oldPath, newPath string) {
	rest := strings.TrimPrefix(line, "diff --git ")
	parts, ok := splitDiffGitPaths(rest)
	if !ok {
		return "", rest
	}
	return parseGitPath(parts[0], "a/"), parseGitPath(parts[1], "b/")
}

func splitDiffGitPaths(rest string) ([2]string, bool) {
	var parts [2]string
	if strings.HasPrefix(rest, "\"") {
		first, tail, ok := scanQuotedGitPath(rest)
		if !ok {
			return parts, false
		}
		second, tail, ok := scanQuotedGitPath(strings.TrimLeft(tail, " "))
		if !ok || strings.TrimSpace(tail) != "" {
			return parts, false
		}
		parts[0], parts[1] = first, second
		return parts, true
	}

	pieces := strings.SplitN(rest, " b/", 2)
	if len(pieces) != 2 {
		return parts, false
	}
	parts[0], parts[1] = pieces[0], "b/"+pieces[1]
	return parts, true
}

func scanQuotedGitPath(s string) (path string, rest string, ok bool) {
	quoted, err := strconv.QuotedPrefix(s)
	if err != nil {
		return "", "", false
	}
	path, err = strconv.Unquote(quoted)
	if err != nil {
		return "", "", false
	}
	return path, s[len(quoted):], true
}

func parseGitPath(path string, prefix string) string {
	path = strings.TrimSpace(path)
	if strings.HasPrefix(path, "\"") {
		if unquoted, err := strconv.Unquote(path); err == nil {
			path = unquoted
		}
	}
	return strings.TrimPrefix(path, prefix)
}

func parseHunkHeader(header string) (int, int) {
	// @@ -old,count +new,count @@ optional context
	oldStart, newStart := 1, 1
	header = strings.TrimPrefix(header, "@@")
	end := strings.Index(header[1:], "@@")
	if end == -1 {
		return 1, 1
	}
	header = strings.TrimSpace(header[:end+1])
	parts := strings.Fields(header)
	for _, p := range parts {
		if strings.HasPrefix(p, "-") {
			nums := strings.SplitN(p[1:], ",", 2)
			fmt.Sscanf(nums[0], "%d", &oldStart)
		} else if strings.HasPrefix(p, "+") {
			nums := strings.SplitN(p[1:], ",", 2)
			fmt.Sscanf(nums[0], "%d", &newStart)
		}
	}
	return oldStart, newStart
}

func fileExtension(path string) string {
	ext := filepath.Ext(path)
	if ext != "" {
		return ext[1:] // strip leading dot
	}
	return ""
}

func langClass(path string) string {
	ext := fileExtension(path)
	switch ext {
	case "go":
		return "language-go"
	case "js":
		return "language-javascript"
	case "ts":
		return "language-typescript"
	case "tsx":
		return "language-tsx"
	case "jsx":
		return "language-jsx"
	case "py":
		return "language-python"
	case "rs":
		return "language-rust"
	case "rb":
		return "language-ruby"
	case "java":
		return "language-java"
	case "css":
		return "language-css"
	case "html", "templ":
		return "language-html"
	case "sql":
		return "language-sql"
	case "json":
		return "language-json"
	case "yaml", "yml":
		return "language-yaml"
	case "md":
		return "language-markdown"
	case "sh", "bash":
		return "language-bash"
	default:
		return "language-plaintext"
	}
}

templ DiffViewer(diffOutput string) {
	@DiffViewerWithView(diffOutput, "inline")
}

templ DiffViewerWithView(diffOutput string, initialView string) {
	if diffOutput == "" {
		<div class="flex flex-col items-center justify-center py-16 text-base-content/50">
			<svg xmlns="http://www.w3.org/2000/svg" class="h-16 w-16 mb-4 opacity-30" fill="none" viewBox="0 0 24 24" stroke="currentColor">
				<path stroke-linecap="round" stroke-linejoin="round" stroke-width="1.5" d="M9 12h6m-6 4h6m2 5H7a2 2 0 01-2-2V5a2 2 0 012-2h5.586a1 1 0 01.707.293l5.414 5.414a1 1 0 01.293.707V19a2 2 0 01-2 2z"></path>
			</svg>
			<p class="text-lg font-medium">No changes detected</p>
			<p class="text-sm mt-1">No files were modified during this execution.</p>
		</div>
	} else {
		@diffViewerContent(buildDiffRenderMetas(ParseDiffOutput(diffOutput)), initialView)
	}
}

// DiffViewerWithReview renders the diff viewer with inline code review support.
templ DiffViewerWithReview(diffOutput string, taskID string, reviewComments []models.ReviewComment) {
	@DiffViewerWithReviewView(diffOutput, taskID, reviewComments, "inline")
}

templ DiffViewerWithReviewView(diffOutput string, taskID string, reviewComments []models.ReviewComment, initialView string) {
	if diffOutput == "" {
		<div class="flex flex-col items-center justify-center py-16 text-base-content/50">
			<svg xmlns="http://www.w3.org/2000/svg" class="h-16 w-16 mb-4 opacity-30" fill="none" viewBox="0 0 24 24" stroke="currentColor">
				<path stroke-linecap="round" stroke-linejoin="round" stroke-width="1.5" d="M9 12h6m-6 4h6m2 5H7a2 2 0 01-2-2V5a2 2 0 012-2h5.586a1 1 0 01.707.293l5.414 5.414a1 1 0 01.293.707V19a2 2 0 01-2 2z"></path>
			</svg>
			<p class="text-lg font-medium">No changes detected</p>
			<p class="text-sm mt-1">No files were modified during this execution.</p>
		</div>
	} else {
		@diffViewerWithReviewContent(buildDiffRenderMetas(ParseDiffOutput(diffOutput)), taskID, reviewComments, initialView)
	}
}

// commentKey generates a unique key for looking up comments by file+line+type
func commentKey(filePath string, lineNum int, lineType string) string {
	return fmt.Sprintf("%s:%d:%s", filePath, lineNum, lineType)
}

// buildCommentMap creates a lookup map from review comments
func buildCommentMap(comments []models.ReviewComment) map[string][]models.ReviewComment {
	m := make(map[string][]models.ReviewComment)
	for _, c := range comments {
		key := commentKey(c.FilePath, c.LineNumber, c.LineType)
		m[key] = append(m[key], c)
	}
	return m
}

type reviewLineTarget struct {
	LineNumber int
	LineType   string
	CanComment bool
}

// reviewTargetForDiffLine maps a visible diff line to the persisted review-comment target.
func reviewTargetForDiffLine(line DiffLine) reviewLineTarget {
	target := reviewLineTarget{
		LineNumber: line.NewNum,
		LineType:   "new",
	}
	if line.Type == "del" {
		target.LineNumber = line.OldNum
		target.LineType = "old"
	} else if line.Type == "ctx" {
		target.LineType = "ctx"
	}
	target.CanComment = target.LineNumber != 0
	return target
}

func (target reviewLineTarget) commentKey(filePath string) string {
	return commentKey(filePath, target.LineNumber, target.LineType)
}

// lineHasComment checks if a specific line has review comments
func lineHasComment(commentMap map[string][]models.ReviewComment, filePath string, line DiffLine) bool {
	target := reviewTargetForDiffLine(line)
	if !target.CanComment {
		return false
	}
	_, ok := commentMap[target.commentKey(filePath)]
	return ok
}

// getLineComments returns comments for a specific line
func getLineComments(commentMap map[string][]models.ReviewComment, filePath string, line DiffLine) []models.ReviewComment {
	target := reviewTargetForDiffLine(line)
	if !target.CanComment {
		return nil
	}
	return commentMap[target.commentKey(filePath)]
}

// lineTypeForDiff maps diff line type to review line type
func lineTypeForDiff(diffType string) string {
	return reviewTargetForDiffLine(DiffLine{Type: diffType, OldNum: 1, NewNum: 1}).LineType
}

// lineNumForReview returns the appropriate line number for a review comment
func lineNumForReview(line DiffLine) int {
	return reviewTargetForDiffLine(line).LineNumber
}

templ diffViewerWithReviewContent(metas []DiffFileRenderMeta, taskID string, reviewComments []models.ReviewComment, initialView string) {
	<div id="diff-viewer" class="flex flex-col h-full" data-file-count={ fmt.Sprintf("%d", len(metas)) } data-task-id={ taskID } data-state-key={ diffViewerStateKey(metas, taskID) } data-initial-view={ normalizeDiffViewMode(initialView) }>
		<!-- Toolbar -->
		<div class="flex flex-wrap items-center gap-2 mb-4">
			<div class="flex items-center gap-2 flex-1">
				<span class="text-sm font-medium opacity-70">
					{ fmt.Sprintf("%d", len(metas)) } file{ fileCountSuffix(len(metas)) } changed
				</span>
				if len(metas) > 1 {
					<button
						class="btn btn-xs btn-ghost opacity-60"
						onclick="toggleAllDiffFiles(true)"
					>
						Expand All
					</button>
					<button
						class="btn btn-xs btn-ghost opacity-60"
						onclick="toggleAllDiffFiles(false)"
					>
						Collapse All
					</button>
				}
			</div>
			<div class="flex flex-wrap items-center gap-2 ml-auto">
				@ReviewToolbar(taskID, len(reviewComments))
				<div class="join">
					<button
						class={ diffViewButtonClass("inline", initialView) }
						id="diff-btn-inline"
						onclick="switchDiffView('inline')"
					>
						Inline
					</button>
					<button
						class={ diffViewButtonClass("split", initialView) }
						id="diff-btn-split"
						onclick="switchDiffView('split')"
					>
						Split
					</button>
				</div>
			</div>
		</div>
		<!-- File List -->
		if len(metas) > 1 {
			<div class="mb-4 p-3 bg-base-200 rounded-lg min-w-0 max-w-full overflow-hidden">
				<div class="text-xs font-semibold uppercase tracking-wider mb-2 opacity-60">Changed Files</div>
				<div class="flex flex-wrap gap-1 min-w-0 max-w-full overflow-hidden">
					for _, m := range metas {
						<a
							href={ templ.SafeURL(fmt.Sprintf("#diff-file-%d", m.Index)) }
							class="badge badge-sm badge-outline cursor-pointer hover:badge-primary max-w-full min-w-0 overflow-hidden"
							onclick={ templ.ComponentScript{Call: fmt.Sprintf("expandAndScrollDiffFile(%d)", m.Index)} }
						>
							<span class="block truncate min-w-0">{ diffFileName(m.File.Path) }</span>
						</a>
					}
				</div>
			</div>
		}
		<!-- Diff Content with Review -->
		<div id="diff-content-inline" class={ diffViewContentClass("inline", initialView) }>
			for _, m := range metas {
				if m.AutoLoad {
					@inlineDiffFileWithReview(m.File, m.Index, shouldDefaultExpand(len(metas)), taskID, buildCommentMap(reviewComments))
				} else {
					@deferredDiffFileWithReview(m, taskID, "inline", true)
				}
			}
		</div>
		<div id="diff-content-split" class={ diffViewContentClass("split", initialView) }>
			for _, m := range metas {
				if m.AutoLoad {
					@splitDiffFileWithReview(m.File, m.Index, shouldDefaultExpand(len(metas)), taskID, buildCommentMap(reviewComments))
				} else {
					@deferredDiffFileWithReview(m, taskID, "split", true)
				}
			}
		</div>
		<!-- Inline review JavaScript -->
		<script>
			// Session-level state for diff file expand/collapse, scoped by viewer.
			if (!window._diffFileState) window._diffFileState = {};
			function diffFileStateBucket() {
				var viewer = document.getElementById('diff-viewer');
				var key = viewer ? (viewer.dataset.stateKey || 'default') : 'default';
				if (!window._diffFileState[key]) window._diffFileState[key] = {};
				return window._diffFileState[key];
			}

			function toggleDiffFile(idx) {
				var inlineBody = document.getElementById('diff-body-' + idx);
				var splitBody = document.getElementById('diff-body-split-' + idx);
				var chevron = document.getElementById('diff-chevron-' + idx);
				var chevronSplit = document.getElementById('diff-chevron-split-' + idx);

				var isExpanded = chevron && chevron.classList.contains('rotate-90');
				var newState = !isExpanded;

				// When collapsing a card whose sticky header is currently
				// pinned to the top of the scroll container, the body shrinks
				// while the page stays scrolled, and the sticky header's
				// containing-block constraint drags the header off-screen.
				// Pre-scroll the page so the card's top aligns with the
				// scroller top before the body animates; the header then
				// stays put while the body collapses in place.
				if (!newState) {
					var card = null;
					[
						document.getElementById('diff-file-' + idx),
						document.getElementById('diff-file-split-' + idx)
					].some(function(candidate) {
						if (!candidate || candidate.getClientRects().length === 0) return false;
						card = candidate;
						return true;
					});
					var scroller = document.getElementById('main-content');
					if (card && scroller) {
						var cardTop = card.getBoundingClientRect().top;
						var scrollerTop = scroller.getBoundingClientRect().top;
						if (cardTop < scrollerTop) {
							scroller.scrollTop -= (scrollerTop - cardTop);
						}
					}
				}

				if (inlineBody) {
					if (newState) {
						inlineBody.style.maxHeight = inlineBody.scrollHeight + 'px';
						setTimeout(function() { inlineBody.style.maxHeight = ''; }, 300);
					} else {
						inlineBody.style.maxHeight = inlineBody.scrollHeight + 'px';
						inlineBody.offsetHeight;
						inlineBody.style.maxHeight = '0';
					}
				}

				if (splitBody) {
					if (newState) {
						splitBody.style.maxHeight = splitBody.scrollHeight + 'px';
						setTimeout(function() { splitBody.style.maxHeight = ''; }, 300);
					} else {
						splitBody.style.maxHeight = splitBody.scrollHeight + 'px';
						splitBody.offsetHeight;
						splitBody.style.maxHeight = '0';
					}
				}

				if (chevron) chevron.classList.toggle('rotate-90', newState);
				if (chevronSplit) chevronSplit.classList.toggle('rotate-90', newState);

				document.querySelectorAll('[data-diff-toggle="' + idx + '"]').forEach(function(el) {
					if (newState) el.removeAttribute('data-collapsed');
					else el.setAttribute('data-collapsed', '1');
				});

				diffFileStateBucket()[idx] = newState;
			}

			function toggleAllDiffFiles(expand) {
				var viewer = document.getElementById('diff-viewer');
				if (!viewer) return;
				var count = parseInt(viewer.dataset.fileCount || '0');
				for (var i = 0; i < count; i++) {
					var chevron = document.getElementById('diff-chevron-' + i);
					var isExpanded = chevron && chevron.classList.contains('rotate-90');
					if (isExpanded !== expand) {
						toggleDiffFile(i);
					}
				}
			}

			function expandAndScrollDiffFile(idx) {
				var chevron = document.getElementById('diff-chevron-' + idx);
				var isExpanded = chevron && chevron.classList.contains('rotate-90');
				if (!isExpanded) {
					toggleDiffFile(idx);
				}
				setTimeout(function() {
					var el = document.getElementById('diff-file-' + idx);
					if (el) el.scrollIntoView({behavior: 'smooth', block: 'start'});
				}, 50);
			}

			// Restore persisted expand/collapse state after initial render and after
			// HTMX swaps. Deferred file-card swaps render expanded by default, so the
			// saved state must be re-applied to the body, chevrons, and header shape.
			window._restoreDiffFileState = window._restoreDiffFileState || function() {
				var viewer = document.getElementById('diff-viewer');
				if (!viewer || !window._diffFileState) return;
				var state = diffFileStateBucket();
				var count = parseInt(viewer.dataset.fileCount || '0');
				for (var i = 0; i < count; i++) {
					if (state.hasOwnProperty(i)) {
						var savedExpanded = state[i];
						var bodies = [
							document.getElementById('diff-body-' + i),
							document.getElementById('diff-body-split-' + i)
						];
						var chevrons = [
							document.getElementById('diff-chevron-' + i),
							document.getElementById('diff-chevron-split-' + i)
						];
						bodies.forEach(function(body) {
							if (!body) return;
							body.style.transition = 'none';
							body.style.maxHeight = savedExpanded ? '' : '0';
							body.offsetHeight;
							body.style.transition = '';
						});
						chevrons.forEach(function(c) {
							if (!c) return;
							var previousTransition = c.style.transition;
							c.style.transition = 'none';
							c.classList.toggle('rotate-90', savedExpanded);
							c.getBoundingClientRect();
							c.style.transition = previousTransition;
						});
						document.querySelectorAll('[data-diff-toggle="' + i + '"]').forEach(function(el) {
							if (savedExpanded) el.removeAttribute('data-collapsed');
							else el.setAttribute('data-collapsed', '1');
						});
					}
				}
			};
			window._restoreDiffFileState();
			if (!window._diffFileStateRestoreRegistered) {
				window._diffFileStateRestoreRegistered = true;
				['htmx:afterSwap', 'htmx:afterSettle'].forEach(function(eventName) {
					document.body.addEventListener(eventName, window._restoreDiffFileState);
				});
			}

			function copyDiffFilePath(ev, button) {
				if (ev) {
					ev.preventDefault();
					ev.stopPropagation();
				}
				var text = button && button.dataset ? button.dataset.copyPath : '';
				if (!text) {
					if (window.showToast) window.showToast('No file path to copy', 'failed');
					return;
				}

				function setCopiedState() {
					if (!button) return;
					var originalHTML = button.innerHTML;
					button.classList.add('btn-success');
					button.innerHTML = '<svg xmlns="http://www.w3.org/2000/svg" class="h-4 w-4" fill="none" viewBox="0 0 24 24" stroke="currentColor" aria-hidden="true"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M5 13l4 4L19 7"></path></svg>';
					setTimeout(function() {
						button.classList.remove('btn-success');
						button.innerHTML = originalHTML;
					}, 1200);
				}

				function onCopySuccess() {
					setCopiedState();
				}

				function onCopyFailure() {
					if (window.showToast) window.showToast('Failed to copy file path', 'failed');
				}

				function fallbackCopy() {
					var textarea = document.createElement('textarea');
					textarea.value = text;
					textarea.setAttribute('readonly', '');
					textarea.style.position = 'fixed';
					textarea.style.opacity = '0';
					document.body.appendChild(textarea);
					textarea.select();
					textarea.setSelectionRange(0, textarea.value.length);
					try {
						if (document.execCommand('copy')) onCopySuccess();
						else onCopyFailure();
					} catch (e) {
						onCopyFailure();
					} finally {
						document.body.removeChild(textarea);
					}
				}

				if (navigator.clipboard && typeof navigator.clipboard.writeText === 'function') {
					navigator.clipboard.writeText(text).then(onCopySuccess).catch(fallbackCopy);
					return;
				}
				fallbackCopy();
			}

			function persistDiffViewPreference(mode) {
				try {
					fetch('/ui/preferences', {
						method: 'POST',
						headers: { 'Content-Type': 'application/json' },
						body: JSON.stringify({ diff_view: mode }),
						keepalive: true
					}).catch(function() {});
				} catch (_) {}
			}

			function switchDiffView(mode, persist) {
				var inlineEl = document.getElementById('diff-content-inline');
				var splitEl = document.getElementById('diff-content-split');
				var btnInline = document.getElementById('diff-btn-inline');
				var btnSplit = document.getElementById('diff-btn-split');
				if (!inlineEl || !splitEl || !btnInline || !btnSplit) return;

				if (mode === 'split') {
					inlineEl.classList.add('hidden');
					splitEl.classList.remove('hidden');
					btnSplit.classList.add('btn-active');
					btnInline.classList.remove('btn-active');
				} else {
					splitEl.classList.add('hidden');
					inlineEl.classList.remove('hidden');
					btnInline.classList.add('btn-active');
					btnSplit.classList.remove('btn-active');
				}
				if (persist !== false) {
					persistDiffViewPreference(mode === 'split' ? 'split' : 'inline');
				}
			}

			// Inline comment functions — always active, no review mode toggle needed
			function closeReviewForm(formRow) {
				if (!formRow) return;
				var lineRow = findLineRowForComment(formRow);
				if (lineRow) lineRow.classList.remove('diff-review-line-open');
				if (formRow.dataset.mode === 'edit') {
					findInlineCommentRows(lineRow).forEach(function(commentRow) {
						commentRow.style.display = '';
					});
					formRow.replaceWith(buildInlineCommentRow({
						id: formRow.dataset.commentId || '',
						filePath: formRow.dataset.filePath || '',
						lineNum: formRow.dataset.lineNum || '',
						lineType: formRow.dataset.lineType || '',
						commentText: formRow.dataset.originalText || ''
					}, formRow.dataset.reviewLayout || 'inline'));
					return;
				}
				formRow.remove();
			}

			function closeOpenReviewForms(exceptForm) {
				var viewer = document.getElementById('diff-viewer');
				if (!viewer) return;
				viewer.querySelectorAll('.review-comment-form').forEach(function(formRow) {
					if (formRow !== exceptForm) {
						closeReviewForm(formRow);
					}
				});
			}

			function reviewFormInnerHtml(submitLabel) {
				return '<div class="review-comment-shell rounded-lg border border-base-300 bg-base-100 p-3">' +
					'<textarea class="review-comment-textarea block w-full font-sans bg-transparent text-base-content placeholder:text-base-content/50" placeholder="Add review comment..." rows="2" autofocus style="resize: none;"></textarea>' +
					'<div class="review-comment-actions mt-3 flex items-center justify-end gap-2">' +
					'<button type="button" class="btn btn-sm btn-ghost review-cancel-btn">Cancel</button>' +
					'<button type="button" class="btn btn-sm btn-success review-submit-btn">' + escapeHtml(submitLabel || 'Comment') + '</button>' +
					'</div>' +
					'</div>';
			}

			function buildReviewFormRow(options) {
				var formRow = document.createElement('tr');
				formRow.className = 'review-comment-form';
				formRow.dataset.mode = options.mode || 'new';
				formRow.dataset.commentId = options.commentId || '';
				formRow.dataset.filePath = options.filePath || '';
				formRow.dataset.lineNum = options.lineNum || '';
				formRow.dataset.lineType = options.lineType || '';
				formRow.dataset.reviewLayout = options.layout || 'inline';
				formRow.dataset.originalText = options.originalText || '';
				if ((options.layout || 'inline') === 'split') {
					formRow.innerHTML = '<td class="diff-line-num px-2 py-0 border-r border-base-300 bg-base-200"></td>' +
						'<td class="diff-line-content px-3 py-0 border-r border-base-300 bg-base-200"></td>' +
						'<td class="diff-line-num px-2 py-0 border-r border-base-300 bg-base-200"></td>' +
						'<td class="p-2 bg-base-200">' + reviewFormInnerHtml(options.submitLabel) + '</td>';
				} else {
					formRow.innerHTML = '<td class="diff-line-num px-2 py-0 w-12 border-r border-base-300 bg-base-200"></td>' +
						'<td class="diff-line-num px-2 py-0 w-12 border-r border-base-300 bg-base-200"></td>' +
						'<td class="p-2 bg-base-200">' + reviewFormInnerHtml(options.submitLabel) + '</td>';
				}
				var textarea = formRow.querySelector('textarea');
				textarea.value = options.initialText || '';
				textarea.addEventListener('keydown', function(e) {
					if (e.key === 'Escape') {
						closeReviewForm(formRow);
					} else if (e.key === 'Enter' && !e.shiftKey && !e.isComposing) {
						e.preventDefault();
						if (formRow.dataset.mode === 'edit') {
							updateReviewComment(formRow);
						} else {
							submitReviewComment(options.taskId, options.filePath, options.lineNum, options.lineType, textarea.value, formRow);
						}
					}
				});
				formRow.querySelector('.review-submit-btn').addEventListener('click', function() {
					if (formRow.dataset.mode === 'edit') {
						updateReviewComment(formRow);
					} else {
						submitReviewComment(options.taskId, options.filePath, options.lineNum, options.lineType, textarea.value, formRow);
					}
				});
				formRow.querySelector('.review-cancel-btn').addEventListener('click', function() {
					closeReviewForm(formRow);
				});
				return formRow;
			}

			function openInlineCommentForm(row) {
				var viewer = document.getElementById('diff-viewer');
				if (!viewer) return;

				var filePath = row.dataset.filePath;
				var lineNum = row.dataset.lineNum;
				var lineType = row.dataset.lineType;
				var taskId = viewer.dataset.taskId;

				if (!filePath || !lineNum || !taskId) return;
				var existingForm = row.nextElementSibling;
				if (existingForm && existingForm.classList.contains('review-comment-form')) {
					closeReviewForm(existingForm);
					return;
				}
				closeOpenReviewForms();
				var formRow = buildReviewFormRow({
					mode: 'new',
					layout: row.dataset.reviewLayout || 'inline',
					taskId: taskId,
					filePath: filePath,
					lineNum: lineNum,
					lineType: lineType,
					submitLabel: 'Comment'
				});
				row.parentNode.insertBefore(formRow, row.nextSibling);
				row.classList.add('diff-review-line-open');
				requestAnimationFrame(function() {
					var textarea = formRow.querySelector('.review-comment-textarea');
					if (!textarea) return;
					textarea.focus();
					textarea.setSelectionRange(textarea.value.length, textarea.value.length);
				});
			}

			function handleAddCommentClick(ev) {
				ev.stopPropagation();
				var btn = ev.target.closest('.diff-add-comment-btn');
				if (!btn) return;
				var row = btn.closest('tr.diff-review-line');
				if (!row) return;
				if (!row.dataset.lineNum || row.dataset.lineNum === '0') return;
				openInlineCommentForm(row);
			}

			function cancelReview() {
				var viewer = document.getElementById('diff-viewer');
				if (!viewer) return;
				var taskId = viewer.dataset.taskId;
				if (!taskId) return;

				// Delete all comments for this task via the API, then reload the page
				fetch('/tasks/' + taskId + '/reviews', { method: 'GET' })
					.then(function() {
						window.location.reload();
					});
			}

			function escapeHtml(value) {
				return String(value || '')
					.replace(/&/g, '&amp;')
					.replace(/</g, '&lt;')
					.replace(/>/g, '&gt;')
					.replace(/\"/g, '&quot;')
					.replace(/'/g, '&#39;');
			}

			function findLineRowForComment(commentRow) {
				var cursor = commentRow ? commentRow.previousElementSibling : null;
				while (cursor) {
					if (cursor.classList && cursor.classList.contains('diff-review-line')) {
						return cursor;
					}
					cursor = cursor.previousElementSibling;
				}
				return null;
			}

			function findInlineCommentRows(lineRow) {
				var rows = [];
				if (!lineRow) return rows;
				var filePath = lineRow.dataset.filePath || '';
				var lineNum = lineRow.dataset.lineNum || '';
				var lineType = lineRow.dataset.lineType || '';
				var cursor = lineRow.nextElementSibling;
				while (cursor) {
					if (cursor.classList && cursor.classList.contains('diff-review-line')) {
						break;
					}
					if (cursor.classList && cursor.classList.contains('review-inline-comment')) {
						if (cursor.dataset.filePath === filePath && cursor.dataset.lineNum === lineNum && cursor.dataset.lineType === lineType) {
							rows.push(cursor);
						}
					}
					cursor = cursor.nextElementSibling;
				}
				return rows;
			}

			function extractCreatedComment(html, filePath, lineNum, lineType, fallbackText) {
				var temp = document.createElement('div');
				temp.innerHTML = html;
				var items = temp.querySelectorAll('.review-comment-item');
				var match = null;
				items.forEach(function(item) {
					if (item.dataset.filePath === filePath && item.dataset.lineNumber === String(lineNum) && item.dataset.lineType === lineType) {
						match = item;
					}
				});
				if (!match) {
					return {
						id: '',
						filePath: filePath,
						lineNum: String(lineNum),
						lineType: lineType,
						commentText: fallbackText
					};
				}
				var textEl = match.querySelector('p');
				return {
					id: match.dataset.commentId || '',
					filePath: filePath,
					lineNum: String(lineNum),
					lineType: lineType,
					commentText: textEl ? textEl.textContent : fallbackText
				};
			}

			function parseReviewCommentsFromListHtml(html) {
				var temp = document.createElement('div');
				temp.innerHTML = html;
				var comments = [];
				temp.querySelectorAll('.review-comment-item').forEach(function(item) {
					var textEl = item.querySelector('p');
					comments.push({
						id: item.dataset.commentId || '',
						filePath: item.dataset.filePath || '',
						lineNum: item.dataset.lineNumber || '',
						lineType: item.dataset.lineType || 'new',
						commentText: textEl ? textEl.textContent : ''
					});
				});
				return comments;
			}

			function reviewCommentLineKey(filePath, lineNum, lineType) {
				return String(filePath || '') + '::' + String(lineNum || '') + '::' + String(lineType || 'new');
			}

			function setReviewToolbarEnabled(hasComments) {
				var toolbar = document.getElementById('review-toolbar');
				if (!toolbar) return;
				var submitBtn = toolbar.querySelector('button[hx-post]');
				if (!submitBtn) return;
				if (hasComments) {
					submitBtn.removeAttribute('disabled');
				} else {
					submitBtn.setAttribute('disabled', 'disabled');
				}
			}

			function syncReviewCommentsFromListHtml(html) {
				var viewer = document.getElementById('diff-viewer');
				if (!viewer) return;
				var comments = parseReviewCommentsFromListHtml(html);
				var grouped = {};
				comments.forEach(function(comment) {
					var key = reviewCommentLineKey(comment.filePath, comment.lineNum, comment.lineType);
					if (!grouped[key]) grouped[key] = [];
					grouped[key].push(comment);
				});

				viewer.querySelectorAll('tr.review-comment-form').forEach(function(formRow) {
					formRow.remove();
				});
				viewer.querySelectorAll('tr.review-inline-comment').forEach(function(commentRow) {
					commentRow.remove();
				});
				viewer.querySelectorAll('tr.diff-review-line').forEach(function(lineRow) {
					lineRow.classList.remove('diff-review-line-open');
					var key = reviewCommentLineKey(lineRow.dataset.filePath, lineRow.dataset.lineNum, lineRow.dataset.lineType);
					(grouped[key] || []).forEach(function(comment) {
						insertInlineCommentRow(lineRow, comment);
					});
				});

				setReviewToolbarEnabled(comments.length > 0);
			}

			function refreshReviewComments(taskId) {
				if (!taskId) return Promise.resolve();
				return fetch('/tasks/' + taskId + '/reviews', {
					headers: { 'HX-Request': 'true' }
				})
				.then(function(resp) {
					if (!resp.ok) throw new Error('failed to load review comments');
					return resp.text();
				})
				.then(function(html) {
					syncReviewCommentsFromListHtml(html);
				});
			}

			function renderInlineCommentBox(comment) {
				var text = escapeHtml(comment.commentText || '');
				return '<div class="review-inline-comment-box p-2 pl-3 pr-8 text-xs cursor-text" data-comment-id="' + escapeHtml(comment.id || '') + '" onclick="startEditReviewComment(event)">' +
					'<span class="review-inline-comment-bar"></span>' +
					'<button type="button" class="btn btn-circle btn-ghost btn-xs review-delete-btn" onclick="deleteReviewComment(event)" aria-label="Delete review comment">' +
						'<svg xmlns="http://www.w3.org/2000/svg" class="h-4 w-4" fill="none" viewBox="0 0 24 24" stroke="currentColor"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M6 18L18 6M6 6l12 12"></path></svg>' +
					'</button>' +
					'<p class="review-comment-text whitespace-pre-wrap break-words">' + text + '</p>' +
					'</div>';
			}

			function buildInlineCommentRow(comment, layout) {
				var commentRow = document.createElement('tr');
				commentRow.className = 'review-inline-comment';
				commentRow.dataset.commentId = comment.id || '';
				commentRow.dataset.filePath = comment.filePath || '';
				commentRow.dataset.lineNum = comment.lineNum || '';
				commentRow.dataset.lineType = comment.lineType || '';
				commentRow.dataset.reviewLayout = layout || 'inline';
				if ((layout || 'inline') === 'split') {
					commentRow.innerHTML = '<td class="diff-line-num px-2 py-0 border-r border-base-300 bg-base-200"></td>' +
						'<td class="diff-line-content px-3 py-0 border-r border-base-300 bg-base-200"></td>' +
						'<td class="diff-line-num px-2 py-0 border-r border-base-300 bg-base-200"></td>' +
						'<td class="p-0 bg-warning/15 align-top">' + renderInlineCommentBox(comment) + '</td>';
				} else {
					commentRow.innerHTML = '<td class="diff-line-num px-2 py-0 w-12 border-r border-base-300 bg-base-200"></td>' +
						'<td class="diff-line-num px-2 py-0 w-12 border-r border-base-300 bg-base-200"></td>' +
						'<td class="p-0 bg-warning/15 align-top">' + renderInlineCommentBox(comment) + '</td>';
				}
				return commentRow;
			}
	
			function insertInlineCommentRow(lineRow, comment) {
				if (!lineRow) return;
				var layout = (lineRow.dataset && lineRow.dataset.reviewLayout) ? lineRow.dataset.reviewLayout : 'inline';
				var commentRow = buildInlineCommentRow({
					id: comment.id || '',
					filePath: lineRow.dataset.filePath || comment.filePath || '',
					lineNum: lineRow.dataset.lineNum || comment.lineNum || '',
					lineType: lineRow.dataset.lineType || comment.lineType || '',
					commentText: comment.commentText || ''
				}, layout);
				var insertionPoint = lineRow;
				while (insertionPoint.nextElementSibling && insertionPoint.nextElementSibling.classList && insertionPoint.nextElementSibling.classList.contains('review-inline-comment')) {
					insertionPoint = insertionPoint.nextElementSibling;
				}
				lineRow.parentNode.insertBefore(commentRow, insertionPoint.nextElementSibling);
			}

			function startEditReviewComment(ev) {
				var target = ev.target;
				if (target && target.closest && target.closest('.review-delete-btn')) {
					ev.stopPropagation();
					return;
				}
				ev.stopPropagation();
				var row = ev.target.closest('tr.review-inline-comment');
				if (!row) return;
				closeOpenReviewForms();
				var lineRow = findLineRowForComment(row);
				if (!lineRow) return;
				var viewer = document.getElementById('diff-viewer');
				if (!viewer || !viewer.dataset) return;
				var textEl = row.querySelector('.review-comment-text');
				var currentText = textEl ? textEl.textContent : '';
				findInlineCommentRows(lineRow).forEach(function(commentRow) {
					commentRow.style.display = 'none';
				});
				var formRow = buildReviewFormRow({
					mode: 'edit',
					layout: row.dataset.reviewLayout || 'inline',
					taskId: viewer.dataset.taskId || '',
					commentId: row.dataset.commentId || '',
					filePath: row.dataset.filePath || '',
					lineNum: row.dataset.lineNum || '',
					lineType: row.dataset.lineType || '',
					initialText: currentText,
					originalText: currentText,
					submitLabel: 'Update'
				});
				row.replaceWith(formRow);
				lineRow.classList.add('diff-review-line-open');
			}

			function updateReviewComment(formRow) {
				if (!formRow) return;
				var viewer = document.getElementById('diff-viewer');
				var taskId = viewer && viewer.dataset ? viewer.dataset.taskId : '';
				var commentId = formRow.dataset.commentId;
				if (!commentId) return;
				var textarea = formRow.querySelector('textarea');
				if (!textarea) return;
				var text = textarea.value.trim();
				if (!text) return;
				var formData = new URLSearchParams();
				formData.append('comment_text', text);
				fetch('/reviews/' + commentId, {
					method: 'PATCH',
					headers: { 'Content-Type': 'application/x-www-form-urlencoded', 'HX-Request': 'true' },
					body: formData.toString()
				})
				.then(function(resp) {
					if (!resp.ok) throw new Error('failed to save comment');
					var lineRow = findLineRowForComment(formRow);
					var existingRows = findInlineCommentRows(lineRow);
					if (existingRows.length > 0) {
						existingRows.forEach(function(commentRow) {
							commentRow.style.display = '';
							if (commentRow.dataset.commentId === commentId) {
								var textNode = commentRow.querySelector('.review-comment-text');
								if (textNode) textNode.textContent = text;
							}
						});
						formRow.remove();
					} else {
						formRow.replaceWith(buildInlineCommentRow({
							id: commentId,
							filePath: formRow.dataset.filePath || '',
							lineNum: formRow.dataset.lineNum || '',
							lineType: formRow.dataset.lineType || '',
							commentText: text
						}, formRow.dataset.reviewLayout || 'inline'));
					}
					if (lineRow) lineRow.classList.remove('diff-review-line-open');
					if (taskId) {
						refreshReviewComments(taskId).catch(function(err) {
							console.error(err);
						});
					}
				})
				.catch(function(err) {
					console.error(err);
				});
			}

			function deleteReviewComment(ev) {
				ev.stopPropagation();
				var row = ev.target.closest('tr.review-inline-comment, tr.review-comment-form');
				if (!row) return;
				var viewer = document.getElementById('diff-viewer');
				var taskId = viewer && viewer.dataset ? viewer.dataset.taskId : '';
				var commentId = row.dataset.commentId;
				if (!commentId) return;
				var lineRow = findLineRowForComment(row);
				fetch('/reviews/' + commentId, {
					method: 'DELETE',
					headers: { 'HX-Request': 'true' }
				})
				.then(function(resp) {
					if (!resp.ok) throw new Error('failed to delete comment');
					row.remove();
					if (lineRow) lineRow.classList.remove('diff-review-line-open');
					if (taskId) {
						refreshReviewComments(taskId).catch(function(err) {
							console.error(err);
						});
					}
				})
				.catch(function(err) {
					console.error(err);
				});
			}

			function submitReviewComment(taskId, filePath, lineNum, lineType, text, formRow) {
				if (!text.trim()) return;

				var formData = new URLSearchParams();
				formData.append('file_path', filePath);
				formData.append('line_number', lineNum);
				formData.append('line_type', lineType);
				formData.append('comment_text', text);

				fetch('/tasks/' + taskId + '/reviews', {
					method: 'POST',
					headers: { 'Content-Type': 'application/x-www-form-urlencoded', 'HX-Request': 'true' },
					body: formData.toString()
				})
				.then(function(resp) {
					if (!resp.ok) throw new Error('failed to add review comment');
					return resp.text();
				})
				.then(function(html) {
					var row = findLineRowForComment(formRow);
					var comment = extractCreatedComment(html, filePath, lineNum, lineType, text);
					var layout = formRow.dataset.reviewLayout || (row && row.dataset ? row.dataset.reviewLayout : '') || 'inline';
					if (formRow && formRow.parentNode) {
						formRow.replaceWith(buildInlineCommentRow({
							id: comment.id || '',
							filePath: filePath,
							lineNum: String(lineNum),
							lineType: lineType,
							commentText: comment.commentText || text
						}, layout));
					}
					if (row) row.classList.remove('diff-review-line-open');
					refreshReviewComments(taskId).catch(function(err) {
						console.error(err);
					});
				})
				.catch(function(err) {
					console.error(err);
				});
			}

			// Track when sticky diff file headers are pinned. Headers keep their
			// original rounded corners in normal flow, then square their top
			// corners while pinned so diff rows cannot show through the radius.
			window._wireDiffStickyHeaders = window._wireDiffStickyHeaders || (function() {
				var ticking = false;

				function updateStickyHeaders() {
					ticking = false;
					var scroller = document.getElementById("main-content");
					var rootTop = scroller ? scroller.getBoundingClientRect().top : 0;
					var viewer = document.getElementById("diff-viewer") || document;
					viewer.querySelectorAll(".diff-file-header").forEach(function(header) {
						var sentinel = header.previousElementSibling;
						if (!sentinel || sentinel.getAttribute("data-diff-sticky-sentinel") !== "1") return;
						if (sentinel.getBoundingClientRect().top <= rootTop + 1) {
							header.setAttribute("data-stuck", "1");
						} else {
							header.removeAttribute("data-stuck");
						}
					});
				}

				function scheduleUpdate() {
					if (ticking) return;
					ticking = true;
					requestAnimationFrame(updateStickyHeaders);
				}

				return function() {
					var viewer = document.getElementById("diff-viewer") || document;
					viewer.querySelectorAll(".diff-file-header:not([data-sticky-wired])").forEach(function(header) {
						var sentinel = document.createElement("div");
						sentinel.style.cssText = "height:1px;margin-bottom:-1px;pointer-events:none;";
						sentinel.setAttribute("aria-hidden", "true");
						sentinel.setAttribute("data-diff-sticky-sentinel", "1");
						header.parentNode.insertBefore(sentinel, header);
						header.setAttribute("data-sticky-wired", "1");
					});
					scheduleUpdate();
				};
			})();
			window._wireDiffStickyHeaders();
			if (!window._diffStickyHeadersScrollRegistered) {
				window._diffStickyHeadersScrollRegistered = true;
				var diffScroller = document.getElementById("main-content");
				if (diffScroller) diffScroller.addEventListener("scroll", window._wireDiffStickyHeaders, { passive: true });
				window.addEventListener("resize", window._wireDiffStickyHeaders);
				document.body.addEventListener("htmx:afterSettle", window._wireDiffStickyHeaders);
			}

		</script>
		<style>
			/* Sticky file headers within the diff viewer.
			   The Task Detail page scroll container is #main-content. The
			   diff file card itself cannot use any overflow other than
			   visible — `overflow: hidden`/`auto`/`scroll`/`clip` all trap
			   `position: sticky` against the card instead of #main-content.
			   The header therefore inherits the card's top corner radius
			   directly and the body inherits the bottom corner radius; the
			   card border draws cleanly around them without an intermediate
			   clipping context. Each card keeps its full rounded corners
			   and the original space-y-4 gap between files. */
			.diff-file-card {
				border-radius: var(--rounded-box, 1rem);
			}
			/* #main-content has p-6 (1.5rem) padding-top. Tailwind's
			   `top-0` would stick the header at the content-box edge —
			   24px below the visible page top — leaving a band where
			   diff rows scrolling up remain visible above the header.
			   Using `top: -1.5rem` snaps the header's top edge flush
			   with the padding-box edge (the visible page top), so
			   overflow clipping hides rows behind it.

			   The header keeps its original rounded top corners while in
			   normal flow. When it is pinned, JS marks it data-stuck="1"
			   and the top corners become square so diff rows cannot show
			   through the rounded radius. */
			.diff-file-header {
				top: -1.5rem;
				border-top-left-radius: inherit;
				border-top-right-radius: inherit;
			}
			.diff-file-header[data-stuck="1"] {
				border-top-left-radius: 0;
				border-top-right-radius: 0;
			}
			.diff-file-header[data-stuck="1"]:hover {
				background-color: oklch(var(--b2)) !important;
			}
			[data-theme="light"] .diff-file-header[data-stuck="1"]:hover {
				background-color: var(--ov-l-bg) !important;
			}
			.diff-file-header[data-collapsed="1"] {
				border-bottom-color: transparent;
				border-bottom-left-radius: inherit;
				border-bottom-right-radius: inherit;
			}
			.diff-file-header[data-collapsed="1"] + .diff-file-body {
				max-height: 0 !important;
			}
			.diff-copy-path-btn {
				color: oklch(var(--bc) / 0.7);
			}
			.diff-copy-path-btn:hover,
			.diff-copy-path-btn:focus-visible {
				color: oklch(var(--bc));
				background-color: oklch(var(--b3) / 0.75);
			}
				.diff-file-body {
					border-bottom-left-radius: inherit;
					border-bottom-right-radius: inherit;
				}
				.diff-file-stats .diff-stat-add {
					color: var(--ov-diff-add-fg);
				}
				.diff-file-stats .diff-stat-del {
					color: var(--ov-diff-del-fg);
				}
				/* Inline review styles — always active */
				.diff-review-line {
					position: relative;
				}
				.diff-line-num {
					padding-right: 1.75rem;
				}
				.diff-add-comment-btn {
					display: inline-flex;
					align-items: center;
					justify-content: center;
					position: absolute;
					right: 0.25rem;
					top: 50%;
					transform: translateY(-50%);
					width: 18px;
					height: 18px;
					border-radius: 9999px;
					background: #3b82f6;
					color: white;
				border: none;
				cursor: pointer;
				font-size: 14px;
				line-height: 1;
				padding: 0;
				z-index: 2;
				font-weight: bold;
				opacity: 0;
				pointer-events: none;
				transition: opacity 0.15s ease, background-color 0.15s ease;
			}
				.diff-add-comment-btn:hover {
					background: #2563eb;
				}
			.diff-review-line:hover .diff-add-comment-btn,
			.diff-review-line-open .diff-add-comment-btn {
				opacity: 1;
				pointer-events: auto;
			}
			.review-comment-shell {
				box-shadow: none;
				overflow: hidden;
			}
			.review-comment-textarea {
				resize: none;
				border: 0 !important;
				outline: none;
				box-shadow: none !important;
				background: transparent;
				min-height: 56px;
				padding: 0;
			}
			.review-comment-form td {
				padding-top: 0.5rem;
				padding-bottom: 0.5rem;
			}
			.review-comment-textarea:focus {
				outline: none;
				box-shadow: none !important;
			}
			.review-comment-actions {
				z-index: 1;
			}
			.review-indicator {
				z-index: 1;
			}
			.review-inline-comment-box {
				position: relative;
				box-shadow: none;
				background: transparent;
				min-height: 2.25rem;
			}
				.review-inline-comment-bar {
					position: absolute;
					left: 0;
					top: 0;
					bottom: 0;
					width: 4px;
					background: #facc15;
				}
			.review-inline-comment-box .review-delete-btn {
				position: absolute;
				top: 0.25rem;
				right: 0.25rem;
				min-height: 1.5rem;
				height: 1.5rem;
				min-width: 1.5rem;
				width: 1.5rem;
				padding: 0;
				line-height: 1;
				color: white;
				z-index: 1;
			}
			.review-inline-comment-box .review-delete-btn:hover {
				background: rgb(255 255 255 / 0.12);
			}
		</style>
	</div>
}

templ diffFileHeader(f DiffFile, idx int, defaultExpanded bool, splitChevron bool) {
	<div
		class="diff-file-header sticky z-20 bg-base-200 px-4 py-2 border-b border-base-300 flex items-center gap-2 cursor-pointer select-none hover:bg-base-300/50 transition-colors"
		onclick={ templ.ComponentScript{Call: fmt.Sprintf("toggleDiffFile(%d)", idx)} }
		data-diff-toggle={ fmt.Sprintf("%d", idx) }
		data-diff-status={ diffFileStatusValue(f.Status) }
		if !defaultExpanded {
			data-collapsed="1"
		}
	>
		<svg
			if splitChevron {
				id={ fmt.Sprintf("diff-chevron-split-%d", idx) }
			} else {
				id={ fmt.Sprintf("diff-chevron-%d", idx) }
			}
			xmlns="http://www.w3.org/2000/svg"
			class={ "h-4 w-4 opacity-60 transition-transform duration-200", templ.KV("rotate-90", defaultExpanded) }
			fill="none"
			viewBox="0 0 24 24"
			stroke="currentColor"
		>
			<path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 5l7 7-7 7"></path>
		</svg>
		<svg xmlns="http://www.w3.org/2000/svg" class="h-4 w-4 opacity-50" fill="none" viewBox="0 0 24 24" stroke="currentColor">
			<path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 12h6m-6 4h6m2 5H7a2 2 0 01-2-2V5a2 2 0 012-2h5.586a1 1 0 01.707.293l5.414 5.414a1 1 0 01.293.707V19a2 2 0 01-2 2z"></path>
		</svg>
		<span class={ diffFileStatusBadgeClass(f.Status), "shrink-0" } title={ diffFileStatusLabel(f.Status) }>{ diffFileStatusLabel(f.Status) }</span>
		if f.IsBinary {
			<span class="badge badge-ghost badge-sm shrink-0" title="Binary file">Binary</span>
		}
		<span class="flex items-center gap-1 min-w-0 flex-1">
			<span class="font-mono text-sm font-medium truncate min-w-0" title={ diffFileDisplayPath(f) }>{ diffFileDisplayPath(f) }</span>
			@diffFileCopyPathButton(diffFileDisplayPath(f))
		</span>
		@diffStatsBadge(f)
	</div>
}

templ diffFileCopyPathButton(path string) {
	<button
		type="button"
		class="diff-copy-path-btn btn btn-ghost btn-xs btn-square shrink-0 opacity-60 hover:opacity-100 focus:opacity-100"
		title="Copy file path"
		aria-label={ "Copy file path " + path }
		data-copy-path={ path }
		onclick={ templ.ComponentScript{Call: "copyDiffFilePath(event, this)"} }
	>
		<svg xmlns="http://www.w3.org/2000/svg" class="h-4 w-4" fill="none" viewBox="0 0 24 24" stroke="currentColor" aria-hidden="true">
			<rect x="9" y="9" width="13" height="13" rx="2" ry="2" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"></rect>
			<path d="M5 15H4a2 2 0 0 1-2-2V4a2 2 0 0 1 2-2h9a2 2 0 0 1 2 2v1" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"></path>
		</svg>
	</button>
}

templ diffStatsBadge(f DiffFile) {
	<span class="diff-file-stats text-xs font-semibold ml-auto shrink-0 flex items-center gap-1" aria-label={ diffStatsAriaLabel(f) }>
		<span class="diff-stat-add" title="Added lines">+{ fmt.Sprintf("%d", diffStatCounts(f).Adds) }</span>
		<span class="diff-stat-del" title="Deleted lines">-{ fmt.Sprintf("%d", diffStatCounts(f).Dels) }</span>
	</span>
}

templ diffFileEmptyBody(f DiffFile) {
	<div class="p-6 bg-base-100 text-center">
		<div class="text-sm font-medium mb-1">{ diffFileSummaryText(f) }</div>
		if (f.Status == "renamed" || f.Status == "copied") && f.OldPath != "" && f.OldPath != f.Path {
			<div class="text-xs opacity-60 font-mono break-all">
				{ f.OldPath } → { f.Path }
			</div>
		}
	</div>
}

templ reviewInlineCommentRow(comment models.ReviewComment, filePath string, target reviewLineTarget, layout string) {
	<tr
		class="review-inline-comment"
		data-comment-id={ comment.ID }
		data-file-path={ filePath }
		data-line-num={ fmt.Sprintf("%d", target.LineNumber) }
		data-line-type={ target.LineType }
		data-review-layout={ layout }
	>
		if layout == "split" {
			<td class="diff-line-num px-2 py-0 border-r border-base-300 bg-base-200"></td>
			<td class="diff-line-content px-3 py-0 border-r border-base-300 bg-base-200"></td>
			<td class="diff-line-num px-2 py-0 border-r border-base-300 bg-base-200"></td>
		} else {
			<td class="diff-line-num px-2 py-0 w-12 border-r border-base-300 bg-base-200"></td>
			<td class="diff-line-num px-2 py-0 w-12 border-r border-base-300 bg-base-200"></td>
		}
		<td class="p-0 bg-warning/15">
			<div class="review-inline-comment-box p-2 pl-3 pr-8 text-xs cursor-text" data-comment-id={ comment.ID } onclick="startEditReviewComment(event)">
				<span class="review-inline-comment-bar"></span>
				<button type="button" class="btn btn-circle btn-ghost btn-xs review-delete-btn" onclick="deleteReviewComment(event)" aria-label="Delete review comment">
					<svg xmlns="http://www.w3.org/2000/svg" class="h-4 w-4" fill="none" viewBox="0 0 24 24" stroke="currentColor"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M6 18L18 6M6 6l12 12"></path></svg>
				</button>
				<p class="review-comment-text whitespace-pre-wrap break-words">{ comment.CommentText }</p>
			</div>
		</td>
	</tr>
}

templ inlineDiffFileWithReview(f DiffFile, idx int, defaultExpanded bool, taskID string, commentMap map[string][]models.ReviewComment) {
	<div id={ fmt.Sprintf("diff-file-%d", idx) } class="diff-file-card card bg-base-100 border border-base-300 scroll-mt-2">
		@diffFileHeader(f, idx, defaultExpanded, false)
		<div
			id={ fmt.Sprintf("diff-body-%d", idx) }
			class="diff-file-body overflow-hidden transition-all duration-300 ease-in-out"
			if !defaultExpanded {
				style="max-height: 0;"
			}
		>
			if !diffHasTextualContent(f) {
				@diffFileEmptyBody(f)
			} else {
				<div class="overflow-x-auto">
					<table class="diff-table w-full text-xs font-mono border-collapse">
						for _, hunk := range f.Hunks {
							<tr class="diff-hunk-header">
								<td colspan="3" class="px-3 py-1 bg-info/10 text-info text-xs select-none">{ hunk.Header }</td>
							</tr>
							for _, line := range hunk.Lines {
								<tr
									class={ "diff-review-line", inlineLineClass(line.Type) }
									data-file-path={ f.Path }
									data-line-num={ fmt.Sprintf("%d", lineNumForReview(line)) }
									data-line-type={ lineTypeForDiff(line.Type) }
								>
									<td class="diff-line-num text-right px-2 py-0 select-none opacity-40 w-12 border-r border-base-300 relative">
										if line.OldNum > 0 {
											{ fmt.Sprintf("%d", line.OldNum) }
										}
									</td>
									<td class="diff-line-num text-right px-2 py-0 select-none opacity-40 w-12 border-r border-base-300 relative">
										if line.NewNum > 0 {
											{ fmt.Sprintf("%d", line.NewNum) }
										}
										if lineHasComment(commentMap, f.Path, line) {
										}
										<button type="button" class="diff-add-comment-btn" onclick="handleAddCommentClick(event)" title="Add comment">+</button>
									</td>
									<td class="diff-line-content px-3 py-0 whitespace-pre-wrap break-all">
										<span class="diff-marker select-none opacity-50 inline-block w-4">{ lineMarker(line.Type) }</span>{ line.Content }
									</td>
								</tr>
								if lineHasComment(commentMap, f.Path, line) {
									for _, comment := range getLineComments(commentMap, f.Path, line) {
										@reviewInlineCommentRow(comment, f.Path, reviewTargetForDiffLine(line), "inline")
									}
								}
							}
						}
					</table>
				</div>
			}
		</div>
	</div>
}

templ diffViewerContent(metas []DiffFileRenderMeta, initialView string) {
	<div id="diff-viewer" class="flex flex-col h-full" data-file-count={ fmt.Sprintf("%d", len(metas)) } data-state-key={ diffViewerStateKey(metas, "") } data-initial-view={ normalizeDiffViewMode(initialView) }>
		<!-- Toolbar -->
		<div class="flex flex-wrap items-center gap-2 mb-4">
			<div class="flex items-center gap-2 flex-1">
				<span class="text-sm font-medium opacity-70">
					{ fmt.Sprintf("%d", len(metas)) } file{ fileCountSuffix(len(metas)) } changed
				</span>
				if len(metas) > 1 {
					<button
						class="btn btn-xs btn-ghost opacity-60"
						onclick="toggleAllDiffFiles(true)"
					>
						Expand All
					</button>
					<button
						class="btn btn-xs btn-ghost opacity-60"
						onclick="toggleAllDiffFiles(false)"
					>
						Collapse All
					</button>
				}
			</div>
			<div class="join ml-auto">
				<button
					class={ diffViewButtonClass("inline", initialView) }
					id="diff-btn-inline"
					onclick="switchDiffView('inline')"
				>
					Inline
				</button>
				<button
					class={ diffViewButtonClass("split", initialView) }
					id="diff-btn-split"
					onclick="switchDiffView('split')"
				>
					Split
				</button>
			</div>
		</div>
		<!-- File List -->
		if len(metas) > 1 {
			<div class="mb-4 p-3 bg-base-200 rounded-lg min-w-0 max-w-full overflow-hidden">
				<div class="text-xs font-semibold uppercase tracking-wider mb-2 opacity-60">Changed Files</div>
				<div class="flex flex-wrap gap-1 min-w-0 max-w-full overflow-hidden">
					for _, m := range metas {
						<a
							href={ templ.SafeURL(fmt.Sprintf("#diff-file-%d", m.Index)) }
							class="badge badge-sm badge-outline cursor-pointer hover:badge-primary max-w-full min-w-0 overflow-hidden"
							onclick={ templ.ComponentScript{Call: fmt.Sprintf("expandAndScrollDiffFile(%d)", m.Index)} }
						>
							<span class="block truncate min-w-0">{ diffFileName(m.File.Path) }</span>
						</a>
					}
				</div>
			</div>
		}
		<!-- Diff Content -->
		<div id="diff-content-inline" class={ diffViewContentClass("inline", initialView) }>
			for _, m := range metas {
				if m.AutoLoad {
					@inlineDiffFile(m.File, m.Index, shouldDefaultExpand(len(metas)))
				} else {
					@deferredDiffFileWithReview(m, "", "inline", false)
				}
			}
		</div>
		<div id="diff-content-split" class={ diffViewContentClass("split", initialView) }>
			for _, m := range metas {
				if m.AutoLoad {
					@splitDiffFile(m.File, m.Index, shouldDefaultExpand(len(metas)))
				} else {
					@deferredDiffFileWithReview(m, "", "split", false)
				}
			}
		</div>
		<style>
			/* Sticky file headers within the diff viewer.
			   The card cannot use any overflow other than visible —
			   overflow: hidden/auto/scroll/clip all trap position: sticky
			   against the card. Each card keeps its full rounded corners
			   and the original space-y-4 gap between files. */
			.diff-file-card {
				border-radius: var(--rounded-box, 1rem);
			}
			/* See review variant for rationale: top: -1.5rem snaps the
			   sticky header flush with #main-content's padding-box edge.
			   Keep rounded corners normally; square them only while pinned. */
			.diff-file-header {
				top: -1.5rem;
				border-top-left-radius: inherit;
				border-top-right-radius: inherit;
			}
			.diff-file-header[data-stuck="1"] {
				border-top-left-radius: 0;
				border-top-right-radius: 0;
			}
			.diff-file-header[data-stuck="1"]:hover {
				background-color: oklch(var(--b2)) !important;
			}
			[data-theme="light"] .diff-file-header[data-stuck="1"]:hover {
				background-color: var(--ov-l-bg) !important;
			}
			.diff-file-header[data-collapsed="1"] {
				border-bottom-color: transparent;
				border-bottom-left-radius: inherit;
				border-bottom-right-radius: inherit;
			}
				.diff-file-header[data-collapsed="1"] + .diff-file-body {
					max-height: 0 !important;
				}
				.diff-copy-path-btn {
					color: oklch(var(--bc) / 0.7);
				}
				.diff-copy-path-btn:hover,
				.diff-copy-path-btn:focus-visible {
					color: oklch(var(--bc));
					background-color: oklch(var(--b3) / 0.75);
				}
				.diff-file-body {
					border-bottom-left-radius: inherit;
					border-bottom-right-radius: inherit;
				}
				.diff-file-stats .diff-stat-add {
					color: var(--ov-diff-add-fg);
				}
				.diff-file-stats .diff-stat-del {
					color: var(--ov-diff-del-fg);
				}
			</style>
		<script>
				// Session-level state for diff file expand/collapse, scoped by viewer.
				if (!window._diffFileState) window._diffFileState = {};
				function diffFileStateBucket() {
				var viewer = document.getElementById('diff-viewer');
				var key = viewer ? (viewer.dataset.stateKey || 'default') : 'default';
				if (!window._diffFileState[key]) window._diffFileState[key] = {};
				return window._diffFileState[key];
			}

			function toggleDiffFile(idx) {
				var inlineBody = document.getElementById('diff-body-' + idx);
				var splitBody = document.getElementById('diff-body-split-' + idx);
				var chevron = document.getElementById('diff-chevron-' + idx);
				var chevronSplit = document.getElementById('diff-chevron-split-' + idx);

				var isExpanded = chevron && chevron.classList.contains('rotate-90');
				var newState = !isExpanded;

				// When collapsing a card whose sticky header is currently
				// pinned to the top of the scroll container, pre-scroll the
				// page so the card's top aligns with the scroller top before
				// the body animates; otherwise the sticky header's
				// containing-block constraint would drag the header
				// off-screen as the body collapses.
				if (!newState) {
					var card = null;
					[
						document.getElementById('diff-file-' + idx),
						document.getElementById('diff-file-split-' + idx)
					].some(function(candidate) {
						if (!candidate || candidate.getClientRects().length === 0) return false;
						card = candidate;
						return true;
					});
					var scroller = document.getElementById('main-content');
					if (card && scroller) {
						var cardTop = card.getBoundingClientRect().top;
						var scrollerTop = scroller.getBoundingClientRect().top;
						if (cardTop < scrollerTop) {
							scroller.scrollTop -= (scrollerTop - cardTop);
						}
					}
				}

				// Update inline view
				if (inlineBody) {
					if (newState) {
						inlineBody.style.maxHeight = inlineBody.scrollHeight + 'px';
						// After transition, remove max-height so content can resize
						setTimeout(function() { inlineBody.style.maxHeight = ''; }, 300);
					} else {
						inlineBody.style.maxHeight = inlineBody.scrollHeight + 'px';
						// Force reflow then collapse
						inlineBody.offsetHeight;
						inlineBody.style.maxHeight = '0';
					}
				}

				// Update split view
				if (splitBody) {
					if (newState) {
						splitBody.style.maxHeight = splitBody.scrollHeight + 'px';
						setTimeout(function() { splitBody.style.maxHeight = ''; }, 300);
					} else {
						splitBody.style.maxHeight = splitBody.scrollHeight + 'px';
						splitBody.offsetHeight;
						splitBody.style.maxHeight = '0';
					}
				}

				// Update chevrons
				if (chevron) chevron.classList.toggle('rotate-90', newState);
				if (chevronSplit) chevronSplit.classList.toggle('rotate-90', newState);

				document.querySelectorAll('[data-diff-toggle="' + idx + '"]').forEach(function(el) {
					if (newState) el.removeAttribute('data-collapsed');
					else el.setAttribute('data-collapsed', '1');
				});

				// Persist state
				diffFileStateBucket()[idx] = newState;
			}

			function toggleAllDiffFiles(expand) {
				var viewer = document.getElementById('diff-viewer');
				if (!viewer) return;
				var count = parseInt(viewer.dataset.fileCount || '0');
				for (var i = 0; i < count; i++) {
					var chevron = document.getElementById('diff-chevron-' + i);
					var isExpanded = chevron && chevron.classList.contains('rotate-90');
					if (isExpanded !== expand) {
						toggleDiffFile(i);
					}
				}
			}

			function expandAndScrollDiffFile(idx) {
				var chevron = document.getElementById('diff-chevron-' + idx);
				var isExpanded = chevron && chevron.classList.contains('rotate-90');
				if (!isExpanded) {
					toggleDiffFile(idx);
				}
				// Scroll after a small delay to allow expansion
				setTimeout(function() {
					var el = document.getElementById('diff-file-' + idx);
					if (el) el.scrollIntoView({behavior: 'smooth', block: 'start'});
				}, 50);
			}

			// Restore persisted expand/collapse state after initial render and after
			// HTMX swaps. Deferred file-card swaps render expanded by default, so the
			// saved state must be re-applied to the body, chevrons, and header shape.
			window._restoreDiffFileState = window._restoreDiffFileState || function() {
				var viewer = document.getElementById('diff-viewer');
				if (!viewer || !window._diffFileState) return;
				var state = diffFileStateBucket();
				var count = parseInt(viewer.dataset.fileCount || '0');
				for (var i = 0; i < count; i++) {
					if (state.hasOwnProperty(i)) {
						var savedExpanded = state[i];
						var bodies = [
							document.getElementById('diff-body-' + i),
							document.getElementById('diff-body-split-' + i)
						];
						var chevrons = [
							document.getElementById('diff-chevron-' + i),
							document.getElementById('diff-chevron-split-' + i)
						];
						bodies.forEach(function(body) {
							if (!body) return;
							body.style.transition = 'none';
							body.style.maxHeight = savedExpanded ? '' : '0';
							body.offsetHeight;
							body.style.transition = '';
						});
						chevrons.forEach(function(c) {
							if (!c) return;
							var previousTransition = c.style.transition;
							c.style.transition = 'none';
							c.classList.toggle('rotate-90', savedExpanded);
							c.getBoundingClientRect();
							c.style.transition = previousTransition;
						});
						document.querySelectorAll('[data-diff-toggle="' + i + '"]').forEach(function(el) {
							if (savedExpanded) el.removeAttribute('data-collapsed');
							else el.setAttribute('data-collapsed', '1');
						});
					}
				}
			};
			window._restoreDiffFileState();
			if (!window._diffFileStateRestoreRegistered) {
				window._diffFileStateRestoreRegistered = true;
				['htmx:afterSwap', 'htmx:afterSettle'].forEach(function(eventName) {
					document.body.addEventListener(eventName, window._restoreDiffFileState);
				});
			}

			function copyDiffFilePath(ev, button) {
				if (ev) {
					ev.preventDefault();
					ev.stopPropagation();
				}
				var text = button && button.dataset ? button.dataset.copyPath : '';
				if (!text) {
					if (window.showToast) window.showToast('No file path to copy', 'failed');
					return;
				}

				function setCopiedState() {
					if (!button) return;
					var originalHTML = button.innerHTML;
					button.classList.add('btn-success');
					button.innerHTML = '<svg xmlns="http://www.w3.org/2000/svg" class="h-4 w-4" fill="none" viewBox="0 0 24 24" stroke="currentColor" aria-hidden="true"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M5 13l4 4L19 7"></path></svg>';
					setTimeout(function() {
						button.classList.remove('btn-success');
						button.innerHTML = originalHTML;
					}, 1200);
				}

				function onCopySuccess() {
					setCopiedState();
				}

				function onCopyFailure() {
					if (window.showToast) window.showToast('Failed to copy file path', 'failed');
				}

				function fallbackCopy() {
					var textarea = document.createElement('textarea');
					textarea.value = text;
					textarea.setAttribute('readonly', '');
					textarea.style.position = 'fixed';
					textarea.style.opacity = '0';
					document.body.appendChild(textarea);
					textarea.select();
					textarea.setSelectionRange(0, textarea.value.length);
					try {
						if (document.execCommand('copy')) onCopySuccess();
						else onCopyFailure();
					} catch (e) {
						onCopyFailure();
					} finally {
						document.body.removeChild(textarea);
					}
				}

				if (navigator.clipboard && typeof navigator.clipboard.writeText === 'function') {
					navigator.clipboard.writeText(text).then(onCopySuccess).catch(fallbackCopy);
					return;
				}
				fallbackCopy();
			}

			function persistDiffViewPreference(mode) {
				try {
					fetch('/ui/preferences', {
						method: 'POST',
						headers: { 'Content-Type': 'application/json' },
						body: JSON.stringify({ diff_view: mode }),
						keepalive: true
					}).catch(function() {});
				} catch (_) {}
			}

			function switchDiffView(mode, persist) {
				var inlineEl = document.getElementById('diff-content-inline');
				var splitEl = document.getElementById('diff-content-split');
				var btnInline = document.getElementById('diff-btn-inline');
				var btnSplit = document.getElementById('diff-btn-split');
				if (!inlineEl || !splitEl || !btnInline || !btnSplit) return;

				if (mode === 'split') {
					inlineEl.classList.add('hidden');
					splitEl.classList.remove('hidden');
					btnSplit.classList.add('btn-active');
					btnInline.classList.remove('btn-active');
				} else {
					splitEl.classList.add('hidden');
					inlineEl.classList.remove('hidden');
					btnInline.classList.add('btn-active');
					btnSplit.classList.remove('btn-active');
				}
				if (persist !== false) {
					persistDiffViewPreference(mode === 'split' ? 'split' : 'inline');
				}
			}

			// Track when sticky diff file headers are pinned. Headers keep their
			// original rounded corners in normal flow, then square their top
			// corners while pinned so diff rows cannot show through the radius.
			window._wireDiffStickyHeaders = window._wireDiffStickyHeaders || (function() {
				var ticking = false;

				function updateStickyHeaders() {
					ticking = false;
					var scroller = document.getElementById("main-content");
					var rootTop = scroller ? scroller.getBoundingClientRect().top : 0;
					var viewer = document.getElementById("diff-viewer") || document;
					viewer.querySelectorAll(".diff-file-header").forEach(function(header) {
						var sentinel = header.previousElementSibling;
						if (!sentinel || sentinel.getAttribute("data-diff-sticky-sentinel") !== "1") return;
						if (sentinel.getBoundingClientRect().top <= rootTop + 1) {
							header.setAttribute("data-stuck", "1");
						} else {
							header.removeAttribute("data-stuck");
						}
					});
				}

				function scheduleUpdate() {
					if (ticking) return;
					ticking = true;
					requestAnimationFrame(updateStickyHeaders);
				}

				return function() {
					var viewer = document.getElementById("diff-viewer") || document;
					viewer.querySelectorAll(".diff-file-header:not([data-sticky-wired])").forEach(function(header) {
						var sentinel = document.createElement("div");
						sentinel.style.cssText = "height:1px;margin-bottom:-1px;pointer-events:none;";
						sentinel.setAttribute("aria-hidden", "true");
						sentinel.setAttribute("data-diff-sticky-sentinel", "1");
						header.parentNode.insertBefore(sentinel, header);
						header.setAttribute("data-sticky-wired", "1");
					});
					scheduleUpdate();
				};
			})();
			window._wireDiffStickyHeaders();
			if (!window._diffStickyHeadersScrollRegistered) {
				window._diffStickyHeadersScrollRegistered = true;
				var diffScroller = document.getElementById("main-content");
				if (diffScroller) diffScroller.addEventListener("scroll", window._wireDiffStickyHeaders, { passive: true });
				window.addEventListener("resize", window._wireDiffStickyHeaders);
				document.body.addEventListener("htmx:afterSettle", window._wireDiffStickyHeaders);
			}

		</script>
	</div>
}

templ inlineDiffFile(f DiffFile, idx int, defaultExpanded bool) {
	<div id={ fmt.Sprintf("diff-file-%d", idx) } class="diff-file-card card bg-base-100 border border-base-300 scroll-mt-2">
		@diffFileHeader(f, idx, defaultExpanded, false)
		<div
			id={ fmt.Sprintf("diff-body-%d", idx) }
			class="diff-file-body overflow-hidden transition-all duration-300 ease-in-out"
			if !defaultExpanded {
				style="max-height: 0;"
			}
		>
			if !diffHasTextualContent(f) {
				@diffFileEmptyBody(f)
			} else {
				<div class="overflow-x-auto">
					<table class="diff-table w-full text-xs font-mono border-collapse">
						for _, hunk := range f.Hunks {
							<tr class="diff-hunk-header">
								<td colspan="3" class="px-3 py-1 bg-info/10 text-info text-xs select-none">{ hunk.Header }</td>
							</tr>
							for _, line := range hunk.Lines {
								<tr class={ inlineLineClass(line.Type) }>
									<td class="diff-line-num text-right px-2 py-0 select-none opacity-40 w-12 border-r border-base-300">
										if line.OldNum > 0 {
											{ fmt.Sprintf("%d", line.OldNum) }
										}
									</td>
									<td class="diff-line-num text-right px-2 py-0 select-none opacity-40 w-12 border-r border-base-300">
										if line.NewNum > 0 {
											{ fmt.Sprintf("%d", line.NewNum) }
										}
									</td>
									<td class="diff-line-content px-3 py-0 whitespace-pre-wrap break-all">
										<span class="diff-marker select-none opacity-50 inline-block w-4">{ lineMarker(line.Type) }</span>{ line.Content }
									</td>
								</tr>
							}
						}
					</table>
				</div>
			}
		</div>
	</div>
}

templ splitDiffFileWithReview(f DiffFile, idx int, defaultExpanded bool, taskID string, commentMap map[string][]models.ReviewComment) {
	<div id={ fmt.Sprintf("diff-file-split-%d", idx) } class="diff-file-card card bg-base-100 border border-base-300 scroll-mt-2">
		@diffFileHeader(f, idx, defaultExpanded, true)
		<div
			id={ fmt.Sprintf("diff-body-split-%d", idx) }
			class="diff-file-body overflow-hidden transition-all duration-300 ease-in-out"
			if !defaultExpanded {
				style="max-height: 0;"
			}
		>
			if !diffHasTextualContent(f) {
				@diffFileEmptyBody(f)
			} else {
				<div class="overflow-x-auto">
					<table class="diff-table w-full text-xs font-mono border-collapse">
						<colgroup>
							<col style="width: 40px"/>
							<col style="width: 50%"/>
							<col style="width: 40px"/>
							<col style="width: 50%"/>
						</colgroup>
						for _, hunk := range f.Hunks {
							<tr class="diff-hunk-header">
								<td colspan="4" class="px-3 py-1 bg-info/10 text-info text-xs select-none">{ hunk.Header }</td>
							</tr>
							for _, pair := range buildSplitLines(hunk.Lines) {
								<tr
									class="diff-review-line"
									data-file-path={ f.Path }
									data-line-num={ fmt.Sprintf("%d", lineNumForReview(pair.Right)) }
									data-line-type={ lineTypeForDiff(pair.Right.Type) }
									data-review-layout="split"
									data-review-side="right"
								>
									<td class={ "diff-line-num text-right px-2 py-0 select-none opacity-40 border-r border-base-300", splitCellBg(pair.Left.Type) }>
										if pair.Left.Type != "empty" && pair.Left.OldNum > 0 {
											{ fmt.Sprintf("%d", pair.Left.OldNum) }
										}
									</td>
									<td class={ "diff-line-content px-3 py-0 whitespace-pre-wrap break-all border-r border-base-300", splitCellBg(pair.Left.Type) }>
										if pair.Left.Type != "empty" {
											{ pair.Left.Content }
										}
									</td>
									<td class={ "diff-line-num text-right px-2 py-0 select-none opacity-40 border-r border-base-300 relative", splitCellBg(pair.Right.Type) }>
										if pair.Right.Type != "empty" && pair.Right.NewNum > 0 {
											{ fmt.Sprintf("%d", pair.Right.NewNum) }
										}
										if pair.Right.Type != "empty" && lineHasComment(commentMap, f.Path, pair.Right) {
										}
										if pair.Right.Type != "empty" {
											<button type="button" class="diff-add-comment-btn" onclick="handleAddCommentClick(event)" title="Add comment">+</button>
										}
									</td>
									<td class={ "diff-line-content px-3 py-0 whitespace-pre-wrap break-all", splitCellBg(pair.Right.Type) }>
										if pair.Right.Type != "empty" {
											{ pair.Right.Content }
										}
									</td>
								</tr>
								if pair.Right.Type != "empty" && lineHasComment(commentMap, f.Path, pair.Right) {
									for _, comment := range getLineComments(commentMap, f.Path, pair.Right) {
										@reviewInlineCommentRow(comment, f.Path, reviewTargetForDiffLine(pair.Right), "split")
									}
								}
							}
						}
					</table>
				</div>
			}
		</div>
	</div>
}

templ splitDiffFile(f DiffFile, idx int, defaultExpanded bool) {
	<div id={ fmt.Sprintf("diff-file-split-%d", idx) } class="diff-file-card card bg-base-100 border border-base-300 scroll-mt-2">
		@diffFileHeader(f, idx, defaultExpanded, true)
		<div
			id={ fmt.Sprintf("diff-body-split-%d", idx) }
			class="diff-file-body overflow-hidden transition-all duration-300 ease-in-out"
			if !defaultExpanded {
				style="max-height: 0;"
			}
		>
			if !diffHasTextualContent(f) {
				@diffFileEmptyBody(f)
			} else {
				<div class="overflow-x-auto">
					<table class="diff-table w-full text-xs font-mono border-collapse">
						<colgroup>
							<col style="width: 40px"/>
							<col style="width: 50%"/>
							<col style="width: 40px"/>
							<col style="width: 50%"/>
						</colgroup>
						for _, hunk := range f.Hunks {
							<tr class="diff-hunk-header">
								<td colspan="4" class="px-3 py-1 bg-info/10 text-info text-xs select-none">{ hunk.Header }</td>
							</tr>
							for _, pair := range buildSplitLines(hunk.Lines) {
								<tr>
									<!-- Left side (old) -->
									<td class={ "diff-line-num text-right px-2 py-0 select-none opacity-40 border-r border-base-300", splitCellBg(pair.Left.Type) }>
										if pair.Left.Type != "empty" && pair.Left.OldNum > 0 {
											{ fmt.Sprintf("%d", pair.Left.OldNum) }
										}
									</td>
									<td class={ "diff-line-content px-3 py-0 whitespace-pre-wrap break-all border-r border-base-300", splitCellBg(pair.Left.Type) }>
										if pair.Left.Type != "empty" {
											{ pair.Left.Content }
										}
									</td>
									<!-- Right side (new) -->
									<td class={ "diff-line-num text-right px-2 py-0 select-none opacity-40 border-r border-base-300", splitCellBg(pair.Right.Type) }>
										if pair.Right.Type != "empty" && pair.Right.NewNum > 0 {
											{ fmt.Sprintf("%d", pair.Right.NewNum) }
										}
									</td>
									<td class={ "diff-line-content px-3 py-0 whitespace-pre-wrap break-all", splitCellBg(pair.Right.Type) }>
										if pair.Right.Type != "empty" {
											{ pair.Right.Content }
										}
									</td>
								</tr>
							}
						}
					</table>
				</div>
			}
		</div>
	</div>
}

// SplitPair represents a side-by-side line pair
type SplitPair struct {
	Left  DiffLine
	Right DiffLine
}

func buildSplitLines(lines []DiffLine) []SplitPair {
	var pairs []SplitPair
	var delQueue []DiffLine
	var addQueue []DiffLine

	flushQueues := func() {
		maxLen := len(delQueue)
		if len(addQueue) > maxLen {
			maxLen = len(addQueue)
		}
		for i := 0; i < maxLen; i++ {
			pair := SplitPair{
				Left:  DiffLine{Type: "empty"},
				Right: DiffLine{Type: "empty"},
			}
			if i < len(delQueue) {
				pair.Left = delQueue[i]
			}
			if i < len(addQueue) {
				pair.Right = addQueue[i]
			}
			pairs = append(pairs, pair)
		}
		delQueue = nil
		addQueue = nil
	}

	for _, line := range lines {
		switch line.Type {
		case "del":
			if len(addQueue) > 0 {
				flushQueues()
			}
			delQueue = append(delQueue, line)
		case "add":
			addQueue = append(addQueue, line)
		case "ctx":
			flushQueues()
			pairs = append(pairs, SplitPair{Left: line, Right: line})
		}
	}
	flushQueues()
	return pairs
}

func inlineLineClass(lineType string) string {
	switch lineType {
	case "add":
		return "bg-success/10"
	case "del":
		return "bg-error/10"
	default:
		return ""
	}
}

func splitCellBg(lineType string) string {
	switch lineType {
	case "add":
		return "bg-success/10"
	case "del":
		return "bg-error/10"
	case "empty":
		return "bg-base-200/50"
	default:
		return ""
	}
}

func lineMarker(lineType string) string {
	switch lineType {
	case "add":
		return "+"
	case "del":
		return "-"
	default:
		return " "
	}
}

func diffFileStatusValue(status string) string {
	switch status {
	case "added", "deleted", "renamed", "copied", "modified":
		return status
	default:
		return "modified"
	}
}

// diffFileStatusLabel returns a short human label for a DiffFile.Status value.
// Unknown or empty statuses fall back to "Modified" so the badge is always
// populated.
func diffFileStatusLabel(status string) string {
	switch diffFileStatusValue(status) {
	case "added":
		return "Added"
	case "deleted":
		return "Deleted"
	case "renamed":
		return "Renamed"
	case "copied":
		return "Copied"
	default:
		return "Modified"
	}
}

// diffFileStatusBadgeClass returns the DaisyUI badge class for a status.
func diffFileStatusBadgeClass(status string) string {
	switch diffFileStatusValue(status) {
	case "added":
		return "badge badge-success badge-sm"
	case "deleted":
		return "badge badge-error badge-sm"
	case "renamed":
		return "badge badge-info badge-sm"
	case "copied":
		return "badge badge-info badge-sm badge-outline"
	default:
		return "badge badge-ghost badge-sm"
	}
}

// diffHasTextualContent reports whether the file has any non-empty hunks.
// Pure renames with similarity index 100% and binary changes have no
// textual content; the UI substitutes an explicit placeholder body for them.
func diffHasTextualContent(f DiffFile) bool {
	for _, h := range f.Hunks {
		if len(h.Lines) > 0 {
			return true
		}
	}
	return false
}

// diffFileSummaryText returns a one-line description of the file change for
// use in the body when there are no textual hunks (pure rename, binary
// add/delete, empty file add).
func diffFileSummaryText(f DiffFile) string {
	switch {
	case f.IsBinary && f.Status == "added":
		return "Binary file added."
	case f.IsBinary && f.Status == "deleted":
		return "Binary file deleted."
	case f.IsBinary:
		return "Binary file changed."
	case f.Status == "renamed" && f.OldPath != "" && f.OldPath != f.Path:
		if f.SimilarityIndex == 100 {
			return fmt.Sprintf("File renamed from %s with no content changes.", f.OldPath)
		}
		return fmt.Sprintf("File renamed from %s.", f.OldPath)
	case f.Status == "copied" && f.OldPath != "" && f.OldPath != f.Path:
		return fmt.Sprintf("File copied from %s.", f.OldPath)
	case f.Status == "added":
		return "Empty file added."
	case f.Status == "deleted":
		return "Empty file deleted."
	default:
		return "No textual changes."
	}
}

// diffFileDisplayPath returns the path string shown in the file header.
// For renames/copies we render "old → new" so the move is visible at a
// glance instead of only displaying the new path.
func diffFileDisplayPath(f DiffFile) string {
	if (f.Status == "renamed" || f.Status == "copied") && f.OldPath != "" && f.OldPath != f.Path {
		return f.OldPath + " → " + f.Path
	}
	return f.Path
}

func diffFileName(path string) string {
	parts := strings.Split(path, "/")
	if len(parts) > 2 {
		return ".../" + strings.Join(parts[len(parts)-2:], "/")
	}
	return path
}

type diffStatCount struct {
	Adds int
	Dels int
}

func diffStatCounts(f DiffFile) diffStatCount {
	counts := diffStatCount{}
	for _, h := range f.Hunks {
		for _, l := range h.Lines {
			if l.Type == "add" {
				counts.Adds++
			} else if l.Type == "del" {
				counts.Dels++
			}
		}
	}
	return counts
}

func diffStats(f DiffFile) string {
	counts := diffStatCounts(f)
	return fmt.Sprintf("+%d -%d", counts.Adds, counts.Dels)
}

func diffStatsAriaLabel(f DiffFile) string {
	counts := diffStatCounts(f)
	return fmt.Sprintf("%d added lines, %d deleted lines", counts.Adds, counts.Dels)
}

func fileCountSuffix(n int) string {
	if n == 1 {
		return ""
	}
	return "s"
}

func diffFileMetrics(f DiffFile) (int, int) {
	totalLines := 0
	totalChars := 0
	for _, h := range f.Hunks {
		totalChars += len(h.Header)
		for _, l := range h.Lines {
			totalLines++
			totalChars += len(l.Content)
		}
	}
	return totalLines, totalChars
}

func buildDiffRenderMetas(files []DiffFile) []DiffFileRenderMeta {
	metas := make([]DiffFileRenderMeta, 0, minInt(len(files), maxDiffFiles))
	cumulativeLines := 0
	cumulativeChars := 0

	for i, f := range files {
		if i >= maxDiffFiles {
			break
		}

		lineCount, charCount := diffFileMetrics(f)
		meta := buildDiffRenderMeta(f, i, lineCount, charCount, cumulativeLines, cumulativeChars)
		if meta.AutoLoad || meta.CanLoadOnDemand {
			cumulativeLines += lineCount
			cumulativeChars += charCount
		}

		metas = append(metas, meta)
	}

	return metas
}

func buildDiffRenderMeta(f DiffFile, index int, lineCount int, charCount int, cumulativeLines int, cumulativeChars int) DiffFileRenderMeta {
	meta := DiffFileRenderMeta{
		Index:     index,
		File:      f,
		LineCount: lineCount,
		CharCount: charCount,
	}

	switch {
	case lineCount > maxLoadableFileDiffLines || charCount > maxLoadableFileDiffChars:
		meta.BlockedReason = fmt.Sprintf(
			"This file exceeds single-file limit (%d lines or %s raw diff).",
			maxLoadableFileDiffLines,
			formatByteSize(maxLoadableFileDiffChars),
		)
	case cumulativeLines+lineCount > maxLoadableTotalDiffLines || cumulativeChars+charCount > maxLoadableTotalDiffChars:
		meta.BlockedReason = fmt.Sprintf(
			"Total diff load limit reached (%d lines or %s raw diff).",
			maxLoadableTotalDiffLines,
			formatByteSize(maxLoadableTotalDiffChars),
		)
	default:
		if lineCount <= autoLoadFileDiffLines && charCount <= autoLoadFileDiffChars {
			meta.AutoLoad = true
		} else {
			meta.CanLoadOnDemand = true
		}
	}

	return meta
}

// DiffRenderMetaByIndex extracts render metadata for one diff file without
// parsing every later file in the diff output. It preserves the same per-file
// and cumulative load-limit decisions as buildDiffRenderMetas for the requested
// index by scanning previous file blocks only for their rendered line metrics.
func DiffRenderMetaByIndex(diffOutput string, fileIndex int) (DiffFileRenderMeta, bool) {
	meta, _, ok := diffRenderMetaByIndexWithParsedBytes(diffOutput, fileIndex)
	return meta, ok
}

func diffRenderMetaByIndexWithParsedBytes(diffOutput string, fileIndex int) (DiffFileRenderMeta, int, bool) {
	if diffOutput == "" || fileIndex < 0 || fileIndex >= maxDiffFiles {
		return DiffFileRenderMeta{}, 0, false
	}

	cumulativeLines := 0
	cumulativeChars := 0
	currentIndex := -1
	blockStart := -1
	parsedBytes := 0

	for lineStart := 0; lineStart <= len(diffOutput); {
		if lineStart == len(diffOutput) {
			break
		}
		lineEnd := strings.IndexByte(diffOutput[lineStart:], '\n')
		nextLineStart := len(diffOutput)
		line := diffOutput[lineStart:]
		if lineEnd >= 0 {
			nextLineStart = lineStart + lineEnd + 1
			line = diffOutput[lineStart : lineStart+lineEnd]
		}

		if strings.HasPrefix(line, "diff --git ") {
			if currentIndex >= 0 {
				blockEnd := lineStart
				if currentIndex == fileIndex {
					return diffRenderMetaFromBlock(diffOutput[blockStart:blockEnd], fileIndex, cumulativeLines, cumulativeChars), blockEnd, true
				}
				lines, chars := diffBlockMetrics(diffOutput[blockStart:blockEnd])
				if previousDiffFileCountsTowardTotal(lines, chars, cumulativeLines, cumulativeChars) {
					cumulativeLines += lines
					cumulativeChars += chars
				}
			}
			currentIndex++
			if currentIndex >= maxDiffFiles {
				return DiffFileRenderMeta{}, lineStart, false
			}
			blockStart = lineStart
		}

		if nextLineStart == len(diffOutput) {
			break
		}
		lineStart = nextLineStart
	}

	if currentIndex == fileIndex && blockStart >= 0 {
		parsedBytes = len(diffOutput)
		return diffRenderMetaFromBlock(diffOutput[blockStart:], fileIndex, cumulativeLines, cumulativeChars), parsedBytes, true
	}
	if blockStart >= 0 {
		parsedBytes = len(diffOutput)
	}
	return DiffFileRenderMeta{}, parsedBytes, false
}

func diffRenderMetaFromBlock(block string, fileIndex int, cumulativeLines int, cumulativeChars int) DiffFileRenderMeta {
	files := ParseDiffOutput(block)
	if len(files) == 0 {
		return DiffFileRenderMeta{}
	}
	lineCount, charCount := diffFileMetrics(files[0])
	return buildDiffRenderMeta(files[0], fileIndex, lineCount, charCount, cumulativeLines, cumulativeChars)
}

func previousDiffFileCountsTowardTotal(lineCount int, charCount int, cumulativeLines int, cumulativeChars int) bool {
	if lineCount > maxLoadableFileDiffLines || charCount > maxLoadableFileDiffChars {
		return false
	}
	if cumulativeLines+lineCount > maxLoadableTotalDiffLines || cumulativeChars+charCount > maxLoadableTotalDiffChars {
		return false
	}
	return true
}

func diffBlockMetrics(block string) (int, int) {
	lineCount := 0
	charCount := 0
	inHunk := false
	for lineStart := 0; lineStart <= len(block); {
		if lineStart == len(block) {
			break
		}
		lineEnd := strings.IndexByte(block[lineStart:], '\n')
		nextLineStart := len(block)
		line := block[lineStart:]
		if lineEnd >= 0 {
			nextLineStart = lineStart + lineEnd + 1
			line = block[lineStart : lineStart+lineEnd]
		}

		switch {
		case strings.HasPrefix(line, "@@"):
			inHunk = true
			charCount += len(line)
		case line == `\ No newline at end of file`:
		case inHunk && (strings.HasPrefix(line, "+") || strings.HasPrefix(line, "-") || strings.HasPrefix(line, " ") || line == ""):
			lineCount++
			if line == "" {
				break
			}
			charCount += len(line) - 1
		case !inHunk && diffLineWouldSynthesizeHunk(line):
			inHunk = true
			lineCount++
			charCount += len(line) - 1
		}

		if nextLineStart == len(block) {
			break
		}
		lineStart = nextLineStart
	}
	return lineCount, charCount
}

func diffLineWouldSynthesizeHunk(line string) bool {
	if line == "" || strings.HasPrefix(line, "diff --git ") || strings.HasPrefix(line, "--- ") || strings.HasPrefix(line, "+++ ") {
		return false
	}
	if strings.HasPrefix(line, "index ") || strings.HasPrefix(line, "new file") || strings.HasPrefix(line, "deleted file") || strings.HasPrefix(line, "old mode") || strings.HasPrefix(line, "new mode") || strings.HasPrefix(line, "Binary files") || strings.HasPrefix(line, "# Untracked") || strings.HasPrefix(line, "# + ") {
		return false
	}
	return strings.HasPrefix(line, "+") || strings.HasPrefix(line, "-") || strings.HasPrefix(line, " ")
}

func diffFileCardID(idx int, view string) string {
	if view == "split" {
		return fmt.Sprintf("diff-file-split-%d", idx)
	}
	return fmt.Sprintf("diff-file-%d", idx)
}

func diffFileCardTargetSelector(idx int, view string) string {
	return "#" + diffFileCardID(idx, view)
}

templ deferredDiffFileWithReview(meta DiffFileRenderMeta, taskID string, view string, reviewMode bool) {
	<div
		id={ diffFileCardID(meta.Index, view) }
		class="diff-file-card card bg-base-100 border border-base-300 scroll-mt-2"
	>
		@diffFileHeader(meta.File, meta.Index, true, view == "split")
		<div
			if view == "split" {
				id={ fmt.Sprintf("diff-body-split-%d", meta.Index) }
			} else {
				id={ fmt.Sprintf("diff-body-%d", meta.Index) }
			}
			class="diff-file-body overflow-hidden transition-all duration-300 ease-in-out"
		>
			<div class="p-6 bg-base-100 text-center">
				if meta.CanLoadOnDemand {
					<div class="text-sm font-medium mb-1">Large file diff not shown by default</div>
					<div class="text-xs opacity-60 mb-4">
						Auto-load is limited to { fmt.Sprintf("%d lines / %s", autoLoadFileDiffLines, formatByteSize(autoLoadFileDiffChars)) } per file.
					</div>
					<button
						class="btn btn-sm btn-primary"
						hx-get={ fmt.Sprintf("/tasks/%s/changes/file?file_index=%d&view=%s&review=%t", taskID, meta.Index, view, reviewMode) }
						hx-target={ diffFileCardTargetSelector(meta.Index, view) }
						hx-swap="outerHTML"
					>
						Load diff
					</button>
				} else {
					<div class="text-sm font-medium mb-1">Diff not available</div>
					<div class="text-xs opacity-60">{ meta.BlockedReason }</div>
				}
			</div>
		</div>
	</div>
}

templ LoadDiffFileCard(diffOutput string, fileIndex int, view string, taskID string, reviewComments []models.ReviewComment, reviewMode bool) {
	if meta, exists := DiffRenderMetaByIndex(diffOutput, fileIndex); exists {
		@LoadDiffFileCardMeta(meta, true, view, taskID, reviewComments, reviewMode)
	} else {
		@LoadDiffFileCardMeta(DiffFileRenderMeta{}, false, view, taskID, reviewComments, reviewMode)
	}
}

templ LoadDiffFileCardMeta(meta DiffFileRenderMeta, exists bool, view string, taskID string, reviewComments []models.ReviewComment, reviewMode bool) {
	if !exists {
		<div class="alert alert-warning">
			<span>Unable to load diff file.</span>
		</div>
	} else if !isDiffRenderMetaLoadable(meta) {
		<div class="alert alert-warning">
			<span>{ meta.BlockedReason }</span>
		</div>
	} else if view == "split" {
		if reviewMode {
			@splitDiffFileWithReview(meta.File, meta.Index, true, taskID, buildCommentMap(reviewComments))
		} else {
			@splitDiffFile(meta.File, meta.Index, true)
		}
	} else {
		if reviewMode {
			@inlineDiffFileWithReview(meta.File, meta.Index, true, taskID, buildCommentMap(reviewComments))
		} else {
			@inlineDiffFile(meta.File, meta.Index, true)
		}
	}
}

func getDiffRenderMetaByIndex(files []DiffFile, fileIndex int) (DiffFileRenderMeta, bool) {
	metas := buildDiffRenderMetas(files)
	for _, meta := range metas {
		if meta.Index == fileIndex {
			return meta, true
		}
	}
	return DiffFileRenderMeta{}, false
}

func diffFileMetaExists(diffOutput string, fileIndex int) bool {
	_, ok := DiffRenderMetaByIndex(diffOutput, fileIndex)
	return ok
}

func diffRenderMetaByIndexOrZero(diffOutput string, fileIndex int) DiffFileRenderMeta {
	meta, _ := DiffRenderMetaByIndex(diffOutput, fileIndex)
	return meta
}

func isDiffRenderMetaLoadable(meta DiffFileRenderMeta) bool {
	return meta.AutoLoad || meta.CanLoadOnDemand
}

func diffViewerStateKey(metas []DiffFileRenderMeta, taskID string) string {
	var b strings.Builder
	if taskID != "" {
		b.WriteString("task:")
		b.WriteString(taskID)
		b.WriteString("|")
	}
	b.WriteString(fmt.Sprintf("files:%d", len(metas)))
	for _, m := range metas {
		b.WriteString("|")
		b.WriteString(strconv.Itoa(m.Index))
		b.WriteString(":")
		b.WriteString(m.File.Status)
		b.WriteString(":")
		b.WriteString(m.File.OldPath)
		b.WriteString("->")
		b.WriteString(m.File.Path)
	}
	return b.String()
}

func formatByteSize(bytes int) string {
	if bytes < 1024 {
		return fmt.Sprintf("%d B", bytes)
	}
	if bytes < 1024*1024 {
		return fmt.Sprintf("%d KB", bytes/1024)
	}
	return fmt.Sprintf("%.1f MB", float64(bytes)/(1024*1024))
}

func minInt(a int, b int) int {
	if a < b {
		return a
	}
	return b
}

// shouldDefaultExpand returns true so all diff files are expanded by default.
func shouldDefaultExpand(fileCount int) bool {
	return true
}
