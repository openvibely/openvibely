package components

import templpkg "github.com/a-h/templ"
import "github.com/openvibely/openvibely/internal/models"

type channelAuthorizationListConfig struct {
	ContainerID        string
	Description        string
	EmptyState         string
	RemoveConfirmation string
	AddHelp            string
}
type channelAuthorizationRow struct {
	Identity       templpkg.Component
	ProjectID      string // Legacy call compatibility; not a management boundary.
	DeleteEndpoint string
	ID             string
	Channel        string
	Mapping        models.ChannelSenderMapping
}
type channelAuthorizationAddConfig struct {
	ProjectID        string
	Endpoint         string
	InputType        string
	InputName        string
	InputPlaceholder string
}

templ channelSenderSelect(value string) {
	<select name="application_user_id" aria-label="OV user" class="select select-bordered select-sm">
		<option value="" selected?={ value == "" }>Select OV user</option>
		for _, user := range models.SenderOptions(ctx).Users {
			if !user.Disabled {
				<option value={ user.UserID } selected?={ value == user.UserID }>{ user.DisplayName } ({ user.Username })</option>
			}
		}
	</select>
}

templ channelAuthorizationList(config channelAuthorizationListConfig, rows []channelAuthorizationRow, addConfig channelAuthorizationAddConfig) {
	<div id={ config.ContainerID }>
		<p class="text-xs opacity-60 mb-2">{ config.Description }</p>
		if len(rows) == 0 {
			<p class="text-sm opacity-50 italic mb-3">{ config.EmptyState }</p>
		}
		<div class="space-y-2 mb-3">
			for _, row := range rows {
				if models.CanManageSender(ctx, row.Mapping.ApplicationUserID) {
					<div class="flex flex-wrap items-center gap-2 bg-base-200 rounded-lg px-3 py-2" id={ config.ContainerID + "-" + row.ID }>
						<div class="flex-1">@row.Identity</div>
						if row.Mapping.MappingReview {
							<span class="text-xs text-warning">Review mapping</span>
						}
						<label class="text-xs">OV user @channelSenderSelect(row.Mapping.ApplicationUserID)</label>
						if row.Channel == "slack" {
							<input class="input input-bordered input-sm" name="team_id" aria-label="Slack workspace ID" placeholder="Workspace ID (T…)" value={ row.Mapping.TeamID }/>
						}
						<button type="button" class="btn btn-sm" hx-params="application_user_id,team_id" hx-vals="js:{...Object.fromEntries(Array.from(this.parentElement.querySelectorAll('input,select')).map(el => [el.name, el.value]))}" hx-post={ "/channels/" + row.Channel + "/senders/" + row.ID } hx-include={ "#" + config.ContainerID + "-" + row.ID } hx-target={ "#" + config.ContainerID } hx-swap="outerHTML">Save</button>
						<button type="button" class="btn btn-ghost btn-xs text-error" hx-params="none" hx-delete={ row.DeleteEndpoint } hx-target={ "#" + config.ContainerID } hx-swap="outerHTML" hx-confirm={ config.RemoveConfirmation }>Remove</button>
					</div>
				}
			}
		</div>
		if config.AddHelp != "" {
			<p class="text-xs opacity-60 mb-2">{ config.AddHelp }</p>
		}
		@channelAuthorizationAddControls(config.ContainerID, addConfig)
	</div>
}

templ channelAuthorizationAddControls(containerID string, config channelAuthorizationAddConfig) {
	<div class="flex flex-wrap gap-2" id={ containerID + "-add-controls" }>
		<input type={ config.InputType } name={ config.InputName } placeholder={ config.InputPlaceholder } class="input input-bordered input-sm flex-1"/>
		<input type="text" name="display_name" placeholder="Display name (optional)" class="input input-bordered input-sm w-40"/>
		@channelSenderSelect("")
		if containerID == "slack-authorized-users" {
			<input class="input input-bordered input-sm" name="team_id" aria-label="Slack workspace ID" placeholder="Workspace ID (T…)"/>
		}
		<button type="button" class="btn btn-primary btn-sm" hx-params={ config.InputName + ",display_name,application_user_id,team_id" } hx-vals="js:{...Object.fromEntries(Array.from(this.parentElement.querySelectorAll('input,select')).map(el => [el.name, el.value]))}" hx-post={ config.Endpoint } hx-target={ "#" + containerID } hx-swap="outerHTML" hx-include={ "#" + containerID + "-add-controls" }>Add</button>
	</div>
}
