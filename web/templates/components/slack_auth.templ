package components

import (
	"fmt"

	"github.com/openvibely/openvibely/internal/models"
)

// SlackAuthorizedUsersList renders the list of authorized Slack users with add/remove controls.
templ SlackAuthorizedUsersList(users []models.SlackAuthorizedUser, projectID string) {
	@channelAuthorizationList(
		channelAuthorizationListConfig{
			ContainerID: "slack-authorized-users",
			Description: "This list authorizes installation-wide Slack ingress. Authenticated messages additionally require a verified workspace-to-application-user binding for the selected project. Only organization administrators may change these entries.",
			EmptyState: "No authorized users configured.",
			RemoveConfirmation: "Remove this authorized user?",
		},
		slackAuthorizationRows(users, projectID),
		channelAuthorizationAddConfig{
			ProjectID: projectID,
			Endpoint: "/channels/slack/authorized-users",
			InputType: "text",
			InputName: "slack_user_id",
			InputPlaceholder: "Slack user ID (e.g. U12345678)",
		},
	)
}

func slackAuthorizationRows(users []models.SlackAuthorizedUser, projectID string) []channelAuthorizationRow {
	rows := make([]channelAuthorizationRow, 0, len(users))
	for _, user := range users {
		rows = append(rows, channelAuthorizationRow{
			Identity:       slackAuthorizedUserIdentity(user),
			ProjectID:      user.ProjectID,
			DeleteEndpoint: fmt.Sprintf("/channels/slack/authorized-users/%s?project_id=%s", user.ID, user.ProjectID),
		})
	}
	return rows
}

templ slackAuthorizedUserIdentity(user models.SlackAuthorizedUser) {
 <div class="space-y-2">
	<div class="flex items-center gap-2">
		<svg xmlns="http://www.w3.org/2000/svg" class="h-4 w-4 opacity-50" fill="none" viewBox="0 0 24 24" stroke="currentColor">
			<path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M16 7a4 4 0 11-8 0 4 4 0 018 0zM12 14a7 7 0 00-7 7h14a7 7 0 00-7-7z"></path>
		</svg>
		<span class="text-sm font-medium">{ user.DisplayName }</span>
		<span class="text-xs opacity-50">{ fmt.Sprintf("ID: %s", user.SlackUserID) }</span>
	</div>

 <div id={ "slack-identity-" + user.ID } class="flex flex-wrap gap-2">
 <input type="hidden" name="project_id" value={ user.ProjectID }/>
 <input class="input input-bordered input-xs" name="team_id" aria-label="Slack workspace ID" placeholder="Workspace ID (T…)"/>
 <input class="input input-bordered input-xs" name="application_user_id" aria-label="Application user ID" placeholder="Application user ID"/>
 <button type="button" class="btn btn-xs" hx-post={ "/channels/slack/authorized-users/" + user.ID + "/identity" } hx-include={ "#slack-identity-" + user.ID } hx-target="#slack-authorized-users" hx-swap="outerHTML" hx-confirm="Confirm you verified this Slack workspace and user belong to the specified application user. This replaces any existing binding for this workspace.">Bind identity</button>
 </div>
 <p class="text-xs opacity-60">An organization administrator must verify both identities before binding. Unbound users cannot submit work when authentication is enabled.</p>
 </div>
}
