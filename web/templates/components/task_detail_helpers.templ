package components

import (
	"fmt"
	"github.com/openvibely/openvibely/internal/models"
	"time"
)

func derefString(v *string) string {
	if v == nil {
		return ""
	}
	return *v
}

func TaskThreadHasActiveComposerStopState(task *models.Task, executions []models.Execution) bool {
	if task != nil && (task.Status == models.StatusRunning || task.Status == models.StatusQueued || (task.Status == models.StatusPending && task.Category == models.CategoryActive)) {
		return true
	}
	return taskThreadActiveTurnID(executions) != ""
}

func taskThreadActiveTurnID(executions []models.Execution) string {
	for _, exec := range executions {
		if exec.Status == models.ExecRunning {
			return exec.ID
		}
	}
	return ""
}

func taskQueuedSteerEndpoint(input models.ThreadInput) string {
	return fmt.Sprintf("/tasks/%s/thread/queued/%s/steer", input.TaskID, input.ID)
}

func GetScheduleEditTime(s models.Schedule) string {
	if s.NextRun != nil {
		return s.NextRun.Local().Format("2006-01-02T15:04")
	}
	return s.RunAt.Local().Format("2006-01-02T15:04")
}

func ScheduleRepeatLabel(s models.Schedule) string {
	unit := ""
	switch s.RepeatType {
	case models.RepeatSeconds:
		if s.RepeatInterval == 1 {
			unit = "second"
		} else {
			unit = "seconds"
		}
	case models.RepeatMinutes:
		if s.RepeatInterval == 1 {
			unit = "minute"
		} else {
			unit = "minutes"
		}
	case models.RepeatHours:
		if s.RepeatInterval == 1 {
			unit = "hour"
		} else {
			unit = "hours"
		}
	default:
		return string(s.RepeatType)
	}
	if s.RepeatInterval == 1 {
		return fmt.Sprintf("every %s", unit)
	}
	return fmt.Sprintf("every %d %s", s.RepeatInterval, unit)
}

func formatDuration(ms int64) string {
	if ms < 1000 {
		return fmt.Sprintf("%dms", ms)
	}

	totalSeconds := ms / 1000
	if totalSeconds < 60 {
		return fmt.Sprintf("%ds", totalSeconds)
	}

	minutes := totalSeconds / 60
	seconds := totalSeconds % 60
	if minutes < 60 {
		if seconds > 0 {
			return fmt.Sprintf("%dm %ds", minutes, seconds)
		}
		return fmt.Sprintf("%dm", minutes)
	}

	hours := minutes / 60
	minutes = minutes % 60
	if minutes > 0 && seconds > 0 {
		return fmt.Sprintf("%dh %dm %ds", hours, minutes, seconds)
	} else if minutes > 0 {
		return fmt.Sprintf("%dh %dm", hours, minutes)
	} else if seconds > 0 {
		return fmt.Sprintf("%dh %ds", hours, seconds)
	}
	return fmt.Sprintf("%dh", hours)
}

func FormatElapsedTime(startedAt time.Time) string {
	elapsed := time.Since(startedAt)
	ms := elapsed.Milliseconds()
	return formatDuration(ms)
}

func parseChainConfigForDisplay(task *models.Task) models.ChainConfiguration {
	config, err := task.ParseChainConfig()
	if err != nil {
		return models.ChainConfiguration{Enabled: false}
	}
	return *config
}

// TaskChainConfigPage renders the task chaining configuration form for the task detail page
templ TaskChainConfigPage(task *models.Task, agents []models.LLMConfig) {
	<form
		method="post"
		hx-put={ fmt.Sprintf("/tasks/%s/chain", task.ID) }
		hx-target="#task-detail-content"
		hx-swap="outerHTML"
	>
		<div class="form-control mb-4">
			<label class="label cursor-pointer justify-start gap-2">
				<input
					type="checkbox"
					name="chain_enabled"
					id={ fmt.Sprintf("chain-enabled-page-%s", task.ID) }
					class="checkbox"
					value="true"
					if chainConfig := parseChainConfigForDisplay(task); chainConfig.Enabled {
						checked
					}
					onchange="document.getElementById('chain-config-fields-page').classList.toggle('hidden', !this.checked)"
				/>
				<span class="label-text">Enable task chaining</span>
			</label>
		</div>
		<div
			id="chain-config-fields-page"
			if chainConfig := parseChainConfigForDisplay(task); !chainConfig.Enabled {
				class="hidden"
			}
		>
			<div class="form-control mb-4">
				<label class="label">
					<span class="label-text">Trigger</span>
				</label>
				<select name="chain_trigger" class="select select-bordered">
					<option
						value="on_completion"
						if chainConfig := parseChainConfigForDisplay(task); chainConfig.Trigger == "on_completion" || chainConfig.Trigger == "" {
							selected
						}
					>On Task Completion</option>
					<option
						value="on_planning_complete"
						if chainConfig := parseChainConfigForDisplay(task); chainConfig.Trigger == "on_planning_complete" {
							selected
						}
					>On Planning Complete (Opus → Sonnet)</option>
				</select>
				<label class="label">
					<span class="label-text-alt">When should the child task be created?</span>
				</label>
			</div>
			<div class="form-control mb-4">
				<label class="label">
					<span class="label-text">Child Task Category</span>
				</label>
				<select name="chain_child_category" class="select select-bordered">
					<option
						value=""
						if chainConfig := parseChainConfigForDisplay(task); chainConfig.ChildCategory == "" {
							selected
						}
					>Same as parent</option>
					<option
						value="active"
						if chainConfig := parseChainConfigForDisplay(task); chainConfig.ChildCategory == "active" {
							selected
						}
					>Active (run immediately)</option>
					<option
						value="backlog"
						if chainConfig := parseChainConfigForDisplay(task); chainConfig.ChildCategory == "backlog" {
							selected
						}
					>Backlog</option>
				</select>
				<label class="label">
					<span class="label-text-alt">Which category should the child task be placed in?</span>
				</label>
			</div>
			<div class="form-control mb-4">
				<label class="label">
					<span class="label-text">Child Task Model</span>
				</label>
				<select name="chain_child_agent_id" class="select select-bordered">
					<option
						value=""
						if chainConfig := parseChainConfigForDisplay(task); chainConfig.ChildAgentID == "" {
							selected
						}
					>Use default model</option>
					for _, agent := range agents {
						<option
							value={ agent.ID }
							if chainConfig := parseChainConfigForDisplay(task); chainConfig.ChildAgentID == agent.ID {
								selected
							}
						>
							{ agent.Name }
							if agent.IsDefault {
								(Default)
							}
						</option>
					}
				</select>
				<label class="label">
					<span class="label-text-alt">Which model should execute the child task?</span>
				</label>
			</div>
			<div class="form-control mb-4">
				<label class="label">
					<span class="label-text">Child Task Model Override</span>
				</label>
				<input
					type="text"
					name="chain_child_model"
					value={ parseChainConfigForDisplay(task).ChildModel }
					class="input input-bordered"
					placeholder="e.g., sonnet, opus, haiku (leave empty to use model's default)"
				/>
				<label class="label">
					<span class="label-text-alt">Optional: Override the model for the child task</span>
				</label>
			</div>
		</div>
		<div class="flex gap-2">
			<button type="submit" class="btn btn-primary btn-sm">
				Save Chaining Configuration
			</button>
		</div>
	</form>
}

// TaskLatestDuration returns the duration of the most recent completed/failed execution.
func TaskLatestDuration(executions []models.Execution) string {
	for i := len(executions) - 1; i >= 0; i-- {
		if executions[i].DurationMs > 0 {
			return formatDuration(executions[i].DurationMs)
		}
	}
	return ""
}

// TaskThreadStatusIndicator renders a success/failure status indicator at the bottom of thread messages.
// Shows only when the task is completed or failed, providing clear visual feedback.
templ TaskThreadStatusIndicator(task *models.Task, executions []models.Execution) {
	if task.Status == models.StatusCompleted {
		<div class="flex items-center justify-center gap-2 py-2">
			<div class="flex items-center gap-2 text-success text-sm opacity-70">
				<svg xmlns="http://www.w3.org/2000/svg" class="h-4 w-4" fill="none" viewBox="0 0 24 24" stroke="currentColor">
					<path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M5 13l4 4L19 7"></path>
				</svg>
				<span>Task completed</span>
				if dur := TaskLatestDuration(executions); dur != "" {
					<span class="opacity-60">({ dur })</span>
				}
			</div>
		</div>
	} else if task.Status == models.StatusFailed {
		<div class="flex items-center justify-center gap-2 py-2">
			<div class="flex items-center gap-2 text-error text-sm opacity-70">
				<svg xmlns="http://www.w3.org/2000/svg" class="h-4 w-4" fill="none" viewBox="0 0 24 24" stroke="currentColor">
					<path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M6 18L18 6M6 6l12 12"></path>
				</svg>
				<span>Task failed</span>
				if dur := TaskLatestDuration(executions); dur != "" {
					<span class="opacity-60">({ dur })</span>
				}
			</div>
		</div>
	}
}

templ TaskPrimaryAgentBanner(agentDef *models.Agent) {
	if agentDef != nil {
		<div id="task-thread-primary-agent" class="rounded-lg border border-primary/20 bg-primary/10 px-3 py-2 text-xs text-primary-content">
			<span class="font-medium">Assigned agent:</span>
			<span>{ agentDef.Name }</span>
			if agentDef.Key != "" {
				<span class="font-mono opacity-70">({ agentDef.Key })</span>
			}
		</div>
	}
}

templ TaskThreadEarlierMessages(task *models.Task, executions []models.Execution, chatAttachments map[string][]models.ChatAttachment, hasEarlier bool, windowLimit int) {
	if hasEarlier && len(executions) > 0 {
		@ChatEarlierMessagesLoader("task-thread-messages", fmt.Sprintf("/tasks/%s/thread?before=%s&limit=%d", task.ID, executions[0].ID, windowLimit), windowLimit)
	}
	@ChatMessages(executions, task, chatAttachments, "task-thread-messages", "task-thread-view", hasEarlier)
}

// TaskThreadView renders the unified thread interface for a task.
// Uses shared chat components for message bubbles and input form.
// Accepts agents list to show model selector matching /chat page behavior.
// chatAttachments map is optional - when nil, no attachment indicators are shown on messages.
templ TaskThreadView(task *models.Task, executions []models.Execution, agents []models.LLMConfig, agentDef *models.Agent, chatAttachments map[string][]models.ChatAttachment, pendingInputs []models.ThreadInput, hasEarlier bool, windowLimit int) {
	<div
		id="task-thread-view"
		class="flex flex-col flex-1 min-h-0 min-w-0 max-w-full"
			if task.Status == models.StatusRunning || task.Status == models.StatusQueued || (task.Status == models.StatusPending && task.Category == models.CategoryActive) {
			hx-get={ fmt.Sprintf("/tasks/%s/thread?limit=%d", task.ID, windowLimit) }
			hx-trigger="every 3s"
			hx-target="#task-thread-view"
			hx-swap="morph:outerHTML"
		}
			data-task-active={ boolStr(task.Status == models.StatusRunning || task.Status == models.StatusQueued || (task.Status == models.StatusPending && task.Category == models.CategoryActive)) }
		data-task-id={ task.ID }
	>
		<!-- Chat messages area — matches /chat layout (min/max height, padding, spacing) -->
		<div id="task-thread-messages" class="flex-1 overflow-y-auto py-4 mb-4 space-y-6 min-h-0" data-window-limit={ fmt.Sprintf("%d", windowLimit) } data-earlier-url-base={ fmt.Sprintf("/tasks/%s/thread?limit=%d", task.ID, windowLimit) }>
			@TaskPrimaryAgentBanner(agentDef)
			if hasEarlier && len(executions) > 0 {
				@ChatEarlierMessagesLoader("task-thread-messages", fmt.Sprintf("/tasks/%s/thread?before=%s&limit=%d", task.ID, executions[0].ID, windowLimit), windowLimit)
			}
			if len(executions) == 0 && len(pendingInputs) == 0 {
				@ChatEmptyState("No messages yet. Click \"Run Now\" to start, then follow up here.")
			} else {
				@ChatMessages(executions, task, chatAttachments, "task-thread-messages", "task-thread-view", hasEarlier)
				@PendingThreadInputRows(pendingInputs, taskQueuedSteerEndpoint)
				@TaskThreadStatusIndicator(task, executions)
			}
		</div>
		<!-- Message Input Form (shared component with model selector) -->
		@ChatInputForm(ChatInputFormConfig{
			FormID:                 "task-thread-form",
			InputID:                "task-message-input",
			PostEndpoint:           fmt.Sprintf("/tasks/%s/thread", task.ID),
			TargetID:               "task-thread-messages",
			Agents:                 agents,
			ShowModelSelector:      true,
			TaskID:                 task.ID,
				IsRunning:              TaskThreadHasActiveComposerStopState(task, executions),
				ActiveTurnID:           taskThreadActiveTurnID(executions),
				StopEndpoint:           fmt.Sprintf("/tasks/%s/cancel?composer_stop=1", task.ID),
				SelectedAgentID:        derefString(task.AgentID),
			PendingInputs:          pendingInputs,
			QueuedSteerEndpointFor: taskQueuedSteerEndpoint,
		})
		<!-- Shared auto-scroll and transcript rendering/cleaning utilities -->
		@ChatAutoScrollScript()
		@_initThreadStreamingScript()
		@TaskThreadLiveEventsScript(task.ID)
		<script>
			function _taskThreadTaskId() {
				var threadContent = document.getElementById('thread-content');
				if (threadContent && threadContent.dataset.taskId) return threadContent.dataset.taskId;
				var taskIdMatch = window.location.pathname.match(/\/tasks\/([^\/]+)/);
				return taskIdMatch && taskIdMatch[1] ? taskIdMatch[1] : '';
			}

			function _taskThreadDraftStorageKey() {
				var taskId = _taskThreadTaskId();
				return taskId ? 'task-thread-draft-' + taskId : '';
			}

			function _taskThreadScrollStateKey(taskId) {
				return taskId ? 'task-thread-scroll-' + taskId : '';
			}

			function _getTaskThreadScrollState(taskId) {
				window._taskThreadScrollStates = window._taskThreadScrollStates || {};
				var key = _taskThreadScrollStateKey(taskId || _taskThreadTaskId());
				return key ? window._taskThreadScrollStates[key] : null;
			}

			function _saveTaskThreadScrollState() {
				var taskId = _taskThreadTaskId();
				var key = _taskThreadScrollStateKey(taskId);
				var messages = document.getElementById('task-thread-messages');
				if (!key || !messages || !window.chatAutoScroll) return;
				var tracker = window._taskThreadPageTracker;
				var nearBottom = window.chatAutoScroll.isNearBottom(messages);
				var snapshot = tracker && typeof tracker.snapshot === 'function'
					? tracker.snapshot()
					: { scrollTop: messages.scrollTop || 0, userScrolledUp: !nearBottom, pinned: nearBottom };
				window._taskThreadScrollStates = window._taskThreadScrollStates || {};
				window._taskThreadScrollStates[key] = snapshot;
				window._taskThreadUserScrolledUp = !!snapshot.userScrolledUp;
			}

			function _restoreTaskThreadScrollState(messages, state) {
				if (!messages || !state) return false;
				messages.scrollTop = state.pinned ? messages.scrollHeight : (state.scrollTop || 0);
				return true;
			}

			function _syncTaskThreadDraftFromTextarea() {
				window._taskThreadDrafts = window._taskThreadDrafts || {};
				var key = _taskThreadDraftStorageKey();
				if (!key) return;
				var textarea = document.getElementById('task-message-input');
				if (!textarea) return;
				if (textarea.value.trim() === '') {
					delete window._taskThreadDrafts[key];
					return;
				}
				window._taskThreadDrafts[key] = textarea.value;
			}

			function _restoreTaskThreadDraftToTextarea() {
				window._taskThreadDrafts = window._taskThreadDrafts || {};
				var textarea = document.getElementById('task-message-input');
				if (!textarea) return;

				var restoreValue = '';
				if (typeof window._taskThreadSavedInput === 'string' && window._taskThreadSavedInput !== '') {
					restoreValue = window._taskThreadSavedInput;
				}
				if (!restoreValue) {
					var key = _taskThreadDraftStorageKey();
					if (key && window._taskThreadDrafts[key]) {
						restoreValue = window._taskThreadDrafts[key];
					}
				}
				if (restoreValue && textarea.value !== restoreValue) {
					textarea.value = restoreValue;
				}
				if (!textarea.dataset.draftSyncBound) {
					textarea.dataset.draftSyncBound = 'true';
					textarea.addEventListener('input', _syncTaskThreadDraftFromTextarea);
					textarea.addEventListener('change', _syncTaskThreadDraftFromTextarea);
				}
				window._taskThreadSavedInput = '';
			}

				// Apply cleaning and scroll on load
				(function() {
					var chatMessages = document.getElementById('task-thread-messages');
					if (chatMessages) {
						if (window.cleanAssistantMessages) window.cleanAssistantMessages(chatMessages);
						if (window.initChatEarlierLoader) window.initChatEarlierLoader(chatMessages);
						if (window.pruneChatExecutionWindow) window.pruneChatExecutionWindow(chatMessages);
						var taskId = _taskThreadTaskId();
						var preservedScrollState = _getTaskThreadScrollState(taskId);
						var restoredScrollState = _restoreTaskThreadScrollState(chatMessages, preservedScrollState);
						if (!restoredScrollState && window.chatAutoScroll) {
							window.chatAutoScroll.scrollToBottom(chatMessages, false);
						}
						var preservedUserScrolledUp = restoredScrollState ? !!preservedScrollState.userScrolledUp : false;

						// Set up page-level scroll tracker for task thread before binding attachment image handlers
						// so cached/complete images respect restored explicit upward scroll intent.
						if (window.ChatScrollTracker) {
							if (window._taskThreadPageTracker) window._taskThreadPageTracker.destroy();
							window._taskThreadPageTracker = new window.ChatScrollTracker(chatMessages);
							window._taskThreadPageTracker.userScrolledUp = preservedUserScrolledUp;
						}
						if (window.bindAttachmentImageSmartScroll) window.bindAttachmentImageSmartScroll(chatMessages, 'scrollTracker_task-thread-messages', window._taskThreadPageTracker);

						// Keep global flag as fallback source of truth across partial re-inits.
						window._taskThreadUserScrolledUp = preservedUserScrolledUp;
					}
					// Render tool/thinking transcript controls and initialize SSE for any running executions.
					// Content is in data-raw-content attribute (not textContent) to prevent raw text flash.
					var resumeContainers = document.querySelectorAll('[data-streaming-resume="true"]');
					resumeContainers.forEach(function(c) {
						var raw = c.getAttribute('data-raw-content') || '';
						if (raw.trim() && window.renderStreamingContent) {
							window.renderStreamingContent(c, raw);
						}
					});
					if (window._initThreadStreaming) window._initThreadStreaming();
					_restoreTaskThreadDraftToTextarea();
				})();
			// Intelligent auto-scroll: only scroll when user hasn't manually scrolled up
			if (!window._taskThreadScrollHandlerAttached) {
				window._taskThreadScrollHandlerAttached = true;

				// Rule 1: Reset tracker when user sends a message (beforeRequest fires before swap)
				// Also cancel polling requests when SSE streaming is active to prevent morph from killing the EventSource
				document.body.addEventListener('htmx:beforeRequest', function(event) {
					var threadView = document.getElementById('task-thread-view');
					var isTaskActive = !!(threadView && threadView.getAttribute('data-task-active') === 'true');
					var triggerEl = event.detail && event.detail.elt;
					// Block stale polls when task is no longer active
					if (triggerEl && triggerEl.id === 'task-thread-view' && !isTaskActive) {
						event.preventDefault();
						return;
					}
					var detail = event.detail || {};
					var requestConfig = detail.requestConfig || {};
						var requestPath = typeof requestConfig.path === 'string' ? requestConfig.path : '';
						var requestMethod = typeof requestConfig.verb === 'string' ? requestConfig.verb.toUpperCase() : '';
						var isPost = requestMethod === 'POST';
						var isThreadPath = requestPath.indexOf('/thread') !== -1;
						var isThreadSendRequest = isPost && isThreadPath;
						if (isThreadSendRequest) {
							if (window.markChatSendScrollIntent) window.markChatSendScrollIntent('task-thread-messages');
							var tracker = window._taskThreadPageTracker;
							if (tracker) tracker.resetOnUserSend();
							var taskId = _taskThreadTaskId();
							var key = _taskThreadScrollStateKey(taskId);
							window._taskThreadScrollStates = window._taskThreadScrollStates || {};
							if (key) window._taskThreadScrollStates[key] = { scrollTop: 0, userScrolledUp: false, pinned: true };
							window._taskThreadUserScrolledUp = false;
						}
					// Block polling requests to task-thread-view while SSE streaming
					// is active or sidebar navigation is in progress
					if (triggerEl && triggerEl.id === 'task-thread-view') {
						if (window._taskThreadStreamingActive || window._sidebarNavigating) {
							event.preventDefault();
						}
					}
				});

				document.body.addEventListener('htmx:afterRequest', function(event) {
					var detail = event.detail || {};
					var requestConfig = detail.requestConfig || {};
					var requestPath = typeof requestConfig.path === 'string' ? requestConfig.path : '';
					var requestMethod = typeof requestConfig.verb === 'string' ? requestConfig.verb.toUpperCase() : '';
					var isPost = requestMethod === 'POST';
					var isThreadPath = requestPath.indexOf('/thread') !== -1;
					var isThreadSendRequest = isPost && isThreadPath;
					if (!isThreadSendRequest) return;
					if (!detail.successful) return;
					var xhr = detail.xhr;
					var responseText = xhr ? (xhr.responseText || '') : '';
					if (responseText.trim() === '') return;
					window._taskThreadSavedInput = '';
					window._taskThreadDrafts = window._taskThreadDrafts || {};
					var key = _taskThreadDraftStorageKey();
					if (key) delete window._taskThreadDrafts[key];
				});

					function _closeTaskThreadEventSources() {
						if (!window._threadEventSources) return;
						window._threadEventSources.forEach(function(es) {
							try { es.close(); } catch(e) {}
						});
						window._threadEventSources = [];
					}

					// Before swaps, capture scroll state and preserve textarea input
					document.body.addEventListener('htmx:beforeSwap', function(event) {
						var target = event.detail.target;
						if (target && (target.id === 'task-thread-messages' || target.id === 'task-detail-content' || target.id === 'task-thread-view' || target.id === 'thread-content')) {
							var requestConfig = event.detail.requestConfig || {};
						var requestPath = typeof requestConfig.path === 'string' ? requestConfig.path : '';
						var requestMethod = typeof requestConfig.verb === 'string' ? requestConfig.verb.toUpperCase() : '';
						var isPost = requestMethod === 'POST';
						var isThreadPath = requestPath.indexOf('/thread') !== -1;
						var isThreadSendRequest = isPost && isThreadPath;
						var xhr = event.detail.xhr;
						var responseText = xhr ? (xhr.responseText || '') : '';

						if (isThreadSendRequest && responseText.trim() !== '') {
							window._taskThreadSavedInput = '';
							window._taskThreadDrafts = window._taskThreadDrafts || {};
							var sentKey = _taskThreadDraftStorageKey();
							if (sentKey) delete window._taskThreadDrafts[sentKey];
						} else {
							// Save textarea value before swap to prevent clearing during morph polling
							var textarea = document.getElementById('task-message-input');
							if (textarea) {
								window._taskThreadSavedInput = textarea.value;
								_syncTaskThreadDraftFromTextarea();
							}
						}
						_saveTaskThreadScrollState();
					}
						// Clean up thread EventSource connections before replacing active thread DOM.
						if (target && (target.id === 'thread-content' || target.id === 'task-thread-view' || target.id === 'task-detail-content' || target.id === 'main-content')) {
							_closeTaskThreadEventSources();
							window._taskThreadStreamingActive = false;
						}

						// Clean up thread state when navigating away via sidebar
						// (sidebar replaces main-content, removing the thread view)
						if (target && target.id === 'main-content') {
							_saveTaskThreadScrollState();
							window._taskThreadSavedInput = '';
							if (window._taskThreadPageTracker) {
								window._taskThreadPageTracker.destroy();
								window._taskThreadPageTracker = null;
							}
						}
				});

						document.body.addEventListener('htmx:afterSwap', function(event) {
							var target = event.detail.target;
							if (target && target.id === 'task-thread-messages') {
								// Skip expensive DOM work if navigating away via sidebar
								if (window._sidebarNavigating) return;
								// Re-attach tracker if the DOM element changed before binding image load handlers.
								if (target !== (window._taskThreadPageTracker && window._taskThreadPageTracker.element)) {
									if (window.ChatScrollTracker) {
										if (window._taskThreadPageTracker) window._taskThreadPageTracker.destroy();
										window._taskThreadPageTracker = new window.ChatScrollTracker(target);
										window._taskThreadPageTracker.userScrolledUp = !!window._taskThreadUserScrolledUp;
										_saveTaskThreadScrollState();
									}
								}
								if (window.cleanAssistantMessages) window.cleanAssistantMessages(target);
								if (window.initChatEarlierLoader) window.initChatEarlierLoader(target);
								if (window.pruneChatExecutionWindow) window.pruneChatExecutionWindow(target);
								if (window.bindAttachmentImageSmartScroll) window.bindAttachmentImageSmartScroll(target, 'scrollTracker_task-thread-messages', window._taskThreadPageTracker);
								// Auto-scroll on deliberate sends even when attachments change layout;
								// otherwise respect explicit user scroll-up intent.
								var sentByUser = window.consumeChatSendScrollIntent ? window.consumeChatSendScrollIntent('task-thread-messages') : false;
								if (sentByUser || !window._taskThreadUserScrolledUp) {
									if (window.scrollChatToBottomAfterLayout) {
										window.scrollChatToBottomAfterLayout(target, true);
									} else {
										requestAnimationFrame(function() {
											if (target && window.chatAutoScroll) {
												window.chatAutoScroll.scrollToBottom(target, true);
											}
										});
									}
								}
							}
							// Handle polling updates to task-thread-view (e.g., task completion status)
							else if (target && target.id === 'task-thread-view') {
								// Skip expensive DOM work if navigating away via sidebar
								if (window._sidebarNavigating) return;
								var chatMessages = document.getElementById('task-thread-messages');
								if (chatMessages) {
									// Re-attach tracker if the DOM element changed before binding image load handlers.
									if (chatMessages !== (window._taskThreadPageTracker && window._taskThreadPageTracker.element)) {
										if (window.ChatScrollTracker) {
											if (window._taskThreadPageTracker) window._taskThreadPageTracker.destroy();
											window._taskThreadPageTracker = new window.ChatScrollTracker(chatMessages);
											window._taskThreadPageTracker.userScrolledUp = !!window._taskThreadUserScrolledUp;
											_saveTaskThreadScrollState();
										}
									}
									if (window.cleanAssistantMessages) window.cleanAssistantMessages(chatMessages);
								if (window.initChatEarlierLoader) window.initChatEarlierLoader(chatMessages);
								if (window.pruneChatExecutionWindow) window.pruneChatExecutionWindow(chatMessages);
									if (window.bindAttachmentImageSmartScroll) window.bindAttachmentImageSmartScroll(chatMessages, 'scrollTracker_task-thread-messages', window._taskThreadPageTracker);
									// Auto-scroll on deliberate sends even when attachments change layout;
									// otherwise respect explicit user scroll-up intent.
									var sentByUser = window.consumeChatSendScrollIntent ? window.consumeChatSendScrollIntent('task-thread-messages') : false;
									if (sentByUser || !window._taskThreadUserScrolledUp) {
										if (window.scrollChatToBottomAfterLayout) {
											window.scrollChatToBottomAfterLayout(chatMessages, true);
										} else {
											requestAnimationFrame(function() {
												if (chatMessages && window.chatAutoScroll) {
													window.chatAutoScroll.scrollToBottom(chatMessages, true);
												}
											});
										}
									}
								}
								if (window.cleanAssistantMessages) window.cleanAssistantMessages(document.getElementById('task-thread-messages'));
								if (window._initThreadStreaming) window._initThreadStreaming();
							}
						// Also handle full page refreshes on task-detail-content
						else if (target && target.id === 'task-detail-content') {
							var chatMessages = document.getElementById('task-thread-messages');
							if (chatMessages) {
								// Re-attach tracker if the DOM element changed before binding image load handlers.
								if (chatMessages !== (window._taskThreadPageTracker && window._taskThreadPageTracker.element)) {
									if (window.ChatScrollTracker) {
										if (window._taskThreadPageTracker) window._taskThreadPageTracker.destroy();
										window._taskThreadPageTracker = new window.ChatScrollTracker(chatMessages);
										window._taskThreadPageTracker.userScrolledUp = !!window._taskThreadUserScrolledUp;
										_saveTaskThreadScrollState();
									}
								}
								if (window.cleanAssistantMessages) window.cleanAssistantMessages(chatMessages);
								if (window.initChatEarlierLoader) window.initChatEarlierLoader(chatMessages);
								if (window.pruneChatExecutionWindow) window.pruneChatExecutionWindow(chatMessages);
								if (window.bindAttachmentImageSmartScroll) window.bindAttachmentImageSmartScroll(chatMessages, 'scrollTracker_task-thread-messages', window._taskThreadPageTracker);
								// Auto-scroll on deliberate sends even when attachments change layout;
								// otherwise respect explicit user scroll-up intent.
								var sentByUser = window.consumeChatSendScrollIntent ? window.consumeChatSendScrollIntent('task-thread-messages') : false;
								if (sentByUser || !window._taskThreadUserScrolledUp) {
									if (window.scrollChatToBottomAfterLayout) {
										window.scrollChatToBottomAfterLayout(chatMessages, true);
									} else {
										requestAnimationFrame(function() {
											if (chatMessages && window.chatAutoScroll) {
												window.chatAutoScroll.scrollToBottom(chatMessages, true);
											}
										});
									}
								}
							}
						}
						// Restore textarea value after morph polling or full page refresh
						_restoreTaskThreadDraftToTextarea();
					});
			}
			</script>
	</div>
}

templ TaskThreadLiveEventsScript(taskID string) {
	<script type="text/javascript">
			(function() {
				var threadView = document.getElementById('task-thread-view');
				var taskId = threadView ? (threadView.getAttribute('data-task-id') || '') : '';
				if (!taskId) return;
				window._taskThreadLiveHandlers = window._taskThreadLiveHandlers || {};
				if (window._taskThreadLiveHandlers[taskId]) {
					window.removeEventListener('sse-task-event', window._taskThreadLiveHandlers[taskId]);
				}
						function currentTaskThreadView() {
							var view = document.getElementById('task-thread-view');
							return view && view.getAttribute('data-task-id') === taskId ? view : null;
						}
						function scopedPendingContainerSelector() {
							return '#pending-thread-inputs[data-task-id="' + taskId.replace(/"/g, '\\"') + '"]';
						}
						function currentPendingContainer() {
							return currentTaskThreadView() ? document.querySelector(scopedPendingContainerSelector()) : null;
						}
						function removePendingRow(inputId) {
							if (!inputId || !currentTaskThreadView()) return;
							var row = document.querySelector('[data-thread-input-id="' + inputId.replace(/"/g, '\\"') + '"][data-task-id="' + taskId.replace(/"/g, '\\"') + '"]');
							if (row) row.remove();
						}
						function ensureComposerPendingContainer() {
							if (!currentTaskThreadView()) return null;
							var pendingContainer = currentPendingContainer();
							if (pendingContainer) return pendingContainer;
							var form = document.getElementById('task-thread-form');
							var textarea = document.getElementById('task-message-input');
							if (!form || !textarea) return null;
							pendingContainer = document.createElement('div');
							pendingContainer.id = 'pending-thread-inputs';
							pendingContainer.className = 'space-y-1.5';
							pendingContainer.setAttribute('data-task-id', taskId);
							var textareaWrap = textarea.parentElement;
							form.insertBefore(pendingContainer, textareaWrap || textarea);
							return pendingContainer;
						}
						function refreshPendingInputsIfVisible() {
							var pendingContainer = currentPendingContainer();
							if (!pendingContainer || !pendingContainer.querySelector('[data-thread-input-id]') || typeof htmx === 'undefined') return;
							htmx.ajax('GET', '/tasks/' + encodeURIComponent(taskId) + '/thread/pending-inputs', {target: scopedPendingContainerSelector(), swap: 'outerHTML'});
						}
						function refreshThreadComposerAction() {
							if (typeof htmx === 'undefined' || !document.getElementById('task-thread-form-primary-action')) return;
							htmx.ajax('GET', '/tasks/' + encodeURIComponent(taskId) + '/thread/composer-action', {target: '#task-thread-form-primary-action', swap: 'outerHTML'});
						}
						function stopThreadPollingAfterCompletion() {
							var view = currentTaskThreadView();
							if (!view) return;
							view.setAttribute('data-task-active', 'false');
							view.removeAttribute('hx-trigger');
							view.removeAttribute('hx-get');
							if (typeof htmx !== 'undefined') htmx.process(view);
						}
						function showCompletedThreadTerminalStatus(status) {
							stopThreadPollingAfterCompletion();
							var form = document.getElementById('task-thread-form');
							if (form) {
								var textarea = document.getElementById('task-message-input');
								if (textarea) textarea.setAttribute('placeholder', 'Type your message... (Enter to send, Shift+Enter for new line)');
								refreshThreadComposerAction();
							}
							var messages = document.getElementById('task-thread-messages');
							if (!messages || document.getElementById('task-thread-terminal-status')) return;
							var wrap = document.createElement('div');
							wrap.id = 'task-thread-terminal-status';
							wrap.className = 'flex items-center justify-center gap-2 py-2';
							var inner = document.createElement('div');
							var statusClass = status === 'failed' ? 'text-error' : (status === 'cancelled' ? 'text-warning' : 'text-success');
							inner.className = 'flex items-center gap-2 text-sm opacity-70 ' + statusClass;
							var icon = document.createElement('span');
							icon.setAttribute('aria-hidden', 'true');
							icon.textContent = status === 'failed' ? '✕' : (status === 'cancelled' ? '■' : '✓');
							var text = document.createElement('span');
							text.textContent = 'Task ' + (status === 'failed' ? 'failed' : (status === 'cancelled' ? 'cancelled' : 'completed'));
							inner.appendChild(icon);
							inner.appendChild(text);
							wrap.appendChild(inner);
							messages.appendChild(wrap);
						}
						function syncCompletedThreadOutput(execId, completedOutput, status) {
							if (!currentTaskThreadView() || !execId || typeof completedOutput !== 'string' || completedOutput === '') return;
							var streamContainer = document.getElementById('streaming-message-' + execId);
							if (!streamContainer) return;
							streamContainer.setAttribute('data-raw-content', completedOutput);
							if (window.renderStreamingContent) {
								var liveRenderer = window.renderLiveChatContent || window.renderStreamingContent;
								liveRenderer(streamContainer, completedOutput);
							} else {
								streamContainer.textContent = completedOutput;
							}
							streamContainer.classList.remove('hidden');
							var bubble = streamContainer.closest('.chat-bubble-assistant-msg');
							if (bubble) {
								var thinkingWrap = document.getElementById('streaming-thinking-' + execId) || document.getElementById('streaming-thinking-resume-' + execId);
								if (thinkingWrap) {
									thinkingWrap.classList.add('hidden');
								} else {
									var thinking = bubble.querySelector('.ov-loading-dots');
									if (thinking) thinking.classList.add('hidden');
								}
								var loading = bubble.querySelector('.loading-dots, [id^="streaming-dots-"]');
								if (loading) loading.classList.add('hidden');
								if (window.convertTaskLinksInMessage) window.convertTaskLinksInMessage(bubble);
								if (window.convertTaskEditLinksInMessage) window.convertTaskEditLinksInMessage(bubble);
								if (window.cleanBubbleContent) window.cleanBubbleContent(bubble);
							}
							window._taskThreadStreamingActive = false;
							showCompletedThreadTerminalStatus(status || 'completed');
						}
						function renderQueuedRow(data) {
							if (!data || data.task_id !== taskId || !data.pending_input_id || !currentTaskThreadView()) return;
							if (document.querySelector('[data-thread-input-id="' + data.pending_input_id + '"][data-task-id="' + taskId + '"]')) return;
							var pendingContainer = ensureComposerPendingContainer();						if (!pendingContainer) return;
							var queuedRow = document.createElement('div');
							queuedRow.id = 'thread-input-' + data.pending_input_id;
							queuedRow.className = 'queued-input-row flex min-h-8 items-center gap-3 rounded-lg bg-base-300/45 px-3 py-1.5 text-sm text-base-content/80';
							queuedRow.setAttribute('data-thread-input-id', data.pending_input_id);
							queuedRow.setAttribute('data-task-id', taskId);
							queuedRow.setAttribute('data-input-mode', 'queued');						queuedRow.title = 'Queued follow-up will run after the active response finishes';
						var preview = document.createElement('div');
						preview.className = 'min-w-0 flex-1 truncate';
						preview.textContent = data.message || '';
						var actionWrap = document.createElement('div');
						actionWrap.className = 'ml-auto flex shrink-0 items-center gap-2';
						var steerBtn = document.createElement('button');
						steerBtn.type = 'button';
						steerBtn.className = 'btn btn-ghost btn-xs h-6 min-h-0 rounded-md px-2 text-xs font-medium';
						steerBtn.setAttribute('hx-post', '/tasks/' + encodeURIComponent(taskId) + '/thread/queued/' + data.pending_input_id + '/steer');
						steerBtn.setAttribute('hx-target', '#thread-input-' + data.pending_input_id);
						steerBtn.setAttribute('hx-swap', 'outerHTML');
						steerBtn.title = 'Convert queued follow-up to steering';
						steerBtn.textContent = 'Steer';
						var cancelBtn = document.createElement('button');
						cancelBtn.type = 'button';
						cancelBtn.className = 'btn btn-ghost btn-xs h-6 min-h-0 rounded-md px-2 text-xs text-error';
						cancelBtn.setAttribute('hx-post', '/thread-inputs/' + data.pending_input_id + '/cancel');
						cancelBtn.setAttribute('hx-target', '#thread-input-' + data.pending_input_id);
						cancelBtn.setAttribute('hx-swap', 'outerHTML');
						cancelBtn.title = 'Cancel queued follow-up';
						cancelBtn.setAttribute('aria-label', 'Cancel queued follow-up');
						cancelBtn.innerHTML = '<svg xmlns="http://www.w3.org/2000/svg" class="h-4 w-4" fill="none" viewBox="0 0 24 24" stroke="currentColor"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M19 7l-.867 12.142A2 2 0 0116.138 21H7.862a2 2 0 01-1.995-1.858L5 7m5 4v6m4-6v6m1-10V4a1 1 0 00-1-1h-4a1 1 0 00-1 1v3M4 7h16"></path></svg>';
						actionWrap.appendChild(steerBtn);
						actionWrap.appendChild(cancelBtn);
						queuedRow.appendChild(preview);
						queuedRow.appendChild(actionWrap);
						pendingContainer.appendChild(queuedRow);
						if (window.htmx) htmx.process(queuedRow);
					}
						var pendingFragmentExecs = {};
						window._pendingTaskThreadLiveEvents = window._pendingTaskThreadLiveEvents || {};
						function rememberPendingExecutionEvent(data) {
							if (!data || data.task_id !== taskId || !data.exec_id) return;
							window._pendingTaskThreadLiveEvents[taskId] = data;
						}
						function consumePendingExecutionEvent() {
							var data = window._pendingTaskThreadLiveEvents && window._pendingTaskThreadLiveEvents[taskId];
							if (!data) return;
							delete window._pendingTaskThreadLiveEvents[taskId];
							ensureStreamingFragment(data);
						}
							function ensureStreamingFragment(data, attempt) {
								attempt = attempt || 0;
								if (!currentTaskThreadView()) return;
								var messages = document.getElementById('task-thread-messages');
								if (!data || data.task_id !== taskId || !data.exec_id) return;							if (!messages) {
								rememberPendingExecutionEvent(data);
								return;
							}
							if (document.querySelector('[data-exec-id="' + data.exec_id + '"]')) {
							delete pendingFragmentExecs[data.exec_id];
							if (window._initThreadStreaming) window._initThreadStreaming();
							return;
						}
						removePendingRow(data.pending_input_id);
						var terminal = document.getElementById('task-thread-terminal-status');
						if (terminal) terminal.remove();
						if (typeof htmx === 'undefined') return;
						if (pendingFragmentExecs[data.exec_id] && attempt === 0) return;
						pendingFragmentExecs[data.exec_id] = true;
						htmx.ajax('GET', '/tasks/' + encodeURIComponent(taskId) + '/thread/executions/' + encodeURIComponent(data.exec_id) + '/fragment', {
							target: '#task-thread-messages',
							swap: 'beforeend'
						}).then(function() {
							delete pendingFragmentExecs[data.exec_id];
							var view = document.getElementById('task-thread-view');
							if (view) view.setAttribute('data-task-active', 'true');
							if (window._initThreadStreaming) window._initThreadStreaming();
							if (window.htmx) htmx.process(messages);
							var tracker = window._taskThreadPageTracker;
							if (window.chatAutoScroll && (!tracker || tracker.shouldAutoScroll())) {
								window.chatAutoScroll.scrollToBottom(messages, true);
							}
						}).catch(function() {
							delete pendingFragmentExecs[data.exec_id];
							if (attempt < 5) {
								setTimeout(function() { ensureStreamingFragment(data, attempt + 1); }, 150 * (attempt + 1));
							}
						});
					}
					var chatHandler = function(event) {
						var data = event.detail || {};
						if (data.type !== 'chat_response_done' || data.task_id !== taskId || !data.exec_id) return;
						syncCompletedThreadOutput(data.exec_id, data.completed_output, data.status || 'completed');
					};
					var handler = function(event) {
						var data = event.detail || {};
						if (data.type !== 'mixture_progress' && data.task_id !== taskId) return;
						if (data.type === 'mixture_progress') {
							if (window.applyMixtureProgress) window.applyMixtureProgress(data);
							return;
						}
						if (data.type === 'task_status_changed' || data.type === 'task_category_changed') {
						refreshPendingInputsIfVisible();
						return;
					}
					if (data.type === 'task_thread_execution_started') {
						refreshPendingInputsIfVisible();
						ensureStreamingFragment(data);
						return;
					}
							if (data.type === 'task_thread_input_applied') {
								removePendingRow(data.pending_input_id);
								refreshPendingInputsIfVisible();
								ensureStreamingFragment(data);
								return;
							}
							if (data.type === 'task_thread_input_cancelled') {
								removePendingRow(data.pending_input_id);
								return;
							}						if (data.type === 'task_thread_input_queued') {
							renderQueuedRow(data);
						}
				};
					window._taskThreadLiveHandlers[taskId] = handler;
					window.addEventListener('sse-task-event', handler);
					window.addEventListener('sse-chat-live-event', chatHandler);
					consumePendingExecutionEvent();

					// On SSE reconnect (e.g. after tab blur/refocus), refresh the pending-inputs
				// container so any steering rows missed while the tab was hidden are reconciled.
				// The server query excludes prepared/in-flight steering (expected_turn_id=NULL),
				// so stale "Steering pending" rows are cleanly replaced with current state.
					var reconnectHandler = function(event) {
						var detail = event.detail || {};
						if (!detail.reconnected || !currentTaskThreadView()) return;
						var pendingContainer = currentPendingContainer();
						if (pendingContainer && typeof htmx !== 'undefined') {
							htmx.ajax('GET', '/tasks/' + encodeURIComponent(taskId) + '/thread/pending-inputs', {target: scopedPendingContainerSelector(), swap: 'outerHTML'});
						}
					};				window._taskThreadReconnectHandlers = window._taskThreadReconnectHandlers || {};
				if (window._taskThreadReconnectHandlers[taskId]) {
					window.removeEventListener('sse-live-connected', window._taskThreadReconnectHandlers[taskId]);
				}
				window._taskThreadReconnectHandlers[taskId] = reconnectHandler;
				window.addEventListener('sse-live-connected', reconnectHandler);

					document.body.addEventListener('htmx:beforeSwap', function(event) {
						var target = event.detail && event.detail.target;
						if (target && (target.id === 'main-content' || target.id === 'task-detail-content' || target.id === 'thread-content' || target.id === 'task-thread-view')) {
							window.removeEventListener('sse-task-event', handler);
							window.removeEventListener('sse-chat-live-event', chatHandler);
							delete window._taskThreadLiveHandlers[taskId];
							window.removeEventListener('sse-live-connected', reconnectHandler);
							delete window._taskThreadReconnectHandlers[taskId];
						}
					}, { once: true });			})();
		</script>
}

// TaskThreadFollowupResponse renders user message + streaming assistant for a task thread follow-up.
// Delegates to the shared ChatFollowupResponse component with thread settings.
templ TaskThreadFollowupResponse(message string, execID string, attachments []models.ChatAttachment) {
	@ChatFollowupResponse(message, execID, "task-thread-messages", "task-thread-view", true, attachments)
}

templ TaskThreadQueuedFollowupResponse(message string, attachments []models.ChatAttachment) {
	if len(attachments) > 0 {
		@ChatBubbleWithAttachments("User", message, attachments)
	} else {
		@ChatBubble("User", message)
	}
	@ChatBubble("Assistant", "Queued. This message will be sent to the model after the active response finishes.")
}

// TaskExecutionHistory renders just the execution history section for polling updates
templ TaskExecutionHistory(task *models.Task, executions []models.Execution) {
	<div
		id="task-execution-history"
		class="mt-6"
		if task.Status == models.StatusRunning || task.Status == models.StatusPending {
			hx-get={ fmt.Sprintf("/tasks/%s/executions", task.ID) }
			hx-trigger="every 3s"
			hx-target="#task-execution-history"
			hx-swap="morph:outerHTML"
		}
	>
		<div class="flex items-center justify-between mb-3">
			<h4 class="text-lg font-bold">Execution History</h4>
			<div class="flex items-center gap-2">
				if task.Status == models.StatusRunning {
					<button
						class="btn btn-sm btn-error"
						hx-post={ fmt.Sprintf("/tasks/%s/cancel", task.ID) }
						hx-target="#task-execution-history"
						hx-swap="morph:outerHTML"
						hx-confirm="Cancel this running task?"
					>
						Cancel Task
					</button>
					<span class="loading loading-spinner loading-sm"></span>
				}
			</div>
		</div>
		if len(executions) == 0 {
			<p class="opacity-50">No executions yet</p>
		} else {
			for i, exec := range executions {
				<div class="card bg-base-100 shadow-sm border border-base-300 mb-2">
					<div class="card-body p-4">
						<div class="flex items-center justify-between mb-2">
							<div class="flex flex-col text-sm opacity-60">
								<span>Started: { exec.StartedAt.Local().Format("2006-01-02 3:04:05 PM") }</span>
								if exec.CompletedAt != nil {
									<span>Finished: { exec.CompletedAt.Local().Format("2006-01-02 3:04:05 PM") }</span>
								}
							</div>
							if exec.Status == models.ExecRunning && i == 0 && task.Status == models.StatusRunning {
								<div class="text-sm opacity-60">
									<span class="badge badge-warning">Elapsed: { FormatElapsedTime(exec.StartedAt) }</span>
								</div>
							} else if exec.DurationMs > 0 || exec.TokensUsed > 0 {
								<div class="text-sm opacity-60">
									{ fmt.Sprintf("%d tokens, %s", exec.TokensUsed, formatDuration(exec.DurationMs)) }
								</div>
							}
						</div>
						if exec.Status == models.ExecRunning && exec.Output == "" {
							<div class="flex items-center gap-2 p-3 bg-base-200 rounded-lg">
								<span class="loading loading-spinner loading-sm"></span>
								<span class="text-sm opacity-60">Model is working on this task...</span>
							</div>
						}
						if exec.Output != "" {
							<div class="mb-2">
								<div class="flex items-center justify-between mb-1">
									<span class="text-xs opacity-60">Model Output:</span>
									<button
										class="btn btn-xs btn-ghost"
										onclick={ templ.ComponentScript{Call: fmt.Sprintf("copyToClipboard('exec-output-%s', this)", exec.ID)} }
										title="Copy to clipboard"
									>
										<svg xmlns="http://www.w3.org/2000/svg" class="h-4 w-4" fill="none" viewBox="0 0 24 24" stroke="currentColor">
											<path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M8 16H6a2 2 0 01-2-2V6a2 2 0 012-2h8a2 2 0 012 2v2m-6 12h8a2 2 0 002-2v-8a2 2 0 00-2-2h-8a2 2 0 00-2 2v8a2 2 0 002 2z"></path>
										</svg>
									</button>
								</div>
								<pre id={ fmt.Sprintf("exec-output-%s", exec.ID) } class="p-3 bg-base-200 rounded-lg text-sm whitespace-pre-wrap max-h-96 overflow-y-auto mt-1">{ exec.Output }</pre>
							</div>
						}
						if exec.ErrorMessage != "" {
							<div class="mb-2">
								<div class="flex items-center justify-between mb-1">
									<span class="text-xs opacity-60 text-error">Error:</span>
									<button
										class="btn btn-xs btn-ghost text-error"
										onclick={ templ.ComponentScript{Call: fmt.Sprintf("copyToClipboard('exec-error-%s', this)", exec.ID)} }
										title="Copy to clipboard"
									>
										<svg xmlns="http://www.w3.org/2000/svg" class="h-4 w-4" fill="none" viewBox="0 0 24 24" stroke="currentColor">
											<path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M8 16H6a2 2 0 01-2-2V6a2 2 0 012-2h8a2 2 0 012 2v2m-6 12h8a2 2 0 002-2v-8a2 2 0 00-2-2h-8a2 2 0 00-2 2v8a2 2 0 002 2z"></path>
										</svg>
									</button>
								</div>
								<pre id={ fmt.Sprintf("exec-error-%s", exec.ID) } class="p-3 bg-error/10 rounded-lg text-sm text-error whitespace-pre-wrap mt-1">{ exec.ErrorMessage }</pre>
							</div>
						}
					</div>
				</div>
			}
		}
	</div>
}
