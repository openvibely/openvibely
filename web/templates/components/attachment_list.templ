package components

import (
	"fmt"
	"net/url"

	"github.com/openvibely/openvibely/internal/models"
)

func TaskAttachmentUploadURL(taskID, projectID string) string {
	base := fmt.Sprintf("/tasks/%s/attachments", taskID)
	if projectID == "" {
		return base
	}
	return base + "?project_id=" + url.QueryEscape(projectID)
}

func TaskAttachmentDeleteURL(attachmentID, projectID string) string {
	base := fmt.Sprintf("/attachments/%s", attachmentID)
	if projectID == "" {
		return base
	}
	return base + "?project_id=" + url.QueryEscape(projectID)
}

func TaskAttachmentDownloadURL(id, projectID string) string {
 return fmt.Sprintf("/attachments/%s/download?project_id=%s", url.PathEscape(id), url.QueryEscape(projectID))
}

templ AttachmentList(attachments []models.Attachment, projectID string, taskID string) {
 <div>
  <style>
   #attachment-form .htmx-indicator { display:none; }
   #attachment-form.htmx-request .htmx-indicator { display:inline; }
  </style>
  <div class="flex items-center justify-between mb-3" style="height:20px">
   <h3 class="text-sm font-semibold">Attachments</h3>
   <button type="button" id="add-attachment-btn" class="btn btn-ghost btn-xs" aria-label="Add attachments" onclick="document.querySelector('#attachment-form input[type=file]').click()">+</button>
  </div>
  <form method="post" id="attachment-form" hx-post={ TaskAttachmentUploadURL(taskID, projectID) } hx-target="#attachment-list" hx-swap="outerHTML" hx-encoding="multipart/form-data" hx-on::after-request="if(event.detail.successful)this.reset()">
   <input type="file" name="files" multiple class="hidden" aria-label="Select attachments" onchange="this.form.requestSubmit()"/>
   <span class="htmx-indicator text-sm" role="status">Uploading…</span>
  </form>
  <div hx-get={ TaskAttachmentUploadURL(taskID, projectID) } hx-trigger="load, taskAttachmentsChanged from:body" hx-target="#attachment-list" hx-swap="outerHTML">
  @AttachmentListOnly(attachments, projectID)
  </div>
 </div>
}

templ ImageAttachmentRow(fileName string, fileSize int64, mediaType, downloadURL, deleteURL, target string) {
 <div class="attachment-gallery-row">
  <a href={ templ.SafeURL(downloadURL) } class="attachment-gallery-open" target="_blank" rel="noopener" data-image-name={ fileName }
   if IsImageMediaType(mediaType) {
    data-image-gallery-item=""
   }
  >
   if IsImageMediaType(mediaType) {
    <img src={ templ.SafeURL(downloadURL) } alt={ fileName } loading="lazy"/>
   } else { <span aria-hidden="true">▤</span> }
   <span class="min-w-0"><span class="block text-sm break-all">{ fileName }</span><span class="block text-xs opacity-60">{ FormatFileSize(fileSize) }</span></span>
  </a>
  if deleteURL != "" {
  <button type="button" class="btn btn-ghost btn-xs text-error shrink-0" aria-label={ "Remove " + fileName } hx-delete={ deleteURL } hx-target={ target } hx-swap="outerHTML">×</button>
  }
 </div>
}

templ AttachmentListRow(fileName string, fileSize int64, downloadURL string, deleteURL string, target string) {
	<div class="flex items-center justify-between p-2 bg-base-200 rounded">
		<div class="flex items-center gap-2">
			<svg class="w-5 h-5 text-base-content/70" fill="none" stroke="currentColor" viewBox="0 0 24 24">
				<path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M15.172 7l-6.586 6.586a2 2 0 102.828 2.828l6.414-6.586a4 4 0 00-5.656-5.656l-6.415 6.585a6 6 0 108.486 8.486L20.5 13"></path>
			</svg>
			<div>
				if downloadURL == "" {
					<p class="text-sm font-medium">{ fileName }</p>
				} else {
					<a href={ templ.SafeURL(downloadURL) } class="text-sm font-medium hover:underline" target="_blank">{ fileName }</a>
				}
				<p class="text-xs text-base-content/60">{ FormatFileSize(fileSize) }</p>
			</div>
		</div>
		<button class="btn btn-ghost btn-xs text-error" hx-delete={ deleteURL } hx-target={ target } hx-swap="outerHTML">
			<svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24">
				<path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M19 7l-.867 12.142A2 2 0 0116.138 21H7.862a2 2 0 01-1.995-1.858L5 7m5 4v6m4-6v6m1-10V4a1 1 0 00-1-1h-4a1 1 0 00-1 1v3M4 7h16"></path>
			</svg>
		</button>
	</div>
}

templ AttachmentListOnly(attachments []models.Attachment, projectID string, messageGroups ...[]models.ChatAttachment) {
	<div id="attachment-list" class="space-y-2" data-image-gallery-group="">
		if len(attachments) == 0 && (len(messageGroups) == 0 || len(messageGroups[0]) == 0) {
			<p class="text-sm opacity-50">No attachments</p>
		} else {
			for _, att := range attachments {
				@ImageAttachmentRow(att.FileName, att.FileSize, att.MediaType, TaskAttachmentDownloadURL(att.ID, projectID), TaskAttachmentDeleteURL(att.ID, projectID), "#attachment-list")
			}
		}
        for _, messages := range messageGroups {
            for _, att := range messages {
                @ImageAttachmentRow(att.FileName, att.FileSize, att.MediaType, ChatAttachmentDownloadURL(att.ID, projectID), "", "")
            }
        }
	</div>
}

func FormatFileSize(bytes int64) string {
	const unit = 1024
	if bytes < unit {
		return fmt.Sprintf("%d B", bytes)
	}
	div, exp := int64(unit), 0
	for n := bytes / unit; n >= unit; n /= unit {
		div *= unit
		exp++
	}
	return fmt.Sprintf("%.1f %cB", float64(bytes)/float64(div), "KMGTPE"[exp])
}
