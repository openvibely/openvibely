package components

import (
 "fmt"
 "net/url"
 "path/filepath"
 "strings"
 "github.com/openvibely/openvibely/pkg/filecontent"
)

func FileURLMode(raw, mode string) string { u,err:=url.Parse(raw);if err!=nil{return raw};q:=u.Query();q.Del("view");q.Del("raw");q.Del("download");q.Del("thumbnail");q.Set(mode,"1");u.RawQuery=q.Encode();return u.String() }
func FilePreviewKind(name string) string {
 ext:=strings.ToLower(filepath.Ext(name))
 switch ext {case ".pdf":return "pdf";case ".docx":return "docx";case ".xlsx",".xls",".xlsb",".ods",".csv",".tsv":return "table";case ".json":return "json";case ".html",".htm":return "html";case ".md",".markdown",".mdx":return "markdown";case ".doc",".ppt",".pptx":return "unknown"}
 media:=filecontent.FileMediaType(name,nil)
 if strings.HasPrefix(media,"video/"){return "video"};if strings.HasPrefix(media,"audio/"){return "audio"};if strings.HasPrefix(media,"image/")||ext==".svg"{return "image"};return "text"
}

templ FilePreview(name, kind, text, base string) {
 <section data-file-viewer={kind} data-file-name={name}>
 <header data-file-header><h3>{name}</h3><a href={templ.SafeURL(FileURLMode(base,"download"))} download>Download original</a></header>
 if kind=="pdf" {
 <nav data-pdf-controls aria-label="PDF controls"><button type="button" data-pdf-page="previous">Previous</button><input type="number" min="1" value="1" data-pdf-page-input aria-label="Page number"/><span data-pdf-page-number></span><button type="button" data-pdf-page="next">Next</button><button type="button" data-pdf-zoom="out" aria-label="Zoom out">−</button><button type="button" data-pdf-zoom="in" aria-label="Zoom in">+</button></nav>
 <p data-pdf-status role="status">Loading PDF…</p><button type="button" data-pdf-retry hidden>Try again</button>
 <form data-pdf-password hidden><label>PDF password<input type="password" data-pdf-password-input required/></label><button type="submit">Unlock</button><button type="button" data-pdf-password-cancel>Cancel</button><p data-pdf-password-status role="status"></p></form>
 <div class="result-pdf" data-pdf-viewer data-pdf-source={FileURLMode(base,"raw")}><div data-pdf-pages></div></div>
 } else if kind=="table" {
 <div data-file-viewer="table" data-spreadsheet-url={FileURLMode(base,"raw")}><p data-sheet-status role="status"></p><nav data-sheet-tabs aria-label="Sheets"></nav><div data-sheet-grid tabindex="0" role="region" aria-label="Spreadsheet cells"></div></div>
 } else if kind=="image" {
 <img src={templ.SafeURL(FileURLMode(base,"thumbnail"))} alt={name}/>
 } else if kind=="audio" {
 <audio controls preload="metadata" src={templ.SafeURL(FileURLMode(base,"raw"))}></audio><p>Audio is not automatically transcribed.</p>
 } else if kind=="video" {
 <video controls playsinline preload="metadata" src={templ.SafeURL(FileURLMode(base,"raw"))}></video>
 } else if kind=="html" {
 <nav><button type="button" data-file-html-mode="preview">Preview</button><button type="button" data-file-html-mode="source">Source</button></nav>
 <iframe title={name} sandbox="allow-scripts" referrerpolicy="no-referrer" src={templ.SafeURL(FileURLMode(base,"raw"))}></iframe><pre data-file-source hidden><code data-file-code>{text}</code></pre>
 } else if kind=="markdown" {
 <div data-file-markdown class="markdown-content">{text}</div>
 } else if kind=="json" {
 if node,ok:=fileJSONPreview(text);ok {
 <div data-json-tree>
 @FileJSONNode(node,0)
 </div>
 } else {
 <pre><code>{text}</code></pre>
 }
 } else if kind=="text" {
 <pre><code data-file-code>{text}</code></pre>
 } else if kind=="unsupported-encoding" {
 <p role="status">Unsupported text encoding. Save a copy as UTF-8 to preview it, or download the original.</p>
 } else {
 <p role="status">Preview not available. Download the original to open it on your computer.</p>
 }
 </section>
}

templ FileJSONNode(node jsonPreviewNode, depth int) {
 if node.Branch {
 <details open?={depth<2}><summary>{node.Label}{fmt.Sprintf(" %s (%d)",node.Value,node.Count)}</summary>
 for _,child:=range node.Children {
 @FileJSONNode(child,depth+1)
 }
 if node.Count>len(node.Children) {
 <p>{fmt.Sprintf("%d more items",node.Count-len(node.Children))}</p>
 }
 </details>
 } else { <div class="file-json-value"><span>{node.Label}</span>{": " + node.Value}</div> }
}
