package components

import (
	"fmt"
	"strings"

	"github.com/openvibely/openvibely/internal/models"
)

func githubDisplayLogin(login string) string {
	login = strings.TrimSpace(login)
	if login == "" {
		return ""
	}
	return "@" + login
}

// GitHubRuntimeSettings renders GitHub authorized users for runtime tools.
templ GitHubRuntimeSettings(actors []models.GitHubAuthorizedActor, inbox *models.GitHubProjectInbox, projectID string) {
	<div id="github-runtime-settings" class="space-y-5">
		<div>
			<h4 class="font-semibold text-sm mb-2 flex items-center gap-2">
				<svg xmlns="http://www.w3.org/2000/svg" class="h-4 w-4" fill="none" viewBox="0 0 24 24" stroke="currentColor">
					<path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 15v2m-6 4h12a2 2 0 002-2v-6a2 2 0 00-2-2H6a2 2 0 00-2 2v6a2 2 0 002 2zm10-10V7a4 4 0 00-8 0v4h8z"></path>
				</svg>
				Authorized Users
			</h4>
			<p class="text-xs opacity-60 mb-3">
				GitHub users allowed for this channel. Scheduled GitHub tasks can scan issues assigned to these users, and authorization checks use the same list.
			</p>
			if len(actors) == 0 {
				<p class="text-sm opacity-50 italic mb-3">No authorized users configured. GitHub authorization checks deny by default, and GitHub App/custom issue scanning has no assignee to use.</p>
			} else {
				<div class="space-y-2 mb-3">
					for _, actor := range actors {
						<div class="flex items-center justify-between bg-base-200 rounded-lg px-3 py-2 gap-3">
							<div class="flex items-center gap-2 min-w-0">
								<svg xmlns="http://www.w3.org/2000/svg" class="h-4 w-4 opacity-50 shrink-0" fill="none" viewBox="0 0 24 24" stroke="currentColor">
									<path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M16 7a4 4 0 11-8 0 4 4 0 018 0zM12 14a7 7 0 00-7 7h14a7 7 0 00-7-7z"></path>
								</svg>
								<span class="text-sm font-medium truncate">{ actor.DisplayName }</span>
								<span class="text-xs opacity-50 truncate">{ githubDisplayLogin(actor.GitHubLogin) }</span>
							</div>
							<button
								type="button"
								class="btn btn-ghost btn-xs text-error shrink-0"
								hx-delete={ fmt.Sprintf("/channels/github/authorized-actors/%s?project_id=%s", actor.ID, projectID) }
								hx-target="#github-runtime-settings"
								hx-swap="outerHTML"
								hx-confirm="Remove this authorized GitHub user?"
							>
								<svg xmlns="http://www.w3.org/2000/svg" class="h-4 w-4" fill="none" viewBox="0 0 24 24" stroke="currentColor">
									<path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M6 18L18 6M6 6l12 12"></path>
								</svg>
							</button>
						</div>
                        <details class="text-sm bg-base-200 rounded-lg p-3">
                            <summary>Reviewer identity for this project</summary>
                            if actor.ReviewerIdentity != nil {
                                <p class="my-2">Attested: { actor.ReviewerIdentity.Host } user { fmt.Sprint(actor.ReviewerIdentity.ExternalUserID) } → { actor.ReviewerIdentity.ApplicationUserID }</p>
                            } else {
                                <p class="my-2">No application user binding. A GitHub login alone does not establish application identity.</p>
                            }
                            <div id={ "github-reviewer-binding-" + actor.ID } class="space-y-2 mt-2">
                                <input type="hidden" name="project_id" value={ projectID }/>
                                <input aria-label="GitHub host" type="text" name="host" placeholder="github.com or enterprise host" class="input input-bordered input-sm"/>
                                <input aria-label="Numeric GitHub user ID" type="number" min="1" name="external_user_id" class="input input-bordered input-sm"/>
                                <input aria-label="Application user ID" type="text" name="application_user_id" class="input input-bordered input-sm"/>
                                <label class="flex gap-2"><input type="checkbox" name="attested" value="true" class="checkbox checkbox-sm"/>I verified that this GitHub account belongs to this application user.</label>
                                <button type="button" class="btn btn-sm" hx-post={ fmt.Sprintf("/channels/github/authorized-actors/%s/identity", actor.ID) } hx-include={ "#github-reviewer-binding-" + actor.ID } hx-target="#github-runtime-settings" hx-swap="outerHTML">Save verified binding</button>
                            </div>
                        </details>
					}
				</div>
			}
			<div class="grid grid-cols-1 md:grid-cols-[1fr_1fr_auto] gap-2" id="github-authorized-actors-add-controls">
				<input type="hidden" name="project_id" value={ projectID }/>
				<input type="hidden" name="permission" value="triage"/>
				<input type="text" name="github_login" placeholder="GitHub login, e.g. @alice" class="input input-bordered input-sm"/>
				<input type="text" name="display_name" placeholder="Display name (optional)" class="input input-bordered input-sm"/>
				<button
					type="button"
					class="btn btn-primary btn-sm"
					hx-post="/channels/github/authorized-actors"
					hx-target="#github-runtime-settings"
					hx-swap="outerHTML"
					hx-include="#github-authorized-actors-add-controls"
				>
					Add
				</button>
			</div>
		</div>
	</div>
}
