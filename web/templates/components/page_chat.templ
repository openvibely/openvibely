package components

import "github.com/openvibely/openvibely/internal/models"

// PageChatView uses server-authorized endpoints and saved conversation records.
// It has no dependency on a plugin, iframe, or a particular page type.
type PageChatView struct {
 Title string
 ProjectID string
 SendURL string
 StopURL string
 ChatExecutions []models.Execution
 ChatTask *models.Task
}

templ PageSideChat(v PageChatView) {
	<aside id="page-side-chat" class="hidden w-96 max-w-[45%] flex-col min-h-0 border border-base-300 rounded-lg bg-base-100" data-project-id={ v.ProjectID }>
		<div class="px-3 py-2 border-b border-base-300 text-sm font-semibold flex items-center justify-between">
			<span>Chat · { v.Title }</span>
			<span class="text-xs opacity-60">uses page context + tools</span>
		</div>
		<div id="page-chat-messages" class="flex-1 min-h-0 overflow-y-auto p-3 space-y-4" data-project-id={ v.ProjectID }>
			if len(v.ChatExecutions) > 0 {
				@ChatMessages(v.ChatExecutions, v.ChatTask, nil, "page-chat-messages", "", false, v.ProjectID)
			}
		</div>
		<form
			id="page-chat-form"
			class="p-2 border-t border-base-300 flex gap-2 items-end"
			hx-post={ v.SendURL }
			hx-target="#page-chat-messages"
			hx-swap="beforeend"
			hx-on::after-request="if(event.detail.successful){this.reset();}"
		>
			<textarea name="message" rows="2" class="textarea textarea-bordered textarea-sm flex-1" placeholder="Ask about this page…" required></textarea>
			<div class="flex flex-col gap-1">
				<button type="submit" class="btn btn-sm btn-primary">Send</button>
				<button type="button" class="btn btn-sm btn-ghost" hx-post={ v.StopURL } hx-swap="none">Stop</button>
			</div>
		</form>
		@ChatAutoScrollScript()
		@pageChatInputRequestsScript()
	</aside>
}

script pageChatInputRequestsScript() {
	function sideChat() { return document.getElementById('page-chat-messages'); }
	function loadCards(execId) {
		var box = sideChat();
		var pair = box && document.getElementById('chat-execution-' + execId);
		if (!pair || !box.contains(pair)) return;
		var pid = box.getAttribute('data-project-id') || '';
		fetch('/chat/input-requests?project_id=' + encodeURIComponent(pid) + '&execution_id=' + encodeURIComponent(execId)).then(function(resp) {
			if (!resp.ok) throw new Error('HTTP ' + resp.status);
			return resp.text();
		}).then(function(html) {
			if (sideChat() !== box) return;
			var t = document.createElement('template');
			t.innerHTML = html;
			t.content.querySelectorAll('[data-chat-input-request-id]').forEach(function(card) {
				if (document.getElementById(card.id)) return;
				pair.appendChild(card);
			});
			window.initChatInputRequestCards(pair);
			if (window.chatAutoScroll) window.chatAutoScroll.scrollToBottom(box, true);
		}).catch(function(err) { console.error('[page-chat] input request load failed:', err); });
	}
	window.bindChatInputRequestControls();
	if (!window._pageChatInputRequestsBound) {
		window._pageChatInputRequestsBound = true;
		window.addEventListener('sse-chat-live-event', function(event) {
			var data = event.detail || {};
			var box = sideChat();
			if (!box || (data.project_id && data.project_id !== box.getAttribute('data-project-id'))) return;
			var request = data.input_request || {};
			if (data.type === 'chat_user_input_requested' && !request.completed) loadCards(request.exec_id || data.exec_id || '');
			if (data.type === 'chat_user_input_resolved' || request.completed) {
				var card = request.id && document.getElementById('chat-input-request-' + request.id);
				if (card && box.contains(card)) window.completeChatInputRequest(card);
			}
		});
	}
	var box = sideChat();
	if (box) {
		// Cards restored on page load come from the shared execution-pair loader.
		new MutationObserver(function() { window.initChatInputRequestCards(box); }).observe(box, {childList: true, subtree: true});
		window.initChatInputRequestCards(box);
	}
}
