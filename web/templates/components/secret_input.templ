package components

type SecretInputConfig struct {
	ID           string
	Name         string
	Value        string
	Placeholder  string
	Class        string
	AutoComplete string
	OnInput      string
	AriaLabel    string
	ReadOnly     bool
	Required     bool
}

templ SecretInputVisibilityScript() {
	<script>
		(function() {
			if (window.openVibelySecretInputVisibility) {
				window.togglePasswordVisibility = window.openVibelySecretInputVisibility.togglePasswordVisibility;
				window.resetSecretInputVisibility = window.openVibelySecretInputVisibility.resetSecretInputVisibility;
				return;
			}

			function togglePasswordVisibility(inputId, button) {
				const input = document.getElementById(inputId);
				if (!input || !button) return;
				const eyeOpen = button.querySelector('.eye-open');
				const eyeClosed = button.querySelector('.eye-closed');
				const willReveal = input.type === 'password';
				input.type = willReveal ? 'text' : 'password';
				if (eyeOpen) eyeOpen.classList.toggle('hidden', willReveal);
				if (eyeClosed) eyeClosed.classList.toggle('hidden', !willReveal);
				button.setAttribute('aria-pressed', willReveal ? 'true' : 'false');
			}

			function resetSecretInputVisibility(inputId) {
				const input = document.getElementById(inputId);
				if (!input) return;
				input.type = 'password';
				const button = document.querySelector("button[onclick=\"togglePasswordVisibility('" + inputId + "', this)\"]");
				if (!button) return;
				const eyeOpen = button.querySelector('.eye-open');
				const eyeClosed = button.querySelector('.eye-closed');
				if (eyeOpen) eyeOpen.classList.remove('hidden');
				if (eyeClosed) eyeClosed.classList.add('hidden');
				button.setAttribute('aria-pressed', 'false');
			}

			window.openVibelySecretInputVisibility = {
				togglePasswordVisibility: togglePasswordVisibility,
				resetSecretInputVisibility: resetSecretInputVisibility,
			};
			window.togglePasswordVisibility = togglePasswordVisibility;
			window.resetSecretInputVisibility = resetSecretInputVisibility;
		})();
	</script>
}

templ SecretInput(config SecretInputConfig) {
	<div class="relative">
		<input
			type="password"
			id={ config.ID }
			class={ config.Class }
			placeholder={ config.Placeholder }
			value={ config.Value }
			autocomplete={ config.AutoComplete }
			if config.Name != "" {
				name={ config.Name }
			}
			if config.OnInput != "" {
				oninput={ templ.ComponentScript{Call: config.OnInput} }
			}
			if config.ReadOnly {
				readonly
			}
			if config.Required {
				required
			}
		/>
		<button
			type="button"
			class="password-toggle-btn btn btn-ghost btn-sm absolute right-1 top-1/2 -translate-y-1/2 h-8 min-h-0 px-2"
			onclick={ templ.ComponentScript{Call: "togglePasswordVisibility('" + config.ID + "', this)"} }
			aria-label={ config.AriaLabel }
			aria-pressed="false"
		>
			<svg class="eye-open h-4 w-4" xmlns="http://www.w3.org/2000/svg" fill="none" viewBox="0 0 24 24" stroke="currentColor" aria-hidden="true">
				<path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M15 12a3 3 0 11-6 0 3 3 0 016 0z"></path>
				<path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M2.458 12C3.732 7.943 7.523 5 12 5c4.478 0 8.268 2.943 9.542 7-1.274 4.057-5.064 7-9.542 7-4.477 0-8.268-2.943-9.542-7z"></path>
			</svg>
			<svg class="eye-closed h-4 w-4 hidden" xmlns="http://www.w3.org/2000/svg" fill="none" viewBox="0 0 24 24" stroke="currentColor" aria-hidden="true">
				<path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M13.875 18.825A10.05 10.05 0 0112 19c-4.478 0-8.268-2.943-9.543-7a9.97 9.97 0 011.563-3.029m5.858.908a3 3 0 114.243 4.243M9.878 9.878l4.242 4.242M9.88 9.88l-3.29-3.29m7.532 7.532l3.29 3.29M3 3l3.59 3.59m0 0A9.953 9.953 0 0112 5c4.478 0 8.268 2.943 9.543 7a10.025 10.025 0 01-4.132 5.411m0 0L21 21"></path>
			</svg>
		</button>
	</div>
}
