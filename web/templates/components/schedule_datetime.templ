package components

import "time"

func scheduleDateTimeLabel(value string) string {
 date, err := time.Parse("2006-01-02T15:04", value)
 if err != nil { return "" }
 return date.Format("01/02/2006, 03:04 PM")
}

// ScheduleDateTime keeps the existing local run_at form contract in every editor.
templ ScheduleDateTime(value string) {
 <div data-schedule-datetime style="position:relative">
  <input type="text" hidden name="run_at" value={ value }/>
  <input type="text" value={ scheduleDateTimeLabel(value) } data-run-at-picker class="input input-bordered cursor-pointer w-full" required placeholder="Choose date and time" onbeforeinput="event.preventDefault()" aria-label="Run at" aria-haspopup="dialog" aria-expanded="false" autocomplete="off" onclick="window.openScheduleDateTime(this)" onkeydown="if(event.key==='ArrowDown'||event.key==='Enter'||event.key===' '){event.preventDefault();window.openScheduleDateTime(this)}"/>
  <svg class="schedule-datetime-icon" xmlns="http://www.w3.org/2000/svg" width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" aria-hidden="true"><rect x="3" y="5" width="18" height="16" rx="2"></rect><path d="M16 3v4M8 3v4M3 11h18"></path></svg>
  <div class="schedule-datetime-popup" popover="auto" role="dialog" aria-label="Choose date and time">
   <div class="schedule-datetime-body">
    <div class="schedule-datetime-calendar">
     <div class="schedule-datetime-month">
      <button type="button" class="btn btn-xs btn-ghost" data-today aria-label="Go to current month">Today</button>
      <div class="flex items-center gap-0">
       <button type="button" class="btn btn-xs btn-ghost px-1" data-month-step="-1" aria-label="Previous month"><svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" aria-hidden="true"><path d="M15 19l-7-7 7-7"></path></svg></button>
       <button type="button" class="btn btn-xs btn-ghost px-1" data-month-step="1" aria-label="Next month"><svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" aria-hidden="true"><path d="M9 5l7 7-7 7"></path></svg></button>
      </div>
      <span data-month-title aria-live="polite"></span>
     </div>
     <div class="schedule-datetime-weekdays" aria-hidden="true"><span>Su</span><span>Mo</span><span>Tu</span><span>We</span><span>Th</span><span>Fr</span><span>Sa</span></div>
     <div class="schedule-datetime-days" role="group" aria-label="Date"></div>
    </div>
    <div class="schedule-datetime-time"><div data-time-column="hour" role="listbox" aria-label="Hour" tabindex="0"></div></div>
    <div class="schedule-datetime-time"><div data-time-column="minute" role="listbox" aria-label="Minute" tabindex="0"></div></div>
    <div class="schedule-datetime-time"><div data-time-column="period" role="listbox" aria-label="AM or PM" tabindex="0"></div></div>
   </div>
  </div>
 </div>
 <style>
  [data-schedule-datetime] > [data-run-at-picker] { padding-right:38px; }
  .schedule-datetime-icon { position:absolute; right:12px; top:50%; transform:translateY(-50%); pointer-events:none; }

  .schedule-datetime-popup { margin:0; padding:12px; width:450px; max-width:calc(100vw - 16px); border:1px solid oklch(var(--bc) / .18); border-radius:12px; background:oklch(var(--b1)); color:oklch(var(--bc)); box-shadow:0 12px 36px #0004; }
  .schedule-datetime-body { display:grid; grid-template-columns:minmax(0, 1fr) 48px 48px 60px; gap:4px; }
  .schedule-datetime-calendar { padding-right:8px; min-width:0; }
  .schedule-datetime-month { display:flex; flex-wrap:wrap; align-items:center; gap:4px; min-height:34px; padding-bottom:4px; font-size:12px; white-space:nowrap; }
  .schedule-datetime-month > * { flex-shrink:0; }
  .schedule-datetime-weekdays,.schedule-datetime-days { display:grid; grid-template-columns:repeat(7,minmax(0,1fr)); text-align:center; font-size:12px; }
  .schedule-datetime-weekdays { height:26px; align-items:center; opacity:.6; }
  .schedule-datetime-days button { height:30px; border-radius:6px; padding:0; }
  .schedule-datetime-days button[data-other-month] { opacity:.4; }
  .schedule-datetime-popup button:hover { background:oklch(var(--bc) / .1); }
  .schedule-datetime-popup [aria-pressed=true],.schedule-datetime-popup [data-time-selected=true] { background:oklch(var(--p)) !important; color:oklch(var(--pc)); opacity:1 !important; }
  .schedule-datetime-popup :focus-visible { outline:2px solid oklch(var(--p)); outline-offset:-2px; }
  .schedule-datetime-time { text-align:center; min-width:0; }
  .schedule-datetime-time [role=listbox] { height:240px; overflow-y:auto; overscroll-behavior:contain; scrollbar-width:none; overflow-anchor:none; }
  .schedule-datetime-time [role=listbox]::-webkit-scrollbar { display:none; }
  .schedule-datetime-time [role=option] { display:block; width:100%; height:30px; border-radius:6px; font-size:13px; }
  @media(max-width:380px) { .schedule-datetime-popup { padding:8px; } .schedule-datetime-body { grid-template-columns:minmax(0,1fr) 36px 36px 46px; gap:2px; } .schedule-datetime-calendar { padding-right:3px; } }
 </style>
 <script>
 (() => {
  queueMicrotask(()=>window.refreshScheduleDateTimes(document));
  if (window.openScheduleDateTime) return;
  let active = null;
  let nextID = 0;
  const pad = n => String(n).padStart(2,'0');
  const dateValue = d => `${d.getFullYear()}-${pad(d.getMonth()+1)}-${pad(d.getDate())}`;
  const localValue = d => `${dateValue(d)}T${pad(d.getHours())}:${pad(d.getMinutes())}`;
  const stored = input => input.parentElement.querySelector('[name="run_at"]');
  function refresh(input) {
   if(!stored(input).value) {
    const now=new Date(); now.setMinutes(now.getMinutes()+1); now.setSeconds(0,0);
    stored(input).value=localValue(now);
   }
   const value=stored(input).value, date=new Date(value);
   input.value=value && !Number.isNaN(date.getTime()) ? `${pad(date.getMonth()+1)}/${pad(date.getDate())}/${date.getFullYear()}, ${pad(date.getHours()%12||12)}:${pad(date.getMinutes())} ${date.getHours()<12?'AM':'PM'}` : '';
  }
  window.refreshScheduleDateTimes=root=>root.querySelectorAll('[data-run-at-picker]').forEach(refresh);
  document.addEventListener('reset',event=>queueMicrotask(()=>window.refreshScheduleDateTimes(event.target)));
  document.addEventListener('toggle',event=>{if(event.target.tagName==='DIALOG')window.refreshScheduleDateTimes(event.target);},true);
  function position(state) {
   const rect = state.input.getBoundingClientRect();
   const popup = state.popup;
   popup.style.maxHeight = `${window.innerHeight-16}px`;
   popup.style.overflowY = 'auto';
   popup.style.left = `${Math.max(8,Math.min(rect.left,window.innerWidth-popup.offsetWidth-8))}px`;
   const below = rect.bottom+6;
   popup.style.top = `${Math.max(8,below+popup.offsetHeight<=window.innerHeight-8 ? below : rect.top-popup.offsetHeight-6)}px`;
  }
  function write(state) {
   stored(state.input).value = localValue(state.selected);
   refresh(state.input);
   state.input.setCustomValidity('');
   stored(state.input).dispatchEvent(new Event('input',{bubbles:true}));
   state.input.dispatchEvent(new Event('input',{bubbles:true}));
   state.input.dispatchEvent(new Event('change',{bubbles:true}));
  }
  function close(state, focus) {
   if (state.popup.matches(':popover-open')) state.popup.hidePopover();
   state.input.setAttribute('aria-expanded','false');
   if(active===state) active=null;
   if(focus && state.input.isConnected) state.input.focus();
  }
  function calendar(state, focusDate) {
   const {popup,selected,month} = state;
   const today=new Date();
   const todayButton=popup.querySelector('[data-today]');
   const currentMonth=month.getFullYear()===today.getFullYear() && month.getMonth()===today.getMonth();
   if(currentMonth && document.activeElement===todayButton)popup.querySelector('[data-month-step="-1"]').focus({preventScroll:true});
   todayButton.disabled=currentMonth;
   popup.querySelector('[data-month-title]').textContent=month.toLocaleDateString(undefined,{month:'long',year:'numeric'});
   const days=popup.querySelector('.schedule-datetime-days');
   days.replaceChildren();
   const start=new Date(month.getFullYear(),month.getMonth(),1,12);
   start.setDate(start.getDate()-start.getDay());
   for(let i=0;i<42;i++) {
    const day=new Date(start); day.setDate(start.getDate()+i);
    const button=document.createElement('button'); button.type='button';
    button.textContent=day.getDate(); button.dataset.date=dateValue(day);
    button.setAttribute('aria-label',day.toLocaleDateString(undefined,{weekday:'long',year:'numeric',month:'long',day:'numeric'}));
    button.setAttribute('aria-pressed',String(dateValue(day)===dateValue(selected)));
    button.tabIndex=dateValue(day)===dateValue(focusDate||selected)?0:-1;
    if(day.getMonth()!==month.getMonth())button.dataset.otherMonth='';
    button.onclick=()=>{
     state.selected=new Date(day.getFullYear(),day.getMonth(),day.getDate(),selected.getHours(),selected.getMinutes());
     state.month=new Date(day.getFullYear(),day.getMonth(),1);
     write(state); calendar(state,day); timeColumns(state,true);
     days.querySelector('[tabindex="0"]').focus();
    };
    button.onkeydown=event=>{
     const offsets={ArrowLeft:-1,ArrowRight:1,ArrowUp:-7,ArrowDown:7};
     if(!(event.key in offsets))return;
     event.preventDefault(); const next=new Date(day); next.setDate(next.getDate()+offsets[event.key]);
     state.month=new Date(next.getFullYear(),next.getMonth(),1); calendar(state,next);
     days.querySelector('[tabindex="0"]').focus();
    };
    days.append(button);
   }
   if(!days.querySelector('[tabindex="0"]'))days.querySelector('button:not([data-other-month])').tabIndex=0;
  }
  function timeColumns(state, scroll) {
   state.popup.querySelectorAll('[data-time-column]').forEach(column=>{
    const kind=column.dataset.timeColumn;
    const current=kind==='hour'?(state.selected.getHours()%12||12):kind==='minute'?state.selected.getMinutes():Math.floor(state.selected.getHours()/12);
    const count=kind==='hour'?12:kind==='minute'?60:2;
    const looping=kind!=='period';
    const middle=looping?2:0;
    const rowHeight=30;
    const cycleHeight=count*rowHeight;
    if(!column.children.length) {
     for(let i=0;i<count*(looping?5:1);i++) {
      const value=kind==='hour'?i%count+1:i%count;
      const cycle=Math.floor(i/count);
      const option=document.createElement('button'); option.type='button'; option.tabIndex=-1;
      option.id=`schedule-time-${++nextID}`; option.setAttribute('role','option'); option.dataset.value=value;
      option.dataset.cycle=cycle;
      if(cycle!==middle)option.setAttribute('aria-hidden','true');
      option.textContent=kind==='period'?['AM','PM'][value]:pad(value);
      option.onclick=()=>choose(value,false);
      column.append(option);
     }
     column.onscroll=()=>{
      if(!looping)return;
      // Keep the same visible sequence in the middle copies before reaching an end.
      if(column.scrollTop<cycleHeight || column.scrollTop>=cycleHeight*3) {
       column.scrollTop=cycleHeight*2+((column.scrollTop%cycleHeight)+cycleHeight)%cycleHeight;
      }
     };
     column.onkeydown=event=>{
      const value=kind==='hour'?(state.selected.getHours()%12||12):kind==='minute'?state.selected.getMinutes():Math.floor(state.selected.getHours()/12);
      const index=kind==='hour'?value-1:value;
      let next=index;
      if(event.key==='ArrowDown')next=looping?(index+1)%count:Math.min(count-1,index+1);
      else if(event.key==='ArrowUp')next=looping?(index+count-1)%count:Math.max(0,index-1);
      else if(event.key==='Home')next=0;
      else if(event.key==='End')next=count-1;
      else return;
      event.preventDefault(); choose(kind==='hour'?next+1:next,true);
     };
    }
    function choose(value, reveal) {
     const hour=state.selected.getHours();
     if(kind==='hour')state.selected.setHours(value%12+(hour>=12?12:0));
     else if(kind==='minute')state.selected.setMinutes(value);
     else state.selected.setHours(hour%12+value*12);
     write(state); calendar(state); timeColumns(state,false); column.focus({preventScroll:true});
     if(reveal) {
      const selected=column.querySelector('[aria-selected="true"]');
      column.scrollTop=Array.from(column.children).indexOf(selected)*rowHeight-60;
     }
    }
    Array.from(column.children).forEach(option=>{
     const selected=Number(option.dataset.value)===current;
     option.dataset.timeSelected=String(selected);
     option.setAttribute('aria-selected',String(selected && Number(option.dataset.cycle)===middle));
    });
    const selected=column.querySelector('[aria-selected="true"]');
    column.setAttribute('aria-activedescendant',selected.id);
    if(scroll)column.scrollTop=Array.from(column.children).indexOf(selected)*rowHeight-60;
   });
  }
  window.openScheduleDateTime=input=>{
   const popup=input.parentElement.querySelector('.schedule-datetime-popup');
   if(active && active.popup===popup)return;
   if(active)close(active,false);
   let selected=new Date(stored(input).value);
   if(!stored(input).value||Number.isNaN(selected.getTime())) { selected=new Date(); selected.setMinutes(selected.getMinutes()+1); }
   selected.setSeconds(0,0);
   const state={input,popup,selected,month:new Date(selected.getFullYear(),selected.getMonth(),1)};
   active=state;
   if(!popup.id)popup.id=`schedule-datetime-${++nextID}`;
   input.setAttribute('aria-controls',popup.id);
   input.setAttribute('aria-expanded','true');
   // Rebuild column handlers on each opening so draft/reset values are authoritative.
   popup.querySelectorAll('[data-time-column]').forEach(column=>column.replaceChildren());
   calendar(state); timeColumns(state,false);
   popup.ontoggle=()=>{if(!popup.matches(':popover-open'))close(state,false);};
   popup.onkeydown=event=>{if(event.key==='Escape'){event.preventDefault();event.stopPropagation();close(state,true);}};
   // Safari does not focus buttons on mouse down. Keep focus in the popup
   // while replacing calendar days so modal focus handling cannot dismiss it.
   popup.onmousedown=event=>{if(event.target.closest('button'))event.preventDefault();};
   popup.showPopover(); position(state); timeColumns(state,true);
   popup.querySelector('.schedule-datetime-days [tabindex="0"]').focus();
  };
  // Delegate static controls: HTMX morphs can replace their DOM nodes while open.
  document.addEventListener('click',event=>{
   const button=event.target.closest('[data-month-step], [data-today]');
   if(!active || !button || !active.popup.contains(button))return;
   const state=active;
   // Focus the persistent control before replacing the focused calendar day.
   button.focus({preventScroll:true});
   if(button.hasAttribute('data-month-step')) {
    state.month=new Date(state.month.getFullYear(),state.month.getMonth()+Number(button.dataset.monthStep),1);
    calendar(state);
   } else if(button.hasAttribute('data-today')) {
    const today=new Date();
    state.month=new Date(today.getFullYear(),today.getMonth(),1);
    calendar(state);
   }
  });
  window.addEventListener('resize',()=>{if(active)position(active);});
  document.addEventListener('scroll',event=>{if(active && !active.popup.contains(event.target))position(active);},true);
  document.addEventListener('close',event=>{if(active && event.target.contains(active.input))close(active,false);},true);
  document.addEventListener('htmx:beforeSwap',event=>{
   const target=event.detail && event.detail.target;
   if(active && target && target.contains(active.input))close(active,false);
  });
 })();
 </script>
}
