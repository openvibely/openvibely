package components

import (
	"fmt"

	"github.com/openvibely/openvibely/internal/models"
)

// DiscordAuthorizedUsersList renders the list of authorized Discord users with add/remove controls.
templ DiscordAuthorizedUsersList(users []models.DiscordAuthorizedUser, projectID string) {
	@channelAuthorizationList(
		channelAuthorizationListConfig{
			ContainerID: "discord-authorized-users",
			Description: "Organization administrators manage this trust list. Application identity bindings are project-specific. When authentication is enabled, Discord messages are accepted only from senders bound to an enabled application user with editor access or higher on this project.",
			EmptyState: "No authorized users configured. Access is denied until authorized users are added.",
			RemoveConfirmation: "Remove this authorized user?",
			AddHelp: "Use the numeric Discord user ID from Developer Mode, not the username or display name.",
		},
		discordAuthorizationRows(users, projectID),
		channelAuthorizationAddConfig{
			ProjectID: projectID,
			Endpoint: "/channels/discord/authorized-users",
			InputType: "text",
			InputName: "discord_user_id",
			InputPlaceholder: "Numeric Discord user ID, e.g. 123456789012345678",
		},
	)
}

func discordAuthorizationRows(users []models.DiscordAuthorizedUser, projectID string) []channelAuthorizationRow {
	rows := make([]channelAuthorizationRow, 0, len(users))
	for _, user := range users {
		rows = append(rows, channelAuthorizationRow{
			Identity:       discordAuthorizedUserIdentity(user),
			ProjectID:      user.ProjectID,
			DeleteEndpoint: fmt.Sprintf("/channels/discord/authorized-users/%s?project_id=%s", user.ID, user.ProjectID),
		})
	}
	return rows
}

templ discordAuthorizedUserIdentity(user models.DiscordAuthorizedUser) {
 <div class="space-y-2">
	<div class="flex items-center gap-2">
		<svg xmlns="http://www.w3.org/2000/svg" class="h-4 w-4 opacity-50" fill="none" viewBox="0 0 24 24" stroke="currentColor">
			<path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M16 7a4 4 0 11-8 0 4 4 0 018 0zM12 14a7 7 0 00-7 7h14a7 7 0 00-7-7z"></path>
		</svg>
		<span class="text-sm font-medium">{ user.DisplayName }</span>
		<span class="text-xs opacity-50">{ fmt.Sprintf("ID: %s", user.DiscordUserID) }</span>
	</div>

 <p class="text-xs opacity-60">
 if user.ApplicationUserID == "" {
 <span>Application identity: unbound</span>
 } else {
 <span>Application user: { user.ApplicationUserID }</span>
 }
 </p>
 <div id={ "discord-identity-" + user.ID } class="flex flex-wrap gap-2">
 <input type="hidden" name="project_id" value={ user.ProjectID }/>
 <input class="input input-bordered input-xs" name="application_user_id" aria-label="Application user ID" placeholder="Application user ID" value={ user.ApplicationUserID }/>
 <label class="text-xs"><input type="checkbox" name="attested" value="true"/> I verified this Discord numeric ID belongs to this application user.</label>
 <button type="button" class="btn btn-xs" hx-post={ "/channels/discord/authorized-users/" + user.ID + "/identity" } hx-include={ "#discord-identity-" + user.ID } hx-target="#discord-authorized-users" hx-swap="outerHTML" hx-confirm="Replace this project's identity binding?">Bind identity</button>
 </div>
 </div>
}
