package components

import (
	"fmt"

	"github.com/openvibely/openvibely/internal/models"
	templateui "github.com/openvibely/openvibely/web/templates"
)

templ BreadcrumbSelector(config models.BreadcrumbSelector) {
	<div class={ "min-w-0", templ.KV("shrink-0 w-0 overflow-visible", config.CaretOnly) } data-breadcrumb-selector data-searchable-selector data-searchable-selector-kind={ config.Kind }>
		if config.ContextName != "" {
			<input type="hidden" name={ config.ContextName } value={ config.ContextValue } data-breadcrumb-selector-context/>
		}
		if config.OriginName != "" {
			<input type="hidden" name={ config.OriginName } value={ config.OriginValue } data-breadcrumb-selector-origin/>
		}
		<button
			id={ config.ID + "-button" }
			class={ "inline-flex items-center rounded-btn py-0 text-left font-bold leading-tight transition-colors hover:bg-base-200 focus-visible:outline focus-visible:outline-2 focus-visible:outline-primary", templ.KV("max-w-full gap-1 px-1 text-2xl", !config.CaretOnly), templ.KV("relative z-10 h-8 w-7 justify-center px-0", config.CaretOnly) }
			type="button"
			aria-label={ "Switch " + config.Kind }
			aria-haspopup="dialog"
			aria-expanded="false"
			aria-controls={ config.ID + "-dialog" }
			data-breadcrumb-selector-button
			data-searchable-selector-trigger
			data-breadcrumb-selector-caret-only?={ config.CaretOnly }
		>
			if !config.CaretOnly {
				<span class="min-w-0 truncate">{ config.CurrentName }</span>
			}
			<svg class="h-4 w-4 shrink-0 opacity-60" width="16" height="16" viewBox="0 0 20 20" fill="currentColor" aria-hidden="true" data-breadcrumb-selector-caret data-searchable-selector-caret><path fill-rule="evenodd" d="M5.23 7.21a.75.75 0 011.06.02L10 11.168l3.71-3.938a.75.75 0 111.08 1.04l-4.25 4.5a.75.75 0 01-1.08 0l-4.25-4.5a.75.75 0 01.02-1.06z" clip-rule="evenodd"></path></svg>
		</button>
		@templateui.SearchableSelector(templateui.SearchableSelectorConfig{
			ID: config.ID,
			Kind: config.Kind,
			SearchURL: config.SearchURL,
			InitialStatus: "Search results update as you type.",
		}) {
			<p class="px-3 py-6 text-center text-sm text-base-content/60">Loading { config.Kind }s…</p>
		}
	</div>
}

templ BreadcrumbSelectorResults(kind string, currentID string, items []models.BreadcrumbSelectorItem, hasMore bool) {
	if len(items) == 0 {
		<div class="px-3 py-8 text-center" data-breadcrumb-selector-empty data-searchable-selector-empty>
			<p class="font-medium">No { kind }s found</p>
			<p class="mt-1 text-sm text-base-content/60">Try a different search.</p>
		</div>
	} else {
		<div role="listbox" aria-label={ kind + "s" } class={ templateui.SearchableSelectorMenuClass }>
			for _, item := range items {
				<a
					class={ templateui.SearchableSelectorOptionClass }
					href={ templ.URL(item.URL) }
					role="option"
					aria-selected={ fmt.Sprintf("%t", item.ID == currentID) }
					aria-current={ fmt.Sprintf("%t", item.ID == currentID) }
					data-breadcrumb-selector-option
					data-searchable-selector-option
				>
					<span class="w-4 shrink-0" aria-hidden="true">{ breadcrumbSelectorCheck(item.ID == currentID) }</span>
					<span class="min-w-0 break-words">{ item.Name }</span>
				</a>
			}
		</div>
		if hasMore {
			<p class="px-3 py-2 text-center text-xs text-base-content/60">More matches are available. Refine your search.</p>
		}
	}
}

func breadcrumbSelectorCheck(current bool) string {
	if current {
		return "✓"
	}
	return ""
}
