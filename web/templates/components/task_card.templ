package components

import (
	"fmt"
	"strings"

	"github.com/openvibely/openvibely/internal/models"
)

func findModelByID(models []models.LLMConfig, agentID *string) *models.LLMConfig {
	if agentID == nil {
		// Find default model
		for _, m := range models {
			if m.IsDefault {
				return &m
			}
		}
		return nil
	}
	for _, m := range models {
		if m.ID == *agentID {
			return &m
		}
	}
	return nil
}

func getModelDisplayName(model *models.LLMConfig) string {
	if model == nil {
		return "No Model"
	}
	return model.Name
}

func findAgentDefinitionByID(agentDefs []models.Agent, agentDefinitionID *string) *models.Agent {
	if agentDefinitionID == nil {
		return nil
	}
	for _, ad := range agentDefs {
		if ad.ID == *agentDefinitionID {
			return &ad
		}
	}
	return nil
}

func StatusBadgeClass(status models.TaskStatus) string {
	switch status {
	case models.StatusRunning:
		return "badge-warning"
	case models.StatusCompleted:
		return "badge-success"
	case models.StatusFailed:
		return "badge-error"
	case models.StatusCancelled:
		return "badge-ghost"
	case models.StatusBlocked:
		return "badge-neutral"
	default:
		return "badge-info"
	}
}

func StatusLabel(status models.TaskStatus) string {
	switch status {
	case models.StatusPending:
		return "Queued"
	case models.StatusQueued:
		return "Queued"
	case models.StatusRunning:
		return "In Progress"
	case models.StatusCompleted:
		return "Completed"
	case models.StatusFailed:
		return "Failed"
	case models.StatusCancelled:
		return "Cancelled"
	case models.StatusBlocked:
		return "Waiting for Parent"
	default:
		return string(status)
	}
}

// StatusLabelForTask returns a display label considering both status and category.
// Backlog tasks with pending status show "Pending" instead of "Queued",
// and scheduled tasks show "Scheduled".
func StatusLabelForTask(status models.TaskStatus, category models.TaskCategory) string {
	if status == models.StatusPending {
		switch category {
		case models.CategoryBacklog:
			return "Pending"
		case models.CategoryScheduled:
			return "Scheduled"
		}
	}
	return StatusLabel(status)
}

func PriorityLabel(p int) string {
	switch p {
	case 1:
		return "Low"
	case 2:
		return "Normal"
	case 3:
		return "High"
	case 4:
		return "Urgent"
	case 0:
		// Legacy priority value - treat as Normal but don't display badge
		return ""
	default:
		return ""
	}
}

func TagBadgeClass(tag models.TaskTag) string {
	switch tag {
	case models.TagFeature:
		return "badge-primary"
	case models.TagBug:
		return "badge-error"
	default:
		return ""
	}
}

func TagLabel(tag models.TaskTag) string {
	switch tag {
	case models.TagFeature:
		return "Feature"
	case models.TagBug:
		return "Bug"
	default:
		return ""
	}
}

func hasChainConfigEnabled(task models.Task) bool {
	config, err := task.ParseChainConfig()
	if err != nil {
		return false
	}
	return config.Enabled
}

func SwarmRoleDisplayName(role models.SwarmRole) string {
	switch role {
	case models.SwarmRolePlanner:
		return "Planner"
	case models.SwarmRoleWorker:
		return "Worker"
	case models.SwarmRoleReviewer:
		return "Reviewer"
	case models.SwarmRoleMerger, models.SwarmRoleLegacyIntegrator:
		return "Merger"
	default:
		return "Swarm"
	}
}

func swarmChildDisplayTitle(child models.Task) string {
	label := SwarmRoleDisplayName(child.SwarmRole)
	if child.SwarmRole == models.SwarmRoleWorker {
		return child.Title
	}
	return label
}

func swarmStatusText(status models.TaskStatus, category models.TaskCategory) string {
	label := StatusLabelForTask(status, category)
	if label == "" {
		return "pending"
	}
	return strings.ToLower(label)
}

func SwarmStatusDisplayName(status string) string {
	switch status {
	case "needs_integration":
		return "Needs merge"
	case "integrating":
		return "Merging"
	case "integrated":
		return "Merged"
	case "needs_review":
		return "Needs review"
	case "reviewing":
		return "Reviewing"
	case "reviewed":
		return "Reviewed"
	case "planning":
		return "Planning"
	case "planned":
		return "Planned"
	case "current":
		return "Current"
	case "coordinating":
		return "Coordinating"
	case "blocked":
		return "Blocked"
	case "failed":
		return "Failed"
	case "cancelled":
		return "Cancelled"
	case "running":
		return "Running"
	case "pending", "":
		return "Pending"
	default:
		return strings.TrimSpace(strings.ReplaceAll(status, "_", " "))
	}
}

func swarmStatusIndicatorClass(status models.TaskStatus) string {
	switch status {
	case models.StatusCompleted:
		return "text-success"
	case models.StatusRunning:
		return "text-primary"
	case models.StatusFailed, models.StatusBlocked:
		return "text-error"
	case models.StatusCancelled:
		return "text-warning"
	default:
		return "text-base-content/35"
	}
}

func swarmSummary(task models.Task) string {
	workers, done, running, blocked := 0, 0, 0, 0
	for _, child := range task.SwarmChildren {
		if child.SwarmRole == models.SwarmRoleWorker {
			workers++
		}
		if child.Status == models.StatusCompleted {
			done++
		}
		if child.Status == models.StatusRunning {
			running++
		}
		if child.Status == models.StatusBlocked || child.Status == models.StatusFailed {
			blocked++
		}
	}
	return fmt.Sprintf("%d workers · %d/%d done · %d running · %d blocked", workers, done, len(task.SwarmChildren), running, blocked)
}

type taskCardState struct {
	Key       string
	Label     string
	TextClass string
}

func taskCardDisplayState(task models.Task) taskCardState {
	if task.Status == models.StatusCompleted && task.MergeStatus == models.MergeStatusMerged {
		return taskCardState{Key: "merged", Label: "Merged", TextClass: "text-success"}
	}
	if task.Status == models.StatusCompleted && task.GoalMet {
		return taskCardState{Key: "goal-met", Label: "Goal met", TextClass: "text-success"}
	}

	label := StatusLabelForTask(task.Status, task.Category)
	switch task.Status {
	case models.StatusPending:
		if task.Category == models.CategoryBacklog {
			return taskCardState{Key: "pending", Label: label, TextClass: "text-base-content/45"}
		}
		return taskCardState{Key: "queued", Label: label, TextClass: "text-info"}
	case models.StatusQueued:
		return taskCardState{Key: "queued", Label: label, TextClass: "text-info"}
	case models.StatusRunning:
		return taskCardState{Key: "running", Label: label, TextClass: "task-state-running"}
	case models.StatusCompleted:
		return taskCardState{Key: "completed", Label: label, TextClass: "text-success"}
	case models.StatusFailed:
		return taskCardState{Key: "failed", Label: label, TextClass: "text-error"}
	case models.StatusCancelled:
		return taskCardState{Key: "cancelled", Label: label, TextClass: "text-base-content/45"}
	case models.StatusBlocked:
		return taskCardState{Key: "blocked", Label: label, TextClass: "text-warning"}
	default:
		return taskCardState{Key: "pending", Label: "Pending", TextClass: "text-base-content/45"}
	}
}

templ taskCardStateIcon(task models.Task) {
	{{ state := taskCardDisplayState(task) }}
	<span
		data-task-state-icon
		data-task-state={ state.Key }
		class={ "tooltip tooltip-right inline-flex h-5 w-5 shrink-0 items-center justify-center", state.TextClass }
		data-tip={ state.Label }
		role="img"
		aria-label={ "Task state: " + state.Label }
	>
		switch state.Key {
			case "goal-met":
				<svg xmlns="http://www.w3.org/2000/svg" class="h-4 w-4" fill="none" viewBox="0 0 24 24" stroke="currentColor" aria-hidden="true">
					<circle cx="12" cy="8.5" r="7.5" stroke-width="2"></circle>
					<path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="m8 14-2 8 6-3.5 6 3.5-2-8"></path>
					<path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="m9 8.5 2 2 4-4"></path>
				</svg>
			case "merged":
				<svg xmlns="http://www.w3.org/2000/svg" class="h-4 w-4" fill="none" viewBox="0 0 24 24" stroke="currentColor" aria-hidden="true">
					<circle cx="6.5" cy="4.5" r="2.5" stroke-width="2"></circle>
					<circle cx="6.5" cy="19.5" r="2.5" stroke-width="2"></circle>
					<circle cx="18" cy="12" r="2.5" stroke-width="2"></circle>
					<path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M6.5 7v10M6.5 7c0 3.2 3.4 5 9 5"></path>
				</svg>
			case "queued":
				<svg xmlns="http://www.w3.org/2000/svg" class="h-4 w-4" fill="none" viewBox="0 0 24 24" stroke="currentColor" aria-hidden="true">
					<circle cx="5" cy="7" r="1" fill="currentColor" stroke="none"></circle>
					<circle cx="5" cy="12" r="1" fill="currentColor" stroke="none"></circle>
					<circle cx="5" cy="17" r="1" fill="currentColor" stroke="none"></circle>
					<path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 7h10M9 12h10M9 17h7"></path>
				</svg>
			case "running":
				<svg xmlns="http://www.w3.org/2000/svg" class="h-4 w-4" fill="none" viewBox="0 0 24 24" stroke="currentColor" aria-hidden="true">
					<circle cx="12" cy="12" r="9" stroke-width="2"></circle>
					<path d="m10 8 6 4-6 4z" fill="currentColor" stroke="none"></path>
				</svg>
			case "completed":
				<svg xmlns="http://www.w3.org/2000/svg" class="h-4 w-4" fill="none" viewBox="0 0 24 24" stroke="currentColor" aria-hidden="true">
					<circle cx="12" cy="12" r="9" stroke-width="2"></circle>
					<path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="m7.5 12 3 3 6-6"></path>
				</svg>
			case "failed":
				<svg xmlns="http://www.w3.org/2000/svg" class="h-4 w-4" fill="none" viewBox="0 0 24 24" stroke="currentColor" aria-hidden="true">
					<path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="m8 3-5 5v8l5 5h8l5-5V8l-5-5zM12 7.5v6m0 3h.01"></path>
				</svg>
			case "cancelled":
				<svg xmlns="http://www.w3.org/2000/svg" class="h-4 w-4" fill="none" viewBox="0 0 24 24" stroke="currentColor" aria-hidden="true">
					<rect x="4" y="4" width="16" height="16" rx="4" stroke-width="2"></rect>
					<path d="M9 9h6v6H9z" fill="currentColor" stroke="none"></path>
				</svg>
			case "blocked":
				<svg xmlns="http://www.w3.org/2000/svg" class="h-4 w-4" fill="none" viewBox="0 0 24 24" stroke="currentColor" aria-hidden="true">
					<rect x="5" y="10" width="14" height="10" rx="2" stroke-width="2"></rect>
					<path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M8 10V7a4 4 0 0 1 8 0v3"></path>
				</svg>
			default:
				<svg xmlns="http://www.w3.org/2000/svg" class="h-4 w-4" fill="none" viewBox="0 0 24 24" stroke="currentColor" aria-hidden="true">
					<circle cx="12" cy="12" r="9" stroke-width="2"></circle>
					<circle cx="12" cy="12" r="1.75" fill="currentColor" stroke="none"></circle>
				</svg>
		}
	</span>
}

type TaskCardMergeMenuState struct {
	LocalEligible       bool
	FastForwardEligible bool
	RebaseEligible      bool
	PullEligible        bool
	PullRequest         *models.TaskPullRequest
	TargetBranch        string
}

func taskCardMergeActionEnabled(state TaskCardMergeMenuState, mergeType string) bool {
	switch mergeType {
	case "ff":
		return state.FastForwardEligible
	case "rebase":
		return state.RebaseEligible
	default:
		return state.LocalEligible
	}
}

func taskCardMergeTarget(task *models.Task, state TaskCardMergeMenuState) string {
	if target := strings.TrimSpace(state.TargetBranch); target != "" {
		return target
	}
	return TaskWorktreeMergeTarget(task)
}

func taskCardMergeMenuStateMap(states []map[string]TaskCardMergeMenuState) map[string]TaskCardMergeMenuState {
	if len(states) == 0 {
		return nil
	}
	return states[0]
}

func taskCardMergeMenuState(taskID string, states []map[string]TaskCardMergeMenuState) TaskCardMergeMenuState {
	if len(states) == 0 || states[0] == nil {
		return TaskCardMergeMenuState{}
	}
	return states[0][taskID]
}

templ TaskCardMergeSubmenus(task *models.Task, projectID string, state TaskCardMergeMenuState) {
	{{ targetBranch := taskCardMergeTarget(task, state) }}
	<li class="group relative" data-task-card-local-submenu onmouseenter="positionKanbanSubmenu(this)">
		<button type="button" class="text-sm justify-between" onfocus="positionKanbanSubmenu(this.parentElement)" onkeydown="handleKanbanSubmenuKeydown(event, this.parentElement)">
			<span>Local</span>
			<svg xmlns="http://www.w3.org/2000/svg" class="h-4 w-4" fill="none" viewBox="0 0 24 24" stroke="currentColor" aria-hidden="true">
				<path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="m9 18 6-6-6-6"></path>
			</svg>
		</button>
		<ul tabindex="-1" data-task-card-submenu-panel class="menu menu-sm absolute right-0 top-full z-[110] hidden w-56 max-w-[calc(100vw-2rem)] border border-base-300 bg-base-100 p-2 shadow rounded-box group-hover:block group-focus-within:block">
			<li class="menu-title"><span>Local</span></li>
			for _, action := range TaskWorktreeMergeActions() {
				@TaskCardWorktreeMergeAction(task, projectID, targetBranch, action, taskCardMergeActionEnabled(state, action.MergeType))
			}
		</ul>
	</li>
	<li class="group relative" data-task-card-github-submenu onmouseenter="positionKanbanSubmenu(this)">
		<button type="button" class="text-sm justify-between" onfocus="positionKanbanSubmenu(this.parentElement)" onkeydown="handleKanbanSubmenuKeydown(event, this.parentElement)">
			<span>GitHub</span>
			<svg xmlns="http://www.w3.org/2000/svg" class="h-4 w-4" fill="none" viewBox="0 0 24 24" stroke="currentColor" aria-hidden="true">
				<path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="m9 18 6-6-6-6"></path>
			</svg>
		</button>
		<ul tabindex="-1" data-task-card-submenu-panel class="menu menu-sm absolute right-0 top-full z-[110] hidden w-56 max-w-[calc(100vw-2rem)] border border-base-300 bg-base-100 p-2 shadow rounded-box group-hover:block group-focus-within:block">
			<li class="menu-title"><span>GitHub</span></li>
			<li>
				if state.PullRequest != nil && state.PullRequest.PRURL != "" && strings.EqualFold(strings.TrimSpace(state.PullRequest.PRState), "open") {
					<a class="text-sm" href={ templ.SafeURL(state.PullRequest.PRURL) } target="_blank" rel="noopener noreferrer">View PR #{ fmt.Sprintf("%d", state.PullRequest.PRNumber) }</a>
				} else {
					<button
						type="button"
						class="text-sm"
						if !state.PullEligible {
							disabled
						}
						data-task-card-pr-action
						data-task-id={ task.ID }
						data-project-id={ projectID }
						data-target-branch={ targetBranch }
						data-merge-type="pr"
						data-merge-label="Create PR"
						data-merge-endpoint="pull-request"
						onclick="runTaskCardAction(this)"
					>Create PR</button>
				}
			</li>
		</ul>
	</li>
}

templ TaskCardMergeOptions(task *models.Task, projectID string, eligible bool, rebaseAvailable bool, taskPR *models.TaskPullRequest, prEligible bool) {
	@TaskCardMergeSubmenus(task, projectID, TaskCardMergeMenuState{
		LocalEligible:       eligible,
		FastForwardEligible: eligible,
		RebaseEligible:      eligible && rebaseAvailable,
		PullEligible:        prEligible,
		PullRequest:         taskPR,
		TargetBranch:        TaskWorktreeMergeTarget(task),
	})
}

templ TaskCard(task models.Task, projectID string, viewingCategory string, llmModels []models.LLMConfig, agentDefs []models.Agent, menuStates ...map[string]TaskCardMergeMenuState) {
	<div
		id={ fmt.Sprintf("task-%s", task.ID) }
		class="card bg-base-100 shadow-sm border border-base-300 hover:border-primary/40 hover:shadow-md transition-all mb-2 cursor-grab active:cursor-grabbing drag-cursor-surface relative min-w-0 overflow-visible"
		data-task-id={ task.ID }
		data-task-status={ string(task.Status) }
		data-task-category={ string(task.Category) }
		data-display-order={ fmt.Sprintf("%d", task.DisplayOrder) }
		onclick="handleTaskSelect(event)"
		onpointerdown="handleTaskPointerDown(event)"
	>
		<!-- Kebab menu in top right corner -->
		<div class="dropdown dropdown-end absolute top-2 right-14 lg:right-8 z-30" data-kanban-menu-key={ "task-" + task.ID } onclick="event.stopPropagation()">
			<label tabindex="0" aria-expanded="false" class="btn btn-ghost btn-xs min-h-11 h-11 w-11 p-0 lg:min-h-6 lg:h-6 lg:w-6" onclick="handleDropdownToggle(event)" data-kanban-menu-trigger data-task-card-menu-trigger aria-label={ "More actions for " + task.Title }>
				<svg xmlns="http://www.w3.org/2000/svg" class="h-4 w-4" fill="none" viewBox="0 0 24 24" stroke="currentColor">
					<path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 5v.01M12 12v.01M12 19v.01M12 6a1 1 0 110-2 1 1 0 010 2zm0 7a1 1 0 110-2 1 1 0 010 2zm0 7a1 1 0 110-2 1 1 0 010 2z"></path>
				</svg>
			</label>
			<ul tabindex="0" class="dropdown-content z-[100] menu p-2 shadow bg-base-100 rounded-box w-52 max-w-[calc(100vw-2rem)] translate-x-4 border border-base-300" data-kanban-menu-content>
				<!-- Run option (hide in Active column) -->
				if viewingCategory != "active" {
					<li>
						<button
							class="text-sm"
							hx-post={ fmt.Sprintf("/tasks/%s/run", task.ID) }
							hx-target="#kanban-board"
							hx-swap="outerHTML"
						>
							Run
						</button>
					</li>
				}
				<!-- Cancel option (only show if running) -->
				if task.Status == models.StatusRunning {
					<li>
						<button
							class="text-sm text-error"
							hx-post={ fmt.Sprintf("/tasks/%s/cancel", task.ID) }
							hx-target="#kanban-board"
							hx-swap="outerHTML"
							hx-confirm="Cancel this running task?"
						>
							Cancel
						</button>
					</li>
				}
				<!-- Edit option (only show if not running) -->
				if task.Status != models.StatusRunning {
					<li>
						<a
							class="text-sm"
							href={ templ.SafeURL(fmt.Sprintf("/tasks/%s?tab=details&from=tasks", task.ID)) }
							hx-get={ fmt.Sprintf("/tasks/%s?tab=details&from=tasks", task.ID) }
							hx-target="#main-content"
							hx-swap="innerHTML"
							hx-push-url="true"
						>
							Edit
						</a>
					</li>
				}
				@TaskCardMergeSubmenus(&task, projectID, taskCardMergeMenuState(task.ID, menuStates))
			</ul>
		</div>
		<!-- X button in top right corner -->
		<button
			class="btn btn-circle btn-ghost btn-xs min-h-11 h-11 w-11 p-0 lg:min-h-6 lg:h-6 lg:w-6 absolute top-2 right-2 z-10"
			onclick="event.stopPropagation()"
			hx-delete={ fmt.Sprintf("/tasks/%s", task.ID) }
			hx-target="#kanban-board"
			hx-swap="outerHTML"
		>
			<svg xmlns="http://www.w3.org/2000/svg" class="h-4 w-4" fill="none" viewBox="0 0 24 24" stroke="currentColor">
				<path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M6 18L18 6M6 6l12 12"></path>
			</svg>
		</button>
			<div class="card-body p-4 pt-14 sm:pt-4">
				<div class="flex items-start justify-between pr-0 sm:pr-24 lg:pr-12">
					<div class="flex-1 min-w-0">
					<a
						href={ templ.SafeURL(fmt.Sprintf("/tasks/%s?from=tasks", task.ID)) }
						hx-get={ fmt.Sprintf("/tasks/%s?from=tasks", task.ID) }
						hx-target="#main-content"
						hx-swap="innerHTML"
						hx-push-url={ fmt.Sprintf("/tasks/%s?from=tasks", task.ID) }
						class="font-medium hover:underline cursor-pointer flex items-start gap-2 min-w-0 max-w-full leading-snug"
						title={ task.Title }
					>
						@taskCardStateIcon(task)
						<span data-task-title class="min-w-0 flex-1 break-words sm:truncate">{ task.Title }</span>
					</a>
					if task.Prompt != "" {
						<p class="text-sm opacity-60 mt-1 line-clamp-3 sm:line-clamp-2 break-words">{ task.Prompt }</p>
					}
					<div class="flex gap-1 mt-1 flex-wrap">
						if task.ParentTaskID != nil {
							<span class="badge badge-sm badge-secondary inline-flex items-center" title="Child task (chained from parent)">
								<svg xmlns="http://www.w3.org/2000/svg" class="h-3 w-3 mr-1" fill="none" viewBox="0 0 24 24" stroke="currentColor">
									<path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M13 10V3L4 14h7v7l9-11h-7z"></path>
								</svg>
								Chained
							</span>
						}
						if hasChainConfigEnabled(task) {
							<span class="badge badge-sm badge-accent inline-flex items-center" title="Will create child task on completion">
								<svg xmlns="http://www.w3.org/2000/svg" class="h-3 w-3 mr-1" fill="none" viewBox="0 0 24 24" stroke="currentColor">
									<path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M13.828 10.172a4 4 0 00-5.656 0l-4 4a4 4 0 105.656 5.656l1.102-1.101m-.758-4.899a4 4 0 005.656 0l4-4a4 4 0 00-5.656-5.656l-1.1 1.1"></path>
								</svg>
								Chain
							</span>
						}
							if task.HasGoal {
								<span class="badge badge-sm badge-primary badge-outline inline-flex items-center" title="Task has an active goal">Goal</span>
							}
							if task.SwarmRole == models.SwarmRoleParent {
								<span class="badge badge-sm badge-accent badge-outline inline-flex items-center" title="Swarm parent task">Swarm</span>
							}
						<!-- Model Badge -->
						if len(llmModels) > 0 {
							<span class="badge badge-sm badge-outline" title={ fmt.Sprintf("Model: %s", getModelDisplayName(findModelByID(llmModels, task.AgentID))) }>
								{ getModelDisplayName(findModelByID(llmModels, task.AgentID)) }
							</span>
						}
						if ad := findAgentDefinitionByID(agentDefs, task.AgentDefinitionID); ad != nil {
							<span class="badge badge-sm badge-outline" title={ fmt.Sprintf("Assigned agent: %s", ad.Name) }>
								{ ad.Name }
							</span>
						}
						if TagLabel(task.Tag) != "" {
							<span class={ "badge badge-sm inline-flex items-center", TagBadgeClass(task.Tag) }>{ TagLabel(task.Tag) }</span>
						}
						if PriorityLabel(task.Priority) != "" {
							<span class="badge badge-sm badge-outline">{ PriorityLabel(task.Priority) }</span>
						}
					</div>
					</div>
				</div>
						if task.SwarmRole == models.SwarmRoleParent && len(task.SwarmChildren) > 0 {
								<details class="group mt-3 w-full rounded-xl border border-base-300 bg-base-200/45 text-xs shadow-inner overflow-hidden">
								<summary class="flex cursor-pointer list-none items-center justify-between gap-2 px-3 py-2 font-semibold text-base-content/80 transition-colors hover:bg-base-300/40 [&::-webkit-details-marker]:hidden" onclick="event.stopPropagation()">
									<span>{ swarmSummary(task) }</span>
									<svg xmlns="http://www.w3.org/2000/svg" class="h-4 w-4 shrink-0 text-base-content/50 transition-transform group-open:rotate-180" fill="none" viewBox="0 0 24 24" stroke="currentColor" aria-hidden="true">
										<path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M19 9l-7 7-7-7"></path>
									</svg>
								</summary>
								<div class="divide-y divide-base-300/70 border-t border-base-300/80">
									for i, child := range task.SwarmChildren {
										<div class="relative grid grid-cols-[1.25rem_minmax(0,1fr)_auto] items-center gap-2 px-3 py-2 min-w-0 hover:bg-base-100/45 transition-colors" onclick="event.stopPropagation()">
											<div class="relative flex h-full min-h-7 items-center justify-center">
												if i > 0 {
													<span class="absolute -top-2 h-1/2 border-l border-base-content/20"></span>
												}
												if i < len(task.SwarmChildren)-1 {
													<span class="absolute top-1/2 -bottom-2 border-l border-base-content/20"></span>
												}
												if child.Status == models.StatusCompleted {
													<svg xmlns="http://www.w3.org/2000/svg" class={ "relative z-10 h-4 w-4", swarmStatusIndicatorClass(child.Status) } viewBox="0 0 20 20" fill="currentColor" aria-hidden="true">
														<path fill-rule="evenodd" d="M16.704 5.29a1 1 0 010 1.415l-7.25 7.25a1 1 0 01-1.415 0l-3.25-3.25a1 1 0 111.414-1.414l2.543 2.543 6.543-6.543a1 1 0 011.415 0z" clip-rule="evenodd"></path>
													</svg>
												} else {
													<span class={ "relative z-10 h-3.5 w-3.5 rounded-full border-2 bg-base-200", swarmStatusIndicatorClass(child.Status), templ.KV("border-current", true), templ.KV("bg-current", child.Status == models.StatusRunning) } aria-hidden="true"></span>
												}
											</div>
											<a href={ templ.SafeURL(fmt.Sprintf("/tasks/%s?from=tasks", child.ID)) } hx-get={ fmt.Sprintf("/tasks/%s?from=tasks", child.ID) } hx-target="#main-content" hx-swap="innerHTML" hx-push-url="true" class="min-w-0 truncate text-sm font-semibold text-base-content/85 hover:text-primary hover:underline" title={ child.Title }>{ swarmChildDisplayTitle(child) }</a>
											<div class="flex items-center gap-3 text-right text-sm font-medium shrink-0">
												if child.WorktreeBranch != "" && (child.Status == models.StatusRunning || child.Status == models.StatusCompleted || child.Status == models.StatusFailed || child.Status == models.StatusBlocked) {
													<a href={ templ.SafeURL(fmt.Sprintf("/tasks/%s?tab=changes&from=tasks", child.ID)) } hx-get={ fmt.Sprintf("/tasks/%s?tab=changes&from=tasks", child.ID) } hx-target="#main-content" hx-swap="innerHTML" hx-push-url="true" class="link link-primary no-underline hover:underline">Diff</a>
													<a href={ templ.SafeURL(fmt.Sprintf("/tasks/%s?tab=thread&from=tasks", child.ID)) } hx-get={ fmt.Sprintf("/tasks/%s?tab=thread&from=tasks", child.ID) } hx-target="#main-content" hx-swap="innerHTML" hx-push-url="true" class="link link-primary no-underline hover:underline">Logs</a>
												} else {
													<span class="text-base-content/55">{ swarmStatusText(child.Status, child.Category) }</span>
												}
											</div>
										</div>
									}
								</div>
							</details>
						}
			</div>
		</div>
	}
