package components

import (
 "fmt"
 "github.com/openvibely/openvibely/internal/models"
)

templ DiffChunk(file DiffFile, index int, view, taskID string, comments []models.ReviewComment, chunk, count int, revision string) {
 <div data-diff-chunk-response data-chunk={ fmt.Sprint(chunk) } data-chunks={ fmt.Sprint(count) } data-code-revision={ revision }>
  if view == "split" {
   @splitDiffFileWithReview(file, index, true, taskID, buildCommentMap(comments))
  } else {
   @inlineDiffFileWithReview(file, index, true, taskID, buildCommentMap(comments))
  }
 </div>
}
