package components

import (
 "fmt"
 "github.com/openvibely/openvibely/internal/models"
)

templ DiffChunk(chunks []DiffFile, index int, view, taskID string, comments []models.ReviewComment, chunk int, revision string) {
 <div data-diff-chunk-response data-chunk={ fmt.Sprint(chunk) } data-chunks={ fmt.Sprint(len(chunks)) } data-chunk-rows={ diffChunkRowCounts(chunks, view) } data-code-revision={ revision }>
  if view == "split" {
   @splitDiffFileWithReview(chunks[chunk], index, true, taskID, buildCommentMap(comments))
  } else {
   @inlineDiffFileWithReview(chunks[chunk], index, true, taskID, buildCommentMap(comments))
  }
 </div>
}
