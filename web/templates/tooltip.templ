package templates

templ Tooltips() {
 <style>
 .ov-tooltip { position:fixed; inset:auto; margin:0; width:max-content; max-width:min(360px,calc(100vw - 16px)); max-height:calc(100vh - 16px); overflow:auto; padding:6px 8px; border:1px solid oklch(var(--bc) / .18); border-radius:6px; background:var(--ov-menu-surface,#1D232A); color:var(--ov-tooltip-text,oklch(var(--bc))); box-shadow:0 3px 10px #0003; font:12px/1.5 system-ui,sans-serif; z-index:2147483647; }
 .ov-tooltip[hidden] { display:none; }
 .ov-tooltip-row { display:flex; align-items:baseline; justify-content:space-between; gap:12px; white-space:pre-wrap; overflow-wrap:anywhere; }
 .ov-tooltip kbd { flex-shrink:0; padding:0 4px; border:1px solid oklch(var(--bc) / .16); border-radius:3px; background:oklch(var(--bc) / .08); color:inherit; font:11px/16px system-ui,sans-serif; white-space:nowrap; }
 [data-tip]::before,[data-tip]::after { content:none !important; display:none !important; }
 </style>
 <script>
 (function() {
  if (window.openVibelyTooltip) return;
  var tip=document.createElement('div');tip.id='ov-shared-tooltip';tip.className='ov-tooltip';tip.setAttribute('role','tooltip');tip.hidden=true;tip.setAttribute('popover','manual');document.body.appendChild(tip);
  var changing=false,active=null,pinned=false,timer=null,nativePopover=typeof tip.showPopover==='function';
  if(!nativePopover)tip.removeAttribute('popover');
  var selector='[title],[data-tip],[data-ov-tooltip],[data-model-help],[data-model-setting-help]';
  function textFor(el) {
   var text=el.getAttribute('title')||el.dataset.ovTooltip||el.dataset.modelSettingHelp||el.dataset.modelHelp||el.dataset.tip||'';
   var sample=el.querySelector('[data-task-summary-sample]');
   if(el.hasAttribute('data-model-help')&&sample&&sample.textContent)text+=' '+sample.textContent+'.';
   return text;
  }
  function describe(el,add) {
   var ids=(el.getAttribute('aria-describedby')||'').split(/\s+/).filter(function(id){return id&&id!==tip.id;});if(add)ids.push(tip.id);
   if(ids.length)el.setAttribute('aria-describedby',ids.join(' '));else el.removeAttribute('aria-describedby');
  }
  function close() {
   if(changing)return;changing=true;
   clearTimeout(timer);
   if(active){describe(active,false);if(active.matches('[data-model-help],[data-model-setting-help]'))active.setAttribute('aria-expanded','false');}
   active=null;pinned=false;
   if(nativePopover&&tip.matches(':popover-open'))tip.hidePopover();tip.hidden=true;if(tip.parentElement!==document.body)document.body.appendChild(tip);
   changing=false;
  }
  function render(text) {
   tip.replaceChildren();
   String(text).split(/\n|;\s*(?=previous\/next:|last visited:)/).forEach(function(line){
    var row=document.createElement('div');row.className='ov-tooltip-row';
    // Existing labels keep their wording; only recognizable shortcuts get a badge.
    var match=line.match(/^(.*?)\s*\(((?:⌘|Ctrl\+|Command\+|Shift\+|Esc|Enter)[^)]*)\)$/)||line.match(/^(.*?:)\s*((?:⌘|Ctrl\+|Command\+).*)$/);
    if(match){var label=document.createElement('span');label.textContent=match[1];var key=document.createElement('kbd');key.textContent=match[2];row.append(label,key);}
    else {var parts=line.split(/((?:Command|Ctrl)\+click)/);parts.forEach(function(part){var node=document.createElement(/^(Command|Ctrl)\+click$/.test(part)?'kbd':'span');node.textContent=part;row.appendChild(node);});}
    tip.appendChild(row);
   });
  }
  function position(point) {
   if(!active)return;
   var r=active.getBoundingClientRect(),box=tip.getBoundingClientRect(),x=point?point.x:r.left,y=point?point.y:r.bottom;
   tip.style.left=Math.max(8,Math.min(x,innerWidth-box.width-8))+'px';
   tip.style.top=Math.max(8,Math.min(y+8+box.height<=innerHeight?y+8:(point?y:r.top)-box.height-8,innerHeight-box.height-8))+'px';
  }
  function show(el,text,pin,point) {
   if(changing)return;
   if(!el||!el.isConnected||!text)return;
   if(active!==el)close();clearTimeout(timer);active=el;pinned=pinned||!!pin;
   adopt(el);
   var host=el.closest('dialog[open]')||document.body;if(tip.parentElement!==host)host.appendChild(tip);
   render(text);describe(el,true);if(el.matches('[data-model-help],[data-model-setting-help]'))el.setAttribute('aria-expanded','true');
   tip.hidden=false;if(nativePopover&&!tip.matches(':popover-open'))tip.showPopover();position(point);
  }
  function trigger(target){if(changing)return null;return target instanceof Element?target.closest(selector)||(active&&active.contains(target)?active:null):null;}
  document.addEventListener('pointerover',function(e){if(tip.contains(e.target)){clearTimeout(timer);return;}var el=trigger(e.target);if(el&&!pinned&&el!==active)show(el,textFor(el));});
  document.addEventListener('pointerout',function(e){if(pinned)return;if(active&&(!e.relatedTarget||(!active.contains(e.relatedTarget)&&!tip.contains(e.relatedTarget)))){clearTimeout(timer);timer=setTimeout(close,100);}});
  document.addEventListener('focusin',function(e){var el=trigger(e.target);if(el)show(el,textFor(el));});
  document.addEventListener('focusout',function(e){if(!pinned&&active&&active.contains(e.target)&&!active.contains(e.relatedTarget))close();});
  document.addEventListener('click',function(e){var el=trigger(e.target);if(el&&el.matches('[data-model-help],[data-model-setting-help]')){if(active===el&&pinned)close();else show(el,textFor(el),true);}else if(!tip.contains(e.target))close();});
  document.addEventListener('keydown',function(e){if(e.key==='Escape'&&active){e.preventDefault();e.stopPropagation();close();}},true);
  document.addEventListener('scroll',function(e){if(!tip.contains(e.target))close();},true);window.addEventListener('resize',close);
  document.addEventListener('close',function(e){if(active&&e.target.contains(active)&&!e.target.open)close();},true);
  document.addEventListener('model-section-change',close);
  document.addEventListener('htmx:beforeSwap',close);document.addEventListener('htmx:beforeHistorySave',close);
  // Consume native labels centrally, including labels produced by streamed HTML
  // and existing title setters. No native tooltip remains after dismissal.
  function adopt(el) {
   if(!(el instanceof Element))return;
   function convert(node){
    var text=node.getAttribute('title');if(text===null)return;
    node.dataset.ovTooltip=text;node.removeAttribute('title');
    if(text&&!node.textContent.trim()&&!node.hasAttribute('aria-label')&&!node.hasAttribute('aria-labelledby'))node.setAttribute('aria-label',text);
   }
   convert(el);el.querySelectorAll('[title]').forEach(convert);
  }
  adopt(document.body);
  new MutationObserver(function(records){
   records.forEach(function(record){
    if(record.type==='childList')record.addedNodes.forEach(adopt);
    else if(record.attributeName==='title'&&record.target.hasAttribute('title'))adopt(record.target);
   });
   if(!active)return;if(!active.isConnected){close();return;}
   if(records.some(function(record){return record.type==='attributes'&&record.target===active;})){var text=textFor(active);if(text){render(text);position();}else close();}
  }).observe(document.body,{subtree:true,childList:true,attributes:true,attributeFilter:['title','data-tip','data-ov-tooltip','data-model-help','data-model-setting-help']});
  window.openVibelyTooltip={show:show,close:close,chart:function(context){
   var model=context.tooltip,canvas=context.chart.canvas;if(!model||!model.opacity){if(active===canvas)close();return;}
   var lines=[].concat(model.title||[],model.beforeBody||[]);(model.body||[]).forEach(function(body){lines=lines.concat(body.before||[],body.lines||[],body.after||[]);});lines=lines.concat(model.afterBody||[],model.footer||[]);
   var r=canvas.getBoundingClientRect();show(canvas,lines.join('\n'),false,{x:r.left+model.caretX,y:r.top+model.caretY});
  }};
 })();
 </script>
}
