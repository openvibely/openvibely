# =============================================================================
# OpenVibely development image
# =============================================================================
# Self-contained development image for working on OpenVibely itself. The image
# includes an initial copy of the app source and starts it with Air, so it can run
# by itself. For day-to-day development, bind-mount your checkout at /workspace;
# Air will rebuild/restart the server from the mounted source as files change.
FROM fedora:42
ENV PATH=/usr/local/go/bin:/home/openvibely/go/bin:/usr/local/sbin:/usr/local/bin:/usr/sbin:/usr/bin:/sbin:/bin \
    HOME=/home/openvibely \
    GOPATH=/home/openvibely/go
LABEL org.opencontainers.image.title="OpenVibely Development" \
      org.opencontainers.image.description="OpenVibely development image with live reload, Go, Air, templ, Swagger, and rootless Podman tools" \
      org.opencontainers.image.url="https://github.com/openvibely/openvibely" \
      org.opencontainers.image.source="https://github.com/openvibely/openvibely" \
      org.opencontainers.image.licenses="MIT"
RUN dnf install -y \
      bash \
      buildah \
      ca-certificates \
      coreutils \
      crun \
      curl \
      findutils \
      fuse-overlayfs \
      gawk \
      git \
      grep \
      make \
      nodejs \
      npm \
      podman \
      procps-ng \
      sed \
      shadow-utils \
      slirp4netns \
      tzdata \
      util-linux \
 && dnf clean all \
 && rm -rf /var/cache/dnf \
 && (chmod u+s /usr/bin/newuidmap /usr/bin/newgidmap /usr/sbin/newuidmap /usr/sbin/newgidmap 2>/dev/null || true)
ARG GO_VERSION=1.26.6
ARG TARGETARCH
RUN case "${TARGETARCH:-amd64}" in \
      amd64) go_arch=amd64 ;; \
      arm64) go_arch=arm64 ;; \
      *) echo "unsupported TARGETARCH=${TARGETARCH}" >&2; exit 1 ;; \
    esac \
 && curl -fsSL "https://go.dev/dl/go${GO_VERSION}.linux-${go_arch}.tar.gz" -o /tmp/go.tgz \
 && rm -rf /usr/local/go \
 && tar -C /usr/local -xzf /tmp/go.tgz \
 && rm /tmp/go.tgz
RUN useradd -m -u 10001 -s /bin/bash openvibely \
 && echo "openvibely:100000:65536" >> /etc/subuid \
 && echo "openvibely:100000:65536" >> /etc/subgid \
 && mkdir -p \
      /data \
      /tmp/openvibely-runtime \
      /tmp/containers-runroot \
      /home/openvibely/.cache/go-build \
      /home/openvibely/.config/containers \
      /home/openvibely/.local/share/containers/storage \
      /home/openvibely/go \
      /workspace \
 && printf '[storage]\ndriver = "overlay"\nrunroot = "/tmp/containers-runroot"\ngraphroot = "/home/openvibely/.local/share/containers/storage"\n\n[storage.options.overlay]\nmount_program = "/usr/sbin/fuse-overlayfs"\nmountopt = "nodev"\n' \
      > /home/openvibely/.config/containers/storage.conf \
 && printf '[containers]\ndefault_ulimits = ["nofile=65536:65536"]\n\n[engine]\nruntime = "crun"\nevents_logger = "file"\n' \
      > /home/openvibely/.config/containers/containers.conf \
 && chown -R openvibely:openvibely \
      /data \
      /tmp/openvibely-runtime \
      /tmp/containers-runroot \
      /home/openvibely \
      /workspace \
 && chmod 700 /tmp/openvibely-runtime \
 && printf '[safe]\n\tdirectory = *\n' > /etc/gitconfig
RUN printf '%s\n' \
      '#!/usr/bin/env bash' \
      'set -euo pipefail' \
      '' \
      'mkdir -p /data /tmp/openvibely-runtime /tmp/containers-runroot /home/openvibely/.cache/go-build /home/openvibely/.config/containers /home/openvibely/.local/share/containers/storage /home/openvibely/go /workspace' \
      'chown -R openvibely:openvibely /tmp/openvibely-runtime /tmp/containers-runroot /home/openvibely/.cache/go-build /home/openvibely/.config /home/openvibely/.local /home/openvibely/go' \
      'chmod 700 /tmp/openvibely-runtime' \
      '' \
      'if [ "$(stat -c "%u:%g" /data)" != "10001:10001" ]; then' \
      '  chown -R openvibely:openvibely /data' \
      'fi' \
      '' \
      'exec setpriv --reuid=10001 --regid=10001 --init-groups "$@"' \
      > /usr/local/bin/openvibely-dev-entrypoint \
 && chmod +x /usr/local/bin/openvibely-dev-entrypoint
USER openvibely
WORKDIR /workspace
COPY --chown=openvibely:openvibely go.mod go.sum /tmp/openvibely-tools/
RUN cd /tmp/openvibely-tools \
 && go install github.com/air-verse/air@v1.65.3 \
 && go install github.com/a-h/templ/cmd/templ@$(go list -m -f '{{.Version}}' github.com/a-h/templ) \
 && go install github.com/swaggo/swag/cmd/swag@$(go list -m -f '{{.Version}}' github.com/swaggo/swag) \
 && go install github.com/pressly/goose/v3/cmd/goose@$(go list -m -f '{{.Version}}' github.com/pressly/goose/v3) \
 && rm -rf /tmp/openvibely-tools
COPY --chown=openvibely:openvibely . /workspace
RUN templ generate \
 && go build -o ./tmp/openvibely ./cmd/server
USER root
ENV PORT=3001 \
    OPENVIBELY_APP_DATA_DIR=/data \
    DATABASE_PATH=/data/openvibely.db \
    PROJECT_REPO_ROOT=/data/repos \
    ENVIRONMENT=development \
    GIT_EXEC_PATH=/usr/libexec/git-core \
    XDG_RUNTIME_DIR=/tmp/openvibely-runtime \
    STORAGE_DRIVER=overlay \
    BUILDAH_ISOLATION=chroot
EXPOSE 3001
VOLUME ["/data"]
ENTRYPOINT ["/usr/local/bin/openvibely-dev-entrypoint"]
CMD ["air", "-c", ".air.toml"]
